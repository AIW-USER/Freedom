      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anterior approach to cervical spine",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "critical to align center of rotation in both the coronal and sagittal planes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "especially important in two-level CDA",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hardware failure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
