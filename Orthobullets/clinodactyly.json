  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinodactyly is a congenital condition of the hand, often associated with Down's syndrome, that is characterized by the abnormal curvature of a digit in the radioulnar plane.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is usually observation in the majority of cases.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Prevalence",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6075/images/Clinical%20photo%20-%20neonet_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "found in 25% of children with **Down's syndrome** and 3% of general population",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**middle phalanx of small finger most commonly affected**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
