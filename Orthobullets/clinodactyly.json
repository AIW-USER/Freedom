                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "phalanx opening wedge osteotomy +/- bone excision",
              "table": null,
              "images": [
                {
