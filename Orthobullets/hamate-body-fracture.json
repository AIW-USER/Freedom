{
  "title": "Hamate Body Fracture",
  "url": "https://www.orthobullets.com/hand/12110/hamate-body-fracture",
  "subtitle": "Updated: May 13 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hamate Body Fractures are rare carpal fractures that can be associated with 4th or 5th metacarpal fractures.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is generally made with radiographs of the wrist but may require CT for confirmation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is nonoperative for non-displaced fractures but displaced or intra-articular fractures require ORIF.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "< 2% of all carpal fractures",
              "table": null,
              "images": [
