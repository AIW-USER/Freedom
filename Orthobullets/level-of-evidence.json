    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A method utilized in the **3rd step of evidence based medicine (EBM)** to determine the clinical value of a study",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "five steps of EBM",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**formulate an answerable question**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**gather the evidence**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**appraise the evidence**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**implement the evidence**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**evaluate the process**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "See details of Clinical Design Trials",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
