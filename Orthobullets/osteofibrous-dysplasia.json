{
  "title": "Osteofibrous Dysplasia",
  "url": "https://www.orthobullets.com/pathology/8039/osteofibrous-dysplasia",
  "subtitle": "Updated: Jun 21 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteofibrous Dysplasia is a rare benign tumor-like condition that primarily affects the cortices of the tibia.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "The condition typically presents in patients less than 10 years of age with painless anterior shin swelling.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made by a combination of radiographs showing an anterior eccentric lytic tibial lesion and biopsy showing fibroblast proliferation surrounding islands of woven bone with osteoblastic rimming.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually observation alone as lesions usually regress and do not cause problems in adulthood.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually found in younger children (< 10 years old)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "males>females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primarily in anterior tibia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "trisomy 7, 8, 12, 22 have been reported",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "does NOT have Gs alpha activating mutation like fibrous dysplasia has",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "may be asymptomatic",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**painless** swelling",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**anterior or anterolateral bowing of the tibia**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**pseudoarthrosis** develops in 10-30% of patients",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may have local tenderness over the tibia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of affected area",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**anterior eccentric lytic tibial lesion** in child that often leads to tibial bowing",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8039/images/35a_moved.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8039/images/35b_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "usually diaphyseal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "no periosteal reaction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "confined to anterior cortex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "radiographic differential includes **adamantinoma**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8039/images/osteofibrous%20dysplasia..jpg",
              "caption": "histology for osteofibrous dysplasia"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "histology similar to fibrous dysplasia EXCEPT **osteoblastic rimming is present**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8039/images/35c_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "fibroblast proliferation surrounding islands of woven bone with osteoblastic rimming",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "mitotic figures are common",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may have giant cells",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
