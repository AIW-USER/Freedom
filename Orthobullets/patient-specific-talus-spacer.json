    {
      "src": "https://upload.orthobullets.com/topic/423363/images/cfb4e065-b799-42e0-a6e5-2d10c1bbd227_screenshot_2026-05-21_at_3.37.21_pm.jpg",
      "caption": ""
    },
    {
      "src": "https://upload.orthobullets.com/topic/423363/images/671b0977-4037-4f87-ad30-793c665d301f_screenshot_2026-05-21_at_3.37.34_pm.jpg",
      "caption": ""
    },
    {
      "src": "https://upload.orthobullets.com/topic/423363/images/e813a795-e694-44c5-a4ba-cdde7414a8b6_screenshot_2026-05-22_at_3.35.02_pm.jpg",
      "caption": ""
