{
  "title": "Raynaud's Syndrome",
  "url": "https://www.orthobullets.com/hand/6098/raynauds-syndrome",
  "subtitle": "Updated: Feb 10 2025",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Raynaud's is an exaggerated vasocontriction of the digital arteries in response to a variety of stimuli. It takes two forms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Raynaud's Phenomenon or Raynaud's Syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "vasospastic disease with a known underlying cause",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**Raynaud's Disease**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "vasospastic disease with no known cause (idiopathic)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "periodic digital ischemia due vasoconstriction induced by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cold temperature** or",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**sympathetic stimuli** including pain or **emotional stress**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**triphasic color change** (white-blue-red progression)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "digits turn white from vasospasm and interruption of blood flow",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6098/images/white%20discoloration.jpg",
                      "caption": "Shows white discoloration of the digits secondary to Raynaud&#39;s syndrome."
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "blue discoloration follows from cyanosis and venous stasis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6098/images/blue%20digits.jpg",
                      "caption": "Shows blue discoloration of the digits in Raynaud&#39;s syndrome."
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "finally digits turn red as a result of rebound hyperemia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dysesthesias often follow color changes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Raynaud's Phenomenon",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Vasospastic disease with a **known underlying disease**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "epidemiology",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "demographics",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "occasional female predominance",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "age >40 years (generally older than patients with Raynaud's disease)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "location",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "affects the distal aspect of digits",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "associated conditions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**connective tissue disease**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "scleroderma (80-90% incidence of Raynaud's phenomenon)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "SLE (18-26%)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "dermatomyositis (30%)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "RA (11%)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**CREST syndrome**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "calcinosis, Raynaud's phenomenon, esophageal dysmotility, sclerodactyly, telangiectasias",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**neurovascular compression** (thoracic outlet syndrome)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "asymmetric findings",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rapid progression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "peripheral pulses often absent",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "frequent trophic skin changes (including ulceration and gangrene)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6098/images/gangrene.jpg",
                      "caption": "Shows gangrene in a patient with Raynaud&#39;s phenomenon."
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "abnormal Allen test",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Studies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "labs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "blood chemistry - often abnormal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "invasive studies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "microangiology - often abnormal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "angiography - often abnormal",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6098/images/angiogram.jpg",
                      "caption": "Shows an angiogram with incomplete ulnar artery obstruction in a patient with Raynaud&#39;s phenomenon."
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "normal and not indicated",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6098/images/normal_xray..jpg",
                      "caption": "normal radiographs"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Raynaud's Disease",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Vasospastic disease **with no known cause (idiopathic)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "epidemiology",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "seen in young premenopausal women (age <40 years)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often bilateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "slow progression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Allen and Brown Criteria for Raynaud's Disease",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "Intermittent attacks with discoloration of acral parts",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Bilateral involvement",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Absence of clinical arterial occlusion",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Gangrene and trophic changes are rare",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Symptoms present for >2 years",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Predominance in women",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Absence of other disease to explain findings",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "peripheral pulses usually present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "trophic skin changes are uncommon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "normal Allen test",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "normal and not indicated",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6098/images/normal_xray..jpg",
                      "caption": "normal radiographs"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Studies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "labs usually normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "invasive studies usually normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "based on Allen and Brown criteria",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Factors to differentiate Raynaud's Phenomenon or Raynaud's Disease",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6098/images/raynaud_ddx..jpg",
              "caption": "Green DP et al, editors: Green’s operative hand surgery, ed 5, Philadelphia, 2005, Churchill Livingstone, p 2304"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "age",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "gender",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "time frame of symptom progression",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "severity of exam findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medical management & lifestyle modifications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**smoking cessation and avoidance of cold exposure** is critical",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "thermal biofeedback techniques",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "medications include",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**topical nitrates**",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "**calcium channel blockers**",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "ASA",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "intra-arterial reserpine",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "dipyridamole (Persantine)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "pentoxifylline (Trental)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "Sildenafil",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "Botulinum toxin A injections",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "medical management has failed",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "presence of ischemia and pain",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "ulcerations not a contraindication",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "note this is \"off-label\" use",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6098/images/method..jpg",
                          "caption": "method of botox injection"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "contraindications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "pregnancy/breastfeeding",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "allergy to toxin",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "active infections",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "coadministration with medications affecting nerve transmission (aminoglycosides, anticholinergics)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Shown to improve digital perfusion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thorascopic sympathectomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fallen out of favor due to rebound hypersympathetic response",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "digital sympathectomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "severe cases that fail conservative treatment (impending gangrene)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "periarterial sympathectomy most common method",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "removal of adventitia and sympathetic nerve fibers",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "may extend to forearm",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "sympathectomy is not indicated calcific arterial disease",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "microvascular reconstruction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "may be indicated in rare situations with occlusion of small segment of one major artery while other is spared/minimal involvement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**digital ischemia leading to ulcerations and/or gangrene**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "may necessitate amputation of digit(s)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
