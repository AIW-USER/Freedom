                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1048/images/talar%20neck%20fx%20dislocation%20lateral.jpg",
                          "caption": "shows Hawkins III talar neck fracture"
                        }
                      ],
