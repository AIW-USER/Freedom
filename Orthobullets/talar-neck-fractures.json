{
  "title": "Talar Neck Fractures",
  "url": "https://www.orthobullets.com/trauma/1048/talar-neck-fractures",
  "subtitle": "Updated: Sep 13 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Talar neck fractures are high energy injuries to the hindfoot that are associated with a high incidence of talus avascular necrosis.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs of the foot but frequently require CT scan for full characterization.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is emergent reduction of the talus following by internal fixation in an acute or delayed fashion.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "common",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "most common fracture of talus ( 50%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a high-energy injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "is **forced dorsiflexion** with **axial load**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ipsilateral lower extremity fractures common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Articulation",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1048/images/3D%20Anatomy_moved.gif",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "inferior surface articulates with **posterior facet of calcaneus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**talar head** articulates with:",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "navicular bone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "sustenaculum tali",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral process** articulates with",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "posterior facet of calcaneus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lateral malleolus of fibula",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**posterior process** consist of medial and lateral tubercles separated by groove for FHL",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "talar neck supplied by three sources",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1048/images/Blood%20supply_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**posterior tibial artery**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "via artery of tarsal canal (dominant supply)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "supplies majority of talar body",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "deltoid branch of posterior tibial artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "supplies medial portion of talar body",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "may be only remaining blood supply with a displaced fracture",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**anterior tibial artery**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "supplies head and neck",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**perforating peroneal** artery via **artery of tarsal sinus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "supplies head and neck",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
