        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Canale view",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1048/images/Canale%20View%20Illustration_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "best view to demonstrate talar neck fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "technique is maximum equinus, 15 degrees pronated, xray 75 degrees cephalad from horizontal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "best study to determine degree of displacement, comminution and articular congruity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "CT scan also will assess for ipsilateral foot injuries (up to 89% incidence)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "emergent reduction in ER",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**all cases require emergent closed reduction in ER**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "short leg cast for 8-12 weeks (NWB for first 6 weeks)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**nondisplaced fractures** (Hawkins I)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "CT to confirm nondisplaced without articular stepoff",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open reduction and internal fixation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "all displaced fractures (Hawkins II-IV)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "Talus extrusion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "extruded talus should be replaced and treated with ORIF",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "~63% of reimplanations do not require secondary procedure",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "low incidence of infection with adequate I&D and antibiotic therapy",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "high incidence of AVN without collapse",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "complications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "post-traumatic arthritis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "mal-union",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "non-union",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "infection",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "wound dehiscence",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**ORIF**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "two approaches recommended",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "visualize medial and lateral neck to assess reduction",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "typical areas of comminution are dorsal and medial",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "anteromedial",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "between tibialis anterior and posterior tibialis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "preserve soft tissue attachments, especially **deep deltoid ligament (blood supply)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**medial malleolar osteotomy** to preserve deltoid ligament",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "anterolateral",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "between tibia and fibula proximally, in line with 4th ray",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "elevate extensor digitorum brevis and remove debris from subtalar joint",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "anatomic reduction essential",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "variety of implants used including mini and small fragment screws, cannulated screws and mini fragment plates",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "medial and lateral lag screws may be used in simple fracture patterns",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "consider mini fragment plates in comminuted fractures to buttress against varus collapse",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1048/images/talar%20neck%20fx%20dislocation%20or.jpg",
                      "caption": "shows postoperative talar neck fracture"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "non-weight-bearing for 10-12 weeks",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Osteonecrosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "31% overall (including all subtypes)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**hawkins sign**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1048/images/Xray%20-%20AP%20-%20Hawkins%20positive%20and%20negative_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "subchondral lucency best seen on mortise Xray at **6-8 weeks**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "indicates intact vascularity with resorption of subchondral bone",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "increased risk with increasing degree of initial fracture displacement",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "associated with talar neck comminution and open fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "recent studies have found a significantly increased risk of osteonecrosis with the presence of subtalar dislocation and/or proximal fracture extension into the talar body",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "delayed internal fixation is not associated with avascular necrosis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "associated with a dual-incision approach",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Posttraumatic arthritis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**subtalar arthritis (50%) is the most common** complication",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "tibiotalar arthritis (33%)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "Posttraumatic arthritis may necessitate fusion surgery",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Varus malunion** (25-30%)",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "can be prevented by anatomic reduction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "treatment includes medial opening wedge osteotomy of talar neck",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "leads to",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**decreased subtalar eversion**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "decreased motion with locked midfoot and hindfoot",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**weight bearing on the lateral border of the foot**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
