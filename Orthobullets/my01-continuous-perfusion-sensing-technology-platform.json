            {
              "text": "lower leg compartments",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "anterior",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "deep posterior",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "superficial posterior",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "forearm compartments",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "volar (anterior)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "dorsal (posterior)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "mobile wad (lateral)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "hand compartments",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "thenar",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "hypothenar",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "adductor pollicis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
