    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Neutral ulnar variance (ulnar zero)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "difference between ulnar and radial length is <1mm",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Positive ulnar variance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ulnar sided wrist pain from increased impact stress on the lunate and triquetrum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "UV becomes more positive in **pronation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "UV becomes more positive during **grip**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Negative ulnar variance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "UV decreases in supination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended view",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**PA of the wrist with shoulder abducted 90 deg, elbow flexed 90 deg, neutral forearm rotation**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Method to determine ulnar variance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "draw 2 lines",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "1 line tangential to the articular surface of the ulna and perpendicular to its shaft",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "1 line tangential to the lunate fossa of the radius and perpendicular to its shaft.",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "measure the distance between these 2 lines (normal is 0mm)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "if the ulnar tangent is distal to the radial tangent = positive UV",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "if the ulnar tangent is proximal to the radial tangent = negative UV",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can estimate but not quantify degree of UV",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "because specific wrist position cannot be duplicated in MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
