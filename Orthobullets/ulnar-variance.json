{
  "title": "Ulnar Variance",
  "url": "https://www.orthobullets.com/hand/6046/ulnar-variance",
  "subtitle": "Updated: Mar 3 2023",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ulnar Variance is the length of the ulna compared to the length of the radius at the wrist.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with PA wrist radiographs. Positive ulnar variance indicates a longer ulna compared to the radius and a negative ulnar variance indicates a shorter ulna.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment depends on severity of symptoms and underlying condition.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "male:female relationship",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
