          "children": [
            {
              "text": "may be helpful if hematoma suspected",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "EMGs",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "may be used post-operatively to confirm level of injury and guide discussion with patient regarding prognosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Intraoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "adult hip dysplasia undergoing THA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**subtrochanteric osteotomy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "downsizing components",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Immediate postoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "place hip in extension and knee in flexion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**immediate post-operative palsy**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "decreases tension along sciatic nerve",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**immediate evacuation in operating room**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "post-operative hematoma",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Persistent foot drop",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "AFO orthosis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first line of treatment for persistent foot drop",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "1",
      "children": [
        {
          "text": "**Only 35% to 40% recover full strength after complete palsy**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    }
