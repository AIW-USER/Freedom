{
  "title": "Macrodactyly (local gigantism)",
  "url": "https://www.orthobullets.com/hand/6080/macrodactyly-local-gigantism",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Macrodactyly is nonhereditary congenital digit enlargement.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "very rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "90% are unilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "70% involves more than one digit",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6080/images/macrodactyly.jpg",
                  "caption": "Macrodactyly"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "index involved most frequently",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "in order of decreasing frequency, the long finger, thumb, ring, and small are also involved",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can involve digits of the hand or foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "none known",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "etiology unknown",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no genetic correlations known to date",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "affected digits correspond with **neurologic innervation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "the median nerve being the most common",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lipfibromatous hamartoma of the median nerve is the adult homolog",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "has been associated with:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Proteus syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Banayan-Riley-Ruvalcabe's disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Maffucci syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Ollier’s disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Milroy’s disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
