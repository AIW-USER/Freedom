    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "asymmetry to digits can be present at birth or appearing over time",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inability to use digits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "complaints of cosmetic issues",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6080/images/1.jpg",
              "caption": "Macrodactyly of the hand"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "inspection & palpation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "thick, fibrofatty tissue involving enlarged digits",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "ROM & instability",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "often limited ROM due to soft tissue constraints",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "biplanar hand radiographs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**enlarged phalanges** to involved digits",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6080/images/f21.large.jpg",
                      "caption": "Macrodactyly of the hand"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "may see malalignment of joints or angled phalanges",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT, MRI",
