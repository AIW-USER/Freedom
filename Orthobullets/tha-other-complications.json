    {
      "text": "Heterotopic Ossification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "frequent radiographic complication but rarely results in functional limitations following hip replacement",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "mild cases with notable symptoms should undergo workup for other potential causes of pain",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "prolonged surgical time",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "excessive soft tissue handling during procedure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hypertrophic osteoarthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**male gender**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "ankylosing spondylitis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "history of prior heterotopic ossification at other sites",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical excision",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "severe loss of motion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "once heterotopic ossification is visible on radiographs, only surgical excision will eradicate",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**must wait 6 months after initial procedure to allow for maturation and formation of capsule**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**perioperative prophylaxis with perioperative radiation or NSAIDs**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Prophylaxis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classically oral indomethacin, although various NSAIDs have equivalent efficacy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "radiation therapy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "600-800 cGy administered ideally within 24-48 hours following procedure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Squeaking",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Defined as a high pitched audible sound occurring during hip movement",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ceramic-on-ceramic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "0.5-10%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "metal-on-metal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "4-5%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "incidence of revision because of squeaking is 0.5%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risks",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "impingement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "edge loading",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "component malposition",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "loss of fluid film lubrication",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "third body particles",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "thin, flexible (titanium) femoral stem",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Postoperative Anemia",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Low preoperative hemoglobin**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "is the best predictor of the need for a blood transfusion postoperatively",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Prevention",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "TXA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "postoperative transfusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most centers have dropped to a hemoglobin of 7-8",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
