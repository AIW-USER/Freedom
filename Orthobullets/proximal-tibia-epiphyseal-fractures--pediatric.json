{
  "title": "Proximal Tibia Epiphyseal Fractures - Pediatric",
  "url": "https://www.orthobullets.com/pediatrics/4024/proximal-tibia-epiphyseal-fractures--pediatric",
  "subtitle": "Updated: Mar 19 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Proximal Tibia Epiphyseal Fractures are rare injuries seen in adolescents that may be associated with vascular injury.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be confirmed with plain radiographs of the knee.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on the Salter-Harris classification, stability, and displacement of fracture.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "< 1% of pediatric fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more commonly seen in **children 12-14 years old**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "high energy trauma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "varus/valgus force",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hyperextension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**fracture**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "may occur as a part of a Type III tibial tubercle fracture",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4024/images/xr_ap.jpg",
                      "caption": "AP xray of a knee demonstrating a non-displaced Salter-Harris Type III proximal tibia fracture."
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4024/images/ct_coronal_2.jpg",
                      "caption": "Coronal CT of a knee demonstrating a non-displaced Salter-Harris Type III proximal tibia fracture."
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**vascular injury**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**most common with hyperextension injuries**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "tethering of popliteal artery (5%)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**peroneal nerve injury** (5%)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**ligamentous injury**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "seen in up to 40% of Salter-Harris type III and type IV injuries",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**compartment syndrome (3-4%)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physeal considerations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "general assumptions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leg growth continues until",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**16 yrs in boys**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**14 yrs in girls**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "growth contribution",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leg grows **23 mm/year**, with most of that coming from the knee (**15 mm/yr**)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "proximal femur - 3 mm/yr (1/8 in)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "distal femur - 9 mm/yr (3/8 in)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "proximal tibia - 6 mm/yr (1/4 in)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "distal tibia - 5 mm/yr (3/16 in)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**closure of proximal tibial epiphysis occurs in a predictable pattern**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "sagittal plane - posterior to anterior",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "coronal plane - medial to lateral",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "axial plane - posteromedial to anterolateral",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**medial collateral ligament**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "superficial portion extends distal to physis to insert on medial metaphysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "acts as medial buttress",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral collateral ligament**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "inserts on proximal pole of fibula",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "acts as lateral buttress along with fibula",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**patellar ligament**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "inserts on tibial tubercle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "acts as restraint to posterior displacement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**popliteal artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "distal portion lies close to posterior aspect of proximal tibia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "tethered to proximal tibia by firm connective tissue septa",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**at risk of injury with displaced fractures**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "divides into anterior tibial and posterior tibial branches beneath arch of soleus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral inferior geniculate artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "passes over popliteus, anterior to lateral head of gastrocnemius, and underneath LCL",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**medial inferior geniculate artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "passes along proximal border of popliteus, anterior to medial head of gastrocnemius, to anterior proximal tibia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Salter-Harris Classification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture through the physis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Mean age 12 years",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Usually displaced (>50%) due to buttress effect of tibial tubercle and fibula",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/screenshot_2018-10-24_10.11.56..jpg",
                          "caption": "Salter-Harris classification"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/lower-extremity-growth-plate-fractures1.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture through the physis and exiting through the metaphysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Mean age 14 years",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Usually displaced (>67%)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Most common pattern is medial gapping with lateral Thurston-Holland fragment and proximal fibula fracture",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/screenshot_2018-10-24_10.11.56..jpg",
                          "caption": "Salter-Harris classification"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/13018_2009_article_120_fig1_html.jpg",
                          "caption": "SH 2"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture through the physis and exiting through the epiphysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Usually tibial tubercle fractures",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/screenshot_2018-10-24_10.11.56..jpg",
                          "caption": "Salter-Harris classification"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/xr_ap.jpg",
                          "caption": "AP xray of a knee demonstrating a non-displaced Salter-Harris Type III proximal tibia fracture."
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/ct_coronal_2.jpg",
                          "caption": "Coronal CT of a knee demonstrating a non-displaced Salter-Harris Type III proximal tibia fracture."
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type IV",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture through the physis, metaphysis and epiphysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/screenshot_2018-10-24_10.11.56..jpg",
                          "caption": "Salter-Harris classification"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4024/images/tibia.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inability to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain and swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tenderness along the physis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may see deformity or have palpable step-off if displaced",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may see varus or valgus knee instability on exam",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "important to perform thorough neurovascular exam",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**physis is at same level of trifurcation of vessels and there is a risk of vascular compromise with displacement**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
