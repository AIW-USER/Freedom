{
  "title": "Rib Stress Fracture",
  "url": "https://www.orthobullets.com/knee-and-sports/12108/rib-stress-fracture",
  "subtitle": "Updated: Jun 1 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A rib stress fracture in an uncommon site of stress fracture that typically occurs due to repetitive contraction of the chest wall muscles.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis can be made with radiographs but often require CT or MRI for accurate diagnosis.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment consists of rest, analgesia and cessation of inciting activity for ~4-6 weeks.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "uncommon site of stress fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "first rib",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "common site",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "occurs anterolaterally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "activities associated with stress fx include baseball pitching, basketball, weightlifting and ballet",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "middle ribs (4-9th)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occurs laterally and anterolaterally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "increased incidence in **competitive rowers**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "posteromedial ribs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more commonly occurs in **novice golfers**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**amenorrhea**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "osteopenia / osteoporosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "extreme overuse / repetitive use",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "repetitive coughing paroxysms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**repetitive contraction**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "stress placed on a rib during repetitive contraction of an attached muscle",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "accentuated during training because muscles strengthen more rapidly than bone",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**muscle fatigue** during prolonged activity",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "places a bone at risk for fracture by lessening the ability of a muscle to absorb and dissipate opposing forces",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**anatomic sites of weakness**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first rib stress fx",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12108/images/firstrib.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": [
                        {
                          "text": "groove for subclavian artery is site of weakness due to superiorly directed forces from the scalene muscles and inferiorly directed forces from the serratus anterior and intercostal muscles",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "in cases of acute injury **may hear \"snap\"** (complete fracture of fatigued bone) while performing activity (i.e., throwing, batting, lifting)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**insidious onset**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "worse with coughing, deep inspiration and overhead activities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "focal tenderness directly over affected rib",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "with advanced injuries, palpable callus may develop",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP chest",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12108/images/rsfxr.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "x-rays are **negative for fracture in as many as 60%** of patients with rib fracture of any etiology",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "when x-rays are negative and clinical suspicion remains",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12108/images/bsrsf.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "increased activity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can be helpful when there is concern for pathologic fx",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "can help localize an uptake abnormality in the costotransverse region, where the anatomy is complex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12108/images/ctrsf.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "clear delineation of fracture pattern",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "when x-rays are negative and clinical suspicion remains",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "avoids the use of radiation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "used more commonly than bone scans in athletes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "marrow edema consistent with stress response; fracture line may or may not be seen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, analgesia, cessation of inciting activity for ~4-6 weeks, correction of training errors or faulty mechanics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "majority of rib stress fx",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "majority heal uneventfully",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Non-union**",
          "table": null,
