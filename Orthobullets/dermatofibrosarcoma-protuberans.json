{
  "title": "Dermatofibrosarcoma Protuberans",
  "url": "https://www.orthobullets.com/pathology/8066/dermatofibrosarcoma-protuberans",
  "subtitle": "Updated: Aug 11 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Dermatofibrosarcoma Protuberans are rare, low-grade fibrogenic cutaneous sarcomas that occur in early to mid-adult life.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing uniform fibroblasts arranged in storiform pattern around an inconspicuous vasculature.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually wide surgical resection with radiation therapy.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "accounts for 1% of soft tissue sarcomas",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "slightly more common in **males**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "usually presents in people aged **20-50 years old**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**more common in African Americans (2:1) vs. Caucasians**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "t**runk > proximal extremities > head/neck**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Variants",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**Bednar tumor**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8066/images/28704.jpg",
                  "caption": "Bednar"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "pigmented variant that is 7.5x more common in African Americans",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**fibrosarcomatous**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "more aggressive variant with poor prognosis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mutations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "associated with **t(17;22)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "encodes for PDGF-beta chain (PDGFB)/collagen type I alpha 1 (COL1A1) fusion protein",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Symptoms",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**usually an slowly enlarging painless mass**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8066/images/28701.jpg",
                  "caption": "Clinical photo"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "composed of firm irregular nodules",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may have dark red or blue discoloration",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "CXR",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "screen for pulmonary metastasis in high-risk cases (i.e. recurrence or suspicion for a fibrosarcoma variant of DFSP)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "suspected direct bone involvement or metastasis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "preoperative assessment in larger or atypical lesions and recurrent disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "monitoring of local DFSP or regional lymph node metastasis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "PET",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "monitoring of metastatic disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Biopsy is required for diagnosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classically appears as **uniform fibroblasts arranged in storiform pattern around an inconspicuous vasculature**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8066/images/28707.jpg",
                  "caption": "Histology"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "Bednar variant has scattered melanin-containing dendritic cells",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8066/images/3-figure3-1.jpg",
                  "caption": "Bednar histology"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "fibrosarcomatous variant has a characteristic herringbone pattern",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8066/images/03_31r.jpg",
                  "caption": "Herringbone"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "imatinib",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "inhibits PDGF-receptor tyrosine kinase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**adult patients with unresectable, recurrent, and/or metastatic DFSP**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "65% response rate",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "no response in patients who lack the t(17,22) mutation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wide surgical resection +/- adjuvant radiation therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**patients with resectable DFSP**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "adjuvant radiation therapy is useful in patients with positive margins or in whom adequate wide excision alone may result in major cosmetic or functional deficits",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "clean margins are an important goal of surgical resection",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "obtain 2-3cm margins",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "dissect deep to and excise all tissue including the fascia",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "total dose of radiation therapy is 50-70 Gy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "15.7% recurrence for lesions on the body",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "51.8% recurrence rate for lesions on the head/neck",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**LocationXrayXrayCTB. ScanMRIMRIHisto**(1)**Case A**tibia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Local recurrence is common**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Distant metastasis is rare** (< 5%)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**lung** is the most common site of distant metastasis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "occurs via hematogenous spread",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "usually preceded by multiple local recurrences",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Worse prognosis seen with",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "regional lymph node involvement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fibrosarcomatous progression DFSP variant",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "histologic features: high number of mitotic figures, increased cellularity, DNA aneuploidy, TP53 gene overexpression, and the presence of fibrosarcomatous changes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "age > 50 years old",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
