{
  "title": "Gait Cycle",
  "url": "https://www.orthobullets.com/foot-and-ankle/7001/gait-cycle",
  "subtitle": "Updated: Jun 4 2026",
  "sections": [
    {
      "text": "Overview",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "One gait cycle is measured from heel-strike to heel-strike",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**stance phase**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "period of time that the foot is on the ground",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "~60% of one gait cycle is spent in stance",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "during stance, the leg accepts body weight and provides single limb support",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**swing phase**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "period of time that the foot is off the ground moving forward",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "~40% of one gait cycle is spent in swing",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "the limb advances",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Stride",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "is the distance between consecutive inital contacts of the same foot with the ground",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Step",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "is the distance between initial contacts of the alternating feet",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Stance Phase",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Initial contact (heel strike)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7001/images/gait%20cycle.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "occurs when foot contacts the ground",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "hip extensors contract to stabilize the hip",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "quadriceps contract eccentrically",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tibialis anterior contracts eccentrically",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Loading response (initial double limb support)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "marks the beginning of the initial double limb stance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occurs after initial contact until elevation of opposite limb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bodyweight is transferred on to the supporting limb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**ankle dorsiflexors (tibialis anterior) contract eccentrically to control plantar flexion moment**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**quads contract** to stabilize knee and counteract the flexion moment (about the knee)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Mid-stance (single limb support)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "initial period of single leg support",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "from elevation of opposite limb until both ankles are aligned in coronal plane",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**gluteus medius and calf muscles undergo eccentric contraction**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Terminal stance (single limb support)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "begins when the supporting heel rises from the ground and continues until the opposite heel touches the ground",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "toe flexors and tibialis posterior contract and are the most active during this phase",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pre-swing (second double limb support)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "is the start of the second double limb stance in the gait cycle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "from initial contact of opposite limb to just prior to elevation of ipsilateral limb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hip flexors contract to propel advancing limb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Swing Phase",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Initial swing (toe off)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7001/images/gait%20cycle.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "start of single limb support for opposite limb",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "from elevation of limb to point of maximal knee flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "hip flexors concentrically contract to advance the swinging leg",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Mid-swing (foot clearance)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "following knee flexion to point where tibia is vertical",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ankle dorsiflexors contract to ensure foot clearance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Terminal swing (tibia vertical)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "from point where tibia is vertical to just prior to initial contact",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscular contractions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hamstring muscles decelerate forward motion of thigh",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Variables Affected During Gait Cycle",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pelvic rotation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pelvis **rotates 4 degrees medially** (anteriorly) on swing side",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lengthens the limb as it prepares to accept weight",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pelvic tilt",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pelvis **drops 4 degrees** on swing side",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lowers COG at midstance",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Knee flexion in stance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early **knee flexion (15 degrees) at heel strike**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "lowers COG, decreasing energy expenditure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "also absorbs shock of heel strike",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Foot mechanisms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ankle plantar flexion** at heel strike and first part of stance",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "FHL plantarflexes the great toe during push-off and is inactive during swing phase",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Knee mechanisms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "at **midstance**, the **knee extends** as the ankle plantar flexes and foot supinates",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "restores leg to original length",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reduces fall of pelvis at opposite heel strike",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Lateral displacement of pelvis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pelvis **shifts over stance limb**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "COG must lie over base of support (stance limb)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Center of gravity (COG)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "in standing position is 5cm anterior to S2 vertebral body",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "vertical displacement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "during gait cycle COG displaces vertically in a rhythmic pattern",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "the highest point is during midstance phase",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "lowest point occurs at the time of double limb support",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "horizontal displacement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "COG displaces 5cm horizontally during adult male step",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Muscle Activity",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Figure showing muscle activity through different phases of gait cycle",
          "table": null,
          "images": [
