{
  "title": "Sacroiliitis",
  "url": "https://www.orthobullets.com/spine/2040/sacroiliitis",
  "subtitle": "Updated: May 30 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Sacroiliitis is an inflammatory condition of the sacroiliac joint that can cause persistent low back and posterior pelvic pain",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with contrast-enhanced MRI demonstrating fluid/inflammation in the SI joint and possible abscess formation",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually nonoperative, consisting of NSAIDs and rest, with IV antibiotics reserved for infection. Surgical debridement is indicated in the presence of an abscess",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly presents in teenagers to middle-age adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "males > females",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly part of **ankylosing spondylitis** or **Reiter's syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can stem from a traumatic event or infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pregnancy may predispose",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often stems from chronic inflammation of the SI joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can lead to fibrosis and ossification within the SI joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ankylosing spondylitis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "associated with HLA-B27",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**approximately 1-2% of all individuals are HLA-B27 positive**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Reiter's syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**oligoarticular arthritis, conjunctivitis, and urethritis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain with prolonged standing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "difficulty climbing stairs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "generalized low back pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakness of the hip musculature on the affected side",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "morning stiffness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**FABER test**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**pain with flexion, abduction, and external rotation of the hip**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "ankylosing spondylitis may be associated with the following:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "spinal flexion deformities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "typically beginning in the thoracic and lumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may show some **erosive changes** in the bone, although these findings are **nonspecific**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "may show calcifications or sclerosis within the SI joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI is the study of choice",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "with gadolinium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "T2-weighted images may show **fluid/inflammation in the SI joint** and/or a possible abscess",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "WBC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually normal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "can be elevated in cases of infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ESR/CRP",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually elevated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "blood cultures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "positive in ~50% of cases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "HLA-B27",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "check rheumatoid factor (typically negative in ankylosing spondylitis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Depends on underlying cause",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "IV antibiotics",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "until symptoms improve and CRP levels normalize",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "followed by oral antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "surgery",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may be necessary if antibiotics alone fail or if a large abscess is present",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "trauma or overuse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rest, activity modification, NSAIDs, and corticosteroid injections",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "most cases resolve with rest and activity modification",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "pregnancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "symptoms typically resolve after childbirth",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "when occurring as part of a broader spondyloarthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "aggressive physical therapy, NSAIDs, and/or TNF inhibitors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "severe symptoms may require TNF inhibitors or other biologic agents",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Depends on the underlying cause, but most cases eventually resolve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
