{
  "title": "Physeal Considerations",
  "url": "https://www.orthobullets.com/pediatrics/4002/physeal-considerations",
  "subtitle": "Updated: Jul 4 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Always look to see if **physis is open**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Unique principals in pediatric bone",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**elasticity**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "more elastic which leads to unique fracture patterns",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "buckle fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "greenstick fractures",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/forearm%20greenstick%20fx%20(medcyclopaedia.com).jpg",
                          "caption": "greenstick"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**remodeling potential**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "open physes (growth plates) can allow extensive bone deformity remodeling potential",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "skeletal age is important to determine because it differs by >1 year from chronologic age in 26% of children",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "occurs more rapidly in **plane of joint motion**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "sagittal plane in wrist, due to primarily extension/flexion",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/wrist%20move%20(midfordathleticclub.org).jpg",
                          "caption": "wrist moving"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "occurs more at the **most active physes**, due to most growth and potential for remodeling",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most active physes in upper extremity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "proximal humerus",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "distal radius",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "most active physes in lower extremity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "distal femur",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "proximal tibia",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "distal tibia",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "patients require follow up after physeal injury for 2 years to evaluate for clinically significant growth disturbances",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "lateral ligament sprains are more common than Salter-Harris 1 fractures in pediatric ankle inversion injuries",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Same principles as adult bone",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intra-articular fractures must be reduced",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Physeal Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Physeal Growth Plate**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Reserve zone (B)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Cells store lipids, glycogen, and proteoglycan aggregates for later growth and matrix production",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Low oxygen tension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Gaucher's**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Kneist",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Pseudoachondroplasia",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Proliferative zone (C)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Proliferation of chondrocytes with longitudinal growth and stacking of chondrocytes.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Highest rate of extracellular matrix production",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Increased oxygen tension in surroundings inhibits calcification",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Achondroplasia**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Hypertrophic zone (D)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Zone of chondrocyte maturation, **chondrocyte hypertrophy**, and chondrocyte calcification.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Three phases occur in the hypertrophic zone",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Maturation zone:** preparation of matrix for calcification, chondrocyte growth",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Degenerative zone:** further preparation of matrix for calcification, further chondrocyte growth in size (5x)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Provisional calcification zone:** chondrocyte death allows calcium release, allowing calcification of matrix",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Chondrocyte maturation regulated by local growth factors (parathyroid related peptides, expression regulated by Indian hedgehog gene)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Type X collagen** produced by hypertrophic chondrocytes important for mineralization",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**SCFE** (not renal)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Rickets (provisional calcification zone)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Enchondromas",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Mucopolysacharide disease",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Schmids",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Fractures most commonly occur through **zone of provisional calcification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Primary spongiosa (E)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(metaphysis)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Vascular invasion and resorption of transverse septa.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Osteoblasts align on cartilage bars produced by physeal expansion.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Primary spongiosa mineralized to form woven bone and then remodels to become secondary spongiosa (below)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Metaphyseal \"corner fracture\" in child abuse**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Secondary spongiosa",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(metaphysis)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/Histology%20of%20zones_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Internal remodeling (removal of cartilage bars, replacement of fiber bone with lamellar bone)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "External remodeling (funnelization)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Renal SCFE",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Physis Periphery**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Groove of Ranvier",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "During the first year of life, the zone spreads over the adjacent metaphysis to form a fibrous circumferential ring bridging from the epiphysis to the diaphysis.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "This **ring increases the mechanical strength of the physis and is responsible for appositional bone growths**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Osteochondroma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Perichondrial fibrous ring of La Croix",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Dense fibrous tissue that is the primary limiting membrane that anchors and **supports the physis through peripheral stability**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/ring.jpg",
                          "caption": "ring of la croix"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Perichondrial artery",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4002/images/perichondral%20artery.jpg",
                          "caption": "perichonrial artery"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Major source of nutrition to physis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Injury Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Salter-Harris classification**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4002/images/harris%20class%20(centralline.org).jpg",
              "caption": "salter"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "Type 1: physeal separation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Type 2: fracture traverses physis and exits metaphysis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4002/images/femur%20sh2(medcyclopaedia.com).jpg",
                  "caption": "SH2"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**most common type**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "Thurston Holland fragment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Type 3: fracture traverses physis and exits epiphysis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4002/images/salterharris3%20(handbook.muh.ie).jpg",
                  "caption": "SH3"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "Type 4: fracture passes through epiphysis, physis, metaphysis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4002/images/figner%20sh4(medcyclopaedia.com).jpg",
                  "caption": "SH4"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "Thurston Holland fragment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Type 5: crush injury to physis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Closed reduction vs. CRPP vs. ORIF",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "depends on injury pattern",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "intra-articular fractures must be reduced",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Growth arrests**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "overview",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "complete arrest leads to shortening",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "see Leg Length Discrepancy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "partial arrest leads to angulation",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4002/images/crookedankle%20arrest%20(medcyclopaedia.com).jpg",
                      "caption": "deformity"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "most commonly encountered with injury to epiphyseal plate",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bar resection with interposition",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**< 50% physeal involvement**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**> 2 years or 2cm growth remaining**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
