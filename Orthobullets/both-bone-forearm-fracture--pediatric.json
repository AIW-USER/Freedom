{
  "title": "Both Bone Forearm Fracture - Pediatric",
  "url": "https://www.orthobullets.com/pediatrics/4126/both-bone-forearm-fracture--pediatric",
  "subtitle": "Updated: Jan 24 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Both Bone Forearm Fractures are one of the most common pediatric fractures, estimated around 40% of all pediatric fractures.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with plain radiographs of the forearm.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is closed reduction and casting for the majority of fractures. Surgical intervention is indicated for significantly displaced or angulated fractures in patients approaching skeletal maturity.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "one of the most common pediatric fractures estimated around 40% of all pediatric fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in males than females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "14% distal physis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "60% distal metaphysis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "20% midshaft",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "4% proximal third",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pathophysiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism of injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually occurs from **fall from a height, sporting event, or playground equipment injury**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "peak incidence is during peak bone turnover leading to a mismatch in bone remodeling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**floating elbow**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "15% present with an ipsilateral supracondylar fracture or \"floating elbow\"",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**nerve injury**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "1% have a neurologic injury most commonly to the median nerve",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physiologic apex lateral bowing of radius",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4126/images/radial_bowing.jpg",
                  "caption": "Physiologic apex lateral bowing of the radius"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "physiologic apex posterior bowing of ulna",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4126/images/proximal_ulnar_bow.jpg",
                  "caption": "Physiologic apex lateral bowing of the ulna"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Biceps and supinator flex and supinate the proximal fragment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Pronator teres and pronator quadratus pronate the distal fragment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Brachioradialis dorsiflexes and radially deviates the distal fragment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Soft tissues",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "periosteum is often intact on the concave side of the fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "interosseous membrane is taut in neutral to slight supination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Fracture type**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**Incomplete**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**greenstick fractures**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4126/images/greenstick.jpg",
                      "caption": "Greenstick"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "torus fracture",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "plastic deformation",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4126/images/plastic_deformation.jpg",
                      "caption": "x-ray of pediatric forearm showing an example of plastic deformation"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Complete fractures**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4126/images/completefx.jpg",
                  "caption": "complete"
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Fracture location and pattern",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "proximal-third, middle-third, distal-third",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "apex volar or apex dorsal pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "forearm pain and refuses to use arm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "swelling, deformity, and ecchymosis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4126/images/exam.jpg",
                      "caption": "Both bone forearm fracture"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "open fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "can be subtle poke-holes, and can often be missed if not evaluated by an orthopedic surgeon",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4126/images/poke.jpg",
                          "caption": "Poke hole"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "tenderness to palpation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "a complete examination of injured extremity for ipsilateral injury",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "assess for neurovascular injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "should rule out compartment syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral forearm x-rays",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "obtain orthogonal x-rays of elbow and wrist for ipsilateral injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fracture of both radius and ulna",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fracture of a single bone with plastic deformation of the other bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "no fracture with atypical bowing patterns suggesting plastic deformation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rotational malalignment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "the bicipital tuberosity and radial styloid should be 180 degrees apart on the AP view",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4126/images/ap_forearm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "ulnar styloid and coronoid are 180 degrees apart on the lateral view",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4126/images/lateral_forarm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "the diameter of proximal and distal fragments should match",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "thickness of cortices should match on proximal and distal fragments",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 4,
                  "bullets": [
                    {
                      "text": "**Table of Acceptable Reduction (Tolerances)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Angle (°)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Malrotation (°)*",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Bayonet Apposition*",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "0-10 years",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "<15",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "<45",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Yes, if <1cm short",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "≥ 10 years",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "<10",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "<30",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "No",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Approaching skeletal maturity (< 2y growth remaining)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "0",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "0",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "No",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction and immobilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**most pediatric forearm fractures can be treated without surgery when an adequate reduction is maintained**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "greenstick injuries",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "plastic deformation if NOT over 20 degrees",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bayonet apposition ok if <10 years and growth remains",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "closed reduction with analgesia and casting or splinting",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "options for analgesia vary from local block, regional block, conscious sedation, and general anesthesia",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "percutaneous vs open reduction and intramedullary nailing",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**unacceptable alignment** following closed reduction",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "angulation >15°, rotation >45° in children <10y",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "angulation >10°, rotation >30° in children >10y",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "bayonet apposition in children older than 10 years",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "both bone forearm fractures in children <13y",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "relative indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "highly displaced fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "open reduction and internal fixation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**unacceptable alignment** following closed reduction",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "angulation >15° and rotation >45° in children <10y",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "angulation >10° and rotation >30° in children >10y",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "bayonet apposition in children older than 10 years",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "open fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "refractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "both bone forearm fractures in children >13y (nearing skeletal maturity)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "relative indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "highly displaced fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "highly comminuted or segmental fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed Reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "plastic deformation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bone work",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "steady three-point bending to counteract bending deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "complications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "a fracture may occur with abrupt force rather than a slow gradual increase in force",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "greenstick fracture",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bone work",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "reduction is achieved through a combination of traction, direct pressure with thumb, rotation, and three-point bending",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "apex volar fractures are treated with pronation and apex dorsal fractures are treated with supination",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4126/images/threepoint.jpg",
                          "caption": "3 point bend"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "instrumentation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "reduction can be aided with finger traps and counterweights",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "casting maintains reduction through three-point molding and interosseous mold",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "no increase in loss of reduction with short arm versus long arm casting",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "there is an increase in loss of reduction with **increased cast index >0.8**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "complications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "compartment syndrome with excessive swelling and tight circumferential casting, can bivalve cast to mitigate this risk",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "remanipulation after closed reduction has been associated with increased initial fracture displacement",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Percutaneous vs. Open Intramedullary Nailing**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "the ulnar nail is inserted through the tip of the olecranon or through the anconeus to avoid damage to the ulnar nerve",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "the radial nail is inserted just proximal to the radial styloid or in the dorsal aspect of the distal radius proximal to the physis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "the dorsal central start point can cause injury to the extensor pollicis longus (EPL) tendon",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "bone work",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "reduce bone prior to passage of the nails",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "start with whichever bone is easiest to reduce",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "open fracture if unsuccessful passage with three attempts",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rod removal is often required 3 to 4 months after surgery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "multiple unsuccessful attempts at passage of the nail **increases the risk of compartment syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "shorter surgical time than ORIF",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "less blood loss than ORIF",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**equal union rates, radial bow, and rotation as ORIF**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction internal fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "often a combination of a volar approach and ulnar approach centered over the fracture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "soft tissue",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "minimize soft tissue damage and avoid excessive periosteal stripping",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "bone work",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "simple patterns can be rigidly stabilized after anatomic reduction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "comminuted patterns or bone loss requires relative stability over fracture sites",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rotational malalignment, nonunion, malunion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Refracture**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "occurs in 5-10% following both bone fractures",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "plate removal and greenstick patterns are risk factors for refracture",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**treatment consists of open reduction and internal fixation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Malunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "the incidence of symptomatic malunion seen as the loss of pronation and supination",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "may be related to initial reduction or delay in diagnosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "if symptomatic, treatment consists of corrective osteotomies",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Compartment syndrome**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "risk factors include high energy trauma or **multiple attempts at reduction and rod passage**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "if unsuccessful nail passage after 2-3 attempts, open the fracture site to visualize rod passage",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "treatment consists of forearm fasciotomies",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Synostosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "rare complication",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "occurs following head injury and high-energy trauma",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "resection rarely leads to an improved range of motion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
