  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "procedures associated with pulmonary embolism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hip fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "elective total hip arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "the greatest risk of activation of the clotting cascade during total hip arthroplasty occurs during insertion of the femoral component",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "elective total knee arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "spine fracture with paralysis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "**early** diagnosis and treatment is most important factor for survival",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Saddle emboli can present with death",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "PE should be suspected in postoperative patients with",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute onset pleuritic pain and dyspnea",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "tachypnea",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tachycardia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "EKG",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "most common finding on EKG during PE is sinus tachycardia",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "ABG",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "CXR",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "is usually normal",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "may show a prominent hilum",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "nuclear medicine **ventilation-perfusion scan** (V/Q)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most helpful for **dye-sensitive patients**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**pulmonary angiography**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "is gold standard",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**helical chest CT**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "widely considered first line imaging modality",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "continuous IV heparin infusion followed by warfarin therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "in most cases as first line treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "continuous IV heparin infusion typically **given for 7-10 days**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**monitor heparin therapy with PTT** (partial thromboplastin time)",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**warfarin therapy typically given for 3 months**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**monitor coumadin therapy with INR (international normalized ratio)**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "thrombolytics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "in specific cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "see anticoagulation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
