      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Length: 257mm Max. THA Stem Coverage: ≤100mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 292mm Max. THA Stem Coverage: 140mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 320mm Max. THA Stem Coverage: 165mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 371mm Max. THA Stem Coverage: 215mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Technical specifications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Material: Ti6Al4V ELI (plates and non locking screws) and Cobalt chrome (CoCr alloy locking screws)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Maximum THA Stem Coverage: ≤100mm to 215mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Variable angle locking within a 30° cone",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Left and right anatomic plate options",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Variable Angle Screw Trajectory",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The PeriPRO Proximal Femur Plates offer an evidence-based design with a variety of plate lengths, screw diameters and SOMA designed screw trajectories, allowing for the ability to achieve a desired construct.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
