    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "extrinsic tendon abnormalities **(frequently found in Blouth type IIIA)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**pollex abductus**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "flexor pollicis longus attaches to normal insertion and the extensor tendon",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/6083/images/pollex%20abductus.jpg",
                              "caption": "pollex abductus"
                            }
                          ],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**hypoplasia** of thenar musculature",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6083/images/thenar%20hypoplasia.jpg",
                          "caption": "example of thenar hypoplasia"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "variable extensor pollicis longus tendon insertion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "absence of skin creases indicates muscle or tendon abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "excessive abduction of MCP joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "range of motion and instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ulnar collateral ligament laxity",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**web-space tightness**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "evaluation for **associated anomalies** is essential",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cardiac",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "auscultation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "echocardiography",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "kidneys",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "ultrasound",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "abdomen",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "ultrasound",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
