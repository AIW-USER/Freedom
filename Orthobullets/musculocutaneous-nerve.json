    {
      "text": "Course",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Pierces Coracobrachialis**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "pierces coracobrachialis 3-8 cm distal to coracoid",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "gives branch to coracobrachialis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Splits biceps and brachialis**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "runs between biceps and brachialis in the anterior compartment to enter the lateral aspect of the arm",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "gives branch to biceps and brachialis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Pierces deep fascia lateral to biceps brachii**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "a little above the elbow it pierces the deep fascia lateral to the tendon of the biceps brachii",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Becomes lateral antebrachial cutaneous nerve (terminal branch)**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "emerges lateral to distal bicep tendon and brachoradialis to form lateral antebrachial cutaneous nerve",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Injury & Clinical Conditions",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Musculocutaneous Nerve Inury**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "usually iatrogenic **during deltopectoral approach** with dissection or retraction medial to conjoint tendon",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
