    {
      "text": "Inspection",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Skin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "discoloration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "erythema (cellulitis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "white (arterial insufficiency)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "blue/purple (venous congestion)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "black spots (melanoma)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "trophic changes (i.e. increased hair growth or altered sweat production)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can represent derangement of sympathetic nervous system",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "scars/wounds",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Swelling",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Muscle atrophy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**thenar atrophy**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/thenars_2.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "median nerve involvement",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "caused by carpal tunnel syndrome",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**interossei atrophy**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/interossei_atrophy.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "ulnar nerve involvement",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "caused by cubital tunnel or cervical radiculopathy",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "subcutaneous atrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "locally post-steroid injection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Deformity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "asymmetry",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "angulation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rotation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "absence of normal anatomy (previous amputation)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cascade sign",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fingers converge toward the scaphoid tubercle when flexed at the MCPJ and PIPJ",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6008/images/cascade.jpg",
                      "caption": "Fingers converge toward the scaphoid tubercle when flexed at the MCPJ and PIPJ"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "if one or more fingers do not converge, then trauma to the digits has likely altered normal alignment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Palpation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Masses (ganglions, nodules)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6008/images/dwg.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": []
        },
        {
          "text": "Temperature",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "warm: infection, inflammation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cool: vascular pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Tenderness",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Crepitus (fracture)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Clicking or snapping (tendonitis)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Joint effusion (infection, inflammation, trauma)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Range of Motion",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Active and passive",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Finger",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/finflex.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "MCP: 0° extension to 85° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "PIP: 0° extension to 110° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "DIP: 0° extension to 65° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Wrist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "60° flexion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6008/images/wristflex.jpg",
                      "caption": "Wrist range of motion"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "60° extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "50° radioulnar deviation arc",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6008/images/wrist_dev.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Neurovascular Exam",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Sensation",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6008/images/handsense.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "two-point discrimination",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Motor",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radial nerve: test thumb IP joint extension against resistence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "median nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "recurrent motor branch: palmar abduction of thumb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "anterior interosseous branch: flexion of thumb IP and index DIP (\"A-OK sign\")",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ulnar nerve: cross-fingers or abduct fingers against resistence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Vascular",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radial pulse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ulnar pulse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Allen's test",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "capillary refill",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Special Tests",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Palpation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "grind test",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/grind.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "used to test for pathology at the thumb carpometacarpal joint (CMC)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "examiners applies axial load to first metacarpal and rotates or \"grinds\" it",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "positive findings: pain, crepitus, instability",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Finkelstein's",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/fink.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "used to test for DeQuervain's tenosynovitis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "patient makes fist with fingers overlying thumb",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "examiner gently ulnarly deviates the wrist",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "positive findings: pain along the 1st compartment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Range of motion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flexor profundus",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/fdp.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "used to test continuity of FDP tendons",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "MCP + PIP joints held in extension while patient asked to flex FDP, thereby isolating FDP (from FDS) as the only tendon capable of flexing the finger",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "flexor sublimus",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/fds.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "used to test for continuity of FDS tendon",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "MCP, PIP and DIP of all fingers held in extension with hand flat and palm up; the finger to be tested is then allowed to flex at PIP joint.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Bunnel's test",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/intrin.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "examiner passively flexes PIPJ twice",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first with MCP in extension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "next with MCP held in flexion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**intrinsic tightness** present if PIP can be flexed easily when MCP is flexed but NOT when MCP is extended",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**extrinsic tightness** present if PIP can be flexed easily when MCP is extended but NOT when MCP is flexed",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Stability assessment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "scaphoid shift test (Watson's test)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "tests for scapholunate ligament tear",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "examiner places thumb on distal pole of scaphoid on palmar side of wrist and applies constant pressure as the wrist is radially and ulnarly deviated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dorsal wrist pain or \"clunk\" may indicate instability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "lunotriquetral ballottement",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "tests for lunotriquetral ligament tear",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "examiner secures the pisotriquetral unit with the thumb and index finger of one hand and the lunate with the other hand",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "anterior and posterior stresses are placed on the LT joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "positive findings are increased laxity and accompanying pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "midcarpal instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "examiner stabilizes distal radius and ulna with non-dominant hand and moves patients wrist from radial deviation to ulnar deviation, whilst applying an axial load",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "a positive test occurs when a clunk is felt when the wrist is ulnarly deviated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ulnar carpal abutement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tests for TFCC tear or ulnar-carpal impingement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "examiner ulnarly deviates wrist with axial compression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "positive if test reproduces pain or a 'pop' or 'click' is heard",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Gamekeeper's",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/game.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "tests for ulnar collateral ligament tear at MCP of thumb",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "examiner stresses first MCPJ into radial deviation with MCPJ in fully flexed and extended positions",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "positive test if > 30 degrees of laxity in both positions (or gross laxity compared to other side)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Nerve assessment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Tinel's",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/tin.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "tests for carpal tunnel syndrome",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "examiner percusses with two fingers over distal palmar crease in the midline",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "positive if patient reports paresthesias in median nerve distribution",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Phalen's",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/phalens.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "tests for carpal tunnel syndrome",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "with the hands pointed up, the patient's wrist is allowed to flex by gravity in palmar flexion for 2 minutes maximum",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "positive if patient reports paresthesias in median nerve distribution",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Froment's sign",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tests for ulnar nerve motor weakness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "patient asked to hold a piece of paper between thumb and radial side of index",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "positive if as the paper is pulled away by the examiner the patient flexes the thumb IP joint in an attempt to hold on to paper",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6008/images/froment.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Wartenberg's sign",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/wartenberg.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "tests ulnar nerve motor weakness",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "patient asked to hold fingers fully adducted with MCP, PIP, and DIP joints fully extended",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "positive if small finger drifts away from others into abduction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Jeanne's sign",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6008/images/jean.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "tests for ulnar nerve motor weakness",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ask patient to demosntrate key pinch",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "positive finding if patients first MCP joint is hyperextended",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
