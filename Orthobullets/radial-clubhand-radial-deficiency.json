{
  "title": "Radial Clubhand (radial deficiency)",
  "url": "https://www.orthobullets.com/hand/6067/radial-clubhand-radial-deficiency",
  "subtitle": "Updated: Feb 22 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radial Clubhand is a rare birth defect characterized by a deformity of hand, with perpendicular relationship between forearm and wrist, and an absent thumb.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made on physical exam.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment may be observation or surgical reconstruction when the child is around 6 months of age.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "EPIDEMIOLOGY",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "1 per 100,000",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "anatomic location",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "bilateral in 50-72%",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "thumb usually deficient as well",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "likely related to **sonic hedgehog gene**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "most commonly result from **spontaneous mutations**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Associated with",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**TAR**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "autosomal recessive condition with thrombocytopenia and absent radius",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "different in that **thumb is typically present**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6067/images/TAR%20-%20xray%20-%20colorado_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Fanconi's anemia**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "autosomal recessive condition with aplastic anemia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "Fanconi screen and chromosomal breakage test to screen",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "treatment is bone marrow transplant",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**Holt-Oram syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "autosomal dominant condition characterized by cardiac defects",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**VACTERL Syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "vertebral anomalies, anal atresia, cardiac abnormalities, tracheoesophageal fistula, renal agenesis, and limb defects)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**VATER Syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "vertebral anomalies, anal atresia, tracheoesophageal fistula, esophageal atresia, renal agenesis)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Bayne and Klug Classification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Deficient distal radial epiphysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6067/images/classification%20def.jpg",
                          "caption": "Bayne and Klug classification"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Deficient distal and proximal radial epiphyses",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6067/images/classification%20def.jpg",
                          "caption": "Bayne and Klug classification"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Present proximally (partial aplasia)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6067/images/classification%20def.jpg",
                          "caption": "Bayne and Klug classification"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type IV",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Completely absent (total aplasia - most common)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6067/images/classification%20def.jpg",
                          "caption": "Bayne and Klug classification"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "deformity of hand with perpendicular relationship between forearm and wrist",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6067/images/Case%20A%20-%20clinical%20photo%20-%20Kosin_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "**absent thumb**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "perform careful elbow examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "entire radius and often thumb is absent",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6067/images/xray%20-%20colorado_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Laboratory",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "must order CBC, renal ultrasound, and echocardiogram to screen for associated conditions",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "passive stretching",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "target tight radial-sided structures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indicated if **absent elbow motion or biceps deficiency**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "hand deformity allows for extra reach to mouth in presence of a stiff elbow",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hand centralization",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**good elbow motion** and biceps function intact",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "done at 6-12 months of age",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "followed by tendon transfers",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "contraindications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "older patient with good function",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "patients with elbow extension contracture who rely on radial deviation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "proximate terminal condition",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "involves resection of varying amount of carpus, shortening of ECU, and, if needed, an angular osteotomy of the ulna (be sure to spare ulnar distal physis)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "may do as two stage procedure in combination with a distraction external fixator",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "if thumb deformity then combine with thumb reconstruction at 18 months of age",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
