    {
      "text": "Magnetic Resonance Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "MRI is best for evaluating soft tissue structures and evaluating bone contusions or trabelcular microfractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "the stronger the magnet, the higher the intrinsic signal-to-noise ratio (e.g. a 3 Tesla MRI machine has 9x the proton energy of a 1.5 Tesla MRI machine)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**T1-weighted sequence**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "uses a short repetition time (TR) and short echo time(TE)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bright= fat",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dark= fluid, bone, ligament, bone marrow, and fibrocartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "often combined with MR arthrograms",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "useful to visualize",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "Hill Sachs Lesion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**T2-weighted sequence**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "uses a long TR and long TE",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bright= fluid (inflammation) and bone marrow",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "dark= bone, ligament, muscle, and fibrocartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "useful to visualize",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rotator cuff pathology",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "full thickness tear",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3038/images/shoulder%20full%20thicknes%20rct%20mri.jpg",
                          "caption": "Shows full thickness RCT"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Short tau inversion recovery (STIR)**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "Fat saturation (e.g. suppression) technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "technique that reduces signal from fat and increases signal from fluid and edema",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
