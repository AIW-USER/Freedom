    {
      "text": "Computed Tomography",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "provides better detail of cortical and trabecular bone structures than MRI at cost of higher radiation exposure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "there for optimal for visualization of bony defects",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "magnification artifacts that are associated with radiographs do not occur with CT",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
