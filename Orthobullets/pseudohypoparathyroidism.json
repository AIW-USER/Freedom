    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptom",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms of **hypocalcemia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "paresthesia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fingertip, toes, perioral",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "abdominal pain, biliary colic",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "muscle cramps, tetany",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dyspnea (laryngospasm, bronchospasm)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "convulsions",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "mental status changes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "anxiety, fatigue, mood swings",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**findings of tetany**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**Trousseau's Sign**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "carpopedal spasm after blood pressure readings",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "inflate BP cuff 20mmHg above systolic BP x 3-5min",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "hand adopts a MCP flexed, DIP and PIP extended position",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "more sensitive than Chvostek's sign",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Chvostek's Sign**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**facial muscle contractions after tapping on the facial nerve**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "dermatologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fungal nail infections",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hair loss",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "blotchy skin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "pigment loss, vitiligo",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Laboratory",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**high PTH**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**low calcium**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "high phosphate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "low vit D",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Ellsworth-Howard test**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "method to differentiate type 1 and type 2 by administering exogenous PTH",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "Type 1",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "will show no increase in urinary cAMP and phosphate",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Type 2",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "will show increased excretion of urinary cAMP and phosphate",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Causes of hypocalcemia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**renal osteodystrophy (low Ca, high PTH, high phosphate, high ALP)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "hypoparathyrodism (low Ca, **low PTH, high phosphate)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**pseudopseuodohypoparathyroidism**",
              "table": null,
