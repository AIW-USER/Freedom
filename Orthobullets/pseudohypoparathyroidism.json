              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Type 1b**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "defect in GNAS1 (Gsα protein)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
