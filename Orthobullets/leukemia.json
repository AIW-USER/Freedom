{
  "title": "Leukemia",
  "url": "https://www.orthobullets.com/pathology/8026/leukemia",
  "subtitle": "Updated: Dec 19 2023",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Leukemia is a malignant neoplastic proliferation of lymphocytes and lymphocyte precursors. Patients typically present before the age of 4 with recurrent infections, bleeding, fatigue, and lymphadenopathy.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with a bone marrow biopsy.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually chemotherapy.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Forms include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**acute lymphocytic leukemia (ALL)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "neoplastic proliferation of lymphocytes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**actue myeloblastic leukemia (AML)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "neoplastic proliferation of myeloblasts",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**chronic myelocytic leukemia (CML)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**neoplastic mature myeloid cells (granulocytes)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**chronic lymphocytic leukemia (CLL)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "neoplastic proliferation of naive B cells",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "ALL",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "represents 80% of cases of leukemia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "peak incidence of **4 years of age**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "causes dimeralization of bones, periostitis, and lytic lesions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**positive TdT nuclear staining**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "T-ALL",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "proliferation of **T-lymphocytes**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "presents in teenagers",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "B-ALL",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "proliferation of **B-lymphocytes**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**12;21** translocation most commonly seen in **children**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**9;22** translocation most commonly seen in **adults**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "AML",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly seen in **older adults** (5th-6th decade)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "marrow failure secondary to crowding out of normal hematopoiesis by neoplastic proliferation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**myeloblasts with Auer rods**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8026/images/2009-exam-3-image-4.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "Acute Promyelocytic Leukemia (APL)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "caused by **15;17 translocation**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**disrupts retinoic acid receptor (RAR)** required for myeloblast maturation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Acute megakaryoblastic leukemia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "associated with **Down syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**younger than 5 years**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Acute monocytic leukemia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**infiltration of the gums**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CML",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "onset usually in **older adults** (5th-6th decade)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**9;22 translocation**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8026/images/philadelphia_chromosome.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "known as the **Philadelphia chromosome**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "results in a fusion **tyrosine kinase** with increased activity (**bcr-abl**)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "increased levels of bcr-abl leads to **↑ cell division and inhibition of apoptosis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CLL",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly seen in **older adults** (5th-6th decade)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "insidious onset of symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**smudge cells on peripheral smear**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8026/images/heme030.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**recurrent infections**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**bleeding**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**fatigue**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**lymphadenopathy (more common in CLL)**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hepatosplenomegaly**",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "secondary to leukemic infiltrate",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**lymphadenopathy**",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "secondary to leukemic infiltrate",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "chemotherapy",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "T-ALL & B-ALL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "may predispose to pathologic fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**all-trans-retinoic acidfor APL (AML subtype)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**imatinib for CML**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
