{
  "title": "Equinovalgus Foot",
  "url": "https://www.orthobullets.com/pediatrics/4065/equinovalgus-foot",
  "subtitle": "Updated: Apr 20 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Equinovalgus Foot is an acquired foot deformity commonly seen in pediatric patients with cerebral palsy, spina bifida, or idiopathic flatfoot, that present with a equinovalgus foot deformity.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with presence of a valgus heel deformity with lateral calcaneal displacement and compensatory forefoot supination.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment ranges from bracing to surgical osteotomies and arthrodesis depending on the underlying etiology, severity of deformity, and rigidity of contracture.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common foot deformity seen with",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**idiopathic flatfoot (if the heel cord is tight)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**cerebral palsy (spastic diplegia and quadriplegia)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**spina bifida**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**fibular hemimelia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "typically bilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary deformities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**midfoot abduction**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**hindfoot valgus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**equinus contracture**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "secondary deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "forefoot supination",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "muscle imbalances",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**spasticity and/or overpull of**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "peroneals",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "gastoc-soleus complex",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**weakness of**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "posterior tibialis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "anterior tibialis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathomechanics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "results in **lever arm dysfunction** during gait",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "due to shortened lever arm and non-rigid lever",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "patient is bearing weight on the medial border of the foot and possibly the talar head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "external rotation of the foot creates",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "instability during push off",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "external foot progression",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "difficulty with brace and/or shoe wear",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**painful callus over talar head** secondary to weightbearing",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection and palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**valgus heel deformity with lateral calcaneal displacement**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "seen when viewing feet from posterior",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4065/images/equinovalgus.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**prominent talar head**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "appreciated in the medial hindfoot",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "midfoot break is common",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**compensatory forefoot supination**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "is common (best appreciated when hindfoot valgus is corrected manually during physical exam)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**hallux valgus often develops over time**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**the medial and lateral malleoli are palpated -- the lateral malleolus should be distal to the medial malleolus, unless there is ankle valgus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**motion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "flexibility of the deformity is checked",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the hindfoot valgus deformity is manually corrected (by inverting the hindfoot) in order to check for true ankle dorsiflexion and achilles contracture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "a valgus heel can mask an equinus contracture by allowing for dorsiflexion through the subtalar joint",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "weight-bearing AP and lateral foot x-rays",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "weight-bearing AP radiographs of the ankles are obtained",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "used to rule out ankle valgus if suspected clinically (based on palpation of the malleoli, as above)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**\"talar sag\"** (talus tilted inferiorly)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4065/images/equinovalgusxr.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicates collapse of the arch",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**decrease in the calcaneal pitch**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "due to heel cord tightness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**bracing and physical therapy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**flexible deformities**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**technique**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**ankle foot orthosis** or supramalleolar orthosis -- should be fabricated with hindfoot in subtalar neutral",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "serial casting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "often helpful for deformities recalcitrant to bracing, therapy and home program",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "calcaneal osteotomy with soft tissue procedure",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "rigid deformities which have failed conservative treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "types",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "calcaneal slide or calcaneal lengthening osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "fusions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "severe rigid deformities, particularly in the presence of severe midfoot breaks in limited ambulators",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "types",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**talonavicular fusion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "indicated if severe midfoot break in neuromuscular patients with low function",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**subtalar fusion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "consider in severe valgus foot, though rarely needed",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "subtalar arthroeresis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4065/images/ste.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "poor outcomes and contraindicated",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Calcaneal osteotomy with soft tissue procedure**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "soft tissue procedures",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**gastrocnemius recession or achilles tendon lengthening for equinus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**peroneus brevis lengthening, if performing calcaneal lengtheing osteotomy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "bony procedures",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**calcaneal osteotomy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "medial slide osteotomy or calcaneal lengthening osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral column lengthening procedure",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "performed most commonly through calcaneus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "trapezoidal bone graft",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "medial reefing of medial structures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "may need to perform medial column osteotomy if fixed supination present after calcaneal osteotomy completed",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial calcaneal sliding osteotomy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "calcaneus is slid 1/3 to 1/2 calcaneal diameter",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Grice procedure**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4065/images/grice.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "extra-articular subtalar arthrodesis via a lateral approach",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "place bone graft in lateral subtalar joint to block valgus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**does not interfere with tarsal bone growth**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**uncommonly performed currently**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Overcorrection** (resultant varus deformity)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "most common complication",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "more common in children with neuromuscular disease",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Recurrence**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**more common if forefoot supination not corrected at time of primary surgery**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Sural nerve injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "at risk during lateral calcaneal osteotomy approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Overlengthening of lateral column**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "results in a painful lateral forefoot secondary to overload",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Wound dehiscence**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "risk minimized by use of non-absorbable sutures",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
