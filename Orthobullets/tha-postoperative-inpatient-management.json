{
  "title": "THA Postoperative Inpatient Management",
  "url": "https://www.orthobullets.com/recon/422739/tha-postoperative-inpatient-management",
  "subtitle": "Updated: Jun 10 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Postoperative inpatient management requires a coordinated effort from",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physician (orthopedic surgeon +/- hospitalist)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "physical therapist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "occupational therapist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "case manager",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nursing staff",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patient and patient's family",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Care can be broken down into different phases including",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**preoperative teaching**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**inpatient acute care** (hospital) - this topic",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**inpatient extended care** (rehab/SNF)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**outpatient home care**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Inpatient Acute Care (Hospital)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pain management",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "NSAIDS and Acetaminphen are commonly given immediately before procedure to reduce postoperative pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Some use Gabapentin and opiods but the data to support this is not as robust",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "intraoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "regional anesthesia (spinal and/or epidural)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**preferred over general anesthesia**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "periarticular multimodal drug injection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "decrease postoperative pain with minimal risks",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "postoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**multimodal oral drug therapy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "gold standard",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Medical management",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical stress response can lead to exacerbation of underlying medical conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "these conditions may require consultation with a hospitalist for workup and treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypertension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "defined as >140/90mm Hg however no set threshold for treatment",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "evaluate for reversible causes (missed medication, pain or anxiety, constipation, etc)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "consider increasing home dose, IV antihypertensives (HTN emergency), or oral antihypertensives (preferred)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hypotension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "defined as systolic BP <90 or drop in SBP by 40 from baseline",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**most common cause is intravascular volume depletion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "treatment should include holding antihypertensives, IV fluid administration, +/- further testing (CBC/BMP, EKG, troponins, CXR, CTPE)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hypoxia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "a combination of decreased cardiac output and oxygen tissue uptake results in hypoxia",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**all patients should be encouraged to use incentive spirometry or other pulmonary hygiene**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/422739/images/incentive_spirometer-fig_1-en.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "may be a sign of acute cardiac ischemia, exacerbation of COPD/asthma, heart failure exacerbation, or PE",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "oxygen supplementation to keep O2 saturation >90% with those patients with an inability to maintain O2 saturation and respiratory distress should be taken to an intensive care unit",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "decreased urine output",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most common causes are hypovolemia, urinary retention and acute kidney injury (AKI)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "**urinary retention**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "bladder dysfunction or urethral obstruction",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**acute kidney injury**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "prerenal (hypovolemia/hypotension), intrinsic, postrenal (urinary tract obstruction)",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "treatment for urinary retention includes straight cath, minimize anticholinergic/opioids, and consider tamsulosin",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "treatment for AKI includes correcting reversible cause, maintaining euvolemia, and remove nephrotoxics agents, renal dosing of other medications",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "altered mental status",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "mental status change that may wax and wane",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "identify underlying causes based on physical exam, laboratory values, and medication review",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**reorient and normalize sleep wake-cycle**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chest pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "differential can include angina (myocardial ischemia), pleuritic chest pain, dyspepsia (epigastric discomfort), or chest wall pain",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "if cardiac origin is suspected check troponins and EKG",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "treatment can include immediate aspirin and cardiology eval (myocardial ischemia), NSAIDs (pleuritic or chest wall pain), or antiacid/PPI (dyspepsia)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "nausea, vomiting, and abdominal pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**postoperative nausea and vomiting (PONV)** is a side effect of opiates and anesthetic agents",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "treatment includes antiemetics, hydration, and electrolyte replacement",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "ileus may require placement of a nasogastric tube",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**Ogilvie's syndrome** results in colonic obstruction without underlying mechanical cause and is a scenario where laxatives may make symptoms worse",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/422739/images/colonic_pseudo-obstruction.jpg",
                          "caption": "An x-ray example of colonic pseudo-obstruction consistent with Ogilvie&#39;s syndrome"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "postoperative fever",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "cytokine-mediated fever commonly occurs from surgical inflammation from orthopedic surgery on day 1-2",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**fevers after POD#3 have numerous causes broadly classified as infectious** (UTI, cellulitis, pneumonia, C. diff, etc) **or noninfectious** (PE, withdrawal, transfusion reaction, medication reaction, etc)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "observation is appropriate up to POD#2 if patients appear well",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "empiric antibiotics should be reserved for those patients who upon focused investigation have an infectious source of postoperative fever",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical therapy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "should start the day of surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decrease LOS",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "reduces pain and improves function",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "exercises",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bed supported ROM exercises - ankle pumps, knee bends, glut sets, quad contractions, hip abduction, straight-leg raise",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/422739/images/total_hip_inpatient_therapy_exercises.jpg",
                      "caption": "Bed exercises for the post op THA patient"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "sit to edge of bed, sit in a chair, standing with a walker, gait training",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "stairs (up with the good, down with the bad)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "going up should lead with nonoperative leg",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "going down should lead with operative leg",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ambulation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "walkers should be used in the immediate postoperative period",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/422739/images/total_hip_inpatient_rehab_walker.jpg",
                          "caption": "Total hip arthroplasty patient using a walker following surgery"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Occupational therapy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activities of daily living should be assisted by devices such as raised toilet seats, shower seats, and raised sitting chairs",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/422739/images/raised_toilet_seat.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "goals of therapy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sitting upright -->",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "gait training, ambulation with walker, out of bed to chair -->",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "transfers, gait normalization -->",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "independence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Discharge home criteria**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "independent ambulation with assistive device (50-100ft)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "independent transfers",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "independent ADLs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "2 stairs with supervision",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**follows dislocation precautions if present**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "appropriate home assistance (spouse, family, visiting nurses)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Inpatient Extended Care (Rehab)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Earlier discharge to rehab from hospital associated with **improved outcomes**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Discharge criteria to home similar to those in hospital",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Levels of rehab include inpatient rehab and skilled nursing facility(SNF) or subacute rehab (SAR)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/422739/images/inpatientrehabversussnf.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": []
        },
        {
          "text": "**SNF/SAR**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "those patients who do not meet the above discharge criteria and do not qualify for inpatient rehab",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "considered a complement to acute care hospital and more cost-effective than inpatient rehab",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**inpatient rehab**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "for total joint arthroplasty patients must be able to participate in 3 hours of therapy/day and be >85 yo, BMI >50, or have undergone bilateral total joint arthroplasty",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "intensive rehabilitation services",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "rarely utilized following total joint arthroplasty",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
