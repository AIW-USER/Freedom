{
  "title": "Fingertip Amputations & Finger Flaps",
  "url": "https://www.orthobullets.com/hand/6060/fingertip-amputations-and-finger-flaps",
  "subtitle": "Updated: Jan 22 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Injury to the finger with variable involvement of soft tissue, bone, and tendon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Goals of treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**sensate** tip",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**durable** tip",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**bone support** for nail growth",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Prognosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "improper treatment may result in **stiffness** and long-term functional loss",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fingertip anatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6060/images/cuticles%20labels.jpg",
              "caption": "nail top view"
            },
            {
              "src": "https://upload.orthobullets.com/topic/6060/images/fingertip%20anatomy.jpg",
              "caption": "fingertip anatomy"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "eponychium",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "soft tissue on the dorsal surface just proximal to the nail",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "paronychium",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lateral nail folds",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "hyponychium",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "plug of keratinous material situated beneath the distal edge of the nail where the nail bed meets the skin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "lunula",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "white portion of the proximal nail",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "demarcates the sterile from germinal matrix beneath",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "nail bed",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**sterile matrix**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "where the nail adheres to the nail bed",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**germinal matrix**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "proximal to the sterile matrix",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "responsible for 90% of nail growth",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "avulsion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "laceration",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "crush",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often, **characteristics of laceration** will guide management",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "presence or absence of exposed bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "flexor and extensor tendon involvement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "required imaging",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP/lateral radiographs to assess for **bony involvement**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "healing by secondary intention",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "adults and children with no bone or tendon exposed with < 2cm of skin loss",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**children with exposed bone**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary closure (revision amputation)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "finger amputation with exposed bone and the ability to rongeur bone proximally **without compromising bony support to nail bed**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "full thickness skin grafting from hypothenar region",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fingertip amputation with no exposed bone and **> 2cm of tissue loss**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "flap reconstruction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "exposed bone or tendon where rongeuring bone proximally is not an option",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Surgical Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Secondary intention**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "initial treatment with irrigation and soft dressing",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "after 7-10 days, soaks in water-peroxide solution daily followed by application of soft dressing and fingertip protector",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "complete healing takes **3-5 weeks**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Full thickness skin grafting from hypothenar region**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "split thickness grafts not used because they are",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**contractile**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**tender**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**less durable**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "donor site is closed primarily",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "graft is sutured over defect",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "cotton ball secured over graft helps maintain coaptation with underlying tissue",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "post-operative care",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cotton ball removed after 7 days",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "range of motion encouraged after 7 days",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Primary closure with removal of exposed bone (revision amputation)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "must **ablate remaining nail matrix**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "prevents formation of irritating nail remnants",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "if flexor or extensor tendon insertions cannot be preserve, **disarticulate DIP joint**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**transect digital nerves and remaining tendons** as proximal as possible",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "palmar skin is brought over bone and sutured to dorsal skin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Flap reconstruction (see below)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Flap Techniques By Region",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Flap treatment options determined by location of lesion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "**1**.Finger TipStraight or Dorsal Oblique laceration •V-Y Advancement flap •**Digital island artery**Volar Oblique laceration •Cross finger flap**(if > 30 yrs)** •Thenar flap**(if< 30 yrs)** • Digital island arteryreverse cross finger (for nail bed sterile matrix and eponychial fold losses) 2.Volar Proximal Finger •Cross finger (if > 30 yrs) • Axial flag flap from long finger 3.Dorsal Proximal Finger & MCP •Reverse cross finger • Axial flag flap from long finger 4.Volar Thumb •Moberg Advancement Volar Flap (if < 2 cm) • FDMA (if > 2 cm) • Neurovascular Island Flap (up to 4 cm) 5.Dorsal Thumb •First Dorsal Metacarpal Artery (FDMA) flap 6.First Web Space •Z-plasty with 60 degree flaps •**Posterior interosseous fasciocutaneous flap** (if > 75%) 7.Dorsal Hand •Groin Flap",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Straight or Dorsal Oblique laceration •V-Y Advancement flap •**Digital island artery**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Volar Oblique laceration •Cross finger flap**(if > 30 yrs)** •Thenar flap**(if< 30 yrs)** • Digital island arteryreverse cross finger (for nail bed sterile matrix and eponychial fold losses)",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "•Cross finger (if > 30 yrs) • Axial flag flap from long finger",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "•Reverse cross finger • Axial flag flap from long finger",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "•Moberg Advancement Volar Flap (if < 2 cm) • FDMA (if > 2 cm) • Neurovascular Island Flap (up to 4 cm)",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "•First Dorsal Metacarpal Artery (FDMA) flap",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "•Z-plasty with 60 degree flaps •**Posterior interosseous fasciocutaneous flap** (if > 75%)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "•Groin Flap",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Flap Reconstruction Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**V-Y advancement flap**",
          "table": null,
          "images": [
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Flaps/Images/V-Y%20advancement.jpg",
              "caption": ""
            },
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/VY/VY%20sequence.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**straight or dorsal oblique finger tip** lacerations",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Digital island artery**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "straight or dorsal oblique finger tip lacerations",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "volar oblique finger tip lacerations",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "available digital artery and transverse anastamotic arch blood supply",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "best axial pattern flap",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Cross finger flap**",
          "table": null,
          "images": [
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/Cross%20Finger/Illustration.jpg",
              "caption": ""
            },
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/Cross%20Finger/Sequence.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**volar oblique finger tip lacerations** in patients > 30 years",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "leads to less stiffness",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Reverse cross finger flap**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "dorsal finger & MCP lacerations",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Thenar flap**",
          "table": null,
          "images": [
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/Thenar/Thenar%20sequence.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "volar oblique finger tip lacerations to index or middle finger in patients < 30 years",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "improved cosmesis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Axial flag flap from long finger**",
          "table": null,
          "images": [
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/Axial%20Flag/Illustration.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "volar proximal finger",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "dorsal proximal finger & MCP lacerations",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Moberg advancement volar flap**",
          "table": null,
          "images": [
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/Illustration%20-%20emedicine.jpg",
              "caption": ""
            },
            {
              "src": "https://img.orthobullets.com/Hand/Microsurgery/Fingertip%20amputations/Images/Moberg%20Advancement%20Flap/Sequence.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "volar thumb if < 2 cm",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Neurovascular island flap",
          "table": null,
