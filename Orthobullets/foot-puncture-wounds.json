{
  "title": "Foot Puncture Wounds",
  "url": "https://www.orthobullets.com/foot-and-ankle/7026/foot-puncture-wounds",
  "subtitle": "Updated: Dec 4 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Foot Puncture Wounds are common work place injuries which are at high risk for soft tissue infection and development of osteomyelitis.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is clinical with inspection of the plantar foot for the puncture site as well as surrounding erythema and drainage. MRI studies are indicated when there is concern for osteomyelitis.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment can be observation with antibiotics or surgical debridement depending on chronicity of wound, patient comorbidities and presence of soft tissue infection or osteomyelitis.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "2",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "common injury in certain work-places (i.e. construction sites)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "approximately 10% develop infection",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "approximately 1-2% develop osteomyelitis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually stepping on a nail or stick through a sock/sole of foot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "microbiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**most common cause of soft tissue infection is Staph aureus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**most common cause of osteomyelitis is pseudomonas**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often present weeks to a month after initial injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "limp",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "swollen and tender foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obvious wound, with or without tract",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7026/images/screen_shot_2014-10-20_at_1.33.14_pm.jpg",
                  "caption": "puncture wound"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "well-demarcated erythema",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may present with lymphadenopathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "required views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ap and lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "normal early",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bone destruction seen later",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "exclude presence of foreign body",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "obtain prior to operative irrigation and debridement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "used to rule out osteomyelitis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may occur in **1-2%**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**tetanus booster,** prophylactic antibiotics (controversial)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "recent (within hours) puncture wound with no evidence of infection",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "if open wound, bedside irrigation and debridement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "no standard prophylactic abx for acute (within hours) injury, but should cover for Pseudomonas",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical debridement",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "late/delayed presentation with deep infection with/without osteomyelitis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "foreign body removal",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "no improvement with PO antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "tract and soft tissue debridement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "deep culture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "bony curretage (if osteo)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "packing with wick to allow for healing by secondary intention",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "postoperative",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "follow with IV antibiotics (coverage for pseudomonas)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "convert to PO antibiotics once clinical picture improves",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "antibiotic choice",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "preferred antibiotics",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "ciprofloxacin or levofloxacin (except in children)",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "alternative antibiotics: ceftazidime or cefepime",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
