            },
            {
              "text": "surgical",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "use of an uncemented stem; demonstrated by multiple RCTs and registry studies",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "undersized femoral components",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "use of a **slip-taper stem** if performing cemented arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
