    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ground level fall",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "history of startup pain may indicate antecedent loosening",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "progressive pain, constitutional symptoms, or wound complications should raise concern for prosthetic joint infection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inability to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shortened, externally rotated limb",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain with log roll",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "a thorough examination of prior scars for surgical planning",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral femoral radiographs to evaluate the fracture pattern, displacement, and implant position.",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AP pelvis if planning revision of the component",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "evaluate implant stability and detailed fracture morphology.",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "better fidelity in evaluating the integrity of the cement mantle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "1",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "protected weightbearing with restricted abduction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Vancouver AG fractures (<2 cm displacement)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "Vancouver AL fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "protected weight bearing",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "consider early weightbearing with walker support in the elderly",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "restriction of active hip abduction x 6-12 weeks for Vancouver AG fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "open reduction internal fixation (ORIF) greater trochanter",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Vancouver AG (>2 cm displacement)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "approaches",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "lateral approach to the proximal femur",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "use of claw plates, cables, or tension band wiring",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "if performing revision (see below) with certain modular stems, can use a trochanteric bolt or attachment",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/423186/images/c53830dc-de63-45bb-b124-510e6bb097de_trochantericbolt.jpg",
                          "caption": "trochanteric bolt (modular fluted tapered stem)"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "open reduction internal fixation (ORIF) femoral diaphysis/metaphysis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423186/images/f5e9bf41-576f-475b-b502-1938acaaf8a7_hemiorif.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Vancouver B1 fractures",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/423186/images/1855f004-917b-46c2-9734-591d19d74c99_hemivancb1.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Vancouver C fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**Vancouver B2 fractures (controversial)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "Favorable outcomes in select B2 fractures, particularly in elderly, lower demand patients",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "favorable factors",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "simple fracture pattern",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "anatomic reduction",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "no prior stem loosening",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "intact bone-cement interface",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "timing",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "performed as soon as medically optimized",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "approaches",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "lateral approach (subvastus)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "MIPO",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "polyaxial locking plates",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "proximal fixation with combination cables, cerclage, or screws",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/423186/images/82df2907-d777-44a1-98e5-891b61e7cc8b_periproshemiproximalfixation.jpg",
                          "caption": "Combined use of proximal screws and cerclage wire"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/423186/images/f5e9bf41-576f-475b-b502-1938acaaf8a7_hemiorif.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": [
                        {
                          "text": "drilling into cement results in increased pullout strength but may compromise cement mantle",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "minimally invasive techniques with submuscular plating",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "cable allograft struts (controversial)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "15% complication rate",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "revision arthroplasty (hemiarthroplasty or conversion to total hip arthroplasty)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
