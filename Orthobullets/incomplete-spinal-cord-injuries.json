{
  "title": "Incomplete Spinal Cord Injuries",
  "url": "https://www.orthobullets.com/spine/2008/incomplete-spinal-cord-injuries",
  "subtitle": "Updated: Jul 30 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Defined as spinal cord injury with some preserved motor or sensory function below the injury level including:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "voluntary anal contraction (sacral sparing)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sacral sparing is critical to separate complete vs. incomplete injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "OR palpable or visible muscle contraction below injury level",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "OR perianal sensation present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "11,000 new cases/year in US",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "34% incomplete tetraplegia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**central cord syndrome** most common",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "17% incomplete paraplegia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "remaining 47% are complete",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Descending tracts (motor)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lateral corticospinal tract (LCT)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**ventral corticospinal tract**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Ascending tracts (sensory)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**dorsal columns (DC)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "fine touch",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "vibration",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "proprioception",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral spinothalamic tract (LST)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "temperature",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "gross sensation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**ventral spinothalamic tract (VST)**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "light touch",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anterior cord syndrome (see below)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Brown-Sequard syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "central cord syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior cord syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "ASIA classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "method to scale",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**ASIA Impairment Scale**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "A",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "No motor or sensory function is preserved in the sacral segments S4-S5",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Complete",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "B",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Sensory function preserved, but motor function is not preserved below the neurological level and includes the sacral segments S4-S5",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Incomplete",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "C",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Motor function is preserved below the neurological level, and more than half of key muscles below the neurological level have a muscle **grade less than 3**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Incomplete",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "D",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Motor function is preserved below the neurological level, and at least half of key muscles below the neurological level have a muscle **grade of 3 or more**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Incomplete",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "E",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Motor and sensory functions are normal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Normal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Central Cord Syndrome",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**most common** incomplete cord injury",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2008/images/central_cord_syndrome.jpg",
                      "caption": "Diagram of central cord syndrome"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "demographics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often in **elderly** with **minor extension injury** mechanisms",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "due to anterior osteophytes and posterior infolded ligamentum flavum",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "believed to be caused by spinal cord compression and central cord edema with selective destruction of lateral corticospinal tract white matter",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "anatomy of spinal cord explains why upper extremities and hands are preferentially affected",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "hands and upper extremities are located \"centrally\" in corticospinal tract",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "weakness with hand dexterity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hyperpathia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "burning in distal upper extremity",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "loss",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "**motor deficit worse in UE than LE** (some preserved motor function)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "hands have more pronounced motor deficit than arms",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "preserved",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "**sacral sparing**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "late clinical presentation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "UE have LMN signs (clumsy)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "LE has UMN signs (spastic)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative vs. operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "extremely controversial",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Prognosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "final outcome",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**good prognosis,** although full functional recovery is rare",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "<50 y/o associated with greatest neurologic recovery",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "usually ambulatory at final follow up",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "usually regain bladder control",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "upper extremity and hand recovery is unpredictable and **patients often have permanent clumsy hands**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "recovery occurs in typical pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lower extremities recover first",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bowel and bladder function next",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "proximal upper extremities next",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hand function last to recover",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anterior Cord Syndrome",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A condition characterized by",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "motor dysfunction",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2008/images/anterior_cord_.jpg",
                  "caption": "Diagram of anterior cord syndrome"
                }
              ],
              "importance": "2",
              "children": []
            },
            {
              "text": "dissociated sensory deficit below level of SCI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "injury to anterior spinal cord caused by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**direct compression** (osseous) of the anterior spinal cord",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**anterior spinal artery injury**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "anterior 2/3 spinal cord supplied by anterior spinal artery",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually result of **flexion/compression** injury",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lower extremities affected more than upper extremities**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "loss",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "LCT",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "motor function",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "LST",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "pain",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "temperature",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "preserved",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "DC",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "proprioception",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "vibratory sense",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Prognosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "worst prognosis of incomplete SCI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most likely to mimic complete cord syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "10-20% chance of motor recovery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Brown-Sequard Syndrome",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Caused by complete cord hemitransection",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2008/images/bs_syndrome.jpg",
              "caption": "Diagram of anterior cord syndrome"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "usually seen with **penetrating trauma**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Exam",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "ipsilateral deficit",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "LCT",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**motor function**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "DC",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**proprioception**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**vibratory sense**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "contralateral deficit",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**LST**",
                  "table": null,
