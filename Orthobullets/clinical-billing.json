{
  "title": "Clinical Billing",
  "url": "https://www.orthobullets.com/basic-science/322148/clinical-billing",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "definitions",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "coding and billing involves a system of rules and guidelines by which orthopedic surgeons can describe what was treated and in what manner it was treated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Definitions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Common procedural terminology (CPT®)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a 5 digit alphanumeric code used by insurers to help determine the amount of reimbursement that a practitioner will receive for services provided",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Category I codes",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "five-digit codes have descriptors which correspond to a procedure or service (range from 00100 - 99499)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "Category III codes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "provisional or temporary codes for emerging procedures",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Relative Value Units (RVU)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a unit value assigned to each CPT code derived by four factors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**International Classification of Disease -10 (ICD-10)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a clinical cataloging system developed by the World Health Organization (WHO) used to define and classify diagnoses",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "ICD-10",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "ICD-10 provides coding structure to diagnosis",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/322148/images/icd10_code_explained.jpg",
              "caption": "Illustration of ICD-10 code explained"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "alphanumeric seven-digit codes utilized",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322148/images/achilles_icd10_explained.jpg",
                  "caption": "Illustration depicting ICD-10 code for an Achilles injury and possible details that could be included"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "allows description of:",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "chronicity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "from acute to chronic",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "phase of care",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "initial, subsequent, sequela",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "effects",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "routine, complications,",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "laterality",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "left, right, unspecified",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Current Procedural Terminology (CPT)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "CPT codes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "are assigned to specific services including operative procedures, nonoperative care, and minor procedures (injections/aspirations)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "operative procedures codes are all-inclusive and include approach, procedure, closure, splinting, etc.",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "codes are associated with a global period (0, 10, or 90 days) during which all associated services are considered within the package of care",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Modifiers",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a 2-digit code used to indicate a special situation",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322148/images/modifiers.jpg",
                  "caption": "Table depicting possible modifiers for various scenarios"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "-22 modifier",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "unusually complicated due to increased technical difficulty, patient condition, time, effort",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "-24 modifier",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "unrelated E&M during the postoperative period",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "-25 modifier",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "significant or separate E&M performed on the day of the procedure",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation and Management (E&M)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Location of service and level of service",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "outpatient",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/322148/images/em_for_outpatient_new_established_consult.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**new patient**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "has not received professional services from the physician or any other providers in the same practice group and specialty within the last 3 years",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**established patient**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "has received professional services from the physician or any other providers in the same practice group and specialty within the last 3 years",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "there is a 90-day post-operative period where all follow-up services are considered part of the global fee and cannot be billed separately",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**consultation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "service requested by another physician",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "advice must be the object of the request, not a transfer of care",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "a request must be documented in the chart",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "level of visit must be documented",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "written response to requesting physician must be provided by consulting physician",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "emergency department",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hospital",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "initial care, continued care, consultation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "level of service (1-5)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322148/images/coding-tab1-600x594.jpg",
                  "caption": "Billing Cheat Sheet"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**component-based**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "history, examination, and medical decision making",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "levels include problem focused, expanded problem focused, detailed, comprehensive",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "billing level is limited to the lowest level of history, examination, or medical decision making",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**time-based**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "when visit consists mainly of counseling and coordination of care",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "amount of time must be documented",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Documentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "detail in note must match requirements for location and level of services that are billed for",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Global Period (90-Day)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "single payment for care associated with a surgical procedure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "What is included",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preoperative care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "preoperative visits and work",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "OR preparation (patient marking, positiong, prep, drape)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "operative care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "skin to skin work",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "immobilization and bracing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**application of immobilization or bracing in the OR**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inpatient visits (postoperative progress notes)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "postoperagive visits for up to 90 days",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**whether performed by physician or physician extender**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "What is not included",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "postoperative care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "diagnostic tests and procedures (e.g., CBC on postop day #1)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "immobilization and bracing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**application of immobilization outside of the OR**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "different conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "visits for separate problems",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "evaluation by physician part of a different group",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "additonal operations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "reoperation for complications from initial procedure (e.g., infection)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "staged procedures (e.g., front-back spine surgery)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Coding errors",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "ICD-10 diagnosis code should support and justify the corresponding E&M and CPT codes for services provided",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Errors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "seen as fraud regardless of whether intentional or unintentional",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "services billed were not provided at all",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "services billed were not provided by billing physician",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "services billed were provided but not supported in documentation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "responsibility ultimately falls on the billing physician",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
  "gallery": [],
  "domBulletCount": 101,
  "visitorMode": false
}