{
  "title": "Hemophilia",
  "url": "https://www.orthobullets.com/basic-science/4113/hemophilia",
  "subtitle": "Updated: Oct 9 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hemophilia is a congenital bleeding disorder that results from an X-linked recessive mutation leading to a decrease in clotting factor VIII or factor IX. Patients present withe excessive bleeding into joints, most commonly the knee.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with a plasma factor VIII or IX inhibitor assay.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is medical management with pain management and clotting factor administration.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Hemophilia A**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "approx. 1 in 5000 boys/men",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**Hemophilia B:**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "approx. 1 in 30,000 boys/men",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "excessive bleeding into joints and muscle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**hemarthrosis most commonly affects the knee**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "other joints affected include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "elbow, ankle, shoulder, and spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Two forms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Hemophilia A**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "decreased or absent **factor VIII**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Hemophilia B**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "decreased or absent **factor IX**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Factors VIII and IX required for the generation of thrombin in the intrinsic coagulation pathway",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "results in unstable clot formation and excessive bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritence pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**congential hemophilia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**X-linked recessive** disorder (**typically affects males only**)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "aquired hemophila",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rare condition with autoimmune ethiology, with no genetic inheritence",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Orthopaedic manifestations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hemophilic arthropathy**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "synovitis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cartilage destruction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "joint deformity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "pseudotumor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**intramuscular hematoma** (pseudotumor)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "may lead to nerve compression",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**iliacus hematoma** may compress femoral nerve and presentswith paresthesias in the L4 distribution",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4113/images/dermatomes-netter2_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**leg length discrepancy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "due to epiphyseal overgrowth",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**fractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "due to generalized osteopenia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "will heal in normal time",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**compartment syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "male gender",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "family history of hemophilia, usually **maternal** uncles",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recurrent or severe bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bleeding in unusual places (e.g. joints)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mucocutaneous bleeding (e.g. gums, nose, easy bruising)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Examination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pallor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "joint effusions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bruising",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "movement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "joint tenderness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "decreased ROM",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "focal neurological deficits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**muscle pain** (bleeding most commonly in quadriceps, hamstrings, iliopsoas, biceps, triceps)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views of knee",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4113/images/hemophilia-fig2[1]_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "AP, lateral, oblique and skyline",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "general findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**epiphyseal overgrowth**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "generalized osteopenia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "irregularity of the joint space",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "joint effusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "specific findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4113/images/Xray%20-%20knee%20-%20col_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "squaring of patella and femoral condyles **(Jordan's sign)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "ballooning of distal femur",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "widening of intercondylar notch",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "patella appear long and thin on lateral",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indication",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evaluate pseudotumors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "characterize fracture pattern",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "determine the location of pseudotumor in soft-tissue or bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "better visualization of fracture pattern and characteristic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**MRI better than CT at visualizing soft tissue characteristics**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indication",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "soft tissue evaluation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "evaluate cartilage",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hemarthrosis, synovitis, and hemosiderin deposition in the joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**best visualization modality of soft-tissue anatomy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indication",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "differentiate effusion from pseudotumor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "often helpful to prospectively follow intramuscular hematomas",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CBC (check Hb levels)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**aPTT prolonged, PT normal**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "plasma factor VIII or IX inhibitor assay",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "plasma factor VIII or IX activity level",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "LFTs normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Screening",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Bethesda assay**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "performed if blood factor VIII or IX inhibitor are positive",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "measures the amount of factor VIII or IX antibody in the blood",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "measurements=no titre, <5 BU (low levels), >5BU (high levels)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "analgesics, pain team evaluation, physiotherapy,",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "non-life threatening bleeds into joint or muscle",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "adjunct measures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "codiene in children should be moderated by local prescriber",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "joint immobilization and joint paracentesis are not routinely recommended",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "factor VIII or IX administration",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "relevant factor is administered for Hemophilia A (Factor VIII) and B (Factor IX)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "estabilished bleed with decreased factor VIII and IX or increased Bethesda assay (>5 BU)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "increase factor levels by risk of potential blood loss and bleeding",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**acute hematomas**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "increase blood factor levels to 30%",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**acute hemarthrosis and soft tissue surgery**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "increase blood factor levels to 40-50%",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**skeletal surgery**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "increase blood factor levels to 100% for first week following surgery then maintain at > 50% for second week following surgery",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "factor VIIa",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute bleed, compartment syndrome, or surgical intervention in patients with high titers of factor VIII inhibitor",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "synovectomy and/or contracture release",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "may be indicated for recurrent bleeding into a specific joint causing:",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "chronic synovitis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "recurrent hemarthrosis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
