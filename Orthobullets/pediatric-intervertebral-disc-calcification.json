            {
              "text": "classically cervical spine",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "typical location lower cervical spine, specifically C6-C7, however can occur anywhere in the spine",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "thoracic, lumbar, and multiple level involvement have been rarely",
