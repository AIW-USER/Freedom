  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pediatric Intervertebral Disc Calcification is a very rare condition of unknown etiology.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Textbook presentation is child with neck pain, fever, malaise, and an elevated ESR and presumably CRP.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is typically conservative, and the disease is usually self-limiting with a favorable prognosis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
