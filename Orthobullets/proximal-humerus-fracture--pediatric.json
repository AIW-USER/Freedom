              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis confirmed by history, physical exam, and radiographs",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**acceptable alignment** for non-operative management",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "<10 years old = any degree of angulation",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "10-12 years old = up to 60-75° of angulation",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": ">12 years old = up to 45° of angulation or 2/3 displacement",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "immobilization modalities",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "sling +/- swathe",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "shoulder immobilizer",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "coaptation splint",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction +/- fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "unacceptable alignment for non-operative management as described above",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "open reduction internal fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "unable to obtain acceptable reduction due to soft tissue interposition",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**long head of biceps tendon (most common)**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "joint capsule",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "infolded periosteum",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "deltoid muscle",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**open fractures**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "fractures associated with **vascular injuries**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "intra-articular displacement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed reduction ± fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "reduction maneuver",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "longitudinal traction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "shoulder abduction to 90 degrees",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "external rotation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "fixation options",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "percutaneous pinning",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "two or three lateral threaded pins",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "starting point must consider branches of axillary nerve (lateral) and musculocutaneous nerve (anterior)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "ideally separated at fracture",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "retrograde elastic nails",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Cannulated screws in older patients",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction with fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "deltopectoral interval",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "fixation methods as above",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Loss of reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "unstable fractures treated with closed reduction without pinning",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Axillary nerve Injuries**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "occur in <1% of case due to injury alone",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "typically are neuropraxias",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "associated with a **medially displaced shaft**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "higher risk with percutaneous pinning",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "place lateral pin distal to the axillary nerve, which is approximately 5 cm from the acromion in adult patients and propotionally less in smaller patients, or twice the distance from the superior aspect of the humeral head to the inferiormost margin of the humeral head",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Malunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "severe varus malalignment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "may cause glenohumeral impingement",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Limb-length inequality**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "fracture shortening",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "<3 cm usually well tolerated in patients < 12 years of age",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "growth arrest",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rare",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Hypertrophic scar**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "deltopectoral approach with open reduction and fixation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Pin site infection**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence 5-22%",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Excellent",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "abundant **remodeling potential of the proximal humerus, particularly in younger patients**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "due to range of motion of the shoulder joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
