    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "identify mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**shoulder pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**ecchymosis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection of skin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "motion and **tenderness of neck**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "evaluate ipsilateral sternoclavicular joint and elbow",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "check brachial plexus nerve function",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "perform vascular examination of arm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "standard views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "axillary view (or scapula Y)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "optional",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "contralateral shoulder for comparison views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bone age (rarely required)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**assess maximum angulation** of **fracture displacement**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "glenohumeral dislocation (very rare with associated fracture)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ultrasound may be neccessary in newborns before secondary ossification centers are formed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Little Leaguer's shoulder**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "an overuse injury in throwers that may demonstrate mild physeal widening and metaphyseal changes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "not an actual fracture",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4004/images/screen%20shot%202012-07-24%20at%208.47.45%20am.jpg",
                  "caption": "Little Leaguer&#39;s Shoulder"
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Pathologic fracture",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ABC**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**UBC**",
              "table": null,
              "images": [],
