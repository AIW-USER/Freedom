{
  "title": "Opiates & Analgesic Medications",
  "url": "https://www.orthobullets.com/basic-science/9076/opiates-and-analgesic-medications",
  "subtitle": "Updated: May 20 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definitions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "implies presence of tissue damage",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "chronic pain (3-6 months)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "no implication of tissue damage necessary",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pathologic pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain from abnormal nervous system functioning (neuropathic)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "afferent pain pathways",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**nociceptors**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "transduce signal through various substances",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**Substance P**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "a sensory neurotransmitter that plays an important role in pain",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "depletion of substance P increases the threshold to painful stimuli",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "Capsaicin is thought to function by decreasing Substance P",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**peripheral nerves**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "nociceptors transmit pain to **type A** and **C** peripheral nerve fibers",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**spinal cord**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "peripheral nerves transmit the pain signal via the dorsal column and spinothalamic tract",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**brainstem**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "spinal cord transmits the pain signal to the thalamus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "site of pain modulation with endogenous opiates",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Agents (details below)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Acetaminophen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "NSAIDS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Opiates",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Gaba synthesis agents",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Adjunctive agents",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Indications & Special Consideratoins",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pediatric patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "follow specific dosing guidelines for children which have been tested and recommended by the American Academy of Pediatrics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Geriatric patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may have increased sensitivity to opioid pain medicines with higher rates of side effects",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decreased total body mass with increased body fat percentage",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "potentially decreased hepatic and renal function",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Obese patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "achieving adequate peri-operative pain control in the morbidly obese can be difficult",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "the most accurate method to control pain and avoid respiratory depression should include patient controlled analgesia (PCA), which is based on the patient's ideal weight",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "intramuscular injections should be avoided due to the difficulty of avoiding injection into muscle and the poor vascularity of the subcutaneous adipose tissue",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Red-haired patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often require more anaesthesia to maintain MAC levels and higher opioid dosages postoperatively compared to other hair types",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Chronic regional pain syndrome",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Vitamin C has been shown to possibly prevent CRPS specifically related to distal radius fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Acetaminophen",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not fully understood",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inhibits prostaglandin synthesis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "minimal antinflammatory effects",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "As effective for pain control as aspirin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Toxicity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "overdose leads to hepatic disfunction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "contraindicated in the setting of pre-existing hepatic dysfunction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "NSAIDs",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decrease transduction of pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "See anti-inflammatory medications",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    },
    {
      "text": "Local anesthetics",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decrease transduction of pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "interfere with nerve conduction to provide a reversible loss of sensation in a specific location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "affects the depolarization phase of action potentials (cells fail to depolarize enough to fire after excitation leading to a blocked action potential)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Examples",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "amide family",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lidocaine (Xylocaine)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "bupivacaine (Marcaine)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "esters of p-aminobenzoic acid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "procaine (Novocain)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "butethamine (Monocaine)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "esters of meta-aminobenzoic acid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cyclomethycaine (Surfacaine)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "metabutoxycaine (Primacaine)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "esters of benzoic acid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cocaine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ethyl aminobenzoate (Benzocaine)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Adverse effects",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "FDA warning on the administration of continuous intra-articular infusion of local anesthetics for pain control",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Some patients have been noted to have chondrolysis following infusion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Opiates",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful in chronic nociceptive pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "perispinal method affects modulation of pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "systemic opiates change the perception and modulation of pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "CYP2D6 activates oxycodone, hydrocodone, tramadol, codeine",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "SSRIs/SNRIs block CYP2D6, causing analgesic failure",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Administration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral, IV, intraspinal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "oral administration preferred (more convenient and less costly)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bony procedures require more analgesia than soft tissue procedures",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "patient compliance can improve with long-acting preparations that providue more uniform serum drug levels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "implantable systems are available for intrathecal administration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Prescription dosing guide for upper extremity surgery",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "no narcotics",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "trigger finger release, nonop Dupuytren's release, small lumps/bumps",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "10 narcotic tablets",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "mucous cyst, carpal tunnel, deQuervain’s, Dupuytren’s releases and small joint fusion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "20 narcotic tablets",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "wrist ganglion cysts, hand fracture ORIF, LRTI and tendon transfers",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "40 narcotic tablets",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "large trauma, wrist fusion, open carpal surgery and DRUJ reconstruction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Chronic use",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "addiction occurs in a minority of patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "chronic opiates should be prescribed by pain management specialists",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "written contracts should be obtained",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prescriptions should always be refilled in person",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "when used for OA, increases rate of surgical complications",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Methadone",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Synthetic diphenylheptaine-derivative opioid receptor agonist",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "High bioavailability (three times as much as morphine), effective, and inexpensive",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cytochrome P450 system",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Rapid distribution phase (2-3 hours) and prolonged elimination phase (15-60 hours)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Caution",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can accumulate to high levels with repeated dosing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rates of elimination vary considerably",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "risk of respiratory depression, cardiac toxicity (torsades de pointes)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "consult with a qualified pain specialist when prescribing for the first-time",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "GABA agents",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Agents",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Pregabalin (Lyrica)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Gabapentin (Neurontin)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decrease transduction of pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**reduce hyper-excitability of voltage dependent Ca2+ channels** in activated neurons.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Gabapentin is an anticonvulsant also used to treat neuropathic pain",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "binds presynaptic calcium channels to inhibit release of neurotransmitters",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Efficacy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "evidence of effectiveness primarily for postherpetic neuralgia, diabetic nueropathy, and fibromyalgia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "little evidence for other uses, though often prescribed for other forms of chronic neuropathic pain (such as complex regional pain syndrome, CRPS)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "gabapentin has been shown to be as effective and less expensive than pregabalin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Discontinuation requires a tapering dose",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Muscle relaxants",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Useful to treat pain secondary to muscle spasms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Agents",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Cyclobenzaprine (Flexeril)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mechnism of action not fully understood",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
