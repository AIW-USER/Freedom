{
  "title": "Exertional Compartment Syndrome",
  "url": "https://www.orthobullets.com/knee-and-sports/3106/exertional-compartment-syndrome",
  "subtitle": "Updated: Dec 7 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Exertional compartment syndrome is an exercise-induced condition of the extremity characterized by reversible ischemia to muscles within a muscular compartment.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made by obtaining compartment pressures at rest, during exercise and post-exercise.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment generally involves surgical fasciotomies of the compartments involved.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "second most common exercise induced leg syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "behind **medial tibial stress syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males >females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often seen in 3rd decade of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**runners** or those who run a lot for their sport",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**anterior leg compartment** most commonly affected (~70%)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "anterior and lateral leg compartment affected in 10%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior leg compartment involvement associated with less predictable surgical outcomes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more frequently associated with popliteal artery entrapment syndrome (PAES)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "most common cause is the presence of an accessory head of the medial gastrocnemius muscle",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**volar forearm**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "less commonly encountered, but occurs in sports requiring repetitive gripping",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "volar forearm compartment most commonly affected",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "biochemistry",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the local metabolism of the musculature cannot go fast enough to clear the metabolic waste products",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "vascular, advanced imaging, and histologic experiments have not provided clear evidence of the pathoanatomy of this condition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may have lower density of capillaries compared to asymptomatic individuals",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "fascial **hernias** have been identified with decompression",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "40% of people with exertional compartment syndrome have these facial defects, only 5% of asymptomatic people have such defects",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "most common location is near the intramuscular septum of the anterior and lateral compartments, where the superficial peroneal nerve exits",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "aching or **burning pain in leg**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "patients can often predict how long the pain will last for after they stop exercise",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "paresthesias over dorsum of foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "symptoms are **reproduced by exercise** and relieved by rest",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "symptoms begin ~ 10 minutes into exercise and slowly resolve ~30-40 minutes after exercise",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**most likely to be normal**",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "decreased sensation **1st web space**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "decreased active ankle **dorsiflexion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful to eliminate other pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not very helpful in establishing diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can help eliminate other pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Compartment pressure measurement**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**limb should be in relaxed and consistant position**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**required to establish diagnosis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "three pressure should be measured",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**resting pressure**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**1 minute post-exercise pressure**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**5 minutes post-exercise pressure**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "some authors advocate for an additional measurement point 15 minutes post-exercise",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "diagnostic criteria",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "resting (pre-exercise) pressure > 15 mmHg",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "immediate (1 minute) post-exercise is **>30 mmHg** and",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "post-exercise pressure **>20mmHg at 5 minutes**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "post-exercise pressure **>15 mmHg at 15 minutes**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Near-infrared spectroscopy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can show deoxygenation of muscle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "showed return to normal within 25 minutes of exercise cessation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activity modification",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "rarely effective",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "anti-inflammatories",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "attempt these treatments for 3 months prior to operating",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "two incision fasciotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "refractory cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "two incision approach",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "lateral incision",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "release anterior and lateral compartments",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "12-15 cm above lateral malleolus",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "identify and protect **superficial peroneal nerve**",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            },
                            {
                              "text": "may see fascial hernia",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "medial incision",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "used to release posterior compartments",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "perform if needed based on measurements",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "release at middle of tibia at posterior border",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "endoscopic",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "smaller incisions, similar complications",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "not a \"home run\" procedure because symptoms are often multi-variable",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "no studies directly comparing operative to non-opertative treatment options",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "surgery is successful in >80% of cases for the anterior compartment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "deep posterior compartment success is lower (around 60%)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nerve injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "most commonly the **SPN**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**DVT**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Recurrence**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "up to 20% at a mean of 2 years after fasciotomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "because of **fibrosis**/scar formation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "risk factors:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "isolated compartment release",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
