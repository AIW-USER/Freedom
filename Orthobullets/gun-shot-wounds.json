{
  "title": "Gun Shot Wounds",
  "url": "https://www.orthobullets.com/trauma/1059/gun-shot-wounds",
  "subtitle": "Updated: Mar 12 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gun shot wounds are high energy injuries that contribute to extensive soft tissue damage and comminuted bony fractures.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "gun shot wounds represent the **second-leading cause** of death for youth in United States.",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wounding capability of a bullet directly related to its **kinetic energy**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "damage caused by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "passage of missile",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "secondary shock wave",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cavitation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "**exponential increase in injury with increasing velocity** and efficient energy transfer",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "fractures may be caused even without direct impact",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lead intoxication** (plumbism)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1059/images/captura%20de%20tela%202011-12-21%20%C3%A0s%2013.06.47_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "may be caused by intra-articular missile",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "systemic effects include",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "neurotoxicity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "anemia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "emesis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "abdominal colic",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "GSW to hip and acetabulum are most commonly associated with bowel perforation > vascular injury > urogenital injuries",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Low velocity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "muzzle velocity <**350 meters per second** or < 1,200 feet per second",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "most handguns except for magnums",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "wounds comparable to Gustillo-Anderson Type I or II",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Intermediate velocity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "muzzle velocity **350-650** meters per second or 1,200-2,000 feet per second",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "shotgun blasts",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "highly variable depending on distance from target",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "can reflect wounding potential of high velocity firearms from close range (less than 21 feet) or multiple low velocity weapons",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "wound contamination/infection with close range injuries due to shotgun wadding",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "wounding potential depends on 3 factors",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "shot pattern",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "load (size of individual pellet)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "distance from target",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**High velocity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "muzzle velocity >**600 meters per second** or >2,000 feet per second",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "military (assault) and hunting rifles",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "wounds comparable to Gustillo-Anderson Type III regardless of size",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "high risk of infection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "secondary to wide zone of injury and devitalized tissue",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "perform careful neurovascular exam",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "clinical suspicion for **compartment syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "secondary to increased muscle edema from higher velocity wounds",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "examine and document all associated wounds",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "massive bone and soft tissue injuries occur even with low velocity weapons",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1059/images/weatherford_110829_25.jpg",
                      "caption": "shows exit wound associated with low velocity handgun"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obtain to identify bone involvement and/or fracture pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "identify potential **intra-articular missile**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1059/images/l%20ankle%20gsw%20pilon%20ct%20sag.jpg",
                  "caption": "Shows intra-articular missile"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "detect hollow viscus injury that may communicate with fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "high index of suspicion for pelvis or spine fractures given increased risk of associated bowel injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment General",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "local wound care",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**low velocity GSW with no bone involvement and clean wound edges**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "local wound care, tetanus +/- short course of oral antibiotics",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**low-velocity injury with no bone involvement or non-operative fractures**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "low-velocity injury causing traumatic arthrotomy without retained intra-articular missile",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "primary closure contraindicated",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**antibiotic use controversial but currently recommended if wound appears contaminated**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "treatment of other non-orthopedic injuries",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "for trans-abdominal trajectories, laparotomy takes precedence over arthrotomy",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "ORIF/external fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "unstable/operative fracture pattern in low-velocity gunshot injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "treatment dictated by fracture characteristics similar to closed fracture without gunshot wound",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "stabilize extremity with associated vascular or nerve injuries",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/weatherford_110919_-3.jpg",
                          "caption": "shows GSW with brachial artery and median nerve injury"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/weatherford_110919_-6.jpg",
                          "caption": "shows disruption of brachial artery from GSW"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/weatherford_110919_.jpg",
                          "caption": "show plating of right humerus fracture with vascular injury"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**low velocity** gunshot injuries can be treated with superficial debridement and gram-positive antibiotic coverage with appropriate fracture stabilization based on injury type",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**high velocity/high** energy gunshot injuries",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/weatherford_110618_-2.jpg",
                          "caption": "shows multiple GSW with comminuted humerus"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/weatherford_110618_-7.jpg",
                          "caption": "shows external fixation of left humerus fx from multiple GSW"
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "grossly contaminated/devitalized wounds managed with aggressive debridement per open fracture protocol with broad-spectrum antibiotic coverage",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "arthrotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "intra-articular missile",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "may lead to local inflammation, arthritis and lead intoxication (plumbism)",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/cases/1120/captura%20de%20tela%202011-12-21%20%C3%A0s%2013.06.47.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "transabdominal GSW",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "GSW to Hand/Foot",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "antibiotics",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "gross contamination",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "joint penetration",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "extent of contamination unclear",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical debridement +/- ORIF/external fixation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "articular involvement",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "unstable fractures",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "tendon involvement",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "superficial fragments in the palm or sole",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "GSW to Femur",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intramedullary nailing",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "diaphyseal femur fracture secondary to low-velocity gunshot wound",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/gsw%20to%20femur.jpg",
                          "caption": "shows diaphyseal femur fx from low energy GSW"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/intraop.jpg",
                          "caption": "shows IM rodding of femur fx from low velocity GSW"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "superficial wound debridement and immediate reamed nailing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "similar union and infection rates to closed injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "external fixation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "high-velocity gunshot wounds or close range shotgun blasts",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "associated vascular injury",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "temporize extremity until amenable to intramedullary nailing",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "GSW to Spine",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "broad spectrum IV antibiotics for 7-14 days",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "gunshot wounds to the spine with associated perforated viscus",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**bullets which pass through the alimentary canal and cause spinal cord injuries do not require surgical removal of the bullet**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical decompression and bullet fragment removal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "when a neurologic deficit is present that correlates with radiographic findings of neurologic compression",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1059/images/l3%20sci%20ct%20axial.jpg",
                          "caption": "shows bullet embedded in L3 vertebral body"
                        }
                      ],
                      "importance": "1",
                      "children": [
