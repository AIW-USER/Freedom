                }
              ]
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "equivocal radiographs with high suspicion for symptomatic bipartite patella",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increased **uptake** along **superolateral** aspect",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4049/images/bone%20scan.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "utility somewhat controversial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will clearly demonstrate fragment, but does not demonstrate edema",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "interposed tissue between accessory and main fragment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "composed of **fibrocartilage** > fibrous > hyaline cartilage",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**avascular**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "adjacent bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "scalloped surface with numerous osteoclasts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**well-vascularized**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, immobilization, NSAIDS, and physical therapy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "generally, non-operative, symptomatic management is indicated for bipartite patella for at least 6 months",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "rest and restriction of sports activities",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "NSAIDs",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "isometric quadriceps strengthening exercises",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "immobilization with the knee braced in 30° of flexion",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "local corticosteroid injections",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "non-operative management may be less successful in younger, athletic patients, possibly due to non-compliance",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open excision of the accessory fragment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "failed nonoperative treatment >6 months or in cases of a displaced fragment requiring reduction, direct trauma resulting in the onset of pain, or significant impairment in daily activities",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "most common treatment technique, typically good results",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "may lead to poor results if large, articular fragment due to patellofemoral incongruity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "arthroscopic excision",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "thought to lead to expedited recovery and avoids disrupting the quad tendon",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "limited evidence to support but good results in case reports",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "lateral retinacular release",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4049/images/lat%20release.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "superolateral fragment (to remove the traction force of the vastus lateralis on the fragment)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "vastus lateralis release (subperiosteal)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4049/images/vastus%20lateralis%20release.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "superolateral fragment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "to avoid long lateral retinacular release",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "open vs arthroscopic",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "quicker recovery and less effusion noted in arthroscopic patients",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "ORIF",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4049/images/orif%20bipartite.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for large fragments",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "limited support in the literature, controversial",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Patellofemoral maltracking**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "due to excision of a large fragment or lateral retinacular release",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "may lead to patellofemoral degenerative changes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Effusion**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "may require arthrocentesis following fragment excision",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Persistent knee pain**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "may see following lateral retinacular release",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Quadriceps weakness**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Osteonecrosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
