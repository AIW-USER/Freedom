                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "may show displacement of the accessory fragment",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "consider radiographs of the contralateral knee for comparison",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "smooth edges (helps differentiate from fracture)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "weight-bearing skyline (squatting) view demonstrates **increased separation of fragments** compared with non-weight views (prone)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "50% have bilateral bipartite patella",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4049/images/bilat%201.jpg",
                      "caption": ""
                    },
                    {
