                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**squatting position (weight-bearing)**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4049/images/skyline%20squatting.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4049/images/skyline.jpg",
