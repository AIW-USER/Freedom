                      "children": []
                    }
                  ]
                },
                {
                  "text": "skyline view",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "prone position (non-weight-bearing)",
                      "table": null,
                      "images": [
                        {
