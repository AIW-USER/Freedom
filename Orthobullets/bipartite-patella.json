    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most are asymptomatic and discovered incidentally",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "only **2%** become symptomatic",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "anterior knee pain from",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "direct trauma (e.g. fall, kick to the knee)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "indirect trauma or overuse injuries (e.g. cycling, hill climbing)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "aggravated by squatting, jumping, climbing stairs",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "giving way",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "localized tenderness over accessory fragment (typically superolateral patella)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hematoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "quad inhibition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "unusual patella prominence or palpable defect",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "larger than normal patella",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
