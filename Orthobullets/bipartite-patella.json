{
  "title": "Bipartite Patella",
  "url": "https://www.orthobullets.com/pediatrics/4049/bipartite-patella",
  "subtitle": "Updated: Oct 12 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bipartite Patella is a congenital knee condition caused by the failure of the patella to fuse and is often an incidental finding on radiographs.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is confirmed radiographically with most commonly an unfused patella at the superolateral pole.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is observation and most often does not require treatment as the condition is typically asymptomatic.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**2-3%** of the population",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**no notable sex predilection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most often found in the **superolateral region (Type III)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**bilateral in 50%**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4049/images/bilat%201.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/4049/images/bilat%202.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Etiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Normal patella variant representing a failure of fusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often confused with **patella fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "considered a developmental variation of ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "painful bipartite patella following injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "direct or indirect injury results in disruption of the fibrocartilaginous zone between the main patella and accessory fragment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fibrocartilaginous zone cannot heal by bony union, resulting in persistent pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "lack of arterial penetration from patella to osteochondral fragment",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "vastus lateralis contributes to traction force in fragment separation and nonunion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nail-patella syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**patella fracture**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "compared with patella fractures, bipartite patellas:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "are located superolaterally",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "have smooth, rounded borders",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "may have similar findings on contralateral knee radiographs (50%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the patella is the **largest sesamoid bone**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "arises from a single ossific nucleus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "males at 4-5 years old",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "females at 3 years old",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "accessory ossification center appears between 8-12 years",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "separate fragment attached to patella by fibrocartilaginous tissue",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fulcrum for the quadriceps",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "protects the knee joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "articular cartilage of patella is thickest in body (up to 1cm)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "enhances lubrication of the knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "see complete knee biomechanics",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "blood supply to patella is predominantly from **distal to proximal**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "6 arteries contribute",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4049/images/blood%20supply.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**from popliteal artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "superior lateral geniculate artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "superior medial geniculate artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "inferior lateral geniculate artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**inferior medial geniculate artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**from superficial femoral artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "supreme geniculate artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**from anterior tibial artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "anterior tibial recurrent artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
