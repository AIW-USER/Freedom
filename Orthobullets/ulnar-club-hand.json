{
  "title": "Ulnar Club Hand",
  "url": "https://www.orthobullets.com/hand/6068/ulnar-club-hand",
  "subtitle": "Updated: May 21 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ulnar Club Hand is a congenital upper extremity deformity characterized by a deficiency of the ulna and/or ulnar-sided carpal structures.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment can be nonoperative or operative depending on hand position, thumb function, elbow stability and presence of syndactyly.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "5-10 times less common than radial club hand",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medical",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not associated with systemic conditions like radial club hand",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "orthopaedic conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**PFFD**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**fibula deficiency**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "phocomelia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "multiple hand abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "almost all patients have absent ulnar sided digits",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "limited function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually painless",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shortened, bowed forearm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "decrease in elbow function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "loss of ulnar digits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
