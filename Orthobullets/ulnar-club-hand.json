                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6068/images/screenshot61.jpg",
                          "caption": "The distal aspect of the ulna is missing"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
