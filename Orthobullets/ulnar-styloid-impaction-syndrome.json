    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ulnar side wrist pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain with pronation or grip",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain and swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tenderness along ulnar styloid and/or triangular fibrocartilage complex (TFCC)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "limited range of motion due to pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ulnar stress test",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "maximum ulnar deviation, axial loading, rotation from supination to pronation to reproduce symptoms",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posteroanterior (PA) view to determine ulnar variance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "excessive length determined by subtracting ulnar variance from ulnar styloid length and dividing this by the width of the ulnar head (<.22 is normal)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may exhibit subchondral sclerosis, cyst formation on ulnar side",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pronated grip PA view",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evaluate for any dynamic ulnar variance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "contralateral comparison views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can help evaluate TFCC and the lunotriquetral interossesous ligament (LTIL)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
