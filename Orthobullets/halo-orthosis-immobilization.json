{
  "title": "Halo Orthosis Immobilization",
  "url": "https://www.orthobullets.com/spine/2019/halo-orthosis-immobilization",
  "subtitle": "Updated: Dec 7 2024",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fixes skull relative to the torso",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "provides the most rigid form of external immobilization for the cervical spine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ideal for **upper cervical spine injury**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Allows intercalated paradoxical motion in the subaxial cervical spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**not ideal for lower cervical spine injuries as** lateral bending is the least controlled motion",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2019/images/osteology%203_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "**\"snaking phenomenon\"**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "recumbent lateral radiograph shows focal kyphosis in the midcervical spine",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "yet, upright lateral radiograph shows maintained lordosis in the midcervical spine",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Adult",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definitive treatment of cervical spine trauma including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**occipital condyle fracture**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**occipitocervical dislocation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**stable type II atlas fracture (Jefferson fracture)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**type II odontoid fractures in young patients**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**type II and IIA Hangman’s fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "adjunctive postoperative stabilization following cervical spine surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pediatric",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definitive treatment for",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**atlantooccipital dissociation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**Jefferson fractures (C1 burst fracture)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**atlas fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**unstable odontoid fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**persistent atlantoaxial rotatory subluxation**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**C1-2 dissociations**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**subaxial cervical spine trauma**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "preoperative reduction in patients with spinal deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Contraindications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Absolute",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cranial fractures**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**infection**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "severe soft-tissue injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "especially near proposed pin sites",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Relative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "polytrauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "severe chest trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "barrel-shaped chest",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obesity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**advanced age**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "recent evidence demonstrates an unacceptably high mortality rate in patients >79 y/o (21%)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "CT scan prior to halo application",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**clinical suspicion for cranial fracture**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**children <10 y/o to determine thickness of bone**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Adult Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Adults",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "torque",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tighten to **8 inch-pounds (in-lb) of torque**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "total of 4 pins",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "2 anterior pins",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**safe zone** is a 1 cm region just above the lateral 1/3 of the orbit (eyebrow) at or below the equator of the skull",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2019/images/screen%20shot%202012-10-14%20at%2011.09.23%20am.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "anterior and medial to temporalis fossa/temporalis muscle",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "lateral to supraorbital nerve",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "2 posterior pins",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "placed on the opposite side of the ring from anterior pins",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "followup care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can have the patient return on day 2 to tighten pins again",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "proper pin and halo care can minimize the chance of infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Pediatric Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pediatrics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "torque",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "best construct involves **more pins with less torque**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "total of 6-8 pins",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "lower torque (2-4 in-lb or \"finger-tight\")",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pin locations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "place anterior pins lateral enough to avoid injury to the frontal sinus, supratrochlear nerve, and supraorbital nerve",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "place pins anterior enough to avoid the temporalis muscle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "place posterior pins opposite from anterior pins",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "brace/vest",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "custom fitted vest for children >2 y/o",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Minerva cast for children <2 y/o",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "CT scans may help in pin placement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can help avoid cranial sutures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "can help avoid thin regions of the skull",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "help limit risk of complications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Higher complication rates in children (70%) than adults (35%)**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Pin loosening** (36%)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "can be treated with retightening",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "if pin continues to loosen, should be treated with pin exchange",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Infection** (20%)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "especially occurs with a **posterior pin in the temporalis fossa**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pins hidden in hairline",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "bone is thin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "temporalis muscle moves with chewing",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "can be treated with **oral antibiotics if the pin is not loose**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "if there is a pin infection and the pin is loose, then the pin should be removed",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Discomfort** (18%)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "treated by loosening the skin around a pin",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Dural puncture** (1%)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Abducens nerve (cranial nerve VI) palsy**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "epidemiology",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "most commonly injured cranial nerve with halo placement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "thought to be a traction injury to cranial nerve VI (abducens nerve), which innervates lateral rectus muscles",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2019/images/abducens.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "diplopia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "loss of lateral gaze on affected side",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2019/images/abducens_clinical.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "observation, as most cases resolve spontaneously",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Supraorbital nerve palsy**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2019/images/screen%20shot%202012-10-14%20at%2011.09.23%20am.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "injured by medially placed anterior pins",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Supratrochlear nerve palsy**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2019/images/screen%20shot%202012-10-14%20at%2011.09.23%20am.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "injured by medially placed anterior pins",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Medical complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pneumonia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ARDS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "arrhythmia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
