{
  "title": "Renal Osteodystrophy",
  "url": "https://www.orthobullets.com/basic-science/9030/renal-osteodystrophy",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Renal Osteodystrophy is a form of metabolic bone disease seen in patients with chronic renal insufficiency characterized by bone mineralization deficiency due to electrolyte and endocrine abnormalities. Patients present with osteomalacia, osteonecrosis and pathologic fractures.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made based on a thorough evaluation of serum labs, clinical features, and radiographic findings.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves medical management to resolve the etiology of the underlying renal condition.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hypocalcemia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "due to the inability of the damaged kidney to convert vitamin D3 to calcitrol (the active form)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "because of phosphate retention (hyperphosphatemia)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**hyperparathyroidism and secondary hyperphosphatemia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "caused by hypocalcemia and lack of phosphate excretion by damaged kidney",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**uremia related phosphate retention**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "is a key pathological step",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "osteomalacia (adults) and growth retardation (children)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AVN",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tendinitis and tendon rupture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "carpal tunnel syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "deposition of amyloid (β2 microglobulin)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "pathologic fracture",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9030/images/renal%20od%20patho%20frac.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "from brown tumors (hyperparathyroidism) or amyloid deposits",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "osteomyelitis and septic arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Two different forms:",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**High-turnover renal bone disease (high PTH disease)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "chronically elevated phosphate leads to secondary hyperparathyroidism",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "hyperphosphatemia lowers serum Ca, stimulating PTH",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "phosphorus impairs renal 1α-hydroxylase, reducing 1,25(OH)2 vitamin D3 production",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "phosphorus retention directly stimultes PTH production",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "hyperplasia of chief cells of parathyroid gland",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "associated lab values",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "decreased calcium, increased serum phosphate, increased alkaline phosphate, increased parathyroid hormone",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Low turnover renal bone disease (normal PTH disease)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "characterized by lack of secondary hyperparathyroidism",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "normal levels of PTH with characteristic bone lesions marked by low levels of bone formation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "excess deposition of aluminium into bone affects bone mineralization",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "impairs differentiation of precursors into osteoblasts, and osteoblast proliferation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "impairs PTH release from parathyroid gland",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "disrupts mineralization",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
