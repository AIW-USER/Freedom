        {
          "text": "**Tumor Compartments**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**i**ntracompartmental",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**bone tumors are confined within the cortex of the bone**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "extracompartmental",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bone tumors extend beyond the bone cortex",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Tumor Grade**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "histologically, tumors are graded based on the **percentage of cellular atypia**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**low grade tumors**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "low metastatic potential",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "e.g. parosteal osteosarcoma",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**high grade** tumors",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "greater metastastatic potential",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "e.g. intramedullary osteosarcoma, Ewing's sarcoma, dedifferentiated chondrosarcoma",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
