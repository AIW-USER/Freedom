{
  "title": "Meniscus",
  "url": "https://www.orthobullets.com/knee-and-sports/9019/meniscus",
  "subtitle": "Updated: May 16 2022",
  "sections": [
    {
      "text": "Function",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Force transmission",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the meniscus functions to optimize force transmission across the knee. It does this by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increasing congruency",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "increases contact area leads to decreased point loading",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "shock-absorption",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "the meniscus is more elastic than articular cartilage, and therefore absorbs shock",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "transmits 50% weight-bearing load in extension, 85% in flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the meniscus deepens tibial surface and acts as **secondary stabilizer**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**medial meniscus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "posterior horn of medial meniscus is the main secondary stabilizer to anterior translation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**lateral meniscus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "is less stabilizing and has **2X the excursion** of the medial meniscus",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "the menisci become primary stabilizers in the ACL-deficient knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Composition",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Made of **fibroelastic cartilage**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "interlacing network of collagen, proteoglycan, glycoproteins, and cellular elements",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "composed of 65-75% water",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Collagen",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**90 % Type I collagen**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Fibers",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "composed of two types of fibers which allow the meniscus to **expand under compressive forces** and increase contact area of the joint",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**radial**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**longitudinal (circumferential)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "help dissipate hoop stresses",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "vertical mattress captures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gross Shape",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medial meniscus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "C-shaped with triangular cross section",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "avarage width of 9 to 10mm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "average thickness of 3 to 5mm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lateral meniscus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "is more circular (the horns are closer together and approximate the ACL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "covers a larger portion of the articular surface",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "average width is 10 to 12mm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "average thickness is 4 to 5mm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Attachment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**transverse (intermeniscal) ligament**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "connects the medial and lateral meniscus anteriorly",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**coronary ligaments**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**connects the meniscus peripherally**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**medial meniscus has less mobility with more rigid peripheral fixation than the lateral meniscus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**meniscofemoral ligament**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**connects the meniscus into the substance of the PCL**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**originate from the posterior horn of the lateral meniscus and has two components**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Humphrey ligament (anterior)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9019/images/humphrey%20lig_arrow.jpg",
                          "caption": "Shows the Humphrey ligament"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "Ligament of Wrisberg (posterior)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "middle genicular artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "supply to posterior horns",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "medial inferior genicular artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "supplies peripheral 20-30% of medial meniscus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lateral inferior genicular artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "supplies peripheral 10-25% of lateral meniscus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "central 75% receive nutrition through diffusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Innervation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "peripheral two-thirds innervated by Type I and II nerve endings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior horns have highest concentration of **mechanoreceptors**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Injury & Healing potential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "See topic Meniscal Pathology",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Tears in **peripheral 25%** red zone",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "can heal via fibrocartilage scar formation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**fibrochondrocyte** is cell responsible for healing",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "peripheral tears < 4 mm have best healing potential",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tears of **central 75%**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "have limited or no intrinsic healing ability",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
