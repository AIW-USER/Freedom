{
  "title": "Thoracic Disc Herniation",
  "url": "https://www.orthobullets.com/spine/2033/thoracic-disc-herniation",
  "subtitle": "Updated: Jul 25 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Thoracic disc herniations are rare causes of midline back pain and sensory changes around the rib cage",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made using MRI of the thoracic spine",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually activity modification, physical therapy, and pain management. Surgical management is indicated in patients with persistent pain or progressive neurological symptoms",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "relatively uncommon and makes up only 1% of all HNP",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rare due to limited motion of the thoracic spine and short disc heights",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly occurs between the 4th and 6th decades of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "as the disc desiccates, it becomes less likely to herniate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually involves the middle and lower levels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "T11-12 most common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "75% of all thoracic disc herniations occur between T8-12",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "underlying Scheuermann's disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Herniation type",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bulging nucleus pulposus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "annulus remains intact",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "extruded disc",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "through annulus, but remains confined by PLL",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "sequestered",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "disc material floats freely into canal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Location classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "central",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterolateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**axial back or chest pain** is the most common symptom",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**thoracic radicular pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "band-like chest or abdominal pain along the course of the intercostal nerve",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "arm pain (with HNP at T2-5)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "numbness, paresthesias, sensory changes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**myelopathy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "paraparesis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**bowel or bladder changes** (15-20% of patients)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "sexual dysfunction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "localized tenderness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "root symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dermatomal sensory changes (paresthesias and dysesthesia)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "cord compression and findings of **myelopathy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "weakness or mild paraparesis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "abnormal rectal tone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "upper motor neuron findings",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**hyperreflexia**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "sustained clonus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "positive Babinski sign",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "gait changes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "wide-based spastic gait",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Horner's syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "with HNP at T2-5",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "disc narrowing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "calcifications (osteophytes)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2033/images/sagital.mri.t1.thoracic%20disk%20herniation_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "most useful and important imaging method to demonstrate thoracic disc herniation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "identification of neoplastic pathology",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "intradural pathology",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "myelomalacia",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "may not fully demonstrate calcified component of herniated disc",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "high false positive rate",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "in a study of **asymptomatic individuals:**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "73% had thoracic disc abnormalities",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "37% had frank herniations",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "29% had cord compression",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activity modification, physical therapy, non-narcotic medication, and steroid injections",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "majority of cases",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities include",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "activity modification",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "immobilization and short-term rest",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "progressive activity restoration",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "physical therapy",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "range of motion and strengthening",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "medications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "NSAIDs, Tylenol, gabapentin",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "injections",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "may be useful for radiculopathy",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "majority improve with nonoperative treatment",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "discectomy with possible hemicorpectomy or fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute disc herniation with myelopathic findings attributable to the disc herniation, especially if there is progressive neurologic deterioration",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "persistent and intolerable pain",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "rarely indicated",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "discectomy with or without fusion is controversial",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "most studies indicate that anterior or lateral (via costotransversectomy) are the best approaches",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "see below for different approaches",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Transthoracic discectomy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "best approach for central disc herniations",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "intercostal neuralgia",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "techniques",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "can be done with video-assisted thoracic surgery (VATS)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Costotransversectomy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lateral disc herniation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "extruded or sequestered disc",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Intercostal neuralgia**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "associated with transthoracic discectomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
