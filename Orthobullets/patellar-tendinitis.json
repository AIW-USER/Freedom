{
  "title": "Patellar Tendinitis",
  "url": "https://www.orthobullets.com/knee-and-sports/3015/patellar-tendinitis",
  "subtitle": "Updated: Apr 27 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Patellar tendinitis is tendinopathy of the patellar tendon associated with activity-related anterior knee pain.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is primarily made clinically with tenderness to palpation at the distal pole of patella in full extension.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is generally nonoperative with resting, ice, activity modifications and physical therapy to focus on hamstring, quadriceps and core strengthening.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "up to 20% of **jumping athletes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "males > females",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "volleyball most common",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "more common in adolescents/young adults",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "quadriceps tendinopathy is more common in older adults",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "poor **quadriceps and hamstring flexibility**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "repetitive, forceful, eccentric contraction of the extensor mechanism",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "histology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**degenerative**, rather than inflammatory",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "micro-tears of the tendinous tissue are commonly seen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Blazina classification system",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "",
