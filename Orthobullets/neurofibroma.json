    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MRI with and without contrast",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8056/images/mri%20plexiform.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/8056/images/nf%20mri%201.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/8056/images/nf%20mri%202.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/8056/images/nf%20mri%203.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "differentiate Schwannoma from neurofibroma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Schwannoma are found ECCENTRIC to the nerve fibers",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Solitary neurofibromas are found CENTRAL to the nerve fibers",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**nerve continuity sign**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "fusiform tumor in continuity with the neurovascular bundle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**split fat sign**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "fusiform tumor surrounded by a thin margin of fat because the mass within the neurovascular bundle enlarges and displaces the adjacent intramuscular fat",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**target sign**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lesion of high signal intensity peripherally and low signal centrally (on coronal STIR)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
