    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Characteristics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypocellular",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "predominantly **fibroblasts**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "mixed Schwann cells, mast cells, lymphocytes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "elongated, wavy nuclei",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "stroma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rich **wire-like collagen fiber** network",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/nf%20histo.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "may be myxoid",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "distorted structures resembling Pacini or Meissner corpuscles",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "variable S100 staining",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MPNST (malignant peripheral nerve sheath tumor or neurofibrosarcoma)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "5% of patients with NF, 10-25% lifetime risk",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "symptoms include **painful, enlarging** soft tissue mass",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "usually from plexiform neurofibroma",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**10% of plexiform neurofibromas** transform into MPNST",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "associated with loss of expression of **CDKN2A or TP53** genes in non-myelinating Schwann cells (that also have biallelic inactivation of NF1)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "poor prognosis",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "widespread metastasis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "high rate of local recurrence",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Schwannoma",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
