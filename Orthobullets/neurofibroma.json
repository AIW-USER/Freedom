    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stinging, itching, pain, disfiguration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reduced sensation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cutaneous lesions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can \"button hole\" through skin defect using finger pressure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "signs of neurofibromatosis (2 of 7) (NIH criteria)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "2 or more neurofibromas, or 1 plexiform neurofibroma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "axillary or groin freckling (Crowe's sign)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "6 or more coast of California **cafe-au-lait** spots",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/Cafe%20au%20lait%20-%20colorado_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "5mm diameter in prepubertal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": ">15mm diameter in postpubertal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "sphenoid wing dysplasia or thinning of long bone cortex (anterolateral tibial bowing)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/sphenoid%201.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/sphenoid%202.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "2 or more Lisch nodules (**iris hamartomas**)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/lisch%20nodules_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "on slit lamp",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "optic glioma",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/optic%20glioma.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/glioma%202.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "1st degree relative with NF1",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "associated with NF1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dystrophic kyphoscoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rib penciling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intraspinal neurofibromas and dumbbell lesions",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/dumbbell_moved.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/dumbbell2_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "dural ectasia",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/dural%20ectasia.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8056/images/coronal%20dural%20ectasia.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
