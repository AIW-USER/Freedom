{
  "title": "Turner's Syndrome",
  "url": "https://www.orthobullets.com/pediatrics/4106/turners-syndrome",
  "subtitle": "Updated: Jun 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Turner's Syndrome is a common congenital disorder caused by a missing X chromosome that presents with scoliosis, short stature, webbed neck, amenorrhea, cardiovascular abnormalities, and osteoporosis.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with chromosomal testing showing a 45 XO genotype.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to address orthopedic manifestations, cardiovascular abnormalities, and genitourinary anomalies.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1 in every 2,000 live births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "only in females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "less than 10% of cases are diagnosed antenatally",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "largest proportion are diagnosed between ages 10 to 16",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
