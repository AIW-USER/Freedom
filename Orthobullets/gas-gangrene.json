{
  "title": "Gas Gangrene",
  "url": "https://www.orthobullets.com/trauma/1067/gas-gangrene",
  "subtitle": "Updated: May 8 2022",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**also called clostridial myonecrosis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "1",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "male:female ratio",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "no sexual predilection",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "buttocks, thigh, perineum",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "**posttraumatic** (associated with C perfringens)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**car accidents** (most common)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "crush injuries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "gunshot wounds with foreign bodies",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "burns and frostbite",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "IV drug abuse",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**postoperative**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "bowel resection or perforation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "biliary surgery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "premature wound closure",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**spontaneous**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "colon cancer (associated with C. septicum)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "neutropenia",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**Clostridial species**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**Clostridium perfringens (most common), Clostridium novyi, Clostridium septicum**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "found in soil and gut flora",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "gram-positive obligate anaerobic spore-forming rods that produce **exotoxins** (e.g. C. perfringens alpha toxin)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1067/images/clostridium%20histo.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "causes muscle necrosis and vessel thrombosis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "can cause hemolysis and shock",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "incubation period <24h",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**gas** produced by fermentation of glucose",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "main component is nitrogen",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "other bacteria include **E. coli, Pseudomonas aeruginosa, Proteus species, Klebsiella pneumoniae**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recent surgery to GI or biliary tract",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "triad",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sudden progressive **pain** out of proportion to injury",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "from thrombotic occlusion of large vessels",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**tachycardia** not explained by fever",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "feeling of **impending doom**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**sweet smelling** odor",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "swelling, edema, **discoloration** and ecchymosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "blebs and hemorrhagic **bullae**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "\"**dishwater** pus\" discharge",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**crepitus**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "altered mental status",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "linear **streaks** of gas in soft tissues",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1067/images/xr%20arm.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Elevated LDH**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Elevated WBC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Metabolic acidosis and renal failure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Gram stain reveals **Gram-positive bacilli**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1067/images/clostridium%20histo.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "**absence** of neutrophils",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1067/images/histo2.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**lack** of acute inflammatory response is hallmark of gas gangrene",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Culture",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "blood culture rarely grows Clostridial species",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Necrotizing fasciitis",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "high dose IV antibiotics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "1st line is penicillin G and clindamycin",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "alternative treatment is erythromycin, tetracycline or ceftriaxone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "clindamycin and tetracycline **inhibit** toxin synthesis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "hyperbaric O2",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "useful adjunct",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "effectiveness of HBO2 is inconclusive",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "radical surgical debridement with fasciotomies",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**1st line treatment is surgical**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Shock",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Renal failure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "both mediated by **TNF alpha, IL-1, IL-6**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overall **25% mortality**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "50% mortality if bacteremic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "100% mortality if treatment is delayed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Poorer prognosis for older patients with comorbidities",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
