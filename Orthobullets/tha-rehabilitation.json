  "subtitle": "Updated: Jun 10 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Rehabilitation requires coordinated effort from",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic surgeon",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "physical therapist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "occupational therapist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "case manager",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nursing staff",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patient and patient's family",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Care can be broken down into different phases including",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**preoperative teaching**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**inpatient acute care** (hospital)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**inpatient extended care** (rehab/SNF)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**outpatient home care**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Preoperative Teaching",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical therapy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preoperative physical therapy **has not been shown to improve postoperative outcomes**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Hip precautions**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "useful if discussed before surgery",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "types of hip precautions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**posterolateral approach**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5036/images/posterior_hip_precautions.jpg",
                      "caption": "posterior hip precautions"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "avoid",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "flexion past 90 degrees",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "extreme internal rotation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "adduction past body's midline",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**anterolateral approach**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5036/images/anterolateral_precautions.jpg",
                      "caption": "atnerolateral hip precautions"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "avoid",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "extension",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "extreme external rotation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "adduction past the body's midline",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**direct anterior approach**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5036/images/bridging.jpg",
                      "caption": "bridging"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "avoid",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "bridging",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "extension",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "extreme external rotation",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "adduction past body's midline",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Inpatient Acute Care (Hospital)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pain management",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "NSAIDS and opioids given immediately before procedure reduce postoperative pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "intraoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "regional anesthesia (spinal and/or epidural)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**preferred over general anesthesia**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "periarticular multimodal drug injection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "decrease postoperative pain with minimal risks",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "postoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**multimodal oral drug therapy**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "gold standard",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical therapy goals",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sitting upright -->",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "gait training, ambulation with walker, out of bed to chair -->",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "transfers, gait normalization -->",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "independence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Discharge home criteria",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "independent ambulation with assistive device",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "independent transfers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "independent ADLs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stairs with supervision",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "appropriate home assistance (spouse, family, visiting nurses)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Inpatient Extended Care (Rehab)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Earlier discharge to rehab from hospital associated with **improved outcomes**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Discharge criteria to home similar to those in hospital",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Outpatient Care",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Return to sport",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**low-impact exercises** are preferred",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "golf",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "handicap shows minimal change after THA",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "handicap shows increase after TKA",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "high-impact exercises i**ncrease revision rates** in patients less than 55 years-old",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Driving recommendations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3-4 weeks after right THA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "less than 3-4 weeks after a left THA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reaction time returns to preoperative levels at 4-6 weeks",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Return to work",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "within a month if no manual labor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
