                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "elevation & depression",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "movement up and down along the rib cage",
                      "table": null,
