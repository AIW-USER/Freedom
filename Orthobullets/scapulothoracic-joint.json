{
  "title": "Scapulothoracic Joint",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3035/scapulothoracic-joint",
  "subtitle": "Updated: Aug 10 2022",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows scapular motion against the rib cage",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not a true joint; actually an articulation between the scapula and the thorax",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "is a sliding \"joint\" between medial border of scapula and ribs 2-7",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "resting position angulation (although these are variable even in healthy adults)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anteriorly 10-20°",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "internally rotated 30°-45° from the coronal plane",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "upward tilt of 3°",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Biomechanics",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
