{
  "title": "Osteoblastoma",
  "url": "https://www.orthobullets.com/pathology/8013/osteoblastoma",
  "subtitle": "Updated: Dec 28 2023",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteoblastomas are benign, aggressive osteogenic bone lesions commonly found in the posterior elements of the spine. Patients typically present between ages 10 and 30 with regional pain with only partial response from NSAIDs.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically by a characteristic lesion that is > 2 cm in diameter with a sclerotic margin and radiolucent nidus.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually curettage or marginal excision with bone grafting.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "relatively rare: 1% of all primary bone tumors and 10% of all osseous spinal neoplasms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "less common than osteoid osteoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males > females (2:1)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "majority of patients 10-30 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**most common in posterior elements of spine and sacrum (30-40%)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "other locations include diaphysis or metaphysis long bones (lower > upper extremities) and mandible",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Rearrangements of FOS (Chr 14) and FOSB (Chr 19) are reported",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oncogenic osteomalacia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**secondary ABC**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "10%-40% associated with secondary ABC",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "slowly progressive dull aching pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "night pain is not typical",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "partial response to NSAIDs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "may see **neurologic symptoms** with spine involvement",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "muscle atrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "limp",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of symptomatic area",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**lytic** or mixed **lytic-blastic** lesion with **radiolucent nidus** 2-10cm in size with occasional intralesional densities",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8013/images/osteoblastoma%20ct.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8013/images/Case%20C%20-%20xray%20-%20Parsons_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "reactive **sclerotic bone**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "66% cortically based, 33% medullary based; rarely periosteal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "often expansile with or without characteristic reactive bone formation seen in osteoid osteoma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "25% appear very aggressive and often mistaken for malignant lesion given minimal secondary bone reaction",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8013/images/osteoblastoma%20ct.jpg",
              "caption": ""
            }
          ],
          "importance": "3",
          "children": [
            {
              "text": "Indicated to fully evaluate lesion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Specifically helpful in characterizing the size, exact location, presence and extent of cortical disruption, and presence of a soft tissue component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8013/images/Case%20E%20-calcaneus%20-%20MRI%20-%20parsons_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "identifies reactive soft tissue edema and often better evaluates the soft tissue component if present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "low to intermediate T1 signal intensity and intermediate to high T2 signal intensity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hot** with intense focal uptake despite the pathologically benign features",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8013/images/Case%20B%20-%20bone%20scan%20-%20Parsons_moved.png",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "similar to osteoid osteoma but with more giant cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**distinct demarcation** between **nidus** and **reactive bone**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "nidus of **immature osteoid** and **osteoblasts** with abundant cytoplasm and normal nuclei",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "irregular seams of osteoid/woven bone spicules separated by loose fibrovascular stroma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rim of osteoblasts surrounds osteoid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "numerous mitotic figures, but not atypical",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rich vascularity often with extravasated erythrocytes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographic differential for osteoblastoma includes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "osteosarcoma",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "ABC",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "osteomyelitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteoid osteoma",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Differentiating from ABC",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "cross sectional imaging for ABCs demonstrate air-fluid levels and internal septations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "on histopathology, ABCs will demonstrate multiple blood filled sinusoidal spaces with fibrous walls",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Differentiating from osteosarcoma",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "osteoblastoma does not demonstrate periostitis unless in the setting of acute pathologic fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "soft tissue component more common with osteosarcoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteoblastoma does not infiltrate or permeate preexisting lamellar bone structures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteoblastoma is characterized by nuclear beta-catenin staining, whereas cytoplasmic or membranous staining of beta-catenin suggests osteosarcoma",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Differentiating from osteoid osteoma",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "characteristics specific to osteoblastoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**rare and locally aggressive but benign (not self limiting)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "over 40% occur in **posterior elements of spine** or sacrum",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8013/images/Case%20D%20-%20spine%20-%20xray_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "dull pain **less likely to be relieved by NSAIDs**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "larger",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "more giant cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Differential for lesions of the posterior spinal elements includes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "aneurysmal bone cyst",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteoid osteoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteoblastoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 4,
                  "bullets": [
                    {
                      "text": "Osteoid osteoma vs. Osteoblastoma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Osteoid Osteoma**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Osteoblastoma**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Incidence",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "10% of benign bone tumors",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "3% of benign bone tumors",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Size",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "< 2 cm (typically <1.5cm)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "> 2 cm (average, 3.0-3.5 cm)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Site",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "> 50% in long bone diaphysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "> 35% in posterior elements of the spine",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Location",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Proximal femur > tibia diaphysis > phalanges > spine",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Vertebral column > long bone diaphysis/metaphysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Natural history",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Self-limited",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Progressive",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Histology",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Benign appearance. No growth potential. Central nidus composed of more organized osteoid and lined by osteoblasts.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Benign appearance. Localized growth that is not self-limiting. Central lesion less organized with greater vascularity.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Symptoms",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Nocturnal pain, **relieved by NSAIDS.** If spine involvement, presents 75% of the time with painful scoliosis with lesion on concave side of curve",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Dull ache which is less likely to be relieved by NSAIDS (partial response). Neurologic symptoms common if spine involvement.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Management of Spine Lesions",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Nonsurgical management is indicated as first-line treatment, definitive treatment is percutaneous RFA/surgical resection",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Surgery is always indicated as they do not respond to nonsurgical treatment.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": []
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rarely indicated as the lesion will continue to grow",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "curettage or marginal excision with bone grafting",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "aqedeuate in most cases to achieve local control",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "can be combined with cryotherapy and chemical cauterization with phenol as adjuncts",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "En bloc resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "typically perfomed for locally aggressive, large, or recurrent lesions",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "occasionally required for lesions in the spine",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lower risk of recurrence compared to curettage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "excellent prognosis with most patients disease free after the initial surgical treatment.",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "most common complication is local reoccurrence, with rates as high as 15-25%",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "recurrence is most common in initial 2 years following treatment but is rare after 2 years",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    }
