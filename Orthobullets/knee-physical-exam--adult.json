    {
      "text": "Neurovascular",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Motor",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "knee flexion - sciatic nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "knee extension - femoral nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "foot plantarflexion - tibial nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "foot dorsiflexion - deep peroneal nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Sensory",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medial thigh - obturator nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "anterior thigh - femoral nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterolateral leg - sciatic nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "dorsal foot - peroneal nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "plantar foot - tibial nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pulses",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "popliteal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "dorsal pedis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior tibial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Reflexes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patellar (L4)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypoactive / absent is concerning for L4 radiculopathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hyperactive may indicate UMN injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "ROM",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Flexion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "125-135 deg",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Extension",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "0-10 deg hyperexension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Rotation (stabilize femur)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "10-15 deg internal and external tibial rotation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Special Tests",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Anterior Cruciate Ligament**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**Lachman's test**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/acl-5.jpg",
                  "caption": "Lachman&#39;s"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "most sensitive test for ACL rupture",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "flex knee to 20-30 deg, translate tibia with anteriorly directed force",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "grading",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "A= firm endpoint, B= no endpoint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Grade 1: <5 mm translation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Grade 2 A/B: 5-10mm translation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Grade 3 A/B: >10mm translation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**anterior drawer**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/anterior-drawer-test.jpg",
                  "caption": "Ant drawer"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "flex knee to 90 deg, translate tibia with anteriorly directed force",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "laxity in anterior translation indicates ACL injury",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**pivot shift**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "patient is supine with the knee fully extended",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "place an internal rotation and valgus force on the proximal tibia while flexing the knee",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "clunk with flexion indicates ACL injury",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "with ACL deficient knee, the tibia starts subluxed and reduces with flexion, causing a clunk",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ITB",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12755/images/b9780702034732000137_f009-022-9780702034732.jpg",
                      "caption": "ITB"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "starts anterior to the pivot point of the knee with the lateral plateua subluxed anterior (due to ACL deficiency)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "ITB pull then becomes posterior to pivot point of the tibia during flexion causing subluxed lateral plateau to reduce with a clunk",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Posterior Cruciate Ligament",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**posterior drawer**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/posterior-drawer-test.jpg",
                  "caption": "Post Drawer"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "flex knee to 90 deg, posteriorly directed force on tibia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**posterior sag**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/figure_03.jpg",
                  "caption": "Post Sag"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "place the patient supine, hip at 45 deg, and knee at 90 deg",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "view the knee from the lateral position",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "posterior translation of the tibia in relation to the femur, indicates a PCL injury",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**quadriceps active**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "with the patient supine, flex the knee to 90 deg and have the patient fire their quadriceps",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "posterior subluxed tibia will translate anteriorly if PCL is deficient",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**reverse pivot shift**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/9781604065145_c005_f006.jpg",
                  "caption": "Rev pivot shift"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "with the patient supine, flex the knee to 45 deg, ER and apply a valgus force to the proximal tibia and extend the knee",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "a clunk with knee extension indicates a PCL injury",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Collateral Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**valgus stress**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/b9781437716030500146_f11-04-9781437716030.jpg",
                  "caption": "valgus stress"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "lateral force to knee at 0 and 30 deg",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "laxity at 30 deg indicates MCL injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "laxity at 0 deg indicates MCL and cruciate injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**varus stress**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/hqdefault-2.jpg",
                  "caption": "Varus stress"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "medial force to knee at 0 and 30 deg",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "laxity at 30 deg indicates LCL injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "laxity at 0 deg indicates LCL and cruciate injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Meniscus",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**joint line tenderness**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/7321630.jpg",
                  "caption": "Joint line"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "most sensitive test for meniscal tear when pain is present",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "palpate medial and lateral joint lines",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**McMurray's test**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "place knee into flexion, and internal rotation, then extend the knee",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "pain or pop sensation indicates lateral meniscus tear",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "place knee into flexion, and external rotation, then extend the knee",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "pain or pop sensation indicates medial meniscus tear",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Apley's compression test**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/apley-grind-test.jpg",
                  "caption": "appley&#39;s"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "with the patient prone, place the knee at 90 deg, then compress and rotate the leg",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "pain or pop sesation indicates meniscal tear",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Patellofemoral Joint",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**patella displacement**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/images..jpg",
                  "caption": "Patella displacement"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "translate patella medially or laterally",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "divide patella into 4 quadrants",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "patella should translate 2 quadrants in both directions",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**patella apprehension**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "relax the quads and place laterally directed force on patella",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "pain or apprehension would indicate MPFL or medial retinacular injury",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**J-sign**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "extend the patient's knee from a flexed position",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "maltracking noted if patella is laterally displacing in full extension",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**patella grind test**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "have the patient activate their quadriceps while placing a compression force on the patella when the knee is in full extension",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "pain would indicate patellar/trochlear OCD, chondromalacia, or arthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Extensor Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**straight leg raise**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/366e00_fd8db543caa54553b37b44d4d4ebe5b5.jpg",
                  "caption": "SLR"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/12755/images/maxresdefault.jpg",
                  "caption": "+ SLR"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "patient supine, have them raise the foot off the bed and hold it in position",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "light resistance can test strength",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inability to perform suggests quadriceps or patellar tendon injuries",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
