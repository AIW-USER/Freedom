        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "metatarsus adductus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tarsometatarsal capsulotomies",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "aged 2-4yr with failed nonop management",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "lateral column shortening and medial column opening osteotomies, multiple metatarsal osteotomies",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "age > 5yrs (as the deformity may correct with growth until this age)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "resistant cases that fail nonoperative treatment (usually with medial skin crease)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "severe deformity produces difficulty with shoeware and pain",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "technique",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "lateral column shortening done with cuboid closing wedge osteotomy",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "medial column lengthening includes a cuneiform opening wedge osteotomy with medial capsular release and abductor hallucis longus recession (for atavistic first toe)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "serpentine foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "opening wedge and closing wedge osteotomies",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "indicated if **serpentine deformity** is symptomatic and significantly limits function",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "operative treatment is difficult and often times deformity is accepted and observed",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "technique",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "calcaneal osteotomy for hindfoot valgus",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "possible midfoot osteotomies to correct midfoot and forefoot deformities",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "**multiple metatarsal osteotomies with forefoot pinning** and tarsometatarsal capsular release (Hamen procedure)",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/4061/images/Hamen%20procedure%20-%20courtesy%20Miller_moved.png",
                              "caption": ""
                            }
                          ],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Long-term studies show that residual metatarsus adductus is not related to pain or decreased foot function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Associated with late medial cuneiform obliquity (not hallux valgus)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
