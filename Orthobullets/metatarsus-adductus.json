            {
              "text": "**serpentine Foot** (complex skew foot)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a condition that can be considered on the axis of severity of metatarsus adductus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "residual tarsometatarsal adductus, talonavicular lateral subluxation, and hindfoot valgus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "different from metatarsus adductus in that nonoperative treatment and casting are ineffective at correcting deformity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
