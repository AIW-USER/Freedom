{
  "title": "Metatarsus Adductus",
  "url": "https://www.orthobullets.com/pediatrics/4061/metatarsus-adductus",
  "subtitle": "Updated: Jun 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Metatarsus Adductus is a common congenital condition in infants that is thought to be caused by intra-uterine positioning that lead to abnormal adduction of the forefoot at the tarsometatarsal joint.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with medial deviation of the forefoot with normal alignment of the hindfoot.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is generally nonoperative with stretching if the deformity can be passively corrected, and with casting if the deformity is rigid. Surgical management is indicated for patients with progressive deformities who fail nonoperative management.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs in approximately 1 in 1,000 births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "equal frequency in males and females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bilateral approximately 50% of cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Increased incidence in",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "late pregnancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "first pregnancies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "twin pregnancies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "oligohydramnios",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**DDH** (15-20%)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "torticollis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thought to be related to packaging disorder caused by intra-uterine positioning",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "parents complain of intoeing, usually in first year of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tickling to foot can allow evaluation of active correction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "evaluation for intoeing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**metatarsus adductus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "forefoot is adducted",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "lateral foot border is convex instead of straight",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "a medial soft-tissue crease indicates a more rigid deformity",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "normal hindfoot and subtalar motion",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**femoral anteversion**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "hip motion shows >70° internal rotation (normal is 30-60°) and decreased external rotation",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "patella internally rotated",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**tibial torsion**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "observe foot-thigh angle in prone position",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "> 10° of internal rotation is indicative of tibial torsion (normal is 0-20° of external rotation)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
