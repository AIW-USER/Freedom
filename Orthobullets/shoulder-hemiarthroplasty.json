{
  "title": "Shoulder Hemiarthroplasty",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3074/shoulder-hemiarthroplasty",
  "subtitle": "Updated: Sep 13 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A shoulder hemiarthroplasty is a procedure in which the humeral articular surface is replaced with stemmed humeral component.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "The most common indication is glenohumeral arthritis when the glenoid bone stock is inadequate for a total shoulder arthroplasty.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "It is contraindicated in patients with coracoacromial ligament deficiency.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary arthritis, if:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**rotator cuff is deficient**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "glenoid bone stock is inadequate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "risk of glenoid loosening is high",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "young patients",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "active laborers",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "rotator cuff arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hemiarthroplasty > rTSA if able to achieve forward flexion > 90 degrees",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "osteonecrosis without glenoid involvement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "proximal humerus fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "three-part fractures with poor bone quality",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**four-part fractures**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "head-splitting fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fracture with significant destruction of the articular surface",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neuropathic joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "unmotivated patient",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**coracoacromial ligament deficiency**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "provides a barrier to humeral head proximal migration in the case of a rotator cuff tear",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "superior escape will occur if coracoacromial ligament and rotator cuff are deficient",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Outcomes",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Rotator cuff deficiency",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**status of the rotator cuff** is the most influential factor affecting postoperative function in shoulder hemiarthroplasty",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Proximal humerus fractures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "provides **excellent pain relief** in a majority of patients",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "outcome scores inversely proportional to",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patient age",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "time from injury to operation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Preoperative Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "true (Grashey) AP of shoulder",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3074/images/final%20shoulder.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "taken 30-40 degrees oblique to the coronal plane of the body",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "findings",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "helps determine extent of DJD",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "delineation of fracture pattern",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "axillary view",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3074/images/axillary%20view.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "findings",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "look for posterior wear of glenoid",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3074/images/posterior%20glenoid%20wear.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "helps quantify displacement in cases of fracture",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obtain CT scan to determine **glenoid version and glenoid bone stock**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "useful if fracture pattern is poorly understood after radiographic evaluation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful for evaluation of rotator cuff",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "deltopectoral approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Shaft preparation and prosthesis placement",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "humeral head resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "start osteotomy at medial insertion line of supraspinatus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "determine retroversion, implant height and head size",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "retroversion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**30° of retroversion is ideal**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "lateral fin should be **slightly posterior to biceps groove**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "excessive anteversion leads to risk of **anterior dislocation**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "excessive retroversion leads to risk of **posterior dislocation**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "implant height",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "greater tuberosity should be",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "7 to 8 mm below the top of the prosthetic humeral head",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "functions to",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": [
                                {
                                  "text": "maintain cuff and biceps tension",
                                  "table": null,
                                  "images": [],
                                  "importance": "3",
                                  "children": []
                                },
                                {
                                  "text": "recreate normal contour of medial calcar",
                                  "table": null,
                                  "images": [],
                                  "importance": "3",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "technique to achieve",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": [
                                {
                                  "text": "cement prosthesis proud",
                                  "table": null,
                                  "images": [],
                                  "importance": "3",
                                  "children": []
                                },
                                {
                                  "text": "distance from top of prosthesis head to **upper border of pectoralis major** should be 56mm.",
                                  "table": null,
                                  "images": [],
                                  "importance": "4",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "head size",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "determine size by using",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "radiograph of contralateral shoulder or",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "measuring size of native head removed earlier in procedure",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "using too large of a head may **\"overstuff\" joint**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Fixation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cemented prosthesis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**standard of care**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "provides better quality of life, range of motion, and strength compared to uncemented humeral component",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tuberosity reduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "introduction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tuberosity migration is one of the **most common causes of failure** for fractures treated with hemiarthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "strict attention to securing the tuberosities to each other and to the shaft",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "autogenous bone grafting from the excised humeral head will decrease the incidence of pull-off and improve healing rates",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tuberosity reduction must be anatomic or it may lead to a deficit in rotation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "The \"Ream and Run\" Procedure",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "introduction",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "shoulder hemiarthroplasty with concentric glenoid reaming (non-prosthetic glenoid arthroplasty)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "avoids the potential limitations associated with a prosthetic glenoid component",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "provides patient with the opportunity for a level of activity beyond that recommended for a total shoulder arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "spherical reaming of the osseous glenoid surface to optimize both glenohumeral stability and the distribution of load applied by the humeral prosthesis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "the glenoid face is reamed to a single smooth concavity using a nubbed spherical reamer",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "excellent functional and radiographic 2-year outcomes",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Rehab",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Early passive motion until fracture has healed",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "duration usually 6-8 weeks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Strengthening exercises begin once tuberosity has fully healed",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Progressive glenoid arthrosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "increased risk with",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "young patients",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "active patient",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**conversion to total shoulder arthroplasty**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Tuberosity displacement/malunion**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "one of the most common complications of shoulder hemiarthroplasty when used to treat fracture",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "repositioning of the tuberosity with bone grafting",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Joint overstuffing**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "may lead to",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "stiffness",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "accelerated arthritis of glenoid",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Subcutaneous (anterosuperior) escape**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3074/images/anterosuperior%20escape.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "occurs when both rotator cuff and coracoacromial arch are deficient",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "better outcomes with conversion to reverse shoulder arthroplasty compared to anatomic TSA",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
