{
  "title": "Hemihypertrophy",
  "url": "https://www.orthobullets.com/pediatrics/4044/hemihypertrophy",
  "subtitle": "Updated: Jun 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hemihypertrophy is an idiopathic condition that can also be caused by a variety of syndromes, and presents with asymmetry between the right and left sides of the body to a greater degree than can be attributed to normal variation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with abnormal asymmetry defined as a 5% or greater difference in length and/or circumference.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is observation with or without shoe lifts for leg length differences < 2 cm at skeletal maturity. Surgical intervention is indicated for leg length differences > 2 cm, with different techniques depending on the discrepancy magnitude and remaining skeletal growth.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "varies from 1:14,000 to 1:86,000",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "male:female = 2:3",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "slightly more common on the right side",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may also involve head, trunk and internal organs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common causes are",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**idiopathic (non-syndromic)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**syndromic**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**neurofibromatosis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**Beckwith-Wiedemann syndrome**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "Klippel-Trenauney syndrome",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Proteus syndrome",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**scoliosis (compensatory)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "peripheral nerve entrapment (rare)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "medical conditions & comorbidities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "malignant intra-abdominal tumors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Wilm's tumor** (most common)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "perform serial abdominal ultrasounds (every 3 months) until age 7 to rule out Wilm's tumor",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "then physical exam every 6 months until skeletal maturity",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "adrenal carcinoma",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "hepatoblastoma",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**genitourinary abnormalities**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "medullary sponge kidneys",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "polycystic kidney",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "inguinal hernias",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**congenital**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "total",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "involvement of all organ systems",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "limited",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "only muscular, vascular, skeletal, or neurologic involvement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "classic (ipsilateral upper and lower limbs)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "segmental (a single limb)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "facial",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/4044/images/hemit.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "crossed",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**acquired**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "very rare",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "can result from injury, infection, radiation or inflammation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Syndromic classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**non-syndromic** (isolated)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**syndromic** (part of a clinical syndrome)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings rarely apparent at birth, manifest during growth",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "skin often thicker on involved side",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "more hair on corresponding side of the head",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "limb circumference asymmetric",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "leg-length discrepancy (LLD)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "AP + lateral of affected limb may demonstrate enlargement of bone and soft tissue",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4044/images/hemilld.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "osseous maturation may be seen",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Abdominal ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "perform serial abdominal ultrasounds (every 3 months) until age 7 to rule out Wilm's tumor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Renal function tests",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Serum alpha-fetoprotein",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "screen for embryonal tumors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation, shoelift, corrective shoes",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**< 2 cm** projected LLD at maturity",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical correction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "based on principles of **leg length discrepancies**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
