    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "double-jointedness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "easily damaged, bruised, & stretchy skin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "easy scarring & poor wound healing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "increased joint mobility, joint popping, early arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "especially shoulders, patellae, ankles",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "chronic musculoskeletal pain (50%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a score of 5 or more on 9-point **Beighton-Horan scale defines joint hypermobility** ; however this threshold varies in the literature",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "passive hyperextension of each small finger >90° (1 point each)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4111/images/eds%20small%20finger%20dorsiflexion.jpg",
                      "caption": "Shows hypermobility of the small finger in Ehlers-Danlos syndrome."
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "passive abduction of each thumb to the surface of forearm (1 point each)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4111/images/ehlers-danlos%20thumb%20apposition.jpg",
                      "caption": "Shows hypermobility of the thumb in Ehlers-Danlos syndrome."
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "hyperextension of each knee >10° (1 point each)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "hyperextension of each elbow >10° (1 point each)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "forward flexion of trunk with palms on floor and knees fully extended (1 point)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "look for joint dislocations/subluxations",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4111/images/eds%20radiograph%20bilateral%20feet.jpg",
                  "caption": "Shows incongruent first MTP joints in Ehlers-Danlos syndrome."
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "kyphoscoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Echocardiogram**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "cardiac evaluation with echo is mandatory in the workup",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "up to 1/3 of patients have aortic root dilatation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Labs",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosed by collagen typing of skin biopsy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physical therapy, orthotics, supportive measures for pain",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "mainstay of treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthrodesis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "joints recalcitrant to non-operative management",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "soft tissue procedures are unlikely successful in hypermobile joints",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "posterior spinal fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "progressive scoliosis (most common in Kyphoscoliosis Type)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "longer fusions needed to prevent junctional problems",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
