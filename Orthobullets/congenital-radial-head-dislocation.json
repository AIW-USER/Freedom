      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "almost always **posterior dislocation of radial head**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "often combined with **bowing of the radius**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "the radius often **appears too long compared to the ulna**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
