      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital radial head dislocation",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "can be differentiated from traumatic dislocation by",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "bilateral involvement",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "hypoplastic capitellum",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "convex radial head",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "other congenital anomalies",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lack of history of trauma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "difficult to reduce",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
