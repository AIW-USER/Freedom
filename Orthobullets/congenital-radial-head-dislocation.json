                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**Posterior** dislocation (~70%) more common than anterior (15%) and lateral dislocation (15%)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "bilateral in the majority of cases",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
