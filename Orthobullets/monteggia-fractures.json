      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**PIN neuropathy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "up to 10% in acute injuries",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "due to blunt trauma to nerve related to redial head dislocation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "observation for 2-3 months",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**spontaneously resolves in most cases**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "if no improvement obtain nerve conduction studies",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Malunion with radial head dislocation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "usually caused by failure to obtain anatomic alignment of ulna",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "ulnar osteotomy and open reduction of the radial head",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "consider radial head excision in chronic malunion",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "must have competent medial collateral ligament to prevent valgus instability",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
