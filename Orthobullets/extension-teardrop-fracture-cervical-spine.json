{
  "title": "Extension Teardrop Fracture Cervical Spine",
  "url": "https://www.orthobullets.com/spine/12102/extension-teardrop-fracture-cervical-spine",
  "subtitle": "Updated: Oct 2 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Extension teardrop fractures of the cervical spine are subaxial cervical spine fractures caused by forced extension of the neck, resulting in avulsion of the anteroinferior corner of the vertebral body",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made with lateral radiographs of the cervical spine",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually immobilization in a hard collar, as the injury is mechanically stable",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extension mechanism causes disruption of the anterior longitudinal ligament (ALL)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "represents a true avulsion, often of an anterior osteophyte",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**important to distinguish from a flexion teardrop fracture**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "flexion teardrop fractures have larger fragments produced by compression",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "extension teardrop fractures are stable in flexion and unstable in extension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**not considered as severe as flexion teardrop fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**central cord syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "due to buckling of the ligamentum flavum into the canal during the hyperextension phase of injury",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "risk factors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "elderly patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "anterior osteophytes and infolded posterior ligamentum flavum",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "can be seen in diving accidents",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "not usually associated with spinal cord injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neck pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually neurologically intact",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may have symptoms of central cord syndrome",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommend views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of the cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**avulsion fracture** from the attachment of the ALL off the inferior corner of the vertebral body",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12102/images/43d577137344a1ff3201bacbd3d361_jumbo.jpg",
                      "caption": "XR Teardrop"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "usually a thin fracture fragment",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "fragment is usually triangular in shape (reminiscent of a teardrop)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "may see anterior disc space widening",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may help distinguish extension injury from flexion injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**edema will be located anteriorly** in extension injury",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization in a hard collar",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
