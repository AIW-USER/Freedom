                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "consists of 3 parts",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4029/images/c4b26689-3de6-4fcd-9f3c-d6428df34c49_pedankle-1..jpg",
                      "caption": "Triplane fracture"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "anterolateral quadrant of distal tibial epiphysis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "medial and posterior portions of epiphysis with posterior metaphyseal spike",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "tibial metaphysis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "AP radiograph shows **SH III fracture**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4029/images/preopap.jpg",
                      "caption": "AP view"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "lateral radiograph shows **SH II fracture**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4029/images/preoplat.jpg",
                      "caption": "lat pre"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually required to delineate fracture pattern and assess articular congruity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "if closed reduction planned, consider CT after reduction to assess quality of reduction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fracture involvement seen in all 3 planes",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4029/images/ctscan.jpg",
                      "caption": "CT"
                    }
                  ],
