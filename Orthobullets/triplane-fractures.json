    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction and casting",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "< 2mm displacement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "ideal for 2-part fractures (difficult to achieve reduction of 3-part or 4-part fractures)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "reduction maneuvers",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "reduce fibula fracture prior to attempting reduction of tibial fracture",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "for lateral triplane fractures, reduce with **internal rotation**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "for medial triplane fractures, reduce with **eversion**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "obtain post-reduction CT to assess reduction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**long leg cast** initially for 3-4 weeks to control rotational component of injury",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "follow early with radiographs to assess for displacement",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "immobilize an additional 2-4 weeks in a **short leg cast** or walking boot (to initiate ankle ROM)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CRPP vs. ORIF",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "> 2mm displacement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**CRPP vs. ORIF**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "anterolateral approach for lateral triplane fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "anteromedial approach for medial triplane fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "reduction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "for lateral triplane fractures, reduce with **internal rotation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "for medial triplane fractures, reduce with **external rotation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**arthroscopically-assisted reduction has been described**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "K wires or cannulated screws",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "epiphyseal screws **placed parallel to physis**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4029/images/postop.jpg",
                      "caption": "postop"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "metaphyseal fixation if component is large enough",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "post-op",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "long leg cast for 3-4 weeks then short leg walking cast for 2 weeks",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications specific to this treatment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "hardware irritation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "transient neuropathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Growth arrest**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "occurs in 7-21%",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "increased risk with pronation-abduction injuries compared to supination-external rotation injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "increased risk with residual fracture displacement following reduction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "usually insignificant but should closely follow patients with > 2 years of growth remaining",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Ankle pain and degeneration**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "increased risk with articular step-off > 2mm",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
