{
  "title": "Pangea® Medial NPC Plate",
  "url": "https://www.orthobullets.com/implants/423338/pangea-r--medial-npc-plate",
  "subtitle": "Updated: Jun 1 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Designed with SOMA (Stryker Orthopedics Modeling and Analytics) which includes a database with CT scans from hospitals across the world and state of the art algorithms that analyze shape variability, bone density, and implant fit",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Designed to link with the T2 Alpha Femur Retrograde Nail when using nail plate combination fixation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Eight distal T20 screw holes, including 1 linking hole and 1 AP hole designed to capture Hoffa fragments",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Related Implants",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The Pangea® Femur Reconstruction System includes",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**Lateral NPC Plate**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**Medial NPC Plate (this topic)**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**T2 Alpha™ Femur Retrograde Nailing System**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Design",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Tapered end",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "allows for atraumatic submuscular insertion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Staggered screw holes",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "designed to enable surgeon to choose points of fixation and allows for placement of screws around an intramedullary implant or a prothesis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "AP hole",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423338/images/a9380712-c72e-44cb-8caa-b9e977f76f80_screenshot_2026-03-05_at_4.22.20_pm.jpg",
              "caption": "AP hole"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "screw hole trajectory that is designed to capture a \"Hoffa Fragment\" (Posterior Medial Condyle)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Variable-angle screw holes",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423338/images/a5cf012f-7eb2-4879-bcac-e3eae0d374f7_screenshot_2026-03-05_at_4.22.47_pm.jpg",
              "caption": "Variable-angle screw holes"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "circular universal holes accept non-locking screws, and locking screws within a 30° cone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Proximal twist",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "metadiaphyseal twist allows for screw placement anterior to posterior",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Linking hole",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "designed to allow for seamless linking of the plate to a T2 Alpha Femur Retrograde Nail using an AlphaLink Dowel",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "partial articular medial tibial plateau fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "medial plateau fragments in bicondylar tibial plateau fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "metaphyseal fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "epiphyseal fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "extra-articular proximal tibial fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "active or suspected infection at the surgical site",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "severe local inflammation around the operative area",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "hypersensitivity or allergy to implant materials",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "inadequate soft-tissue coverage over the implant",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
