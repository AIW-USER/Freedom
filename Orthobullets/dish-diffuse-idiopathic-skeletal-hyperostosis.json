    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnostic criteria",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flowing ossification along the anterolateral aspect of **at least 4 contiguous vertebrae**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "preservation of **disc height** in the involved vertebral segment and a relative absence of significant degenerative changes (e.g. marginal sclerosis of the vertebral bodies or vacuum phenomenon)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**absence** of facet-joint ankylosis and absence of SI joint erosion, sclerosis, or intra-articular osseous fusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activity modification, physical therapy, brace wear, NSAIDs, and bisphosphonate therapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "cervical traction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cervical spine fracture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "use with caution because traction may result in excessive distraction due to compromised ligamentous integrity",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spinal decompression and stabilization",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
