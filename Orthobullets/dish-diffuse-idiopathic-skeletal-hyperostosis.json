          "importance": "1",
          "children": [
            {
              "text": "for cervical spine trauma in DISH",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "15% for those treated operatively",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "67% for those treated nonoperatively",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "higher mortality rates than patients with cervical spine trauma and ankylosing spondylitis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "similar mortality rates to patients with ankylosing spondylitis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Heterotopic ossification**",
