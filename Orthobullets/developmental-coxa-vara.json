{
  "title": "Developmental Coxa Vara",
  "url": "https://www.orthobullets.com/pediatrics/4041/developmental-coxa-vara",
  "subtitle": "Updated: Jun 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Developmental Coxa Vara is a rare condition that causes a decreased neck-shaft angle that is associated with an ossification defect in inferior femoral neck.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be confirmed with plain radiographs of the hip.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment can be nonoperative or surgical corrective valgus derotation osteotomy depending on patient symptoms, the severity of varus deformity, and degree of angle progression.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**1 in 25,000 live births in the US**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males and females affected equally",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "presents between age of ambulation and 6 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bilateral in **1 in 3 cases**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "congenital defects",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "differential diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "trauma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "SCFE",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Legg-Calve-Perthes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**proximal femoral cartilaginous physis** or **ossification center defects lead to**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "decreased proximal femoral neck-shaft angle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "vertical position of the proximal femoral physis and varus",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "pathomechanics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "coxa vara and vertical physis increases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "physeal sheering forces",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "inferior medial neck compressive forces",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no clear inheritance pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "femoral neck **stress fractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "decreased limb length",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "early hip osteoarthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Etiologies of Coxa Vara",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**developmental**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**congenital (e.g. congenital short femur, PFFD)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**acquired (e.g. SCFE, infection, Perthes)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**dysplasia (e.g OI, Jansen, Schmid, SED)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**cretinism**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "previous hip trauma or infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "associated skeletal abnormalities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prenatal and developmental history",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "family history of similar deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**usually painless**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**gait abnormality**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "waddling or limp (trendelenburg gait)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "caused by abductor weakness from tension abnormality",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**leg length discrepancy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "high riding greater trochanter",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "limb shortening",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "excessive lumbar lordosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "restricted **hip range of motion** in all planes that is usually non-tender",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP hip with limb internally rotated + lateral hip",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**varus neck shaft angle <120 degrees**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "short femoral neck, vertical physis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**increased Hilgenreiner's epiphyseal angle (normal <25 degrees**)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "determined on AP as angle between Hilgenreiner's line and a line through the proximal femoral physis",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4041/images/SA%20Hilgenreiners%20Physeal%20angle_moved.jpg",
                          "caption": "Hilgenreiner&#39;s epiphyseal angle (normal &lt;25 degrees)"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4041/images/Xray%20-%20emedicine%20with%20Hingenreiner's_moved.jpg",
                          "caption": "increased Hilgenreiner&#39;s epiphyseal angle (normal &lt;25 degrees)"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "triangular metaphyseal fragment in inferior femoral neck (looks like **inverted-Y radiolucency)**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4041/images/Xray%20-%20emedicine2%20-%20ossification%20defect_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "decreased femoral anteversion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgical planning",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "delineate proximal femur defects",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "orientation of deformity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "consider all views including **3D reconstructions**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "deformity configuration",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bone stock",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "physeal widening",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation alone",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "Hilgenreiner-ephyseal angle (normal <25 degrees)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**<45 degrees – unlikely to progress**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "45-60 – may progress",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "will require close follow-up if non-symptomatic",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "corrective valgus derotation osteotomy (VDRO)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4041/images/Xray%20-%20emedicine2-progression_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**Hilgenreiner's physeal angle > 60°**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**Hilgenreiner's physeal angle between 45-60° if symptomatic (e.g. limp & progression of varus)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "progressive decrease in neck shaft angle < 110 °",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "aftercare",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**hip-spica** or abduction pillow x 4-6 weeks depending on fixation and healing",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Corrective valgus derotation osteotomy (VDRO)**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4041/images/Xray%20-%20emedicine2-progression_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "goals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "over-correct neck shaft angle (literature suggests to reduce Hilgenreiner's physeal angle < 38**°)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "correct leg length discrepancy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "correct hip anteversion/retroversion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "re-establish abductor muscle tensioning",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "typically a **hip direct lateral approach** is used",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "procedure(s)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**valgus trochanteric osteotomy** – may fix with blade plate",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "supine with bump",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "perform adductor tenotomy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "direct lateral approach",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "valgus osteotomy as template",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "overcorrect to place physis in horizontal position (to decrease shear stress)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "derotation to antevert neck as neck",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "hip cast post-op for 6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**greater trochanter epiphyseodesis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "to prevent GT overgrowth in vascular coxa vara",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "lateral approach",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fluoro to determine position of physis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "curette or drill physis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**greater trochanter transfer**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "lateral approach",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "free GT fragment of soft tissues",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "transfer distal and lateral",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "freshen lateral femoral recipient bed cortex with osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "place GT fragment so that tip is at level of femoral head",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Loss of correction**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Premature closure of the proximal femoral physis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Overgrowth of proximal femur**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Dysplasia of acetabulum**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
