{
  "title": "Osteochondritis Dissecans",
  "url": "https://www.orthobullets.com/knee-and-sports/3028/osteochondritis-dissecans",
  "subtitle": "Updated: Aug 11 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteochondritis Dissecans is a pathologic lesion affecting articular cartilage and subchondral bone with variable clinical patterns.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis may be made radiographically (notch view) but MRI usually required to determine size and stability of lesion, and to document the degree of cartilage injury.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative with restricted weight bearing in children with open physis. Surgical treatment may be indicated in older patients (closed physis), lesions that are unstable and patients who have failed conservative management.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "juvenile form (open physes)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occurs at age 10-15 (median age: 13.1) while the physis is still open",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "adult form (skeletal maturity)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "knee (most common)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterolateral aspect of **medial femoral condyle** (70% of lesions in knee)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "capitellum of humerus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "talus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism/etiology may be",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hereditary",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "traumatic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "vascular",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "cause of adult form is thought to be vascular",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomic cascade",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "softening of the overlying articular cartilage with intact articular surface",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "early articular cartilage separation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "partial detachment of lesion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "osteochondral separation with loose bodies",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
