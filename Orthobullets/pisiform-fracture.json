{
  "title": "Pisiform Fracture",
  "url": "https://www.orthobullets.com/hand/6112/pisiform-fracture",
  "subtitle": "Updated: May 14 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pisiform Fractures are rare carpal fractures associated with falls on an outstretched hand.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is often made with orthogonal radiographs but may require CT for confirmation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is primarily nonoperative with painful nonunions requiring surgical excision.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "<1% of carpal fractures",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6112/images/carpal_fractures.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "rare injury and often missed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually occurs by direct impact against a hard surface",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**fall on outstretched hand**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "50% occur as isolated injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "50% occur in association with other carpal fractures or distal radius fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pisiform Bone",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "osteology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pea shaped, seasmoid bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most ulnar and palmar carpal bone in proximal row",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "located within the **FCU** tendon",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "contributes to the stability of the ulnar column by preventing triquetral subluxation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ulnar sided wrist pain** after a fall",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "grip weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypothenar tenderness and swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**rule out associated injury** to other carpal bones and distal radius",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "PA",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6112/images/pisiform_fracture.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ER oblique",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "carpal tunnel",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**best seen with ER oblique or carpal tunnel view**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6112/images/fracture.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "may be required to delineate fracture pattern and determine treatment plan",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "suspected carpal fracture with negative radiographs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may show bone marrow edema within the pisiform indicating fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hamate body fracture",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Hook of hamate fracture",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "FCU tendonitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis confirmed by history, physical exam, and radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early immobilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "short arm cast with **30 degrees of wrist flexion** and ulnar deviation for 6-8 weeks",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most often go on to heal without posttraumatic osteoarthritis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pisiformectomy**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "severely displaced and symptomatic fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "painful nonunion",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "studies show a pisiformectomy is a reliable way to relieve this pain and does not impair wrist function",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Malunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Non-union**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Chronic ulnar sided pain**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Decreased grip strength**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    }
