              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Dorsal Medial Plate",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423257/images/986ee84c-9cce-48e2-bdd9-5517eb445c63_screenshot_2025-03-28_at_4.20.43_pm.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
