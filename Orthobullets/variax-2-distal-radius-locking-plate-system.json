    },
    {
      "text": "Design",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The VariAx 2 Distal Radius Plating System provides you with a comprehensive range of anatomic plating options that work with a common instrument and screw platform",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Plates utilize SmartLock technology which permits polyaxial screw placement",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "You can angle locking screws up to 15˚in each direction for a total range of 30˚ providing you with the flexibility to position screws based on the patient, not a plate’s pre-existing design",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423223/images/858c584b-2bed-4b14-a4db-25cdcda32985_screenshot_2025-03-27_at_10.24.33_am.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Volar Distal Radius Plate Offerings",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Volar Distal Radius Plate**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423257/images/04525884-8182-452f-8c6f-9e1d8beb61a2_screenshot_2025-04-11_at_9.16.54_am.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "Designed using Stryker Orthopaedics Modeling and Analytics (SOMA) database",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Distal taper around the watershed line",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Plate shape and thickness designed to reduce the potential for soft tissue irritation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Functional window that allows fracture visualization, bone grafting and monoaxial locking",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Transverse hole is designed to allow for ulnar/radial plate adjustment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Extended Volar Distal Radius Plate**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423257/images/c640a06f-bf9e-4a40-b3c0-81000f3d4999_screenshot_2025-04-11_at_9.17.01_am.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "All the benefits of the Volar Distal Radius plate plus a more distal plate outline and screw pattern as well as a pre-bent extension for buttressing the volar-ulnar corner",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Tapered distal portion designed to reduce the risk of protrusion and soft tissue irritation around the watershed line",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Suture holes designed to allow for volar capsule tissue approximation with sutures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**XXS Distal Radius Plate**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423257/images/72fe3127-8696-4f9c-b592-fd0a7506aa3a_screenshot_2025-04-11_at_9.17.05_am.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "Designed for a minimally invasive approach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Available sterile only",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Dorsal and Fragment Specific Plates",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Standard Dorsal Plate",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423223/images/e09fa781-3bad-48e4-93f8-b6d69085d9c2_screenshot_2025-03-27_at_9.18.16_am_copy.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "SOMA designed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "2mm thickness",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Styloid screw hole that can be bent if desired to patient’s need",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Low plate profile and flush screws to minimize soft tissue irritation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Butressing of the complete dorsal rim",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Pre-angulated divergent screw trajectories distally",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Lateral Plate",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423223/images/ccec9907-0fac-4e80-9d01-2f7f86e3b90a_screenshot_2025-03-27_at_9.18.26_am.jpg",
