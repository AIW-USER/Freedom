              "children": []
            },
            {
              "text": "2mm thickness",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Distal K-wire holes for paperclipping and additional small fragment fixation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Dorsal Lateral Plate",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423223/images/2ca13849-4255-475d-bb56-ca600abd69c9_screenshot_2025-03-27_at_9.18.48_am.jpg",
              "caption": ""
