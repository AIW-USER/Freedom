{
  "title": "Cervical Spondylosis",
  "url": "https://www.orthobullets.com/spine/2029/cervical-spondylosis",
  "subtitle": "Updated: Oct 24 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical spondylosis represents the natural degenerative process of the cervical motion segment, which can lead to cervical radiculopathy, cervical myelopathy, and/or axial neck pain",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis can be made with plain radiographs of the cervical spine",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment can be observation, medical management, or surgical management depending on the severity and chronicity of pain, presence of instability, and/or presence of neurologic deficits",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically begins at 40-50 y/o",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**85% of patients >65 y/o** demonstrate spondylotic changes, regardless of symptoms",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in men than women",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common levels are **C5-6** > C6-7. These levels are associated with the most flexion and extension in the subaxial spine",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "excessive driving",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "smoking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lifting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "professional athletes",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pathophysiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spondylosis is a natural aging process of the spine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "characterized by degeneration of the disc and the four joints of the cervical motion segment, which include:",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "two facet joints",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "two uncovertebral joints of Luschka",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Degenerative cycle includes:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**disc degeneration**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "disc desiccation, loss of disc height, disc bulging, and possible disc herniation",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**joint degeneration**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "uncinate spurring and facet arthrosis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**ligamentous changes**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "ligamentum flavum thickening and infolding secondary to loss of disc height",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**deformity**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "kyphosis secondary to loss of disc height with resulting load transfer to the facet and uncovertebral joints, leading to further uncinate spurring and facet arthrosis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Associated conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often leads to the clinical conditions of:",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "cervical radiculopathy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "cervical myelopathy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "discogenic neck pain",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Mechanism of Neurologic Compression",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nerve root compression",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**leads to the clinical condition of radiculopathy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**foraminal spondylotic changes**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "secondary to chondro-osseous spurs of facet and uncovertebral joints",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**posterolateral disc herniation or disc-osteophyte complex**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "between posterior edge of uncinate and lateral edge of posterior longitudinal ligament (PLL)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "affects the exiting nerve root (C6-7 disease will affect the C7 nerve root)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**foraminal soft disc herniation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "affects the exiting nerve root (C6-7 disease will affect the C7 nerve root)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Central cord compression (central stenosis)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "leads to myelopathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "occurs when the canal diameter is **<13 mm** (normal is 17 mm)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "worse during neck extension, where the central cord is pinched between",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**degenerative disc** (anterior)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**hypertrophic facets** and **infolded ligamentum** (posterior)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common radiographic findings include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "degenerative changes of uncovertebral and facet joints",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "osteophyte formation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "disc space narrowing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "endplate sclerosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "decreased sagittal diameter (cord compression occurs when canal diameter is <13 mm)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "radiographic findings often do not correlate with symptoms",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sagittal alignment and size of spinal canal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "oblique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "foraminal stenosis, which is often caused by uncovertebral joint arthrosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "flexion and extension views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "angular or translational instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "look for compensatory subluxation above or below the spondylotic/stiff segment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "axial imaging is the modality of choice and provides necessary information on the status of the soft tissues",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can assist in preoperative planning",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "disc degeneration",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "spinal cord changes (myelomalacia)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "has a high false-positive rate (28% of patients >40 y/o will have findings of HNP or foraminal stenosis)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT myelography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can give useful information on bony anatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most useful when combined with intrathecal injection of contrast (myelography) to see status of neural elements",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "contrast is given via C1-C2 puncture and allowed to diffuse caudally, or given via a lumbar puncture and allowed to diffuse proximally by putting the patient in Trendelenburg position",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "particularly useful in patients who cannot undergo MRI (e.g. due to pacemaker) or have artifact from hardware",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Discography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "controversial and rarely indicated in cervical spondylosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "approach is similar to that used with ACDF",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "risks include esophageal puncture and disc infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Clinical Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Axial neck pain",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Cervical radiculopathy",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Cervical myelopathy",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
