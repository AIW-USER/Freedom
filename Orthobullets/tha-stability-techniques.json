                      "children": []
                    },
                    {
                      "text": "alcoholism",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**peripheral nervous system**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pathology that affects the peripheral nervous system",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "spinal stenosis (gluteus medius is L5)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "peripheral neuropathy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "radiculopathy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "paralysis/paresis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**local soft tissue integrity**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "trauma",
                  "table": null,
                  "images": [],
