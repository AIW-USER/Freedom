{
  "title": "THA Stability Techniques",
  "url": "https://www.orthobullets.com/recon/5007/tha-stability-techniques",
  "subtitle": "Updated: Jan 1 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Four important variables that help determine the stability of THA",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**component design**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**component position**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**soft-tissue tensioning**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**soft tissue function**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Component Design",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Femoral component design",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "large femoral heads",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**decreased dislocation rates** due to",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "head-neck ratio increased",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "definition",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "diameter of femoral head/diameter of femoral neck",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "importance",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "**larger head-neck ratios** allow greater arc range of motion prior to impingement",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/5007/images/head-neck_ratio.jpg",
                                  "caption": "head/neck ratio"
                                }
                              ],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "skirts can be avoided",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "definition",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "skirts are attachments used to extend the length of the femoral neck",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "importance",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "**skirts decrease the head-neck ratio**",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/5007/images/skirt.jpg",
                                  "caption": "skirt"
                                }
                              ],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "jump-distance is increased",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "definition",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "amount of translation prior to dislocation",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "importance",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "large femoral heads are seated deeper within the acetabulum, increasing jump-distance",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/5007/images/jump..jpg",
                                  "caption": "jump distance"
                                }
                              ],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "increase in jump-distance **increases joint stability**",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "**a larger femoral head will not compensate for abductor deficiency or a vertically positioned cup**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "femoral offset",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "see \"soft tissue tensioning\" below",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "femoral neck-shaft angle",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "increasing neck shaft angle (more valgus) compared to native anatomy can increase leg length and decrease offset",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "decreasing neck-shaft angle (more varus) compared to native anatomy can decrease leg length and increase offset",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Acetabular component design",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**elevated rim liner**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a posteriorly placed elevated rim liner may increase joint stability",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/liners.jpg",
                      "caption": "Elevated liner"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateralized liner**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "increases soft-tissue tension by increasing offset",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/liners_2.jpg",
                      "caption": "lateralized liner"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**has been shown to increase the risk of acetabular component loosening**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Component Position",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acetabular position",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommendations",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**anteversion**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/anteversion.jpg",
                      "caption": "anteversion"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "5° - 25°",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**abduction**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/inclination.jpg",
                      "caption": "abduction"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "30° - 50°",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medialization of the cup increases moment arm of the abductors (gluteus medius & gluteus minimus)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "increased moment arm leads to decreased joint reactive forces",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "caveats",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgical approach may affect optimal position of implants",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "posterior approach should err towards **more anteversion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "anterior approach should err towards **less anteversion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**hypertrophy of the anterior inferior iliac spine may cause component impingement and instability**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "excessive retroversion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/retroverted.jpg",
                      "caption": "retroverted socket"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "posterior dislocation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "excessive anteversion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "anterior dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "excessive abduction (high theta angle, vertical cup)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "posterior superior dislocation",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5007/images/vertical.jpg",
                          "caption": "vertical cup"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**eccentric polyethylene wear** and late instability",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "excessive adduction (low theta angle, horizontal cup)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "impingement in flexion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "inferior dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Femoral stem position",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommendations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "10°- 15° of anteversion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "caveats",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more difficult to adjust femoral component version in uncemented femoral components",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Combined version",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "femoral component anteversion plus acetabular component anteversion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "recommendations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "37 degrees",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Soft Tissue Tensioning",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Abductor Integrity",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "gluteus medius serves as the major hip abductor muscle; insufficiency/tear leads to Trendelenburg gait",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "gluteus maximus and/or fascia lata transfers can be utilized in chronic abductor insufficiency",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Restoration of offset",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "perpendicular distance from **femoral head center of rotation to the axis of the femur**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/femoral_offset_measurement.jpg",
                      "caption": "offset measurement"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "importance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**increased offset leads to**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "decreased impingement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "decreased joint reaction force",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "increases soft tissue tension without increasing leg length",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**decreased offset may lead to**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "instability",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "abductor weakness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "gluteus medius lurch",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**increasing offset improves hip stability**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "techniques to increase offset",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5007/images/screen_shot_2014-11-30_at_4.06.23_pm.jpg",
                  "caption": "neck length"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "increasing length of femoral neck",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "decreasing neck-shaft angle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "medializing the femoral neck while increasing femoral neck length",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "trochanteric advancement",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5007/images/trochanteric_advancement.jpg",
                      "caption": "troch advancement"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "alteration of the acetabular liner (see \"component design\" above)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Soft Tissue Function",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Three main factors controlling proper soft tissue function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**central nervous system**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pathology that affects the central nervous system",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "stroke",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "cerebellar dysfunction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
