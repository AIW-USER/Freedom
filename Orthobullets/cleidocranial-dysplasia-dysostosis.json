{
  "title": "Cleidocranial Dysplasia (Dysostosis)",
  "url": "https://www.orthobullets.com/pediatrics/4100/cleidocranial-dysplasia-dysostosis",
  "subtitle": "Updated: Jan 12 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cleidocranial Dysplasia is a rare congenital disorder caused by an autosomal dominant mutation in the RUNX2/CBFA1 gene leading to abnormal intramembranous ossification. Patients present with proportionate dwarfism with the characteristic feature of hypoplastic or absent clavicles.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made based on family history associated with typical radiographic and clinical features. No commercially available diagnostic test exists due to the variety of genetic mutations.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to improve and maintain function with observation of clavicular hypoplasia.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "approximately 1 in 1,000,000 affected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by defect in **intramembranous ossification**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "leads to failure of formation of midline structures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**characteristic feature is hypoplastic or absent clavicles**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4100/images/105%20-%20cleidocranial%20dysplasia_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**autosomal dominant**",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**RUNX2/CBFA1 mutation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "transcription factor which regulates osteoblastic differentiation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Orthopaedic manifestations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "proportionate dwarfism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**clavicle dysplasia/aplasia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "wormian bones",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**frontal bossing**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "delayed fontanelle ossification",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4100/images/skull.jpg",
                  "caption": "skull"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**due to delay in closure of skull sutures**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**coxa vara**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**shortened middle phalanges of 3-5 fingers**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**delayed ossification of pubis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "dental abnormalities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**delayed eruption of permanent teeth**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "hypermobility of the shoulders",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4100/images/clinical%20photo%20-%20colorado.jpg",
                  "caption": "Shows shoulder motion in Cleidocranial dysplasia"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "frontal bossing",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "hand deformities",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "examine middle phalanges for shortening",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "delayed formation of permanent teeth",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "abnormal range of motion at hips",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "if severe coxa vara may be present",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP chest",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "to identify clavicular dysmorphism",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4100/images/clinical%20photo%20-%20colorado.jpg",
                          "caption": "Shows shoulder motion in Cleidocranial dysplasia"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral skull",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "look for delayed closure of sutures",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4100/images/ccsutures.jpg",
                          "caption": "shows delayed suture closure"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4100/images/skull.jpg",
                          "caption": "skull"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "AP pelvis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "look for coxa vara",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4100/images/coxa%20vara.jpg",
                          "caption": "Shows coxa vara"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "look for failure of pubis to ossify",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4100/images/coxa%20vara.jpg",
                          "caption": "Shows coxa vara"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "AP hands",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4100/images/hands.jpg",
                      "caption": "XR hands"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "short middle phalanges",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "clavicular hypoplasia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most manifestations associated with this disease do not need intervention",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intertrochanteric osteotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**coxa vara with a** neck shaft angle of less than 100 degrees",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
