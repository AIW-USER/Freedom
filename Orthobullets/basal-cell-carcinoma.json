{
  "title": "Basal Cell Carcinoma",
  "url": "https://www.orthobullets.com/pathology/12761/basal-cell-carcinoma",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Basal Cell Carcinoma is the most common skin malignancy that rarely, if ever, metastasizes.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "The condition most commonly occurs in patients with significant sun exposure, who present with a pink, pearly-white, dome-shaped nodule.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing basophilic palisading cells.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually wide surgical resection.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**sun exposure**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**prior ionizing radiation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "xeroderma pigmentosum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "common in **fair-skinned** individuals",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly affects **upper lip** (squamous cell carcinoma typically affects lower lip)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically **asymptomatic**, but may be tender if ulcerated",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "slow-growing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pink, **pearly-white, almost translucent dome-shaped nodule or papule**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "overlying **telangiectasias**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "commonly develop **raised or rolled border**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "commonly **ulcerate**, bleed, and crust in the center (a non-healing ulcer)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "frequently on **sun-exposed areas**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosis by **skin biopsy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**basophilic palisading cells** on histology",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "nests of basaloid cells in dermis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Squamous cell carcinoma",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Actinic keratosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prevention",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**use sunscreen**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "avoid sun exposure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Surgical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "electrodesiccation and curettage",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "typically for non-facial tumors that are small or superficial – not used for aggressive tumors",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "best technique determined by",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "size",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "location",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "histology",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "cosmetic considerations",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cure rate up to 92%",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Mohs micrographic surgery",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "especially if on face or if recurrence",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cure rate up to 99%",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "wide local surgical excision",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cure rate up to 90%",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "If treated, typically very good",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Risk of developing another basal cell carcinoma is **5-8% per year**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    }
  ],
