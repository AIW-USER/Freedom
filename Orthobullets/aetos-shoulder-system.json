{
  "title": "AETOS Shoulder System",
  "url": "https://www.orthobullets.com/implants/423267/aetos-shoulder-system",
  "subtitle": "Updated: Apr 15 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "AETOS Shoulder System is a metaphyseal, in-lay humeral platform that recenters on the anatomic neck cut, uses concentric humeral heads, and is delivered with a streamlined tray workflow for efficient anatomic and reverse shoulder arthroplasty.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "It is used for anatomic TSA with an anatomic 4-peg glenoid and for reverse RSA via the Meta Stem.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "primary anatomic total shoulder arthroplasty using AETOS anatomic glenoid with Meta Stem or Stemless humeral components",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "reverse shoulder arthroplasty using AETOS reverse baseplate/glenosphere constructs with the AETOS Meta Stem",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "stemless humeral prosthesis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indicated for anatomic TSA only and not approved for reverse",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "active infection",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "insufficient bone stock",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "neuromuscular disorders",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "-1",
