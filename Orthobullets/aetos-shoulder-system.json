                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "consider length and tissue caliber",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "emphasizes coracohumeral ligament and anterior/inferior capsule",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "partial preservation of posterior capsule can help centralize the humeral head during trialing",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Nerves",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "axillary nerve",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "at risk with inferior capsular work",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "use blunt, low-profile retraction hugging the humeral neck",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "musculocutaneous nerve",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "avoid deep retraction medial to the conjoint tendon when releasing clavipectoral fascia and subcoracoid tissues",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "anterior humeral circumflex vessels encountered at the inferior subscapularis border",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "encountered at the inferior subscapularis border",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "coagulate or ligate early to reduce bleeding during inferior capsule release",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
