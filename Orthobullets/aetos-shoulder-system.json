            {
              "text": "anatomic neck",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "reference for head resection and in-lay collar seating",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "set inclination and version on this plane",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "greater and lesser tuberosities",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "guide subscapularis approach (LTO/peel/tenotomy) and broach alignment",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "protect GT during compaction and seating",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "glenoid vault and inferior rim",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "landmarks for pin placement",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "angulator reaming trajectory",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
