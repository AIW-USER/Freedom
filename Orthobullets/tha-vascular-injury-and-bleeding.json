                {
                  "text": "obturator vessels",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "anterior-superior",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "external iliac and femoral vessels",
                  "table": null,
