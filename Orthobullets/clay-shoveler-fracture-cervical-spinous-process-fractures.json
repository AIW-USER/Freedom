{
  "title": "Clay-Shoveler Fracture (Cervical Spinous Process Fractures)",
  "url": "https://www.orthobullets.com/spine/12284/clay-shoveler-fracture-cervical-spinous-process-fractures",
  "subtitle": "Updated: Oct 12 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clay-shoveler fractures are avulsion-type spinous process fractures in the lower cervical or upper thoracic spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made using lateral radiographs of the cervical spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment usually consists of rest and pain control, as the injuries are mechanically stable",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "direct trauma to the posterior spinous process",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "indirect trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sudden muscular or ligamentous pull during flexion or extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**most commonly C7**, but can affect C6-T3",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "usually occurs midway between the spinous process tip and the lamina",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "laborers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "racket or contact sports",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "motor vehicle accidents",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**usually occurs in isolation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "other orthopaedic injuries to consider:",
                  "table": null,
