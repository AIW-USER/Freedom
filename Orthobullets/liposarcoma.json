{
  "title": "Liposarcoma",
  "url": "https://www.orthobullets.com/pathology/8068/liposarcoma",
  "subtitle": "Updated: Mar 16 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Liposarcomas are a heterogeneous class of sarcomas with differentiation towards adipose tissue that consist of 5 different sub-types: well-differentiated, myxoid, round cell, pleomorphic, and dedifferentiated.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "The condition is typically seen in patients 50-80 years of age who present with a slow-growing, painless mass.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing immature lipoblasts with various cellular atypia depending on the sub-type.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment may be marginal excision for a well-differentiated liposarcoma. Wide surgical resection with radiation is indicated for intermediate and high-grade liposarcomas.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "liposarcomas are the **second most common** form of soft tissue sarcomas in adults",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occur in older individuals (**50-80yrs**)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "myxoid liposarcoma can present in younger adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "affect more males than females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "almost always occurs deep to fascia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "almost never occur in the subcutaneous tissue",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "75% occur in the extremities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more common in lower extremity than upper extremity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "common in retroperitoneum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the **lipoblast** (**signet ring-type** cell) is a hallmark of liposarcomas",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "well-differentiated liposarcoma - amplification (MDM2)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "myxoid liposarcoma - translocation (12;16)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "well-differentiated and dedifferentiated liposarcomas have chromosome 12q13-15 amplification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pleomorphic liposarcoma may have p53 mutation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Malignant potential",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "metastasis risk correlates with grade/sub-type of liposarcoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "low grade (well-differentiated) has a metastasis rate of < 1%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intermediate grade (myxoid) has a metastasis rate of about 10-30%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "high grade has a metastasis rate of > 50%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histologic types",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "liposarcoma types are related to the developmental stage of the lipoblasts from which they form",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "all are from primitive mesenchymal cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "types include",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**well-differentiated (low grade)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "same entity as atypical lipomatous tumor",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "can be sub-classified as lipoma-like, sclerotic, or inflammatory",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**myxoid (intermediate grade)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most common ~ 50% of all liposarcomas",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**round cell (high grade)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**pleomorphic (high grade)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "< 5% of cases",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**dedifferentiated (high grade)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "< 10% of cases",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often an incidentally found mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "slow growing painless mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mass may be 10-20cm",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Plain Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "initial imaging modality",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may show soft tissue calcification or ossification in well-differentiated liposarcomas",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT Chest/Abd/Pelvis with contract",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "staging for myxoid liposarcoma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "myxoid liposarcomas most commonly metastasize to the lungs, but also can spread to the abdomen and spine",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "MRI of entire spine recommended to assess for spinal metastases",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "findings",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "evidence of soft tissue within the fat mass",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "invasion into mediastinal structures",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "calcification",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI with contrast",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "best modality to characterize the lesion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "well-differentiated liposarcomas look similar to lipomas on MRI",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**bright on T1, dark on T2**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "may show differences in rate of growth, stranding, size",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "thicker (>2mm) and more irregular septa compared to lipomas on T2 suggests an area of dedifferentiation",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "high-grade liposarcomas look similar to other sarcomas on MRI",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8068/images/t1%20mri%20pleomorphic%20liposarcoma.jpg",
                      "caption": "T1 MRI showing high grade pleomorphic liposarcoma"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8068/images/t2%20mri%20pleomorphic%20liposarcoma.jpg",
                      "caption": "T2 MRI showing high grade pleomorphic liposarcoma"
                    }
                  ],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**dark on T1, bright on T2**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "although high grade liposarcomas appear fibrogenic, they may have 10% fat composition, so they appear dark on T1 and bright on T2 unlike a lipoma which images iso-intense to subcutaneous fat on all sequences",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "sensitivity and specificity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sensitivity: 100%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "specificity: 71%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "positive predictive value: 100%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Positron emission tomography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be used for staging and follow-up",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Areas of the mass inconsistent with fat on imaging must be biopsied",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Characteristic histology",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**immature lipoblasts** (signet ring-type cells)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "mature adipocytes",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Atypical lipomatous tumor (ALT; located in extremities)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8068/images/well%20differentiated%20liposarcoma.jpg",
              "caption": "well differentiated liposarcoma"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "ALT has 0% metastatic potential",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "referred to as well-differentiated liposarcoma (WDL) when located central/retroperitoneal",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "WDLs have a higher risk of local recurrence and metastatic spread compared to ALTs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "low grade",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "atypical lipoblasts, minimally cellular",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "fatty stroma background",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "stain for MDM2/CDK4",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "have ring chromosome 12",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Myxoid liposarcoma",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8068/images/myxoid%20liposarcoma.jpg",
              "caption": "myxoid liposarcoma"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "low to intermediate grade",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "proliferating lipoblasts upon a myxoid stroma matrix",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "signet ring lipoblasts at the edge of the tumor lobules",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Round cell liposarcoma",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8068/images/round_cell_liposarcoma2.jpg",
              "caption": "round cell liposarcoma"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "poorly differentiated liposarcoma with characteristic small round blue cells",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Pleomorphic liposarcoma",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8068/images/pleomorphic%20liposarcoma.jpg",
              "caption": "pleomorphic liposarcoma"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "high-grade pleomorphic tumor",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "giant lipoblasts with bizarre nuclei",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "eosinophilic giant cells",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Dedifferentiated liposarcoma",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8068/images/dedifferentiated_liposarc1.jpg",
              "caption": "dedifferentiated liposarcoma"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "often an ALT or WDL that transformed into a high-grade sarcoma",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "marginal resection without radiotherapy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**atypical lipomatous tumors (ALT)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "risk of local recurrence 10-50% over 10 yrs",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "metastasis extremely rare",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "dedifferentiation risk of 2% in extremities (ALTs)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "wide surgical resection with adjuvant radiotherapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**well-differentiated** liposarcoma",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**intermediate grade** liposarcomas",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**high grade** liposarcomas",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**radiation decreases local recurrence**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "wide surgical resection with adjuvant radiotherapy and chemotherapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "myxoid liposarcoma with >5% round cells",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "adequate surgical margins cannot be obtained",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "myxoid liposarcoma is generally more responsive to chemotherapy and radiation therapy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "myxoid liposarcomas with >10% round cells have higher likelihood of metastasis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "",
      "table": null,
      "images": [],
      "importance": "1",
      "children": []
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Marginal resection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "tumor is dissected out through the plane of the pseudocapsule",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Wide surgical resection & radiation therapy**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "resection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "use of tourniquet without exsanguination",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "maintain meticulous hemostasis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "meticulous dissection to ensure wide margins must confirm border free of disease with histology",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "frozen section can be used to ensure margins are free of tumor",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "consideration of nearby neurovascular and bony structures",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "resection of neurovascular structures may be performed if bypass grafting is possible",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "resection should only be performed if the resulting morbidity is acceptable to the patient",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "radiation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "50 Gy pre-operative and 66 Gy postoperative is the standard dose for soft-tissue sarcomas",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Mass effect on surrounding structures**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "location",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "neurovascular bundles",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "retroperitoneal structures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "peritoneal cavity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Local recurrence**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "depends on histology",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "see prognosis section",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Lipomas do not predispose a patient to a liposarcoma**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Atypical lipomatous tumors (ALT)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "risk of local recurrence 10-50% over 10 yrs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "dedifferentiation occurs in 3-7% of ALTs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "almost 100% survival",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Well-differentiated liposarcomas (WDL)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "WDLs have <**1% chance of metastasis**, but high rate of local recurrence.",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "dedifferentiation occurs in 20% of WDLs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "5-year survival about 80%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Intermediate and high grade liposarcomas",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "~ 20% risk of local recurrence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**10-30% risk of metastasis** for intermediate grade tumors",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": ">50% risk of metastasis for high grade tumors",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "5 year survival between 50-80%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
