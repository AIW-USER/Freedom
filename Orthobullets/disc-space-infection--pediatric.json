{
  "title": "Disc Space Infection - Pediatric",
  "url": "https://www.orthobullets.com/spine/2028/disc-space-infection--pediatric",
  "subtitle": "Updated: Jun 27 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Disc space infections in the pediatric population are a common source of fever and low back pain and are caused by systemic infections",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with blood cultures and MRI",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment includes bed rest, immobilization, and antibiotics for 4-6 weeks for early infection without abscess. Surgical debridement followed by antibiotic treatment is indicated in the presence of an abscess and/or lack of improvement with nonoperative treatment",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in pediatric patients compared with adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "more common in males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually affects patients <5 y/o",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly occurs in the **lumbar spine** (50-60%)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "in children, blood vessels extend from the cartilaginous endplate into the nucleus pulposus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "this allows direct inoculation of the disc space",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "infection may spread from the endplate to the disc space and vertebral body",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "in adults, blood vessels extend only to the annulus fibrosus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "this limits the incidence of isolated disc space infections in adults",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "microbiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Staphylococcus aureus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most common causative organism (>80%)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**tuberculosis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**always consider, especially if the patient is not improving with first-line antibiotics**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Salmonella**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "consider in patients with sickle cell anemia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Disc anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "in children, blood vessels extend from the cartilaginous endplate into the nucleus pulposus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "in adults, blood vessels extend only to the annulus fibrosus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms depend on the age of the child",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "toddlers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "painful limping or refusal to sit or walk",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**loss of appetite**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "fever (present in only 25%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "abdominal pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "older children",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "back pain with **point tenderness**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tender to palpation over the involved level",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "limited range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiographic findings are unreliable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "earliest radiographic manifestation occurs at **1 week**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually normal radiographs early in the process",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**loss of lumbar lordosis** may be the earliest radiographic sign",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**disc space narrowing** (10-21 days after infection onset)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2028/images/afp20071201p1669-f1[1]_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "endplate erosion (10-21 days after infection onset)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**diagnostic test of choice**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2028/images/pediatric%20diskitis%20t2%20mri.jpg",
                  "caption": "T2 MRI demonstrating pediatric discitis"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ESR**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "high-normal or mildly elevated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**C-reactive protein**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "high-normal or mildly elevated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**WBC**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "high-normal or mildly elevated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood cultures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "to identify the organism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bed rest, immobilization, and antibiotics for 4-6 weeks",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**early infection** with **no abscess** or displacement of the thecal sac",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "initial treatment consists of parenteral antibiotics directed against Staphylococcus aureus for 7-10 days",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "follow-up",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "monitor serial labs to assess the efficacy of antibiotic treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "CRP is the most sensitive marker for monitoring the patient's response to antibiotic therapy",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "obtain a CT-guided biopsy if there is no response",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "rule out tuberculosis",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical debridement followed by antibiotic therapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**late infection**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "paraspinal abscess with associated neurologic deficits",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "limited response to nonoperative treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "obtain cultures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "followed by antibiotic therapy and bracing",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Long-term narrowing of the disc space**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Fusion between vertebrae**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Back pain**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
