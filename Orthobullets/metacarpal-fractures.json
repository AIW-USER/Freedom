        {
          "text": "Techniques",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "**closed reduction percutaneous pinning**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "place antegrade through metacarpal base or retrograde through collateral recess",
                  "table": null,
                  "images": [],
