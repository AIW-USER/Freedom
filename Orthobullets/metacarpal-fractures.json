                {
                  "text": "can use multiple lag screws for long spiral fractures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "try to get at least two lag screws",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**open reduction with dorsal plating**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "works best for transverse fractures",
                  "table": null,
                  "images": [
                    {
