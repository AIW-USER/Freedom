        {
          "text": "Techniques",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "**ORIF**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "approach",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "dorsal incision",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "either centrally split extensor apparatus or release and repair sagittal band",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "fixation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "hardware cannot protrude from joint surface",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "fix with multiple small screws in collateral recess, headless screws, or k-wires",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "ideal fixation should allow for early motion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
