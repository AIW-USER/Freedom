                      "caption": "Hand radiograph"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "try to cover plate with periosteum to prevent tendon irritation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "begin early motion to prevent tendon irritations",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**intramedullary headless compression screw**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
