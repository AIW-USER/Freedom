              "text": "effect on activities and employment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cosmetic deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial deviation of 5th toe",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "prominence of the 5th metatarsal head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "**pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "lateral bunion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "plantar callus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "worse with constrictive shoe wear",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "plantar or lateral hyperkeratosis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7017/images/Clincical%20photo%20-%20Richardson_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "widened forefoot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "erythema and swollen 5th bunion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "check shoe wear",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often painless passive ROM of 5th MTP joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
