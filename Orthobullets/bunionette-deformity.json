{
  "title": "Bunionette Deformity",
  "url": "https://www.orthobullets.com/foot-and-ankle/7017/bunionette-deformity",
  "subtitle": "Updated: Jan 28 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bunionette Deformities, commonly called tailor's bunion, are prominences on the lateral aspect of the 5th metatarsal head that most commonly occur as a result of compression of the forefoot.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with presence of a prominence on the lateral aspect of the 5th metatarsal head, often associated with pain and callus formation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment can be nonoperative with shoe modifications for mild and minimally symptomatic cases. Surgical management is indicated for progressive deformity and difficulty with shoe wear",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly seen in adolescents and adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "2-4x more common in women",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often bilateral deformities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "extrinsic causes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**compression of forefoot (e.g. tight shoes)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "abnormal loading on the lateral aspect of the foot",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "intrinsic causes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "congenital deformities (e.g. splayfoot, brachymetatarsia)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "inflammatory arthropathies",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "residual malalignments from surgery",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "boney prominence +/- bursitis over lateral aspect of 5th metatarsal head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "increased 4-5 intermetatarsal angle (normal 6.5-8 degrees)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7017/images/4-5ima.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "increased lateral deviation angle (normal 0-7 degrees)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7017/images/lat_deviation.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "increased width of MT head (normal <13mm)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral bowing of the 5th metatarsal bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "varus MTP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pes planus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
