{
  "title": "Digital Collateral Ligament Injury",
  "url": "https://www.orthobullets.com/hand/6039/digital-collateral-ligament-injury",
  "subtitle": "Updated: May 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Digital Collateral Ligament Injuries result from direct trauma to the digit injuring the radial or ulnar collateral ligaments.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically and MRI may be required for confirmation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is nonoperative with buddy splinting with the exception of radial collateral injury to the index finger which requires surgical repair.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "5",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "< 1 per 100,000 annually",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "depends on the joint involved",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually the result of a \"jammed finger\"",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "doral or volar dislocation events can tear one or both of the collateral ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Collateral ligaments of the digits",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "located on the lateral aspect of the DIP, PIP and MCP joints",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6039/images/collateral%20ligaments%20of%20the%20fingers.jpg",
                  "caption": "Shows collateral ligaments of digits"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "crucial for opposing pinch stability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
