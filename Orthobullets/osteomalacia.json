{
  "title": "Osteomalacia",
  "url": "https://www.orthobullets.com/basic-science/9033/osteomalacia",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteomalacia is a metabolic bone disease where defective mineralization results in a large amount or unmineralized osteoid.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made based on a thorough evaluation of serum labs, clinical features, and radiographic findings.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves medical management with Vitamin D supplementation and resolving the underlying etiology.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**qualitative** defect as opposed to a quanitative defect like osteoporosis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare in the US (approximately 1 in 1000)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "much less common than osteoporosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "because of adequate exposure to sunlight and dairy products fortified with vitamin D",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rickets is found in children (open physis)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteomalacia is found in adults (closed physis)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
