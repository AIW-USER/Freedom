                  "importance": "1",
                  "children": []
                },
                {
                  "text": "polypharmacy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "narcotics",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**Pre-operative fascia iliaca block** and decrease overall narcotic use",
