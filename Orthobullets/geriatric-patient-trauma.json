    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Mortality**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "hip fracture",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "mortality rate in hospital and at one year: 6% and 30% respectively",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**decreased postoperative complications, pain, length of stay, and mortality if treated within 48 hours**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "spinal cord injury",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**higher mortality rate compared to younger patients**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**increased mortality associated with**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**need for mechanical ventilation at admission**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "higher injury severity scores",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "head injury",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Delirium**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "13%-50% postoperatively in elderly orthopedic patients",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
