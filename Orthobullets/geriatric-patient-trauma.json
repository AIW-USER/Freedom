        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "similar to fractures in other age groups with some exceptions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "acute arthroplasty may be indicated for certain fractures in the elderly",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**comminuted distal humerus fracture**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/322053/images/distal_humerus.jpg",
                          "caption": "Elderly patient with comminuted distal humerus fracture who underwent total elbow arthroplasty"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**proximal humerus**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/322053/images/proximal-humerus-fracture-reverse-arthroplasty.jpg",
                          "caption": "Proximal humerus fracture treated with a reverse TSA"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**femoral neck fracture**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/322053/images/right_femoral_neck_fracture.jpg",
                          "caption": "right femoral neck fracture on AP pelvis in osteoporotic bone"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "acetabulum",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "intra-articular distal femur",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "adjunct or alternative fixation may be necessary",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "allograft (fibular strut for proximal humerus)",
                      "table": null,
