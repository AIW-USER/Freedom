{
  "title": "Nodular Fasciitis",
  "url": "https://www.orthobullets.com/pathology/8063/nodular-fasciitis",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nodular Fasciitis is a common, fibrous, soft tissue lesion that usually occurs in the upper extremities of young people.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with MRI studies showing a deep-seated inhomogeneous mass with nodularity along the fascial planes. Biopsy shows short irregular bundles and fascicles in a dense reticulum network.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually marginal surgical resection.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common fibrous soft tissue lesion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "half of the cases occur in the upper extremities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males and females equally affected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "volar forearm, back, chest wall, head and neck",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be painless or painful",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "painful in half of patients",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "often rapidly enlarging mass over 1 to 2 weeks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lesions 1 to 2 cm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiograph",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shows deep seated inhomogeneous mass",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8063/images/46a_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "nodularity with extension along the fascial planes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "avid enhancement with gadolinium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most commonly is superficial but can occur intramuscularly or along the superficial plane",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Classic characteristics are",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "short irregular bundles and fascicles",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8063/images/46c_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "dense reticulum network",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "small amounts of mature collagen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "marginal resection",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
