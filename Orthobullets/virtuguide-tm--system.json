{
  "title": "VIRTUGUIDE™ System",
  "url": "https://www.orthobullets.com/implants/423331/virtuguide-tm--system",
  "subtitle": "Updated: Jun 12 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The VIRTUGUIDE™ System includes a pre-operative AI powered planning software that suggests a patient-matched Virtual Alignment Correction (VAC) Guide used for Lapidus arthrodesis procedures.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The VIRTUGUIDE™ pre-operative planning software utilizes AI to analyze the patient’s foot anatomy by identifying specific landmarks.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The software generates a plan of the surgery and helps in the selection of a patient matched VAC Guide.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "The VAC Guide incorporates the correction Intermetatarsal (IM) and Frontal Plane (FP) angles for the patient to allow wire placements in the specific deformity positions required for the correction.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Related Implants (Implants are not part of the VIRTUGUIDE System.)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "DYNABUNION™ Plates and other staple compression plates",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423331/images/015577c5-e050-4948-83b7-acdaea55e0e6_screenshot_2026-04-23_at_4.39.13_pm.jpg",
              "caption": "DYNABUNION™ Plates"
            },
            {
              "src": "https://upload.orthobullets.com/topic/423331/images/141a6f7e-433a-4a1f-b29f-4e96721ae0ce_screenshot_2026-04-23_at_4.39.17_pm.jpg",
              "caption": "Lapidus Staple Compression Plate"
            }
          ],
          "importance": "-1",
          "children": []
        },
        {
          "text": "TriLEAP™ Plates",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423331/images/1282dd9e-44cc-4624-8c7d-219d0cd41dc5_screenshot_2026-04-23_at_4.39.19_pm.jpg",
              "caption": "TriLEAP™ Lapidus Plate"
            }
          ],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Continuous Compression Implants",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423331/images/6f7a5643-1cf6-4f1b-acd2-26ecbe4cd4c0_screenshot_2026-04-23_at_4.39.22_pm.jpg",
              "caption": "Continuous Compression Implants"
            }
          ],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Cannulated Screws",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423331/images/48044832-5ddb-4b97-a7e9-4b3a639269be_picture1.jpg",
              "caption": "Cannulated Screws"
            }
          ],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "General Lapidus Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "1st TMT arthrodesis (Lapidus)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "severe deformity (HVA > 40 degrees, IMA > 20 degrees)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "arthritis at TMT joint or ligamentous laxity",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "note: VIRTUGUIDE System is for hallux valgus only",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Open Anatomy",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "first tarsometatarsal (TMT) joint",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "articulation between the medial cuneiform and base of the first metatarsal",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "primary stabilizer of the medial column and first ray",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Osseous",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "medial cuneiform",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "base of the first metatarsal",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "relationship to the second metatarsal contributes to midfoot stability",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "dorsal and plantar TMT ligaments",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "plantar restraints stronger than dorsal restraints",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Nerves",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "deep peroneal nerve adjacent to dorsalis pedis artery",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "saphenous and superficial fibular nerves at risk during dorsal approach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Blood Supply",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "dorsalis pedis artery traverses dorsal aspect of the first TMT joint",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Reference",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Donantoni M, Santini S, Martinelli D, Marinozzi A. Surgical Techniques for Lapidus Arthrodesis: Approaches, Indications, and Outcomes. J Clin Med. 2025 Jun 28;14(13):4591",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Preoperative Planning",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Imaging parameters",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "the VIRTUGUIDE™ Software is configured to accept weight bearing CT scans and AP X-rays of the entire foot",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "weight bearing may influence the deformed anatomy and therefore provide a more accurate analysis of the deformity correction needed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "x-ray",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "must be calibrated before being analyzed by the software",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "scaling factors must be defined using an option in the software",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "must be calibrated prior to software analysis using X-ray scaling factors to enable AI-automated measurements in mm",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "this will allow AI-automated analysis of the measurements in mm",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "if you do not have the magnification factor, you can set a default value",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "if you do so, the software will not display any measurements in mm and will show only the calculations for the various angles",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "CT",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "while Standard CT scans can be uploaded, they may result in a less desired deformity correction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "when performing scans and gathering files, ensure the images meet noted image requirements in the adjacent table",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Surgical Approach",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Dorsomedial incision",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423331/images/6d905a7c-025a-43fa-a484-abf3f6ac374b_screenshot_2026-02-02_at_11.24.50_am.jpg",
              "caption": "Dorsomedial incision"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "create a dorsomedial incision that is approximately 20 degrees from direct dorsal and medial to the extensor hallucis longus",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "the incision should be 3-4cm in length",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "retract the skin incision laterally",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "create a small direct dorsal stab incision into the TMT joint capsule to expose access to the joint",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/7dd97a51-d545-4182-9038-d141f87a3ab9_screenshot_2026-02-02_at_11.26.44_am.jpg",
                  "caption": "Stab incision."
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "the size of this incision should be just large enough to fit the paddle of the Joint Seeking Pin Guide",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423331/images/1e9b5821-d9fa-4f99-80cd-0d55e9f2cc18_screenshot_2026-02-02_at_11.31.09_am.jpg",
                      "caption": "Place Joint Seeking Guide."
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "do not expose and mobilize the entire joint capsule and do not place an osteotome into the joint",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "the joint space should still be tight",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Surgical Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Placement of joint seeking pin and VAC Guide",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "place Joint Seeking Pin Guide into the TMT joint where the stab incision was made",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/1e9b5821-d9fa-4f99-80cd-0d55e9f2cc18_screenshot_2026-02-02_at_11.31.09_am.jpg",
                  "caption": "Place Joint Seeking Guide."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "the Joint Seeking Pin can be inserted either using the Wire Driver of the Power Tool or a Mallet",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/480d1290-1e20-4eb6-95a7-49c45db0fa76_screenshot_2026-02-02_at_11.32.50_am.jpg",
                  "caption": "Verify position of Joint Seeking Pin."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "assemble distal Insert into the VAC Guide",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/d0e494dd-246f-4ab5-9dde-8c1ee8f05ac1_screenshot_2026-02-02_at_11.34.56_am.jpg",
                  "caption": "Assemble VAC Guide."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "slide the VAC Guide over the Joint Seeking Pin through the central hole until the Guide is in apposition with the foot",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/69c0507c-e0cc-408b-b7d2-6bbbd1655800_screenshot_2026-02-02_at_12.45.34_pm.jpg",
                  "caption": "Position VAC Guide."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "in the Cuneiform, place a long 2.0mm Wire first proximally (1), then a short 2.0mm Wire distally (2)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/89842e13-a3ca-4021-b688-0399becd4804_screenshot_2026-02-02_at_12.46.02_pm.jpg",
                  "caption": "Insert Wires."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "in the Metatarsal, place a short 2.0mm Wire proximally (3), then a long 2.0mm Wire distally (4)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Cut guide for bone resections",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "dissect the joint capsule to expose the joint",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "place the Cut Guide over the Metatarsal Wires through the holes marked “0”",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/0e07f81d-4df8-400e-b7ed-813f81c00467_screenshot_2026-02-02_at_2.32.32_pm.jpg",
                  "caption": "Cut Guide placement on Metatarsal."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "apply the Cut Guide on the proximal Wires and resect the bone of the Cuneiform",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/54734b85-ce8e-4d1b-b6c1-d104fa4e8bf9_screenshot_2026-02-02_at_2.33.20_pm.jpg",
                  "caption": "Cut Metatarsal."
                }
              ],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Realignment and compression with RAC Block",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "apply pressure to the medial aspect of the first Metatarsal squeezing towards the 2nd Metatarsal to allow ease of placement of the RAC Block",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/f5e7a3fe-e929-4b04-b25e-c3ec7c2d4621_screenshot_2026-02-02_at_2.36.23_pm.jpg",
                  "caption": "Slide RAC Block over Wires."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "slide down RAC Block over all 4 Wires to compress joint space and generation correction and alignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "verify desired correction has been achieved by assessing Intermetatarsal and Frontal Plane angles under fluoroscopy",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/1fd565a8-3acc-487d-80dd-52e9de25bc83_screenshot_2026-02-02_at_2.36.54_pm.jpg",
                  "caption": "Apply plantar counter-pressure"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "verify if desired compression is achieved under AP and lateral fluoroscopy by verifying apposition of joint surfaces",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/53ed12d6-9b23-404e-984e-359966b81f8d_screenshot_2026-02-02_at_2.42.22_pm.jpg",
                  "caption": "RAC Block - Compression."
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "if additional compression is needed, remove 0 - RAC Block (Standard) and replace with a 1 - RAC or 2 - RAC Block for greater compression until apposition is achieved",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423331/images/ff24c7c0-13b6-4ea5-9eb1-e0e5c4edf2f7_screenshot_2026-02-02_at_2.43.19_pm.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Fixation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "the VIRTUGUIDE™ Instruments are compatible with a range of DePuy Synthes Lapidus fixation options",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423331/images/9983044e-944c-4602-b2ca-a2ec2391ad77_screenshot_2026-04-23_at_4.36.21_pm.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Technical specifications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "VAC Guide",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patient-matched to deformity and incorporates IM and FP angles for wire placement in correction-specific positions",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "3D printed and supplied sterile packed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "single patient use only and must never be reused",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "instrument kits are available as left- and right-foot options across multiple IM and frontal plane angle combinations",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Disposable and reusable instrumentation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "disposable instruments include patient-matched VAC guide, 2.0 mm K-wires with trocar in 102 mm and 152 mm lengths, long sawblade, and Joint Seeking Pin",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "reusable instruments include the cut guide, Universal Handle, and RAC blocks, supplied via a modular tray system",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Realignment and Compression (RAC) Block options",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "0, 1, and 2 levels of compression",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "0, 5, and 10 degrees of additional frontal plane rotation, with left, right, and universal configurations depending on the block",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Disclaimers",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The VIRTUGUIDE Pre-operative Planning Software, powered by PeekMed®, is developed and owned by Peek Health, S.A.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Important Information: Prior to use, refer to the instructions for use supplied with the device(s) for indications, contraindications, side effects, warnings and precautions.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The third-party trademarks used herein are the trademarks of their respective owners.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    }
  ],
  "gallery": [
    {
