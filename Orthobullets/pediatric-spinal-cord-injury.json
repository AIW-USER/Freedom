                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "malalignment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "relatively high chance of multilevel spinal involvement",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "dislocation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "polytrauma",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "high energy injuries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "high clinical suspicion of spine injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "altered mental status",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "head and facial injuries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "risk of radiation overexposure in young children",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**not to be used as a spine screening examination**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "neurological deficits without radiographic abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "limits ionizing radiation exposure",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "spinal cord injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "soft-tissue edema",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "inferior to CT for evaluating osseous anatomy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain control and activity as tolerated",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "stable fracture patterns",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "apophyseal fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "spinous process fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "transverse process fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "activity modification and spinal immobilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cervical collar immobilization (8-12 weeks)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "fracture patterns",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "stable odontoid fractures",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "atlantoaxial instability",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "acute atlantoaxial rotatory displacement (AARD)",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "stable subaxial cervical spine trauma",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
