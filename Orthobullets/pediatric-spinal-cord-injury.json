{
  "title": "Pediatric Spinal Cord Injury",
  "url": "https://www.orthobullets.com/spine/2068/pediatric-spinal-cord-injury",
  "subtitle": "Updated: Oct 13 2024",
  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**2-5%** of all spinal cord injuries",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "83% involve the cervical spine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "male:female ratio of approximately 1.5:1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**cervical spine injuries** more common in children <8 y/o due to large head-to-body ratio",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**thoracolumbar spine injuries more c**ommon in children >8 y/o",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "upper cervical spine injuries (C1-4) are more common than lower cervical spine injuries (C5-7)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury includes:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**motor vehicle accidents (most common)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "falls from height",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "sport-related injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "child abuse",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "sledding and ATV (high risk for thoracolumbar spine injury)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Orthopedic considerations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pattern of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "occipitoatlantal, atlantoaxial dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "atlantoaxial rotatory fixation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "odontoid fracture",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "subaxial ligamentous injuries",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "spinal cord injury without radiographic abnormality **(SCIWORA)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "thoracolumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "compression fracture (most common)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "burst fracture",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "flexion-distraction injury",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "combined fracture-dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**head injuries (>30%)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "intra-thoracic injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "intra-abdominal injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Spinal cord",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spinal cord **ends at L3 in the newborn**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "migrates cephalad during childhood to end at L1-L2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reaches adult size by 10 y/o",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "vertebral bodies undergo chondrification around the 5th or 6th week of gestation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ossification occurs throughout adolescence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "deforming forces are commonly translated through the relatively weak physeal cartilage of maturing vertebral bodies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "greater flexibility of the pediatric spinal column compared to adults is due to:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increased ligamentous laxity of the spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "immature supporting structures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thoracolumbar facets are more shallow and horizontal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "the nucleus pulposus has greater water content and less collagen crosslinking, which allows for a greater ability to dissipate force",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pediatric Glasgow Coma Scale",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Best motor response**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "6 - normal spontaneous movement",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "5 - withdraws to touch",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "4 - withdraws to pain",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "3 - flexion is abnormal",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "2 - extension, either spontaneous or to painful stimulus",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "1 **- none (flaccid)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Best verbal response**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "5 - smiles, oriented to sound, follows objects, interacts",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "4 - cries but is consolable, confused",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "3 - inconsistently consolable, moaning",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "2 - inconsolable, agitated",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "1 **- no vocal response**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Best eye opening**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "4 - spontaneously",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "3 - to verbal stimulation or to touch",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "2 **- to pain**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "1 - no response",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Primary survey",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "formation of a multi-disciplinary pediatric trauma team",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**assessment as per Advanced Trauma and Life Support (ATLS) protocol for children**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**A**irway",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**B**reathing",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**C**ardiovascular support",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "use of the **Broselow pediatric emergency tape** may be used for estimating weight in a pediatric patient during trauma resuscitation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**D**isability",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "spinal precautions with cervical spine immobilization and log-roll procedures should be utilized",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "pediatric spine board or an adult spine board with a torso pad/head cut out should be used to prevent flexion of the cervical spine",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2068/images/f1.large-2.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "evaluate neurologic response using the **Pediatric Glasgow Coma Scale**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**E**xposure",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Secondary survey",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "trauma specific history",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mechanism of injury, last meal, past medical history, allergies, medications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "full neurologic examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "motor and sensory examination by myotome and dermatome, respectively",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**rectal and genital examination**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "bulbocavernosus reflex, when appropriate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "physical examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inspection and palpation of the entire spine and paraspinous region",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "note step-offs, crepitus, bruising, pain, or open injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "head-to-toe assessment for associated injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
