    {
      "text": "Prevention",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "High-risk patients, generally those undergoing THA and not TKA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**external beam radiation therapy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "pharmaceutical prophylaxis with **NSAIDs**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "no literature regarding these therapies in TKA patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
