{
  "title": "Flexor Pronator Strain",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/12765/flexor-pronator-strain",
  "subtitle": "Updated: Jun 6 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Flexor Pronator Strains are acute or chronic muscle strains of the flexor pronator mass, distal to its origin on the medial epicondyle.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with medial elbow swelling and ecchymosis in acute strains withtenderness distal to the medial epicondyle. MRI studies can be used to help identify complete tears or UCL injuries.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally nonoperative with rest, activity modifications and physical therapy.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "golfers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cricket players",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**throwing athletes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**acute muscle tear**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "single event of a large, eccentric force during resisted wrist flexion, forearm pronation, and valgus at the elbow",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "chronic overuse can lead to acute flexor pronator rupture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "sudden onset of pain and flexor weakness",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**chronic tendonitis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "repetitive elbow valgus, wrist flexion, and forearm pronation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ulnar collateral ligament insufficiency**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "should be ruled out in throwing athletes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Flexor pronator mass provides dynamic support to the medial elbow **against valgus stress**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Flexor pronator mass includes (proximal to distal)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12765/images/aa911965-5e07-433a-9a44-51ddecc9ce01_flexors..jpg",
              "caption": "Common flexors origin"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "Pronator Teres (median n.)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Flexor Carpi Radialis (median n.)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Palmaris Longus (median n.)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "FDS (median n.)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "Flexor Carpi Ulnaris (ulnar n.)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute event of hitting the ground during golf, bat, or racquet swing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "history of throwing or racquet sports",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "repetitive gripping and/or elbow valgus stress activities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "medial elbow pain distal to the medial epicondyle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "chronic pain during late cocking/early acceleration",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medial elbow **swelling and ecchymosis** in acute strain",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**tenderness distal to medial epicondyle**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain with elbow extension and resisted wrist flexion or pronation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "examine for associated conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "negative moving valgus stress test",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "normal neurovascular exam",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "unclear source of medial elbow pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "grade severity of muscle strain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rule out other causes of medial elbow pain such as UCL rupture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12765/images/ax_pronter.jpg",
                  "caption": "T2 Axial MRI of the elbow demonstrating edema in the flexor-pronator mass"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/12765/images/sag_pronter.jpg",
                  "caption": "T2 Sagittal MRI of the elbow demonstrating edema in the flexor-pronator mass with partial tearing of the pronator teres"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**edema in flexor pronator mass**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "partial tearing or complete rupture of flexor pronator mass",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Medial epicondylitis",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "UCL injury",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Valgus extension overload with posteromedial olecranon impingement",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "NSAIDS, rest, physical therapy, steroid injections",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "ROM and flexor pronator strengthening x 4-6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**corticosteroid injection** for chronic flexor pronator tendonitis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "rarely needed",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "avoid UCL due to risk of rupture",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "typical resolution and return to sport in 4-6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary surgical repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "significant (>2.5 cm) retraction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Continued medial elbow pain and valgus instability**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "unrecognized UCL insufficiency",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Typically resolves with 4-6 weeks of activity restriction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
