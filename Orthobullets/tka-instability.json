{
  "title": "TKA Instability",
  "url": "https://www.orthobullets.com/recon/12308/tka-instability",
  "subtitle": "Updated: Apr 28 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Instability is a common cause of early failure following total knee arthroplasty.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made clinically with presence of a varus/valgus thrust during ambulation, positive posterior sag with the knee flexed to 90 degrees and overall laxity of the knee on exam.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment depends on severity of symptoms, direction of instability and the type of TKA prosthesis present in the knee.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common cause of early failure following total knee arthroplasty",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "accounts for 10-20% of revisions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Types",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**extension (varus-valgus) instability**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**flexion (anteroposterior) instability**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**mid-flexion instability**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**genu recurvatum**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**global, multiply-operated instability**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "previous operations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "indication for initial replacement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "original implant information",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "comorbidities including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "connective tissue disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "inflammatory diseases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diabetes, Charcot arthropathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "history of trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, instability or both",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "timeline as to start of symptoms, what worsens/improves",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Examination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "overall gait, observe for **valgus/varus thrust**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "ligamentous examination throughout range of motion, attempt to reproduce symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**flexion instability test**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "positive posterior sag with the knee flexed to 90 degrees",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "overall strength",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "extensor mechanism competency",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patellar tracking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "weightbearing AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "used to assess joint line symmetry",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "full-length AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "used to assess overall mechanical alignment",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "used to assess tibial slope, tibial subluxation, recurvatum",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "extension instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "excessive distal femoral resection",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "oversized femoral component",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "flexion instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "overresection of posterior femoral condyles",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "undersized femoral component",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "increased tibial slope",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "mid-flexion instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "anterior or proximal placement of femoral component",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "genu recurvatum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Computed tomography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can offer information regarding component rotation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CBC, ESR, CRP, must rule out infection as potential cause",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Knee aspiration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "to rule out infection via cell count and culture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Extension (varus-valgus) Instability",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "varus/valgus instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "types",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**symmetrical**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "caused by excessive distal femoral resection, causing flexion/extension gap mismatch",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**asymmetrical**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "more common",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "ligamentous asymmetry caused by failure to correct deformity in the coronal plane",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symmetrical instability",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "distal femoral augments to tighten extension gap",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**upsizing poly will fail as it affects both flexion and extension gaps**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "asymmetrical instability",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "balance ligaments accordingly",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "controlled release of soft tissue on contracted side",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "if ligamentously insufficient, varus/valgus constrained device needed",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12308/images/mcl_insufficient.jpg",
                          "caption": "AP MCL TKA instability"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/12308/images/hinged_tka.jpg",
                          "caption": "TKA hinged radiograph"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "if caused by, intraoperative MCL transection/deficiency",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "suture repair or suture anchor reattachment, use of either CR or PS implant, hinged knee brace for 6 weeks postoperatively",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "use of unlinked constrained prosthesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Flexion (anteroposterior) instability",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs when the flexion gap exceeds the extension gap",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "knee dislocation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior stabilized knees can \"jump the post\" resulting in dislocation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "over resection of posterior femoral condyles",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**treat with posterior augments**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "undersizing femoral component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**upsize femoral component**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "excessive tibial slope",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**decrease slope and consider posterior-stabilized prosthesis**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "excessive posterior femoral condyle cuts",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**augment posterior condyles of distal femur**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "posterior cruciate ligament insufficiency following a cruciate-retaining arthroplasty",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**convert to posterior-stabilized prosthesis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Mid-flexion instability",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Causes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "controversial topic, poorly understood",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "associated with modification of the joint line",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "involves **malrotation when the knee is flexed between 45 and 90 degrees**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "potential contributing factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "femoral component design in sagittal plane",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "attenuation of anterior MCL",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "overall geometry of the tibiofemoral joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically, full revision is required",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "goals",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "restoration of joint line",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "equalize flexion and extension gaps",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Genu recurvatum",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fixed valgus deformity and iliotibial band contracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Causes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated with poliomyelitis, rheumatoid arthritis, or Charcot arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "poliomyelitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patient walks with knee locked in hyperextension, ankle in equinus due to quadriceps weakness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically long-stemmed posterior stabilized, or varus/valgus constrained implant",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rotating-hinge reserved for salvage as residual hyperextension may occur, leading to early failure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Global, multiply-operated instability",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "laxity of both flexion and extension gaps, as well as varus/valgus instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can be associated with severe bone loss",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "multidirectional ligamentous instability with recurvatum gait",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "varus/valgus constrained prosthesis at minimum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "typically, hinged prosthesis with or without augments, sleeves, cones",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "severe bone loss situations may require endoprosthetic replacements",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
