{
  "title": "Clinical Trial Design",
  "url": "https://www.orthobullets.com/basic-science/9080/clinical-trial-design",
  "subtitle": "Updated: Apr 4 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical trial design impacts Level of Evidence",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Clinical trials may be either observational or experimental",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**observational**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "researchers observe patient groups without allocation of intervention",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may be either prospective or retrospective",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may be descriptive or analytic",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**descriptive**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "useful for obtaining background information for more advance studies",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "examples",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "case reports",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "case series",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "cross-sectional studies",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "**analytic**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "explores the association between a given outcome and a potentially related variable",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "examples",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "case-control",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "cohort",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "meta-analysis",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**experimental**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "researchers allocate treatment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "allows the evaluation of efficacies of therapeutic interventions",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "internal validity refers to the methodological rigor of the study (efforts to reduce bias and confounding)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "external validity refers to the generalizability of study findings",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "many factors that increase internal validity may reduce external validity, and vice versa",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "for example, well-controlled and homogenous study population may strengthen internal validity, but weakens applicability to other populations",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "examples",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "double-blinded, prospective, randomized clinical trial is the gold standard for evidence based medicine",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Conflict of interest statement",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "submitted with each publication for each author",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "discloses all financial interests of each author as it relates to the study and/or publication",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Randomized controlled trial",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "a study in which patients are randomly assigned to the treatment or control group and are followed prospectively",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "provides the most compelling evidence that the study treatment causes the expected effect on human health",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "randomization minimizes study selection bias",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "randomization can help distribute confounding variables evenly, reducing their overall impact",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "by definition an experimental study because there is an intervention",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Study designs",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**parallel-group**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "each participant is randomly assigned to a group, and all the participants in the group receive (or do not receive) an intervention,",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**crossover**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "administration of two or more therapies, one after the other, in a random order",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "susceptible to bias if washout period is inadequate",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**factorial**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "each participant is randomly assigned to a group that receives a particular combination of interventions or non-interventions.",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**cluster**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pre-existing groups of participants (e.g., villages, schools) are randomly selected to receive (or not receive) an intervention.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blinding",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "blinding of the outcome assessor",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "likely to decrease the treatment effect reported in the study",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Analysis",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**intent-to-treat analysis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "outcomes based on the group into which they were randomized, regardless of whether the patient actually received the planned intervention",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "minimizes non-responder bias",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**as-treated analysis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "outcomes based on actual intervention received, regardless of which group their were randomized to.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "by definition, when as-treated analysis is done, the results are no longer a RCT",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "used when there is higher cross-over from randomization groups (e.g., a patient is randomized to nonoperative treatment, but elects to obtain surgical treatment).",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "per protocol",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "excludes patients who were not compliant with the protocol guidelines",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Example",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "you want to determine whether your new toothpaste prevents cavities better than your old toothpaste. You randomly assign a large number of patients to either an intervention group, which uses the new toothpaste, or to a control group, which uses the old toothpaste. You would then measure the amount of cavities between the groups over time.",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic Literature Examples",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Cohort study",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a study in which patient groups are separated non-randomly by exposure or treatment, with exposure occurring after (prospective), or before (retrospective), the initiation of the study",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Evidence**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**217480Level II or III evidence**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Analysis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "results usually reported as **relative-risk**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Example",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "you want to determine if smoking is a risk factor for the development of lung cancer. You identify a group of smokers and a group of non-smokers, and follow them over time measuring the desired outcome, in this case, lung cancer.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic Literature Examples",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Case-control study",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a study in which patient groups are separated by the current presence (cases) or absence (controls) of disease and examined for the prior exposure of interest",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Evidence**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**Most are Level III evidence**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Analysis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually reported as **odds-ratio**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Example",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "you want to determine if smoking is a risk factor for the development of lung cancer. You compare the smoking history of individuals with lung cancer (cases) and those without (controls).",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic Literature Examples",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Meta-analysis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a systematic review that summarizes results of other studies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be used to increase the statistical power of several under-powered studies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Example",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "you want to determine if wearing sunscreen results in fewer cases of melanoma. You pool the results of 9 randomized controlled studies and statistically analyze the data to determine the effect of the relationship.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic Literature Examples",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Cross-sectional Study",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "study group is analyzed at a given time (\"snapshot\") with no follow-up",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Example",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "you want to determine the prevalence of baseball injuries during the 2003 little-league season",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic Literature Examples",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Case Series",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a retrospective account of multiple patients with the same injury or treatment with no control or comparison group",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "useful for generating hypotheses for additional studies",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Evidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**level IV evidence**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Example",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "you have found that several of your patients who have used a new lipid lowering medication have developed hemorrhagic cysts. You want to alert other members of the community of this possible association.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic Literature Examples",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    }
  ],
