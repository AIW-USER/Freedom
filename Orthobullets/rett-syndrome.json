{
  "title": "Rett Syndrome",
  "url": "https://www.orthobullets.com/pediatrics/4107/rett-syndrome",
  "subtitle": "Updated: Jun 16 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Rett Syndrome is a congenital condition caused by an X-linked dominant mutation in the MECP2 gene that affects girls between 6-18 months of age. Patients present with progressive impairment, developmental delays, and spinal abnormalities.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made primarily based on patient development history and clinical observations.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to address developmental delay, cognitive abnormalities, and orthopedic manifestations.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1 in 10,000 births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "male fetuses (only 1 X chromosome) do not survive to term",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "female fetuses (1 mutated gene, 1 normal gene) survive and manifest disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "affects the grey matter of the brain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritance pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "X-linked dominant pattern",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "mutation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "MECP2 gene mutation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "this gene encodes the methyl-CpG-binding protein-2, which methylates DNA",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "95% de novo mutation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "mutation is on male copy of X chromosome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medical conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "development delay",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "seizures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "80% of cases",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "behavioral abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "screaming and crying",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "loss of speech",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "gastrointestinal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "constipation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "orthopaedic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "spasticity and joint contractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ataxia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hypotonia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bruxism (grinding of teeth)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "chorea (abnormal hand movement)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**scoliosis with C-shaped curve**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "develops at the age of 10",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "occurs in more than 50% of patients",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "does not respond to bracing",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "instrumentation must include entire scoliotic and kyphotic curve",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "normal development for first 6-18 months of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "when symptoms present, they range widely from mild to severe including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "apraxia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "loss of purposeful movements in the hands",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**often the first sign of the disease**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "mental slowing (i.e. signs of dementia)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "abnormal breathing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "difficulty ambulating",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "seizures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "apraxia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "abnormal gait",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "decreased head circumference",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually starts to become evident at 5-6 months",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "poor circulation indicated by cold, blue extremities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
