                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosis is based primarily on patient development history and clinical observations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Genetic testing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may identify genetic mutation responsible for disease, though not in all cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptom management",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "there is no specific treatment for Rett's syndrome",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "assistance with feeding and hygeine",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "treat seizures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "physical therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indicated to avoid hand contracture**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior spinal fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "thoracic curve that interferes with sitting and balance",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "C-shaped curve does not respond to bracing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "instrumentation must include entire scoliotic and kyphotic curve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Half of children unable to walk after the age of ten due to deterioration of motor function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "development is normal until 6 to 18 months then progressive impairment and development delays occur",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "regression is rapid until the age of three",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "a more stable phase of progression occurs until age of 10",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
