              ]
            },
            {
              "text": "alternative views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "flexion-extension views of cervical, thoracolumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**upper cervical spine instability**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4096/images/sed%20with%20cervical%20instability.jpg",
                          "caption": "Shows ununited odontoid process"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "odontoid hypoplasia or os odontoideum",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "thoracolumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**platyspondyly** (flattened vertebral bodies) is evident in lumbar spine",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4096/images/sed%20spine.jpg",
                          "caption": "Shows spine in SED"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4096/images/Xray%20-%20lumbar%20spine_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "incomplete fusion of spinal ossification centers",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "end plate irregularities and narrowed intervertebral disk spaces",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "kyphoscoliosis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "excessive lumbar lordosis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hips",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "horizontal acetabular roofs and delayed ossification of the pubis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "wide Y cartilage",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**coxa vara of varying severity**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "delayed ossification of the femoral head",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
