    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "multidisciplinary rehabilitation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**all patients to improve and maintain function**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**technique**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**should integrate**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "physiotherapy",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "monitor for weakness, increasing spine curvature, worsening hip pain",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "occupational therapist",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "ophthalmologist",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "obtain yearly eye examination",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "pulmonologist",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "monitor for declining lung function",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "orthopaedic surgeon",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "possible bracing for mild scoliosis",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior atlantoaxial fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "atlantoaxial instability measuring 8 mm or more",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "myelopathy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "posterior instrumentation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "posterior thoracolumbar instrumentation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "spinal scoliosis curvatures >50 degrees",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "distraction spinal rods (younger aged patients)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "posterior instrumented spinal fusion (older aged patients)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "valgus intertrochanteric osteotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "coxa vara angle <100 degrees",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "progressive coxa vara",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "symptomatic hip arthritis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "valgus + extension osteotomy may help to decrease an associated hip flexion deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "reconstructive measures may be indicated in patients with subluxation, hinge abduction, or osteoarthritis.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "open reduction and fixation of proximal femur and acetabulum to treat hip dislocations.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
