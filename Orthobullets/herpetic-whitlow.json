{
  "title": "Herpetic Whitlow",
  "url": "https://www.orthobullets.com/hand/6100/herpetic-whitlow",
  "subtitle": "Updated: May 16 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Herpetic Whitlow is a viral infection of the hand caused by herpes simplex virus (HSV-1).",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically by presence of a small, vesicular rash and confirmed with a Tzank smear.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is observation with a short course of antiviral antibiotics (acyclovir).",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "2.4 cases per 100,000 people per year",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs with increased frequency in **medical and dental personnel**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "most common infection occurring in a **toddler’s and preschooler’s** hand",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "viral shedding occurs while vesicles are forming bullae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intense burning pain followed by erythema",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "malaise",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "erythema followed by **small, vesicular rash**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "over the course of 2 weeks, the vesicles may come together to form bullae",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "the bullae will crust over and ultimately lead to superficial ulceration",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "fever and lymphadenitis may be found",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Tzank smear**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "diagnosis confirmed by culture, antibody titers or **Tzank smear**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Clinical and culture-based",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination and confirmed with a positive Tzank smear",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation +/- acyclovir",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "standard of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "self limiting, with resolution of symptoms in 7-10 days",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**acyclovir** may shorten the duration of symptoms",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "recurrence may precipitated by fever, stress and sun exposure",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical debridement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "none",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "surgical treatment associated with superinfections, encephalitis, and death and should be avoided",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Superinfections**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "often the result of surgical intervention",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "in pediatric patients, an infection of the digits may occur and require treatment with an oral antibiotic (penicillinase resistant) ifor 10 days",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
