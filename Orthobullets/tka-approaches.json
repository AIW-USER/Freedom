{
  "title": "TKA Approaches",
  "url": "https://www.orthobullets.com/recon/5031/tka-approaches",
  "subtitle": "Updated: Jan 19 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Surgical approach may be dictated by",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgeon preference",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prior incisions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "degree of deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patella baja",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patient obesity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Incision planning",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "if multiple incision, choose more lateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "blood supply comes from medial side",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "generally safe to cross previous transverse incisions at right angles",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ensure adequate skin bridge",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "exact length of skin bridge needed is controversial",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Approaches",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "\"simple\" primary knee arthroplasty approaches",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial parapatellar",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "midvastus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "subvastus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "minimally invasive",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "No midterm or longterm differences have been shown in terms of functional outcomes between a standard medial parapatellar, midvastus, or subvastus approach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "\"complex\" primary or revision total knee arthroplasty",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial parapatellar",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "quadriceps snip",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "V-Y turndown",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tibial tubercle osteotomy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Standard Medial Parapatellar Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/5031/images/medial_parapatellar.jpg",
              "caption": "medial parapatellar"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "most commonly completed through a straight midline incision",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "familiar for most orthopaedic surgeons",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "excellent exposure even in challenging cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "possible failure of medial capsular repair",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "development of lateral patellar subluxation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "access to lateral retinaculum less direct",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may jeopardize patellar circulation if lateral release is performed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Lateral Parapatellar Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/5031/images/lateral_parapatellar.jpg",
              "caption": "lateral parapatellar"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "useful for addressing lateral contractures but difficult eversion of patella makes exposure challenging",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful for a fixed valgus deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "preserves blood supply to patella",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prevents lateral patellar subluxation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "allows direct access to lateral side in a valgus knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "technically demanding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial eversion of patella is more difficult",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "may require tibial tubercle osteotomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Midvastus",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/5031/images/midvastus.jpg",
              "caption": "Midvastus"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "similar approach to medial parapatellar that spares VMO insertion and may lead to quicker recovery",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "vastus medialis insertion on quad tendon is not disrupted",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "potentially allows accelerated rehab due to avoiding disruption of extensor mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patellar tracking may be improved compared to medial parapatellar approach",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "less extensile",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "exposure difficult in obese patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "exposure difficult with flexion contractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "potential for partial VMO denervation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Relative contraindications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ROM <80 degrees",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obese patient",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hypertrophic arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "previous HTO",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Subvastus Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/5031/images/subvastus.jpg",
              "caption": "subvastus"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "muscle belly of vastus medialis is lifted off intermuscular septum",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patellar vascularity preserved",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "extensor mechanism remains intact",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "minimal need for lateral retinacular release",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "least extensile",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Relative contraindications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "revision TKA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "large quadriceps",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "previous HTO",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obese patient",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "previous parapatellar arthrotomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Minimally Invasive Surgical Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often need special instruments for exposure and implant insertion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "technically demanding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "data shows no clinically significant improvement in patient reported outcomes, gait patterns or quadriceps strength",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "quadriceps-sparing approach may lead to high rates of component malposition",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Indications to convert to a standard parapatellar approach",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "patellar tendon starts to peel off the tibial tubercle",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "incision is too small for proper jig placement",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Extensile Exposures",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Quadriceps snip",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5031/images/quad_snip.jpg",
                  "caption": "quad snip"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "snip made at apex of quadriceps tendon obliquely across tendon at a 45-degree angle into vastus lateralis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "no change in post-operative protocol",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "minimal, if any, long-term consequences",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not as extensile as a turndown or tibial tubercle osteotomy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "V-Y turndown",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5031/images/v-y_turndown.jpg",
                  "caption": "VY"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "straight medial parapatellar arthrotomy with diverging incision down the vastus lateralis tendon towards lateral retinaculum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "allows excellent exposure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "allows lengthening of quadriceps tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "preserves patellar tendon and tibial tubercle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "extensor lag",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may affect quadriceps strength",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "knee needs to be immobilized post-operatively",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tibial tubercle osteotomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5031/images/tto.jpg",
                  "caption": "TTO"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "6-10 cm bone fragment cut from medial to lateral",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "fixed with screws or wires",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "excellent exposure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "avoids extensor lag seen with V-Y turndown",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "avoids quadriceps weakness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "some surgeons immobilize or limit weight-bearing post-operatively",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tibial tubercle avulsion fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "non-union",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "wound healing problems",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Bilateral Total Knee Arthroplasty",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Definitions",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "simultaneous",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "two surgeons performing the bilateral TKA at the same time",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "sequential",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "one surgeon performing one TKA and then the contralateral TKA under one anesthetic",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "stage",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "done surgeon performing each TKA under a separate anesthetic",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "timing ranges from 3 days to one year in between each side",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Other",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Antibiotic loaded bone cement (ALBC)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reduces deep infection in revision TKA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "indications for use in primary TKA are controversial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "in vitro studies have shown a theoretical risk of decreased cement strength with adding antibiotics (dilution)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "however, there are no current studies that have shown ALBC to increase the rate of aseptic loosening",
                      "table": null,
