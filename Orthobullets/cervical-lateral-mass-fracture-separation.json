{
  "title": "Cervical Lateral Mass Fracture Separation",
  "url": "https://www.orthobullets.com/spine/2000/cervical-lateral-mass-fracture-separation",
  "subtitle": "Updated: Apr 26 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical lateral mass fracture separations of the lateral mass-facet are uncommon cervical spine injuries characterized by a high degree of instability and neurologic deficits",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made using a CT scan of the cervical spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment usually involves posterior decompression and two-level instrumented fusion",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "male:female ratio 2:1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mean age 35 y/o (20-70 y/o)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "C6 > C5 > C7 > C4 > C3",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "traffic accident, fall, or heavy object landing on the head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**hyperextension, lateral compression, and rotation** of the cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "affects 2 levels",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "due to involvement of the superior and inferior facets on either side of the fractured articular mass",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "anterior translation (listhesis)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fractured vertebrae (77%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "superior adjacent vertebrae (24%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "inferior adjacent vertebrae (10%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "coronal translation (33%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "vertebral body collapse (33%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "less common in type A separation fracture subtypes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
