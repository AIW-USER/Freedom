{
  "title": "Lumbar Spine Anatomy",
  "url": "https://www.orthobullets.com/spine/2071/lumbar-spine-anatomy",
  "subtitle": "Updated: Aug 17 2024",
  "sections": [
    {
      "text": "Alignment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Sagittal plane",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lumbar lordosis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "average of 60°",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "normal range is 20-80°",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "apex of lordosis at L3",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "disc spaces responsible for most of lordosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Lumbar Osteology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lumbar spine has the largest vertebral bodies in the axial spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Components of vertebral bodies",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/ap%20xr.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/latxr.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "**anterior vertebral body**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**posterior arch**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "formed by",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**pedicles**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "project posteriorly from posterolateral corners of vertebral bodies",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**lamina**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "project posteromedially from pedicles, join in the midline",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**spinous process**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**transverse processes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**mammillary processes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "separate ossification centers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "project posteriorly from superior articular facets",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**pars interarticularis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "mass of bone between superior and inferior articular facets",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "site of spondylolysis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2071/images/spondylolysis.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Articulations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**intervertebral disc**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "act as an articulation above and below",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**facet joint** (zygapophyseal joint)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "formed by superior and inferior articular processes that project from junction of pedicle and lamina",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "facet orientation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "facets become **more coronal moving distally**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2071/images/facet%20orientation.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/2071/images/l4%20vs%20l5%203.jpg",
                          "caption": "Facet orientation"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Lumbar Pedicle Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Landmarks",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/ct%20lat.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/level%201.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/level%202.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/level%203.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "midpoint of the transverse process is used to identify the midpoint of pedicle in the superior-inferior plane",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "lateral border of pars is used to identify the midpoint in the medial-lateral plane",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Pedicle angulation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pedicles **angulate more medially** moving distally in the spine",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "L1: 12°",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "L5: 30°",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "S1: 39°",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pedicle diameter",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/pedicle%20diameter%20illustration%202.jpg",
              "caption": "Shows pedicle diameter."
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "**L1 has the smallest diameter in the lumbar spine** (T4 has the smallest diameter overall)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "S1 has an average diameter of ~19 mm",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Lumbar Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lumbar vertebral bodies supplied by",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**segmental arteries**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "dorsal branches supply blood to the dura and posterior elements",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Lumbar Neurologic Structures",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nerve roots**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "anatomy",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "nerve root exits foramen under same numbered pedicle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "central herniations affect traversing nerve root",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2071/images/herniated%20disk_moved.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/2071/images/paracental%20disc%20illustration_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "far lateral herniations affect exiting nerve root",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2071/images/herniated%20disk_moved.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/2071/images/fld%20illustration_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "dorsal rami",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "supply muscles, skin",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "medial branch supplies facet joints",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ventral rami",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "supply anteromedial trunk",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "key difference between cervical and lumbar spine is:",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2071/images/illustration%20cervical%20v%203s_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**pedicle/nerve root mismatch**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "cervical spine C6 nerve root travels under C5 pedicle (mismatch)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "lumbar spine L5 nerve root travels under L5 pedicle (match)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "extra C8 nerve root (no corresponding C8 pedicle) allows transition",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "horizontal (cervical) vs. vertical (lumbar) anatomy of nerve root",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "due to the vertical anatomy of a lumbar nerve root, a paracentral and foraminal disc herniation will affect different nerve roots",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "due to the horizontal anatomy of cervical nerve root, a central and foraminal disc herniation will affect the same nerve root",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Intervertebral disk",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**sinuvertebral nerve** is responsible for nociception and proprioception of disk",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "nerve fibers present along periphery of annulus fibrosus only",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Cauda equina**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "begins at ~L1",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Lumbar-Pelvic Sagittal Alignment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Pelvic incidence**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/combined%20pi,%20ss,%20pt_moved.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/pelvic%20incidence_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "pelvic incidence = pelvic tilt + sacral slope",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "a line is drawn from the center of the S1 endplate to the center of the femoral head",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "a second line is drawn perpendicular to a line drawn along the S1 endplate, intersecting the point in the center of the S1 endplate",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "the angle between these two lines is the pelvic incidence (see angle X in associated figure)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "correlates with severity of disease",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "pelvic incidence has direct correlation with the Meyerding-Newman grade",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2071/images/combined%20pi,%20ss,%20pt_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Pelvic tilt**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/pelvic%20tilt_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "pelvic tilt = pelvic incidence - sacral slope",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "a line is drawn from the center of the S1 endplate to the center of the femoral head",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "a second vertical line (parallel with side margin of radiograph) is drawn intersecting the center of the femoral head",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "the angle between these two lines is the pelvic tilt (see angle Z in associated figure)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Sacral slope**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/sacral%20slope_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "sacral slope = pelvic incidence - pelvic tilt",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "a line is drawn parallel to the S1 endplate",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "a second horizontal line (parallel to the inferior margin of the radiograph) is drawn",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "the angle between these two lines is the sacral slope (see angle Y in associated figure)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Image-Guided Interventions",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "performed using CT or fluoroscopic guidance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "22G-25G needle usually used for injection of local anesthetic and corticosteroid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Selective nerve root injections**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "unilateral radicular symptoms",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "used for therapeutic and diagnostic purposes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "transforaminal (outside-in) technique usually used",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Facet joint injection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2071/images/facet%20injection.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "to confirm facet joint as pain generator (diagnostic)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "also can be therapeutic",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Epidural injection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "indication",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2071/images/epidural%20injection.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "lumbar spinal stenosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Discography**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/discogram%20ap.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2071/images/discogram%20lateral.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "very controversial",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "to prove that pain arises from the intervertebral disc (\"concordant pain\") rather than other sources (\"discordant pain\")",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "small amount of dilute contrast injected into the disc",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "pain response is recorded",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "contrast helps assess disc morphology and diagnose annular tears",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Surgical Approaches",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Posterior",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**posterior midline approach**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "can be used for PLIF or TLIF",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**Wiltse paraspinal approach**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Anterior lateral",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**retroperitoneal (anterolateral) approach**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "aorta bifurcation found at L4-5",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "superior hypogastric plexus on L5 body",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "damage causes retrograde ejaculation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "also referred to as",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "transpsoas approach",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "direct lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "patient position",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "usually performed on **left side** due to increased resistance of aorta to injury",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "target levels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ideal for access for",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**L1-2**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**L2-3**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**L3-4**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "less ideal access",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "L4-5",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "highest risk of iatrogenic nerve injury to lumbar plexus, which can result in hip flexion and knee extension weakness",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "T12-L1",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "will need to remove rib and take down diaphragm",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "anatomic risks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lumbar plexus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "moves from dorsal to ventral going distally down the lumbar spine",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**ilioinguinal and iliohypogastric nerves**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2071/images/13b22cad-1dc3-41d3-9788-7cc4776b0094_lumbar_plexus..jpg",
                      "caption": "Lumbar plexus"
                    }
                  ],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may be injured during retroperitoneal approach, which can result in groin paresthesias and abdominal paresis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "segmental arteries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "need to be stabilized or tied off when performing a corpectomy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "aorta",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "important to place anterior retractors and prevent damage to aorta",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
