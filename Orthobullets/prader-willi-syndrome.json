    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosis is based primarily on physical exam at infancy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "glucose intolerance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "high insulin level",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "failure to respond to LHrF",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "high CO2, low O2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetic testing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may identify missing portion of chromosome 15 to confirm diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bracing",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications: curves over 20°-25° in children less than 10 years of age",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "efficacy may be compromised by obesity",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "growth rods",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "children under the age of 10 who cannot maintain a curve under 50°",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "posterior spinal fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications- older children with curves greater than 50°",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "complications may be higher than in idiopathic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
