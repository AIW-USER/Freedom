      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "failure to thrive in infancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weak cry",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "aggressive behavior",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "abnormal facial features",
              "table": null,
              "images": [],
              "importance": "3",
