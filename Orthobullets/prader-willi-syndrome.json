          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "small for gestational age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hypoplastic or undescended testicles",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "delayed onset of puberty",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "truncal obesity at 1-4 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "slow motor development",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may show signs of right-sided heart failure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "knee and hip instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
