    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "shoes with high toe boxes, Silicone/foam toe sleeves",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "percutaneous/open FDL tenotomy",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "flexible deformities that have failed nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "FDL transfer to dorsum of phalanx",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "to prevent unopposed extensor with FDL tenotomy and cock-up deformity",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "DIPJ fusion or middle phalangeal distal condylectomy (excisional arthroplasty of DIP)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "rigid deformities that have failed nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "repair attenuated extensor tendons",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "K wire placement used to hold affected digit in extension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
