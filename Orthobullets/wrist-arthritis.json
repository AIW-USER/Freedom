  "subtitle": "Updated: May 18 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Various forms of wrist arthritis based on location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**SLAC wrist** (scapholunate advanced collapse)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "most common",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**STT arthrosis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "second most common",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6056/images/stt%20arthritis.jpg",
                      "caption": "STT arthritis"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**SNAC** (scaphoid nonunion advanced collapse)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**DRUJ arthrosis**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6056/images/druj%20arthritis.jpg",
                  "caption": "DRUJ arthritis"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "**Pisotriquetrial arthrosis**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6056/images/pisotriquetrial%20arthritis.jpg",
                  "caption": "pisotriquetrial joint arthritis"
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "degenerative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "primary OA",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "posttraumatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leads to SLAC/SNAC/DRUJ",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "inflammatory",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Rheumatoid arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "congenital",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be secondary to Madelung's deformity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "idiopathic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may secondary to Kienbock's or Preiser's disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "SLAC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Injury to SL ligament --> palmar rotary subluxation of scaphoid --> incongruency of joint surfaces --> arthrosis of radiocarpal joint --> arthrosis of capitolunate joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**radiolunate typically spared**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "SNAC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "proximal portion of scaphoid remains attached to lunate while distal scaphoid flexes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "leads to early arthritis between radial styloid and distal scaphoid",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "like SLAC, radiolunate typically spared",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Rheumatoid arthritis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "wrist becomes supinated, palmarly dislocated, radially deviated, and ulnarly translocated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "early disruption of DRUJ leads to dorsal subluxation of ulna (Caput-ulna)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Wrist ligaments and biomechanics",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obtain standard hand series with additional views to visualize specific joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pisotriquetral joint (pisotriquetral arthrosis) obtain **lateral in 30 degrees of supination**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**NSAIDs, bracing, intra-articular steroid injections**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment for mild to moderate symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "aimed at addressing diseased area",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "SLAC",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "SNAC",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "Pisotriquetrial arthritis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "excision of pisiform in refractory cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "DRUJ abutment syndrome & arthrosis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "distal ulna resection (Darrach procedure)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "Sauvé-Kapandji procedure",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "partial ulna resection and interposition",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "ulnar head replacement",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6056/images/ulnar%20head%20replacement.jpg",
                          "caption": "ulnar head replacement"
                        }
                      ],
                      "importance": "4",
                      "children": [
                        {
                          "text": "can be used as primary procedure, or as salvage for failed Darrach",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "early results are promising, long-term results pending",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Rheumatoid arthritis",
                  "table": null,
                  "images": [],
                  "importance": "5",
