      "children": [
        {
          "text": "Clinical",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "local wound care",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rare",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "minimal soft tissue injury with absence of neurovascular injury",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "initial management:",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "place amputated part, if present, in bag with saline-moistened gauze, followed by bag of ice water",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**antibiotics and tetanus prophylaxis**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "replantation +/- vein graft, DIPJ fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "disruption of venous drainage only",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "disruption of venous and arterial flow (requires revascularization)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**requires intact PIPJ and FDS insertion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "contraindication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "complete amputation (especially proximal to PIPJ and FDS insertion) is relative contraindication to replantation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "survival",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "lower overall survival for avulsed digits replantation (60%) than finger replantation in general (90%)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "lower survival for complete (66%) vs incomplete avulsion replantation (78%)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "lower survival for avulsed thumb (68%) than finger (78%) replantation",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "surgeons more likely to attempt technically difficult avulsed thumb replantation where conditions not favorable because of importance of thumb to hand function (unlike other digits, where revision amputation would be performed instead)",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "sensibility",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "most achieve **protective sensibility** (2PD 9mm)",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "better sensibility with incomplete avulsion replantation (8mm) than complete (10mm)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "range of motion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "average total arc of motion (TAM) of 170-200 degrees",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "better TAM with incomplete avulsion replantation (199 degrees) than complete (174 degrees)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "revision amputation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "complete degloving",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bony injury with nerve and vessel injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bony amputation **proximal to FDS** insertion or **proximal to PIPJ**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "replantation likely to leave poor hand function",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "consider revision amputation or ray amputation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Surgical Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Replantation/revascularization**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "under operating microscope **mid-lateral approach** to digit",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "arteries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "thorough debridement of nonviable tissue",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "thorough arterial debridement (inadequate debridement leads to failure)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "repair using **vein grafts** because of significant vascular damage",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "may need another **step-down vein graft** because of difficulty in arterial size matching (small artery, large vein graft)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "may reroute arterial pedicle from **adjacent digit**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "disadvantage is this sacrifices major artery from adjacent digit",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "veins",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "repair **at least 2 veins**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "important factor in **revascularization failure**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "bone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "if amputation occurs at DIPJ, perform **primary arthrodesis** of DIPJ",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "skin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "perform **full-thickness skin grafts or venous flaps** to prevent tight closure or may utilize commercially available synthetic acellular dermal matrix.",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6061/images/screen_shot_2015-07-19_at_12.57.54_pm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Complications of replantation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cold intolerance** (70%)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**revascularization/replantation failure**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "factors include",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most significant factor is **repair of <2 veins**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**vascular damage up to digital pulp**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "smoking and level of bone injury have not been found to affect survival",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**flexion contracture**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**malunion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**revision surgery**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Complications of revision amputation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hyperaesthesia**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Outcomes of injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extent of injury is **greater** than what it appears to be",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
