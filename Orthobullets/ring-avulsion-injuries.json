{
  "title": "Ring Avulsion Injuries",
  "url": "https://www.orthobullets.com/hand/6061/ring-avulsion-injuries",
  "subtitle": "Updated: May 17 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ring Avulsion Injuries occur secondary to a sudden pull on a finger and result in severe soft tissue injury ranging from circumferential soft tissue laceration to complete amputation.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is confirmed with physical examination most commonly showing degloving of a finger.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment involves urgent repair or reconstruction depending on extend of soft tissue and neurovascular injury to the digit.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "150,000 incidents of amputations and degloving in the US per year",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "5% of upper limb injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually only involves **1 digit** (with ring)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "working with **machinery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "wearing a ring",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mechanism of injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patients catch their wedding band or other finger ring on moving machinery or protruding object",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**skin, nerves, vessels** are often damaged",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6061/images/mech.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**long segment** of macro- and microscopic **vascular** injury from crushing, shearing and avulsion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "avulsed digits are devoid of muscles and will survive >12h if cooled",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Skin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "skin is the finger's **strongest** soft tissue",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "once the skin tears, the remaining tissue quickly degloves",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Urbaniak Class I injuries at 80N of traction force",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Urbaniak Class III injuries at 154N of traction force",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Standard wedding band (3mm wide, regardless of alloy) will not open at 1000N",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
