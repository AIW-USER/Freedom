        },
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6011/images/intrinsic-plus-hand-500.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**spastic intrinsics**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "leads to flexion of the MCP and extension of the IP joints",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**EDC weakness**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "fails to provide balancing extension force to MCP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**FDS & FDP weakness**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "fail to provide balancing flexion force to PIP and DIP joints",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "difficulty gripping large objects",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "MCP joint flexion and IP joint extension",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6011/images/intrinsic%20plus%20posture.jpg",
                      "caption": "intrinsic plus posture"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Bunnell test (intrinsic tightness test)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "differentiates intrinsic tightness and extrinsic tightness",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "positive test when **PIP flexion is less with MCP extension** than with MCP flexion",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
