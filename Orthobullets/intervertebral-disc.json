{
  "title": "Intervertebral Disc",
  "url": "https://www.orthobullets.com/spine/9020/intervertebral-disc",
  "subtitle": "Updated: Jun 22 2026",
  "sections": [
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows spinal motion and provides stability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "links adjacent vertebral bodies together",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "responsible for 25% of spinal column height",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Composition",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**annulus fibrosus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "outer structure that encases the nucleus pulposus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "composed of **type I collagen (oriented obliquely),** water, and proteoglycans",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "characterized by high tensile strength and prevents intervertebral distraction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "remains flexible enough to allow for motion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**high collagen / low proteoglycan ratio** (proteoglycans comprise a low % of dry weight)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "fibroblast-like cells",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "responsible for producing type I collagen and proteoglycans",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**nucleus pulposus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "central portion of the intervertebral disc that is surrounded by the annulus fibrosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "composed of **type II collagen,** water, and proteoglycans",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "~88% water",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hydrophilic matrix is responsible for height of the intervertebral disc",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "characterized by compressibility",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "is a hydrated gel due to a high polysaccharide and high water content (88%)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "proteoglycans interact with water and resist compression",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "Aggrecan is the proteoglycan primarily responsible for maintaining the water content of the disc",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "viscoelastic matrix distributes the forces smoothly to the annulus and endplates",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**low collagen / high proteoglycan ratio** (proteoglycans comprise a high % of dry weight)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "chondrocyte-like cells",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "responsible for producing type II collagen and proteoglycans",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "survive in hypoxic conditions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9020/images/blood%20supply%20disc.jpg",
              "caption": "The organization of the venous system in a human vertebral body. The inset shows an enlarged section of the disk-bone interface with the intervertebral disk (1), the capillary bed through which nutrients to the disk are provided (2–3), the venous system perforating the subchondral plate and the collecting vein (4–5), and the venous system of the vertebral body (6–9)."
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "the disk is avascular with capillaries terminating at the endplates",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "nutrition reaches nucleus pulposus by **diffusing through pores in the endplates**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**annulus is not porous enough to allow diffusion**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Innervation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the dorsal root ganglion gives rise to the **sinuvertebral nerve,** which innervates the **superficial fibers of annulus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "no nerve fibers extend beyond the superficial fibers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "neuropeptides thought to participate in sensory transmission include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "substance P",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "calcitonin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "vasoactive intestinal peptide (VIP)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "C-flanking peptide of neuropeptide Y (CPON)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Fixation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "attached to vertebral bodies by hyaline cartilage",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Disc Biomechanics",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Disc",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "viscoelastic characteristics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "demonstrates creep, which allows for deformity over time",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "demonstrates hysteresis, which allows for energy absorption with repetitive axial compression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "this property decreases with time",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Stresses",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "annulus fibrosus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "highest tensile stress",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "nucleus pulposus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "highest compressive stress",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "intradiscal pressure is position dependent",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pressure is lowest when lying supine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pressure is intermediate when standing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pressure is highest when sitting and flexed forward with weights in the hands",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "when carrying weight, the closer the object is to the body, the lower the pressure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "following subtotal discectomy, extension is the most stable loading mode",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pathoanatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Disc herniation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "herniated disks are associated with a spontaneous increase in the production of:",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "osteoprotegerin (OPG)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "interleukin-1 beta (IL-1β)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "receptor activator of nuclear factor-κB ligand (RANKL)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "parathyroid hormone (PTH)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Disc aging leads to an overall loss of water content and **conversion to fibrocartilage**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**decrease in**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "nutritional transport",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "water content",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "absolute number of viable cells",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "proteoglycans",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "pH",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**increase in**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "keratin sulfate to chondroitin sulfate ratio",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "lactate",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "degradative enzyme activity",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**density of fibroblast-like cells**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**fibroblast-like cells reside in the annulus fibrosus only**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**no change in**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "absolute quantity of collagen",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
