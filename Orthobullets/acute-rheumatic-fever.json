    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lyme disease",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "positive Lyme titers",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Septic arthritis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "purulent synovial fluid, elevated cell count",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Reiter/Reactive arthritis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "specific rheumatologic labs will be positive (HLA-B27)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Juvenile Rheumatoid Arthritis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "specific rheumatologic labs will be positive (RF and ANA)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Gout/Pseudogout",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "synovial fluid positive for MSU or CPPD crystals",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosis based on Revised Jones criteria",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preceding Strep infection with 2 major criteria or 1 major and 2 minor criteria",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**major criteria**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9045/images/bb975257-3aba-46b6-b1e0-bbe06e69775f_jones_criteria.jpg",
                      "caption": "Jones crtieria - visual learning aid"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "carditis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "polyarthralgia",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "chorea",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "erythema marginatum",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "subcutaneous nodules",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**minor criteria**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "fever",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "arthralgia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "prior rheumatic fever",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "increased ESR",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "prolonged PR interval (First degree heart block)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "prior Group A Strep infection",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral antibiotics and **anti-inflammatories**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute infection confirmed by Modified Jones criteria",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "arthralgias and/or fever",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "Penicillin 250mg PO BID x10 days (or erythromycin if penicillin-allergic)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "Penicillin monthly x10 years to prevent rheumatic fever recurrence",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "anti-inflammatories",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "naprosyn more commonly used",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "salicylates used historically but concern for liver derangement deters use",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
