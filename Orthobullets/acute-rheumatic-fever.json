{
  "title": "Acute Rheumatic Fever",
  "url": "https://www.orthobullets.com/basic-science/9045/acute-rheumatic-fever",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acute Rheumatic Fever is a systemic reaction following Streptococcal pharyngitis which causes a characteristic rash and migratory arthritis that involves multiple large joints.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is based on the Revised Jones criteria.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually oral antibiotics and anti-inflammatories.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "500k new cases per year worldwide",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "children 5-15 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lower socioeconomic status",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "developing countries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "molecular biology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "autoimmune reaction within 1-4 weeks following **Group A beta-hemolytic Streptococcus pyogenes pharyngitis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "molecular mimicry",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "antibodies to M protein of GAS causing an inflammatory response to synovium, myocardium, and basal ganglia cells",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rash",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "joint pain and refusal to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "red, swollen joints predominantly if the lower extremities, migratory",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "rash",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "erythema marginatum (pink rash on trunk and extremities that spares the face)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9045/images/images..jpg",
                      "caption": "Erythema marginatum associted with Acute Rheumatic Fever"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "other",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "subcutaneous nodules on upper extremity extensor surfaces",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "chorea",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "carditis, first-degree heart block (prolonged PR interval)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
