{
  "title": "Syndactyly",
  "url": "https://www.orthobullets.com/hand/6076/syndactyly",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Syndactyly is the most common congenital malformation of the limbs and is characterized by abnormal connections of digits of the hand.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is usually digit release performed at ~ 1 year of age.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1 in 2,000 - 2,500 live births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "M > F",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Caucasians > African Americans",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Ray involvement",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "50% long-ring finger",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "30% ring-small finger",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "15% index-long finger",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "5% thumb-index finger",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "failure of apoptosis to separate digits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**autosomal dominant** in cases of pure syndactyly",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "reduced penetrance and variable expression",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "positive family history in 10-40% of cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**acrosyndactyly**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6076/images/photo%20acrosyn.jpg",
                  "caption": "acrosyndactyly"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "digits fuse distally and proximal digit has fenestrations (e.g., constriction ring syndrome)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Poland Syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Apert Syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Carpenter syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "acrocephalopolysyndactyly",
                  "table": null,
                  "images": [],
