{
  "title": "Boutonniere Deformity",
  "url": "https://www.orthobullets.com/hand/6012/boutonniere-deformity",
  "subtitle": "Updated: Jan 15 2023",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Boutonniere Deformities are Zone III extensor tendon injuries characterized by PIP flexion and DIP extension.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with PIP flexion and DIP extension of a digit with presence of a positive Elson test.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment of acute injuries involves splinting of the PIP joint with operative management reserved for chronic, symptomatic injuries.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "EPIDEMIOLOGY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common in rheumatoid patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Up to 50% of patients with rheumatoid arthritis develop a boutonniere deformity in at least one digit",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "caused by rupture of the central slip over PIP joint from",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**laceration**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**traumatic avulsion** (jammed finger)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "capsular distension in **rheumatoid arthritis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomic sequence includes",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6012/images/Lineage%20Medical%20500_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "3",
              "children": [
                {
                  "text": "**rupture of central slip**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "causes the extrinsic extension mechanism from the EDC to be lost",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "prevents extension at the PIP joint",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**attenuation of triangular ligament**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**causes intrinsic muscles of the hand (lumbricals) to act as flexors at the PIP joint**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**lumbricals also extend the DIP joint without an opposing or balancing force**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**palmar migration of collateral bands and lateral bands**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**the lumbricals' pull becomes unopposed, pulling through the base of the distal phalanx and volar to the PIP**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "causes PIP flexion and DIP extension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "bone deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "injury involves all three phalanges",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "the middle phalanx flexes on the proximal phalanx at the PIP joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "the distal phalanx is hyperextended relative to the middle phalanx at the DIP joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rheumatoid arthritis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**pseudo-boutonniere**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "refers to PIP joint flexion contracture in the absence of DIP extension",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Muscle",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lumbrical muscles**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "originate from the FDP and insert on the lateral bands",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ligament anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**extensor hood and central slip**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the extrinsic extensor tendon joins the extensor hood at the MCP",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the central portion of the extensor hood forms the central slip",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the central slip inserts onto the middle phalanx and acts to extend the PIP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral bands**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the lateral bands are formed from the deep head of the dorsal interossei combining with the volar interossei",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the lateral bands insert onto the base of the distal phalanx to extend the DIP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**triangular ligament**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "spans the two lateral bands, preventing them from subluxing volarly",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**transverse retinacular ligament**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "prevents dorsal subluxation of the lateral bands",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**interosseous muscles**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "receive blood from vessels formed by a combination of the deep palmer arch and the ulnar artery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "characterized by PIP flexion DIP extension",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6012/images/Clinical%20photo%20-%20surgery%20missouri_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**Elson test**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "is the most reliable way to diagnose a central slip injury **before the deformity is evident**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "bend PIP 90° over edge of a table and extend middle phalanx against resistance.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "in presence of central slip injury there will be",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**weak PIP extension**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**the DIP will go rigid**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "in absence of central slip injury DIP remains floppy because the extension force is now placed entirely on maintaining extension of the PIP joint; the lateral bands are not activated",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended view",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "radiographs are not required in evaluation and treatment of Boutonniere deformity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "splint PIP joint in full extension for 6 weeks",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "acute closed injuries (< 4 weeks)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "encourage active DIP extension and flexion in splint to avoid contraction of oblique retinacular ligament",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "complete part-time splinting for an additional 4-6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary central band repair",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**acute displaced avulsion fx** (proximal MP avulsion seen on x-ray)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "open wound that needs I&D",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "lateral band relocation** vs. **terminal tendon tenotomy** vs. **tendon reconstruction",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "in chronic injuries after FROM is obtained with therapy or surgical release",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "terminal tendon tenotomy (modified Fowler or Dolphin tenotomy)(never central slip tenotomy)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "secondary tendon reconstruction (tendon graft, Littler, Matev)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "triangular ligament reconstruction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "PIP arthrodesis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "rheumatoid patients",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "painful, stiff and arthritic PIP joint",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
