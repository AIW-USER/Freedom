{
  "title": "Humeral Shaft Nonunion",
  "url": "https://www.orthobullets.com/trauma/12767/humeral-shaft-nonunion",
  "subtitle": "Updated: Jun 3 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Humeral Shaft Nonunion is characterized by the arrest of the fracture repair process of a humeral shaft fracture which may occur following nonoperative or operative management.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made with plain radiographs. CT studies are helpful to assess the extent of bridging callous and for preoperative planning.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally open reduction with compression plating with or without bone grafting.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence of primary nonunion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**2 to 33% with nonoperative management**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**5 to 10% with surgical management**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "proximal third humeral shaft fractures are felt to have higher rates of nonunion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "biologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "metabolic/endocrine abnormalities (osteoporosis, Vitamin D deficiency most common)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "patient factors (smoking, obesity, malnutrition, noncompliance**)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "open fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "mechanical",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "unstable fracture patterns with inadequate stability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "shoulder or elbow stiffness (motion directed to fracture site)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inadequate stability at fracture site with operative or nonoperative treatment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pathobiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inadequate biology as a result of metabolic/endocrine abnormalities, infection, smaller bone surface area for healing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radial nerve palsy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Blood Supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nutrient vessel of humerus courses along the medial aspect of the mid to distal third of the diaphysis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12767/images/nutrient_artery.jpg",
                  "caption": "Nutrient artery of humerus"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pectoralis major and deltoid create strong deforming forces on proximal diaphyseal fractures",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12767/images/deforming_forces_on_proximal_humerus.jpg",
                  "caption": "Illustration showing the deforming forces on a proximal third humeral shaft fracture"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Tendon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "biceps tendon interposition in proximal diaphyseal fractures may lead nonunion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain with use of the extremity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "assess the fit of functional brace and skin irritation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "atrophy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "angulation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "gross motion at the fracture site",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "assess radial nerve function",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of the humerus, shoulder, and elbow",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lack of fracture consolidation",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12767/images/nonunion_humerus2.jpg",
                      "caption": "AP radiograph of a humeral shaft fracture nonunion."
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/12767/images/nonunion_humerus.jpg",
                      "caption": "Lateral radiograph of a humeral shaft fracture nonunion"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "hypertrophic callous formation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pseudarthrosis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12767/images/humerus_pseudarthrosis.jpg",
                      "caption": "Lateral humerus radiograph demonstrating a pseudarthrosis."
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "to evaluate for the extent of bridging callous and preoperative planning",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CRP, ESR, CBC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "must rule out infection",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "total protein and serum albumin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "vitamin D, TSH, PTH",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "functional bracing +/- bone stimulation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "rarely indicated unless low demand, high-risk surgical candidate, and asymptomatic nonunion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "continued functional brace",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "bone stimulators",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "nonunion over a period greater than 9 months or no progressive healing 3 months from injury",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "contraindicated if pseudarthrosis, fracture gap >5mm, or poor blood supply",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "compression plating with bone grafting (gold standard)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "symptomatic nonunion",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**shown to be superior to IM nailing**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "dual plating",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12767/images/dual_plating.jpg",
                  "caption": "Dual plating of a distal third humeral shaft fracture."
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "very proximal or distal fracture nonunion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "poor metaphyseal bone quality",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "micromotion noted at fracture site following single plate fixation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "92-100% union at 16 weeks",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "cortical strut allograft/autograft",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "severe osteopenia from disuse, age, or prior surgery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "severe bone loss",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "recalcitrant nonunion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "95-100% union rate",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "bone morphogenic proteins (BMP's)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "limited role as no studies show improved outcomes",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Compression plating with or without bone grafting**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "anterior",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "anterolateral",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "posterior",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "radial nerve exploration and neurolysis or release of nerve entrapment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "soft tissue",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "radial nerve protection and neurolysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "bone work",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "debridement of fibrous tissue and bone ends to stimulate healing",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "fracture reduction with maximal cortical contact and stability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**autologous bone grafting from ICBG if atrophic nonunion**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "DBM, RIA, or local callous autograft as alternative grafts",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "4.5mm compression plate placed anterior, lateral, or posterior",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications specific to this treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "radial nerve neuropraxia or injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ICBG donor site morbidity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "nearly 100% union rate reported",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "44% rate of ICBG donor site morbidity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Dual plating**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "place additional plate orthogonal to the first plate",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Cortical strut allograft/autograft**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "bone work",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "place strut intramedullary and then place the plate",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12767/images/intramedullary_cortical_strut_allograft.jpg",
                      "caption": "AP of humerus showing intraoperative fluoro of an intramedullary cortical strut allograft."
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "place strut medially and place laterally based compression plate",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12767/images/cortical_strut_allograft.jpg",
                      "caption": "Cortical strut allograft placed medially for humeral shaft nonunion."
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nerve injury**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**radial nerve most common**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Persistent nonunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "free fibular grafting",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "recalcitrant atrophic nonunions",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
