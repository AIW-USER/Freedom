{
  "title": "Spine Biomechanics",
  "url": "https://www.orthobullets.com/spine/2003/spine-biomechanics",
  "subtitle": "Updated: May 21 2025",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Functional spinal unit (FSU)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "defined as the cephalad vertebral body, caudad vertebral body, intervertebral disc, and the corresponding facet joints",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "function is to provide physiologic motion and protect neural elements",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "intradiscal pressure depends on position",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2003/images/screen_shot_2017-04-17_at_5.52.21_pm.jpg",
                  "caption": "Intradiscal pressures"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Spinal stability**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "defined as the absence of abnormal strain or excessive motion in the FSU under physiologic loading",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "maintained by",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "FSU",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "muscular tension",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "abdominal and thoracic pressure",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "rib cage support",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Three Column Theory",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Denis three column model",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "clinical relevance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "only moderately reliable in determining clinical degree of stability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "definitions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anterior column",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/combined_2.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**anterior longitudinal ligament** (ALL)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**anterior 2/3 of vertebral body** and annulus",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "middle column",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/combined_2.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**posterior longitudinal ligament** (PLL)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**posterior 1/3 of vertebral body** and annulus",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "posterior column",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/combined_2.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**pedicles**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**facets**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**ligamentum flavum**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**spinous process**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**posterior ligamentous complex (PLC)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "instability defined by",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "injury to middle column",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "evidenced by widening of interpedicular distance on AP radiograph",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "loss of height of the posterior cortex of the vertebral body",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "disruption of posterior ligamentous complex combined with anterior and/or middle column involvement",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Ligaments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "FSU is surrounded by 10 ligaments that function to:",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2003/images/screen_shot_2017-04-17_at_5.41.56_pm.jpg",
              "caption": "Ligaments of spine"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "protect neural structures by restricting motion of the FSU",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "absorb energy during high speed motion",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Contents",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "all ligaments are composed of type I collagen except the **ligamentum flavum (mostly elastin)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "are viscoelastic with nonlinear behavior",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/screen_shot_2017-04-17_at_5.42.12_pm.jpg",
                      "caption": "Properties of spinal ligaments"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Posterior Ligamentous Complex (PLC)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Integrity of PLC is now considered one of the most critical predictors of spinal fracture stability",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2003/images/combined_2.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "one of three primary factors in the Thoracolumbar Injury Classification and Severity Score (TLICS). TLICS categorizes the PLC as:",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "intact",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "suspect/indeterminant",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ruptured",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of:",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**supraspinous ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**interspinous ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**ligamentum flavum**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**facet capsule**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "determining PLC integrity can be challenging",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "conditions where PLC is ruptured:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bony chance fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "widening of interspinous distance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "progressive kyphosis with nonoperative treatment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "facet diastasis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "conditions with ambiguity:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "MRI shows signal intensity between spinous processes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "according to TLICS, if PLC is intact (+0 points) in a compression (+1 point) burst fracture (+1 point) in a patient without neurologic deficits (+0 points), the patient should be treated nonoperatively",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "total score = 2 points (score <4 points = nonoperative)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "according to TLICS, if PLC is ruptured (+3 points) in a compression (+1 point) burst fracture (+1 point) in a patient without neurologic deficits (+0 points), the patient should be treated with surgery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "total score = 5 points (score >4 points = operative)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Spinal Balance",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Sagittal balance**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2003/images/negative%20sagittal%20balance%20obq11.49.jpg",
              "caption": "shows a standing lateral of the lower cervical, thoracic and lumbar spine."
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "due to the normal cervical lordosis, thoracic kyphosis, and lumbar lordosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cervical lordosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "normal range 20-40°",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "thoracic kyphosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "average 35°",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "normal range 20-50°",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lumbar lordosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "average 60°",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "normal range 20-80°",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "as much as 75% of lumbar lordosis occurs between L4 and S1 with 47% occurring at L5/S1",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "normal alignment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the vertical axis runs from the center of C2 → anterior border of T7 → middle of the T12/L1 disc → posterior to the L3 vertebral body → crosses the posterior superior corner of the sacrum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "on radiographs, this is estimated by a plumb line dropped from the center of C7 to the posterior-superior corner of S1",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "negative sagittal balance",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the axis is posterior to the sacrum and occurs in patients with lumbar hyperlordosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "positive sagittal balance",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the axis is anterior to the sacrum and occurs in patients with hip flexion contracture or flat-back syndrome",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Motion",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "The orientation of the **facet** (zygapophyseal) joints determines the degree and plane of motion at that level",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "varies throughout the spine to meet physiologic function",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**cervical spine** (C3-7)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "planes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "0° coronal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "45° sagittal (angled superomedially)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2003/images/cervical%20facets_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "allow flexion-extension, lateral bending, rotation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**thoracic spine**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "planes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "20° coronal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "55° sagittal (facets in coronal plane)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "6 degrees of freedom",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2003/images/rom_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "allow some rotation, minimal flexion-extension (also limited by ribs)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2003/images/rom2_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "prevent downward flexion on the heart and lungs",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2003/images/thoracic%20facets_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**lumbar spine**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "plane",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "50° coronal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "90° sagittal (facets in sagittal plane)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2003/images/lumbar%20facets_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "allow flexion-extension, minimal rotation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "help increase abdominal pressure",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Instantaneous axis of rotation (IAR)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "axis about which the vertebra rotates at some instant in time",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2003/images/lumbar.jpg",
                  "caption": "IAR for lumbar spine"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2003/images/thoracic.jpg",
                  "caption": "IAR for thoracic spine"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "normal FSU",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "IAR is confined to a small area within the FSU",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "abnormal FSU (e.g. degenerative disc)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "IAR shifts outside the physical space of the FSU",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/degenerative_disc.jpg",
                      "caption": "IAR of degenerative disc"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "can be dramatically enlarged",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Pedicle Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "C2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "viable for pedicle screw placement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "C3-C6",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pedicles are small, making pedicle screw instrumentation difficult",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "lateral mass screws placed at C3-C6 as an alternative",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "C7",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "viable for pedicle screw placement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Thoracic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pedicle diameter",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2003/images/pedicle_diameter_illustration_3.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "the pedicle wall is twice as thick medially as it is laterally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**T4 has the narrowest pedicle diameter** (on average)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "T7 can be irregular and have a narrow diameter on the concave side in AIS",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "T12 usually has a larger pedicle diameter than L1",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "pedicle length",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pedicle length decreases from T1 to T4 and then increases moving distally in the thoracic spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "T1: 20 mm",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "T4: 14 mm (**shortest pedicle**)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "T10: 20 mm",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pedicle angle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "transverse pedicle angle",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/transverse%20pedicle%20angle_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "varies from 10° (mid-thoracic spine) to 30° (L5)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "sagittal pedicle angle",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2003/images/sagittal%20pedicle%20angle_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "15-17° cephalad for the majority of thoracic spine",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "neutral (0°) for lumbar spine except L5 (caudal)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
