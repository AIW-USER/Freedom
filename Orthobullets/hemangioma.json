{
  "title": "Hemangioma",
  "url": "https://www.orthobullets.com/pathology/8033/hemangioma",
  "subtitle": "Updated: Jun 21 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hemangiomas are benign vascular tumors of bone that most often occur in the vertebral bodies and craniofacial bones. Patients typically present with an asymptomatic lesion found incidentally on radiographs.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs showing lytic lesions with characteristic vertical striations and with biopsy showing cavernous lesions with numerous thin-walled blood vessels.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is observation for asymptomatic lesions. Surgical curettage and bone grafting is indicated in progressively painful lesions.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may present with **pain** or **pathologic fx**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lytic lesion characteristic **vertical striations** giving a \"**honey-comb**\" or \"jail-bar\" appearance",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8033/images/Case%20C%20-%20spine%20-%20xray%20-%20parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "may be multi-focal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone scan is warm to hot",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Characteristic histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cavernous lesions** with numerous **thin walled blood vessels**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8033/images/Histology%20C%20-%20hig%20-%20parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indicated if the patient is asymptomatic",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**curettage and bone grafting**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indicated if the lesion is symptomatic and accessible",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "low dose radiation (25 to 40 Gy)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indicated if the lesion is symptomatic and inaccessible",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
