{
  "title": "Vertebral Artery Injury",
  "url": "https://www.orthobullets.com/spine/12785/vertebral-artery-injury",
  "subtitle": "Updated: May 13 2026",
  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence of vertebral artery injury (VAI)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "0.5% of all trauma patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "70% of VAI in blunt trauma has an associated cervical fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "33-39% of all cervical spine fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "0.3% anterior cervical spine surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "4.1-8.2% posterior cervical spine surgery (C1-2 transarticular screws)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "blunt traumatic injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pathoanatomy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "highest injury risk at point of entry into C6 transverse foramen",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "second highest risk at C1-2 articulation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "iatrogenic injury during elective surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "safe zone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "C1: avoid dissection cephalad to the C1 posterior arch >1.5 cm lateral to midline",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "C1 lateral mass screw should be placed in a 10° medial and 22° cephalad trajectory",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12785/images/b0c4a8f7-5bcd-4dd2-9d81-260386faaa1f_c1_entry_point_graphic..jpg",
                          "caption": "C1 lateral mass screw trajectory"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "4 arterial segments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "V1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "extraosseous",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "origin at subclavian artery → anterior to C7 transverse process → entry point of C6 transverse foramen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "V2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "within the transverse foramina of C6 → C1",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "most traumatic injuries occur here",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "high risk during drilling, tapping, insertion of lateral mass or pedicle screws",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "V3",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "superior aspect of the arch of atlas to foramen magnum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "VA is vulnerable during lateral exposure and laminectomy of C1",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "high risk of C1-2 transarticular screws that are directed caudally and laterally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "V4",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "intradural extension from foramen magnum to unite with contralateral vertebral artery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "forms the basilar artery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "most injuries from cervical trauma in V2 (foraminal segment)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anomalous anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reported prevalence of 2.7% in anterior cervical surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "transverse foramen may be medial to or within 1.5 mm of the uncovertebral joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "reported prevalence of 2.3-20% in the atlantoaxial region",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "high-riding C2 foramen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "C2 pedicle erosion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "C2 lateral mass thinning",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 2,
                  "bullets": [
                    {
                      "text": "**Biffl VAI Injury Grading**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Grade I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Arteriographic appearance of vessel; dissection/intramural hematoma with <25% luminal stenosis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Grade II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Intraluminal thrombosis or raised intimal flap; dissection/intramural hematoma with >25% luminal stenosis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Grade III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Pseudoaneurysm",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Grade IV",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Vessel occlusion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Grade V",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Vessel transection",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of recent:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cervical spine trauma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "C1 or C2 fractures",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "subaxial facet fractures and dislocations",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "elective surgery of the cervical spine or craniocervical junction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "variable in presentation and time of onset",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "vertebrobasilar insufficiency manifests with:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dizziness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "vertigo",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "nausea",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diplopia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "blindness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ataxia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bilateral weakness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "oropharyngeal dysfunction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Radiographs**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**x-rays of certain fracture patterns raise suspicion for VAI**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**CT angiography (CTA)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "identification of local occlusion or extravasation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "sensitivity reported at 100%",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "indications for the trauma patient (any single criteria is an indication)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "unexplained central or lateralizing neurologic deficit",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "evidence of acute cerebral infarct on CT scan of head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "GCS <9",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "evidence of diffuse axonal injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "facial fracture or Le Fort type II or III fracture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**cervical spine fracture or subluxation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**C1, 2, or 3 fracture**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**Fracture extension into the transverse foramen**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**VAI demonstrated in 20%**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**cervical spinal cord injury**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**hanging injuries**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "major thoracic injury or first rib fracture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Magnetic resonance angiography (MRA)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "identification of local occlusions/stenosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "sensitivity 93.9%",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cervical spine fractures with neurologic deficits attributable to damaged vertebral or basilar artery perfusion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Postoperative anticoagulation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "goal is to prevent thromboembolic sequelae of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "intravenous heparin",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "acetylsalicylic acid (aspirin)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "first line of treatment",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "modalities",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "heparin, aspirin, clopidogrel, IV thrombolysis, glycoprotein IIb/IIIa antagonists (abciximab, eptifibatide, or tirofiban)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "contraindications:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "major intracranial infarction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intraspinal hematoma/arteriovenous fistula",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative reduction and stabilization as necessitated by fracture pattern",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Surgical techniques to control hemorrhage (**see techniques**)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Immediate intraoperative angiography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can assist intraoperative decision making",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Postoperative management following iatrogenic injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "further intervention dictated by clinical course",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "immediate postoperative angiography",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "detects vascular complications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "confirms adequate collateral cerebral circulation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "allows embolization of fistulae or pseudoaneurysm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Hemostatic tamponade**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "utilization of topical hemostatic agents, bone wax",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "if injured during C1-2 transarticular screw placement, can tamponade by screw insertion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "risks include:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "delayed hemorrhage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "fistula formation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Microvascular repair**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "allows restoration of normal blood flow",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "minimizes risk of ischemic complications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "technically demanding",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Direction ligation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "consider intraoperative angiography first to evaluate collateral circulation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "risks of certain morbidities",
              "table": null,
