{
  "title": "Idiopathic Transient Osteoporosis of the Hip (ITOH)",
  "url": "https://www.orthobullets.com/recon/9036/idiopathic-transient-osteoporosis-of-the-hip-itoh",
  "subtitle": "Updated: Jun 9 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Idiopathic Transient Osteoporosis of the Hip, is a self-limiting condition that leads to temporary loss of bone in the femoral head and neck, leading to hip pain and difficulty with ambulation.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Diagnosis can be made with radiographs showing preserved joint space with diffuse osteopenia of the femoral head and neck. MRI studies will often show decreased signal with loss of fatty marrow on T1 studies.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is observation with protected weight bearing as most cases resolve spontaneously within 6-8 months.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "men >women (3:1)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "2 groups",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "middle aged (40-55y) men",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "women in **3rd trimester of pregnancy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "rare in Asians",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually unilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may recur",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathogenesis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "local hyperemia and impaired venous return with marrow edema and increased intramedullary pressure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "also referred to as",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "bone marrow edema syndrome",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "regional migratory osteoporosis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "migratory osteolysis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "progressive, atraumatic hip and groin pain over several weeks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may be unable to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "local tenderness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often have normal hip ROM",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
