    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**genu varum/flexion/internal rotation deformity**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "usually bilateral in infants",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "may exhibit positive **'cover-up test'**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4050/images/screen_shot_2014-07-19_at_4.03.37_pm_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "often associated with internal tibial torsion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "leg length discrepancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually NO tenderness, restriction of motion, effusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lateral thrust on walking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "ensure that patella are facing forwards for evaluation (commonly associated with internal tibial torsion)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "findings suggestive of Blounts disease",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "varus focused at proximal tibia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "severe deformity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "asymmetric bowing",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "medial and posterior sloping of proximal tibial epiphysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "progressing deformity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "sharp angular deformity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lateral thrust during gait",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**metaphyseal beaking**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4050/images/blounts.jpg",
                      "caption": "metaphyseal beak"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "different than physiologic bowing which shows a symmetric flaring of the tibia and femur",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "measurements",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**metaphyseal-diaphyseal angle (Drennan)**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4050/images/Metaphyseal%20diaphyseal%20angle_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "angle between line connecting metaphyseal beaks and a line perpendicular to the longitudinal axis of the tibia",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**>16 ° is considered abnormal** and has a 95% chance of progression",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "Drennan angles between 11-16° necessitate close observation for the progression of tibia vara",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "<10 **° has a 95% chance of natural resolution of the bowing**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**tibiofemoral angle**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4050/images/Tibiofemoral%20angle_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "angle between the longitudinal axis of the femur and tibia",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "1",
      "children": [
        {
          "text": "The following conditions can also lead to pathologic genu varum",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "**persistent physiological varus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**rickets**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4050/images/rickets_comparison.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "osteogenesis imperfecta",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "MED",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "SED",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "metaphyseal dysostosis (Schmidt, Jansen)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "focal fibrocartilaginous defect",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "thrombocytopenia absent radius",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "proximal tibia physeal injury (radiation, infection, trauma)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "brace treatment with KAFO",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**Stage I and II in children < 3 years**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "bracing must continue for approximately 2 years for resolution of bony changes",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "improved outcomes if **unilateral**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "poor results associated with **obesity** and **bilaterality**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "if successful, improvement should occur within 1 year",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "proximal tibia/fibula valgus osteotomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "overcome the varus/flexion/internal rotation deformity",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**Stage I and II in children > 3 years**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**Stage III, IV, V, VI**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**age ≥ 4y (all stages)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**failure of brace treatment**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**progressive deformity**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**metaphyseal-diaphyseal angles > 20 degrees**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "perform osteotomy **below** tibial tubercle",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "staged procedures may be required for Stage IV, V, VI",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "epiphysiolysis required in stage V and VI",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "risk of recurrence is significantly lessened if performed before 4 years of age",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "growth modulation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "tension band plate and screws",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "physeal bar resection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "at least 4y of growth remaining",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "perform together with osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "interpositional material is usually fat or PMMA",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "hemiplateau elevation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "may be performed together with osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Proximal tibia/fibula valgus osteotomy**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "goals of correction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**overcorrect into 10-15° of valgus** because medial physeal growth abnormalities persist",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "distal segment is fixed in valgus, external rotation and lateral translation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "staples and plates function by increasing compression forces across the physis which slows longitudinal growth (Heuter-Volkmann principle)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "temporary lateral physeal growth arrest with staples or plates can be used",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "increasing use for correction in younger patients",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**include a bar resection (epiphysiolysis) when a physeal bar is present (Langenskiold V and VI)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "consider **hemiepiphysiodesis** if bar > 50%",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial tibial plateau elevation is required at time of osteotomy if significant depression is present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "consider prophylactic anterior compartment fasciotomy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Compartment syndrome** (with high tibial/fibular osteotomy)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "prophylactic release of anterior compartment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Recurrence of tibial vara**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "severe cases of Infantile Blount's disease may develop a physeal bar",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "can result in progressive varus after a well executed proximal tibial valgus osteotomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may require a lateral tibial hemiepiphysiodesis or bar resection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Best outcomes with **early diagnosis** and **unloading of the medial joint** with either bracing or an osteotomy",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Young children with stage II and stage IV can have **spontaneous** correction",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
