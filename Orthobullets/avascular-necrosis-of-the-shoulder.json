    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "insidious onset of shoulder pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often without a clear inciting event",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pain, loss of motion, crepitus, and weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "limited range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "crepitus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakness of the rotator cuff and deltoid muscles",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
