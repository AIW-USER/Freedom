                  "caption": "hands of patient with apert syndrome"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
