{
  "title": "Apert Syndrome",
  "url": "https://www.orthobullets.com/hand/6078/apert-syndrome",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Syndrome characterized by",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**bilateral complex syndactyly** of hands and feet",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "index, middle, and ring fingers most affected",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**symphalangism**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "premature fusion of cranial sutures (craniosynostosis) results in flattened skull and broad forehead (acrocephaly)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "hypertelorism (increased distance between paired body parts, as in wide set eyes)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "normal to moderately disabled cognitive function",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "glenoid hypoplasia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "radioulnar synostosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "1/80,000 live births",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "autosomal dominant, but most new cases are sporadic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mutation of **FGFr2 gene**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**dysmorphic face**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6078/images/Clinical%20photo_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "craniosynostosis results in flattened skull and facial features",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "rosebud hands (complex syndactyly where the index, middle, and ring finger share a common nail)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6078/images/apert%20facies..jpg",
                  "caption": "shows hands and face of apert syndrome"
