{
  "title": "Foot Anatomy and Biomechanics",
  "url": "https://www.orthobullets.com/foot-and-ankle/7006/foot-anatomy-and-biomechanics",
  "subtitle": "Updated: Aug 10 2021",
  "sections": [
    {
      "text": "Plantar fascia",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Plantar fascia (windlass mechanism)**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "origin",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "medial calcaneal tuberosity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "insertion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "base of the 5th metatarsal (lateral band), plantar plate and bases of the five proximal phalanges",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "increase arch height as toes dorsiflex during toe-off",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "major (2nd most important) medial arch support",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Hindfoot",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of articulation between",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "talus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "calcaneus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Joints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**subtalar joint**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "has 3 facets",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "posterior facet",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "this is the largest facet",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "middle facet",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "located medially and sits on the sustentaculum of the calcaneus",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "anterior facet",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "continuous with the talonavicular joint",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "motion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "inversion/eversion",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7006/images/inversion_eversion_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "plays no role in plantar and dorsiflexion",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**transverse tarsal joint (Chopart joint)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "consists of two components",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**talonavicular joint**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "ligament support",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "supported by the spring ligament which consist of",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": [
                                {
                                  "text": "superior medial calcaneonavicular ligament",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                },
                                {
                                  "text": "inferior calcaneonavicular ligament",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "**calcaneocuboid joint**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "anatomy",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "saddle shaped",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "ligament support",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "plantar support is by the superficial and deep inferior calcaneocuboid ligaments",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "superior support is by the lateral limb of the bifurcate ligamant",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "motion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7006/images/subtalar%20joint%20chopart%20joint%20axes_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "inversion of subtalar joint locks the transverse tarsal joint",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "allows for a stable hindfoot/midfoot for toe-off",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "eversion of subtalar joint unlocks the transverse tarsal joint",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "allows for supple foot to accommodate ground just after heel strike",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "plantar aponeurosis is primary structure of load/force transfer between hindfoot and forefoot during stance",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "works with the subtalar joint to control foot flexibility during the gait cycle",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Midfoot",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "starts at the articulation between the navicular and cuneiforms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "articulations between the cuboid and fourth and fifth metatarsals",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tarsometatarsal joint (TMT joint)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Midfoot joints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**naviculocuneiform and intercuneiform joints**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "connected by a dense ligamentous structure that permits little motion between the joints",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**tarsometatarsal joint(Lisfranc joint)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "consists of",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "1st, 2nd and 3rd metatarsocuneiform joints",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "4th and 5th metatarsocuboid joints",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "divided into three columns",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "medial column",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7006/images/medial%20column%20of%20foot_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "first metatarsal",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "medial cuneiform",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "navicular",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "middle column",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7006/images/middle%20column_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "second and third metatarsals",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "middle cuneiform",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "lateral cuneiform",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "lateral column",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7006/images/lateral%20column_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "forth and fifth metatarsals",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "cuboid",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "ligament support of the TMT joint",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "composed of three layers",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "interosseus layer",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "contains the Lisfranc ligament",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "origin",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": [
                                {
                                  "text": "plantar aspect of the medial cuneiform",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "inserts",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": [
                                {
                                  "text": "base of the second metatarsal",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "this is the strongest layer",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "plantar layer",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "next strongest",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "dorsal layer",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "this is the weakest layer",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "motion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "lateral column is the most mobile",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "allows for flexibility when walking on uneven ground",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "middle column is the least mobile",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "allows for rigidity during push-off",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "medial column carries most of load while standing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "functions as a transverse roman arch in the axial plane",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "dorsal surface of the arch is wider than the plantar surface",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "second metatarsal base",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "acts as a keystone",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Forefoot",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extends from tarsal-metatarsal joint to tips of toes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bones consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "phalanges",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "first phalanx",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "at risk for seymour fracture of distal phalanx",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "must remove nail and interposed physeal tissue, repair nailbed, splint in extension and prescribe antibiotics",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "metatarsals",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "first metatarsal",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "shortest and widest",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "takes 50% of weight during the gait cycle",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "second metatarsal",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "is the longest",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Joints consists of",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7006/images/forefoot_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "metatarsophalangeal joints",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "proximal interphalangeal joints",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "distal interphalangeal joints",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Ligaments and tendons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**transverse metatarsal ligament**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**holds hallucal sesamoids in place** as 1st MT head moves medially",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "can lead to false image of sesmoid subluxation",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "head is moving, not the sesmoids",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**conjoined tendon of the adductor hallucis muscles**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "broad insertion over the lateral aspect of the lateral sesamoid and lateral aspect of the base of the proximal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**plantar plate**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "made up of a dense phalangeosesamoidal complex",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "plantar plate of 2nd MTP",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "must become lax before abnormal dorsal translation of proximal phalanx can occur",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "once attenuated, most deforming force is EDL",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "weakest at origin of metatarsal neck",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Joint reaction forces",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "second metatarsal experiences more stress during gait",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most commonly metatarsal to have a stress fracture",
                  "table": null,
                  "images": [],
