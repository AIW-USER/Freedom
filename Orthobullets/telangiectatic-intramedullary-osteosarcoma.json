          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indicated in all cases to determine soft tissue involvement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fluid-fluid levels",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8017/images/Case%20C%20-%20distal%20femur%20-%20mri%20ax%20-%20Parsons_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "extensive edema in surrounding tissue",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8017/images/Case%20C%20-%20distal%20femur%20-%20mri%20sag%20-%20Parsons_moved.jpg",
