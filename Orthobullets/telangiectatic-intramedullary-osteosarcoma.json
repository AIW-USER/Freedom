                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "characterized by",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "high grade sarcoma with mitotic figures is seen in intervening cellular areas",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**lakes of blood mixed with malignant cells** (not in ABC)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8017/images/Histology%20A%20-%20Parsons_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**not as much osteoid** as intramedullary osteosarcoma",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8017/images/Histology%20B%20-%20Parsons_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "histology is critical to differentiate from ABC",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Gross pathology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will show \"bag of blood\"",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "ABC",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis needs to be confirmed by an **experienced musculoskeletal pathologist**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "differentiating ABC from telangietic osteosarcoma is **difficult and critical**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "both have similar radiographic appearance",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "both have large blood filled spaces",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "both have similar location (proximal humerus, proximal femur, distal femur, proximal tibia)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "ABC vs Telangiectatic Osteosarcoma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
