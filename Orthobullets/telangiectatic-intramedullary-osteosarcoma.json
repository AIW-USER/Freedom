              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8017/images/Case%20C%20-%20distal%20femur%20-%20bone%20scan%20-%20Parsons_moved.jpg",
                  "caption": ""
                }
              ],
