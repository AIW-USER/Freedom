{
  "title": "Pre-Participation Physical Exam in Athlete",
  "url": "https://www.orthobullets.com/knee-and-sports/3119/pre-participation-physical-exam-in-athlete",
  "subtitle": "Updated: Dec 24 2022",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "AAOS, AOSSM, AFP, and AAP have collaborated to form the \"Preparticipation Physical Examination Task Force\"",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Goal is to identify conditions that may predispose an athlete to injury or illness.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often is the only medical encounter for adolescent athletes that don't have routine physician check-ups",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Should be performed in all athletes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Legal necessity for high school and collegiate participation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Orthopaedic **history and questionnaire most useful** tool for identifying musculoskeletal problems",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "identifies 75% of problems",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "should include complete list of current and past illnesses and injuries along with prior treatments",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "all current OTC and prescription medications and supplements should be listed",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "family history and past symptoms are paramount for identifying potentially lethal conditions",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "document instances of only a solitary remaining organ in a paired-organ system (e.g., single kidney, single enucleation).",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Physical examination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "height, weight, and body mass index (BMI) , vital signs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "visual acuity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lung exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "musculoskeletal exam with focus on regions of prior injury or surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "male genital examination for inguinal hernia, testicular mass, and undescended testis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "scoliotic curve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "EKG's, urinalysis, CBC, ferritin, or chest radiographs presently not indicated for routine screening in the USA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "athletes are then assigned one of the following:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "clearance without restriction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cleared with further evaluation recommended",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cleared with restrictions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "not cleared for participation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Examination Red flags",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Exertional dizziness",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diastolic murmurs, systolic murmurs (grade 3 or greater)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Cardiac murmur worse with valsalva (may indicate HOCM)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "History of transient quadaplegia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Illegal supplement use",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Heat-related illness",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Hypertension (> 140/90)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Female athleteic triad in females",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may manifest as stress fracture, amenorrhea, or anorexia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Cardiac Screening",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hypertrophic cardiomyopathy, sudden death, murmurs, marfan syndrome, long QT syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "athletes who suffer a sudden cardiac death most commonly have no history of prodromal symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "exertional symptoms with activity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may include dyspnea, angina, dizziness, palpitations",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "cardiac murmur that increases with valsalva indicates hypertrophic cardiomyopathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "participation contraindicated with outflow obstruction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Neurologic Screening",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "concussions, loss of consciousness, seizures, transient quadriplegia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neuropsychiatric testing at baseline is encouraged to serve as comparative data post-head injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
