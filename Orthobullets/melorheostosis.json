{
  "title": "Melorheostosis",
  "url": "https://www.orthobullets.com/pathology/8043/melorheostosis",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Melorheostosis is a rare benign painful disorder of the extremities characterized by formation of periosteal new bone. Patients typically present in the first 4 decades of life with localized pain and reduced range of motion.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with a \"dripping candle wax” appearance with dense hyperostosis that flows along the cortex of the bone.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is observation and medical management for those with mild symptoms and normal joint motion. Surgical bone resection and contracture release is indicated for those with severe symptoms and joint contractures.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually presents before age 40",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no sex predilection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in the lower extremities, but can occur in any bones",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8043/images/300px-melorheostosis-002%20ulna.jpg",
                  "caption": "Melorheostosis of the ulna"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "non-hereditary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**reduced range of motion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**joint contractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fibrosis of the skin with significant induration and erythema is common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reduced range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "painful hyperostoses",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cortical hyperostosis**",
              "table": null,
              "images": [
