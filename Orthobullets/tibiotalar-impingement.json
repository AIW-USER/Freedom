              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain in anterior ankle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain with forced dorsiflexion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**limited dorsiflexion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "soft tissue swelling and effusion may be evident",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "subtalar joint is pain free",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
