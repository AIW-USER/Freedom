    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "therapy, lifestyle modifications, NSAIDS",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "corticosteroid injections",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "help with soft tissue impingement and synovitis-related pain",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthroscopic excision",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "nonoperative modalities fail",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Arthroscopic excision**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "supine position with external traction device and leg over a padded bump",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "use knife to only cut the skin and use hemostat to spread to avoid neurovascular injury while making portals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "ensure adequate field of view prior to burring or shaving anterior distal tibia to avoid iatrogenic dorsal NV bundle injury",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Superficial peroneal nerve injury during anterolateral portal creation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Saphenous vein injury during anteromedial portal creation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Dorsal neurovascular bundle injury during tibiotalar spur removal",
          "table": null,
