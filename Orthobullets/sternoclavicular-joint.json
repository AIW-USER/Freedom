{
  "title": "Sternoclavicular Joint",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3034/sternoclavicular-joint",
  "subtitle": "Updated: Jun 3 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diarthrodial saddle joint incongruous (~50% contact)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fibrocartilage (not synovial cartilage)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "contains an **intra-articular disc**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Motion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "elevation of arm to 90° leads to rotation of the sternoclavicular joint of 30°",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "best assessed radiographically by **Serendipity view**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3034/images/serendipity%20view2.jpg",
                  "caption": "Serendipity view"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "involves 40° cephalic tilt view of sternum and clavicle",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3034/images/serendipity%20view.jpg",
                      "caption": "serendiity illustration"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "CT scan is most sensitive and specific",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3034/images/ct%20scan.jpg",
                      "caption": "CT scan"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Stabilizing Ligaments of Sternoclavicular Joint",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Posterior sternoclavicular capsular ligament",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**primary restraint for anterior-posterior stability**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Anterior sternoclavicular ligament",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary restraint to superior displacement of medial clavicle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Costoclavicular (rhomboid) ligament",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anterior fasciculus resists superior rotation and lateral displacement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior fasciculus resists inferior rotation and medial displacement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Intra-articular disk ligament",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**prevents medial displacement of clavicle**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "secondary restraint to superior clavicle displacement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Medial Clavicle Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Clavicle is the first bone to begin the ossification process**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**ossifies between 5th and 6th weeks of gestation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Clavicle is the last bone to complete the ossification process",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**medial epiphysis of clavicle is last physis to close at 20-25 yrs**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Important to distinguish SC dislocations from physeal fractures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most injuries at this location involve the **medial clavicular physis before age of 25**",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
