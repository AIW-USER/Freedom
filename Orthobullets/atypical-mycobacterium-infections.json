{
  "title": "Atypical Mycobacterium Infections",
  "url": "https://www.orthobullets.com/hand/6107/atypical-mycobacterium-infections",
  "subtitle": "Updated: May 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Atypical Mycobacterial Infections of the hand are rare hand infections that are most commonly caused by M. marinum.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made by clinical examination with presence papules, ulcers, and nodules and confirmed with cultures (Lowenstein-Jensen culture agar).",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment of early disease is oral antibiotics (antimycobacterials).",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "0.05 per 100,000 annually",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often found in marine workers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hand and wrist** are involved in 50% of cases",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**immunocompromised host**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incubation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "average incubation period is two weeks, but can be up to six months",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "average time to diagnosis and appropriate treatment is more than 1 year",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "organisms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "widely encountered in the environment, but rarely cause human pathology",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "M. marinum",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "**most common atypical mycobacterium infection**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "more common in stagnant fresh or salt water (aquariums)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "M kansasii",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "found in soil",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "M terrae",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "found in soil",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "M. avium intracellulare",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "most common in terminal AIDS patients, but can occur in non-HIV patients",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cutaneous rash with discomfort",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**papules, ulcers, and nodules** are common, especially on the hands",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6107/images/322e35f2-ea13-4452-b0f1-2bd3b22490b6_mycobacterium_infection..jpg",
                  "caption": "Mycobacterium infection"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6107/images/dc5f192a-717c-4d2a-a1cb-19a393410d89_mycobacterium_..jpg",
                  "caption": "Mycobacterium infection 2"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "many times presents with a single nodule that may ultimately spread to the lymph nodes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "indistinguishable from tuberculous mycobacterial infection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "granulomas may or may not demonstrate **acid-fast bacilli on AFB stain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Cultures and sensitivities are key to diagnosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**Lowenstein-Jensen culture agar**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**M. marinum incubated specifically at 30 to 32° C**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6107/images/m.%20marinum%20culture.jpg",
                      "caption": "Image of Lowenstein-Jensen Agar growing M. Marinum"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "M. avium intracellulare incubated at room temperature",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Herpetic Whitlow",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Fungal infections",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Psoriasis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Clinical and culture-based",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination and confirmed with a positive cultures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral antibiotics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "if diagnosed at early stage",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**ethambutol, tetraycline, trimethoprim-sulfamethoxazole, clarithromycin, azithromycin**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "add **rifampin** if osteomyelitis present",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical debridement + oral antibiotics in combination for 3 to 6 months",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "later stage disease",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "use a combination of above medications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Natural history",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early presentation includes papules, nodules, and ulcers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "late presentation may have progressed to tenosynovitis, septic arthritis, or osteomyelitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Morbidity & mortality",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mortality rate with presence of sepsis is 32%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
