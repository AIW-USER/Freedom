{
  "title": "Spinal Cord Anatomy",
  "url": "https://www.orthobullets.com/spine/2004/spinal-cord-anatomy",
  "subtitle": "Updated: Jul 30 2024",
  "sections": [
    {
      "text": "Nervous System Overview",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nervous system",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**central nervous system**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "brain",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "spinal cord",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "spinal cord ends at L3 at birth and L1 at maturity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**peripheral nervous system**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cranial nerves",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "peripheral nerves",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**autonomic nervous system**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**sympathetic system**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "a total of 22 ganglia (3 cervical, 11 thoracic, 4 lumbar, and 4 sacral)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "cervical ganglia",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "the three cervical ganglia include the stellate, **middle**, and superior",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "the middle ganglion is most at risk at the level of C6, where it lies close to the medial border of the longus colli",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                },
                                {
                                  "text": "injury to the middle ganglion/sympathetic chain can lead to Horner's syndrome",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**parasympathetic nervous system**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "hypogastric plexus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "formed by S2, S3, and S4 parasympathetic fibers and lumbar sympathetic fibers (splanchnic nerves)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Spinal Cord Overview",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Spinal cord extends from the brainstem to the inferior border of L1",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**conus medullaris**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "termination of the spinal cord",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**filum terminale**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "residual fragment of spinal cord that extends from the conus medullaris to the sacrum",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**thecal sac**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "dura-surrounded sac that extends from the spinal cord and contains cerebrospinal fluid, nerve roots, and the cauda equina",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**cauda equina**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "nerve roots and filum terminale that extend from the spinal cord and are surrounded by dura",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Embryology of the spinal cord",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Neural tube",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "becomes the spinal cord",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "formed from the primitive streak → turns into the primitive (midsagittal) groove → turns into the neural tube",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "failure of neural tube closure leads to:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anencephaly if it fails to close cranially",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "spina bifida occulta, meningocele, or myelomeningocele if it fails to close distally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Neural crest",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**forms dorsal to the neural tube**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "becomes:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "peripheral nervous system",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pia mater",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "spinal ganglia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "sympathetic trunk",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Notochord",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**forms ventral to the neural tube**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "becomes:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "vertebral bodies",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intervertebral discs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "nucleus pulposus (forms from cells of the notochord)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "annulus (forms from sclerotomal cells associated with resegmentation)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Layers of the spinal cord",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Layers of the spinal cord include:",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2004/images/pia%20mater.jpg",
              "caption": "Shows layers of spinal cord"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "**dura mater** (outermost)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**arachnoid**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**pia mater** (innermost)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Spinal Cord Functional Tracts",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ascending tracts (sensory)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2004/images/ascending%20tracts.jpg",
              "caption": ""
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "**dorsal columns (posterior funiculi)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "deep touch, proprioception, vibration",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral spinothalamic tract**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "pain and temperature",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "site of chordotomy to alleviate intractable pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**ventral spinothalamic tract**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "light touch",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Descending tracts (motor)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2004/images/descending%20tracts.jpg",
              "caption": ""
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "**lateral corticospinal tract**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "main voluntary motor",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "upper extremity motor pathways are more medial (central), which explains why a central cord injury affects the upper extremities more than the lower extremities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**ventral corticospinal tract**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "voluntary motor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Spinal cord blood supply provided by:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**anterior spinal artery**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "primary blood supply to the anterior 2/3 of spinal cord, including both the lateral corticospinal tract and ventral corticospinal tract",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**posterior spinal arteries (right and left)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "primary blood supply to the dorsal sensory columns",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Artery of Adamkiewicz**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2004/images/artery%20of%20adamkiewicz.jpg",
                  "caption": "Shows Artery of Adamkiewicz"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "the largest anterior segmental artery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "typically arises from left posterior intercostal artery (which branches from the aorta) and supplies the lower two thirds of the spinal cord via the anterior spinal artery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "significant variation exists",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "originates on the left side between the T8 and L1 vertebral segments in 75%",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Cerebrospinal Fluid (CSF)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a colorless fluid that occupies the **subarachnoid space** surrounding the brain, spinal cord, and ventricular system",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the subarachnoid space is between the arachnoid mater and pia mater",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "provides **mechanical and immunological protection** for the brain, spinal cord, and thecal sac",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Production",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most human CSF is produced by the **choroid plexus in the third, fourth, and lateral ventricles** of the brain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "CSF is an ultrafiltrate of blood plasma through the permeable capillaries of the choroid plexus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "volume",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "total CSF volume between brain, spinal cord, and thecal sac is ~150 mL",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "CSF formation occurs at rate of **~500 mL per day**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "thus, the total amount of CSF is turned over **3-4 times per day**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Nerve Root Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**nerve roots exit above the corresponding pedicle**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "C5 nerve root exits above the C5 pedicle",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**nerve roots travel horizontally to exit**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**there is an extra C8 nerve root**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "does not have a corresponding vertebral body",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Thoracic spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nerve roots travel **below the corresponding pedicle**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "T1 exits below T1 pedicle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "T12 exits below T12 pedicle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Lumbar spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nerve roots **descend vertically** before exiting",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "nerve roots travel **below the corresponding pedicle**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "L1 exits below L1 pedicle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "L5 exits below L5 pedicle",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "intrathecal anatomy",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "exiting (cranial) nerve roots are located more ventrally",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "motor fibers are located more ventrally than sensory fibers",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
