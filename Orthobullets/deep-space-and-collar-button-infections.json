  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Deep space infections**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**defined as infections of the**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**thenar space**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most commonly infected",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**hypothenar space**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**midpalmar space**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "rare",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Collar button abscess",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "an abscess that occurs in the web space between fingers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Thenar space",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6106/images/thenar%20space.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/6106/images/deep%20spaces.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "a bursa (potential space) just palmar to adductor pollicis and dorsal to flexor tendons",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "separated from midpalmar potential space by a fascial septum",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Midpalmar space",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6106/images/midpalmar.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "located dorsal and radial to hypothenar space",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Hypothenar space",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6106/images/hypothenar.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "located palmar to fifth metacarpal, dorsal and radial to hypothenar fascia, ulnar to hypothenar septum",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may or may not have penetrating trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain with flexion of fingers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "thenar",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "pain with thumb flexion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hypothenar",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "pain with small finger flexion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "midpalmar",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "pain with middle, ring, and small finger flexion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "thenar and midpalmar spaces",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often have loss of palmar concavity secondary to swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
