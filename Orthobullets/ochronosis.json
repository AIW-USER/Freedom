{
  "title": "Ochronosis",
  "url": "https://www.orthobullets.com/basic-science/9046/ochronosis",
  "subtitle": "Updated: Dec 26 2023",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ochronosis is a metabolic arthropathy caused by alkaptonuria with excess homogentistic acid deposited in the joints. Patients present with early degenerative joint disease, spondylitis, and black urine.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with detection of homogentisic acid in urine.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is similar to that of osteoarthritis with observation, NSAIDs, tramadol and corticosteroids for mild to moderate symptoms. Arthroplasty is indicated for severe symptoms.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "excess homogentistic acid is deposited in the joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "acid polymerizes in joint and leads to early joint arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare inborn defect in homogentisic acid oxidase enzyme system",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**ochronotic spondylitis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "commonly occurs in fourth decade",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "progressive degenerative changes in spine",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "**calcification**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**narrowing of disc spaces**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
