{
  "title": "Fibrosarcoma of Soft Tissue",
  "url": "https://www.orthobullets.com/pathology/8065/fibrosarcoma-of-soft-tissue",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fibrosarcoma of Soft tissue is a malignant fibrogenic tumor that occurs in patients between 55-80 years of age.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing spindle-shaped cells with scant cytoplasm and indistinct borders with tissue that is organized in herringbone fashion.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually wide local resection with radiation",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Symptoms",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**usually and enlarging painless mass**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "usually symptoms develop after mass reaches ten cm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiograph",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "are usually normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shows deep seated inhomogeneous mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Classic characteristics are",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "fasiculated growth pattern",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**spindle-shaped cells** with scant cytoplasm and indistinct borders",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "cells separated by **interwoven collagen fibers**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "tissue may be organized in **herringbone fashion**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wide local resection with perioperative radiation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "radiation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "add **radiation if tumor is > 5 cm** (5000 cGy before resection and 2000 cGy after resection)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "local adjuvant treatment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "may do local adjuvant treatment with phenol or cryotherapy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
