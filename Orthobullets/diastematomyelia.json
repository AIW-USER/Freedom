{
  "title": "Diastematomyelia",
  "url": "https://www.orthobullets.com/spine/2062/diastematomyelia",
  "subtitle": "Updated: Jun 24 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diastematomyelia is a congenital spinal condition caused by a fibrous, cartilaginous, or osseous bar creating a longitudinal cleft in the spinal cord.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a prenatal ultrasound in the 3rd trimester.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is observation if patient is asymptomatic. Surgical resection is indicated if patient is symptomatic or has neurological deficits.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically presents in childhood",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "adult presentation is rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in lumbar spine (L1 to L3)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a congenital anomaly believed to be caused by **persistence of neuroenteric canal**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "present during 3rd and 4th week of gestation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "leads to sagittal division of the spinal cord or cauda equina",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "if the cord does not reunite distally to the spur, it is considered a diplomyelia (true duplication of the cord)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "congenital scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "as high as 79% in some series",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "tethering of cord",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "muscle atrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bladder or bowel incontinence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sensory loss",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reflex asymmetry",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "spinal cutaneous manifestations (>50% of patients)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hairy patch (hypertrichosis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "dimple",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "subcutaneous mass",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "teratoma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lower extremity deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cavus foot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "club foot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "claw toes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prenatal ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be diagnosed in utero, during the third trimester",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "interpedicular widening is suggestive",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2062/images/ap_x-ray_diastematomyelia.jpg",
                  "caption": "AP x-ray demonstrating diastematomyelia"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "helpful to delineate bony anatomy",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2062/images/ct.jpg",
                  "caption": "Shows diastomyelia"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Myelography",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2062/images/myelogram_diastematomyelia.jpg",
              "caption": "Myelogram demonstrating Diastematomyelia at L4"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "spurs are often undetectable by plain radiographs or CT, especially if they are fibrous or there is rotation from concomitant scoliosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "myelography is a useful adjuvant",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "required to evaluate degree of neurologic compression",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2062/images/t2%20mri.jpg",
                  "caption": "shows diastomyelia"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation alone",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may be observed if patient is asymptomatic and does not have neurologic sequelae",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "must watch closely for progressive neurological deterioration",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical resection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "surgery is indicated if patient is symptomatic or has neurologic deficits",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "must resect diastematomyelia **before correction** of spine deformity",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "must resect and repair the duplicated dural sac",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
