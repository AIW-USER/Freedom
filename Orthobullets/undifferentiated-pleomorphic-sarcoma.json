                  "children": [
                    {
                      "text": "pleomorphic (80-85%)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/8064/images/ups_low_power.jpg",
                          "caption": "UPS Low Power"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/8064/images/ups_high_power_2.jpg",
                          "caption": "UPS high magnification 2"
