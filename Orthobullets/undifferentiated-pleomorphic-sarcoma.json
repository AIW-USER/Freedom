                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "maintain meticulous hemostasis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "meticulous dissection to ensure wide margins, must confirm border free of disease with histology",
