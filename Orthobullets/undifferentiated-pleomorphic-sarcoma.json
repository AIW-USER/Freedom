    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Biopsy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "longitudinal incision",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "transverse incisions are contraindicated due to a need for wider resection at time of surgery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "use anatomic route that limits contamination of compartments and neurovascular structures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "maintain meticulous hemostasis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "use knife or curette to remove tissue",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "drains should be placed **distal** and **in line** with the surgical incision to allow removal of drain site with extensile incision",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Wide resection & radiation therapy**",
