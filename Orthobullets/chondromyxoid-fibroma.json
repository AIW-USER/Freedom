{
  "title": "Chondromyxoid Fibroma",
  "url": "https://www.orthobullets.com/pathology/8022/chondromyxoid-fibroma",
  "subtitle": "Updated: Aug 12 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Chondromyxoid Fibromas are rare, benign, chondrogenic lesions characterized by variable amounts of chondroid, fibromatoid, and myxoid elements that are most commonly found in the metaphysis of long bones. Patients typically present between the ages of 10 and 30 with regional pain and swelling.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with biopsy showing hypercellular area with lobules of fibromyxoid tissue and myxoid stroma with stellate cells.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually intralesional curettage and bone grafting (or PMMA).",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in **males**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "most common in second and third decades of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may affect patients up to 75 years old",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "long bones (ie. tibia, distal femur)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often affects metaphyseal (proximal tibia) regions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pelvis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "feet or hands",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may arise from physeal remnants",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mutations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "a genetic rearrangement may affect **chromosome 6 (postion q13)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**long standing pain (months to years)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**may be incidentally identified**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain and mild swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**lytic, eccentric metaphyseal lesion**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8022/images/Case%20D%20-%20tibia%20-%20xray%20b%20-Parsons_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "sharply demarcated from adjacent bone",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "scalloped and sclerotic rim",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "calcifications are rare",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "cortical expansion may be seen",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "lesion size may range from two to ten centimeters",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8022/images/mricmfcoronal.jpg",
                  "caption": "CMF"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/8022/images/mricmfaxial.jpg",
                  "caption": "CMF"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "low signal on T1-weighted images",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "high signal on T2-weighted images",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increased signal uptake will be seen",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8022/images/bonescancmf.jpg",
                      "caption": "Chondromyxoid Fibroma"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**findings**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**low-power**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**biphasic appearance**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**hypercellular area with** lobules of fibromyxoid tissue",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/8022/images/Histology%20C%20-%20high%20power_moved.png",
                              "caption": ""
                            }
                          ],
                          "importance": "5",
                          "children": [
                            {
                              "text": "spindle-shaped cells or stellate-shaped cells",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": [
                                {
                                  "text": "the cells contain hyperchromatic nuclei",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                },
                                {
                                  "text": "multinucleated giant cells and fibrovascular tissue are located between lobules",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "text": "hypocellular area with chondroid material",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "high power",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "myxoid stroma with **stellate cells**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/8022/images/Stellate%20cells_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "regions of pleiomorphic cells with bizarre nuclei may be seen",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Diagnostic criteria",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "histopathologic examination is mandatory for confirmation of the diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
