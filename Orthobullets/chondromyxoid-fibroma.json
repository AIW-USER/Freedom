    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Recurrence**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "occurs in 25% of cases",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Natural history",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recurrence in CMF is not uncommon",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may occur in 20-30% of cases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Negative prognostic variables",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "children",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tumor is more lobulated with abundant myxoid material",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Metastasis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**has not been reported**",
              "table": null,
              "images": [],
