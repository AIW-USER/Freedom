{
  "title": "Leg Nerve Entrapment Syndromes",
  "url": "https://www.orthobullets.com/foot-and-ankle/7044/leg-nerve-entrapment-syndromes",
  "subtitle": "Updated: Feb 13 2026",
  "sections": [
    {
      "text": "Ilioinguinal nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Can be caused by hypertrophied abdominal muscles as a result of intensive training",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Hyperesthesia is common",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Pain worse with hyperextension of hip",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgical release",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "failure of nonoperative management",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Obturator nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Found in patients with well-developed hip adductors (skaters)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Can cause chronic medial thigh pain",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "**Nerve conductions** studies help establish diagnosis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "supportive",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Lateral femoral cutaneous nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Can lead to pain on lateral aspect of proximal leg",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**meralgia paresthetica**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Exacerbated by tight belts and prolonged hip flexion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "PT, NSAIDS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "postural exercises",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "release of compressive devices",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Sciatic nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Can occur anywhere along the course of the nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Most common locations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "at level of ischial tuberosity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "at the piriformis muscle (**piriformis syndrome**)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Saphenous neuritis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Compression of the saphenous nerve, usually at Hunter's canal",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "also known as **surfer's neuropathy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Caused by kneeling for long periods of time",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain inferior and medial to knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "knee pads",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "first line of treatment",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Common peroneal nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Can be compressed behind fibula by a ganglion cyst or injured by a direct blow",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Fusion of the proximal tibiofibular joint may be needed to prevent cyst recurrence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Superficial peroneal nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Due to a fascial defect",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually ~ 12 cm proximal to lateral malleolus where it exits the fascia of the anterolateral leg",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanisms include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inversion injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fascial defect",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "numbness and tingling over dorsum of foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "worsens with plantar flexion and inversion of foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "usually preferred treatment",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fascial release",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "may be indicated in refractory cases or for elite athletes",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Deep peroneal nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Can be caused by inferior extensor retinaculum",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Also known as anterior tarsal syndrome",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Posterior tibial nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Also known as Tarsal Tunnel syndrome",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    },
    {
      "text": "Lateral plantar nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Caused by compression of the first branch of the lateral plantar nerve, also known as **Baxter nerve** (branch to the abductor digiti quinti)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7044/images/trifurcation%20of%20ptn.jpg",
              "caption": "Shows lateral plantar nerve"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "common nerve entrapment in the running athlete",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "becomes compressed between fascia of **abductor hallucis longus and medial side of quadratus plantae**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgical release of abductor hallucis fascia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Medial plantar nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Compression of medial plantar nerve at point where FDL and FHL cross (Knot of Henry)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "also known as **Jogger's foot**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Most common cause of compression is foot orthotics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "discontinue foot orthosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Sural nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Can occur anywhere along the course of the nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Most vulnerable 12-15mm distal to the tip of the fibula as the foot rests in equinus position",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgical release",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Interdigital neuroma",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Also known as Morton's neuroma",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
  "gallery": [
    {
      "src": "https://upload.orthobullets.com/topic/7044/images/trifurcation%20of%20ptn.jpg",
      "caption": ""
    }
  ],
