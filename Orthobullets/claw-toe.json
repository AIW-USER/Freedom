    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain at the level of the unstable MTP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**metatarsalgia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection & palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**claw-type deformity** of the toe is present",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**depressed metatarsal head** with **callus** formation and tenderness",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "flexed IP joints with callosities and tenderness",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7013/images/claw%20toe.jpg",
                      "caption": "Shows claw toe deformity."
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "taping and shoe modification",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "provide adequate plantar padding using metatarsal and/or crest pads or orthotics to offload plantarly-subluxed metatarsal heads",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "wear a shoe with a high toe box",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "use a sling to hold the proximal phalanx parallel to the ground",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "EDB tenotomy, EDL lengthening, FDL flexor-to-extensor transfer (Girdlestone)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "painful, **flexible deformities** without contractures",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "ulcerations caused by shoe wear",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Girdlestone (above), MTP capsulectomy, and proximal phalanx head and neck resection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**fixed contracture**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Girdlestone and distal MT shortening osteotomy (Weil lesser MT osteotomy)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7013/images/weil%20osteotomy.jpg",
                  "caption": "Shows a Weil osteotomy."
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**claw toe deformity of all four lesser toes**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "oblique shortening osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "translates metatarsal head proximal and plantar",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Isolated FDL tenotomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "flexible deformity in a diabetic patient with tip-of-toe ulceration without evidence of infection",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Floating toe**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**most common complication of a Weil osteotomy**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**caused by intrinsics migrating dorsal to the joint and acting as MTP extensors**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Recurrence**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "caused by persistent plantar plate dysfunction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
