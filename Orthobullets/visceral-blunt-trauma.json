  "subtitle": "Updated: Jun 2 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Injuries include (specifics below)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**abdominal wall injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**spleen injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**liver injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**kidney injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**testicular and penile injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contact sports and direct blows are risk factors for visceral injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "deceleration pattern of injury is more likely to cause injury to the spleen, liver, or kidney",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Diaphragmatic Spasm",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Commonly known as \"wind knocked out\"",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by a direct blow to epigastrium causing diaphragmatic spasm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "resolves spontaneously",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may continue play",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Abdominal Wall Injury / Rectus Sheath Hematoma",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "injury to epigastric or intramuscular vessels",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute pain in a localized area is usually a sign of abdominal wall injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "symptoms mimic surgical abdomen with nausea and vomiting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain with active trunk flexion or rotation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis can be made with CT",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3123/images/rectus%20sheath%20hematoma.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ice and rest",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "most cases",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgery decompression",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "required if persistent progression and pain",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Spleen Injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "the most common organ injured in the abdomen as the result of blunt trauma",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**most common cause of death** because of an abdominal injury",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "increased risk with splenomegaly after infectious mononucleosis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nausea and vomiting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sharp LUQ pain that becomes dull after a time and more diffuse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "localized pain that progresses to diffuse pain is concerning for visceral injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis can be made with CT",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3123/images/splenomegaly.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "clinical observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indicated in most cases",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "splenectomy",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indicated only in severe injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Liver Injury",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "the liver is the second most commonly injured organ.",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms include right upper quadrant pain that may radiate to right shoulder",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis can be made with CT",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3123/images/liver%20injury.jpg",
                  "caption": ""
                }
              ],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "conservative treatment with monitoring and rest",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Kidney Injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "more common in contact athletes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "usually occurs with blunt abdominal trauma to flank",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "look / ask for hematuria",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis can be made with CT",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3123/images/renal%20lac.jpg",
                  "caption": ""
                }
              ],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "urgent surgery",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "extensive bleeding with renal fx or vascular pedicle injury",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Penile & Testicular Injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pudendal nerve neuropraxia",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "introduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "common in **bicyclists**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "presentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "causes penile shaft numbness",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "nonoperative",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "seat modifications",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Testicular Injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "introduction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mechanism is usually a kick",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "leads to rupture of tunica albuginea (outer covering)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "causes a hematocoele",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3123/images/hematocoele.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "presentation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "painful firm scrotal mass that does not transilluminate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ultrasound by urology",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
