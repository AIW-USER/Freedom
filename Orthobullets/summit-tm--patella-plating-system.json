          "text": "**Locking Drill Guide**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Locking drill guide with set angle",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**T8 Driver Shaft**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "AO Quick Connect T8 driver shaft",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**1.8 mm Drill**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "1.8 mm AO Quick Connect solid drill bit",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Olive Wire**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Provides provisional fixation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**1.6 mm K-Wire**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Provides provisional fixation and fracture reduction",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**T8 Driver**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Driver with handle",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**VA Cone Drill Guide**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Allows for drilling up to 15° off axis in any direction",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Locking Screws**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "2.4 mm locking screws available in 12 mm*, 14 mm, 16 mm, and 18 mm* lengths",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Patella Plate**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Patella-specific plate design with integrated sutures, available in small and standard sizes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Sutures**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "A single #2 suture for the quadriceps tendon and two #2 sutures for the patella ligament",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Plate placement",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The appropriate size plate is then placed over the fracture on the dorsal surface of the patella allowing for the superior arms to be above the fracture and the inferior arms to be below the fracture.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The arrow etched on the plate should point towards the patient’s head.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The plate is then provisionally held to the dorsal surface on both sides of the fracture with olive wires.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "It’s recommended to place olive wires in a more central hole on each side of the fracture.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "C-arm imaging can be used to confirm adequate size of the plate and good position on the AP and lateral images.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Technical specifications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Standard Plate: Length: 30.5 mm Width: 29.1 mm Thickness: 1.25 mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Small Plate: Length: 26 mm Width: 25 mm Thickness: 1.4 mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    }
  ],
