                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nerve palsy** (1-5%)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "greatest risks for nerve palsy",
              "table": null,
