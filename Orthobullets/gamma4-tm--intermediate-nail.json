    },
    {
      "text": "Gamma4 Design",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Intermediate Nail**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "The Gamma4 Intermediate Nail is 240mm long and has a 4º ML bend and 3º AP bend.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423218/images/9db49a25-f997-4728-89ea-90167af526bf_screenshot_2025-01-14_at_4.24.12_pm.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Diameter options include 9,10,11,12 and 13mm.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "It is offered in CCD Angles 120, 125, and 130 Degrees.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "The shaft has a length dependent radius of curvature of approximately 750mm. Therefore, this nail is side specific.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Shortened Proximal Body**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Proximal diameter of Ø15.5mm",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "The distance from the proximal tip of the nail to the Lag Screw has been reduced by 5mm compared to the legacy system. A bevel was added as well for less trochanteric protrusion.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Optional end caps available",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**AP Bevel for Nail Insertion**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "AP bevel added to the distal tip of the nail to ease insertion into the canal.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Distal Locking",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Option for two distal locking holes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Targeted distal locking similar to the short trochanteric nail",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The Gamma4 Intermediate nail is indicated for the treatment of stable and unstable fractures as well as for stabilization of bones and correction of bone deformities in the intracapsular and trochanteric regions of the femur (including osteoporotic and osteopenic bone).",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The RC Lag Screw is also indicated for rotationally unstable fractures. The RC lag screw is a combination between a standard lag screw and a blade, increasing the surface area of the lag screw by up to 2.4mm.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
