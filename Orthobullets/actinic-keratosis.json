{
  "title": "Actinic Keratosis",
  "url": "https://www.orthobullets.com/pathology/12760/actinic-keratosis",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Actinic Keratosis is an epidermal pre-malignant lesion caused by sun exposure that may predispose to squamous cell carcinoma of the skin.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing hyperkeratotic cells and lower epithelial cells showing loss of polarity and hyperchromatic nuclei",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually cryotherapy.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common in **fair-skinned individuals**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "common in **elderly** patients",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "results from significant lifetime **sun exposure**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "keratinocyte damage",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may lead to **squamous cell carcinoma**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "occasionally tender",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thin, adherent **transparent or yellow scale that progressively increases in thickness**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**often with telangiectasias**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "can progress to cutaneous horn",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "difficult to distinguish from squamous cell carcinoma at this point",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "rough, “sand-paper” texture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often easier to **detect by palpation** rather than observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "frequently on sun-exposed areas",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "face, head, neck, dorsal hands, ears",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Skin biopsy**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "dysplastic epidermis with keratinocyte atypia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "hyperkeratotic cell with lower epithelial cells showing loss of polarity and hyperchromatic nuclei",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**no invasion into dermis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Squamous cell carcinoma",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Actinic cheilitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Lentigo maligna",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prevention",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Annual follow-up for skin cancer monitoring",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "avoid **sun exposure**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "use sunscreen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Lifestyle modification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**avoid sun exposure**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "use sunscreen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Surgical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**liquid nitrogen (cryotherapy)** = most common treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "electrodesiccation and curettage",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pharmacological",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**topical 5-fluorouracil**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "typically reserved for those with **widespread actinic keratoses**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
