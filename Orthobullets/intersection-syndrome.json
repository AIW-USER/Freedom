{
  "title": "Intersection Syndrome",
  "url": "https://www.orthobullets.com/hand/6032/intersection-syndrome",
  "subtitle": "Updated: Feb 7 2023",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Intersection syndrome is an inflammatory condition that occurs at the crossing point of the 1st dorsal compartment (APL and EPB ) and the 2nd dorsal compartment (ECRL, ECRB).",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with pain over the dorsoradial forearm (5 cm from wrist joint) made worse with resisted wrist extension and thumb extension.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is conservative with rest, wrist splinting and steroid injections.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "< 1 per 100,000 annually",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males = females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rowing**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "skiing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "horseback riding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weight lifting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism is r**epetitive wrist extension**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "repetitive motion results in friction at the crossover junction of the 1st and 2nd dorsal compartments",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "friction leads to and inflammatory response and subsequent tenosynovitis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Extensor tendon compartments",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6032/images/extensor%20compartments_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "Compartment 1 (De Quervain's Tenosynovitis )",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "APL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "EPB",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**Compartment 2 (Intersection syndrome)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "ECRL",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "ECRB",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "Compartment 3",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "EPL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Compartment 4",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "EIP",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "EDC",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**Compartment 5 (Vaughan-Jackson Syndrome )**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "EDM",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**Compartment 6 (Snapping ECU )**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "ECU",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain over dorsal forearm and wrist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tenderness on dorsoradial forearm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "approximately **5cm proximal to the wrist joint**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "crepitus over area with **resisted wrist extension** and **thumb extension**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not required for the diagnosis or treatment of intersection syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6032/images/mri_normal.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "to confirm diagnosis when clinical findings unclear",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fluid sensitive sequences (short tau inversion recovery, STIR; fat suppressed proton density, FS PD; T2-weighted)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "most characteristic is peritendinous edema or fluid surrounding the 1st and 2nd extensor compartments",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6032/images/intersec.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "other findings - tendinosis, muscle edema, tendon thickening, loss of the normal comma shape of the tendon, and juxtacortical edema may also be seen",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "De Quervain's tenosynovitis",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Wartenberg's syndrome",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, wrist splinting, **steroid injections**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "injection aimed into **2nd dorsal compartment** (ECRL, ECRB)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**surgical debridement and release**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "rarely indicated in recalcitrant cases",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "release of the 2nd dorsal compartment approximately 6 cm proximal to radial styloid",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
