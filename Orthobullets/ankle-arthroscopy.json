{
  "title": "Ankle Arthroscopy",
  "url": "https://www.orthobullets.com/foot-and-ankle/7007/ankle-arthroscopy",
  "subtitle": "Updated: Jul 27 2023",
  "sections": [
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**osteochondral lesions** of the talus",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "microfracture of OCD",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "debridement of post-traumatic synovitis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**ATFL anterolateral impingement**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**AITFL anterolateral impingement**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "resection of anterior tibiotalar spurs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "such as **anterior bony impingement**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "os trigonum excision",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "removal of loose bodies",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "cartilage debridement in conjunction with ankle fusions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Positioning and Scope insertion",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Position",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patient placed supine",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7007/images/topic%20image.jpg",
                  "caption": "topic image"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "leg over well padded bolster",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Tourniquet",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "place tourniquet and exsanguinate limb",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Joint distention",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**external traction device applied to distract tibiotalar joint**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7007/images/traction.jpg",
                  "caption": "Ankle traction"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "can load joint with saline to distend joint",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7007/images/saline.jpg",
                  "caption": "saline"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Scope insertion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**nick and spread method** commonly utilized to access joint and minimize neurovascular injury",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Portals",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anteromedial",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7007/images/anterior%20portals.jpg",
              "caption": "Anterior portals"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "primary viewing portal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "typically established first",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "access to anteromedial joint",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "medial to tibialis anterior and lateral to medial malleolus",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "make portal between tibialis anterior and saphenous vein",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anterolateral",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "primary viewing portal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "access to anterolateral joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "located just **lateral to peroneus tertius and superficial peroneal nerve and medial to lateral malleolus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "can trace out superficial peroneal nerve prior to incision",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anterocentral",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anterior viewing portal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not commonly utilized due to danger to dorsal pedis artery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "medial to EDL and lateral to EHL",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Posterolateral",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior viewing portal for access to os trigonum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "located 2cm proximal to tip of lateral malleolus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "medial to peroneal tendons and lateral to achilles tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Posteromedial",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior viewing portal for access to os trigonum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "just medial to achilles tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Synovial cutaneous fistula**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "avoid by immobilization to allow portal skin healing and closure",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Neurovascular injury from portal placement**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "neuropraxia most **common** complication",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "Anterolateral portal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "risks **superficial peroneal nerve**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**most common** neurovascular injury",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**specifically, the dorsal intermediate cutaneous branch**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Anteromedial portal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "risks **saphenous nerve and vein**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "risk of tibialis anterior tendon injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Anterocentral portal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "risks dorsalis pedis artery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Posterolateral portal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "risks **sural** nerve and short saphenous vein",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Posteromedial portal",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "risks posterior tibial artery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
