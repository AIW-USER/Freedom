{
  "title": "Bone Circulation",
  "url": "https://www.orthobullets.com/basic-science/9005/bone-circulation",
  "subtitle": "Updated: Jun 15 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bone receives 5-10% of cardiac output",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Bones that receive tenuous blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**scaphoid**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**talus**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**femoral head**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**odontoid**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply to long bone comes from three sources",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9005/images/arterial%20vascularization%20of%20long%20bone.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**nutrient artery system**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**metaphyseal-epiphyseal system**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**periosteal system**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Nutrient Artery System",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**High pressure** system that branches from major systemic arteries",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Enter the cortex through the nutrient foramen and enter the medullary canal",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "then branch into ascending and descending branches",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "then branch into arterioles and supply the **inner 2/3 of mature bone** via the haversion system",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Metaphyseal epiphyseal system",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Arteries arise from periarticular vascular plexus",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "e.g. geniculate arteries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Periosteal System",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Low pressure** system that supplies the outer 1/3 of bone",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "connected by",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "Volkman's artery (perpendicular to long axis)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Haversion system (parallel to long axis)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Intracortical Vascularization",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Intracortical** vessels travel within canals",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Primary Haversian canals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Secondary Volkmann canals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Direction of Arterial Flow",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Normal intraosseous blood flow rate is 5-20ml/min/100g of bone",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Mature bone",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flow is **centrifugal** (inside to outside)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "because of high pressure nutrient artery system and low pressure periosteal system",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Immature bone",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flow is **centripetal** (outside to inside)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "because low pressure periosteal system predominates",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Factors increasing blood flow",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hypoxia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hypercapnia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sympathectomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Direction of Venous Flow",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mature bone",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9005/images/venous%20vascularization%20of%20long%20bone.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "flow is centripetal (outside to inside)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cortical capillaries drain to venous sinusoids, which drain to the emissary venous system",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Growth Plate",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Perichondrial artery** is the major source of nutrition of the growth plate",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Pathoanatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fractures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patterns of blood flow following fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "immediate phase",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "initial **decrease** in blood flow after fracture",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "flow is **centripetal** (outside to inside)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "because high pressure nutrient artery system is disrupted",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "low pressure periosteal system predominates",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "hours to days",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**increase** in blood flow (regional acceleratory phenomenon)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "peaks at 2 weeks and returns to **normal** in 3-5 months",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Intramedullary nails",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**unreamed** intramedullary nails preserve endosteal blood supply",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**reaming** devascularizes inner 50-80% of the cortex and delays revascularization of endosteal blood supply",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**loose fitting nails** spare cortical perfusion and allow more rapid reperfusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**tight fitting nails** compromise cortical perfusion and reperfusion is slow",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
