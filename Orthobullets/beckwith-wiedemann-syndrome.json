{
  "title": "Beckwith-Wiedemann Syndrome",
  "url": "https://www.orthobullets.com/pediatrics/4110/beckwith-wiedemann-syndrome",
  "subtitle": "Updated: Sep 18 2023",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Beckwith-Wiedemann Syndrome is a congenital condition caused by a mutation in chromosome 11p15.5 that presents with hemihypertrophy, macroglossia, abdominal wall defects, and hypoglycemia.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made using physical examination and genetic testing.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to address orthopedic manifestations, abdominal abnormalities, and overgrowth.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1 in 13,700 births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1:1 male to female",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "An overgrowth syndrome characterized by spectrum of clinical manisfestations, highlighted by:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**major criteria:**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**overgrowth**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**abdominal wall defects, incl. omphalocele**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**macroglossia or large tongue**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**minor criteria**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**hemihypertrophy (10-20%)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**ear anomalies**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**neonatal hypoglycemia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**nephromegaly**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pancreatic islet cell hypertrophy causes repeated bouts of infantile hypoglycemia resulting in spasticity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sporadic in 85% of cases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "autosomal dominant with incomplete penetrance in remaining 15%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "mutation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "chromosome 11p15.5",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hemihypertrophy**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4110/images/hemihypertrophy.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "medical conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patients have a predisposition for embryonal tumors, i.e. Wilm's tumor, and should be screened with US every 3-6 months until 5-8 years of age",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
