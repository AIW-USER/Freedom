{
  "title": "Pediatric Trauma Evaluation & Management",
  "url": "https://www.orthobullets.com/pediatrics/4124/pediatric-trauma-evaluation-and-management",
  "subtitle": "Updated: Feb 23 2022",
  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Trauma is most common cause of death in children > 1 years old",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**mortality rate** is approximately 20%",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**CNS injuries** have highest overall morbidity and mortality",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**spine fractures have highest morbidity/mortality among musculoskeletal injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "cervical spine injuries more common in children <8-years-old",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "due to fact that restraints do not fit young children",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "falls and motor vehicle accidents most common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Transport",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Occipital cut-out needed in spine board when transporting children <8 y.o.",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4124/images/pediatric%20spine%20board..jpg",
              "caption": "Pediatric spine injury"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "larger head size can flex unstable cervical spine leading to injury during transport",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Help tips",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Broselow tape** = estimate medication doses, size of equipment, shock voltage for defibrillator",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**ETT** = (age/4) + 4 or (age+16)/4 = uncuffed",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**BP** = 80 + (age x 2)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**chest tube** = 4 x ETT",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**blood volume** = 75 mL/kg",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Intraosseous lines commonly needed due to difficulty obtaining venous access",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "children may remain hemodynamically stable even after significant blood loss",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "hypovolemic shock may result from inadequate fluid resuscitation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**\"triad of death\"** reflects inadequate resusitation and is characterized by:",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "acidosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "hypothermia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "coagulopathy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "ATLS with Children",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "should follow ATLS protocol",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "Airway",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Breathing",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Circulation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Disability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Exposure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Airway",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Smaller airway**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "greater risk of airway obstruction with foreign bodies",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "small amounts of swelling will result in a relatively greater reduction in airway diameter",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Larger tongue, floppy epiglottis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Larger occiput**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "flexes the head forward when placed supine on a flat surface",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "to achieve a neutral position, it may be necessary to lift the chin or place a pad under the torso of the infant (or head cut out)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Larynx is higher and more anterior**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "sits at the level of the C2-C3 vertebrae body in the young child, compared with C6-C7 in the adult.",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "positioning of the larynx makes its visualisation in the paediatric airway more difficult than in the adult.",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Breathing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Most common cause of cardiorespiratory arrest is **hypoventilation**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "**Ribs positioned more horizontally**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "with inspiration the ribs only move up, and not up-and-out, like the adult rib cage.",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "limits the capacity to increase tidal volumes",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Diaphragmatic breathing**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Fewer Type 1 fibres in respiratory muscles**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "smaller number of fatigue-resistant, Type I fibres in their respiratory muscles",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "exhaust more quickly than adults",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Respiratory rate varies with age**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "higher oxygen demand = higher respiratory rates",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Circulation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Initial bolus** = 20ml/kg NS",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**After two boluses** = 10ml/kg of PRBC’s",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Blood volume is relatively larger, but absolute volume is smaller**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "small volumes of blood will constitute significant blood loss in small children",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "example = 100ml hemorrhage experienced by a 5 kg child represents the loss of approximately 26.7% of their total blood volume assuming a blood volume of 75ml/kg",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Systemic vascular resistance is lower**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "increases from birth to adulthood",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Hypotension is a late sign**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "remain normotensive until they are losing large intravascular volumes",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "25-30% of blood volume before signs of shock",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Smaller vessels / more subcutaneous tissue**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "difficult to obtain vascular access due to small veins and increased subcutaneous tissue",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**IV access more difficult – consider intraosseus**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Disability",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Risk factors for head injury",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**Open sutures, presence of fontanelle**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**Thinner cranial bones**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "thinner cranial bones of children do not afford as much protection to the brain tissue",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**Head relatively larger**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "higher center of gravity = higher incidence of head and neck trauma",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Exposure",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Relatively small size**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "large head and organs",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Higher BMR and surface area**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "greater consumption of oxygen and other metabolites",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "higher respiratory and heart rates",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "larger surface-area to body-mass ratio results in greater heat loss",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Increased glucose requirements but decreased glycogen stores**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "higher metabolic rate",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "small glycogen stores",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pediatric Scoring Systems",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pediatric trauma score (PTS)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4124/images/pts.jpg",
              "caption": "PTS"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "PTS<0=100% mortality",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "PTS of 1-4=40% mortality",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "PTS of 5-8=7% mortality",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**PTS less than or equal to 8** should be sent to designated peds trauma center",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pediatric Galsgow Coma Scale",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4124/images/pgcs.jpg",
              "caption": "Pediatric Glasgow Coma Score"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "GCS<8 correlates with a higher rate of mortality",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "O2 sat at presentation and GCS 72hrs post-injury are both prognostic of long-term neurologic recovery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Head and neck",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Most common injury associated with all-terrain vehicle injuries is traumatic brain injury",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "ICP can be elevated by pain",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "it is possible to decrease ICP by fracture fixation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "heterotopic ossification is more common following traumatic brain injury",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**increased serum alkaline phosphatase** heralds onset of HO",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "NSAID prophylaxis is indicated in these situations",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Peripheral nerve injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common in **closed fractures**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "obtain EMG if no return of function **2-3 months after injury**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Multiorgan failure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**occurs early after admission and affects all organ systems**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
