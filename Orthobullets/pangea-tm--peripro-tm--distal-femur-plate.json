      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Length: 173mm Max. TKA Stem Coverage: N/A",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 241mm Max. TKA Stem Coverage: 100mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 280mm Max. TKA Stem Coverage: 120mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 318mm Max. TKA Stem Coverage: 160mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Length: 355mm Max. TKA Stem Coverage: 200mm",
          "table": null,
