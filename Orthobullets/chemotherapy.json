{
  "title": "Chemotherapy",
  "url": "https://www.orthobullets.com/pathology/8003/chemotherapy",
  "subtitle": "Updated: Mar 14 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "induces apoptosis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "may target specific proteins over-expressed in cancer cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "e.g. tyrosine kinase inhibitors",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "imatinib (Gleevec) for chronic myelogenous leukemia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "gefitinib (EGFR inhibitor, Iressa) for lung, breast cancer",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "erlotinib (EGFR inhibitor, Tarceva) for NSCLC and pancreatic cancer",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "eliminates micrometastasis in lungs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": ">98% necrosis with chemotherapy is good prognostic sign",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Resistance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "expression of **multi-drug resistance (MDR)** gene portends very poor prognosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cells can pump chemotherapy out of cell",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "present in 25% of primary lesions and 50% of metastatic lesions",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Integral component of treatment along with surgical resection in",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**osteosarcoma** (intramedullary and periosteal)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**Ewing's sarcoma/primative neuroectodermal tumor**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**malignant fibrous histiocytoma**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "dedifferentiated chondrosarcoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "chemotherapy for soft tissue sarcoma is controversial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Administration",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Preoperative chemotherapy given for 8-12 weeks",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Maintenance chemotherapy for 6-12 months",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Specific Agents & Antidotes",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Doxorubicin (Adriamycin)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "doxorubicin is an anthracycline antibiotic commonly used in oncological protocols",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "functions as a cytostatic agent",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "side effects",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cardiac toxicity**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "leads to congestive heart failure",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "dexrazoxane used to mitigate toxicity",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Agents and Antidotes",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8003/images/antidotes.jpg",
              "caption": "antidotes"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "mechlorethamine/cisplatin - give sodium thiosulfate",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "doxorubicin/epirubicin - give dexrazoxane",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "vinca alkaloids (vincristine/vinblastine) - give hot compress and hyaluronidase",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "give cold compress for all other vesicants",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
