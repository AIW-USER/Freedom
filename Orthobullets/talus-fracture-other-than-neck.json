          "children": [
            {
              "text": "indicated when suspicion is high and radiographs are negative",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "best study for posterior process fx, lateral process fx, and posteromedial process fx",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "helpful to determine degree of displacement, comminution, and articular congruity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be used to confirm diagnosis when radiographs are negative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "SLC for 6 weeks",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "nondisplaced (< 2mm) lateral process fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "nondisplaced (< 2mm) posterior process fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "nondisplaced (< 2mm) talar head fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "nondisplaced (< 2mm) talar body fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "cast molded to **support longitudinal arch**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ORIF/Kirshner wire Fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "displaced (> 2mm) lateral process fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "displaced (> 2mm) talar head fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "displaced (> 2mm) talar body fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "medial, lateral or posterior malleolar osteotomies may be necessary",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "displaced (> 2mm) posteromedial process fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "may require osteotomies of posterior or medial malleoli to adequately reduce the fragments",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "fragment excision",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "comminuted lateral process fractures",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "comminuted posterior process fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "nonunions of posterior process fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**ORIF/Kirshner Wires**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approaches",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**lateral approach**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "for lateral process fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "incision over tarsal sinus, reflect EDB distally",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**posteromedial approach**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "for medial tubercle of posterior process fracture or for entire posterior process fracture that has displaced medially",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "between FDL and neurovascular bundle",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**posterolateral approach**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "for lateral tubercle of posterior process fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "between peroneal tendons and Achilles tendon (protect sural nerve)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "beware when dissecting medial to FHL tendon (neurovascular bundle lies there)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**combined lateral and medial approach**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "required for talar body fractures with more than 2 mm of displacement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Fragment excisions**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incompetence of the lateral talocalcaneal ligament is expected with excision of a 1 cm fragment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "this is biomechanically tolerated and does not lead to ankle or subtalar joint instability",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**AVN**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**Hawkins sign** (lucency) indicates revascularization",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1049/images/Xray%20-%20AP%20-%20AVN%20with%20screws%20(emedicine)_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "lack of Hawkins sign with sclerosis is indicative of AVN",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1049/images/Xray%20-%20Lateral%20-%20AVN%20with%20screws%20(emedicine)_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Talonavicular arthritis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "posttraumatic arthritis is common in all of these fractures",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "this can be treated with an arthrodesis of the talonavicular joint",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Malunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Chronic pain from symptomatic nonunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "may have pain up to 2 years after treatment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Subtalar arthritis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "found in 45% of patients with lateral process fractures, treated either non-operatively or operatively",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "anatomic reduction of the articular surface can decrease incidence",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lateral process injuries have a favorable outcomes with prompt diagnosis and immediate treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
