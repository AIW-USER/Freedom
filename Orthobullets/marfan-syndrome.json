{
  "title": "Marfan Syndrome",
  "url": "https://www.orthobullets.com/pediatrics/4089/marfan-syndrome",
  "subtitle": "Updated: Jul 7 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Marfan Syndrome is a congenital connective tissue disorder caused by a mutation the fibrillin-1 gene that presents with long narrow limbs, skeletal abnormalities, cardiovascular abnormalities, and ocular abnormalities.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with the Ghent Nosology criteria supplemented with cardiology and genetics assessment.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to address orthopedic manifestations, cardiovascular abnormalities, and ocular abnormalities.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1/10,000",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no ethnic or gender predilection known",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**autosomal dominant**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "mutation in **fibrillin-1 (FBN1) gene**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "located on chromosome 15 (locus CH 15q21)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "multiple mutations identified",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Sporadic mutation may also occur (30%)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**arachnodactyly (long, slender digits)**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**scoliosis (50%)**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**protrusio acetabuli (15-25%)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "ligamentous laxity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "recurrent dislocations (patella, shoulder, fingers)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pes planovalgus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "dural ectasia **(>60%)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "meningocele",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pectus excavatum or carinatum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "nonorthopaedic conditions",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cardiac abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "aortic root dilatation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "aortic dissection",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "mitral valve prolapse",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "superior lens dislocations **(60%)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "spontaneous pneumonthorax",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Skin striae, recurrent hernias",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "scoliosis is usually the first manifestation to be diagnosed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may be a history of ankle sprains secondary to ligamentous laxity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "asymptomatic in most cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dolichostenomelia (arm span greater than height (>1.05 ratio)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4089/images/illus.%20arm%20span.jpg",
                  "caption": "Arm span to height ratio"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "**arachnodactyly** (long, thin toes and fingers)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4089/images/Arachnodactyly%20-%20courtesy%20of%20Miller_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "Thumb sign- Tip of thumb extends beyond small finger when thumb clasped in palm under four fingers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Wrist sign- distal phalanges of thumb and small fingers overlap when wrapped around opposite wrist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ligamentous hyperlaxity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Pes planus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "scoliosis series of spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "kyphosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "MRI of spine prior to surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "look for dural ectasia",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4089/images/dural%20ectasia.jpg",
                      "caption": "Dural ectasia"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Cardiac studies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cardiac evaluation prior to surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cardiac consult",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "echocardiogram",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedist may be the first provider to identify manifestations and suspect diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "refer to cardiology or genetics if multiple manifestations are found",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Ghent Nosology used to assist in diagnosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment General",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "beta blockers",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "medications decrease risk of aortic dilatation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "observation and orthotics",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for generalized joint laxity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preoperative evaluation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cardiology consultation required before any surgery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Scoliosis Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bracing",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "early treatment of mild curve",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "less effective than for idiopathic scoliosis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "PSF +/- ASF with instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "rapidly progressing curve in a skeletally immature patient",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "large curve in a skeletally mature patient",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Extend construct to avoid \"adding-on\", fuse to pelvis for distal curves with pelvic oblquity or poor distal fixation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Growing rod construct may be required in younger patients",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Obtain MRI to identify dural ectasia prior to surgery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "higher complication rate than idiopathic scoliosis surgery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Acetabular Protrusio Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative/observation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Considered if **progressing on radiographs or causing pain**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "skeletally immature",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "Closure of the triraditate cartilage (controversial",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "skeletally mature",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "valgus osteotomy (younger patients with minimal arthritis)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "total hip replacement (older patients with symptomatic arthritis)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Postoperative Complications after Scoliosis Surgery**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "overall higher complication rate compared to idiopathic scoliosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**fixation failure**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "is the most common complication secondary to thin laminae, thin pedicles and osteopenia.",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "higher risk of fixation failure than AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**infection**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "higher risk of infection than AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**pseudarthrosis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "higher risk of pseudarthrosis than AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**dural tear and intraoperative CSF leak** (8%)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "higher risk than AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**curve decompensation and need for reoperation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "higher risk than AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**blood loss**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "same complication rate as AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**postoperative neurologic deficits**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "same complication rate as AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**length of hospital stay**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "same complication rate as AIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
