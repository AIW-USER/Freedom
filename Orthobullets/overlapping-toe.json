        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "adduction and slight external rotation of the affected digit",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
