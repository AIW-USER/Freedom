{
  "title": "Bone Matrix",
  "url": "https://www.orthobullets.com/basic-science/9003/bone-matrix",
  "subtitle": "Updated: Jun 15 2021",
  "sections": [
    {
      "text": "composition of bone",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bone is made up of",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**organic component**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "40% of dry weight",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**inorganic component**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "60% of dry weight",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Organic component",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Components include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**collagen**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "90% of organic component",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "primarily type I collagen",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "provides tensile strength",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "it is a triple helix composed of one alpha-2 and two alpha-1 chains",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**proteoglycans**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "responsible for compressive strength",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "inhibit mineralization",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "composed of glycosaminoglycan-protein complexes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**matrix proteins**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "includes noncollagenous proteins",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "function to promote mineralization and bone formation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "three main types of proteins involved in bone matrix",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**osteocalcin**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "most abundant non-collagenous protein in the matrix (10%-20% of total)",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": [
                                {
                                  "text": "produced by mature osteoblasts",
                                  "table": null,
                                  "images": [],
                                  "importance": "5",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "function",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "promotes mineralization and formation of bone",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": [
                                    {
                                      "text": "directly involved in regulation of bone density",
                                      "table": null,
                                      "images": [],
                                      "importance": "2",
                                      "children": []
                                    },
                                    {
                                      "text": "attracts osteoclasts",
                                      "table": null,
                                      "images": [],
                                      "importance": "2",
                                      "children": []
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "text": "signaling",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "stimulated by 1,25 dihydroxyvitamin D3",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                },
                                {
                                  "text": "inhibited by PTH",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "clinical application",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "marker of bone turnover",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": [
                                    {
                                      "text": "can be measured in urine or serum",
                                      "table": null,
                                      "images": [],
                                      "importance": "2",
                                      "children": []
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "text": "**osteonectin**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "secreted by platelets and osteoblasts",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            },
                            {
                              "text": "function",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "believed to have a role in regulating calcium or organizing mineral in matrix",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "text": "**osteopontin**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "function",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "cell-binding protein",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**cytokine and growth factors**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "small amounts present in matrix",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "aid in bone cell differentiation, activation, growth, and turnover",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "include",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "IL-1, IL-6, IGF, TGF-beta, BMPs",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Inorganic component",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Components include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**calcium hydroxyapatite (Ca10(PO4)6(OH)2**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "provides compressive strength",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**osteocalcium phosphate (brushite)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    }
  ],
