{
  "title": "Pangea® Lateral NPC Plate",
  "url": "https://www.orthobullets.com/implants/423337/pangea-r--lateral-npc-plate",
  "subtitle": "Updated: Jul 16 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Designed with SOMA (Stryker Orthopedics Modeling and Analytics) which includes a database with CT scans from hospitals across the world and state of the art algorithms that analyze shape variability, bone density, and implant fit",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Designed to link with the T2 Alpha Femur Retrograde Nail when using nail plate combination fixation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Nine distal T20 screw holes, including 2 linking holes, 2 kickstand screw holes, and 1 threaded monoaxial hole",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Related Implants",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The Pangea® Femur Reconstruction System includes",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**Lateral NPC Plate (this topic)**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**Medial NPC Plate**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**T2 Alpha™ Femur Retrograde Nailing System**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Design",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Tapered end",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "designed for atraumatic submuscular insertion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "2.0mm K-wire holes",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Variable-angle screw holes",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423337/images/479aa36c-b255-4415-87dd-5c8f86c9ba3d_screenshot_2026-03-05_at_3.53.31_pm.jpg",
              "caption": "Variable-angle screw holes"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "circular universal holes accept non-locking screws, and locking screws within a 30° cone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Proximal interface",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423337/images/9be910e8-5f24-4629-982a-d6ce0f29b9f1_screenshot_2026-03-05_at_3.55.37_pm.jpg",
              "caption": "Proximal interface"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "universal junction provides a snap-in interface between the lateral place and a femur spanning attachment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "the junctions ratcheting mechanism allows for up 22 mm of proximal-distal adjustment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Femur spanning attachment",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423337/images/18356276-94bd-41a2-bd57-73504723a0f3_screenshot_2026-03-05_at_3.54.20_pm.jpg",
              "caption": "Femur spanning attachment"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "three 5.0 mm screw holes accept T20 cortical and cancellous non-locking screws, providing the option for fixation in the femoral neck",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Kickstand screw holes",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423337/images/503fb10a-998e-4ec8-89ad-94b5b17d0d95_screenshot_2026-03-05_at_3.52.59_pm.jpg",
              "caption": "Kickstand screw holes"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "two variable-angle screw holes for use in stand-alone plating applications with predetermined trajectories targeting the medial femoral condyle",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Staggered screw holes",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "designed to enable surgeon to choose points of fixation and allows for placement of screws around an intramedullary implant or a prothesis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Linking holes",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "designed to allow for seamless linking of the plate to a T2 Alpha Femur Retrograde Nail using an AlphaLink Dowel",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
