            },
            {
              "text": "split-depression fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "active or suspected infection at the surgical site",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "severe local inflammation around the operative area",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "hypersensitivity or allergy to implant materials",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "inadequate soft-tissue coverage over the implant",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
