{
  "title": "Synovial Facet Cyst",
  "url": "https://www.orthobullets.com/spine/2066/synovial-facet-cyst",
  "subtitle": "Updated: Apr 11 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Synovial facet cysts are degenerative lesions of the lumbar spine that can lead to lumbar spinal stenosis, resulting in low back pain and radicular symptoms",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with MRI of the lumbar spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is a trial of nonoperative management with NSAIDs and physical therapy. Surgical management is indicated for progressive disabling pain that has failed nonoperative management and/or the presence of progressive neurological deficits",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually in the lumbar spine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "60-89% occur at L4-5 (most mobile segment)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "~14% occur at L3-4",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "~12% occur at L5-S1",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "possible etiologies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "trauma (controversial)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "microinstability of the facet joint, leading to:",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "extruded synovium through the joint capsule",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "myxoid degeneration of collagen tissue",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "proliferation of fibroblasts with increased hyaluronic acid production",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "cyst composition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "ganglion cysts",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "flavum cysts",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "serous contents",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "mucoid contents",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "hemorrhagic contents",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "degenerative spondylolisthesis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**mechanical back pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**radicular symptoms** (leg pain)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "rapid onset or sudden deterioration suggest a facet cyst hematoma",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "neurogenic claudication (buttock/leg pain with walking)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may have nerve root deficits at associated spinal levels",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, lateral, flexion, and extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually normal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "look for segmental instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "significant leg pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "best seen on axial and sagittal T2-weighted images",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2066/images/facet%20synovial%20cyst.jpg",
                      "caption": "facet synovial cyst shown on T2 axial MRI image"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/2066/images/facet%20synovial%20cyst%20mri%20t2%20sagittal.jpg",
                      "caption": "T2 sagittal MRI of spinal facet synovial cyst"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "traditionally hyperintense centers with hypointense rims on T2 and hypointense inner cores on T1 sequences",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "peripheral rim enhancement with gadolinium contrast",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "improved detection rate with positional MRI",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "89% sensitivity when supine",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "97% sensitivity when standing",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "cysts may increase in size while standing",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "high-signal intensity on T2-weighted images",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "synovial content",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "higher success rate with CT-guided cyst rupture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "low-signal intensity on T2-weighted images",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "gelatinous or calcified contents",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "lower success rate with CT-guided cyst rupture",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "NSAIDs, rest, immobilization, physical therapy, and epidural steroid injections",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first-line treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "mild symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "radicular pain without motor weakness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "no natural history studies have been conducted to date",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "CT-guided cyst rupture, facet steroid injection, and cyst injection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "second-line management after failure of conservative measures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "radicular symptoms correlate with facet cyst location",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "50-75% pain relief at 1-year",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "~39% of patients will require surgical intervention at 7 months",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2066/images/screen_shot_2020-02-23_at_1.36.06_pm.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "**laminectomy with** decompression and cyst excision",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "persistent symptoms despite nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "unilateral symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "can be performed in patients with spondylolisthesis who have unilateral symptoms as long as they are aware of the higher risk of slip progression",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "high incidence of **recurrent back pain and cyst formation** within 2 years",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "80-90% success rate in improving back and leg pain",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "risk of iatrogenic spondylolisthesis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "facetectomy and instrumented fusion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**some consider this to be the first-line of surgical treatment due to high recurrence rates**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**symptomatic recurrence following laminectomy with decompression**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "bilateral symptoms",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "central canal stenosis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "wider decompression will likely lead to iatrogenic instability",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "presence of instability (i.e. degenerative spondylolisthesis)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "demonstrated to have the **lowest risk of persistent back pain and recurrence of cyst formation** in recent studies",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "complete resolution of symptoms in 80-90% of patients",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**NSAIDs, rest, immobilization, physical therapy, and epidural steroid injections**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "recommended for 6-8 weeks prior to proceeding with surgical treatment or CT-guided rupture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**CT-guided cyst rupture, facet steroid injection, and cyst injection**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "fluoroscopic guidance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "commonly used",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "secondary surgery rate is roughly 50%",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "CT guidance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "improved visualization of spinal anatomy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "slightly improved patient outcomes compared to fluoroscopic guidance",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**laminectomy with decompression and cyst excision**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**posterior approach to the spine**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "unilateral laminotomy and medial facetectomy with a high-speed burr",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "create a plane between the dura and cyst",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "grab cyst with Allis clamp or forceps and apply gentle traction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "separate cyst from the underlying dura with Epstein curet or Woodson elevator",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**facetectomy and instrumented fusion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "posterior approach to the spine",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "place pedicle screws at the intersection of the superior border of the transverse process and midline of the superior articular process",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2066/images/chp0040_pl040-001a-9780323448086.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "perform decompressive laminectomy and facetectomy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "excise cyst after developing an interval between cyst and dura",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "partial excision in cases of cysts adherent to the dura",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Cyst recurrence**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "high recurrence rate with resection alone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "new studies favor facetectomy and fusion as first-line operative treatment",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Iatrogenic spondylolisthesis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "decompressive laminectomy without fusion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "posterior instrumented fusion +/- spondylolisthesis reduction",
