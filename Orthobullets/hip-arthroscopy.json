{
  "title": "Hip Arthroscopy",
  "url": "https://www.orthobullets.com/knee-and-sports/3100/hip-arthroscopy",
  "subtitle": "Updated: Jun 4 2025",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increasingly common procedure as advances in technology and familiarity expands",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "technically difficult procedure due to deep location of hip joint and high congruity (as compared to knee and shoulder)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "significant learning curve",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "250% increase in hip arthroscopies performed in US from 2007 to 2011",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intra-articular pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "femoroacetabular impingement lesions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "labral tears",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diagnosis and staging of AVN",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**loose bodies**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**chondral defects**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**ligamentum teres injury**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**synovial disease**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**septic arthritis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**extra-articular pathology**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "AIIS subspine impingement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "capsular tears or instability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**iliopsoas tendon pathology**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**gluteal tears**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**trochanteric bursal debridement**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**ischiofemoral impingement**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**deep gluteal syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**piriformis debridement/release**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**proximal hamstring tears**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Contraindications**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**advanced DJD**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**hip ankylosis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**acetabular dysplasia**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**joint contracture**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**severe osteoporotic bone**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "significant protrusio acetabuli",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Prognosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lower morbidity than open arthrotomy with expeditious post-operative course",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Setup, Positioning, and Joint access",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Setup",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dedicated hip arthroscopy instruments required",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "70-degree arthroscope",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "long cannulas and guides",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "flexible instrumentation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "fluoroscopy positioned so both fluoroscopic and arthroscopic towers visible",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Positioning",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "may be done supine or in lateral decubitus position",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "regular fracture traction table or commercially made tables/attachments available",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "perineal post, if used, must be well padded",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "traction placed through operative leg to distract joint for safe entry",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "often requires around 50 pounds of traction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "bed may be placed in Trendelenburg to lessen force required",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Access",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "needle insertion at **anterolateral portal** site",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "spinal needle placed into hip joint (central compartment) with aid of fluoroscopy to avoid femoral head and labrum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can load joint with saline to distend",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "alternatively, joint can be vented to create air arthrogram",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "guidewire, cannula, and arthroscope inserted into joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "subsequent portals placed under direct visualization and/or fluoroscopy",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3100/images/hip%20arthrscopy.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "portal use dictated by pathology being treated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Portals",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Anterolateral portal (AL)**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3100/images/portals.jpg",
              "caption": "Labelled clinical photo shows hip arthroscopy portals in relation to greater trochanter and ASIS."
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "primary viewing portal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "anterolateral hip joint instrumentation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "located 2 cm anterior and 2 cm superior to anterosuperior border of greater trochanter",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "established first under fluoroscopic guidance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "structures at risks",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "superior gluteal nerve",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Anterior portal (AP)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "central compartment visualization and instrumentation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "often second portal created",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "starting point originally described at intersection between superior ridge of greater trochanter and line drawn longitudinally from ASIS",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "subsequently moved variable distance lateral to this line to avoid lateral femoral cutaneous nerve",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "flexion and internal rotation of hip loosens capsule and may assist scope insertion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "interportal capsulotomy made connecting anterior portal to anterolateral portal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "iliofemoral ligament fibers cut",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "structures at risk",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**lateral femoral cutaneous nerve**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "ascending branches of lateral femoral circumflex artery",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "femoral neurovascular bundle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Distal anterolateral portal (DALA)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "provides access to the peripheral compartment in the region of the femoral neck",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "starting point 3 to 5 cm distal to the anterolateral portal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "traction is removed and the hip is placed in either neutral flexion and extension or in 45 degrees of flexion to relax the anterior capsule",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "fluoroscopy and direct arthroscopic visualization is used to guide portal placement",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "structures at risk",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "ascending branch of lateral femoral circumflex artery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Mid-anterior portal (MAP)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "functions",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "imilar to anterior portal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "various different portals described",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "all made lateral to anterior portal and medial the anterolateral portals",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Posterolateral portal (PL)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "posterior hip joint access and instrumentation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "location and technique",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "located 1 cm posterior and 1 cm proximal to the posterosuperior tip of the greater trochanter",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "leg in neutral rotation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "structures at risk",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "sciatic nerve",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Compartments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Central compartment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "acetabular fossa and femoral head articular surfaces",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ligamentum teres",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "acetabular rim and labrum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AIIS and capsule",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "requires traction for access and instrumentation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Peripheral compartment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "portion of hip joint lateral to the labrum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no traction required",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "femoral head-neck junction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "iliopsoas tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "zona orbicularis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3100/images/zona_orbicularis.jpg",
                      "caption": "Shows the zona orbicularis"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3100/images/peripheral_compartment_medial_view.jpg",
                      "caption": "Show the peripheral compartment of the hip viewed medially"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3100/images/zona_orbicularis_arthroscopic_image.jpg",
                      "caption": "Shows the zona orbicularis"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "landmark for the iliopsoas tendon",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial synovial fold",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Lateral compartment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "trochanteric and peri-trochanteric area",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no traction required",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "IT band and bursa",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "gluteus medius/minimus tendons",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Deep gluteal space",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extra-articular posterior hip space",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no traction required",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "piriformis and sciatic nerve",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hamstring origin at ischial tuberosity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Rehabilitation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Rehab protocols vary by procedure and surgeon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physical therapist involvement prior to procedure to discuss expectations",
              "table": null,
              "images": [],
