{
  "title": "Meniscal Cysts",
  "url": "https://www.orthobullets.com/knee-and-sports/3006/meniscal-cysts",
  "subtitle": "Updated: May 28 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Meniscal cysts are a condition characterized by a local collection of synovial fluid within or adjacent to the meniscus most commonly as result of a meniscal tear.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is confirmed with MRI studies of the knee.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally nonoperative with physical therapy and NSAIDs. Surgical decompression with partial meniscectomy versus meniscus repair may be indicated for persistently symptomatic patients who fail conservative management.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no studies of the general population",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "found in 1-4% of MRI studies of the knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly associated with a **meniscal tear**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "no trend to increased age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**perimeniscal cysts**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "small lesions of fluid within the meniscus",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "medial cysts are slightly more common than lateral, 2:1 ratio (although literature data are conflicting)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "medial cysts = posterior horn",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "lateral cysts = anterior horn or mid-portion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**parameniscal cysts (e.g., baker cysts)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**extruded fluid outside the meniscus (most common)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "usually located between **semimembranosus** and **medial head of gastrocnemius**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "meniscal tear functions as a one-way valve",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "synovial fluid extrudes and then concentrates to form gel-like material",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "horizontal and complex tears, usually = parameniscal cysts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "radial or vertical tears, usually = perimeniscal cysts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "articular cartilage injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "anterior cruciate ligament tear",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Meniscus",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "composition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**fibroelastic cartilage**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "interlacing network of collagen, proteoglycan, glycoproteins, and cellular elements",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "composed of 65-75% water",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Collagen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**90 % Type I collagen**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "shape",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial meniscus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "stretched-out, C-shape with triangular cross section",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral meniscus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "more circular in shape",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "covers larger area of articular surface",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Blood supply",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**medial inferior genicular artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "supplies peripheral 20-30% of medial meniscus",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**lateral inferior genicular artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "supplies peripheral 10-25% of lateral meniscus",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**synovial fluid**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "central 75% of meniscus' receive nutrition through diffusion",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may have recent trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "localized to medial/lateral joint line or back of knee",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "mechanical symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**locking and clicking**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "delayed or intermittent knee swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakness or claudication (neaurovascular impingement)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Examination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "popliteal mass",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "best visualized with the knee in extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "joint line tenderness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "palpable mass",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "crepitus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "should be normal in young patients with an acute meniscal injury or cyst",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3006/images/ganglion-cyst-baker-mri.jpg",
              "caption": "Baker&#39;s cyst"
            },
            {
              "src": "https://upload.orthobullets.com/topic/3006/images/1207_14.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "MRI is **most sensitive diagnostic test** for meniscal cyst and meniscal tear",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cyst with bright T2 signal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "necrotic tissue, nerve sheath tissue, and pus can all resemble cysts on T2-weighted MRIs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "IV contrast enhancement may be needed",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Non-operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, NSAIDS, rehabilitation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indicated as first line of treatment for small perimeniscal cysts and parameniscal cysts",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "trial of medical therapy to observe patients pain response",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "may be effective in population with degenerative tears",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "aspiration and steroid injection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "isolated baker's cysts in young patient",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cyst drainage",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "ultrasound guided injection into the cyst",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "poor outcomes in older degenerative mensical tears with associated cysts",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthroscopic debridement, cyst decompression and meniscal resection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "perimeniscal cysts with an associated tear that is not amenable to repair (e.g., complex, degenerative, radial tear patterns)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "decompress cyst completely",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "perform partial meniscectomy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "incomplete meniscal resection may lead to recurrence",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "cyst excision using open posterior approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "symptomatic parameniscal cysts",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "incomplete resection may lead to recurrence",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Cyst excision using open posterior approach**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "patient prone",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "curved incision over popliteal fossa",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "interval between medial head of gastrocnemius and semimembranosus",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "sharp dissection of cyst margins to joint capsule",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
