            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**AP** = joint alignment, fracture, knee arthritis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**lateral** = patella alta vs baja, femoral condyle dysplasia, arthritis, transverse patellar fracture",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**axial** = patella malalignment, trochlear groove depth, arthritis, vertical patellar fracture",
                  "table": null,
