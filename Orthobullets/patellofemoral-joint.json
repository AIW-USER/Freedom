  "sections": [
    {
      "text": "Overview",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Biomechanically complex articulation between the **patella** and **distal femoral condyles**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Associated clinical conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patella dislocation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "patella tendon rupture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "quadriceps tendon rupture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "OCD lesions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "chondromalacia patellae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patellofemoral joint arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patella instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osseous",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**bony constraint of the patella within the trochlear groove**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**intracondylar groove**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "diameter of lateral femoral condyle > medial femoral condyle",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "bony constraint of groove is the primary constraint to lateral patellar instability when knee flexion is > 30 degrees",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**static stability** of the patella within the trochlear groove",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**medial patellofemoral ligament (MPFL)**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3002/images/medial_struc.jpg",
                      "caption": "medial structures 1"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3002/images/medial_struc_2.jpg",
                      "caption": "medial structures 2"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**originates from the adductor tubercle to insert onto the superomedial border of the patella**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "primary constraint to lateral patellar instability with knee flexion 0 to 20 degrees",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "patellotibial ligament",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "retinaculum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**dynamic stability** of the patella within the trochlear groove",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**vastus medialis** = medial restraint to lateral translation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "vastus lateralis = lateral restraint to medial translation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tendon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "angular difference between the quadriceps tendon insertion and patella tendon insertion creates a valgus axis (**Q angle**)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "creates a laterally directed force across the patellofemoral joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leads to increased contact pressures in lateral patellar facet between 40-90 degrees",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "superior, medial and lateral, geniculate arteries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inferior, medial and lateral, geniculate arteries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "anterior geniculate artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "descending geniculate artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Biomechanics",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "transmits tensile forces generated by the quadriceps to the patellar tendon",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3002/images/patellofemoral%20joint_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "increases lever arm of the extensor mechanism",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "patellectomy decreases extension force by 30%",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patellofemoral joint reaction force",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3002/images/free_body_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "up to 7x body weight with squatting",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3002/images/jr%20forec_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "2-3x body weight when descending stairs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Motion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "\"sliding\" articulation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patella moves caudally during full flexion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3002/images/42-e289a4c9d4_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "maximum contact between femur and patella is at 45 degrees of flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "passive restraints to lateral subluxation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial patellofemoral ligament",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3002/images/mpfl_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "primary passive restraint to lateral translation in 20 degrees of flexion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "60% of total restraining force",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial patellomeniscal ligament",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "13% of total restraining force",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial retinaculum",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3002/images/lateral%20retinaculum_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "10% of total restraining force",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "dynamic restraint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "quadriceps muscles",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Q angle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "definition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "line drawn from the anterior superior iliac spine --> middle of patella --> tibial tuberosity",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3002/images/qangle_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "normal Q angle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "males = 13 degrees",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "females = 18 degrees",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
