{
  "title": "Tillaux Fractures",
  "url": "https://www.orthobullets.com/pediatrics/4028/tillaux-fractures",
  "subtitle": "Updated: Jan 18 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Tillaux Fractures are traumatic ankle injuries in the pediatric population characterized by a Salter-Harris III fracture of the anterolateral distal tibia epiphysis.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made with plain radiographs of the ankle. CT scan may be required to further characterize the fracture pattern and for surgical planning.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is closed reduction and casting if < 2mm displacement or operative management if > 2mm displacement.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "accounts for 3-5% of pediatric ankle fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in girls",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "seen in children nearing skeletal maturity (12-14 years old)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "typically occur within one year of complete distal tibia physeal closure due to pattern of progression of physeal closure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**older** than triplane fracture age group",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by an **avulsion of the anterior inferior tibiofibular ligament**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**results from supination-external rotation injury**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "leads to avulsion of anterolateral tibia at the site of attachment of the anterior inferior tibiofibular ligament",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4028/images/5-figure4-1-1.jpg",
                          "caption": "tillaux fx"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**lack of coronal plane fracture in the posterior distal tibial metaphysis distinguishes this fracture from a triplane fracture**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "distal fibular fracture (usually SH I or II)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ipsilateral tibial shaft fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physeal considerations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "distal tibial physis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "accounts for 35-40% of overall tibial growth and 15-20% of overall lower extremity growth",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rate of growth is 3-4 mm/year",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "growth continues until 14 years in girls and 16 years in boys",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "closure occurs during an 18 month transitional period",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Occurs in a predictable pattern: central > anteromedial > posteromedial > lateral**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4028/images/8e1ba2d4-0569-4ccf-a39d-174d2b25add3_physis_closure..jpg",
                          "caption": "Pattern of distal tibia physeal closure"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Ligaments**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**anterior inferior tibiofibular ligament (AITFL)**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4028/images/p9780071819657-ch022_f003.jpg",
                  "caption": "AITFL"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "extends from anterior aspect of lateral distal tibial epiphysis (Chaput tubercle) to the anterior aspect of distal fibula (Wagstaffe tubercle)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inability to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "slight swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "focal tenderness at anterolateral joint line",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "deformity is rare",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "marked displacement is prevented by the fibula",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "mortise",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "best view to see tillaux fractures",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "SH III fracture of the anterolateral distal tibia epiphysis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4028/images/xray.ankle.mortise..jpg",
                      "caption": "Shows Tillaux fx"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "delineate fracture pattern",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4028/images/ct.ankle.axia.shows%20tillaux.jpg",
                      "caption": "Shows Tillaux fx"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4028/images/25_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "determine degree of displacement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "identify intramalleolar or medial fracture variant patterns",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction and casting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**< 2mm** displacement following closed reduction (rare)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CRPP vs. ORIF",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**> 2mm** displacement remains after reduction attempt",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed reduction and casting**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "reduce by **internally rotating** foot",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "can also attempt by dorsiflexing the pronated foot then internally rotating",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "CT scans sometimes needed to determine residual displacement (confirm < 2mm)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**long leg cast** initially for 3-4 weeks to control **rotational** component of injury",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "follow early with radiographs to assess for displacement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "immobilize an additional 2-4 weeks in a **short leg cast** or walking boot (to initiate ankle ROM)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**CRPP**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "reduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "use k-wire or guidwire as joystick for reduction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "assess reduction with flouroscopy or arthrogram in OR (if in doubt, open the joint and viusalize)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "K-wire or cunnulated screw over guidwire can be final fixation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "it is OK to cross physis with fixation as there is little growth remaining",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "functional outcomes are good with a residual displacement of < 2.5mm",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**ORIF**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "anterolateral approach",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "visualize joint line to optimize reduction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "reduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "reduce with **internal rotation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "arthroscopically-assisted reduction has been described",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "indirect reduction with periarticular clamp and percutaneous fixation has also yielded good results",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "intraepiphyseal K wires or cannulated screws",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**transphyseal** fixation can also be used as most patients are approaching skeletal maturity",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "post-op",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "long leg cast for 3-4 weeks then short leg walking cast for 2 weeks",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Premature growth arrest**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "physeal closure is already occuring",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "decreased risk with anatomic reduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Early arthritis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "increased risk with articular displacement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
