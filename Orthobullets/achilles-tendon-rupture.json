{
  "title": "Achilles Tendon Rupture",
  "url": "https://www.orthobullets.com/foot-and-ankle/7021/achilles-tendon-rupture",
  "subtitle": "Updated: Apr 20 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Achilles Tendon Ruptures are common tendon injuries that occur due to sudden dorsiflexion of a plantarflexed foot, most commonly associated with sporting events.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made clinically with weakness of plantarflexion with a positive Thompson's test. MRI studies may be indicated for surgical management of chronic injuries.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on patient age, patient activity demands and chronicity of injury.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "18:100,000 per year",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be **missed in up to 25%**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in men",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most common in **ages 30-40**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "episodic athletes, **\"weekend warrior\"**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**flouroquinolone** antibiotics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "steroid injections",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually traumatic injury during a sporting event",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may occur with",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sudden forced plantar flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "violent dorsiflexion in a plantar flexed foot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rupture usually occurs **4-6 cm above the calcaneal insertion** in hypovascular region",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Achilles tendon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "largest tendon in body",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "formed by the confluence of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "soleus muscle tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "medial and lateral gastrocnemius tendons",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "blood supply from posterior tibial artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patient usually **reports a \"pop\"**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "weakness and difficulty walking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain in heel",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increased resting ankle dorsiflexion in prone position with knees bent",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7021/images/picture%201%20resting%20tension.jpg",
                      "caption": "Shows physical exam of Achilles tendon rupture"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "calf atrophy may be apparent in chronic cases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "palpable gap",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7021/images/palpable%20gap.jpg",
                      "caption": "clinical photo palpable gap"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**weakness to ankle plantar flexion**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "increased passive dorsiflexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative test",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Thompson test**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**lack of plantar flexion when calf is squeezed**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7021/images/radiograph.jpg",
              "caption": "Radiograph achilles tendon rupture"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "used to **rule out other pathology**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be useful to determine **complete vs. partial ruptures**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7021/images/ultrasound.jpg",
                      "caption": "ultrasound of a partial tear"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/7021/images/complete%20tear%20ultrasound.jpg",
                      "caption": "ultrasound complete tear"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "equivocal physical exam findings",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "chronic ruptures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "will show acute rupture with retracted tendon edges",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7021/images/mri.jpg",
                      "caption": "achilles tear on MRI"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "functional bracing/casting in resting equinus",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute injuries with surgeon or patient preference for non-operative management",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "sedentary patient",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "medically frail patients",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "more proximal injuries of the musculature contributing to the achilles tendon",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**equivalent plantar flexion strength** compared to operative management",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "new studies show **equivalent rates of re-rupture** if functional rehabilitation used versus operative repair",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "fewer complications compared to operative treatment",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open end-to-end achilles tendon repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "acute ruptures (approximately <6 weeks)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "decreased rate of re-rupture compared to non-operative management",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "new Level 1 evidence has suggested **no difference in re-rupture rates with functional rehab protocol**",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "no significant difference in plantar flexion strength with functional rehab protocol",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "decreased risk of re-rupture after surgical repair when early ROM protocol used",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "percutaneous Achilles tendon repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "concerns over cosmesis of traditional scar",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "higher risk of **sural nerve damage**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "lesser risk of wound complications/infection compared with open repair",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "more rapid return to work, with equivalent 1-year function compared with open repair.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "reconstruction with VY advancement",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "chronic ruptures with defect < 3cm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "flexor hallucis longus transfer +/- VY advancement of gastrocnemius",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**chronic ruptures with defect > 3cm**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**requires a functioning tibial nerve**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Functional bracing/casting in resting equinus**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7021/images/functional%20achilles%20brace.jpg",
                  "caption": "functional achilles brace"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "cast/brace in 20 degrees of plantar flexion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "early functional rehab for those treated without a cast",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**End-to-end achilles tendon repair**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "make incision just medial to achilles tendon to avoid **sural nerve**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "incise paratenon",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "expose tendon edges",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "repair with heavy non-absorbable suture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative care",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**immobilize in 20° of plantar flexion to decrease tension on skin and protect tendon repair for 4-6 weeks**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Percutaneous achilles tendon repair**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Reconstruction with VY advancement**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "make V cut with apex at musculotendinous junction with limbs divergent to exit the tendon",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7021/images/vy%20advancement.jpg",
                      "caption": "VY advancement"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "V is incised through only the superficial tendinous portion leaving the muscle fibers intact",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Flexor hallucis longus transfer ± VY advancement of gastrocnemius**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**technique**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "excise degenerative tendon edges",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "release FHL tendon at the Knot of Henry and transfer through the calcaneus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "residual hallux plantarflexion weakness",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Re-rupture**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "higher with non-operative management (~10-40% vs 2%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "new Level 1 evidence has shown no difference in re-rupture rates",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "surgical repair",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Wound healing complications**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7021/images/wound%20healing.jpg",
              "caption": "wound healing complication"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "5-10%",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "1",
