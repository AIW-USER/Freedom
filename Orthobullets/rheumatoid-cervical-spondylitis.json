{
  "title": "Rheumatoid Cervical Spondylitis",
  "url": "https://www.orthobullets.com/spine/2043/rheumatoid-cervical-spondylitis",
  "subtitle": "Updated: Nov 2 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Rheumatoid cervical spondylitis is seen in patients with rheumatoid arthritis (RA) and comprises 3 specific patterns of cervical spine instability, including atlantoaxial subluxation, basilar invagination, and subaxial subluxation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with cervical spine flexion-extension radiographs and MRI studies to measure the degree of spinal cord compression",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment may involve observation or decompression with instrumentation depending on patient neurologic status, degree of mechanical instability, and severity of spinal cord compression",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "EPIDEMIOLOGY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Present in 90% of patients with RA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis often missed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "ETIOLOGY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical rheumatoid spondylitis presents with 3 main patterns of instability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**atlantoaxial subluxation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most common form of instability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**basilar invagination**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**subaxial subluxation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Ranawat Classification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Class I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Pain, no neurologic deficit",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Class II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Subjective weakness, hyperreflexia, and dysesthesias",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Class IIIA",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Objective weakness, long tract UMN signs",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Patient is ambulatory",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Class IIIB",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Objective weakness, long tract UMN signs",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Patient is non-ambulatory",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Do NOT operate",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms and physical exam findings are similar to cervical myelopathy",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "neck pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neck stiffness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "occipital headaches",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "due to irritation of the lesser occipital nerve (a branch of the C2 nerve root)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "gradual onset of weakness and loss of sensation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hyperreflexia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "upper and lower extremity weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ataxia (gait instability and loss of hand dexterity)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flexion-extension x-rays",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "always obtain before elective surgery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful to delineate bony anatomy and for surgical planning",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "study of choice to evaluate the degree of spinal cord compression and identify myelomalacia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "General Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pharmacologic therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pharmacologic treatment for RA has seen significant recent advances, which has led to a decrease in surgical intervention",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spinal decompression and stabilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "goal is to prevent further neurologic progression; surgery may not reverse existing deficits",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Atlantoaxial Subluxation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "present in 50-80% of patients with RA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most commonly involves anterior subluxation of C1 on C2 (though lateral and posterior displacement may also occur)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by **pannus formation** between the dens and ring of C1, leading to the destruction of the **transverse ligament and dens**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "controlled flexion-extension views to determine AADI and SAC / PADI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**AADI (anterior atlanto-dens interval)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "instability is defined as >3.5 mm of motion between flexion and extension views",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "instability alone is not an indication for surgery",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": ">7 mm of motion may indicate disruption of alar ligament",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**>10 mm** of motion is an **indication for surgery because of increased risk of neurologic injury**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**PADI / SAC (posterior atlanto-dens interval / space available for cord)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**<14 mm** is an **indication for surgery because of increased risk of neurologic injury**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": ">13 mm is the most important radiographic measurement for predicting complete neural recovery after decompressive surgery",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indicated in stable atlantoaxial subluxation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior C1-2 fusion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "general indications for surgery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "AADI >10 mm (even if no neurologic deficits)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "**SAC / PADI <14 mm (even if no neurologic deficits)**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "progressive myelopathy",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "indications for posterior C1-2 fusion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "able to reduce C1 to C2 (no need to remove posterior arch of C1)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "technique",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**transarticular screws** eliminate the need for halo immobilization",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "obtain preoperative CT to identify the location of the vertebral arteries",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "occiput-C2 fusion ± resection of posterior C1 arch",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "used when atlantoaxial subluxation is **combined with basilar invagination**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**resection of C1 posterior arch** for complete decompression",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "leads to indirect decompression of anterior cord compression caused by pannus formation",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "may be required if atlantoaxial subluxation is not reducible",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "odontoidectomy",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "rarely indicated",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "used as a secondary procedure when there is residual anterior cord compression (due to pannus formation) that fails to resolve following a posterior spinal fusion",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "**pannus often resolves following posterior fusion** alone, due to a decrease in instability",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Basilar Invagination",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "also known as superior migration of odontoid (SMO)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tip of dens migrates above the foramen magnum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "present in 40% of RA patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often seen in combination with fixed atlantoaxial subluxation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cranial migration of the dens results from erosion and bone loss between the occiput, C1, and C2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiographic lines",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Ranawat C1-C2 index**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2043/images/ranawat%20c1-2.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "center of C2 pedicle to a line connecting the anterior and posterior C1 arches",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "normal measurement in men is 17 mm and in women is 15 mm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "distance of <13 mm is consistent with impaction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "most reproducible measurement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**McGregor's line**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2043/images/mcgreggor.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "line drawn from the posterior edge of the hard palate to the caudal posterior occiput curve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "cranial settling is present when the tip of dens is >4.5 mm above this line",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "can be difficult to measure when the dens is eroded",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Chamberlain's line**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2043/images/chamberlain.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "line from dorsal margin of hard palate → posterior edge of the foramen magnum",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "abnormal if the tip of dens lies **>5 mm proximal to Chamberlain's line**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "normal distance from tip of dens to basion of occiput is 4-5 mm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "often hard to visualize on standard radiographs",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "McRae's line",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "defines the opening of the foramen magnum",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "the tip of the dens may protrude slightly above this line, but impaction is not present if the dens is below this line",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cervicomedullary angle <135° suggests impending neurologic impairment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "occiput-C2 fusion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**progressive cranial migration (>5 mm)**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "neurologic compromise",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "cervicomedullary angle <135° on MRI",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "transoral or anterior retropharyngeal odontoid resection",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "brainstem compromise",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Subaxial Subluxation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "present in 20% of patients with RA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often occurs at multiple levels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often combined with upper cervical spine instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lower spine involvement is **more common with:**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "steroid use",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "males",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "seropositive RA",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "nodules present",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "severe RA",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pannus formation and soft-tissue instability of the facet and Luschka joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "subaxial subluxation (of vertebral body) of **>4 mm or >20%** indicates cord compression",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "cervical **height index (body height/width) <2.0** is almost 100% sensitive and specific for predicting neurologic compromise",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior fusion and wiring",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**>4 mm / >20% subaxial subluxation with intractable pain and neurologic symptoms**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Operative Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Failure to improve symptoms**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "outcomes are less reliable in Ranawat grade IIIB (objectively weak with UMN signs and nonambulatory)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Pseudarthrosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "10-20%",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "rate decreases with **extension of the construct to the occiput**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Adjacent level degeneration**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    }
