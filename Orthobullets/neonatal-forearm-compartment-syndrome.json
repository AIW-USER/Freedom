    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Natural history of disease",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually missed initially, detected only after complications ensue",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prognostic variable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "negative",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "missed diagnosis has worst prognosis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Outcomes with treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prognostic variable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "favorable",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
