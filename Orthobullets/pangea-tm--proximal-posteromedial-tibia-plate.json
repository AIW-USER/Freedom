      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Standard plate lengths: 4-12 hole (68-180mm)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Thickness: 3.0mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Left and right anatomic plate options",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Drill bits: Ø2.5mm x 135mm (542020) Ø2.5mm x 215mm (542021)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
