{
  "title": "Trochanteric Bursitis",
  "url": "https://www.orthobullets.com/knee-and-sports/3098/trochanteric-bursitis",
  "subtitle": "Updated: Jun 1 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Trochanteric bursitis is a very common source of lateral hip pain caused by repetitive trauma secondary to iliotibial band tracking over the trochanteric bursa.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with point tenderness over the greater trochanter.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is conservative with NSAIDs, stretching, physical therapy and corticosteroid injections.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often occurs in female runners",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Is associated with training on **banked surfaces**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "repetitive trauma caused by **iliotibial band tracking over trochanteric bursa**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3098/images/anatomy.jpg",
                      "caption": "anatomy"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "can irritate the bursa causing inflammation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Trochanteric bursa is superficial to the hip abductor muscles and deep to the iliotibial band",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3098/images/buritis.jpg",
              "caption": "anatomy of bursa"
            }
          ],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lateral sided hip pain**, although hip joint is not involved",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain with palpation over greater trochanter",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3098/images/painsite.jpg",
                  "caption": "pain site"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will be unremarkable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will show increased signal in bursa due to inflammation on T2 sequence",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3098/images/mritroch2.jpg",
                  "caption": "MRI troch bursitis"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "NSAIDS, stretching, PT including modalities, corticosteroid injections",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line treatment is always conservative",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open vs arthroscopic trochanteric bursectomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "is done only after conservative measures fail",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
