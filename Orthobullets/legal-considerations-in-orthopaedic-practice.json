{
  "title": "Legal Considerations in Orthopaedic Practice",
  "url": "https://www.orthobullets.com/basic-science/9074/legal-considerations-in-orthopaedic-practice",
  "subtitle": "Updated: Sep 15 2026",
  "sections": [
    {
      "text": "Informed Consent",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Components",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "patients must be provided with all information needed to make an informed decision",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "diagnosis or medical problem for which treatment is being recommended",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "who will be performing surgery",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "surgeons who have tested positive for HIV/HBV/HCV should disclose this to the patient at the time of scheduling of an \"exposure prone\" procedure",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "description of the proposed treatment or procedure, including its purpose, duration, methods, and implements used, as well as the probability of success",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "origin of surgical implants should be discussed with patients",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "this may have implications for their use based on a patient's religious background",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "in Hinduism, use of bovine-derived implants should be discussed",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "in Judaism and Islam, use of porcine-derived implants should be discussed",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "all material risks of the procedure or treatment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "any reasonable alternatives to the proposed procedure",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "risks of not being treated",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Special situations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Health Information Portability and Accountability Act (HIPAA)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "patient consent is not needed when communicating HIPAA-protected information to other treating providers",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "clinical trials",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "IRB approval for obtaining informed consent from patients enrolled in clinical trials is required",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "IRB approval is not required for quality improvement studies used for internal purposes only",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "purpose of the IRB is to ensure the rights and welfare of human subjects participating in research",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "elective procedures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "informed consent for elective surgical procedures is best obtained in the office/clinic setting a few days prior to scheduled procedure",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "emergent procedures in absence of legal consent",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "confirm necessity of procedure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "in life-threatening injuries requiring surgical intervention but without available legal consent, the surgeon should confirm and document the necessity of care with a fellow orthopaedic surgeon or colleague",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "in non-life threatening injuries, consent must be obtained prior to surgical intervention (e.g. language barrier, pediatric patient)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "non-consentable patients",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "legal guardians have highest precedence",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "\"next of kin\" precedence has been established to assist in determining order of consent: spouse, children (in no order), parents, siblings, grandchildren",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Patient-physician relationship",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "a formal complaint that has been filed by a patient requires the physician to provide a written response to the medical board including all relevant medical records",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "termination of care can be initiated by the physician with due process",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "the patient must be notified in writing the relationship with be terminated",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "a grace period of 30-45 days of continued care to allow the patient to arrange for further treatment",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "termination without a grace period is considered abandonment",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Physician Errors",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Communication errors",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "leading cause of wrong-side surgeries, medication errors, diagnostic delays, or loss to follow-up",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "results in increased treatment costs, treatment delays, and complications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "Crew Resource Management",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "has been shown to improve communication and team dynamics",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "has led to an improvement in patient safety and team morale",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Wrong site surgery",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "prevention",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "involve the patient in identifying correct side in the pre-operative area and prior to induction",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "display pertinent imaging in the operating room",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "mark the correct site with the surgeon's initials visibly in the surgical field",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "perform a time-out with the operating room team prior to incision",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "response when performed",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "acknowledge error with immediate discussions with the family",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "apologize and accept responsibility, but do not place blame",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Surgical errors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prevention",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "surgical \"time-out\"",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "according to JCAHO, should include the following",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "identify correct patient, site, and side",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "verify the correct procedure",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "all members of the team should be present for the time out; alternatively, it can be repeated",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "surgical safety checklists",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "WHO implementation began in 2009",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9074/images/screen_shot_2017-07-04_at_9.01.43_pm.jpg",
                          "caption": "Checklist"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "results in measureable improvements in",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "surgical mortality",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "in-hospital complications",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "adherence to surgical plan in OR crisis situations (e.g., massive hemorrhage, cardiac arrest)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "surgeon is most effective OR team member at reducing complications when using surgical checklist and \"time-out\"",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "disclosure",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "surgeons have an ethical obligation to disclose surgical errors to patients, particularly when errors have surgical or clinical implications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Medication prescribing errors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reduced when physicians use computerized order entry",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Medical documentation errors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "altering the medical record for any reason is illegal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "no one has the authority to authorize a physician to alter the medical record",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "errors can be noted and addendums can be added",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Second opinions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the second opinion surgeon is ethically required to disclose the effect of medical errors on patient outcome",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "only the patient can unilaterally decide to transfer care to a second surgeon",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "the surgeon is not ethically allowed to seek out transfer of care of a patient",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Litigation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "medical liability lawsuits involving orthopaedic surgeons increased by 13% from 2003 to 2008",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "thought to be related to the aging population",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "compared to other specialties, orthopaedic surgery has the 7th highest # of lawsuits",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "~33% of all orthopaedic surgery claims result in payment to plaintiffs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "average cost of defending orthopaedic surgery claims is ~$47,000 USD",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Causes of lawsuits (as of 2008)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "\"improper performance\" makes up 45% of lawsuits",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "most commonly associated procedures operative procedures of joint structures (not including spinal fusion) open reduction of dislocation closed reduction of fractures operative procedures on bones operative procedures on cranial and peripheral nerves",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "most commonly associated clinical diagnoses osteoarthritis (21%) disorder of joint, not including arthritis fracture of femur",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Legislation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anti-Kickback Statute (1987)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "A criminal law that prohibits the knowing and willful payment of remuneration to induce or reward patient referral or the generation of business involving any item or service payable by Federal healthcare programs",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Stark Law (1993)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "A federal regulation that prohibits self-referral of physicians to organizations with which they have a financial relationship.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Patient Protection and Affordable Care Act (2010)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "provides numerous rights and protections that make health coverage more fair, easier to understand, and more affordable",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Physician Payments Sunshine Act (2010)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "requires collection and reporting of financial relationships between physicians/teaching hospitals and businesses (manufacturers of drugs, devices, medical supplies)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "all payments > $10 must be reported to Centers for Medicare and Medicaid Services",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Physician Impairment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Defined as the inability or impending inability to practice according to accepted standards due to substance use, abuse, or dependency/addiction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Surgeons (resident, fellow or attending) who discover chemical impairment, dependence, or incompetence of a colleague or supervisor has a responsibility to ensure that the problem is identified and treated",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Medical Negligence",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Negligence is the failure to provide the standard of health care resulting in medical injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "A second-opinion physician has an ethical obligation, but not a legal obligation, to disclose if the standard of care has been breached by a treating physician",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Successful patient-plaintiff lawsuits for medical negligence require that all of the following 4 elements be alleged and proven in a court of law",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**duty**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "obligation to provide care that meets the professional standard of care, i.e. the same standard of care ordinarily executed by surgeons in the same medical specialty",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**breach of duty**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "occurs when action or failure to act deviates from the standard of care",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**causation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "established if it is demonstrated that failure to meet the standard of care was the direct cause of the patient’s injuries",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**damages**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "monies awarded as compensation for injuries sustained as the result of medical negligence",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Workers Compensation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Principles",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "maximum medical improvement is reached when further restoration of function is no longer anticipated, allowing patients to settle their claim",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "ability of patients to choose their own physician varies according to statutes of each state",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Legal definitions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**impairment**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "loss of function resulting from an anatomic or physiologic derangement",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**disability**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "limitation of an individual’s capacity to meet certain personal social or occupational demands",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Physician Employment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Independent contractor",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "relationship",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "employer influences the outcome",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "contractor determines the methods and means of achieving result of work",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "pay and benefits",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "employer does not pay taxes, provide insurance, or offer retirement benefits",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
