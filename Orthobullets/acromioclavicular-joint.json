{
  "title": "Acromioclavicular Joint",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3033/acromioclavicular-joint",
  "subtitle": "Updated: Jun 25 2021",
  "sections": [
    {
      "text": "AC joint",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the AC joint is a diarthrodial joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fibrocartilaginous intraarticular disc is located between the osseous segments",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Motion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "majority of motion is from the bones, not through the joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "clavicle rotates 40-50° posteriorly with shoulder elevation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "8° of rotation through AC joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "remainder from scapular rotation and sternoclavicular motion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "joint itself is limited to gliding motions only",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**acromioclavicular ligament**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "provides horizontal stability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "has superior, inferior, anterior, and posterior components",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "superior ligament is strongest, followed by posterior",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**coracoclavicular ligaments** (trapezoid and conoid)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "provides vertical stability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "trapezoid inserts **3 cm** from end of clavicle",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "stabilizer against horizontal and vertical loads",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "conoid inserts **4.5 cm** from end of clavicle in the posterior border",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "more important ligament",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "vertical stabilizer of AC joint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "normal CC distance (superior coracoid to inferior clavicle) is 11-13mm",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**deltotrapezial fascia, capsule, deltoid and trapezius**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "act as additional stabilizers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
