{
  "title": "Pseudosubluxation of the Cervical Spine",
  "url": "https://www.orthobullets.com/spine/2048/pseudosubluxation-of-the-cervical-spine",
  "subtitle": "Updated: Oct 18 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pseudosubluxation of the cervical spine is a physiologic radiographic variant due to the horizontal nature of the cervical facet joints found in young children",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with a relative anterior translation of C2 on C3 (up to 4 mm) that resolves with cervical spine extension",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is observation as the condition resolves when the cervical facet joints become more vertical with age",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "~20% of children admitted for polytrauma will demonstrate this incidental finding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "no associations with gender, trauma, intubation status, or injury severity have been demonstrated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "seen in children **<8 y/o**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**C2 on C3 is the most common location**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "C3 on C4 is the second most common location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by the **horizontal nature of the facet joints** at younger ages",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "facet joints become more vertical with age",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lateral radiograph with flexion and extension views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**reduction of subluxation with extension** x-rays",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "absence of anterior soft-tissue swelling (usually seen with a traumatic cause)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "measurements",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Swischuk's line**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2048/images/lateral%20xray%20pseudosubluxation.jpg",
                      "caption": "Shows Swischuk's line in pseudosubluxation."
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "spinolaminar line drawn from spinolaminar point on C1 to C3",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "spinolaminar point on C2 should be within 1.5 mm of the spinolaminar line",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "helpful to differentiate pseudosubluxation from a true injury",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "True traumatic subluxation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "factors that support pseudosubluxation as opposed to true traumatic subluxation include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**reduction of subluxation** with neck extension",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "spinolaminar line **within 1.5mm of C2**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "no **history or physical** findings of significant trauma",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "absence of anterior soft-tissue swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "true traumatic subluxation may be caused by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Hangman's fracture",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2048/images/hangman%20fracture.jpg",
                      "caption": "Radiograph demonstrating a hangman fracture"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "pseudosubluxation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "no association with increased morbidity or mortality",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
