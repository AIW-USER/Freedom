                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Posterior band of MCL ruptured, anterior band intact (attached to anteromedial facet)",
                      "table": null,
                      "images": [],
