    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute reduction followed by immobilization at 90° flexion for 5-7 days",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute elbow dislocations",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "following reduction assess post-reduction stability",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "place in posterior splint for 5-7 days, with elbow at 90 degrees of flexion and forearm appropriately positioned based on post-reduction stability",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "LCL disrupted, but MCL intact",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "splint in full pronation (tightens lateral structures)",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "LCL + MCL disrupted",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "splint in neutral",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "will not splint in full supination (for MCL rupture only) as the LCL is always disrupted in PLRI",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "early active ROM following splint removal (+/- extension block)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "full supination/pronation from 90° to full flexion",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "progress with increasing extension by 30° weekly, but with the forearm in full pronation; after 6 weeks full supination in extension allowed",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "bracing, extensor strengthening, activity modification w/ avoidance of gravity varus positions",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "mild, chronic PLRI",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "low-demand patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open reduction, fracture fixation, LUCL repair",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "osteochondral fragment or soft-tissue entrapment prevents concentric reduction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "complex dislocation (associated fractures are present)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**acute** instability",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "open & arthroscopic techniques described",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "LUCL reconstruction w/ graft",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**chronic PLRI**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Reconstruction of LUCL complex**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**approach**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "posterior mid-line",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**Kocher approach**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**graft types**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "autograft or allograft tissue may be used",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "palmaris longus most common",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "gracilis and triceps fascia also utilized",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**graft configuration**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "tendon graft tied to itself over lateral column after placing through tunnel in supinator crest & then weaving through \"Y\" tunnel configuration in humerus",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "it is critical that the graft covers > posterior 25% of the radial head to create a sling",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "graft can be plicated to capsule to maintain position and capsule plicated to augment repair",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**graft secured with arm in neutral rotation and 45° of flexion**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**graft fixation**",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "graft may be \"docked\" on humerus with sutures exiting \"Y\" tunnels or on both humeral and ulnar sides with interference screws (or sutures tied over bone - overlay technique)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3129/images/docking.jpg",
                      "caption": "Lateral elbow x-ray with demonstration of LUCL docking technique"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "coronoid fracture ORIF / anterior capsular laxity",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "large fragments should be fixed with screw from dorsal ulnar surface (aided by ACL type guide to improve accuracy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "small fragments should be excised but a suture plication of the anterior capsule to the broken tip increases stability and can be placed with the aid of ACL type guide",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3129/images/coronoid_fixation.jpg",
                      "caption": "Illustration demonstrating utilization of an ACL guide for coronoid fixation"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "protected from varus stress across the elbow and shoulder abduction post-operatively (locked hinge brace)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "early range-of-motion encouraged (+/- extension block with progressive gain to full extension and supination by 6-8 weeks)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "important to keep forearm in **full pronation during ROM** until after 6 weeks (as above)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Recurrent instability**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "3-8% incidence",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Infection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Cutaneous nerve injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "decreased risk with posterior mid-line approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Decreased ROM**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
