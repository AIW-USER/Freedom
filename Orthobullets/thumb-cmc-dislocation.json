    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis confirmed by history, physical exam, and radiographs",
              "table": null,
              "images": [],
