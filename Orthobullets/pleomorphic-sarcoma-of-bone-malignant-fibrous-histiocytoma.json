    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative(similar to osteosarcoma)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neoadjuvant chemotherapy, wide resection, postoperative chemotherapy +/- radiation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "standard of care",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chemotherapy",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "preoperative chemotherapy given for 8-12 weeks followed by maintenance chemotherapy for 6-12 months after surgical resection",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "surgical resection",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "correct surgical option is based on the location of the tumor and the feasibility of obtaining a wide surgical margin",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "wide excision or amputation have been found to have a higher 5-year survival rate than those who received intralesional or marginal excision",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "trend towards limb salvage whenever possible",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "options include endoprosthetic arthroplasty, resection arthrodesis, allograft reconstruction and rotationplasty",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "radiation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "incomplete or questionable margins in order to reduce risk of local recurrence",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "adjunct to traditional chemotherapy and surgical regimens",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "50% - 60% survival at 5 years",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Worse prognosis with secondary MFH compared to primary lesions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Pulmonary metastasis common in up to 30%",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Good response (> 90% tumor necrosis) to neoadjuvant chemotherapy found to have a much better prognosis",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Age younger than 40 years associated with improved disease-free survival rate",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
