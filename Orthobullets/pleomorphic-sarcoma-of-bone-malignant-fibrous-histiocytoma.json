        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**pleomorphic spindle cells and histiocytic cells** in storiform pattern",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8030/images/Histology%20B%20-%20moderate%20power%20-%20Parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "malignant multinucleated **giant cells with grooved or indented nuclei**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8030/images/Histology%20A%20-%20high%20power%20-%20Parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "areas of chronic inflammatory cells",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "variable collagen production",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "fibrous fascicles radiate from focal hypocellular areas",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "hemorrhagic and necrotic regions not infrequent; suggest high-grade lesion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
