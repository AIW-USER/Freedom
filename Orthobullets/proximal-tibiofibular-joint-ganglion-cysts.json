  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Proximal tibiofibular joint ganglion cyst is a rare, mucin-filled synovial cyst. They typically are seen in adults and present with lateral knee pain, fullness, and neurological symptoms due to compression of the common peroneal nerve.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is often initially made based on typical MRI findings and is confirmed histologically.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Nonoperative treatment is indicated for asymptomatic lesions. Operative treatment is indicated for persistent symptoms or associated neurological deficits.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
