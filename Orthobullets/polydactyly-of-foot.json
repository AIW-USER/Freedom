{
  "title": "Polydactyly of Foot",
  "url": "https://www.orthobullets.com/pediatrics/4078/polydactyly-of-foot",
  "subtitle": "Updated: Jun 15 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Polydactyly of Foot is a common congenital autosomal dominant condition caused by the failure of differentiation in the apical ectodermal ridge during the first trimester of pregnancy that presents with extra digits of the foot.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with the presence of extra digits in the foot.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually observation. Surgical treatment is indicated for painful malaligned toes that normal prevent shoe wearing.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs in 1 in 500 births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "postaxial (lateral side of the foot) polydactyly is most common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in African-Americans than caucasians",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "failure of differentiation in the apical ectodermal ridge during first trimester of pregnancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually transmitted as autosomal dominant (positive family history)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedics manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may involve extra phalanges or even duplicated rays",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4078/images/photo%201.jpg",
                      "caption": "Polydactyly"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4078/images/photo%202.jpg",
                      "caption": "Polydactly"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Venn-Watson Classification of Polydactyly",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4078/images/poly.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "post-axial (lateral side of the foot)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "'Y' metatarsal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "'T' metatarsal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "wide metatarsal head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "complete duplication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "central (not part of the original classification)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "duplication of the second, third or fourth toe",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pre-axial (medial side of the foot)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "short block first metatarsal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "wide metatarsal head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extra digits in the foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4078/images/polyrad.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "metatarsals are present on radiographic views at birth, but generally radiographic evaluation delayed to allow full ossification of the phalanges for surgical planning",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "postaxial or central polydactyly",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "with proper alignment of the digit may remain in place unless the foot is significantly widened (rare)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ablation of extra digit (usually border digit)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "malaligned toe, particularly preaxial polydactyly",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "perform at **9-12 months of age** if possible",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "small skin tags can be removed in newborn nursery",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Natural history of disease",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may cause problems with shoe fitting and angular deformity of the toes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
