    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, clicking, **mechanical locking**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "often becomes symptomatic in adolescence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanical symptoms most pronounced in extension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of knee",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3007/images/0303284c-538d-4001-bb10-33e009e2e580_discoid_meniscus..jpg",
                  "caption": "AP radiograph of the knee showing widening of the lateral joint space and squaring of the lateral femoral condyle."
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "**widened joint space** (up to 11mm)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**squaring of lateral condyle**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**cupping of lateral tibial plateau**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "hypoplastic lateral intercondylar spine",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "study of choice for suspected symptomatic meniscal pathology",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "diagnosis can be made with **3 or more 5mm sagittal images with meniscal continuity (\"bow-tie sign\")**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3007/images/11_moved.JPG",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "sagittal MRI will show abnormally thick and flat meniscus",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3007/images/2501ort76-03sag_proton_density[1]_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "coronal MRI will show thick and flat meniscal tissue extending across entire lateral compartment",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3007/images/2495ort76-04[1]_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Symptomatic cases may reveal underlying meniscus tear",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "asymptomatic discoid meniscus without tears",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "partial meniscectomy and saucerization",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "pain and mechanical symptoms",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "meniscal tear or meniscal detachment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "obtain anatomic looking meniscus with debridement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "repair meniscus if detached (Wrisberg variant)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "meniscal instability is frequently present",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "recent literature suggest anterior horn instability is most common",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
