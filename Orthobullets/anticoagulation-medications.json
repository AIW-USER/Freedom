    {
      "text": "ASA (acetylsalicylic acid)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**thromboxane function**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "under normal conditions thromboxane is responsible for the **aggregation of platelets** that form blood clots",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**prostaglandins function**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "prostaglandins are local hormones produced in the body and have diverse effects including",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "the **transmission of pain** information to the brain",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "modulation of the **hypothalamic thermostat**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "inflammation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Mechanism of ASA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inhibits the production of prostaglandins and thromboxanes through **irreversible inactivation of the cyclooxygenase enzyme within platelets**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "acts as an acetylating agent where an acetyl group is covalently and irreversibly attached to a serine residue in the active site of the cyclooxygenase enzyme.",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "this differentiates aspirin different from other NSAIDs which are reversible inhibitors",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "renal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Unfractionated Heparin (SQ)",
      "table": null,
