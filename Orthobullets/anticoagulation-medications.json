              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Low Molecular Weight Heparin",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "molecular name: **enoxaparin**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "trade name: Lovenox, Clexane",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "has advantage of not requiring lab value monitoring",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "LMWH acts in several sites of the coagulation cascade, with its principal action being inhibition of **factor Xa**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "reversed by protamine",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "renal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bleeding",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Fondaparinux",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "trade name: **Arixtra**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "has advantage of not requiring lab value monitoring",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indirect factor **Xa inhibitor (acts through antithrombin III)**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "renal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "studies show decreased incidence of DVT when compared to enoxaparin in hip fx and TKA patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "highest bleeding complications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not to be used in conjunction with epidurals",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Warfarin",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism of anticoagulation",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "inhibits **vitamin K 2,3-epoxide reductase**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "prevents reduction of vitamin K epoxide back to active vitamin K",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "vitamin K is needed for gamma-carboxylation of glutamic acid for factors",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**II** (prothrombin), **VII** (first affected), **IX, X**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "protein C, protein S",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Monitoring",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "target level of INR (international normalized ratio) is 2-3 for orthopaedic patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "not achieved for 3 days after initiation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Reversal",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**vitamin K** (takes up to 3 days)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**fresh frozen plasma** (acts immediately)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "difficult to dose requires the frequent need for INR lab monitoring",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can have adverse reaction with other drugs including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rifampin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "phenobarbital",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diuretics",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cholestyramine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Rivaroxaban (Xarelto)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "others in the same class include apixaban (Eliquis) and edoxaban (Savaysa or Lixiana)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mechanism of action of these drugs can be deduced from the name.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Rivaro(Identifier)-xa(FactorXa)-ban(inhibitor)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "direct Xa inhibitor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "liver",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Antidote",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no current antidote",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "andexanet alpha being investigated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Half-life",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "8-hours (12-hours for apixaban)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "urgent surgical procedures delayed until half-life spanned from last dose",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Dabigatran (Pradaxa)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reversible direct thrombin (factor IIa) inhibitor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "renal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Antidote",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "idarucizumab (FDA approved Oct 2015)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "GI upset",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Tranexamic acid (TXA)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "an **antifibrinolytic that** promotes and stabilizes clot formation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**studies have shown that TXA** reduce perioperative blood loss and transfusion in THA and TKA",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9054/images/8621aa81-65db-4c05-bef2-7f58708ff5d4_txa..jpg",
              "caption": "TXA mechanism of action"
            }
          ],
          "importance": "3",
          "children": [
            {
              "text": "synthetic derivative of the amino acid lysine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**competitively inhibits** the activation of plasminogen by binding to the lysine binding site",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "at high concentrations, is a non-competitive inhibitor of plasmin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "has roughly 8-10 times the antifibrinolytic activity of ε-aminocaproic acid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Dosing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intravenous",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "10-20 mg/kg initial bolus dose followed by repeated doses of the initial TXA dose every 3 hours for 1-4 doses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "10-20mg initial bolus followed either by an infusion of 1-10 mg/kg/hr for 4-30 hours",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "topical application is as effective as IV",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**sprayed** onto open wound at completion of procedure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**no detectable** TXA in the bloodstream after topical application",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "oral adminsitration is as effective as IV",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "1.95g given 2 hours preoperatively",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "<5% of the drug is metabolized",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "biological half-life in joint fluid is 3h, **present in tissues for up to 17h**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Risks",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "systematic review shows **no increase in thromboembolic events**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**relatively few adverse reactions have been reported in the arthroplasty literature**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Herbal Supplements",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Increased bleeding",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**gingko, ginseng, and garlic** have been found to increase the rate of bleeding",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "related to effect on platelets",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "proper history taking can avoid complications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Increased warfarin effect (increase INR)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**omega-3 fish oil**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "affects platelet aggregation and vitamin K dependent coagulation factors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Reduced warfarin effect (reduces INR)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**coenzyme Q10**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**green tea**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "direct warfarin antagonist (reduces INR)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**St John's wort**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "increases catabolism of warfarin (reduces INR)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
