              "children": []
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hepatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
