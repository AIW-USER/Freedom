          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "binds and enhances ability of **antithrombin III to inhibit factors IIa, III, Xa**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Reversal",
          "table": null,
          "images": [],
          "importance": "3",
