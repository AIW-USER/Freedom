{
  "title": "Closed Cervical Traction",
  "url": "https://www.orthobullets.com/spine/2074/closed-cervical-traction",
  "subtitle": "Updated: Oct 4 2025",
  "sections": [
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "subaxial cervical fractures with malalignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "unilateral and bilateral facet dislocations",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "displaced odontoid fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "select hangman's fractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "C1-2 rotatory subluxation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patient who is not awake, alert, and cooperative",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "presence of a skull fracture may be a contraindication",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Patient position",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Preferred setting",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "emergency room, operating room, or ICU for close observation and frequent fluoroscopy or radiographs",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Patient position",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "supine with reverse Trendelenburg, or the use of arm and leg weights, can help prevent patient migration to the top of the bed with the addition of weights",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Sedation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "small doses of diazepam may be administered to aid in muscle relaxation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "patient must remain awake and able to converse",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Pin Placement",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pin placement (Gardner-Wells pins)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "pin placement is 1 cm above pinna, in line with the external auditory meatus, and below the equator of the skull",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "if the pin is placed too anterior, the temporalis muscle, superficial temporal artery, and superficial temporal vein are at risk",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "an anterior pin will apply an extension moment to the cervical spine",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "if the pin is placed too posterior, a flexion moment may be applied to the cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "a posterior pin with a flexion moment may facilitate reduction of a facet dislocation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Pin tightness",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "On Gardner-Wells tongs, pins are tightened until a spring-loaded indicator protrudes 1 mm above the surface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "this is the equivalent of 139 newtons (31 lbs) of force",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "overtightening by 0.3 mm increases the force to 448 newtons (100 lbs)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "failure of the temporal bone occurs at 965 ± 200 newtons (216 lbs)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "in contrast, Mayfield pins are tightened to 60 lbs",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "overtightening of the pins can result in penetration of the inner table of the calvarium",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "this may cause cerebral hemorrhage or abscess",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pin strength",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "stainless steel pins have higher failure loads than those made of titanium or MRI-compatible graphite",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "should be used with >50 lbs of traction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Reduction with Serial Traction",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Serial traction",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "an initial 10 lbs is applied",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "weights are increased by 10-lb increments every 20 minutes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "serial exams and radiographs are obtained after each weight is applied",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "maximal weight is controversial",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "some authors recommend weight limits of 70 lbs",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "recent studies report safety up to 140 lbs",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Reduction maneuvers",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "reduction of a unilateral facet dislocation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "reduction maneuver is performed after facet is distracted to a perched position",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "maintain axial load and rotate the head 30-40° past midline in the direction of the dislocation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "stop once resistance is felt",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "confirm with radiographs",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "reduction of bilateral facet dislocation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "reduction maneuver is performed after facet is distracted to a perched position",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "palpate the stepoff in the spinous process posteriorly and apply an anteriorly directed force caudal to the level of the dislocation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "rotate the head 40° beyond midline in one direction, and then rotate 40° in the other direction while axial traction is maintained",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Failure to reduce",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "a bilateral irreducible facet dislocation is unstable and should be treated with urgent open reduction after MRI is performed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Change in neurologic exam",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "with any change in the neurological exam, the weights should be removed and MRI should be obtained",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
