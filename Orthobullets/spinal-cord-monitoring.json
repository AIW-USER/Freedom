{
  "title": "Spinal Cord Monitoring",
  "url": "https://www.orthobullets.com/spine/9023/spinal-cord-monitoring",
  "subtitle": "Updated: Sep 9 2024",
  "sections": [
    {
      "text": "Forms",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Spinal cord monitoring is a method to detect injury to the spinal cord during operative procedures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common forms are",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**EMG** (electromyography)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**SEP** (somatosensory evoked potentials)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "25% sensitive, 100% specific",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**MEP** (motor evoked potentials)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "100% sensitive, 100% specific",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Spinal cord pathways",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**sensory (afferent)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "dorsal column",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "spinothalamic tract",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**motor (efferent)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "lateral corticospinal tract",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "ventral corticospinal tract",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**anterior spinal artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "primary blood supply to anterior 2/3 of spinal cord, including both the lateral corticospinal tract and ventral corticospinal tract",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**posterior spinal artery (right and left)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "primary blood supply to the dorsal sensory columns",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Sensory evoked potentials (SEPs)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "monitor integrity of dorsal column sensory pathways of the **spinal cord**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Technique",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "signal initiation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lower extremity usually involves stimulation of posterior tibial nerve behind ankle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "upper extremity usually involves stimulation of ulnar nerve",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "signal recording",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "transcranial recording of somatosensory cortex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reliable and unaffected by anesthetics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**not reliable** for monitoring the integrity of the **anterior** spinal cord pathways",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9023/images/senory%20with%20infarct.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "reports exist of an ischemic injury leading to paralysis despite normal SEP monitoring during surgery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Intraoperative considerations",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "loss of signals during distraction mandates immediate removal of device and repeated assessment of signals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**decrease in amplitude of 50% and/or 10% prolongation in latency is considered a significant change**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Motor Evoked Potentials (MEP)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "monitor integrity of lateral and ventral corticospinal tracts of the **spinal cord**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Technique",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "signal initiation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "transcranial stimulation of motor cortex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "signal recording",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "muscle contraction in extremity (gastroc, soleus, EHL of lower extremity)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "effective at detecting a ischemic injury (loss of anterior spinal artery) in **anterior** 2/3 of spinal cord",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often unreliable due to **effects of anesthesia**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Intraoperative considerations",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "loss of signals during distraction mandates immediate removal of device and repeated assessment of monitoring signals",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": ">100 V increase in threshold is suggestive of an early injury",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": ">50% decrease in MEP amplitude is considered significant",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Mechanical Electromyography (spontaneous)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "monitor integrity of **specific spinal nerve roots**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Technique",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "concept",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "microtrauma to nerve root during surgery causes depolarization and a resulting action potential in the muscle that can be recorded",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "contact of a surgical instrument with nerve root will lead to \"**burst activity**\" and has no clinical significance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "significant injury or traction to a nerve root will lead to \"**sustained train**\" activity, which may be clinically significant",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "signal initiation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mechanical stimulation (surgical manipulation) of nerve root",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "signal recording",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "muscle contraction in extremity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows monitoring of specific nerve roots",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be overly sensitive (i.e. sustained train activity does not necessarily reflect a nerve root injury)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Electrical Electromyography (triggered)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows detection of a breached pedicle screw",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Technique",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "concept",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bone conducts electricity poorly",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "an electrically stimulated pedicle screw that is confined to bone will not stimulate a nerve root",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "if there is a breach in a pedicle, stimulation of the screw will lead to activity of that specific nerve root",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "signal initiation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "electrical stimulation of placed pedicle screw",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "signal recording",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "muscle contraction in extremity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**thresholds <8 mA may be indicative of a breach**",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows monitoring of specific nerve roots",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be overly sensitive (i.e. sustained train activity does not necessarily reflect a nerve root injury)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
