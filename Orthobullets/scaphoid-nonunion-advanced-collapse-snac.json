                        {
                          "src": "https://upload.orthobullets.com/topic/12119/images/b3558654-1112-415b-ae02-de963518349d_snac_1..jpg",
                          "caption": "SNAC Wrist, Stage I"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Scaphocapitate arthrosis in addition to Stage 1",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
