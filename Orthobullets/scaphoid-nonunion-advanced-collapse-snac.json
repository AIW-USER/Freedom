    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "reduced grip and pinch strength",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "stiffness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "stiffness with extension and radial deviation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "localized tenderness of the radioscaphoid articulation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decreased wrist motion on extension and radial deviation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
