    {
      "text": "Phases of Throwing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "There are 5 main phases of throwing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**wind up** (see below)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**cocking**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**acceleration**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**deceleration**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**follow-through**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**scapula must work in concert with humerus** to maintain glenohumeral stability",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "the entire throwing motion takes approximately **2 seconds**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "with wind up and acceleration phases taking approximately 75% of time (1.5 seconds)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "1. Wind Up",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Description",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "minimal force on the shoulder during first stage",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Muscle activity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rotator cuff muscles are inactive** during this phase",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "2. Cocking",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Sometimes described as 2 sub-phases",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early cocking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "peak muscle activation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**deltoid**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "late cocking",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "high torque phase with maximal shoulder external rotation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "most likely to cause **internal shoulder impingement**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "elbow valgus stress is greatest in late cocking phase",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "peak muscle activation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**supraspinatus**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**infraspinatus**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**teres minor**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**FDS and FCU muscles provide local dynamic stability of the elbow during late cocking**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**protective against injury to UCL**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated pathology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Medial ulnar collateral ligament elbow injury",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "internal Impingement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**GIRD (glenohumeral internal rotation defect)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "SLAP tears (\"Peel-back\" mechanism during late cocking)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
