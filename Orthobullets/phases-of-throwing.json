    },
    {
      "text": "4. Deceleration",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Description",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "center of gravity moves over plantar foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Muscle activity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**eccentric contraction of all muscles is** required to slow down arm motion",
              "table": null,
              "images": [],
              "importance": "1",
