{
  "title": "Ganglion Cysts",
  "url": "https://www.orthobullets.com/hand/6086/ganglion-cysts",
  "subtitle": "Updated: Apr 5 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ganglion Cysts are mucin-filled synovial cysts and are the most common masses found in the wrist and hand.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made clinically with a firm and well circumscribed mass that transilluminates.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment can be observation for majority of ganglions. Surgical excision is indicated for ganglion cysts associated with severe symptoms or neurovascular manifestations.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**most common** hand mass (60-70%)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dorsal carpal (70%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "originate from SL articulation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "volar carpal (20%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "originate from radiocarpal or STT joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "volar retinacular (10%)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "originate from herniated tendon sheath fluid",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "dorsal DIP joint (**mucous cyst**, associated with Heberden's nodes)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6086/images/mucous%20cyst.jpg",
                  "caption": "Mucous cyst on right index finger"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "may also occur in the lower extremity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most commonly about the knee",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mucoid degeneration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "synovial herniation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "filled with fluid from tendon sheath or joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no true epithelial lining",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "median or ulnar nerve compression",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "may be caused by volar ganglion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "hand ischemia due to vascular occlusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be caused by volar ganglion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may cause issues with cosmesis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**transilluminates (transmits light through tissue)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "firm and well circumscribed",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "often fixed to deep tissue but not to overlying skin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "vascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Allen's test to ensure radial and ulnar artery flow for volar wrist ganglions**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "normal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not routinely indicated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "shows well marginated mass with homogenous fluid signal intensity",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6086/images/wrist%20ganglion%20mri.jpg",
                      "caption": "Shows Dorsal Wrist Ganglion Cyst"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful for differentiating cyst from vascular aneurysm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may provide image localization for aspiration while avoiding artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Biopsy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not routinely indicated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "will show mucin-filled sac with no true epithelial/synovial lining",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first line of treatment in adults",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "children",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "76% resolve within 1 year in pediatric patients",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "closed rupture",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "home remedy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "high recurrence",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "aspiration",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "second line of treatment in adults with dorsal ganglions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "aspiration typically avoided on volar aspect of wrist due to radial artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "higher recurrence rate (50%) than surgical resection but minimal risk so reasonable to attempt",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical resection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "requires adequate exposure to identify origin and allow resection of stalk and a portion of adjacent capsule",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "at dorsal DIP joint: must resect underlying osteophyte",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "results",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**volar ganglions** have higher recurrence after resection than dorsal ganglions (15-20% recurrence)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "With aspiration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "infection (rare)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neurovascular injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "With excision",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neurovascular injury (radial artery most common)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "injury to scapholunate interosseous ligament",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stiffness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
