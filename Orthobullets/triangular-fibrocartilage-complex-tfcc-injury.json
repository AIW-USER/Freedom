    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wrist pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "turning a door key often painful",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "positive \"fovea\" sign",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tenderness in the soft spot between the ulnar styloid and flexor carpi ulnaris tendon, between the volar surface of the ulnar head and the pisiform",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "95% sensitivity and 87% specificity for foveal disruptions of TFCC or ulnotriquetral ligament injuries",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "pain elicited with ulnar deviation (TFCC compression) or radial deviation (TFCC tension)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually negative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "zero rotation PA view evaluates **ulnar variance**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "dynamic pronated PA grip view may show pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Arthography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "joint injection shows extravasation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "has largely replaced arthrography",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tear at ulnar part of lunate indicates ulnocarpal impaction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sensitivity = 74-100%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Arthroscopy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most accurate method of diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "indicated in symptomatic patients after failing several months of splinting and activity modification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ulnocarpal abutment syndrome",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Ulnar styloid impaction syndrome",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "ECU tendonitis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Hook of hamate fracture",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Ulnar tunnel syndrome",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Pisotriquetral arthritis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization, NSAIDS, steroid injections",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**all acute Type I injuries**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "first line of treatment for Type 2 injuries",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**arthroscopic debridement**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**type 1A**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**diagnostic gold standard**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "arthroscopic repair",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "type 1B, 1C, 1D",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "best for ulnar and dorsal/ulnar tears",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "generally acute, athletic injuries more amenable to repair than chronic injuries",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "patient should expect to regain 80% of motion and grip strength when injuries are classified as acute (<3 months)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "ulnar diaphyseal shortening",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Type II with ulnar positive variance is > 2mm",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "advantage of effectively tightening the ulnocarpal ligaments and is favored when LT instability is present",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Wafer procedure",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "Type II with ulnar positive variance is < 2mm",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "type 2A-C",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "limited ulnar head resection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "type 2D",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Darrach procedure",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**contraindicated due to problems with ulnar stump instability**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Arthroscopic debridement**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "arthroscopic approach to the wrist",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "performed through combination of 3-4 and 6R portal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "maintain 2 mm rim peripherally otherwise joint can become unstable",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "not effective if patient has ulnar positive variance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "80% of patients obtain good relief of pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Arthroscopic repair**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "arthroscopic approach to the wrist",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "many techniques exist such as outside-in and inside-out",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "generally suture based repair",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "only works for peripheral tears where blood supply is present",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "patient immobilized for 6 weeks",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "ECU tendonitis from suture knot",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "dorsal sensory nerve injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Ulnar diaphyseal shortening**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "dorsal approach to the forearm",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "osteotomy of the diaphysis or metaphysis followed by plate fixation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "can address > 2 mm ulnar variance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "requires immobilization and time for fracture healing",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "can help tension the ulnocarpal ligaments",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "nonunion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "hardware irritation necessitating removal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Wafer procedure**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "dorsal approach to the forearm",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "ulnar cortex is not disrupted",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "do not extend bone removal into the DRUJ",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "intrinsic stability of ECU, TFCC, and ulnar periosteum obviate need for plate fixation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Limited ulnar head resection**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "arthroscopic approach to the wrist",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "removal of approximately 2-4 mm of bone under the TFCC",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "distal ulnar burred through central TFCC defect",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "can be technically difficult to obtain level shortening through TFCC window",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "only applicable when patient has < 2mm of ulnar variance",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Darrach procedure**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "dorsal approach to the forearm",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "resection of the distal 1-2cm of the distal ulna",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "TFCC should be approximated to the wrist capsule",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "salvage procedure for pain relief only",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "distal joint is unstable",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "ECU tendon can sublux over remaining ulna causing pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
