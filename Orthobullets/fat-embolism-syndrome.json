    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanical ventilation with high levels of PEEP (positive end expiratory pressure)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute fat emboli syndrome",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Prevention",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early fracture stabilization",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**early fracture stabilization (within 24 hours) of long bone fracture is most important factor in prevention of FES**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques to reduce the risk of fat emboli",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "overreaming of the femoral canal during a TKA",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "use of reamers with decreased shaft width reduces the risk during femoral reaming for intramedullary fixation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "use of external fixation for definitive fixation of long bone fractures in medically unstable patients decreases the risk",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fatal in up to 15% of patients",
          "table": null,
