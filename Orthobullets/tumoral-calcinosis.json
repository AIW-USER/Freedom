{
  "title": "Tumoral Calcinosis",
  "url": "https://www.orthobullets.com/pathology/8077/tumoral-calcinosis",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Tumoral Calcinosis is a rare, hereditary metabolic dysfunction of phosphate regulation associated with development of massive periarticular calcinosis in the extra-capsular soft tissues. Patients most commonly present with palpable lesions around the hip and shoulder.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with amorphous, cystic, circular, well-demarcated calcification in a periarticular location.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is observation for asymptomatic lesions. Surgical excision is indicated for symptomatic lesions associated with decreased function.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in **females** and **African-Americans**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "onset in childhood or early adolescence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "around joints, primarily the **hip** (**trochanteric bursa** is most common location) > **shoulder**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unknown",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inborn abnormality of **phosphorus** metabolism",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "FGF-23 defect leading to familial hyperphosphatemic tumoral calcinosis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mass or swelling typically around joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain secondary to compression of normal surrounding structures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "palpable mass around joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "amorphous, cystic, lobular (circular or oval) well-demarcated calcification in periarticular location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "direct involvement of the bones or joints is rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may demonstrate fluid-fluid levels within some of these masses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "calcium layering (\"sedimentation sign\")",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "or may have homogenous appearance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "reduced metabolic activity, lower likelihood of growth",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "diffuse, low signal intensity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bright, nodular pattern with alternating areas of high signal intensity and signal void",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may demonstrate fluid-fluid levels (as with CT)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radionuclide bone scan may reveal intense uptake in the calcific masses",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "normal or slightly elevated renal and parathyroid function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "normal or slightly elevated serum calcium, phosphorus, uric acid, and alkaline phosphatase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lobulated soft tissue masses with well-defined capsules and thick septae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "masses are filled with calcareous material (calcium phosphate, calcium carbonate and calcium hydroxyapatite) and fluid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differentials",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Calcinosis of renal failure** (secondary tumoral calcinosis)",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approximately 1% prevalence of periarticular masses",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "may occur independent of concomitant hyperparathyroidism",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "no radiologic/histologic differences with primary tumoral calcinosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "diagnosis is based on vitamin D levels, GFR, hyperphosphatemia, and history of chronic renal failure/long term dialysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Calcific tendinitis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "shoulder > hip > elbow > wrist > knee",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "occurs within tendon",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "no sedimentation of calcium (makes it different from tumoral calcinosis)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Synovial osteochondromatosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "occurs within joint/tendon sheath",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "\"rings and arcs\" and intra-articular location (makes it different from tumoral calcinosis)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Myositis ossificans and heterotopic ossification**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "not lobular",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "evolves rapidly from faint calcification to organized cartilage and bone in 6 weeks",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "late lesions of HO have well developed cortex and medullary cavity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Gout**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "may have hyperuricemia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "focal erosions of underlying bone",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**treatment of choice for non-symptomatic lesions**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "complete surgical excision",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "treatment of choice for symptomatic lesions",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "complete surgical excision is required to decrease the rate of local recurrence",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "results",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "risk of recurrence",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "if lesion is poorly circumscribed",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "if excision is performed while lesion is actively growing",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": []
    }
