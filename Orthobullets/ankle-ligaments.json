  "subtitle": "Updated: May 25 2025",
  "sections": [
    {
      "text": "Ankle Joint Osteology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ankle Joint",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tibial plafond",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "medial malleolus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral malleolus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "talus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "main motion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/plantar%20flexion_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "plantar flexion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "dorsiflexion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "secondary motions",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "inversion/eversion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "rotation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Distal tibiofibular joint",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "distal fibula",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "incisura fibularis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/fibular%20notch_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "concave surface of distal lateral tibia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fibular rotates within incisura during gait",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "mortise widens when ankle goes from plantar to dorsiflexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "syndesmosis screws limit external rotation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Joint reaction force",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ankle joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "5 times body weight with walking on level surfaces",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Ankle Ligament Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Primary ligaments of ankle include (see below for details)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Deltoid ligament",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Calcaneonavicular ligament (Spring Ligament)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Syndesmosis (includes AITFL, PITFL, TTFL, IOL, ITL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Anterior talofibular ligament (ATFL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Posterior talofibular ligament (PTFL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Calcaneal fibular ligament (CFL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Lateral talocalcaneal ligament (LTCL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Syndesmosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7005/images/posterior-inferior_tibiofibular_ligament_(pitfl).jpg",
              "caption": ""
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "responsible for integrity of ankle mortise",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Syndesmosis components",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/syndesmosis.jpg",
                  "caption": "syndesmosis"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**Anterior-inferior tibiofibular ligament** (AITFL)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**Posterior-inferior tibiofibular ligament** (PITFL)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "deep portion of this ligament sometimes reffered to as the inferior transverse ligament",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Transverse tibiofibular ligament**(TTFL)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**Interosseous ligament** (IOL)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "test to identify a syndesmosis injury include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "external rotation test",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/er%20stress%20test.jpg",
                      "caption": "External Rotation Stress Test"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "squeeze test",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/squeeze%20test.jpg",
                      "caption": "Squeeze Test"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**AP and mortise ankle radiographs**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "used to evaluate the tibiofibular clear space and tibiofibular overlap",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/tibfiboveralp.jpg",
                      "caption": "Tibfib overlap"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "tibiofibular clear space should be < 5 mm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "tibiofibular overlap for AP view > 10 mm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**weight bearing mortise view** is most accurate radiograph for diagnosis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**CT scan** is most accurate for assessment but true normals have not been validated and comparison to the uninjured side are helpful",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Clinical conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**high ankle sprain & syndesmosis injury**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**ankle fracture**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anterior Talofibular Ligament (ATFL)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary restraint to inversion in plantar flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "resists anterolateral translation of talus in the mortise",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakest of the lateral ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extends from the anteroinferior border of the fibula to the neck of the talus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "origin is 10mm proximal to tip of fibula",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "inserts directly distal to articular cartilage of the talus (18mm distal to joint line)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "runs 45°-90° to longitudinal axis of the tibia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**anterior drawer in 20° of plantar flexion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "test competency by anterior drawer in 20° of plantar flexion and compare to uninjured side",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "forward shift of more than 8 mm on a lateral radiograph is considered diagnostic for an ATFL tear",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stress radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more accurate in chronic injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can diagnose injury",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/atfl.jpg",
                      "caption": "ATFL"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "arthroscopic findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can confirm MRI imaging",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/arthroscopic%20view%20atfl.jpg",
                      "caption": "Arthroscopic image of ATFL tear"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "ultrasound",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more accurate than radiographs",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/us%20atfl.jpg",
                      "caption": "US image ATFL"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Clinical Conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**low ankle sprains**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Posterior Talofibular Ligament (PTFL)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "strongest of the lateral ligaments",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "plays only a supplementary role in ankle stability when the lateral ligament complex is intact",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "under greatest strain in ankle dorsiflexion and acts to limit posterior talar displacementwithin the mortise as well as talar external rotation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "if ATFL and CFL are incompetent, then",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "short fibers of PTFL restrict internal and external rotation, talar tilt, and dorsiflexion;",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "long fibres inhibit only external rotation, talar tilt, and dorsiflexion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "origin is posterior border of fibula",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/ptfl%20illustration.jpg",
                  "caption": "Lateral ankle ligaments"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/ptfl%20mri.jpg",
                  "caption": "MRI PTFL"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "inserts on posterolateral tubercle of the talus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "runs perpendicular to longitudinal axis of the tibia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no specific clinical test for isolated PTFL injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "MRI can indicate structural injury, rarely indicated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Clinical Conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rarely injured, except in association with a **complete dislocation of the talus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Calcaneal Fibular Ligament (CFL)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary restrain to inversion in neutral or dorsiflexed position",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "restrains subtalar inversion, thereby limiting talar tilt within mortise",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7005/images/cflanatomy.jpg",
              "caption": "CFL"
            },
            {
              "src": "https://upload.orthobullets.com/topic/7005/images/mri%20cfl.jpg",
              "caption": "CFL MRI"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "origin is anterior border of fibula, 9mm proximal to distal tip",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "inserts on calcaneus 13mm distal to subtalar joint and deep to peroneal tendon sheaths",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inversion (supination) test",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "perform with ankle in slight dorsiflexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "talar tilt test",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "angle formed by tibial plafond & talar dome is measured as inversion force is applied to hindfoot (<5 deg is normal for most ankles)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "useful for evaluation of combined injury of both ATFL and CFL ligament",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "talar tilt radiographs",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/talartiltone.jpg",
                  "caption": "Talar tilt test"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/talartilttwo.jpg",
                  "caption": "talar tilt test positive"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "ankle arthrograms",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/arthrogram.jpg",
                  "caption": "Ankle arthrogram cfl injury"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "CFL rupture can lead to extra-articular dye leakage into the peroneal tendon sheath",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Clinical Conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "injury occurs with ankle inversion with the foot in the neutral position",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**low ankle sprain**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Lateral Talocalcaneal Ligament (LTCL)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thought to stabilize the talocalcaneal joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "short narrow ligamentous band that connects the lateral process of the talus to the lateral surface of the calcaneus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "located anterior and medial to calcaneofibular ligament",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no specific test for this ligament",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "LTCL ligament (red arrows) identified distinctly from the calcaneofibular ligament",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/talcocalc%20lig.jpg",
                  "caption": "Talocalc ligament"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "relationship of the calcaneofibular ligament (green arrow) and the LTCL (red arrow)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/calc%20talo%20lig.jpg",
                  "caption": "Coronal TALOCALC"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Clinical conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often injured in conjunction with ATFL injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**low ankle sprain**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Deltoid Ligament",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary restraint to valgus tilting of the talus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "both the superficial and deep layers individually resist eversion of the hindfoot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stabilizes ankle against plantar flexion, external rotation and pronation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**superficial layer**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "crosses both ankle and subtalar joints",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "originates from anterior colliculus and fans out to insert into the navicular neck of the talus, sustenaculum tali, and posteromedial talar tubercle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the tibiocalcaneal (sustenaculum tali) portion is the strongest component in the superficial layer and resists calcaneal eversion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**deep layer**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "crosses only ankle joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "functions as the primary stabilizer of the medial ankle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "prevents lateral displacement and external rotation of the talus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "originates from inferior & posterior aspects of medial malleolus and inserts on medial and posteromedial aspects of the talus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "eversion test",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "with ankle in neutral, evaluates superficial layer",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "external rotation stress test evaluates syndesmosis and deep layer",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mortise radiograph with medial clear space widening can suggest injury",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/medial%20joint%20space%20widening.jpg",
                      "caption": "medial clear space widening"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "gravity stress view can identify medial clear space widening",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/gravity%20stress%20view.jpg",
                      "caption": "gravity stress view"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "normal deltoid ligament",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/intact%20deltoid.jpg",
                      "caption": "intact deltoid"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "ruptured deltoid ligament",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7005/images/ruptured%20deltoid.jpg",
                      "caption": "ruptured deltoid"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Clinical conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ankle fracture**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "injury occurs with pronation (eversion) trauma leading to forced external rotation and abduction of ankle",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may occur with fracture of the medial malleolus",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**high ankle sprain & syndesmosis injury**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Calcaneonavicular Ligament (Spring Ligament)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "static stabilizer of the medial longitudinal arch and head of the talus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "attaches from the sustentaculum tali to the inferior aspect of the navicular",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/spring%20ligament%20gross.jpg",
                  "caption": "Spring ligament gross anatomy"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/spring%20ligament%20mri.jpg",
                  "caption": "Spring ligament MRI anatomy"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/7005/images/spring%20ligament.jpg",
                  "caption": "Shows spring ligament."
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "consists of the superomedial and inferior calcaneonavicular ligaments",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "superomedial ligament is larger and the most important stabilizer to medial longitudinal arch",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flattening of medial longitudinal arch",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "suspect injury in associated posterior tibial tendon pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can diagnose tear",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "(green arrow, intact ligament; red arrow, disrupted ligament)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7005/images/spring%20ligament%20rupture.jpg",
                          "caption": "SPring ligament rupture"
                        }
                      ],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Clinical conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**posterior tibial tendon dysfunction**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**calcaneonavicular ligament (spring ligament)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most likely to be attenuated in type II flatfoot deformity secondary to posterior tibial tendon dysfuction",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**acute spring ligament tear**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "acute trauma can occur with forceful landing on flat foot",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "the tibialis posterior tendon is usually normal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
