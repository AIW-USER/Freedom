{
  "title": "Myasthenia Gravis",
  "url": "https://www.orthobullets.com/basic-science/9070/myasthenia-gravis",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Myasthenia Gravis is a common autoimmune disorder caused by autoantibodies directed against the acetlycholine receptor of the neuromuscular junction. Patients present with fluctuating proximal muscle weakness, ocular symptoms, and dysphagia.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with serologic testing for anti-AChR autoantibodies.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is medical management with acetylcholinesterase inhibitors.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "has a **bimodal distribution**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "more common in younger women (< 40 years of age) and older men (> 50 years of age)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**HLA-B8**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**medications**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "penicillamine",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "aminoglycosides",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathogenesis",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "autoantibodies directed against a protein of the neuromuscular junction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "autoantibodies can be directed against",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "nicotinic acetlycholine receptor (AChR)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "more common",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "muscle-specific receptor tyrosine kinase (MuSK)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "categorized as a **type II hypersensitivity reaction**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "T-cells play a role as well",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "thought to stimulate B-cell antibody production",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thymoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "thymic hyperplasia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "general feature",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**fluctuating muscle weakness**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**most common weakness is worse with continued use**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**e.g., worse at the end of the day**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**true muscle fatigue**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**secondary to decreasing contractile muscle force**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**ocular symptoms**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**most common presenting symptoms**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**ptosis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**diplopia**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**bulbar symptoms**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**dysphagia**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**dysarthria**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**fatigable chewing**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "proximal muscle weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ice-pack test**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "place ice on the patient's ptosis → ptosis improves",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "low temperatures change the kinetics of acetylcholinesterase, decreasing its activity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "this increases the amount of acetylcholine in the synaptic cleft",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**edrophonium chloride (Tensilon test)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "only used in patients with ptosis or ophthalmoparesis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "this allows for improvement in muscle strength to be observed",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "edrophonium is an acetylcholinesterase inhibitor that has a short duration of action",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "this increases the amount of acetylcholine in the synaptic cleft",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Computerized tomography (CT) scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indication",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "to rule out a thymoma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "view",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "chest",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "serologic testing for autoantibodies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**anti-AChR**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "this is the initial laboratory test to confirm the diagnosis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**anti-MuSK**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Electromyogram (EMG)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decremental decrease in the compound muscle action potential (CMAP)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Lambert-Eaton myasthenic syndrome (LEMS)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "differentiating factor",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**muscle weakness that improves with use**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "autonomic manifestations",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Botulism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "differentiating factor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**poor or impaired pupillary response to light**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Thyroid ophthalmopathy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Medical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "corticosteroids",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "a chronic immunotherapy agent",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "drugs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "oral prednisone",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "acetylcholinesterase inhibitors",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "considered first-line for symptomatic management",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "drugs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**pyridostigmine**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "adverse effects",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "abdominal cramping and diarrhea",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bradycardia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "sweating",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bronchial secretion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Procedural",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intravenous immunoglobulins (IVIg) or plasmapharesis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "rapid immunotherapy for myasthenic crisis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Surgical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thymectomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "in patients with a thymoma, irrespective if the patient has myasthenia gravis or not",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Myasthenic crisis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**respiratory weakness secondary to myasthenia gravis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Most patients with ocular involvement progress to generalized myasthenia gravis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
