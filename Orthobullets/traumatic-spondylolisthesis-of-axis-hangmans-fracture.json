                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Treatment",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2017/images/screen_shot_2017-06-23_at_1.17.34_pm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Axial compression and hyperextension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "<3 mm horizontal displacement of C2-3",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "No angulation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**C2-3 disc remains intact**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Stable fracture pattern",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Rigid collar** x4-6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2017/images/screen_shot_2017-06-23_at_1.17.34_pm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Hyperextension and axial load, followed by rebound flexion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**>3 mm** of horizontal displacement",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Significant angulation**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Vertical fracture line**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "C2-3 disc and PLL are disrupted",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "If <5 mm displacement, reduction with **traction** then **halo** immobilization x6-12 weeks",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "If >5 mm displacement, **surgery** or **prolonged traction**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Usually heal despite displacement (autofuse C2 on C3)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type IIA",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2017/images/screen_shot_2017-06-23_at_1.17.34_pm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Flexion-distraction",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "No horizontal displacement",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Horizontal fracture line",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Significant angulation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Avoid traction in type IIA**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Reduction with gentle axial load + hyperextension, then **compression halo** immobilization for 6-12 weeks",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2017/images/screen_shot_2017-06-23_at_1.17.34_pm.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Flexion-distraction, followed by hyperextension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I fracture with associated bilateral C2-3 facet dislocation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Surgical reduction of facet dislocation followed by stabilization required",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rigid cervical collar x4-6 weeks",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "type I fractures (<3 mm horizontal displacement)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "closed reduction followed by halo immobilization for 8-12 weeks",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "type II with 3-5 mm displacement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "type IIA",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "reduction technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "type II use axial traction combined + extension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "type IIA use hyperextension (avoid axial traction in type IIA)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reduction with surgical stabilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "type II with >5 mm displacement and severe angulation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "type III (facet dislocations)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**anterior C2-3 interbody fusion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**posterior C1-3 fusion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**bilateral C2 pars screw osteosynthesis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
