{
  "title": "Cervical Spine Anatomy",
  "url": "https://www.orthobullets.com/spine/2069/cervical-spine-anatomy",
  "subtitle": "Updated: Sep 14 2025",
  "sections": [
    {
      "text": "Embryology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "homeobox (Hox) genes direct and regulate processes of embryonic differentiation and segmentation along the craniocaudal axis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Osteology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The cervical spine contains 7 vertebral bodies",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "C1 (atlas)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "C2 (axis)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "C1 to C7",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "have a transverse foramen",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "vertebral artery travels through the transverse foramen of C1 to C6",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "C2 to C6",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "have bifid spinous processes",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "C7",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "despite having a transverse foramen, the vertebral artery does NOT travel through it in the majority of individuals",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "there is no C8 vertebral body, but there is a C8 nerve root",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Alignment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Normal sagittal lordosis (measured from C2 to C7)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Spinal Canal",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Spinal canal",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "normal diameter is 17 mm",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "<13 mm indicates possible cord compression",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Atlas (C1)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Has no vertebral body and no spinous process",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Embryology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "three ossification centers",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "one for each lateral mass (come together posteriorly to form posterior neural arch)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "lateral masses fuse to the body at age 7",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "one for the anterior arch",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "anterior arch does not appear until 1 year of age",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Articulations",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "occiput-C1",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "two superior concave facets that articulate with the occipital condyles",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "makes up 50% of neck flexion and extension",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Axis (C2)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "has an odontoid process (dens) and body",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "embryology",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "develops from five ossification centers",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2069/images/ossification%20center%20c2.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "subdental (basilar) synchondrosis is an initial cartilaginous junction between the dens and vertebral body that does not fuse until ~6 years of age",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2069/images/basilar_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "the secondary ossification center appears at ~3 years of age and fuses to the dens at ~12 years of age",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Kinematics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "C1-C2 (atlantoaxial) articulation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "is a diarthrodial joint that provides",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2069/images/cervical%20kinematics_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "50° (of 100°) of cervical rotation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "10° (of 110°) of flexion/extension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "0° (of 68°) of lateral bend",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "C2-C3 joint",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "participates is subaxial (C2-C7) cervical motion that provides",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "50° of cervical spine flexion/extension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "50° of cervical spine rotation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "60° of lateral bending",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "C2 blood supply",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "a vascular watershed exists between the apex and the base of the odontoid",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2069/images/blood%20supply%203_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2069/images/vert_odontoid_arcade_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "apex is supplied by branches of the internal carotid artery",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "base is supplied by branches of the vertebral artery",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "the limited blood supply in this watershed area is thought to affect healing of type II odontoid fractures",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Occipital-C1-C2 Ligamentous Complex",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Provided by the odontoid process and its supporting ligaments",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**transverse ligament**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2069/images/combined_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "limits anterior translation of the atlas",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**apical ligaments**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "limit rotation of the upper cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**alar ligaments**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "limit rotation of the upper cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Subaxial Cervical Spine (C3 to C7)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "C1 to C7",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "have a transverse foramen",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "vertebral artery travels through transverse foramen of C1 to C6",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "C2 to C6",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "have bifid spinous processes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "C6",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "contains palpable carotid tubercle, which is a valuable landmark for the anterior approach to the cervical spine",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "C7",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "non-bifid spinous process",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "despite having a transverse foramen, the vertebral artery does NOT travel through it in the majority of individuals",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "there is no C8 vertebral body, but there is a C8 nerve root",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "The superior articular facets of the subaxial cervical spine (C3-C7) are oriented in a posteromedial direction at C3 and posterolateral direction at C7, with variable transition between these levels",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2069/images/cervical_kinemat.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": []
        }
      ]
    }
  ],
