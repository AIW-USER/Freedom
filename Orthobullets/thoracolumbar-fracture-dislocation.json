{
  "title": "Thoracolumbar Fracture-Dislocation",
  "url": "https://www.orthobullets.com/spine/2024/thoracolumbar-fracture-dislocation",
  "subtitle": "Updated: Oct 16 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Thoracolumbar fracture-dislocations are rare injuries associated with a posterior facet dislocation occurring at the thoracolumbar junction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs of the thoracolumbar spine. CT scan is useful for fracture characterization and surgical planning",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually posterior open reduction with instrumented fusion",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "approximately **4% of spinal cord injuries** that are admitted to level 1 trauma centers",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "50-60% of fracture-dislocations are associated with spinal cord injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "4:1 male-to-female ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly occurs at the **thoracolumbar junction**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "high energy injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**motor vehicle accident (most common)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "falls",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "sports",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "violence",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**acceleration/deceleration injuries**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**resulting in hyperflexion, rotation, and shearing** of the spinal column",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "associated injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "neurologic deficits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "head injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "concomitant injuries in the thorax and abdomen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Classification systems**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "Thoracolumbar Injury Classification and Severity Scale **(TLICS)**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2024/images/asj-4-109-i001-l_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "categorizes injuries based on:",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "injury morphology",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "neurologic injury",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "posterior ligamentous complex integrity",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "treatment recommendations are based on total score",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "nonsurgical ≤3",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "indeterminate = 4",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "surgical ≥5",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Thoracolumbar junction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "definition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**T10-L2**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "transition zone between thoracic spine (kyphosis) and lumbar spine (lordosis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "greater mobility in the lumbar spine compared to the thoracic spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "results in an area that is vulnerable to shearing forces",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**high risk of injury to the spinal cord, conus, or cauda equina,** depending on the patient's anatomy and degree of dislocation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pre-hospital",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patients almost exclusively present after major trauma, with or without neurologic deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patients should be transported to a trauma center using **spine immobilization** precautions with a backboard and cervical collar",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Clinical approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ATLS**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "airway, breathing, circulation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "neurologic assessment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "inspection",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "open injury",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "deformity (e.g. kyphosis)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "palpation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "point tenderness",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "step-off deformity",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "crepitus",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "neurologic Impairment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "GCS",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "**ASIA Impairment score**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "impairment of sensation, motor function, or reflexes",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "rectal examination",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "history",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "physical examination",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2024/images/img_1470.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/2024/images/thoracolumbar_burst.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "AP and lateral views of thoracolumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**suspected spinal column injury** with bone tenderness",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "determine stable vs. unstable spine injuries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fracture type, pattern, and dislocation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/2024/images/img_1472.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "better visualization of fracture pattern and type compared to plain radiographs (e.g. unilateral facet dislocations)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "blunt trauma patients requiring a CT scan to screen for other injuries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "injury status of the spinal canal and other associated ligamentous structures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**better visualization of the spinal cord and supporting ligamentous structures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "level of neurologic deficit does not align with apparent level of spinal injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "important to evaluate for injury to the **posterior longitudinal ligament**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior open reduction and instrumented fusion",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2024/images/img_1468.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2024/images/img_1467.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most patients with thoracolumbar fracture-dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "unstable fracture patterns",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "disrupted supporting ligamentous structures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "midline incision",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "identify fracture-dislocation site",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "use pedicle screws for distraction to obtain anatomic reduction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "insert posterior instrumentation two levels above and two levels below the site of injury",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "early decompression and instrumentation has been shown to have better outcomes than delayed surgery or nonoperative treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "obtain postoperative CT/MRI to evaluate for residual anterior compression",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Neurologic injury**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Cauda equina syndrome**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**DVT**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Nonunion after spinal fusion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Post-traumatic pain**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "most common complication",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "greater risk with increased kyphotic deformity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Deformity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "scoliosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "progressive kyphosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "common with an unrecognized injury of the PLL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "flat back syndrome",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "leads to pain, a forward flexed posture, and easy fatigue",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "post-traumatic syringomyelia",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
