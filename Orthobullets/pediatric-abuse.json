{
  "title": "Pediatric Abuse",
  "url": "https://www.orthobullets.com/pediatrics/4001/pediatric-abuse",
  "subtitle": "Updated: Dec 10 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pediatric Abuse is the second most common cause of death in children and 50% of fractures in children younger than 1 year of age are attributable to abuse.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis can be suspected with a pediatric injury that is inconsistent with the mechanism of injury, a delay in seeking care, long bone fractures in nonambulatory child, or presence of highly specific fractures.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment involves reporting abuse to the appropriate agency and hospital admission for multidisciplinary evaluation. Rarely, operative management of fractures may be required.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": ">1 million children are victims of substantiated abuse or neglect in United States each year",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "child abuse is the second most common cause of death in children behind accidental injury",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "head injury is the most frequent cause of long term physical morbidity in the child",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "90% of fractures due to abuse occur in children younger than 5 years of age",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "50% of fractures in children younger than 1 year of age are attributable to abuse",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "30% of fractures in children younger than 3 years of age are attributable to abuse",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "the most common cause of femur fractures in the nonambulatory infant is nonaccidental trauma",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Social risk factors",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "child",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "first-born",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "unplanned pregnancy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "premature",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**disabilities (cerebral palsy)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "step-children",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "parent",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "single-parent home",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "recent social stressor (move, job loss)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "unemployment",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "drug use",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "personal history of abuse as a child",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "lower socioeconomic status",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "lack of support system",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Types (can have more than one type present):",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neglect 78%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "physical abuse 18%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sexual 9%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "psychological 8%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "injury often inconsistent with history",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "red flags",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "delay in seeking care",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "no history of injury or inconsistent story",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "high specificity fractures",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**long bone fractures in nonambulatory child**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**classic metaphyseal lesion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "fracture at junction of metaphysis and physis (primary spongiosa)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "torsional / traction-shearing strain when infant's extremity is pulled or twisted violently",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "high specificity for child abuse",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "**corner fractures**",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/4001/images/Corner%20fx%20-%20xray_moved.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "5",
                          "children": [
                            {
                              "text": "discrete avulsion of the metaphysis",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**bucket handle fractures**",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/4001/images/bh.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "5",
                          "children": [
                            {
                              "text": "horizontal avulsion fracture with appearance of central and peripheral components gives the appearance of a bucket handle",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            },
                            {
                              "text": "avulsed bone fragment may be seen en face",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/4001/images/enface.jpg",
                                  "caption": ""
                                },
                                {
                                  "src": "https://upload.orthobullets.com/topic/4001/images/bucket.jpg",
                                  "caption": ""
                                }
                              ],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "**transphyseal separation of the distal humerus**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**rib fractures, especially posteromedial**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4001/images/posterior%20rib.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4001/images/pos%20rib.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "scapula fractures",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "sternal fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "spinous process fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "moderate specificity fractures",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**multiple fractures in various stages of healing**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "vertebral body fractures and subluxations",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "digital fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "complex skull fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "other injuries concerning for abuse - multiple bruises, burns",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain related to fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**fractures are the second most common** lesion in abused children",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "frequency of fractures",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "humerus > tibia > femur",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "diaphyseal fractures 4 times more common than metaphyseal",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**skin lesions**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "most common presenting lesion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of bone or joint of suspicion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "initial evaluation should include **skeletal survey**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "alternative or adjunct to the radiographic skeletal survey in selected cases, particularly for children older than 1 year of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "provides increased sensitivity for detecting rib fractures, subtle shaft fractures, and areas of early periosteal elevation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "not useful in metaphyseal or cranial fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "1",
      "children": [
        {
          "text": "True accidental injury",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Osteogenesis imperfecta**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Osteopenia of prematurity",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Scurvy",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Copper deficiency",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Menkes disease",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Disuse osteopenia (nonambulatory or minimally ambulatory children)",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Chronic disease (kidney and liver)",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "report abuse to appropriate agency",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "physicians are mandated reporters and are legally obligated to report suspected child abuse and neglect",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "physicians are granted immunity from civil and criminal liability if they report in good faith, but may be charged with a crime for failure to report",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "early involvement of social workers and pediatricians is essential",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "hospital admission",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "early multidisciplinary evaluation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "admit infants with fractures to the hospital and consult **child protective services**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "obtain social service consult",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "cast application",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most fractures are splinted or casted until adequate callus is formed",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rarely neccessary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "definitive treatment as indicated for particular injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "If unreported",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**30-50% chance of repeat abuse**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**5-10% chance of death from abuse**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
