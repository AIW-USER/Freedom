                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**nucleus pulposus** of intervertebral disks",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "type II collagen has a very long half life",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Type III Collagen**",
          "table": null,
          "images": [],
