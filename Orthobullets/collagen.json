        {
          "text": "**Type I Collagen**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "accounts for more than 90% of the total collagen content in the body",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "found in",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**bone**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**ligament**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**tendon**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**meniscus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**annulus of intervertebral disks**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**skin**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**healed cartilage**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**scar tissue**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**nerves**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "related clinical conditions",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "osteogenesis imperfecta",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Ehlers-Danlos syndrome",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
