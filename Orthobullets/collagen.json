                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**Dupuytren's** contracture",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Type IV Collagen**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "found in basement membranes",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "related clinical conditions",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "renal diseases like Goodpasture's and Alport syndromes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Type V, VI, IX Collagen**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "occur in small amounts in articular cartilage",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "in articular cartilage, type VI collagen found exclusively in the pericellular matrix, surrounding chondrocytes within lacunae",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "thought to contribute to pericellular matrix integrity and mechanical properties, as well as chondrocyte mechanotransduction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**type IX collagen** gene deletion linked to development of OA in women and in knockout mice",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "mutations in COL9A1, COL9A2, COL9A3 linked to **multiple epiphyseal dysplasia (MED)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "however **70% of MED** is associated with **COMP**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "fragmented ossific centers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "coxa vara hips",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9013/images/med3.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "genu valgum",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9013/images/med2.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/9013/images/med1.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "shortened, stunted metacarpals",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9013/images/med%20hands.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Type VII and VIII Collagen**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "basement membrane (epithelial)",
              "table": null,
              "images": [],
              "importance": "2",
