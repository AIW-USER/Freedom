{
  "title": "Hip Resurfacing",
  "url": "https://www.orthobullets.com/recon/5032/hip-resurfacing",
  "subtitle": "Updated: Jan 30 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prior versions of resurfacing failed in the past due to",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "larger femoral head on polyethylene -> increased volumetric wear -> high osteolysis rate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "modern resurfacing techniques (approved by FDA in 2006) have made the following changes",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5032/images/bhr.jpg",
                  "caption": "Birmingham hip prosthesis."
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**metal-on-metal components**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**larger femoral head**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "very popular 10 years ago particularly in younger patients due to less femoral bone resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications (controversial)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "patients with advanced arthritis and good proximal femoral bone stock",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "best outcomes in **younger males with good bone stock**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "patients with proximal femoral deformity making total hip arthroplasty difficult",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "absolute",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**bone stock deficiency** of the femoral head or neck",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "e.g., **cystic** degeneration of the femoral head",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "relative",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**coxa vara**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "increased risk for neck fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**significant leg length discrepancies**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "resurfacing does not allow leg length corrections",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**female sex of child bearing age** (controversial)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "due to fact that metal ions can cross placenta",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "higher overall complication rate",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**renal failure**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "functional kidneys required to excrete metal ions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Advantages & Disadvantages",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**preservation of femoral bone stock**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**better stability** compared to standard small head (22- to 32-mm) THA",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "improved restoration of hip biomechanics with lower risk of limb length discrepancy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "revision may be easier than an intramedullary THA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lack of modularity with inability to adjust length or correct offset",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "requires larger exposure than conventional THA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Outcomes",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Variable outcome findings in the literature (79% to 98% success rate)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Better results found in patients young, larger males with excellent bone stock treated for osteoarthritis than for dysplasia or osteonecrosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Some case series have shown survival comparable to conventional THA, while others have reported higher rates of early revision",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "some products have been removed from the market due to early failure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "More recent prospective trials have shown few differences between resurfacing and THA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Periprosthetic femoral neck fracture**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/5032/images/femoral%20neck%20fx_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "incidence of 0% to 4% (more common than in THA)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "most common early complication (within first 3 years) and frequent cause for **revision** in acute post-operative period (<20 weeks)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "mechanism thought to be related to **osteonecrosis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "fracture pattern",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "vertical fracture line from neck down to lesser trochanter",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**femoral neck notching**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**prevent by placing implant in slight valgus (rather than slight varus)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "osteoporotic bone",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "large areas of preexisting AVN",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "femoral neck impingement (from malaligned acetabular component)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "female sex",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "varus positioning of femoral component",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "presents as groin pain",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "convert to a **primary THA**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "place **cerclage** wire above lesser trochanter to prevent fracture propagation during stem insertion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Implant loosening (aseptic)**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "early loosening of the cemented femoral resurfacing component",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Heterotopic ossification**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "higher incidence of heterotopic ossification compared to THA (from wider exposure)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Metallosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**may have elevated metal ion levels (cobalt, chromium, and cobalt-chromium ratio)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "found in blood and urine from metal debris",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "presentation and laboratory values may mimic infection",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "may present with elevated synovial WBC due to metal debris and corrosion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "most cases related to edge loading of the implant",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Dislocation**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "risk is <1% (lower than conventional THA)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Pseudotumor** risk metal-on-metal implants (like resurfacing) young female sex may be asymptomatic symptomatic patients require revision surgery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "risk",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "metal-on-metal implants (like resurfacing)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "young",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "female sex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "may be asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "symptomatic patients require revision surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "risk",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "metal-on-metal implants (like resurfacing)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "young",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "female sex",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "may be asymptomatic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "symptomatic patients require revision surgery",
          "table": null,
