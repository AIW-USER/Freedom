  "subtitle": "Updated: Sep 25 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Squamous Cell Carcinoma is a malignant soft tissue tumor most commonly found in elderly patients.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is wide surgical resection with or without radiation and skin grafting.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dorsum of hand and forearm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most common **subungual malignancy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary risk factor is excessive exposure to **ultraviolet radiation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "actinokeratosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Solid organ transplant",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**chronic osteomyelitis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**Marjolin's ulcer** is a squamous cell carcinoma resulting from chronic draining wounds or burn scars",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
