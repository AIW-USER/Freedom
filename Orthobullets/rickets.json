    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum labs",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "disordered and elongated zone of proliferation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "poorly defined zone of provisional calcification",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "widened osteoid seams",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "\"swiss cheese\" trabeculae",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "abnormally arranged collagen fibers",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "run perpendicular to haversian canals",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
