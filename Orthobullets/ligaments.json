{
  "title": "Ligaments",
  "url": "https://www.orthobullets.com/basic-science/9016/ligaments",
  "subtitle": "Updated: Sep 18 2022",
  "sections": [
    {
      "text": "function",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ligaments function to",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "restrict joint motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stabilize joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "have mechanoreceptors and free nerve endings that help with **joint proprioception**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Composition",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Extracellular components consist of",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**water**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**Type I collagen** (70% of dry weight)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**elastin**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "higher elastin content than tendons",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lipids**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**proteoglycans**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**epiligament coat**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "present in some ligaments, not all",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "analogous to epitenon of tendons",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Cellular component",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the main cell type in both tendons and ligaments is the fibroblast",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "both tendons and ligaments have low vascularity and cellularity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Ligaments vs. tendons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "composition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "compared to tendons, ligaments have",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "lower percentage of collagen",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "higher percentage of proteoglycans and water",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "less organized collagen fibers",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "rounder fibroblasts",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Bone insertion",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Two types of ligament bone insertion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**indirect (fibrous insertion)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most common form of bone insertion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "superficial fibers insert into the periosteum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "deep fibers insert directly into bone via perforating collagen fibers called **Sharpey fibers**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "at insertion, endotenon becomes continuous with periosteum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "examples",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "MCL inserting into proximal tibia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**direct (fibrocartilaginous insertion)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "has both deep and superficial fiber insertion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "deep fibers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "have four transitional zones of increasing stiffness that allow for force dissipation and reduce stress concentration",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**Zone 1** (tendon or ligament proper)",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "consists of well aligned type I collagen fibers with small amounts of proteoglycan decorin",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**Zone 2** (fibrocartilage)",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "consists of types II and III collagen, with small amounts of type I, IX and X collagen, and proteoglycans aggrecan and decorin",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**Zone 3** (mineralized fibrocartilage)",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "consists of type II collagen, with significant amounts of type X collagen and aggrecan",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**Zone 4** (bone)",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "is made up of type I collagen, with high mineral content",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "examples",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "supraspinatus insertion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Origin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "receives blood supply at insertion site (different from tendons)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ACL (and PCL) receives blood supply from middle geniculate artery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "have uniform microvascularity within ligament",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Biomechanical Properties",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Stress relaxation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "decreased stress with time under constant deformation",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9016/images/stress%20relax.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Creep**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "increased deformation with time under constant load",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9016/images/creep.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Hysteresis** (energy dissipation)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "when tissue is loaded and unloaded, the unloading curve will not follow the loading curve",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9016/images/hysteresis.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "the difference between the 2 curves is the energy that is dissipated",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Stress-strain** (load-elongation) curve",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**toe region**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9016/images/stressstrain.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "significant deformation for given load",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "in this region, the crimped and relaxed fibers of the ligament straighted to take up load",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**linear region**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "fibers oriented longitudinal and parallel to load",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "constant load-elongation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "stiffness = slope of load-elongation curve in this region",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "Young's modulus of elasticity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**yield and failure region**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "nonlinear",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "yield point",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "transition from elastic (reversible) to plastic (irreversible) deformation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ultimate failure",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "point before steep decline in load-deformation curve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Ligament vs. tendons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stress-strain differences between tendons and ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tendons carry higher loads, recruit fibers quickly",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "smaller toe region",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ligaments recruit fibers gradually",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "elongated toe region",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Ligament Failure",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rupture of sequential series of collagen fibers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ligaments do not plastically deform",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Failure site",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually midsubstance in adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usally at bony insertion in children",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ligament avulsion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "occurs at junction of mineralized and unmineralized fibrocartilage layers",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ligament injuries are classified into 3 grades",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Grade I**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "corresponds to mild sprain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Grade II**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "corresponds to moderate sprain/partial tear",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Grade III**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "corresponds to complete tear",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Ligament Healing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Phases",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**inflammatory phase**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "occurs at 1-7days",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "influx of neutrophyils and macrophages",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "production of **type III collagen**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "growth factors involved",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "TGF-β1",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "IGF",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "PDGF",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "BMPs -12 and -13",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bFGF",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**proliferation phase**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "occurs at 7-21 days",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "gradually replaced by **type I collagen**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "tendons and ligaments are weakest at day 5-21",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**remodeling phase**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "occurs at >14 days",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**maturation phase**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "up to 18 months",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Factors that impair ligament healing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**intra-articular**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "extra-articular ligaments (e.g. knee MCL) have a greater capacity to heal compared with intra-articular ligaments (e.g. knee ACL)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**increasing age**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**immobilization**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "reduces strength of both intact and repaired ligament",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**smoking**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**NSAIDS**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "including indocin, celcoxib, parecoxib",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**diabetes**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**alcohol intake**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**decreased growth factors**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bFGF, NGF, and IGF-1",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "decreased expression of genes involved with tendon and ligament healing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "examples include",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "procollagen I",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "cartilage oligomeric matrix protein (COMP)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "tenascin-C",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "tenomodulin",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "scleraxis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Factors that improve ligament healing (experimental)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**extra-articular**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "extra-articular ligaments (e.g. knee MCL) have a greater capacity to heal compared with intra-articular ligaments (e.g. knee ACL)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**compromised immune response**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "CD44 (receptor for lymphocyte activation) knockout mice have faster patellar tendon healing",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**Interleukin 10** (anti-inflammatory cytokine) improves patellar tendon healing in mice",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**Interleukin 1** (inflammatory mediator) **receptor antagonist** inhibits loss of mechanial properties in patellar tendons in rabbits",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "depletion of macrophages (source of TGF-β1 that stimulates fibrosis) improves ACL graft healing in mice (less scar, more fibrocartilage)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**mesenchymal stem cells**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "improved healing of tendon graft in bone tunnel in rabbits and rats",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "promote healing of partial tears of digital flexor tendons in horses",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "insufficient for rat rotator cuff repair (shear stresses too high)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**growth factors**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "PDGF-BB",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "increases cellular proliferation and limits adhesions in dog flexor tendon repairs, but provides no improvement in tensile strength",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "GCSF",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "improves tendon incorporation into bone tunnels in ACL reconstruction in dogs",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "BMP-2 and -12",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "improves healing in animal rotator cuff models",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "scaffolds to help primary ligament healing (instead of reconstruction)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**collagen-platelet-rich plasma hydrogel** helps primary ACL repair",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "but still inferior to native ACL strength",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "neuropeptides",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "denervation degrades tendons and ligaments",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**calcitonin gene-related peptide** improves MCL healing in rabbits",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Scarring",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tendons and ligaments heal with scar tissue that",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "reduces ultimate strength",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "causes adhesions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
