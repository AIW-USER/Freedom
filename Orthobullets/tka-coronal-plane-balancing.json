{
  "title": "TKA Coronal Plane Balancing",
  "url": "https://www.orthobullets.com/recon/5015/tka-coronal-plane-balancing",
  "subtitle": "Updated: Apr 20 2024",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "both medial and lateral ligaments may be stretched or contracted with time",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "it is essential to balance these ligament in both the coronal and sagital plane to obtain an optimum outcome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "concave side",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tight ligaments that need release",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "convex side",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "stretched ligaments that need tightening",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "must test balancing in both flexion and extension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Kinematic alignment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "principle of placing implants in more varus or valgus based on patient anatomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "constitutionally varus = varus tibial implant",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "constitutionally valgus = valgus tibial implant",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes are roughly equivalent with neutrally aligned knees",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Varus Deformity",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medial side is tight (concave), lateral side stretched (convex)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Goals",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "create precise bone cuts",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "release the tight medial ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tighten the lax lateral ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "balance flexion and extension gaps by adjustment of polyethylene bearing thicknesss",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Steps of medial release",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Step 1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Deep MCL Release To Mid-Coronal Plane Of Tibia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Medial Osteophyte Removal**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 3",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Release Posteromedial Corner (Posterior Oblique Ligament)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 4",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Medial Tibial Reduction Ostectomy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 5:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Consider PCL Release/Substitution If Imbalance Persists At This Point** (If Substitution Not Initially Chosen)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 6",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Release Semimembranosis (Especially If There Is An Associated Flexion Contracture)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 7",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Pie Crust Superficial MCL (Favor Use Of 18 Gauge Needle)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 8",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Complete Superficial MCL Release / Pes Anserinus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Rarely Required Even In Severe Cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Destabilizes Medial Flexion Gap / Consider A Constrained Prosthesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Differential release: performed with two components of superficial MCL",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "posterior oblique portion is tight in extension (release if tight in extension)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "anterior portion is tight in flexion (release if tight in flexion)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Lateral tightening",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "use a prosthesis that is sized to \"fill up\" the gap and make the stretched lateral ligaments taut",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "if a polyethylene bearing thickness of >15mm is required to gain appropriate lateral ligamentous tension, consider use of a constrained prosthesis to avoid excessive joint line elevation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Valgus Deformity (lateral side is concave/tight)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lateral side is tight (concave), medial side stretched (convex)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Goals",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "create precise bone cuts",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "release the tight lateral ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tighten the lax medial ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "balance flexion and extension gaps by adjustment of polyethylene bearing thicknesss",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Lateral release in order",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Step 1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**osteophytes**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**posterolateral capsule**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Step 3",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**iliotibial band** if tight in extension",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "with pie crust or release off Gerdy's tubercle",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Step 4**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**popliteus** if tight in flexion (release if tight in flexion)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "release the anterior part of its insertion",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "for severe deformities release both the iliotibial band and the popliteus",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Step 5**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**LCL**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "some authors prefer to release this structure first if tight in both flexion and extension",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "other authors prefer to release the LCL last",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "if LCL & Popliteus require release, flexion gap stability is lost so consider constrained prosthesis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "differential release: performed by differentially release the IT band and popliteus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Medial tightening",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fill up medial side until medial ligament complex is taut",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "In severe cases, if a polyethylene bearing thickness >15mm is required to obtain appropriate medial tension, consider a constained prosthesis to avoid excessive joint line elevation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Avoid internal rotation of the femoral component",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "internal rotation is common due to hypoplasia of the lateral femoral condyle",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "internal rotation of the femoral component may lead to patellofemoral maltracking and a coronally asymmetric flexion gap",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "if posterior referencing is used, verify femoral component rotation against the epicondylar and anteroposterior axes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Flexion / Contracture Deformity",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "concave side is posterior- needs to be released",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Posterior release order",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**1) posterior femoral & posterior tibial osteophytes**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**2) posterior capsule**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**3) additional resection of distal femur**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**4) gastronemius muscles** (medial and lateral)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "All releases are performed with knee at 90 degrees of flexion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows the popliteal artery to fall posteriorly to decrease risk of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "You do not want to address a contracture by removing more tibia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will change the joint line and lead to patella alta",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Peroneal nerve palsy**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "correction of **valgus and flexion contracture deformity** has highest risk of peroneal nerve palsy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "if patient presents with a peroneal palsy in recovery room then",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "then take off dressing and flex the knee",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "watch for three months to see if function returns",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "if function does not return, consider nerve conduction studies or operative exploration to access for damage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Coronal plane deformities >20 degrees cannot be corrected by intra-articular bone cuts and soft-tissue balancing alone and require an extra-articular osteotomy",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    }
  ],
