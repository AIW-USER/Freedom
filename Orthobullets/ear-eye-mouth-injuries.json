{
  "title": "Ear, Eye, Mouth Injuries",
  "url": "https://www.orthobullets.com/knee-and-sports/3120/ear-eye-mouth-injuries",
  "subtitle": "Updated: May 31 2025",
  "sections": [
    {
      "text": "Ear and Nose injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Auricular hematoma**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "cauliflower ear",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "common in wrestlers",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "use proper headgear",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "evaluate for concomittant injuries with an otoscopic evaluation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**aspiration**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**wrapping**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Septal hematoma**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "subperiosteal hematoma of the nasal septum that occurs secondary to facial trauma",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "nasal congestion is the most common symptom",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "treatment:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "urgent decompression under local anesthesia",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "saddle nose deformity with subsequent collapse - necrosis of septal cartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "septal abscess- may occur within 72 hours unless urgent decompression performed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Eye Injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Common in baseball, basketball, racketball, boxing, martial arts",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Injuries include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**traumatic mydriasis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "a transient phenomenon during which the iris fails to constrict properly, resulting in a **dilated pupil**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "caused by **contusion to iris sphincter**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "treated with bedrest",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**corneal abrasion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "diagnosed with fluorescent stain and UV light",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "treat with topical antibiotics, topical NSAIDS, eye patch, and nonurgent referral to ophthalmologist",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**hyphema**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "blood in the anterior chamber",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "treat with eye patch and to ER or emergent ophthalmologist",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**ruptured globe**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "sunken appearance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "vitreous exudate",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "requires referral to ER or emergent ophthalmologist",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**orbital wall fracture**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "may cause occular muscle entrapment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "requires referral to ER or emergent ophthalmologist",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**retinal detachment**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "Bright flashes, stabbing pain, visual field cut",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "requires referral to ER or emergent ophthalmologist",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "vision loss",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "decreased acuity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "floaters or flashers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "double vision",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hyphema",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "blood in anterior chamber",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may represent vitreous or retinal injury",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Dental injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "An **avulsed tooth is a medical emergency** and should be replaced immediately",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "the likelihood of survival of the tooth depends on the length of time that the tooth is out of the socket and the degree to which the periodontal ligament is damaged.",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Tooth handling includes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the tooth should be handled only by the crown end and not the root end",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "it can be rinsed of debris with water or normal saline solution",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "then place temporarily in buccal fold or placed in a container with **milk, saline, or neutral buffered solution**",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "re-insertion into the socket or transportation in the mouth in pediatric patients represents a risk for aspiration",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the tooth and the athlete should be transported to the dentist for reinsertion as soon as possible and preferably within an hour",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
