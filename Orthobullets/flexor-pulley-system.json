{
  "title": "Flexor Pulley System",
  "url": "https://www.orthobullets.com/hand/6004/flexor-pulley-system",
  "subtitle": "Updated: Nov 22 2024",
  "sections": [
    {
      "text": "Flexor Pulley System-Fingers",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Annular ligaments",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6004/images/finger_pulleys_2.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "A2 and A4 are critical to prevent bowstringing",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most biomechanically important",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6004/images/bowstringing.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "A1, A3, and A5 overlie the MP, PIP and DIP joints respectively",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "originate from palmar plate",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6004/images/palmar_plate.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "A1 pulley most commonly involved in trigger finger",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Cruciate pulleys",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6004/images/finger_pulleys_2.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "function to prevent sheath collapse and expansion during digital motion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "facilitates approximation of annular pulleys during flexion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "3 total at the level of the joints",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Classification (Schoffl et al)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Grade I - Pulley strain",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Grade II - complete rupture of A4 or partial rupture of A2 or A3",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Grade III - Complete rupture of A2 or A3",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Grade IV - Multiple ruptures (A2/A3, A2/A3/A4), or single rupture (A2 or A3) combined with lumbrical/collateral ligament trauma)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Flexor Pulley System-Thumb",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Oblique pulley (3-5mm)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6004/images/flexor%20pulley%20thumb%202.jpg",
              "caption": "flexor pulley system of thumb"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "originates at proximal half of proximal phalanx",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**most important pulley in thumb**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "functions like cruciate pulley in fingers",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6004/images/flexor%20pulley%20thumb%202.jpg",
                  "caption": "flexor pulley system of thumb"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "in fingers A1-A2-**C1**-A3",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "in thumb A1-Av-**oblique**-A2",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "facilitates full excursion of FPL",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "prevents bowstringing of FPL",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "bowstringing will occur if both A1 and oblique pulleys are cut",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Annular pulleys",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6004/images/flexor%20pulley%20thumb%202.jpg",
              "caption": "flexor pulley system of thumb"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "A1 pulley (4-8mm)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "at the level of the volar plate at the MCP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "~6mm in length",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "radial digital nerve is closest (2.7mm)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "ulnar digital nerve is less close (5.4mm)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "bowstringing will occur if both A1 and oblique pulleys are cut",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Av pulley (annular variable pulley) (4-8mm)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "between A1 and oblique pulleys",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "previously thought to be part of oblique pulley",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "helps prevent bowstringing",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "3 types",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Type I - transverse, parallel to A1, with gap between Av and A1",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6004/images/type_i.jpg",
                          "caption": "Type I Av pulley"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "Type II - no gap between Av and A1",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6004/images/type_ii.jpg",
                          "caption": "Type II Av pulley"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "Type III - triangular/oblique Av pulley with fibers converging to radial side",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6004/images/type_iii.jpg",
                          "caption": "Type III Av pulley"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "A2 pulley (5-10mm)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "contributes least to arc of motion of thumb",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "if A2 is intact, cutting A1 or oblique pulley will not result in bowstringing",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Pulley Reconstruction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Goals",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preserve or reconstruct 3 or more pulleys",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "A2 is important",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "unclear if A4 reconstruction is absolutely necessary (can be sacrificed during acute flexor tendon surgery)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Preferred treatment for Grade IV injuries",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Graft material",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extensor retinaculum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "synovialized pulley surface, provides **least gliding resistance**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "excised tendon material",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "palmaris or plantaris",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "FDS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "flexor tendon allograft",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Techniques",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "first excise all scar dorsal to the flexor tendon",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**around-the-bone** (encircling technique)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "single-loop (Bunnell)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6004/images/bunnell_single_loop.jpg",
                      "caption": "bunnell single loop"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "triple loop (Okutsu)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6004/images/okutsu_triple_loop.jpg",
                      "caption": "okutsu triple loop"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "biomechanically strongest construct",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "complications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most worrisome is phalangeal fracture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "stiffness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "persistent bowstringing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "inadequate tensioning",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "failure to remove scar tissue dorsal to tendon (tendon is not pressed against bone)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "persistent bowstringing will lead to a clinically significant flexion contracture",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**nonencircling reconstruction**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "ever-present-rim (Kleinert)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6004/images/kleinert_ever_present_rim.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "belt-loop (Karev)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6004/images/karev_palmar_plate_belt_loop.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "extensor retinaculum (Lister)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "palmaris longus transplantation through volar plate (Doyle and Blythe)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Location Specific",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "proximal phalanx (for A2 pulley)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "use 3 loops (around-the-bone) - strongest reconstruction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pass DEEP to extensor mechanism",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "middle phalanx (for A4 pulley)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "use 2 loops (around-the-bone)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pass SUPERFICIAL to extensors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
