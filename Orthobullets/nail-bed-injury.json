{
  "title": "Nail Bed Injury",
  "url": "https://www.orthobullets.com/hand/6109/nail-bed-injury",
  "subtitle": "Updated: May 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nail Bed Injuries are the result of direct trauma to the fingertip and can be characterized into subungual hematoma, nail bed laceration, or nail bed avulsion.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made by careful inspection of the nail bed integrity.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment depends on severity and degree of nail bed injury but generally requires removal of the nail and nail bed repair.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "nail bed injuries are included under the umbrella of fingertip injuries",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "finger tip injuries are the most common hand injuries seen in the hospital emergency department",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3:1 male-to-female predominance",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanisms of injury include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "crushing fingertip between two objects",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "catching finger in a closing door",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "saw injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "snowblower injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "direct blow from a hammer",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**DIP fractures or dislocations**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nailbed and surrounding tissue",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6109/images/fingertip.jpg",
              "caption": "fingertip"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "perionychium",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "nail",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "nailbed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "surrounding skin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "paronychium",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "lateral nail folds",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "hyponychium",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "skin distal distal and palmar to the nail",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "eponychium",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "dorsal nail fold",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "proximal to nail fold",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lunula",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "white part of the proximal nail",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "matrix",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**sterile**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "soft tissue deep to nail",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**distal to lunula**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "adheres to nail",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**germinal**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "soft tissue deep to nail",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**proximal to sterile matrix**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**responsible for most of nail development**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "insertion of extensor tendon is approximately 1.2 to 1.4 mm proximal to germinal matrix",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "examine for subungual hematoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inspect nail integrity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, lateral and oblique of finger",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "to rule out fracture of distal phalanx",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6109/images/nailbedfxapx1600.jpg",
                          "caption": "Distal phalanx fracture"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Subungual Hematoma",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Most commonly caused by a crushing-type injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "causes bleeding beneath nail",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6109/images/image%20subungual%20hematoma.jpg",
                  "caption": "Subungual hematoma"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "drainage of hematoma by perforation",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6109/images/tx%20of%20subungual%20hematoma.jpg",
                  "caption": "Treatment of subungual hematoma"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "less than 50% of nail involved",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "puncture nail using sterile needle",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "electrocautery to perforate nail",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "nail removal, D&I, nail bed repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "> 50 % nail involved",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "nail bed repair (see techniques)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Nail Bed Lacerations",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Laceration of the nail and underlying nail bed",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually present with the nail intact and a subungual hematoma greater than 50% of nail surface area",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6109/images/nail.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nail removal with D&I, nail bed repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most cases",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "tetanus and antibiotic prophylaxis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Avulsion Injuries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Avulsion of nail and portion of underlying nail bed",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6109/images/nail%20avulsion.jpg",
              "caption": "Nail bed avulsion"
            },
            {
              "src": "https://upload.orthobullets.com/topic/6109/images/nailavu2.jpg",
              "caption": "Nail bed avulsion"
            }
          ],
          "importance": "4",
          "children": []
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually caused by higher energy injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly associated with other injuries including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**distal phalanx fracture**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "if present reduction is advocated",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nail removal, nail bed repair, +/- fx fixation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "avulsion injury with minimal or no loss of nail matrix, with or without fracture",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6109/images/fingertip.jpg",
                          "caption": "fingertip"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "always give tetanus and antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "fracture fixation depends on fracture type",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "nail removal, nail bed repair, split thickness graft vs. nail matrix transfer, +/- fx fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "avulsion or crush injury with significant loss of nail matrix",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "always give tetanus and antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "nail matrix transfer from adjacent injured finger or nail matrix transfer from second toe",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "fracture fixation depends on fracture type",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nail bed repair**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "nail removal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "soak nail in Betadine while repairing nail bed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "nail bed repair",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "repair nail bed with 6-0 or smaller absorbable suture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "RCT has demonstrated quicker repair time using 2-octylcyanoacrylate (Dermabond) instead of suture with comparable cosmetic and functional results",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "splint eponychial fold",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "splint eponychial fold with original nail, aluminum, or non-adherent gauze",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Hook nail**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6109/images/hook%20nail.jpg",
              "caption": "hook nail"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "caused by advancement of the matrix to obtain coverage without adequate bony support",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "Treatment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**remove nail and trim matrix to level of bone**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Split nail**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6109/images/split%20nail%20crop.jpg",
              "caption": "Split nail"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "caused by scarring of the matrix following injury to nail bed",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "Treatment",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**excise scar tissue and replace nail matrix**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "graft may be needed",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Early treatment of acute injuries results in the best outcomes with minimal morbidity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
