        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "clinical presentation is based on the severity of disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "prominence of the last vertebral segment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "classic sign of **buttock dimping**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "postural abnormalities (e.g. sitting buddha)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4042/images/sit.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "limb and joint contractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "extended knees, flexed hips, and equinovarus feet.",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "flexion and extension may occur at the junction of the spine rather than hips",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**motor and sensory deficits are common in severe disease**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physical therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Renshaw type 1/2",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most become community ambulators",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "foot and knee deformities to be addressed",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spinal stabilization procedures",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Renshaw type 3/4 with progressive kyphosis or scoliosis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "progressive kyphosis and/or scoliosis may develop between the spine and pelvis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "child must use his or her hands to support the trunk, and therefore is unable to use his or her hands for other activities",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "limb amputation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "non-fuctional lower limb deformities",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "better mobility",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
