{
  "title": "Larsen's Syndrome",
  "url": "https://www.orthobullets.com/pediatrics/4090/larsens-syndrome",
  "subtitle": "Updated: Jun 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Larsen's Syndrome is a rare genetic disorder caused by mutations in filamin B and carbohydrate sulfotransferase 3 deficiency, that presents with characteristic findings of ligamentous hyperlaxity, abnormal facial features, cervical kyphosis, and multiple joint dislocations.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made based on family history associated with typical radiographic and clinical features. No commercially available diagnostic test exists due to the variety of genetic mutations.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually open reduction for joint dislocations and early posterior spinal fusion for cervical kyphosis to prevent neurological deterioration.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "estimated to be 1 in 100,000 live births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "autosomal dominant (AD) and recessive (AR) inheritance patterns",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AD linked to a mutation of the gene encoding **filamin B**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "AR linked to **carbohydrate sulfotransferase 3** deficiency",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manisfestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hand deformities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "dislocations",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**hips**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "knees (usually bilateral)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "shoulders",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "elbows (radial head)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**clubfeet**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**cervical kyphosis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may present with extremity weakness secondary to myelopathy",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "caused by hypoplasia of the cervical vertebrae",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patients have normal intelligence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hypotonia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "uncommon but may be due to cervical compression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "abnormal facial features",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4090/images/larsen%20syndrome.jpg",
                  "caption": "shows facial features of Larsen&#39;s syndrome"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**flattened nasal bridge**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "hypertelorism",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "prominent forehead",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "hands",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "long cylindrical fingers that do not taper",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "wide distal phalanx at the thumb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "elbows",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bilateral radial head dislocations may be present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "knees",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "look for **bilateral knee dislocations**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "foot deformities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "equinovarus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "eqinovalgus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**clubfeet**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**during first year of life**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "prior to any intubation to avoid iatrogenic spinal cord injury",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "AP pelvis and lateral of hips",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "ultrasound if less than 3 months",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypoplasia of vertebrae",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**cervical kyphosis with subluxation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**hip dislocation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cervical kyphosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "myelopathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical kyphosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior cervical fusion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "patients with significant kyphosis but no neurologic deficits",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "recommended to be performed during the **first 18 months of life** to prevent neurological deterioration",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "anterior/posterior cervical decompression and fusion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "cervical kyphosis with neurologic deficits",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Hip dislocations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "closed reduction under anesthesia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "may be attempted but rarely successful",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "open reduction of hip dislocation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "failed closed reduction",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "decreased range of motion secondary to contractures around hip",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "unilateral hip dislocation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "bilateral hip dislocation",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "controversial",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "if considering, perform early and only once",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Knee dislocations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "closed reduction and casting",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "may be attempted but rarely successful",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "open reduction with femoral shortening and collateral ligament excision",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "knee dislocations that remain unstable after closed reduction",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
