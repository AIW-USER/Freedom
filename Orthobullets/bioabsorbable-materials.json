                                }
                              ]
                            }
                          ]
                        },
                        {
                          "header": false,
                          "cells": [
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "PGA",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "1-2 months",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Biodegradation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Primary mechanisms of biodegradation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**poly-hydroxy-acid degradation**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9071/images/biodegradation.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "breakdown is by random hydrolysis of ester bonds, which leads to",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "reduction of molecular weight",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "loss of mechanical properties",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "final products are CO2, H2O, and products of TCA (tricarboxylic acid, Krebs) cycle",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**kidney excretion**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "PDS and PGA products can be excreted by the kidney",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9071/images/biodegradation.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**enzyme breakdown**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "enzymes are involved with PLA and PGA degradation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**lowered pH**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "polymer breakage produces products that **lower pH**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "accelerating the breakdown",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**material crystallinity**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "determines hydrophobicity and degradation speed",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**amorphous** and hydrophillic materials **degrade faster**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "more contact with water molecules",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**crystalline** and hydrophobic materials **degrade slower**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "less contact with water molecules",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Additional variable that affect degradation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "chemical composition and molecular weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fiber orientation (SR or simple)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "monomer concentration (in polymers)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stereoisomerism and conformation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pores and surface area/volume ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sterilization method (gamma irradiation vs others)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Degradation method (enzymatic vs hydrolysis)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histopathology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Granulomatous inflammation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cellular reactions around bioabsorbale implants are characterized by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "T **lymphocytes** (CD4>CD8)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "plasma cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "endothelial cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "birefringent polymer debris",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thin **macrophage** layer",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**multinucleated giant cells**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Capsule formation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a capsule forms around implants that consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**internal cell layer**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "2-3 cells thick",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "type III collagen predominance",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**external fibrous layer**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "few spindle shaped cells",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "type I collagen predominance",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Stages",
          "table": null,
          "images": [],
          "importance": "3",
