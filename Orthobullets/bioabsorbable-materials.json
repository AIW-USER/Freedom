                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "2-3 years",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "header": false,
                          "cells": [
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "PLA/PGA (PLGA) 80/20",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "1-2 years",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "header": false,
                          "cells": [
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "P(D/L)LA 96/4",
                                  "table": null,
