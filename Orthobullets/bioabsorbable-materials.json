{
  "title": "Bioabsorbable Materials",
  "url": "https://www.orthobullets.com/basic-science/9071/bioabsorbable-materials",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bioabsorbable materials were invented to address issues with synthetic implants including",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "migration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "growth disturbance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rigidity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "radioopacity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "need for implant removal operations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Indications include but are not limited to",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pediatric orthopaedics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "transphyseal SR PLGA 80/20 screws only cause temporary growth arrest in rabbits (unlike nonbioabsorbable implants)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "osteomyelitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "antibiotic eluting PLA",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "carriers for growth factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rhBMP2 and rhBMP7",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "augmentation of bone healing at iliac crest bone harvest site",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Types of Bioabsorbable Materials",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Polyglycolic acid (PGA)**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "hydrophilic, crystallic",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "glass transition temperature 36degC",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "becomes malleable if this temperature is exceeded",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "early degradation and strength loss",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "potential postop complications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "intraoperatively, must be heated to adapt to implantation surface, and cooled",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "increased intraoperative time consumption",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Polylactic acid (PLA)**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "more hydrophobic than PGA",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "L-isomer or poly-L-lactic acid (PLLA)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "hydrophobic and crystallic",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "has prolonged degradation time (several years)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "late adverse reactions in the final stages of polymer degradation",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "glass transition temperature 57degC",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "D-isomer",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "amorphous, less stable",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "useful for building co-polymers",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Co-polymers**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "P(L/D)LA copolymers",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "mixture of D- and L-isomers of PLA",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "hydrophobic and crystallic",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "resistant to hydrolysis and degradation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "adding D-isomers results in less tightly packed polymer chains",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "less crystallic and more rapidly degraded than PLLA alone",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "example is P(L/D)LA 70/30 in oral-maxillofacial surgery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "simple and self-reinforced forms",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "PLGA copolymers",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "combination of PLA and PGA",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "low crystallinity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "used in oral-maxillofacial surgery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "simple and self-reinforced forms",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Self reinforcing (SR)**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**composite** structure made from partially crystalline/amorphous material made of orientated fibers/fibrils and binding matrix",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "better biomechanical properties",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "improved **rigidity** and **strength** along longitudinal axis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**malleable** at room temperature",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "no need for heating-cooling",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "can withstand 4 times bending",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**minimal \"memory\"** (tendency to return to previous shape after bending)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "can be sterilized by **gamma irradiation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "gamma irradiation cannot be used with non-reinforced materials",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "will reduce its molecular weight and adversely affect the mechanical properties of the implant",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "",
                      "table": [
                        {
                          "header": true,
                          "cells": [
                            {
                              "colspan": 2,
                              "bullets": [
                                {
                                  "text": "**Absorption time of various materials**",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
