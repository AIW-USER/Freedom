                                  "children": []
                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "2 years",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "header": false,
                          "cells": [
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "SR PGA",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "0.5-1 years",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
