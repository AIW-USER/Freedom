{
  "title": "Synovium & Synovial Fluid",
  "url": "https://www.orthobullets.com/basic-science/9018/synovium-and-synovial-fluid",
  "subtitle": "Updated: Mar 30 2025",
  "sections": [
    {
      "text": "Synovium",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mediates nutrient exchange between blood and joint fluid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Composition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "vascularized connective tissue is porous and **lacks basement membrane**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "cell types",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "type A cells",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9018/images/screen_shot_2017-04-11_at_9.56.16_am.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "derived from macrophages",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "non-fixed cells with antigen presenting ability",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "located in superficial layer",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "important in **phagocytosis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "type B cells",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9018/images/screen_shot_2017-04-11_at_9.56.16_am.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "fibroblast like cells",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "rich rough endoplasmic reticulum and dendritic processes that reach out to the joint surface",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "located at various depths, frequently in deeper layer",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**produce synovial fluid**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "produce hyaluronic acid, fibronectin, collagen",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "type C cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "intermediate cell type",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "unknown function and origin",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "may serve as multi-potent precursor to either type A or B synovial cells",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Synovial Fluid",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lubricates articular cartilage and provides **nourishment through diffusion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Origin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "made from a **ultrafiltrate of blood plasma**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "regulated by synovium",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**healthy knee contains ~2mL of synovial fluid**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Consists of",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**hyaluronin**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "uridine diphosphoglucose dehydrogenase enzyme critical for its synthesis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**lubricin**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a key lubricating glycoprotein",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "reduces coefficient of friction within the joint",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "proteinase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**urokinase-type plasminogen activator**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "activates plasmin and prevents intra-articular clot formation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "collagenases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prostaglandins",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "synovial fluid exhibits **non-Newtonian flow characteristics**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the viscosity coefficient is not a constant",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "the fluid is not linearly viscous",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "viscosity increases as the shear rate decreases",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
