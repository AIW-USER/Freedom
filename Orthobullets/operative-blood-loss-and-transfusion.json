    {
      "text": "Postoperative Management",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Allogenic blood transfusion**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "preoperative hemoglobin strongest risk factor for postoperative blood transfusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "other risk factors",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "female gender",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "increased age",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "larger patient size",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "longer procedures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "lateral releases in total knee arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "1 unit of packed red blood cells generally increases hemoglobin by 1 g/dL",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "no absolute criteria for transfusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "transfusion should especially be considered at hemoglobin <8 g/dL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "routine transfusion should be avoided for hemoglobin > 8 g/dL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "no increased mortality has been seen with this criteria, even in patients with cardiac history",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "initiate transfusion if patient is symptomatic",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "orthostatic hypotension",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "tachycardia unresponsive to fluids",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "allogeneic transfusion causes immunomodulation, suppressing cell-mediated immunity and increasing infection susceptibility",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Allogenic platelet transfusion**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**blood product most likely to be contaminated**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "stored at room temperature",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "infections in 10 cases per million units transfused",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "gram positive organisms most common",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "thrombocytopenia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "platelet count below 5,000/mm^3",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "give platelets to avoid spontaneous bleeding",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "platelet count below 50,000/mm^3",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "give platelets before surgery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "platelet count below 100,000/mm^3",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "consider giving platelets before surgery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "platelet count above 100,000/mm^3",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "no need to transfuse",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Postoperative iron supplementation**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
