{
  "title": "Operative Blood Loss & Transfusion",
  "url": "https://www.orthobullets.com/basic-science/422806/operative-blood-loss-and-transfusion",
  "subtitle": "Updated: Jun 8 2026",
  "sections": [
    {
      "text": "Preoperative Management",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Aimed at optimizing patient hemoglobin levels to allow for better patient stress tolerance at the time of surgery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**vitamin supplementation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "iron",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "major building block of hemoglobin and functions to bind oxygen in the porphyrin ring structure",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "supplementation provides material for hemoglobin synthesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "some studies have demonstrated a significant decrease in postoperative transfusions in patients with anemia-reducing vitamins",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "increased side effects",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "constipation",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "acid reflux/heartburn",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "abdominal pain",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "folate and vitamin B12 supplementation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "are essential vitamins for DNA synthesis that are necessary for erythropoiesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "anemia-associated vitamin supplementation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "iron 256 mg/day, vitamin C 1 g/day, and folate 5 mg/day for 30-45 days preoperatively have been associated with decreased transfusion rates",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "should only be used in patients with specific deficiency",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**erythropoietin** (EPO)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "recombinant protein of natural glycoprotein produced by renal pericapillary cells",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "signals bone marrow cells to stimulate red blood cell (RBC) production",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "studies have demonstrated greater efficacy than preoperative autologus blood donation and reinfusion systems",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "high cost associated with use",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "treatment cost equivalent to 4 units of allogenic blood transfusion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "recommended for high risk patients (e.g. low preoperative hemoglobin, surgeries with significant blood loss anticipated, etc.)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "three dosing regimens have been proposed:",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "600 IU/kg - 4 doses: preoperative days 21, 14, 7, and 0",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "300 IU/kg - 15 doses: preoperative day 10 to postoperative day 4",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "150 IU/kg - 9 doses: preoperative day 5 to postoperative day 3",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**preoperative autologous blood donation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "preoperative procurement of 1 to 2 units of autologous blood",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "performed at least 3 weeks from the planned surgery to allow for recovery of hemoglobin levels",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may be of benefit in patients with normal Hb (>14 g/dL) ubdergoing procedures with high expected blood loss",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may be performed in any patient with Hb > 11 g/dL and body weight >50 kg with sufficient time prior to procedure",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "current literature does not seem to support efficacy and cost effectiveness in the management of postoperative anemia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "concerns that there is a high incidence of unused units",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**preoperative embolization**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "standard treatment for oncology cases with highly vascular tumors",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "renal cell carcinoma",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "performed within 24 hours of the procedure",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Preoperative labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CBC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evaluate hemoglobin levels",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "determine mean corpuscular volume",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "microcytic anemia suggests iron deficiency",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "macrocytic anemia suggests folate and vitamin B12 deficiency",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "folate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "B12",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Intraoperative Management",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Acute normovolemic hemodilution**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "autologus blood harvested right before or at the time of surgery",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "removed volume is replaced with colloid",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "extracted blood is transfused in the perioperative period",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "requires less planning than preoperative autologus blood transfusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "not commonly performed due to increased time in OR and associated labor",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Tourniquet**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "allows for a dry surgical field and better theoretical cement interdigitation during arthroplasty cases",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "minimum inflation pressure of 100 -150 mm Hg of systolic pressure",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "may use of esmarch bandage to exsanguinate limb prior to inflating tourniquet",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "avoid in infections and tumor cases",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "may also elevate limb for gravity exsanguination prior to inflating tourniquet",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "avoid use longer than 2 hours",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "tourniquets should be cautiously used in patients with severe peripheral vascular disease",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "risk of arterial complications associated with:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "history of arterial insufficiency",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "absence of pedal pulses",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "suspected popliteal aneurysm",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "radiographic arterial calcifications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "preoperative vascular surgery consultation in high risk patients",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Tranexamic acid** (TXA)",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "lysine derivative that competitively blocks plasmin binding sites on fibrin",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "results in a decrease in fibrinolysis and stabilized clot formation",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/422806/images/screen_shot_2019-12-30_at_9.34.29_pm.jpg",
                      "caption": "Mechanism of action of tranexamic acid"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "multiple studies have demonstrated a significant reduction in operative blood loss and transfusion rates with perioperative administration",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "no increased risk of DVT and PE",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "does not alter PT and PTT times",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "multiple dosing regimens and routes of administration utilized",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "IV, oral, and topical all appear equally efficacious",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "contraindications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "active intravascular clotting",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "severe drug allergy (anaphylaxis)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "subarachnoid hemorrhage",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "side effects",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "seizures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "binds to glycine and GABA channels leading to a reduced seizure threshold",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Aminocaproic acid**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "lysine derivative that competitively inhibits plasmin",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "results in decreased fibrinolysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "studies have demonstrated decreased blood loss with aminocaproic acid in arthroplasty",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "lower cost than TXA",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "does not decrease seizure threshold",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Topical hemostatic agents**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "collagen agents",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "stimulate the instrinsic pathway of coagulation cascade to promote hemostasis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/422806/images/coagulation-cascade.jpg",
                      "caption": "Diagram of the intrinsic and extrinsic coagulation cascade"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "microfibrillar collagen",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "dry, fine, white powder",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "must be applied with dry surgical instruments to a dry field",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "fibrin sealant",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "consists of two seperate mixtures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "one contains fibrin and factor XIII",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "one contains thrombin and calcium",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "combining the mixtures creates a fibrin seal where it is sprayed",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "platelet-rich plasma",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "centrifugation of patient's blood to isolate plasma with high contents of platelets, growth factors, and clotting factors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "proposed benefit of improved hemostasis, wound healing and recovery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "platelet-poor plasma",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "isolated from centrifugation process",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "combined with thrombin and calcium to provide an autologous fibrin sealant",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "gelfoam sponges",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "manufactured from animal-skin gelatin and processed into sponge-form",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "isolated use exerts mostly mechanical hemostasis against low-pressure bleeders",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "can be soaked with thrombin, which can act as a scaffold for the coagulation cascade",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "excess gelfoam should be removed as it may interfere with bone healing",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "topical hemostatic agents do not appear to be cost-effective in total joint arthroplasty cases",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "beneficial in spine surgery to promote hemostasis without inflicting harm to adjacent neural structures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "topical TXA",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "typically administered near the end of the procedure to control postoperative bleeding",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "decreases fibrinolysis and stabilizes clot formation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "may be an alternative route of adminstration in patients with higher risk of complications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "history of MI, CAD, or CVA",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "gelatin-thrombin matrix",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "commonly used in spine surgery to control epidural bleeding",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "brand names include Floseal and Surgiflo",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "consists of porcine or bovine gelatine matrix combined with human derived thrombin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "acts at the end stage of the coagulation cascade leading to fibrin formation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Reinfusion systems** (cell saver)",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "recycles intraoperative blood loss for later transfusion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "can be transfused intraoperatively during longer procedure",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "collected blood is filtered, washed, and transfused within 6 to 8 hours from the procedure",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "serves as an alternative to allogenic blood transfusion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "theoretical benefits of minimizing wound complications and hematoma formation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "coagulopathy",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "altered composition of the transfused blood containing elevated fibrin split products and inflammatory cytokines (TNF-α and interleukins)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "especially problematic in unwashed systems",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "can lead to increased wound drainage",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "contamination",
                  "table": null,
