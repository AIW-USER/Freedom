{
  "title": "Bladder Exstrophy",
  "url": "https://www.orthobullets.com/pediatrics/4125/bladder-exstrophy",
  "subtitle": "Updated: Jun 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bladder Exstrophy is a rare congenital disorder that involves the musculoskeletal and genitourinary systems and may present with several pelvic abnormalities.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be confirmed with pelvic radiographs revealing pubic rami diastasis, shortened pubi rami, and acetabular retroversion.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is surgical with staged multidisciplinary reconstruction.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classic exstrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "1/40,000 infants diagnosed with this condition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "cloacal exstrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "1/200,000 infants with intestinal track involved as well",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "abnormal anterior rupture of the **cloacal membrane** early in the embryonic period",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "mesenchymal ingrowth into the abdominal wall is also inhibited",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**altered migration of sclerotomes** that comprise the anterior elements (pubis)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "family history should be sought out as often associated with other conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a thorough history and a complete examination are essential",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "urinary system infection(s)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "genitourinary system",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**exposed bladder**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4125/images/bladder_clinical.jpg",
                      "caption": "clin photo"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "musculoskeletal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "acetabuli are ~12 degrees **retroverted**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "without pubis to tether the anterior ring, the posterior elements retrovert",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "waddling gait with **external foot progression**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "obtain AP pelvic radiograph",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**pubic rami diastasis**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4125/images/bladders_exs_xr.jpg",
                      "caption": "xr in infant"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**shortened pubic rami**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4125/images/bladder.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**acetabular retroversion**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Goal of treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "close abdominal wall",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "achieve urinary continence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "normal renal function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "staged multidisciplinary reconstruction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**all cases require surgical treatment**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "multidisciplinary approach",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "management should be multidisciplinary and involve pediatric urologist and general surgeon",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "reconstruction sequence may vary by the preference of urologist",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "components",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**primary closure of bladder** (newborn)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "usually the first stage",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**epispadias repair in males** (1-2 y/o)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "usually 2nd stage",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**bladder neck reconstructions** (4 y/o)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "usually 3rd stage",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**pelvic osteotomies**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "performed in order to decrease tension on the bladder and repaired abdominal wall to decrease dehiscence",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Staged multidisciplinary reconstruction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "stage I",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "primary closure of bladder (newborn)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "stage II",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "epispadias repair in males (1-2 y/o)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "stage III",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "bladder neck reconstructions (4 y/o)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**pelvic osteotomies**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "in order to decrease tension on the bladder and repaired abdominal wall to decrease dehiscence",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "timing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "closure of pelvic ring may be performed at any stage of the process",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "fixation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "pelvic osteotomy fixation depends on the age",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "newborns",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": [
                                {
                                  "text": "not required in newborns (skin traction and hips flexed 90 degrees)",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "younger patients",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": [
                                {
                                  "text": "external fixation in younger patients",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "text": "age > 8 years",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": [
                                {
                                  "text": "augment correction of diastasis with plate fixation in > 8 y/o",
                                  "table": null,
                                  "images": [],
                                  "importance": "2",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Recurrent pubic diastasis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Common whether or not osteotomy was performed",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Does not appear to impact activity level",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Complications of anterior innominate osteotomy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "wound dehiscence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "transient femoral nerve palsy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
