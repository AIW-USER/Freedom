{
  "title": "Camptodactyly",
  "url": "https://www.orthobullets.com/hand/6074/camptodactyly",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Camptodactyly is a rare congenital condition of the hand that is characterized by a digital flexion deformity that usually occurs in the PIP joint of the small finger.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is usually observation with passive stretching in the majority of cases. Surgical management is indicated in cases of progressive deformity leading to functional impairment.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prevalence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "less than 1%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unilateral (33%) or bilateral (66%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "if bilateral, can be symmetric or asymmetric",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically caused by either",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "abnormal lumbrical insertion/origin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "abnormal (adherent, hypoplastic) FDS insertion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "other less common causes include",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "abnormal central slip",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "abnormal extensor hood",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "abnormal volar plate",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "skin, subcutaneous tissue, or dermis contracture",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most often sporadic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can be inherited with autosomal dominant inheritance with incomplete penetrance/variable expressivity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be associated with more widespread developmental dysmorphology syndromes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 4,
                  "bullets": [
                    {
                      "text": "**Benson Classification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Type*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Characteristics*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Treatment*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Isolated anomaly of little finger, presents in **infancy** and affects males and females equally",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Most common form**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stretching/splinting",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6074/images/campto%202%20copy.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Same clinical features as Type I, presents in **adolescence**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Affects girls more often than boys.**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "If full PIP extension can be achieved actively with MCP held in flexion, digit can be explored and abnormal**FDS tendon transferred to radial lateral band**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6074/images/camptodactyly%201%20copy.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Severe contractures, **multiple digits** involved, presents at **birth**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Usually associated with a syndrome",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Non-operative (**unless functional deficit exists after skeletal maturity), then consider **corrective osteotomy/fusion**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Kirner's Deformity",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Specific deformity of small finger distal phalanx with volar-radial curvature (apex dorsal-ulnar)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Often affects preadolescent girls",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Often bilateral",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Usually no functional deficits",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6074/images/screen_shot_2017-04-02_at_7.08.42_pm.jpg",
                          "caption": "Kirner 1"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/6074/images/screen_shot_2017-04-02_at_7.08.03_pm.jpg",
                          "caption": "Kirner 2"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often goes unnoticed as usually only affects small finger and is very rarely associated with any significant compromise in function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "typically painless and without motor/sensory deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**flexion deformity of small finger PIP joint**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "flexible (correctable) or fixed (non-correctable) deformity",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "progressively worsens over time if untreated",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may rapidly worsen during growth spurts",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "normal strength, sensation, perfusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually normal DIP and MCP joint alignment, however compensatory contractures can develop",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no swelling, erythema, or warmth; not associated with inflammation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often normal, especially in early stages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "later stages: possible decrease in P1 head convexity; possible volar subluxation and flattening of base of P2",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "passive stretching, splinting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**nonoperative** treatment is favored in most cases",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "best for PIP contracture < 30 degrees",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "passive stretching + static splinting",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "variable outcomes",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "best outcomes with early intervention",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "FDS tenotomy +/- FDS transfer",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**progressive** deformity leading to functional impairment",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "must address all abnormal anatomy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "passive (correctable) deformities",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "FDS tenotomy, or",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "FDS transfer to **radial lateral band** if full active PIP extension can be achieved with MCP flexion",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "osteotomy vs. arthrodesis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "severe **fixed** deformities",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "variable outcomes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
