{
  "title": "Hypothenar Hammer Syndrome",
  "url": "https://www.orthobullets.com/hand/6097/hypothenar-hammer-syndrome",
  "subtitle": "Updated: Nov 23 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hypothenar Hammer Syndrome is post-traumatic digital ischemia from thrombosis of the ulnar artery at Guyon's canal.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with vascular studies including Doppler ultrasound and CT angiography.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment can be observation, fibrinolysis, vessel ligation or reconstruction depending on the chronicity of symptoms, the digital brachial index, and the presence of an aneurysm.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "< 1 per 100,000",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**male**: female ratio is 9:1",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "age bracket is 40s-50s",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unilateral, dominant **ring** finger +/- **small** finger",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "less commonly, index and middle fingers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "thumb is spared",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occupations using **vibrating** tools such as carpenters, machinists, mechanics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "sports such as baseball catchers, mountain biking, golf, volleyball, karate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "single or **repetitive blunt impact** on hypothenar eminence leads to ulnar artery thrombosis or aneurysm with true endothelial lining",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6097/images/img_1454.jpg",
                      "caption": "Hypothenar hammer syndrome"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "hook of hamate functions as an **anvil**, causing thrombosis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "distal embolisation leads to ulceration, gangrene",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ulnar artery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ulnar artery branches into 2 branches as it exits Guyon's canal",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6097/images/anatomy%20guyon.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "deep branch",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "superficial palmar arch in Guyon's canal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "relation to hook of hamate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "over distal 2cm, the artery is **directly anterior to the hook of the hamate**, covered by palmaris brevis, subcutaneous tissue and skin",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6097/images/ct%20angio.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occupational or sporting risks (see above)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain** over hypothenar eminence and **ring** finger",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "may involve small, middle and index fingers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "cold sensitivity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "paresthesia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "blanching, mottling, cyanosis, pallor, gangrene",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**tenderness** over hypothenar eminence",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "prominent **callus** (calloused skin over hypothenar eminence)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**pulsatile mass** if aneurysm is present",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "fingertip ulcerations over ulnar digits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "splinter hemorrhages over ulnar digits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Allen's test",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "positive if occlusion is present",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "negative if an aneurysm is present",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Doppler** ultrasound",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "first line test",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "measure digital brachial index",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**<0.7 necessitates reconstruction**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Angiogram**, CT angiogram or MR angiogram",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6097/images/angio.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "mandatory for diagnosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "tortuous \"**corkscrew**\" ulnar artery",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**occlusion or aneurysm** at the hook of the hamate",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6097/images/aneurysm%20angio.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Raynaud's** disease",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "involves the thumb (hypothenar hammer syndrome does not)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lifestyle modifications, symptomatic treatment, and vascular consult",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**thrombosis without aneurysm > 2 weeks**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "asymptomatic",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "no threat of digital loss",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lifestyle modifications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "smoking cessation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "avoid recurrent trauma",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "80% success",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "endovascular fibrinolysis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**thrombosis without aneurysm < 2 weeks**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "excision of involved segment and reconstruction with or without a vein graft",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6097/images/resection.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "digital brachial index <0.7",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "thrombosis **with aneurysm**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "ischemia in multiple digits",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "failed conservative treatment with recurrent symptoms",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Modes of Failure",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "Acute (< 1 month)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "thrombosis",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "Subacute (1-18 months)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "intimal hyperplasia",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "arterial ligation (Leriche procedure)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "digital brachial index >0.7",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
