{
  "title": "Periosteal Osteosarcoma",
  "url": "https://www.orthobullets.com/pathology/8016/periosteal-osteosarcoma",
  "subtitle": "Updated: Jun 21 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Periosteal Osteosarcomas are rare, malignant, intermediate-grade, surface osteosarcomas that occur most commonly on the diaphysis of the femur and tibia. Patients typically present between the ages of 15 to 25 years with regional pain and swelling.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs showing a lesion that has a classic \"sunburst or \"hair on end\" periosteal reaction with biopsy showing cellular atypia with areas of osteoid and chondroblastic matrix.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually neo-adjuvant chemotherapy, limb salvage surgical resection, followed by adjuvant chemotherapy.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extremely rare intermediate grade surface osteosarcoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually occurs in patients **15 to 25** years of age",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "more common in females than males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs most commonly in the **diaphysis of long bones**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**femur** and **tibia** are most common",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**germ-line mutation of p53** found in 15-20% of cases",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain** is the most common presenting symptom",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "25% present with **pathologic fracture**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "regional swelling and tenderness",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8016/images/osteosarcoma%20clinical%20picture.jpg",
                  "caption": "clinical photo of a 12 year old boy with osteosarcoma of the distal femur"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lesion has a classic **\"sunburst\" or \"hair on end\"** periosteal reaction",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8016/images/osteosarcoma%20radiograph%20sunburst%20periosteal%20reaction.jpg",
                  "caption": "ap/lateral radiograph of the femoral diaphysis showing the classic sunburst periosteal reaction classic for periosteal osteosarcoma"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "often sunburst periosteal reaction occurs in a saucerized cortical depression",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "typically there is no involvement of the medullary canal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Chest CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "required for staging",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "evaluates for the presence of pulmonary metastasis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "required for staging",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually very **hot**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Classically",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "grossly tumor appears **lobular and cartilaginous**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "while tumor produces **osteoid**, histology reveals areas of **chondroblastic matrix**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8016/images/Histology%20D_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/8016/images/Histology%20C_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "if histology shows no osteoid production, tumor would be classified as a chondrosarcoma",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative (same as intramedullary osteosarcoma)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "multi-agent chemotherapy and limb salvage resection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "standard of care in most patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chemotherapy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "preoperative chemotherapy given for 8-12 weeks followed by maintenance chemotherapy for 6-12 months after surgical resection",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "surgical resection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "trend towards limb salvage whenever possible",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**20-35% chance of pulmonary metastasis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Intermediate prognosis** between parosteal and intramedullary osteosarcoma",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "90-98% necrosis with neoadjuvant chemotherapy is good prognostic sign",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Expression of multi-drug resistance (MDR) gene portends very poor prognosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cells can pump chemotherapy out of cell",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "present in 25% of primary lesions and 50% of metastatic lesions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
