    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Patellar Maltracking is a common cause of patient dissatisfaction following TKA and is the most common reason for secondary surgery following total knee arthroplasty.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with a combination of anterior knee pain, patellar subluxation during ambulation, and limitation in knee flexion.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on underlying etiology.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
