    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**types I (normal web) and IV (merged web)**, no functional impairment",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thumb web space, thumb, and central cleft reconstruction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "types IIA, IIB, III and V webs",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Thumb, thumb web space reconstruction**",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "web space deepening, tendon transfer, rotational osteotomy, toe-hand transfer",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "**thumb web reconstruction has greater priority** over correction of central cleft",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "thumb reconstruction should **not precede cleft closure** as it might compromise skin flaps",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Central cleft reconstruction**",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "depends on **characteristic of thumb web space**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "close the cleft proper with **local tissues** from the cleft and stabilize and **close intermetacarpal space**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Functional limitation dependent on **involvement of 1st webspace**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Aesthetically displeasing, but not functionally limiting**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
