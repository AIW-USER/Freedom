  "sections": [
    {
      "text": "Types of bone marrow",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gelatinous tissue found in the inner spaces of bone that contains **progenitor cells** and **stromal cells**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Types of bone marrow",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**red marrow**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "hematopoietic tissue",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "composition",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "40% water",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "40% fat",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "20% protein",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**yellow marrow**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "fatty tissue",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "composition",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "15% water",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "80% fat",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "5% protein",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary function of **hematopoiesis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "controls the inner diameter of bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Red Bone Marrow",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly found in flat bones",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ribs, ilium, sternum, vertebrae, skull",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "epiphysis/metaphysis of long bone (children only)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contains **mesenchymal stem cells and hematopoietic stem cells**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "red marrow slowly changes to yellow marrow with age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Yellow Bone Marrow",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly found in diaphysis or shaft of long bones",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "femur, humerus, tibia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contains **mostly fat cells**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "may revert to red bone marrow if there is an increased demand for red blood cells (e.g. trauma)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
