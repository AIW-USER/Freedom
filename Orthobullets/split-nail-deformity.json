{
  "title": "Split Nail Deformity",
  "url": "https://www.orthobullets.com/hand/6110/split-nail-deformity",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "scar that produces an 'empty' or 'blank' longitudinal area of nail between two normal regions of nail",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by scar in the germinal matrix that causes absence of nail production",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can occur as a sequelae of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "nail bed injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "infections (i.e. paronychia)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Perionychium",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "nail bed",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "soft tissue beneath the nail includes",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "germinal matrix (proximal)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "produces 90% of the nail",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "**scarring causes absence**",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "sterile matrix (distal)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "keeps nail adherent to nail bed",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "**injury causes deformity**",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "nail fold",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most proximal portion of the perionychium consists of",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "ventral floor - germinal matrix portion of the nail bed",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "dorsal roof",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "eponychium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin proximal to the nail that covers the nail fold",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "paronychium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin on each side of the nail",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hyponychium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin distal to the nail bed",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patient will report fingertip injury in the form of trauma or infection in the past",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "painless",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "complaint is typically cosmetic in nature",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "careful inspection of the nail to identify any 'blank' areas of nail",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not typically warranted",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obtain if suspicious of underlying bony etiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation alone",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "majority of patients not concerned about cosmesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "scar resection and primary closure",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "size < 2mm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "patients have strong desire to improve cosmesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "scar resection and full thickness nail bed graft from second toe",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "germinal matrix and size >2mm",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "sterile matrix, any size",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "resection and primary closure rarely successful",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "patients have strong desire to improves cosmesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Scar resection and primary closure**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indicated for germinal matrix if size <2mm",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Scar resection and full thickness nail bed graft from second toe**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6110/images/excision_toe_graft.jpg",
              "caption": "Toe graft"
            },
            {
              "src": "https://upload.orthobullets.com/topic/6110/images/toe_graft_sutured.jpg",
              "caption": "Sutured"
            },
            {
              "src": "https://upload.orthobullets.com/topic/6110/images/6_month_follow-up.jpg",
              "caption": "Follow-up"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "preferred for geminal matrix if size > 2mm",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
