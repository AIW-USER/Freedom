  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Surgical approach may be dictated by",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12116/images/approaches_to_hip_1500.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "surgeon preference",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "prior incisions",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "obesity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "risk for dislocation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "implant selection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "degree of deformity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Standard approaches",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "direct anterior",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "anterolateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "direct lateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterolateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Extensile approaches",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "trochanteric osteotomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "\"Minimally invasive\" approaches",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Direct Anterior Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12116/images/9_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "increasingly popular approach with good long-term results",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "uses interval between tensor fascia lata and sartorious",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decreased dislocation rate when compared to posterior approach in numerous studies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "abductor mechanism not violated (compared to anterolateral exposure)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "No difference in gait biomechanics at 3 months compared to other approaches",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "unsupported advantages include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decreased muscle damage",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "decreased pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "quicker recovery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "steep learning curve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "complication rates decrease after 100+ procedures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "surgical site infection rates increased in obese patients with large abdominal panni",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Anterior retractor can result in femoral nerve injury",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "femoral exposure can be challenging",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may require a special operating room table for increased exposure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "lateral femoral cutaneous nerve paresthesias",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "intraoperative fracture rate thought to be higher",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anterolateral Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12116/images/7_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "less commonly used approach for arthroplasty secondary to violation of abductor mechanism and post-operative limp",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "uses interval between tensor fascia lata and gluteus medius",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lower dislocation rate than posterior approach",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "violates abductor mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may lead to postoperative limp",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Direct Lateral Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12116/images/5_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "less commonly used approach for arthroplasty secondary to violation of abductor mechanism and postsa-operative limp",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "no true interval",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "splits gluteus medius and vastus lateralis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lower dislocation rate than posterior approach",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "allows access to both anterior and posterior hip joint without osteotomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "violates abductor mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may lead to postoperative limp",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "heterotopic ossification is common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Posterolateral Approach",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12116/images/8_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "most common approach for primary and revision arthroplasty",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "no true interval",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "abductor mechanism not violated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "excellent exposure of both femur and acetabulum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "easily converted to more extensile exposures both proximally and distally",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dislocation rates may be higher than anterior exposures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "risk reduced with repair of capsule and short external rotators",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Extensile Approaches",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Trochanteric osteotomy",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "overview",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "3 types",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "standard trochanteric osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "trochanteric slide",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "extended trochanteric osteotomy",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12116/images/eto.jpg",
                          "caption": "ETO"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "useful for difficult primary and revision hip arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "advantages",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "excellent acetabular exposure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "useful for component removal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "complications include",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "non-union",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "heterotopic ossification",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "trochanteric bursitis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "abductor weakness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fracture of the osteotomy fragment is the most common complication",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "extended trochanteric osteotomy requires diaphyseal engaging stem",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
