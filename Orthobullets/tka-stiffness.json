                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12309/images/2d10ada9-a225-4b2e-a0bd-6aa03002b84c_patella_baja..jpg",
                      "caption": "Patella baja is a risk factor for knee stiffness following TKA"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "younger age (< 55)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "smoking",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "increased medical comorbidities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "low pain tolerance",
