{
  "title": "TKA Stiffness",
  "url": "https://www.orthobullets.com/recon/12309/tka-stiffness",
  "subtitle": "Updated: Dec 26 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Stiffness is a common complication following TKA that results in poor postoperative functional outcomes.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically in a patient with a TKA who has flexion < 90 degrees or a flexion contracture of 10-15 degrees.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is manipulation under anesthesia for flexion < 90 degrees within first 12 weeks of surgery. Arthroscopic lysis of adhesions is indicated for flexion < 90 degrees after 12 weeks.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1.3%-12%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "preoperative factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**poor preoperative ROM**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most important factor",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "patella baja",
