                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "prior surgery",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "technical factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**overstuffing patellofemoral joint**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**malrotation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**tight flexion and/or extension gaps**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**joint line elevation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**excessive tightening of extensor mechanism during closure**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "closure in flexion (as opposed to extension) may limit this complication",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "tight PCL in cruciate-retaining prosthesis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "delayed rehabilitation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "HO",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
