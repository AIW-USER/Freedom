          "children": [
            {
              "text": "overall complication rate is 1-2%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Dorsal sensory branch of ulnar nerve**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "averages 8mm from 6R portal",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "at risk with establishment of 6U and 6R portals",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "to a lesser extent main **ulnar nerve and artery also at risk**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "when performing a TFCC repair, small open incision is typically made prior to knot tying to prevent injury to this nerve.",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Superficial sensory branch of radial nerve**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "averages 16mm from 3-4 portal",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "at risk during arthroscopy of basal joint, as 1U and 1R portals are on either side of the first branch of this nerve",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "at risk during placement of 1-2 portal",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Radial artery Injury**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "associated with establishment 1-2 portal, used for arthroscopic radial styloidectomy.",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "dorsal branch at risk with CMC portals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Extensor tendon injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "most commonly **EPL** and **EDM due to improper portal placement**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Chondral injuries**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "iatrogenic from scope or instrument placement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Portal site infection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Stiffness**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**MCPJ pain**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "typically caused by over-distraction",
              "table": null,
