{
  "title": "Spinal Cord Tumors",
  "url": "https://www.orthobullets.com/spine/2072/spinal-cord-tumors",
  "subtitle": "Updated: Mar 23 2025",
  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Primary central nervous system (CNS) tumor of the spine is classified as",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**intradural extramedullary**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**intradural intramedullary**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**extradural**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "primary CNS tumors most common intracranially",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "2-4% occur in the spine",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "850-1,700 diagnosed in United States annually",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Intradural Extramedullary Tumors",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "account for 60-70% of all primary CNS spinal cord tumors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "typically present with symptoms related to",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**central cord compression**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**radicular pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**deep seated back pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**most intense at night**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**associated cauda equina-like symptoms**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Schwannoma**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most common intradural tumor along with meningiomas",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "peak incidence in **40s-50s**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**equal occurrence between men and women**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "most are benign, with malignant subtypes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "arise from **dorsal nerve root**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "may be associated with",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**neurofibromatosis type II**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "imaging",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "MRI exhibits mass arising from dorsal root",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2072/images/schwannoma.jpg",
                      "caption": "Schwannoma"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "T1 shows isotense mass",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "T2 shows hyperintensity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "common locations:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cervical spine (31%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "cauda equina (24%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "thoracic spine (22%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "upper cervical spine (16%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "conus medullaris (4%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "histology",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "difficult to distinguish from neurofibroma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "biphasic, **Antoni A (hypercellular) and B (hypocellular) pattern**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "elongated nerve cells in collagen background",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2072/images/schwannoma_high-powered.jpg",
                      "caption": "High-powered histology"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**S-100 positive**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "surgical resection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "post-operative radiation for malignant tumors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Meningioma**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "accounts for 25% of all primary spinal cord tumors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "most often occurs in:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**women (80%)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**thoracic spine**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "peak incidence during **5th and 6th** decades of life",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "risk factors include:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**neurofibromatosis type II**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "previous history of radiation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "imaging",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "MRI",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "well-circumscribed, dura-based lesion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "on T1, iso- or hypointense",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "on T2, slightly hypertensive with homogenous enhancement with contrast",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "histology",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lobulated architecture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may contain **meningothelial whorls**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2072/images/whorls.jpg",
                      "caption": "High-powered view"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "if symptomatic, **surgical resection**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "can be curative with complete resection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "for recurrence, radiation should be considered",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Intradural Intramedullary Tumors",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "account for 20-30% of all intradural tumors in adults and 50% in children",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "typically present with symptoms related to:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**local or radicular pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**motor deficits (65%)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**sensory deficits (60%)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**sphincter dysfunction (38%)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**often initial symptom**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Ependymoma**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "most common intradural intramedullary primary CNS tumor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "classified as:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "benign",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**myxopapillary** (40-50%)",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**cellular** (42%)",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "malignant",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**anaplastic**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "imaging",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "myxopapillary",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**on MRI, encapsulated lesion in the filum terminale**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "on T1, hypo- or isointense",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**on T2, hyper intense**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**heterogeneous on contrast enhancement**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**other features typically seen are:**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "**vertebral body scalloping**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**neural foraminal enlargement**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**scoliosis**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**tumor seeding in the sacrum**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "cellular",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "on MRI, similar to myxopapillary",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "distinguishing characteristic",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "**polar cysts**",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/2072/images/polar_cyst.jpg",
                                  "caption": "MRI c-spine"
                                }
                              ],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "hemorrhage",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "histology",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cellular, monomorphic cells",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "characteristic **rosettes and pseudorosettes**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2072/images/rosettes.jpg",
                      "caption": "Rosettes"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "gross total resection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "good prognosis, especially if planes are maintained",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Astrocytoma**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "most are benign (30%)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "peak incidence in **third decade** of life",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "most common in **children** (80-90% of intramedullary tumors)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "imaging",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "on MRI",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fusiform appearance with irregular margins",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "On T1, hypo- or isointense",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "On T2, hyper intensive with variable contrast enhancement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "typically found in **cervicothoracic** junction in children",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "histology",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "hypercellular, mitotic figures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**eosinophilic granules** are common",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "gross total resection difficult due to infiltrative nature",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "radiation typically used to supplement surgery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "chemotherapy may be beneficial",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Extradural Tumors",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Metastasis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "extramedullary",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "representative of advancing systemic disease",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "'drop' metastases from cranial lesion possible",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "spread via CSF",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "intramedullary",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rare, <1% of all systemic malignancies",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "most commonly from:",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**lung**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "breast",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "imaging",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "rapidly expanding, progressive on MRI",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "intramedullary commonly found in **cervical** region and **conus medullaris**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
