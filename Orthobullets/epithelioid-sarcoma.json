{
  "title": "Epithelioid Sarcoma",
  "url": "https://www.orthobullets.com/pathology/8076/epithelioid-sarcoma",
  "subtitle": "Updated: Jun 22 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Epitheliod Sarcomas are rare, slow-growing, malignant, nodular, soft tissue tumors that most commonly occur in the hand and wrist.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "The condition is typically seen in patients between the ages of 10 and 35 who present with a small, firm, painless, mass in the upper extremity.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing a characteristic nodular pattern with central necrosis within granulomatous areas.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually wide surgical excision with radiation.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs in adolescents and young adults (ages 10-35 years)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "2:1 male to female ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common soft tissue sarcoma of the **hand and wrist**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "also occurs in forearm, buttock/thigh, knee, and foot",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "mass is deep or superficial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may ulcerate and mimic skin carcinoma, rheumatoid nodule, or granuloma when superficial",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may be attached to tendons, tendon sheaths, or fascia when deep",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unknown",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Malignancy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "regional **lymph node metastases** common",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "systemic metastasis to lungs can occur",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Symptoms",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "small, firm, painless, slow-growing mass commonly occurring in the upper extremity",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8076/images/epithelioid%20sarcoma.jpg",
                  "caption": "Shows an epithelioid sarcoma of the middle finger."
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3-6 cm firm, painless mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may have skin ulceration",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**calcification** occurs within the lesion in 10-20%",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8076/images/epithelioid%20sarcoma%20pa%20radiograph.jpg",
                  "caption": "Shows bony destruction caused by an epithelioid sarcoma of the ring finger."
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "erosion of adjacent bone is sometimes found",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indeterminate in appearance",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8076/images/epithelioid%20sarcoma%20forearm%20mri.jpg",
                  "caption": "Shows high signal intensity of an epithelioid sarcoma"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**dark on T1**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**bright on T2**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "tendon sheath nodule may be visualized",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Characteristics",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "nodular pattern with **central necrosis** within granulomatous areas",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8076/images/epithelioid%20sarcoma%20histology%20low-power.jpg",
                  "caption": "Shows the nodular appearance of epithelioid sarcoma."
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "epithelial appearance with ovoid or polygonal cells with eosinophilic cytoplasm",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8076/images/epithelioid%20sarcoma%20histology%20high-power.jpg",
                  "caption": "Shows the epithelial appearance of epithelioid sarcoma."
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "dense, hyalinized collagen deposits intercellularly",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "cellular pleomorphism is rare",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**keratin-positive** staining",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wide excision with adjuvant radiotherapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "all operable tumors",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "perform **sentinel node biopsy to evaluate for regional lymph node metastasis**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "high rate of multiple recurrences if mistaken for a benign lesion and inadequately excised",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "re-excision of the tumor bed is recommended for inadequate initial resection",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "amputation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "may be necessary to prevent spread of disease in cases of multiple recurrences",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Extremely poor",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
