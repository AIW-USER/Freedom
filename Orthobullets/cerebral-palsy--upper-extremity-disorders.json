                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "release of the adductor pollicis, transfer of tendons, and stabilization of the MCP joint",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "as a functional procedure in patients with voluntary control, IQ of 50-70 or higher, and better sensibility",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Finger-Flexion Deformity",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a result of intrinsic muscle tightness along with extrinsic overpull of the finger extensors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "swan-neck deformities can often be helped with correction of the wrist flexion deformity",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4129/images/cp%20swan%20neck.jpg",
                  "caption": "Swan neck deformities"
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
