{
  "title": "Acute Subclavian Artery Thrombosis",
  "url": "https://www.orthobullets.com/hand/12302/acute-subclavian-artery-thrombosis",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acute upper extremity ischemia caused by a **proximal occlusion at the level of the subclavian artery**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "<1% of population",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**aortic arch abnormality**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**aortic arch syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**trauma**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "arterial catheterization",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pre-existing stenosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "limb pain occurs secondary to lack of blood flow to the extremity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "unclear but may be secondary to nonocclusive proximal atherosclerotic plaque and/or cardiac embolization",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Blood Supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "left",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "subclavian is the third branch off the aortic arch",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12302/images/subclavian_artery_anatomy.jpg",
                      "caption": "Aortic arch anatomy showing right and left subclavian arteries"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "right",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "subclavian is one of two branches of the brachiocephalic (innominate) artery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "subclavian supplies vertebral artery which join to form basilar artery to supply cerebellum",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12302/images/subclavian-artery-branches-to-the-brain.jpg",
                  "caption": "Arterial anatomy demonstrating branching of the subclavian artery and vertebral arteries forming the basilar artery to the brain"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sudden onset of symptoms without inciting event",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Atrial fibrillation is associated in 80% of the cases of upper extremity thromboembolism",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**arm pain**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "nausea",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "severity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**paresthesias**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cyanotic/pale upper extremity**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "diffuse tenderness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cold limb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**a normal neurologic examination** is common",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**pulses absent** (axillary, brachial, radial, and ulnar)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "doppler signals may be present in nonocclusive disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "different blood pressures may be noted on affected and unaffected upper extremity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "increased pain and fatigue with upper extremity with the exertion of the limb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Arteriography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended diagnostic modality",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12302/images/arteriography.jpg",
                  "caption": "Angiography of the aortic arch with nonocclusive occlusion of the left subclavian artery (black arrow)"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "allows for percutaneous treatment of the occlusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT angiography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be performed expeditiously to rule out other causes of occlusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cannot treat occlusion at time of diagnosis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12302/images/mri_showing_left_subclavian_blockage.jpg",
                  "caption": "MRI angiogram showing occlusion of left subclavian artery (red circle)"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Doppler ultrasonography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Echocardiography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can rule out cardiac embolus following treatment of thrombosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hypercoagulable panel be performed to rule out underlying disorder",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "labs often unremarkable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral and IV anticoagulation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "limited role for nonoperative treatment with limb-threatening ischemia",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "intravenous and oral anticoagulation can be used to supplement percutaneous or surgical treatment",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "percutaneous treatment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "any patient with symptomatic limb ischemia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "intra-arterial thrombolysis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "percutaneous transluminal angioplasty (PTA)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "manual aspiration",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "stenting",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "surgical treatment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "any patient with symptomatic limb ischemia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "embolectomy/thrombectomy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "bypass grafting",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Limb ischemia**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "gangrene",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "loss of limb",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Basilar stroke**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "delay in diagnosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "prolonged ischemia can progress to decreased cerebral perfusion and acute stroke symptoms",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "iatrogenic",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "if vertebro-basilar artery system is left unprotected during endovascular treatment embolism can occur",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Outcomes with treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "favorable prognosis has been reported with prompt recognition and treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes without treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "progression to stroke and upper extremity amputation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
