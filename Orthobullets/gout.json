{
  "title": "Gout",
  "url": "https://www.orthobullets.com/basic-science/9041/gout",
  "subtitle": "Updated: Oct 16 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gout is a form of inflammatory arthritis caused by intraarticular monosodium urate crystal deposition that typically presents with recurrent acute exacerbation of joint swelling and severe pain.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made by joint aspiration and crystal analysis showing strongly negatively birefringent needle-shaped intracellular crystals.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment for acute gout attacks is NSAIDs with chronic gout being treated with allopurinol and medical management to reduce uric acid.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recurrent attacks seen in **men** from ages 40-60 years",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually seen in lower limb",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**podagra** (arthritis attacks of great toe)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "crystal deposition as tophi",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ear helix, eyelid olecranon, Achilles tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "chemotherapy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Forms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**primary gout**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "an idiopathic disorder of nucleic acid metabolism that leads to hyperuricemia and deposition of monosodium urate crystals in joints (a purine breakdown product)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**secondary gout**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "is associated with a disease with high metabolic turnover (psoriasis, hemolytic anemia, leukemia, chemotherapy)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dysfunctional nucleic acid metabolism causing **hyperuricemia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "deposition of monosodium urate crystals in synovium of joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "crystals lead to an inflammatory response activating",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "proteases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "prostaglandins",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "leukotriene B4",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "free oxygen radicals",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**renal stones**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**septic arthritis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "the presence of uric acid crystals does not exclude septic arthritis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain in joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can resemble septic arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "symptoms of renal stones",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may have decreased range of motion due to pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "white toothpaste-like appearance of tophus aspirate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of affected joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may see punched out periarticular erosion with sclerotic overhanging borders",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may see **soft tissue crystal deposition** (tophi)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**serum uric acid**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "elevated uric acid is not diagnostic (80% of people with an elevated uric acid will never have a gout attack)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Crystal analysis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis made by **joint aspiration and crystal analysis**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "monosodium urate (MSU) crystals are",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "thin, tapered, **needle-shaped** intracellular crystals",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "yellow when aligned parallel to red compensator",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "blue when aligned across the direction of polarization",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "strongly **negatively birefringent**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9041/images/22b_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acute gout",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "indomethacin vs. colchicine",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**indomethacin** (indocin) 50mg tid",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "NSAID",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "inhibits phagocytosis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "colchicine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**indicated in acute attacks if patient has a history of peptic ulcers**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**inhibits** inflammatory mediators",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "can be given intravenously",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "oral, intraarticular or IV glucocorticoid",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "patient unable to take NSAID or colchicine",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Chronic gout",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allopurinol",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment for chronic gout attack",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "allopurinol is an xanthine oxidase inhibitor",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "colchicine",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for prophylaxis after recurrent attacks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "up to 85% effective",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
