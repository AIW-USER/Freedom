{
  "title": "Tibial Tubercle Fracture",
  "url": "https://www.orthobullets.com/pediatrics/4023/tibial-tubercle-fracture",
  "subtitle": "Updated: Jun 10 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Tibial Tubercle Fractures are common fractures that occur in adolescent boys near the end of skeletal growth during athletic activity.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be confirmed with plain radiographs of the knee.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on location of the fracture, degree of displacement, and any associated injuries.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "less than 1% of pediatric fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males >> females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ages 12 - 15 (approaching skeletal maturity)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common in basketball, football, sprinting and high jump",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "growth hormone supplementation weakens physeal cartilage, increasing avulsion fracture risk",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pathophysiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Mechanisms of injury**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**a concentric contraction of the quadriceps during jumping**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "an eccentric contraction **of the quadriceps** during forced knee flexion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**compartment syndrome (4%)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "meniscal tears with Type III injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**proximal tibia has two ossification centers**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "primary ossification center (proximal tibial physis)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "secondary ossification center (tibial tubercle physis or apophysis)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "insertion of patellar tendon",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "physeal closure occurs from posterior to anterior and proximal to distal, with the tibial tubercle the last to fuse",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "places distal secondary center at greater risk of injury in older children",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extensor mechanism exerts great force at secondary ossification center",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Blood Supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**recurrent anterior tibial artery can be lacerated**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "can be cause of compartment syndrome",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Based on level of fracture and presence of fragment displacement",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Type III most common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Ogden Classification (modification of Watson-Jones)**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture of the secondary ossification center near the insertion of the patellar tendon",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/tibial%20tubercle%201a.jpg",
                          "caption": "Illustration of Type 1 tibial tubercle fracture."
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture propagates proximal between primary and secondary ossification centers",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/tibial%20tubercle%202a.jpg",
                          "caption": "Type 2 tibial tubercle fracture."
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Coronal fracture extending posteriorly to cross the primary ossification center",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/tibial%20tubercle%203a.jpg",
                          "caption": "Type 3 tibial tubercle fracture"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/displaced_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type IV",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture through the entire proximal tibial physis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/tibial%20tubercle%204.jpg",
                          "caption": "Type 4 proximal tibial tubercle fracture."
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/tibial_tuburcle_fx_2_lat.jpg",
                          "caption": "Type IV Tibial Tuburcle Fx, Lateral xray"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type V",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Periosteal sleeve avulsion of the extensor mechanism from the secondary ossification center",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4023/images/tibial%20tubercle%205.jpg",
                          "caption": "Type 5 proximal tibial fracture illustration."
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Modifier: A (nondisplaced), B (displaced)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sudden onset of pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "generally occurs during the initiation of jumping or sprinting",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "inability to immediately ambulate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "knee swelling/hemarthrosis with Type III injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection & palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "knee effusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tenderness at the tibial tubercle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "evaluate for anterior compartment firmness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ROM & instability",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**extensor lag or extensor deficiency** in Type II or III injuries",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "retinacular fibers may allow for active extension",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "neurovascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**monitor for increasing pain suggestive of compartment syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "optional views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**internal rotation view** will bring the tibial tubercle into profile",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4023/images/int_rotation_tibi_tub_fx..jpg",
                      "caption": "Internal Rotation view"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**comparison views of contralateral** knee in younger pediatric patients",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "widening or hinging open of the apophysis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fracture line may be seen extending proximally and variable distance posteriorly",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "anterior swelling may be the only sign in the setting of a periosteal sleeve avulsion (type V injury)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "patella alta",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be useful to evaluate for intra-articular or posterior extension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "arteriogram if concern for popliteal arterty injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "should not delay intervention in setting of compartment syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4023/images/mrisag-mmtear-pcm_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "generally not indicated",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "useful for determining fracture extension in a nondisplaced Type II injury or type V injury",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "long leg cast in extension for 6 weeks",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Type I injuries or those with minimal displacement (< 2 mm)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "acceptable displacement after closed reduction/cast application",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open reduction internal fixation with arthrotomy +/- arthroscopy, +/- soft tissue repair",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "Type II-IV fractures - need to visualize joint surface for perfect reduction and evaluate for intra-articular pathology",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "soft tissue repair for Type V (periosteal sleeve) fracture",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Open reduction and internal fixation**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "midline incision to the fracture site",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "evaluate and clean fracture site",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "remove any soft tissue (periosteum) interposition",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "anatomic reduction of fracture fragments",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "internal fixation with 4.0 cancellous, partially threaded screws",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4023/images/intra-op_crpp..jpg",
                      "caption": "Intra-operative fluoro showing reduction using partially threaded screws"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "larger screws can be used but may cause soft tissue irritation in the long-term",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "smooth K wires for younger child (>3y from skeletal maturity)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative care",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "immobilization",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "non-weightbearing in long leg cast or brace for 4-6 weeks",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "rehabilitation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "progressive extensor mechanism strengthening",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "return to sports no sooner than 3 months",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pros & cons",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "pros",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "anatomic reduction and stable fixation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "excellent healing potential",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "may allow for earlier range of motion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "cons",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "incision and associated complications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "hardware irritation can necessitate implant removal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction and internal fixation with arthrotomy or arthroscopy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "midline approach and parapatellar arthrotomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "joint surface must be visualized to assure anatomic reduction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "alternatively, arthroscopy can be used to directly assess the articular reduction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "same as above",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "evacuate intra-articular hematoma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "visualize joint surface to achieve anatomic reduction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "evaluate for meniscal tears and repair or debride as appropriate if soft tissue repair indicated",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative care",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "immobilization",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "long leg cast for 4-6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "non-weight bearing",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "rehabilitation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "progressive extensor mechanism strengthening",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "return to sports at 3 months",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "pros & cons",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "pros",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "addresses intraarticular extension and soft tissue injuries",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "cons",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "arthrotomy may require longer immobilization and/or rehabilitation",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Soft tissue repair**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "similar to above",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "midline incison to fracture site",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
