{
  "title": "Congenital Trigger Thumb",
  "url": "https://www.orthobullets.com/hand/6084/congenital-trigger-thumb",
  "subtitle": "Updated: Mar 4 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Trigger Thumb is a congenital pediatric condition of the thumb that results in abnormal flexion at the interphalangeal joint.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with the presence of a flexion deformity at the thumb IP joint.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is nonoperative management with splinting for flexible deformities. Surgical A1 pulley release is indicated in fixed deformities beyond the age of 12 months.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prevalence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3 per 1,000 children are diagnosed by the age of 1 years",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "separate entity to adult acquired trigger thumb",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**male and females affected equally**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "25% are bilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "etiology of pediatric trigger thumb remains unknown",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**flexor pollicis longus (FPL) tendon is thickened** due to abnormal collagen degeneration and synovial proliferation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "increased FPL tendon diameter, compared to the A1 pulley, causes disruption of normal tendon gliding",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly an **acquired condition**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "some reports suggest autosomal dominance with variable penetration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**term congenital trigger thumb is now considered a misnomer**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "presenting complaint is usually fixed thumb flexion deformity at the IP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "history of trauma is rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "family history of disease is rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually painless",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may be bilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**flexion deformity at the IP joint**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "prominence of the flexor tendon nodule, referred to as **\"Notta's node\"**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "deformity may be fixed with loss of IP joint extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually preserved",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral views of the hand",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "additional views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dedicated thumb views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**recommended only if history of trauma**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually diagnosed based on clinical presentation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**radiographs are usually normal**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "passive extension exercises and observation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "not recommended for fixed deformities in older children",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "passive thumb extension exercises",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "duration based on clinical response",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "30-60% will resolve spontaneously before the age of 2 years old",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "<10% will resolve spontaneously after 2 years old",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "intermittent extension splinting",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**first line of treatment**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**more successful than observation alone**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "consider alongside stretching regime",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "flexible deformity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "not recommended with fixed deformity in older children",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "splints maintain IP joint hyperextension and prevent MCP joint hyperextension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "duration for 6-12 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "50-60% resolution in all age groups",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "high drop out rate from therapy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "A1 pulley release",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "fixed deformity beyond age of 12 months of age",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "failed conservative treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "65-95% resolution in all age groups",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**A1 Pulley Release**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "open release",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "small transverse incision in the thumb MCP flexion crease, extending over the A1 pulley",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "protect the radial digital nerve",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "sharp dissection of the A1 pulley",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "identify the Notta nodule in the FPL tendon",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "watch nodule under direct vision during passive IP extension of the thumb to ensure there is smooth FPL tendon gliding",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Digital nerve injury**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "caution must be performed during release as digital nerves at high risk due to proximity to flexor tendon and A1 pulley",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Wound complications**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "scar contracture",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "abscess",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "infection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**IP flexion deficit**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Bow-stringing of flexor tendon**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "usually related to release of the oblique pulley",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Natural history",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually begins with notable thumb triggering that **progresses to a fixed contracture**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "spontaneous resolution unlikely after age of 2 years old",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
