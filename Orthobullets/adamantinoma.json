    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wide-margin surgical resection",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "standard of care in most patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "often requires intercallary resection with allograft or intercallary megaprosthesis reconstruction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**as adamantinoma is a low-grade malignancy, radiotherapy and/or chemotherapy is not typically used for local control of disease**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "May metastasize to lungs (25%), therefore long-term followup is recommended",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Recurrence is uncommon with negative margin excision",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
