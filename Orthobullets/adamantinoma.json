                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Tibial diaphysis lesion**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Treated with wide-resection alone**",
                      "table": null,
