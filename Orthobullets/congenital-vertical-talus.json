{
  "title": "Congenital Vertical Talus",
  "url": "https://www.orthobullets.com/pediatrics/4066/congenital-vertical-talus",
  "subtitle": "Updated: Dec 29 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Vertical Talus is a rare congenital condition caused by neuromuscular or chromosomal abnormalities in neonates that typically presents with a rigid flatfoot deformity.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with forced plantar flexion lateral radiographs that show persistent dorsal dislocation of the talonavicular joint.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually serial manipulation and casting followed by surgical release and talonavicular reduction and pinning at age 6-12 months.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology:",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare, 1:150,000 births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "M:F ratio of 2:1",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "50% bilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rigid foot deformity**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "irreducible dorsolateral navicular dislocation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "vertically oriented talus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "calcaneal eversion with attenuated spring ligament",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**soft tissue contractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "displacement of peroneal longus and posterior tibilais tendon so they function as dorsiflexors rather than plantar flexors",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "contracture of the Achilles tendon",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Genetics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "a positive family history is present in up to 20% of patients",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "HOXD10 gene mutation (transcription factor)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**50% associated with neuromuscular disease or chromosomal aberrations**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "Myelomeningocele",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "Arthrogryposis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "Diastematomyelia",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "congenital dislocation of the hip",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "cerebral palsy",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "spinal muscular atrophy",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rigid rockerbottom deformity**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fixed hindfoot equinovalgus",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "due to contracture of the Achilles and peroneal tendons",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "rigid midfoot dorsiflexion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "secondary to the dislocated navicular",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "forefoot abducted and dorsiflexed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "due to contractures of the EDL, EHL and tibialis anterior tendons",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**prominent talar head**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "can be palpated in medial plantar arch on exam",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "produces a convex plantar surface",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "gait abnormality",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patient may demonstrate a \"peg-leg\" or a calcaneal gait due to poor push-off power",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "limited forefoot contact, excessive heel contact",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurologic deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "a careful neurologic exam needs to be performed due to frequent association with neuromuscular disorders",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, oblique and lateral foot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**vertically positioned talus & dorsal dislocation of navicular**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4066/images/Neutral%20lateral%20xray%20-%20courtesy%20Miller_moved.png",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "line along long axis of talus passes below the first metatarsal-cuneiform axis",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "before ossification of navicular at age 3, the first metatarsal is used as a proxy for the navicular on radiographic evaluation",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "talocalcaneal angle > 40° (20-40° is normal)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4066/images/Talocalcaneal%20angle_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "alternative views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**forced plantar flexion lateral radiograph is diagnostic**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "shows persistent dorsal dislocation of the **talonavicular joint**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4066/images/plantar%20flexion%20lateral%20xray%20-%20courtesy%20Miller_moved.png",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "oblique talus reduces on this view",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "Meary's angle > 20° (between line of longitudinal axis of talus and longitudinal axis of 1st metatarsal)",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/4066/images/meary%20and%20talocal%20labeled.jpg",
                              "caption": "Shows Meary&#39;s and talocalcaneal angle in CVT"
                            }
                          ],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "forced dorsiflexion lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "reveals fixed equinus",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**neuraxial imaging should be performed to rule out neurologic disorder**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "1",
      "children": [
        {
          "text": "**Oblique talus**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "anatomic variant",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "talonavicular subluxation that **reduces with forced plantarflexion of the foot**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment is generally observation, shoe inserts vs casting",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "some require surgical pinning of the talonavicular joint and achilles lengthening for persistent subluxation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Calcaneovalgus foot deformity",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Posteromedial tibial bowing",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Tarsal coalition",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Paralytic pes valgus",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Pes planovalgus",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**serial manipulation and casting**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "indicated preoperatively to **stretch the dorsolateral soft-tissue** structures",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "foot is manipulated into inversion and plantarflexion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "typically still requires closed vs open pinning of the talonavicular joint with percutaneous achilles tenotomy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical release and talonavicular reduction and pinning",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated in most cases",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "performed at 6-12 months of age",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "involves pantalar release with concomitant lengthening of peroneals, Achilles, and toe extensors",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4066/images/posteromedial%20approach%20-%20courtesy%20Miller_moved.png",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "talonavicular joint is reduced and pinned while reconstruction of the plantar calcaneonavicular (spring) ligament is performed",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4066/images/sp%20reduction%20and%20pinning%20-%20courtesy%20Miller_moved.png",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "concomitant tibialis anterior transfer to talar neck",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "minimally invasive correction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "new technique performed in some centers to avoid complications associated with extensive surgical releases",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "principles for casting are similar to the Ponseti technique used clubfoot",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "serial casting utilized to stretch contracted dorsal and lateral soft tissue structures and gradually reduced talonavicular joint",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "once reduction is achieved with cast, closed or open reduction is performed and secured with pin fixation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "percutaneous achilles tenotomy is required to correct the equinus deformity",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "talectomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indicated in resistant case",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "triple arthrodesis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "as salvage procedure",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Missed vertical talus**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "reconstructive options are less predictable after age 3, and patients may require triple arthrodesis as salvage procedure",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Poor in untreated cases and associated with significant disability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
