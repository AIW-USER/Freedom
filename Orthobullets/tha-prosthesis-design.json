  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Biomechanics of total hip arthroplasty depend on",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "prosthesis design",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bearing surface and **lubrication characteristics**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "fixation method",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Designs include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "femoral component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cemented",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5033/images/cemented_stem.jpg",
                      "caption": "cemented stem illustration"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "press-fit (uncemented)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5033/images/cementless-femoral-stems-img-jisrf.jpg",
                      "caption": "cementless femoral stem"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "tapered stems",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "extensively porous coated stems",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "modular stems",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "acetabular components",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5033/images/polyethylene_vs_metal.jpg",
                  "caption": "poly vs metal"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "cemented",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "polyethylene",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "metal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "press-fit (uncemented)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "metal",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Modular dual-mobility liners",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "Decreased risk of dislocation in revision setting",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Unique possibility of liner malseating in the acetabular cup",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "bearing surfaces",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5033/images/bearing_surfaces.jpg",
                  "caption": "bearing surfaces"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "polyethylene",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "metal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ceramic",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "History",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "1891",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Dr. Gluck performs first reported attempt at a hip replacement with ivory used to replace the femoral head",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "1940",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Austin Moore performs first metallic hip replacement surgery (hemiarthroplasty) with a proximal femoral replacement bolted to the femur",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "1952",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Austin Moore prosthesis developed",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5033/images/austin_moore.jpg",
                  "caption": "Austin Moore Illustration"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/5033/images/austin_moore2.jpg",
                  "caption": "Austin Moore 2"
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "1960s",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Sir John Charnley introduces concept of low friction arthroplasty",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "concept",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "termed \"low friction\" as a small femoral head was used to reduce wear",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "components",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5033/images/lowfriction.jpg",
                      "caption": "Charnley low friction"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "metal femoral stem",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "polyethylene acetabular component",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "acrylic bone cement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Press-fit Femoral Stems",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "rely on **biologic fixation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**compression hoop stresses provide** initial stability",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Types",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tapered stems",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most are proximally coated stems that taper distally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "examples",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Tri-Lock (DePuy)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5033/images/tri-lock.jpg",
                          "caption": "tri-lock"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "M/L Taper (Zimmer)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5033/images/mltaper.jpg",
                          "caption": "M/L taper"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "extensively coated stems",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "porous coating extends into the diaphysis for distal engagement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "examples",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "AML (DePuy)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5033/images/depuy_aml..jpg",
                          "caption": "aml"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "VerSys Full Coat (Zimmer)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5033/images/beaded_fullcoat.jpg",
                          "caption": "beaded fullcoat"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "modular stems",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "distal stem and proximal body can be \"mixed-and-matched\"",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "examples",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "S-ROM (DePuy)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5033/images/s-rom.jpg",
                          "caption": "srom"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "ZMR (Zimmer)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/5033/images/zmr-tapered-ills1.jpg",
                          "caption": "ZMR2"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "collared vs. collarless stems",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "pros and cons to both designs",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Unique complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**intraoperative fracture**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "more likely in press-fit through lateral approach",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "typically due to underreaming",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**loosening**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "high loosening rate when used in irradiated bone (due to lack of ingrowth)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**junctional corrosion**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5033/images/junctional_corrosion.jpg",
                  "caption": "junctional corrosion"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "seen in modular components (including cemented modular components)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "common in modular neck stems and can result in metallosis and pseudotumor formation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Cemented Femoral Stems",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "rely on cement fixation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "cement is a grout that provides initial and long-term stability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "limited remodeling potential",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "preferred for irradiated bone due to the bone's limited ability for ingrowth",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "preferred for poor proximal femoral bone stock (i.e. Dorr C femurs)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "composition",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "cobalt-chrome or stainless steel",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most common",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "reduce cement stresses",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "titanium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "prone to micromotion and debonding",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "less stiff than cobalt-chrome or stainless steel stems",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "cemented titanium stems leads to crevice corrosion (use of cemented titanium alloy stems is no longer recommended)",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Unique complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**stem breakage**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "cemented stems are smaller than press-fit stems and unable to tolerate as much cantilever bending",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5033/images/broken_cement_stem.jpg",
                      "caption": "broken cemented stem"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may occur in cementless stems as well",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Bearing Surfaces",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Metal-on-polyethylene**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "metal (cobalt-chrome) femoral head on polyethylene acetabular liner",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5033/images/metla_on_poly..jpg",
                  "caption": "metal on poly"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "benefits",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "longest track record of bearing surfaces",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "lowest cost",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "most modularity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "higher wear and osteolysis rates compared to metal-on-metal and ceramics",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "smaller head (compared to metal-on-metal) leads to higher risk of impingement",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Metal-on-metal**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/5033/images/metal_on_metal.jpg",
              "caption": "metal on metal"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "benefits",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "better wear properties than metal-on-polyethylene",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "lower linear wear rate",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "debris particles much smaller (but more numerous) than those of metal-on-poly",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "overall smaller volume of particles",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "larger head allows for increased ROM before impingement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "disadvantages",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "more expensive than metal-on-polyethylene",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "increased metal ions in serum and urine (5-10x normal)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "serum metal ion concentration highest at 12-24 months",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "correlates with the initial \"wear in\" or \"run-in\" phase of increased particle generation, but then followed by a \"steady state\" phase of decreased particle generation",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "no proven cancer link",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "may form pseudotumors",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5033/images/pseudotumor.jpg",
                      "caption": "pseudotumor"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "hypersensitivity (Type IV delayed type hypersensitvity)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "mediated by T-cells",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "metals sensitize and activate T-cells (nickel > cobalt and chromium)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "however, most participating cells are macrophages (only 5% are lymphocytes)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "antigen-activated T-cells secrete cytokines that activate macrophages",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "activated macrophages have increased ability to present class II MHC and IL-2, leads to increased T-cell activation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "the cycle continues",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "contraindications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "pregnant women",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "renal disease",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
