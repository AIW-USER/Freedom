    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**no serological tests** are specific for disease",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "laboratory tests for bacterial infection are negative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Biopsy and diagnositc injections",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "skin biopsy may be helpful but is rarely necessary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Non-operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "general measures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "smoking cessation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**skin moiturization**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "avoidance of irritants",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "topical corticosteroids, oral retinoid, photochemotherapy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "first-line therapy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "slow-risk for adverse effects with topical corticosteriod therapy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Not contagious**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Varies in severity and can persist for many years",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Little effect on general health",
          "table": null,
