              "children": []
            },
            {
              "text": "worsend by pressure, rubbing and friction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may have discomfort walking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "significant psychologic effect",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
