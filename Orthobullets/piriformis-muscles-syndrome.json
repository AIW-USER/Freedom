{
  "title": "Piriformis Muscles Syndrome",
  "url": "https://www.orthobullets.com/knee-and-sports/3095/piriformis-muscles-syndrome",
  "subtitle": "Updated: Jun 1 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Piriformis syndrome is a condition characterized by sciatic symptoms (leg pain) due to extrapelvic sciatic nerve compression at the hip.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with pain in the posterior gluteal region and migrating down the back of the leg which is made worse with flexion, adduction, and internal rotation of hip.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is rest, NSAIDs, and physical therapy focused on stretching the piriformis muscle and short external rotators.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sciatic nerve entrapment occurs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**anterior to piriformis muscle** or posterior to obturator internus/gemelli complex",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "at **level of ischial tuberosity**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**anatomic anomalies** may contribute to compression including",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**bipartite piriformis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "variations of sciatic nerve path",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "tumors",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "aneurysm of inferior gluteal artery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**femoroacetabular impingement**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "decreased internal rotation may contribute to contractures of short external rotators and compression on sciatic nerve",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Sciatic nerve",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "exits",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "inferior to piriformis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3095/images/6_moved.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3095/images/7_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "superior to superior gemellus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "external rotators of the thigh include (superior to inferior)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "piriformis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "superior gemellus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "obturator internus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "inferior gemellus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "obturator externus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "quadratus femoris",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain in the posterior gluteal region and migrating down the back of the leg**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "pain may be burning or aching in nature similar to sciatica symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**FAIR test**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**Flexion, Adduction**, and **Internal Rotation of hip** can reproduce symptoms",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3095/images/fair%20test.jpg",
                      "caption": "FAIR test"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "maneuver places piriformis muscle on tension",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unremarkable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually unremarkable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lumbar MRI helpful to rule out spine as cause of compression of sciatic nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Electrodiagnostic studies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can document functional impairment of sciatic nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, NSAIDS, muscle relaxants, PT, steroid injections",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "focused on **stretching the piriformis muscle and short external rotators**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**corticosteroid injection directed near the piriformis muscles**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "piriformis muscle release and external sciatic neurolysis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "only indicated in refractory cases after failed conservative measures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
