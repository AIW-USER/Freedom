{
  "title": "Subaxial Cervical Vertebral Body Fractures",
  "url": "https://www.orthobullets.com/spine/2018/subaxial-cervical-vertebral-body-fractures",
  "subtitle": "Updated: Aug 19 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Subaxial cervical vertebral body fractures are a subset of cervical spine injuries that consist of compression fractures, burst fractures, flexion teardrop fractures, and extension teardrop avulsion fractures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs of the cervical spine. CT scan can be helpful for fracture characterization and surgical planning",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment can be nonoperative or surgical stabilization depending on fracture pattern, mechanical stability, and the presence of neurologic deficits",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Types",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**compression fracture**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "characterized by",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "compressive failure of the anterior vertebral body without disruption of posterior body cortex and without retropulsion into spinal canal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "often associated with posterior ligamentous injury",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**burst fracture**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2018/images/Xray-Lateral-Burst%20fracture_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2018/images/Xray-Lateral-Burst-fracture_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2018/images/CT%20-%20Sagital%20-%20C5%20burst%20fracture_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "characterized by",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "fracture extension through posterior cortex with retropulsion into the spinal canal",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "often associated with posterior ligamentous injury",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "prognosis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "often associated with complete and incomplete SCI",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "treatment",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "unstable and usually requires surgery",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**flexion teardrop fracture**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2018/images/flexion%20teardrop%20injury.jpg",
                  "caption": "Shows flexion teardrop injury"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "characterized by",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "anterior column failure in flexion/compression",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "posterior portion of vertebra retropulsed posteriorly",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "posterior column failure in tension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "larger anterior lip fragments may be called 'quadrangular fractures'",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "prognosis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "associated with SCI",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "treatment",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "unstable and usually requires surgery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**extension teardrop avulsion fracture**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2018/images/extension%20teardrop.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "characterized by",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "anterior endplate with an avulsion of a small fleck of bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "usually occurs at C2",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "must differentiate from a true teardrop fracture",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "mechanism",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "extension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "prognosis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "stable injury pattern and not associated with SCI",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "treatment",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "cervical collar",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Subaxial Spine Injury Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Allen and Ferguson classification of subaxial spine injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically used for research and not in the clinical setting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "based solely on static radiographic appearance and mechanisms of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "six groups represent a spectrum of anatomic disruption and include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "flexion-compression",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "vertical compression",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "flexion-distraction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "extension-compression",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "extension-distraction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "lateral flexion",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Radiographic description classification of subaxial spine injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more commonly used in clinical setting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "includes:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "compression fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "burst fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "flexion-distraction injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "facet dislocation (unilateral or bilateral)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "facet fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incomplete vs. complete SCI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "must determine whether there is a posterior ligamentous injury",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "collar immobilization for 6-12 weeks",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "stable **mild compression** fractures (intact posterior ligaments and no significant kyphosis)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "anterior teardrop avulsion fracture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "external halo immobilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "stable fracture pattern (intact posterior ligaments and no significant kyphosis)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anterior decompression, corpectomy, strut graft, and fusion with instrumentation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "compression fracture with 11° of angulation or 25% loss of vertebral body height",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "unstable **burst fracture** with cord compression",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "unstable **teardrop** fracture with cord compression",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "minimal injury to posterior elements",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "early decompression (<24 hours) has been shown to improve neurologic outcomes compared with delayed (≥24 hours) decompression",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "posterior decompression and fusion with instrumentation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "significant injury to posterior elements",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "anterior decompression not required",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
