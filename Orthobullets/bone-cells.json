{
  "title": "Bone Cells",
  "url": "https://www.orthobullets.com/basic-science/9002/bone-cells",
  "subtitle": "Updated: Aug 17 2021",
  "sections": [
    {
      "text": "Osteoblasts",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Origin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**derived from undifferentiated mesenchymal cells**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "mesenchymal cells then differentiate into osteoprogenitor cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Structure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contain increased amounts of endoplasmic reticulum, Golgi apparatus, and mitochondria than other cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "allows for synthesis and secretion of bone matrix",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**form bone** by producing non-mineralized matrix",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "alkaline phosphatase",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "type I collagen",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "osteonectin",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "osteocalcin",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "stimulated by 1,25 dihydroxyvitamin D",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "regulate osteoclast function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Signaling",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**osteoblastic differentiation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "BMP stimulates mesenchymal cells to become osteoprogenitor cells",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "core binding factor alpha-1 (cbf alpha -1: RUNX2)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**stable beta-catenin plays a major role in inducing cells to form osteoblasts with resulting intramembranous bone formation**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "platelet derived growth factor (PDGF) induces osteoblast differentiation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "insulin derived growth factor (IDGF) induces osteoblast differentiation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**osteoblast bone production**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "PTH receptor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "stimulates alkaline phosphatase and type I collagen production",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "1,25 dihydroxyvitamin D receptor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "stimulates matrix and alkaline phosphatase synthesis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "production of bone specific proteins (osteocalcin)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "estrogen inhibits bone resorption and stimulates bone production by inhibiting adenylyl cyclase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "glucocorticoids inhibit collagen and bone matrix production",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "prostaglandins stimulate bone resorption by activating adenylyl cyclase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**osteoclast signaling**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "interconnected signaling allows coupling of bone resorption and formation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "osteoclast activation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**PTH receptors on osteoblast bind to PTH** which when leads to expression of **RANKL**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "RANKL binds to RANK receptor on osteoclast and bone resorption",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "osteoclast inhibition",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "osteoblasts can secrete **OPG (osteoprotegrin)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "OPG binds to RANKL on the osteoblast, preventing RANK activation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "inhibits osteoclast activity",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**regulation of hematopoietic cells and immune response**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "occurs through the Jagged1-Notch pathway",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "PTH induces Jagged1 on osteoblasts",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "Jagged1 stimulates Notch receptors on the membrane of hematopoietic stem cells which results in cell proliferation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more metabolically active cells at the bone surface",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "less active cells in more central bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "activated by disruption of the more peripheral osteoblasts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Osteoclasts",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reabsorb bone",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9002/images/osteoclast.jpg",
                  "caption": "A histologic image showing a multinucleated osteoclast."
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "osteoblasts regulate osteoclast bone reabsorbtion (see above)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "steps in resorption cycle",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "migration to resorption site",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bone attachment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "polarization (formation of membrane domains)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "dissolution of hydroxyapatite",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "degradation of organic matrix",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "removal of degradation products from resorption lacuna",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "apoptosis of the osteoclasts or return to the non-resorbing stage.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Origin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "originate from **myeloid hematopoietic cell**s from monocyte/macrophage cell lineage",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**monocyte progenitors fuse together to form mature multinuclear cells**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Cellular biology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cellular anatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "multinucleated giant cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "cellular physiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bone reabsorbtion occurs at ruffled border",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Howship's lacunae**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "are site of bone resorption where ruffled border meets bone surface",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**tartrate-resistant acid phosphatase**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "secreted by osteoclasts to lowers the Ph (utilizing carbonic anhydrase) and increases the solubility of hydroxyapatite crystals",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "deficiency of carbonic anhydrase prevents bone resorption",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "proteolytic digestion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "the organic matrix is then removed by proteolytic digestion",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "**cathepsin K**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "**is one major proteolytic enzyme that degests organic matrix at ruffled border**",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "bisphosphonates mechanism",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "prevents osteoclasts from forming ruffled border and producing acid hydrolases",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Molecular biology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**osteoclast-bone attachment**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**osteoclast attaches to bone matrix at sealing zone**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "attach to bone surfaces via integrins on osteoclast surface",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "integrins include αVβ3, αVβ5, α2β1, αVβ1",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "αVβ3 (on osteoclast) is a receptor for vitronectin (on bone surface)",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/9002/images/vitronectin.jpg",
                              "caption": "shows vitronectin and osteoclast"
                            }
                          ],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "Arg-Gly-Asp (RGD) sequence of extracellular bone proteins directly allows binding to integrins",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/9002/images/osteoclast2.jpg",
                              "caption": "Osteoclast"
                            }
                          ],
                          "importance": "5",
                          "children": [
                            {
                              "text": "antibodies to αVβ3 and RGD inhibit bone resorption",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**osteoclast polarization**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9002/images/osteoclast_zones.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "contain specialized membrane domains",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "ruffled border (RB)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "functional secretory domain (FSD)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "basolateral membrane (BL)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**mineralized bone matrix degradation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "hydroxyapatite crystals dissolved by HCl secreted through ruffled border into resorption lacuna (RL)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "RL is an extracelllular space between RB and bone matrix, sealed from ECF by sealing zone",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "uses ATP-consuming proton pumps in RB and in intracellular vacuoles",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "H+ come from carbonic anhydrase II",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "RB has high number of chloride channels (maintain electroneutrality)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**organic bone matrix degradation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "lysosomal cysteine proteinases",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "matrix metaloproteinases (MMPs), esp MMP-9",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cathepsin K",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "mutation in cathepsin K gene leads to pycnodysostosis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**removal of degradation products**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "by transcystosis to FSD, where they are secreted into ECF",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tartrate-resistant acid phosphatase (TRAP) is localized in transcytotic vesicles, generates reactive O2 species that destroys collagen",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**osteoclast-osteoblast signaling**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "osteoblasts upregulate and downregulate osteoclast activity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "osteoclast activation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "RANKL (NF-kB ligand)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "expressed by osteoblasts and tumor cells to activate osteoclasts",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**IL-1**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "found adjacent to loose total joint implants and known to activate osteoclasts",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "osteoclast inhibition",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**calcitonin**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "IL-10",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Osteocytes",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Origin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "are former osteoblasts trapped in the matrix they produced",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "account for 90% of cells in the mature skeleton",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Structure",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9002/images/osteocyte.jpg",
              "caption": "Histologic image showing osteocytes as indicated by arrows."
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "high nucleus to cytoplasm ratio",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "have long cellular processes which communicate with other cells via canalculi in the bone",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "maintain bone and cellular matrix",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "important in regulation of calcium and phosphorous concentrations in bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "do not express alkaline phosphatase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Signaling",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stimulated by calcitonin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inhibited by PTH",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "communicate with adjacent osteocytes via **gap junctions in canaliculi**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Osteoprogenitor Cells",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
