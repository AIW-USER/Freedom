{
  "title": "Ankle Arthrodesis",
  "url": "https://www.orthobullets.com/foot-and-ankle/7052/ankle-arthrodesis",
  "subtitle": "Updated: Sep 21 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ankle arthrodesis is the fusion of the tibiotalar joint most commonly performed for end-stage arthritis of the joint.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The procedure may be performed with an open approach or arthroscopically.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The most common complications are development of subtalar arthritis and nonunion.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "painful arthritis following",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "trauma (most common cause)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "chronic instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AVN of the talus",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inflammatory arthropathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "primary OA",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neuropathic arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tumor resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "salvage for failed ORIF",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "salvage for failed TAA",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Optimal Position",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**neutral dorsiflexion**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**5-10° of external rotation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**5° of hindfoot valgus**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**5 mm of posterior talar translation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Arthroscopic arthrodesis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "only indicated if minimal deformity present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Open arthrodesis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "transfibular approach often used when deformity present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "screw fixation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "plate and screw construct",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "external fixation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "fusion of the talonavicular joint decreases hindfoot ROM >90%",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "staged approach",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "infection should be cleared prior to placement of definitive internal hardware for arthrodesis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tibiotalocalcaneal (TTC) fusion with retrograde intramedullary nail",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Load-sharing device with improved bending stiffness and rotational stability compared to plate-and-screw constructs",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7052/images/hindfoot%20nail_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "Indications:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "End-stage ankle and subtalar arthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Charcot neuroarthropathy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Significant hindfoot bone loss (failed total ankle arthroplasty, failed arthrodesis)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Osteonecrosis of the talus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "lateral transfibular approach allows for dual joint preparation as well as local autograft",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Severe acute trauma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Contraindications:",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "Active infection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Profound vascular disease",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Severe tibia malalignment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nonunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "10% non union rate",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tobacco users have 2.7x risk",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "neuropathy is greatest risk factor for persistent nonunion with revision of nonunion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Lateral plantar nerve injury**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Superficial peroneal nerve**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "injury to superficial peroneal nerve during transfibular approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Hindfoot arthritis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "adjacent hindfoot arthritis commonly occurs following fusion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "isolated hindfoot arthritis due to chronic pes planus is treated with subtalar joint arthrodesis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    }
  ],
