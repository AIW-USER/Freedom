{
  "title": "ROSA® Knee with OptimiZe™: Robotic Knee Arthroplasty",
  "url": "https://www.orthobullets.com/implants/423358/rosa-r--knee-with-optimize-tm--robotic-knee-arthroplasty",
  "subtitle": "Updated: May 14 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The ROSA® Knee System is indicated for use as a stereotaxic instrumentation system in total knee replacement surgery to assist in the accurate placement of compatible fixed-bearing knee implant components.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "It achieves this through a robotic arm, an optical tracking system, and software that provide software-defined spatial boundaries and orientation information based on intra-operatively recorded anatomical landmarks.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "This platform is used during primary total knee arthroplasty for skeletally mature patients to enhance alignment accuracy and facilitate intra-operative joint balancing.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Related Implants",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Persona® The Personalized Knee®",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "restores a neutral mechanical axis while addressing specific patient needs through versatile constraint options, including cruciate retaining or posterior stabilized designs",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Total knee replacement surgery",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "software-defined spatial boundaries for orientation and reference information to identifiable anatomical structures for accurate placement of knee implant components",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "significant bone loss",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "severely limiting range of motion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "active infection of the knee joint area",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "knee replacement revision surgery",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "femoral head center",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "femoral axis point",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "posterior condyles",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "anterior and posterior trochlear groove points",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "medial and lateral epicondyles",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "vastus medialis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "muscle fibers",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "saphenous artery and vein, femoral artery and vein, and popliteal artery and vein",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Approach",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Patient positioning",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patient is placed supine",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "OR layout",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Robotic Unit is positioned approximately at the patient’s hip and approximately 45° relative to the surgical table",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Optical Unit is positioned on the opposite side of the surgeon and Robotic Unit",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Four OR configurations are supported",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "right knee with surgeon on same side as operated knee",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "right knee with surgeon opposite the operated knee",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "left knee with surgeon on same side as operated knee",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "left knee with surgeon opposite the operated knee",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Exposure",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "incision and exposure are based on surgeon choice of technique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Visibility and safety",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "trackers must remain visible throughout landmarking, evaluation, and resections",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "camera may be repositioned when needed except during femoral head center acquisition and bone tracking",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Case setup",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "case is created and tracked through ZB Edge Case Portal® and uploaded to the ROSA® Knee System before surgery",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "case is launched from the Robotic Unit using a USB drive and case management application",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "incorrect case information requires quitting and relaunching the correct case",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Image-based workflow",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "pre-operative X-rays are used to reconstruct a patient-specific 3D bone model",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "X-Atlas® 2D to 3D technology is used to generate the virtual femur and tibia model",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Imageless workflow",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "surgeon may elect not to plan the case before the surgery date",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "generic bone schematics are displayed in the user interface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "imageless planning is performed intra-operatively",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Setup and registration",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "ROSA Arm Instrument Interface is installed and Force Sensor is calibrated",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "ROSA Base Reference Frame and ROSA Arm Reference Frame are installed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Robotic Unit is aligned with the operative leg axis and knee joint line",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Optical Unit laser is aimed at the NavitrackER on the ROSA Arm Reference Frame during camera setup",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "OptimiZe Landmarking™",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "distal femoral condyle painting is used to capture the most distal condylar regions",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "tibiofemoral contact points in flexion and extension are used for knee-state and gap assessment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Biomechanical Contact Post is described as creating a starting point for extension and flexion laxity assessment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "landmarking features are intended to reduce user landmarking variability and support consistent landmark positions",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "OptimiZe Planning™",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "OptimiZe Planning™ automatically positions Persona® Knee implants based on a selected surgeon profile",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "feature is available only for Persona® implants",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "selected profile proposes a plan that best matches profile requirements",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "OptimiZe Kinematic Alignment™",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "feature provides an automated Kinematic Alignment plan based on bony landmarks",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "femoral wear evaluation uses distal and posterior condylar cartilage and bone wear",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "tibial wear evaluation uses medial and lateral tibial plateau wear where PTA references were taken",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "LDFA and MPTA are displayed when Kinematic Alignment is active and landmarking is completed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "OptimiZe Tracking™ with Active Track™",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Active Track™ enables collaborative resections without pinning the Cut Guide to bone for selected femoral distal and tibial proximal resections",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Active Track™ is disabled by default",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "when enabled, Robotic Arm remains in Collaborative mode during the corresponding resection",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Active Track™ allows bony resections to remain on plane with leg movement",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "key precautions include soft-tissue protection, leg stability, visible NavitrackERs, and continuous Foot Pedal pressure during resection",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "workflow can revert to pinning at any time during the Active Track™ resection flow",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "OptimiZe Experience™",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "simplified interface allows selection of workflow and display options",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "surgeon can tailor which information is displayed for each case",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "viewing options can be set pre-operatively through ZB Edge Case Portal®",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Resections entry",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "APPROVE PLAN opens the RESECTIONS panel",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Cut Guide Checkpoint verifies registration and correct ROSA TKA Cut Guide installation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Bone Reference Checkpoint verifies femoral and tibial reference stability when selected",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "user can start with femoral distal or tibial proximal resection",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "direct panel access is disabled while in a resection flow",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "ROSA HOME is not accessible during a resection flow unless the flow is cancelled",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Femoral distal resection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Arm transitions to Collaborative mode near the cut plane",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "pins are placed through FEMUR holes, with optional oblique pin for additional stability",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "resection is performed and validated with the Universal Validation Tool Body",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "pins are removed after resection",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Tibial proximal resection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Arm transitions to Collaborative mode near the cut plane",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "pins are placed through TIBIA holes, with optional oblique pin for additional stability",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Active Track™ workflow allows tibial proximal resection without pinning if enabled",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Femoral 4-in-1 positioning",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "accessible after distal femoral resection is completed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "medial 4-in-1 pin is placed first and live cut values are reviewed",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "lateral 4-in-1 hole is drilled after confirmation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "final 4-in-1 bone resections are performed with the appropriate standard finishing guide according to implant system technique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Final evaluation and data confirmation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "final Knee State Evaluation can be performed with trials or final implants in place",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "final case data review includes implant brand, component type and size, bearing thickness, bearing type, final HKA, and Knee State Evaluation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "data can be saved with trial components, saved with final implants, or not saved",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Removal of instrumentation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Checkpoint Screws are removed if the checkpoint workflow was used",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Bone Reference set screws are loosened with a 3.5 mm screwdriver",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Bone References are removed from Fix Fluted Pins",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Fix Fluted Pins are removed from bone using a power tool on reverse setting",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "bending pins during removal should be avoided",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Technical specifications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "System components",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Robotic Unit",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "Robotic Arm",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Touchscreen",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "immobilization system",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Foot Pedal",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "computer",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "software",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "Optical Unit",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "Optical Camera",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Touchscreen",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "camera positioning arm",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tracking",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Optical tracking uses NavitrackER devices mounted to tracked instruments and references",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "NavitrackER devices are single use and must not be resterilized",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "bone references must remain stable throughout the case",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Bone Reference Checkpoint can be used to verify femoral and tibial reference stability after landmarking",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Foot Pedal functions",
          "table": null,
          "images": [],
          "importance": "-1",
