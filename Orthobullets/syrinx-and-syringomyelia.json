{
  "title": "Syrinx & Syringomyelia",
  "url": "https://www.orthobullets.com/spine/2011/syrinx-and-syringomyelia",
  "subtitle": "Updated: Mar 4 2026",
  "sections": [
    {
      "text": "Definitions",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definitions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**syringomyelia**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "a syrinx (fluid filled cavity) within the spinal cord that progressively expands and leads to neurologic deficits",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**syringobulbia**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "a syrinx within the brain stem that leads to neurologic symptoms",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Synringomyelia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "prevalence of the disease is about 8.4 cases per 100,000 people",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "demographic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occurs more frequently in men than in women",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "usually appears in the third or fourth decade of life",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually result from lesions that partially obstruct CSF flow including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**craniocervical junction abnormalities**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "more than 50% related to Chiari malformations (CM)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "herniated cerebellar tonsils act as pistons obstructing subarachnoid space at foramen magnum creating pressure wave in subarachnoid space with each heartbeat",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**spinal cord trauma**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "found in 4-10% of patients with spinal cord injury",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "may become apparent years after the injury",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**spinal cord tumors**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "30% of patients with a spinal cord tumor develop a syrinx",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**post-infectious (e.g. meningitis)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "due to scarring from arachnoiditis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**developmental scoliosis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "25% to 80% of cases of syringomyelia may have scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "neural axis malformations found in 1.8% to 25% of patients initially diagnosed with idiopathic scoliosis depending on case series and referral patterns",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Klippel-Feil deformity**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**Charcot's joints**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "occurs in < 5% with syringomyelia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "often involves shoulder joint",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Syringomyelia**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "symptoms usually begin insidiously between adolescence and age 45",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "occipital headache",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "sometimes exacerbated by Valsalva maneuver",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "back pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "radicular pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "neurologic deficits",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "syringomyelia often presents with a central cord syndrome",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "reflexes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "asymmetric abdominal reflexes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "asymmetric and/or hyperactive reflexes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "asymmetric sweating",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "spasticity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "motor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "asymmetric muscle bulk",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "weakness",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "sensory",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "deficits in pain and temperature sensation in a capelike distribution over the back of the neck",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "light touch and position and vibration sensation are usually not affected",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "deformity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "lower extremity contracture and deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "scoliosis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Syringobulbia**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "symptoms related to cranial nerve involvment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "tongue weakness and atrophy (CN XII)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "sternocleidomastoid & trapezius weakness (CN XI)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dysphagia and dysarthia (CN IX, CN X)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "facial palsy (CN VII)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": []
    },
    {
      "text": "",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "relative lack of apical lordosis may indicate presence of syrinx",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "scoliosis series for evaluation of scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not applicable for characterization of syrinx, only for associated scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis of syrinx made by MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obtain MRI with gadolinium enhancement to rule out associated tumor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "indications for MRI in patients with scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "abnormal curve (e.g. double curve, apex left)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "neurologic deficit",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "infantile or juvenile age at onset",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "male gender with atypical or large curve",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thoracic kyphosis >30 degrees",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Histopathology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gross pathology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cavitation of spinal cord gray matter",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "syrinx in continuity with or adjacent to central canal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inner layer of gliotic tissue",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hydromyelia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Glioependymal cysts",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Myelomalacia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Cystic tumors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Persistent central canal",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "if asymptomatic, non-elarging syrinx, most pediatric neurosurgeons recommend against prophylactic surgery",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "orthopaedic management may include observation or bracing during neurosurgical and neurologic evaluations but results of bracing mixed",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decompression of the foramen magnum and upper cervical cord +/- shunting",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "cranial nerve deficits",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "extremity motor weakness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "cerebellar findings",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "sensory deficit",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "done prior to spinal arthrodesis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "effect of decompression on neurologic signs and symptoms is variable but supported due to propensity of deficits to progess",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "some evidence shows neurosurgery alone may improve spinal deformity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "but scoliosis still likely to progress in large curves or children >8 years old",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "spinal fusion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "depends on age of presentation and curve characteristics",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "timing of orthopaedic intervention debatable",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "most recommend waiting 3 to 6 months after neurosurgical decompression",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "5",
      "children": [
        {
          "text": "In general, same as for idiopathic scoliosis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Increased risk of neurologic deterioration including paralysis if fusion done with undiagnosed syrinx",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Natural history",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not well defined",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prognosis depends on degree of spinal deformity and neurologic deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "multiple authors report resolution or improvement in syrinx size and neurologic deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
