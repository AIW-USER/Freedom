{
  "title": "Pyogenic Flexor Tenosynovitis",
  "url": "https://www.orthobullets.com/hand/6105/pyogenic-flexor-tenosynovitis",
  "subtitle": "Updated: Feb 20 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pyogenic flexor tenosynovitis is an infection of the synovial sheath that surrounds the flexor tendon.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with the presence of the 4 Kanavel signs.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is urgent irrigation and debridement of the flexor tendon sheath with IV antibiotics.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**2.5 to 9.4%** of all hand infections",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diabetes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "IV drug use",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "immunocompromised patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**penetrating trauma** to the tendon sheath",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**direct spread** from",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "felon",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "septic joint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "deep space infection",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "infection travels in the synovial sheath that surrounds the flexor tendon",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "microbiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Staph aureus** (40-75%)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most common",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**MRSA** (29%)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "intravenous drug abusers",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**other common skin flora**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "staph epidermidis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "beta-hemolytic streptococcus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "pseudomonas aeruginosa",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**mixed flora and gram negative organsims**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "in immunocompromised patients",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Eikenella**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "in human bites",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Pasteurella multocida**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "in animal bites",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**\"horseshoe abscess\"**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "may develop from spread pyogenic flexor tenosynovitis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "many individuals have a connection between the sheaths of the thumb and little fingers at the level of the wrist (Space of Parona)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6105/images/w%20tendon%20sheaths.jpg",
                          "caption": "Flexor sheaths of the hand"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "infection in one finger can lead to direct infection of the sheath on the opposite side of the hand resulting a \"horseshoe abscess\"",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Tendon sheaths",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "to protect and nourish the tendons",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "anatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "variations common",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6105/images/variations.jpg",
                      "caption": "Flexor tendon sheath and bursal variations"
                    }
                  ],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "sheaths extends from",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6105/images/w%20tendon%20sheaths.jpg",
                      "caption": "Flexor sheaths of the hand"
                    }
                  ],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**index, middle, and ring fingers**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "from DIP to just proximal to A1 pulley",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**thumb (flexor pollicus longus sheath)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "from IP joint to as proximal as radial bursa (in wrist)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**little finger**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "from DIP joint to as proximal as ulnar bursa (in wrist)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain and swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "typically present in delayed fashion (over last 24-48 hours)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "usually localized to palmar aspect of one digit",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Kanavel signs (4 total)**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6105/images/pft1.jpg",
                  "caption": "Clinical example of pyogenic flexor tenosynovitis"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6105/images/pft2.jpg",
                  "caption": "Clinical example of pyogenic flexor tenosynovitis"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "**flexed posturing of the involved digit**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**tenderness to palpation over the tendon sheath**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**marked pain with passive extension of the digit**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**fusiform swelling of the digit**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "increased warmth and erythema of the involved digit",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "radiographs usually not required, but may be useful to rule out foreign object",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cannot distinguish infectious flexor tenosynovitis from inflammatory but may help determine the extent of the ongoing process",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6105/images/tenosynovitis.jpg",
                  "caption": "Flexor tenosynovitis"
                }
              ],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Felon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Cellulitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Deep space infection",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Collar button infection",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination (Kanavel signs)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative (rare)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hospital admission, IV antibiotics, hand immobilization, observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "early presentation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "splinting",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "if signs of improvement within 24 hours, no surgery is required",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "I&D followed by culture-specific IV antibiotics",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "low threshold to operative once suspected (orthopaedic emergency)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "late presentation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "no improvement after 24 hours of non-operative treatment (confirmed diagnosis)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique (see below)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**I&D of flexor tendon**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "full open exposure using long midaxial or Bruner incision",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "two small incisions placed distally at A5 pulley and proximally at A1 pulley and using an angiocatheter",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Stiffness**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Tendon or pulley rupture**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Spread of infection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Loss of soft tissue**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Osteomyelitis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
