{
  "title": "Flexor Carpi Radialis Tendinitis",
  "url": "https://www.orthobullets.com/hand/6033/flexor-carpi-radialis-tendinitis",
  "subtitle": "Updated: Feb 8 2024",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Flexor carpi radialis tendinitis is a condition characterized by pain over the volar radial wrist caused by inflammation of the FCR tendon sheath.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with pain over the FCR tendon that worsens with **resisted wrist flexion.**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment usually involves immobilization, NSAIDs and injections. In rare refractory cases operative release of the FCR tendon sheath may be indicated.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "< 1 per 100,000 annually",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**repetitive wrist flexion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**golfers and racquet sports**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**manual labor**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary stenosing tenosynovitis within the fibroosseous tunnel (see Anatomy)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "secondary tendinitis associated with",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "scaphoid fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "scaphoid cysts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "distal radius fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "scaphoid-trapezium-trapezoid joint arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thumb CMC joint arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Flexor carpi radialis musculotendinous unit**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6033/images/fcr%20musculotendinous%20unit.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "**FCR muscle**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "bipennate",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "FCR tendon",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "enveloped by sheath from musculotendinous origin to trapezium",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "no fibrous sheath distal to trapezium",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "enters fibroosseous tunnel at the proximal border of the trapezium",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "boundaries",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6033/images/tunnel.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": [
                        {
                          "text": "radial = body of the trapezium",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "palmar = trapezial crest, transverse carpal ligament",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "ulnar = retinacular septum from transverse carpal ligament (separates FCR from carpal tunnel)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "dorsal = reflection of retinacular septum on trapezium body",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "space",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**within the tunnel**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "the FCR tendon occupies 90% of space",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "is in direct contact with the roughened surface of the trapezium",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "more prone to constriction, tendinitis, attrition, rupture",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**proximal to the tunnel**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "the FCR tendon occupies 50-65% of space within FCR sheath proximal to the tunnel",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "less prone to constriction",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "but more prone to mechanical irritation from osteophytes",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "insertion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6033/images/insertion.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "small slip (1-2mm) inserts into trapezial crest",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "80% of remaining tendon inserts into 2nd metacarpal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "20% of remaining tendon inserts into 3rd metacarpal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "volar radial aspect of the wrist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tenderness over volar radial forearm along FCR tendon at distal wrist flexion crease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "provocative test",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**resisted wrist flexion** triggers pain",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**resisted radial wrist deviation** triggers pain",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "in primary tendinitis, radiographs are unremarkable",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "in secondary tendinitis, the following may be present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "healed scaphoid fracture",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "healed distal radius fracture",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "exostosis or arthritis of scaphotrapezoid joint or thumb CMC",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "best seen on T2",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**increased signal around FCR sheath** on T2 image",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6033/images/fcr%20mri.jpg",
                      "caption": "MRI"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "may find associated conditions in secondary tendinitis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "ganglion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "scaphoid cyst",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnostic injection",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**injection** of local anesthetic along FCR sheath relieves symptoms",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differentials",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Thumb CMC arthritis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Scaphoid cyst",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Ganglion cyst",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "De Quervain's tenosynovitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Carpal tunnel syndrome",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Clinical and MRI",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination and can be confirmed with MRI studies",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization, NSAIDS, steroid injection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "direct steroid injection in proximity, but not into tendon",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "usually effective for primary tendinitis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "unsuccessful in secondary tendinitis if other lesions are present (e.g. osteophytes)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical release of FCR tendon sheath",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**rarely needed but can be effective in recalcitrant cases**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "TechniqueS",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Surgical release of FCR tendon sheath**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "volar longitudinal incision starting proximal to the wrist crease, extending over proximal thenar eminence",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6033/images/incision.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "care taken to **avoid**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**palmar cutaneous branch of median nerve**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**lateral antebrachial cutaneous nerve**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**superficial sensory radial nerve**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "elevate and reflect thenar muscles radially",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "expose FCR sheath",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "open FCR sheath proximally in the distal forearm, and extend to the trapezial crest",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "at the trapezial crest, the tendon enters the FCR tunnel",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "at this point, **incise** the sheath along the ulnar margin, taking care not to injure the tendon",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**mobilize** tendon from trapezoidal groove (releasing trapezial insertion)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Complications of disease",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "FCR attrition and rupture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Complications of surgical release",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cutaneous nerve injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**palmar cutaneous branch of median nerve**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**lateral antebrachial cutaneous nerve**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**superficial sensory radial nerve**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "injury to deep palmar arch",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "injury to FPL tendon (lies superficial to FCR tendon)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**injury to FCR tendon within the tunnel**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "decompression is easy proximal to the tunnel (incision of FCR sheath)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "within FCR fibroosseous tunnel, take care to avoid cutting FCR tendon",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Poor prognostic variables",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "history of overuse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "worker's compensation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "failure to respond to local injection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "long duration of symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
