{
  "title": "Atlantoaxial Rotatory Displacement (AARD)",
  "url": "https://www.orthobullets.com/spine/2050/atlantoaxial-rotatory-displacement-aard",
  "subtitle": "Updated: Nov 19 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Atlantoaxial Rotatory Displacement is a pediatric cervical spine rotatory instability caused by C1-C2 subluxation or facet dislocation",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "The most common presentation is a young child who presents with torticollis.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made by dynamic CT scan of the cervical spine.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment can be a soft collar, halter traction, halo traction, or surgical fusion depending on the chronicity of the condition.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spectrum of disease that ranges from mild subluxation to fixed facet dislocation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common causes include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**infection (~35%)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may have history of pharyngitis or otitis media",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Grisel's disease is the condition of AARD following a respiratory infection or retropharyngeal abscess",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "thought to be linked to lymphatic edema in area of cervical spine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**trauma (~24%)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**recent head or neck surgery (~20%)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "idiopathic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "associated conditions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Down's syndrome**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**rheumatoid arthritis**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "tumors",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "congenital anomalies",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mechanism is thought to be related to ligamentous laxity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "transverse ligament integrity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**transverse ligament is intact**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "spinal canal stenosis can only occur with severe rotation and facet dislocation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**transverse ligament is ruptured**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "and there is a component of anterolithesis (> 5mm), then spinal canal stenosis can occur with less rotation (45 degrees)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "vertebral arteries may also be at risk",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Axis Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "axis has odontoid process (dens) and body",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "embryology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "develops from five ossification centers",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2050/images/ossification%20center%20c2_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "subdental (basilar) synchondrosis is an initial cartilagenous junction between the dens and vertebral body that does not fuse until ~6 years of age",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2050/images/basilar_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the secondary ossification center appears at ~ age 3 and fuses to the dens at ~ age 12",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Occipital-C1-C2 ligamentous stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "provided by the odontoid process and its supporting ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**transverse ligament**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2050/images/combined_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "limits anterior translation of the atlas",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**apical ligaments**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "limit rotation of the upper cervical spine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**alar ligaments**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "limit rotation of the upper cervical spine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Fielding Classification of AARD**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Unilateral** facet subluxation with intact transverse ligament",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Odontoid acts as a pivot point with 1 facet subluxating anteriorly, 1 facet subluxating posteriorly.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Most common and benign type",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2050/images/aard_pic.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Unilateral** facet subluxation with 3 to 5 mm of anterior displacement.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Injured Transverse ligament",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "1 facet acts as a pivot point and 1 lateral mass is displaced anteriorly",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2050/images/aard_pic.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Bilateral** anterior facet displacement of > 5 mm.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Rare with a higher risk of neurologic involvement or instantaneous death.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Both lateral masses are displaced",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2050/images/aard_pic.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type IV",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Posterior** displacement of the atlas (C1) (with odontoid fracture, or hypoplastic dens)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Rare with a higher risk of neurologic involvement or instantaneous death.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2050/images/aard_pic.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Physical Exam",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tilted head",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neck pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "headache",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ipsilateral rotation and contralateral tilt of the head in relation to the lateral mass of C1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "chin rotated to the side opposite the facet subluxation (e.g. right sided facet subluxation will have chin rotated to the left)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "contra-lateral sternocleidomastoid may be spastic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sternocleidomastoid (SCM) spasm occurs on the **SAME side as the chin** (e.g. right sided facet subluxation will have chin rotated to the left, and left SCM will be spastic)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "this protective spasticity occurs to reduce further subluxation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "C1-C2 subluxation (and resultant chin position) is primary, SCM spasm is secondary/reactive",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "in contrast to **congenital muscular torticollis** where the SCM spasm occurs on the OPPOSITE side of the chin (e.g. left SCM spasm will rotate the head to the right, and chin will be on the right)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "SCM spasm is primary",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "reduced cervical rotation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**AP, open-mouth odontoid**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "look for variation in **size and distance from midline** of C2 lateral masses (reflects rotation)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**lateral**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "facet joint appears anterior and wedge shaped instead of normal oval shape",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**cervical flexion & extension views**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may be useful to exclude instability",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "may be difficult due to position of head and resisted neck motion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Dynamic CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**is diagnostic gold standard**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "take CT with head straight forward, and then in maximal rotation to right and left",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "will see fixed rotation of C1 on C2 which does not change with dynamic rotation",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2050/images/spine%20articles_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "of little value unless neurologic symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "soft collar, NSAIDs, exercise program",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**subluxation present for < 1 week** (traumatic or Grisel's disease)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "many patients probably **reduce spontaneously** before seeking medical attention",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "head halter traction, NSAIDs, benzodiazepines, then hard collar x 3 months",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**subluxation persists > 2 weeks**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "persistent torticollis in spite of soft collar (above) x 2 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "small amount (5 lbs.) usually enough",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "either in hospital or at home",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "muscle relaxants and analgesics may be needed",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "halo traction, then halo vest x 3 months",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**subluxation persists > 1 mos.**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "failed halter traction x 2 weeks (above)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior C1-C2 fusion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**subluxation persists > 3 mos**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**neurologic deficits present**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**failed halo traction x 2 weeks**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
