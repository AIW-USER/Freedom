                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "discovered **incidentally** during surgery (e.g. ganglion removal)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**mass** on the dorsum of the hand",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6089/images/aeip%20clinical.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "**intermittent dorsal wrist pain** if muscle bellies impinge on and occupy the narrow dorsal compartments of the wrist",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mass does not transilluminate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**moves** with movement of local muscles (flexion and extension of hand and wrist(",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "becomes **firmer with grasp**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**resisted extension triggers pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "exclude other more common conditions e.g. ganglion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mass is isointense with muscle tissue",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**anomalous extensor indicis proprius (aEIP)**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**extensor digitorum brevis manus (EDBM)**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6089/images/edbm%20mri.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**extensor medii proprius (EMP)**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**extensor indicis et medii communis (EIMC)**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ganglion cysts",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Synovitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "both produce dorsal wrist pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical decompression of 4th dorsal compartment (aEIP) or reduction of muscle belly (EDBM)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6089/images/aeip%20surgical.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "failed conservative treatment, and symptoms, signs and imaging point to anomalous muscle, with no associated conditions (e.g. ganglion)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
