    {
      "text": "Gross Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Myotendinous junction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "weak link in muscle and often site of tears (especially with eccentric contraction)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "involution of muscles cells maximized surface area for attachment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Noncontractile elements",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9021/images/Anatomy%20Epimysium_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "3",
          "children": [
            {
              "text": "**Epimysium** surrounds muscle bundles",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**Perimysium** surrounds muscle fascicles",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**Endomysium** surrounds individual fibers",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Muscle Contraction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Contractile elements",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "derived from myoblasts",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "the muscles fiber (an elongated cell) is the basic unit of contraction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "a myofibril is a collection of sarcomeres",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Sarcomere composition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "filaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "thick myosin filaments",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thin actin filaments",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "bands",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9021/images/image013[1]_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "3",
              "children": [
                {
                  "text": "H band is myosin only",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "I band is actin only",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "A band is both actin and myosin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Z line flanks each sarcomere and acts as site of attachment for actin filament",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "during muscle contraction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "A band stays the same length",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "I band reduces in length",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "H zone reduces in length",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Action stimulation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nerve cell body delivers electrical signal to motor endplate (junction between muscle and nerve)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "nerve action potentials are started with passage of sodium ions through voltage gated channels",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Ach is released and diffuses across synaptic cleft to bind to Ach receptor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**myasthenia gravis** patient has shortage of Ach receptors",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**botox** blocks release of Ach from end plate",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Ach binding triggers depolarization of sarcoplasmic reticulum and **release of calcium** into muscles cytoplasm",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**excitation-contraction coupling**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9021/images/excitation-contraction_coupling.jpg",
                  "caption": "excitation contraction coupling"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**in low calcium environment**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**tropomyosin blocks myosin-binding sites on actin**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "in high calcium environment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "calcium binds to troponin (on thin filaments) leading to a configuration change of tropomyosin (on thin filaments)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "exposing myosin-binding sites on actin filament",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "actin forms cross-bridges to myosin, and the ATP breakdown, the two fibers contract past one another",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Types of muscle contraction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**isometric**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "muscle contracts with constant length (e.g. pushing against an immovable object)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**isokinetic**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "muscle contracts with constant speed (requires specific equipment like cybex machines)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**plyometric**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "rapid lengthening followed by contraction of muscle groups (e.g. jumping up and down on boxes)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**isotonic** - muscle contract with constant tension",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**concentric**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "muscle shortens during contraction (e.g. biceps curl)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**eccentric**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "muscle lengthens during contraction (e.g. \"negative\" of a biceps curl)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Force generation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "force generated is most dependent on **muscle cross-sectional area**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "muscle **fiber size** increases with strength conditioning",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Contraction speed",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "duration and speed of contraction is most dependent on **fiber type**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
