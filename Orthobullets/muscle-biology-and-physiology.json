    {
      "text": "Metabolic Systems",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Three systems are used to generate energy for muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ATP-CP anaerobic system**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "(adenosine triphosphate-creatinine phosphate system, \"phosphagen system\")",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "basis for creatine phosphate supplementation (main side effect: muscle cramping)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "used for intense metabolic exercise lasting **less than 20 seconds** (e.g., 100 meter sprint)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "converts carbohydrates stored within muscle into energy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**anaerobic** (does not use oxygen and does not produce lactate)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "formulas",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "ATP –» ADP + P + energy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "ADP –» AMP + P + energy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**lactic anaerobic system** (lactic acid metabolims)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "intense muscle activity lasting 20 to 120 seconds (e.g., 400 meter sprint)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "involves hydrolysis of one glucose molecule",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "formula",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "glucose –» lactic acid + energy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**aerobic system**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "used in longer duration and lower intensity exercises",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Krebs cycle generates ATP from glucose and fatty acids through oxidative phosphorylation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Muscle Injury",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Muscles soreness",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by **edema and inflammation** in the connective tissue",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "neutrophils are the most abundant cells early on after acute injury",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "generates free radicals that possibly increase muscle damage",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "worse with unaccustomed eccentric exercise",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "peaks at 24-48 hours",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "elevated CK levels seen in serum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Muscles strain",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occur at **myotendinous junction** (off during **eccentric contraction** which produces highest forces in skeletal muscle)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "pathoanatomy in inflammation followed by fibrosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "contraction bands seal off plasma membrane defects at regular intervals",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "prevents necrosis from extending along the entire myofiber length",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "basal lamina surrounding necrotic myofibers is not degraded by macrophage phagocytosis, leaving preserved cylindrical scaffolds",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Muscle atrophy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "caused by disuse or nerve injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "leads to fatty infiltration and **increased fatigability**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "muscles crossing a single joint atrophy faster",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "loss of cross-sectional area leads to decreased force generation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "use of Angiotensin-II receptor blockade increases muscle regeneration after contusion which decreases fibrosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "proposed mechanism is IGF-1 blockade decreasing apoptosis cascade",
                  "table": null,
