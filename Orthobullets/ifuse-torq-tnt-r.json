        },
        {
          "text": "Design features",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "FuSIon 3D™ surface is a 3D-printed porous lattice designed for osseointegration",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "variable thread heights and leads are tailored to posterior pelvis and designed to reduce loosening through pelvis-specific fixation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "TORQLock™ hooked thread profile is designed to reduce toggle",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "pelvis-specific 8.7 mm diameter is described by manufacturer as fitting most suitable S1 transsacral screw corridors",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pin Types",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
