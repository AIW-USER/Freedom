    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diffuse pain in the peripatellar or retropatellar area of the knee (major symptom)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "insidious onset and typically vague in nature",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "aggravated by **specific daily activities including**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**climbing or descending stairs**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**prolonged sitting with knee bent (known as theatre pain)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**squatting or kneeling**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "always consider the physical, mental and social elements of knee pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "quadricep muscle atrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "signs of patella maltracking",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increased femoral anteversion or tibial external rotation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral subluxation of patella or loss of medial patellar mobility",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "positive patellar apprehension test",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "palpable crepitus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain with **compression of patella with knee range of motion or resisted knee extension**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
