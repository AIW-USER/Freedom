{
  "title": "Occupational Health",
  "url": "https://www.orthobullets.com/basic-science/9082/occupational-health",
  "subtitle": "Updated: Jun 4 2025",
  "sections": [
    {
      "text": "Radiation Exposure and Fluoroscopy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Factors which **increase radiation exposure** levels during use of fluoroscopy",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "standing closer to the c-arm emitter",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "imaging large body parts",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "positioning extremity **closer to the x-ray source**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9082/images/high-frequency-mobile-x-ray-c-arm-machine_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "use of large c-arm rather than mini c-arm",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "radiation exposure is minimal during routine use of mini-c-arm fluoroscopy unless the surgical team is in the direct path of the radiation beam",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "use of intra-operative CT scanning (o-arm) increases the patient's baseline cancer risk by nearly 2 times (2.3 cases/10,000)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Factors to **decrease radiation exposure** to patient and surgeon",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**maximizing the distance between the surgeon and the radiation beam**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "minimizing exposure time",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "manipulating the x-ray beam with collimation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**orienting the fluoroscopic beam in an inverted position relative to the patient**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9082/images/carm%20radiation%20figure_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "strategic positioning of the surgeon within the operative field to avoid direct path of beam",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "use of protective shielding during imaging",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic surgeons are at elevated risk of breast cancer",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Upper outer quadrant of breast most common site of breast cancer",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Lead sleeves and axillary supplements reduce radiation to the breast",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Orthopaedic surgeons are at increased risk for cataract formation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "the National Council on Radiation Protection and Measurements (NCRP) recommends limiting cumulative annual exposures of the eyes to **< 50 mGy** of ionizing radiation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Risk of Transmission",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Risk of HIV transmission**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "needlestick",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "seroconversion from a contaminated needlestick is **~ 0.3%**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "exposure to large quantities of blood increases risk",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "seroconversion from exposure to HIV contaminated mucous membranes is **~0.09%**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "frozen bone allograft",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "risk of transmission is **<1 per million**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "donor screening is the most important factor in prevention",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "no reported cases of transmission from frozen bone allograft since **2001**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "blood transfusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "risk of transmission from blood transfusion is **1/500,000 per unit transfused**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "seronegative blood may still transmit virus due to delay between HIV infection and antibody development",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Risk of Hepatitis B transmission**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "needlestick",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "37% to 62% eventually seroconvert following needlestick",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "22 to 31% develop clinical Hepatitis B infection following needlestick",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Risk of Hepatitis C transmission**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "needlestick",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "0.5 to 1.8% risk of transmission",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Resident Surgeon Work Duty Hours",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "ACGME has restricted work hours in order to address impaired performance by residents caused by long duty hours",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Duty hours",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "clinical time",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "academic hours",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "administrative work",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "time on call",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "no more than 1 day per every 3 days in house",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "must include a 10-hour period of \"off-time\" between",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "clinics",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "on-call",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "restricted to 80 or less per week (averaged over a 4 week period)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "10% increase allowed if justified by educational value",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "1 day in 7 must be a day off (averaged over 4 week period)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Results of new duty hours",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early evaluations have caused concern over issues of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patient safety",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**continuity of care**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "communication and transfers in care have been cited as sources of decreased continuity of care as a sequelae of the 80-hour resident physician work week",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
