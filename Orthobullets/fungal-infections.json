{
  "title": "Fungal Infections",
  "url": "https://www.orthobullets.com/hand/6108/fungal-infections",
  "subtitle": "Updated: May 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cutaneous Fungal Infections of the hand are usually mild and are broken into 4 types: cutaneous, subcutaneous, deep and systemic.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made by careful history and physical exam and confirmed with positive fungi cultures.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally oral antifungal antibiotics with deep infections requiring surgical debridement.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Most common subcutaneous infection of the hand is *sporotrichosis*",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "onychomycosis is more common in middle-aged women",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "more common to have fungal infection in macerated skin areas (skin folds)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Candida more prevalent in patients working in moist environments or under water.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "immunocompromised patients at risk for Deep infections",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Depends on fungus species",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "Candida species are responsible for chronic or recurrent paronychia and found in moist environments",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "*Sporothrix schenckii* that is found in plants and soil.",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Infections divided into three categories",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cutaneous**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "includes nail bed infections (onychomycosis)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**subcutaneous**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "includes sporothrix schenckii from **rose thorn** prick",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**deep**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "orthopaedic manifestation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "tenosynovial",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "septic arthritis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "osteomyelitis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "organisms include",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "endemic",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "coccidiomycosis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "histoplasmosis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "blastomycosis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "opportunistic include",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "candidiasis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "mucormycosis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "cryptococcocis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "aspergillosis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "requires surgical debridement",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Onychomycosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "defined as fungal infection in vicinity of nail bed (cutaneous)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most common organisms are",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "trichophyton rubrum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "a destructive nail plate infection",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "candida",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "chronic infection of nail fold",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "topic antifungal treatment & **nail plate removal**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**first line of treatment**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "systemic griseofulvin or ketoconazole",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "recalcitrant cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Sporothrix schenckii",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Sporothrix schenckii a common **soil organism**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**a subcutaneous infection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "rose thorn in classic mechanism of subcutaneous transmission",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "will show **local ulceration (papule) at site of penetration**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6108/images/sporotrichosis_11739261504ead880bcf98d.jpg",
                      "caption": "Sporothrix schenckii"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "with time additional lesions form in region on lymphatic vessels",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6108/images/sporotrichosis_1_040319.jpg",
                      "caption": "Sporothrix schenckii"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may show proximal lymph node involvement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "S schenckii isolated at room temperature on **Sabouraud dextrose agar**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral itraconazole for 3 to 6 months",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "mainstay of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "has replaced potassium iodide due to side effects which included",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "thyroid dysfunction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "rash",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "GI symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Coccidiomycosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "found in southwest arid regions (e.g., new mexico)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often a **deep infection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "manifestations include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "subclinical pulmonary involvement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "orthopaedic manifestations",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "synovitis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "arthritis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "periarticular osteomyelitis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "amphotericin B & **surgical debridement**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Histoplasmosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**histoplasma capsulatum** infection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "found in Mississippi River Valleys and Ohio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually subclinical",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "often found incidentally on CXR",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may present with tenosynovial infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosed by skin testing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "amphotericin B & surgical debridement / tenosynovectomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "usually resolve spontaneously",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "may have serious infection in immunocompromised host",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
