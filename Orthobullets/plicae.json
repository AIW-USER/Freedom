{
  "title": "Plicae",
  "url": "https://www.orthobullets.com/knee-and-sports/3027/plicae",
  "subtitle": "Updated: Sep 8 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Plica syndrome is defined as a painful impairment of knee function resulting from the thickened and inflamed synovial folds (usually medial).",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with pain over the medial parapatellar region with possible palpation of a thickened cord.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is mainly nonoperative with NSAIDs and physical therapy to focus on hamstring strengthening. Arthroscopic plica excision is indicated in refractory cases that fail nonoperative treatment.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "50% present with history of blunt trauma to the anterior knee",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**Plica**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "are embryologic remnant synovial folds. Most common plicae are",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3027/images/plica.jpg",
                      "caption": "Shows knee plica"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**ligamentum mucosum**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "most common plica",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "located in the intercondylar notch",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**suprapatellar plica**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "located in the suprapatellar space, extending from the medial wall of the knee toward the lateral wall",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**medial plica**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "extends from the infrapatellar fat pad to the medial wall of the knee",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "most commonly irritated from the abrading the medial femoral condyle",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "snapping sensations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "buckling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "knee pain on sitting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain with repetitive activity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tenderness in the medial parapatellar region",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "painful, palpable medial parapatellar cord",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can be rolled and popped beneath the examiners finger",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provacative test",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "hold the knee in full extension while examiner tries to flex against the patient’s resistance.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the examiner again pushes the patella medially while palpating its medial border.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "pain produced with or without a click is considered a positive test.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can detect plica but has low sensitivity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activity restriction, NSAIDS, and physical therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most cases can be treated nonoperatively",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "physical therapy",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "moist heat applications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "hamstring stretching",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "resistive strengthening exercises are avoided in early rehabilitation phases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthroscopic resection of lesion",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "only utilized in rare cases of plica band syndrome not responding to nonoperative treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
