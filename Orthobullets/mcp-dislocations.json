                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "complex dislocation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**joint space widening** may indicate interposition of volar plate",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6115/images/ap_moved.jpg",
                          "caption": "AP"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "entrapment of sesamoid in MCP joint is diagnostic of complex dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
