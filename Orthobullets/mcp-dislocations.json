{
  "title": "MCP Dislocations",
  "url": "https://www.orthobullets.com/hand/6115/mcp-dislocations",
  "subtitle": "Updated: Sep 8 2024",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MCP Dislocations are a dislocation of the metacarpophalangeal joint, usually dorsal, caused by a fall and hyperextension of the MCP joint.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made clinically and is confirmed by orthogonal radiographs.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is closed reduction unless soft tissue interposition blocks reduction, in which case open reduction is indicated.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "< 1 per 100,000 annually",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**dorsal dislocations** are most common",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**index finger** is most commonly involved",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "thumb is second most common digit involved",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually a fall on outstretched hand leading to **hyperextension of MCP joint**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "leads to avulsion of the volar plate from metacarpal neck",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**metacarpal and phalanx fractures**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "fractures of the base of proximal phalanx or metacarpal head",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "seen in up to 50%",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MCP Joint Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a condyloid joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "proximal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "contains **shallow and concave surface**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "congruent with metacarpal head",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "metacarpal head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "is cam shaped",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "sesamoids",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "embedded in the volar plate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "attached to flexor pollicis brevis and abductor pollicis brevis in thumb",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MCP Joint Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**proper collateral ligaments**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "are the primary stabilizer of the MCP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "originate from the dorsal aspect of metacarpal head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "insert on the volar aspect of base of proximal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "are tight in flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**accessory collateral ligaments**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "originate volar to the proper collateral ligaments",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "insert on the volar plate",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "are tight in extension",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**volar plate**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "stabilizes the volar aspect of MCP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "comprised of thick fibrocartilaginous portion distally and loose membranous portion proximally",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "allows for hyperextension of MCP joint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "forms volar recess proximally",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "allows for flexion of proximal phalanx",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**dorsal capsule**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a weak stabilizer of the dorsal aspect of MCP joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "thin and loose in structure",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**sagittal bands**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "supports the extrinsic tendons",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "originates from the extensor hood",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "attaches volarly with transverse metacarpal ligament",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Anatomic classification of MCP dislocation**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Volar",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Results from hyperextension or hyperflexion injury",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
