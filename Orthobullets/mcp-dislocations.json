                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed Reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "dorsal dislocation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "reduction technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "apply direct pressure over dorsal aspect of proximal phalanx with the wrist in flexion to take tension off the intrinsic and extrinsic flexors",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "avoid longitudinal traction during closed reduction as it may pull volar plate into joint and convert to irreducible",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "immobilization",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "early ROM and dorsal blocking splint following successful reduction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "volar dislocation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "reduction technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "apply direct pressure over volar aspect of proximal phalanx with MCP in flexion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "immobilization",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "immobilize in 30° of flexion for 2 weeks, then active ROM in dorsal blocking splint",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
