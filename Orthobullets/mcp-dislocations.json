                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6115/images/4f28344a-21a9-4891-b132-45734ebd7b1b_volar_dislocation..jpg",
                          "caption": "Volar dislocation"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Dorsal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Most common**Results from hyperextension injury",
                      "table": null,
                      "images": [],
                      "importance": "-1",
