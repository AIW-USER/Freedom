{
  "title": "SI Joint Infection - Pediatric",
  "url": "https://www.orthobullets.com/pediatrics/4033/si-joint-infection--pediatric",
  "subtitle": "Updated: Jun 13 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "SI Joint Infections are rare infections in the pediatric population most commonly associated with progressive low back and buttock pain.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is generally made with MRI studies.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is nonoperative with antibiotics targeted towards the specific organism in the majority of cases. Surgical debridement is indicated in the presence of abscess or lack of response to antibiotics.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare and only accounts for 1-2% of cases of septic arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in children over the age of 10 than adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors in adults",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intravenous drug abuse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "immune suppression",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pregnancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "infective endocarditis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sepsis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "TB",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "microbiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**staphylococcus aureus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "is the causative organism in most of these infections",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**mycobacterium tuberculosis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "skeletal tuberculosis accounts for 3–5 % of all tuberculosis, of which approximately 10 % occurs at the SIJ",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Salmonella**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "seen in the setting of Sickle Cell Disease",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "progressive **low back and buttock pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**unable to bear weight** on affected side secondary to pain",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**fever**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain worsened by**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**compression of the iliac wings**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "palpation of the right sacroiliac (SI) joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "normal hip range of motion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Faber test**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "positive flexion, abduction and external rotation (FABER) test of the hip joint that dramatically aggravates the pain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indication",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "painful SI joints",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral pelvis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "optional views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inlet/outlet views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "joint destruction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "partial or complete fusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "periarticular osteopenia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "widening and cavitation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "is the most sensitive diagnostic study for SIJ infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "findings in the acute phase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "intra-articular fluid or gas",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "subchondral bone marrow edema",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "articular and periarticular post-gadolinium enhancement and soft tissue edema",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings in chronic phase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "periarticular bone marrow reconversion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "replacement of articular cartilage by pannus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bone erosion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "subchondral sclerosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "joint space widening or narrowing and ankylosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more **sensitive than CT scan**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "elevated WBC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "elevated ESR (>50)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "elevated CRP (>70)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Blood cultures",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be positive and should be obtained prior to starting antibiotics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "antibiotics targeted towards the specific organism",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "target staph aureus in children if no organism is identified from blood cultures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical debridement only - rarely needed in children",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute cases with abscess present",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "failed antibiotic treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "the presence of sequestered bone",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "debridement and SI joint arthrodesis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4033/images/si_1.jpg",
                  "caption": "MRI of SI joint infection"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "chronic cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "sequestered bone with joint narrowing/destruction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "recurrent infection",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "longer operative times",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "more complications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
