                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4070/images/clsf.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4070/images/complete%20pic%20.jpg",
                          "caption": "AP image of the foot showing a completely ossified accessory navicular."
                        }
                      ],
                      "importance": "-1",
