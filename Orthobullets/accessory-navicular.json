                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**asymptomatic**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**majority of patients are asymptomatic**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**medial arch pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "often worse with overuse",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "due to repeated microfracture at the synchondrosis or from inflammation of the posterior tibialis tendon insertion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may have swelling in region",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**medial foot tenderness**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "firm and tender at the medial and plantar aspect of the navicular bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, lateral, external obliques",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4070/images/33A_moved.JPG",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4070/images/33B_moved.JPG",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "best seen with an **external oblique view**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4070/images/obl.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "will see bony enlargement or accessory bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evaluation for other pathology",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4070/images/mrinavi.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activity restriction, shoe modification, and non-narcotic analgesics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first-line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "the use of arch supports or pads over the bony prominence may be helpful",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "a UCBL orthosis may invert the heel during walking and decrease symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "orthotics must offload pressure from the accessory navicular or they will exacerbate symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most children and adolescents who have a symptomatic accessory tarsal navicular bone become asymptomatic when they reach skeletal maturity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "short period of cast immobilization",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "pain is refractory to activity modification and shoe modifications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "excision of accessory navicular",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "recalcitrant cases that have failed extended nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Excision of accessory navicular**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "medial approach to the foot",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "an incision is made from distal third of talus to medial cuneiform",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "identify the posterior tibialis and then reflect the tendon (either plantar or dorsal)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "resection technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "the synchondrosis between the accessory navicular and native navicular can typically be identified easily",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "resect the accessory navicular (a 1/4\" curved osteotome may facilitate the resection) through the synchondrosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "trim down the body of the navicular (typically with osteotomes and rongeurs) to remove any medial prominence",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "resection is typically in line with medial border of the medial cuneiform",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "do NOT advance the posterior tibial tendon. The advancement does not enhance the result and increases downtime and morbidity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "flatfoot deformity correction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "this is **not** performed concomitantly with the procedure **unless** the flatfoot is the primary pathology",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Persistent medial prominence and pain**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "the most common complication is persistent medial prominence and pain when the body of the navicular is not trimmed sufficiently",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
