{
  "title": "Occipitocervical Instability",
  "url": "https://www.orthobullets.com/spine/2014/occipitocervical-instability",
  "subtitle": "Updated: Apr 28 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Occipitocervical instability can be traumatic or acquired through a degenerative process such as rheumatoid arthritis or Down syndrome",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is usually confirmed with a combination of CT scan, MRI, and lateral flexion-extension radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Traumatic instability is treated with occipitocervical fusion. Acquired instability is treated with observation or occipitocervical fusion depending on the presence of neurologic deficits",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**traumatic occipitocervical instability**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "~15-30% of cervical spine injuries occur at the occipitocervical junction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "prevalence",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "identified in 19% of **fatal** cervical injuries",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**acquired occipitocervical instability**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "most frequently seen in the Down syndrome population",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "usually asymptomatic and identified in screening for surgery or special Olympic participation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Terminology",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "also called",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "atlanto-occipital dissociation (AOD)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "occipitocervical dislocation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "traumatic",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "mechanism of injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "high-energy trauma",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**translation or distraction injuries** that destabilize the occipitocervical junction",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "head most often displaces anteriorly",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "acquired",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "due to bony dysplasia or ligament/soft-tissue laxity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**atlantoaxial instability**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "also seen in Down syndrome patients",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**neurologic deficits**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**vertebral or carotid artery injuries**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**Down syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "morphology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occipital condyles are paired prominences of the occipital bone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "oval or bean shaped structures forming lateral aspects of the **foramen magnum**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "joint articulations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "intrinsic relationship between occiput, atlas, and axis to form the **occipitoatlantoaxial complex or CCJ**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "6 main synovial articulations",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "anterior and posterior median **atlanto-odontoid joints**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "paired atlanto-occipital joints",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "paired atlantoaxial joints",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intrinsic ligaments are located within the spinal canal and provide most of the ligamentous stability. They include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**transverse ligament**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2014/images/cd3d3632-b2d9-4b34-a33e-9bb3bfd1bde6_combined..jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "primary stabilizer of atlantoaxial junction",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "connects the posterior odontoid to the anterior atlas arch, inserting laterally on bony tubercles",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**paired alar ligaments**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2014/images/7afed22a-8125-46ff-95e6-ddb5df0fb7ae_posterior..jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "connect the odontoid to the occipital condyles",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "relatively strong and contribute to occipitocervical stability",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**apical ligament**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2014/images/2db2fe35-20f2-4d96-9330-3c691dd44f14_ligaments..jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "relatively weak midline structure",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "runs vertically between the odontoid and foramen magnum",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**tectorial membrane**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2014/images/aa104753-0675-47ca-8008-50ba011cfac7_all..jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "connects the posterior body of the axis to the anterior foramen magnum and is the cephalad continuation of the PLL",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Vascular system",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occipital condyles in proximity to vertebral arteries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Nervous system",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occipital condyles are in close proximity to:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medulla oblongata",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "spinal cord",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**lower cranial nerves (CN IX-XII)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 2,
                  "bullets": [
                    {
                      "text": "**Traynelis Classification (direction of displacement)**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Anterior occiput dislocation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Longitudinal dislocation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Posterior occiput dislocation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Harborview Classification (degree of instability)**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Minimal or nondisplaced, unilateral injury to craniocervical ligaments",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stable",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Minimally displaced, but MRI demonstrates significant soft-tissue injuries",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Stability may be based on traction test",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stable or unstable",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Gross craniocervical malalignment (BAI or BDI >2 mm beyond normal limits)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Unstable",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, lateral, and odontoid views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**low sensitivity** in detecting injury (57%)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "measurements",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Powers ratio = C-D/A-B**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2014/images/powers_ratio_ct_scan.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "used to diagnose occipitocervical dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "C-D: distance from basion to posterior arch",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "A-B: distance from anterior arch to opisthion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "significance",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "ratio ~1 is normal",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": ">1.0 raises concern for **anterior dislocation**",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "<1.0 raises concern for",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": [
                                {
                                  "text": "posterior atlanto-occipital dislocation",
                                  "table": null,
                                  "images": [],
                                  "importance": "3",
                                  "children": []
                                },
                                {
                                  "text": "odontoid fractures",
                                  "table": null,
                                  "images": [],
                                  "importance": "3",
                                  "children": []
                                },
                                {
                                  "text": "ring of atlas fractures",
                                  "table": null,
                                  "images": [],
                                  "importance": "3",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**Harris rule of 12**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2014/images/4759531_orig.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "basion-dens interval or basion-posterior axial interval",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": ">12 mm suggests occipitocervical dissociation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "Condyle-C1 interval (CCI)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "distance between the occipital condyles and the superior articular surfaces of the atlas (C1)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "most sensitive and specific test to diagnose occipitocervical dislocation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "<2.5 mm is normal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "considered **gold standard** for osseous injuries of the spine",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "midsagittal CT reconstruction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT angiogram",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evaluate for injury to vertebral artery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "identify anatomy of vertebral artery prior to occipitocervical fusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "suspected ligamentous injury with preserved alignment or occult injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "neurologic deficits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "provisional stabilization while avoiding traction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "traumatic instability with distraction of the atlanto-occipital joint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "halo vest",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "tongs",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**prolonged cervical orthosis is not recommended due to poor stabilization of the atlanto-occipital joint**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "use of traction **should be avoided in most cases**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "traction may be considered in **stage 2 injuries** when MRI demonstrates soft-tissue injury with preserved alignment",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occipitocervical fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most traumatic cases require stabilization",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "acquired cases when evidence of myelopathy or significant symptomatic neck pain",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "invagination and atlantoaxial impaction secondary to inflammatory arthropathy (e.g. rheumatoid arthritis)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "tumor",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Occipitocervical fusion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "posterior midline incision with patient in prone position",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Mayfield retractor used to obtain proper craniocervical alignment",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "establish preoperative O-C2 angle with lateral fluoroscopy prior to draping",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "deep dissection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "if performing C1 lateral mass screw fixation, work within safe zone and do not dissect more than 1 cm lateral to midline above the posterior arch of C1 to avoid injury to vertebral artery",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "length",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "posterior segmental instrumented fusion is usually performed from the occiput to C3",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "occiput",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "occipital plates usually allow for 3 or 4 total screws with adjustable rod holders",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "occipital screws",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "usually unicortical to avoid injury to venous sinus",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "major dural venous sinuses are located just below the external occipital protuberance and are at risk of penetrative injury",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "some institutions prefer bicortical screws but they come at an increased risk",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "occipital screw safe zone",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "the safe zone for occipital screws is located within an area measuring 2 cm lateral and 1 cm inferior to the **external occipital protuberance** along the superior nuchal line",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/2014/images/heyworth_modified.jpg",
                                  "caption": ""
                                }
                              ],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "C1 lateral mass screws",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "often skipped due to angle at base of skull making it more difficult to place a rod",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "may choose a unilateral screw to provide some rotational stability for C1 ring",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "C2 fixation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "pars, pedicle, transarticular, or translaminar screws",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "C3 fixation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "standard lateral mass screws aimed cephalad and lateral to avoid vertebral artery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "arthrodesis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "may require bone grafting or removal of bony fragments compressing neurovascular structures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nonunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Bleeding**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "Internal carotid artery",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "Vertebral artery",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
