{
  "title": "Epidermal Inclusion Cyst",
  "url": "https://www.orthobullets.com/hand/6087/epidermal-inclusion-cyst",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A painless, **benign, slow-growing soft tissue tumor** that often occurs in the hand",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "occurs months to years after a traumatic event",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "third most common hand tumor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in **men** than women",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "occurs in the **third to fourth decade**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the **distal phalanx** is commonly involved",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "results from a **penetrating injury** that drives **keratinizing epithelium** into subcutaneous tissues or bone",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "cells grow slowly to produce an **epithelial cell-lined cyst filled with keratin**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**painless mass, most commonly occurring in the fingertip**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**although less common, erythematous, painful lesions have been reported**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection & palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "flesh-colored, yellow, or white in appearance",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6087/images/epidermal%20inclusion%20cyst%20clinical%20photograph.jpg",
                      "caption": "Shows an epidermal inclusion cyst."
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**well-circumscribed, firm, slightly mobile** lesions",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6087/images/epidermal%20inclusion%20cyst%20clinical%20image.jpg",
                      "caption": "Shows an epidermal inclusion cyst."
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "lesions are firmer than ganglion cysts and do not transilluminate",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "often superficial and tethered to overlying skin",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6087/images/epidermal%20inclusion%20cyst%20clinical%20photo.jpg",
                      "caption": "Shows an epidermal inclusion cyst."
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "there may be **loss of ROM** when lesions are large and occur near IP joints",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**sensory deficits** may be evident with 2-point discrimination testing secondary to digital nerve compression",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, lateral, and oblique views of the involved digit or hand",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**soft tissue mass** may be evident",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "a **lytic lesion** of the distal phalanx may be present if the cyst erodes into bone",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6087/images/interosseous%20epidermal%20inclusion%20cyst.jpg",
                      "caption": "Shows an interosseous epidermal inclusion cyst."
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may mimic a malignant or infectious process",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Biopsy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "should be considered before surgical excision to rule out neoplasm or infection if a lytic bony lesion is present in the distal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "gross appearance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cysts contain a thick, white keratinous material",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "characteristic findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**cysts filled with keratin** and lined with **epithelial cells**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6087/images/epidermal%20inclusion%20cyst.jpg",
                      "caption": "Shows an epidermal inclusion cyst."
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/6087/images/epidermal%20inclusion%20cyst%20microscopy.jpg",
                      "caption": "Shows an epidermal inclusion cyst."
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Tophaceous gout",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Foreign body granuloma",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Sebaceous cyst",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Pyogenic granuloma",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Giant cell tumor",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Ganglion cyst",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Enchondroma",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "Glomus tumor",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "not recommended",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "marginal excision",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "diagnosis of epidermal inclusion cyst",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "painful lesions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "loss of function",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "cosmetic concerns",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "careful dissection to **remove the entire capsule**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "local curettage and bone graft may be required for lesions eroding bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "amputation is an alternative with advanced bony destruction in rare circumstances",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**marginal excision is curative**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "low recurrence rate",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Wound complications**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Infection**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Digital neurapraxia**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Recurrence**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "recurrence rate is low even with bony involvement",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Excision is curative",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Malignant transformation has not been reported",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
