  "subtitle": "Updated: Jul 8 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Solventum™ Prevena™ Therapy is a closed-incision negative pressure wound therapy (ciNPT) system designed to help protect surgical incisions, optimize the healing environment, and reduce the risk of certain postoperative complications in appropriate patients.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "It delivers continuous negative pressure over a closed incision to help hold incision edges together, remove fluid, reduce swelling, and create a barrier against external contamination.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Prevena Therapy is commonly used for patients at higher risk of surgical site complications following procedures such as orthopedic, cardiovascular, general, plastic, and vascular surgeries.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
