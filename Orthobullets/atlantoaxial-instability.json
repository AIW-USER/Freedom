{
  "title": "Atlantoaxial Instability",
  "url": "https://www.orthobullets.com/spine/2049/atlantoaxial-instability",
  "subtitle": "Updated: Jan 30 2026",
  "sections": [
    {
      "text": "etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "The atlantoaxial joint is an important \"transitional zone\" in the cervical spine",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prone to instability by both degenerative and traumatic processes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**adult causes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "degenerative",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "Down syndrome",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "rheumatoid arthritis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "os odontoideum",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "traumatic",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "type I odontoid fracture (very rare)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "atlas fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "transverse ligament injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**pediatric causes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "degenerative",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "JRA",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Morquio syndrome",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "lysosomal storage disorder",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "trauma/infection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "rotatory atlantoaxial subluxation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bony articulations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "C1-2 facet joints",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "transverse apical alar ligament complex",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2049/images/combined_4.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2049/images/transvers_correct.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**transverse ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most important stabilizer",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**apical ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "single midline structure",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**alar ligaments**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "paired parasagittal ligaments",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the atlantoaxial joint provides ~50% of rotation in the cervical spine",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2049/images/biomechanics.jpg",
                  "caption": "Shows rotation of cervical spine"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "this is enabled by the peg (C2) in ring (C1) anatomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Physical Exam",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neck pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neurologic symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neurologic deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often appear late in disease process due to capacious nature of spinal canal at the C1 level",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2049/images/superior%20view.jpg",
                      "caption": "Shows capacious canal"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "myelopathic symptoms",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "hyperreflexia (patellar tendon reflex)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "muscle weakness",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "broad based gait",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "decreased hand dexterity",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "loss of motor milestones",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "bladder problems",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flexion-extension views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**atlantodens interval (ADI)**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2049/images/adi%20labels.jpg",
                      "caption": "ADI and SAC"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/2049/images/ra%20dynamic.jpg",
                      "caption": "Shows ADI increase"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "measurement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "distance between odontoid process and the posterior border of the anterior arch of the atlas",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "adult parameters",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": ">3.5 mm considered unstable",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": ">10 mm indicates surgery in RA",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "other",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "must get preoperative flexion-extension views to clear all high-risk patients for any type of surgery",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**space available for the cord (SAC) = posterior atlantodens interval** (PADI)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2049/images/adi%20labels.jpg",
                      "caption": "ADI and SAC"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "measurement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "distance from posterior surface of dens to anterior surface of posterior arch of atlas",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "adult parameters",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "in adults with RA, **<14 mm** is associated with increased risk of neurologic injury and is an indication for surgery",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "open mouth odontoid",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2049/images/sum%20of%20lateral%20mass%20displacement.jpg",
                  "caption": "Shows sum of lateral mass displacement"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**sum of lateral mass displacement**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "measurement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "lateral masses are connect by the ring of C1 and can only be displaced relative to each other if:",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/2049/images/ring%20structure.jpg",
                              "caption": "Shows ring structure"
                            }
                          ],
                          "importance": "4",
                          "children": [
                            {
                              "text": "bony fracture (disruption of the ring)",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "the transverse ligament is ruptured",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/2049/images/sum%20of%20lateral%20mass%20displacement.jpg",
                                  "caption": "Shows sum of lateral mass displacement"
                                }
                              ],
                              "importance": "4",
                              "children": [
                                {
                                  "text": "transverse ligaments binds them together",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "adult parameters",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "if >8.1 mm, then a transverse ligament rupture is assumed and the injury pattern is considered unstable",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
