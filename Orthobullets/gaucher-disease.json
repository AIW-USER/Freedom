{
  "title": "Gaucher Disease",
  "url": "https://www.orthobullets.com/pediatrics/10132/gaucher-disease",
  "subtitle": "Updated: Jun 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gaucher Disease is a congenital lysosomal storage disorder caused by an autosomal recessive mutation in B-glucocerebrosidase. Patients present with hematological abnormalities, joint pain, osteonecrosis, and developmental delay.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made by elevated plasma levels of glucocerebrosides.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to address orthopedic manifestations, hematologic abnormalities, and neurological abnormalities.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common lysosomal storage disase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "incidence of ~1 in 40,000 people in general population",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in **Ashkenazi Jewish origin**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**deficiency in B-glucocerebrosidase**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cell biology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "enzyme deficency leads to disturbances in cell metabolism with **accumulation of sphingolipids in the**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "liver",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "spleen",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "bone marrow",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritance pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**autosomal recessive**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "classification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Type 1 (B-glucocerebrosidase deficency) is **most common**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "Type 2",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Type 3 (with CNS involvement)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
