                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Type*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Clinical Features*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Prognosis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Type 1**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(Adult Type)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Easy bruising",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Anemia, fractures",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Treatable with enzyme replacement therapy (fatal if enzyme substitute is not given)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Type 2**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(InfantileType)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Lethal by age 3",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Brain and organ involvement",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Untreatable and lethal during infancy",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Type 3**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(JuvenileType)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Onset in teen years",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Thrombocytopenia, anemia, enlarged liver",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Fractures",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Gradual brain involvement",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type 3 is clinically diverse.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "The non-CNS effects respond well to enzyme replacement therapy",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms (will depend on the type of Gaucher's disease)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Systemic Manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fatigue (anemia)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "prolonged bleeding (thrombocytopenia)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fever, chills, sweats (infection)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "seizure, developmental delay (CNS involvement)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Orthopaedic Manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bone pain (fracture, osteomyelitis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "joint pain or contracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**bone crisis (osteonecrosis)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "abnormal skin and bruising",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hepatosplenomegaly**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "auscultation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cardiac mumur",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "musculoskeletal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**bone deformities** (80% of patients with Gaucher will develop deformities of the distal femur or proximal tibia)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "joint contractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pathologic fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Full blood count",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anemia and thrombocytopenia are common",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "diagnosis confirmed by **elevated plasma levels of glucocerebrosides**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bone marrow aspirate shows a **giant binucleate storage cell filled with glucocerebrosides**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "which accumulate because of an hereditary deficiency of Beta-glucocerebrosidase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "chest",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may reveal cardiac involvement (e.g. cardiac enlargement, etc)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "skeletal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may reveal pathologic fractures, osteonecrosis, abnormal bone remodeling or joint deformity",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "\"erlenmeyer flask\" appearance of distal femur and proximal tibia",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/10132/images/46f20e64-370d-4d71-9e6f-cc41fdd53c6e_erlynmeyer_flas..jpg",
                              "caption": "Erlenmeyer flask appearance of distal femur and proximal tibia"
                            }
                          ],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "almost all patients have **diffuse osteopenia**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "CT/MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "visceral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "abdomen may reveal organomegaly",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "skeletal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "increased prevalence of osteomyelitis in patients with Gaucher's disease",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**chronic vascular insults may lead to osteonecrosis** in the proximal and distal femur, proximal tibia and proximal humerus most commonly",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation and supportive therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "unaffected patients (e.g., no blood result irregularities, minimal organ enlargement, no bony lesions on MRI)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "extended multidisciplinary approach is essential",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "enzyme replacement therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "all children and symptomatic patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**not effective in Type 2 Gaucher's disease**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "imiglucerase",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "velaglucerase alfa",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "taliglucerase alfa",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "substrate reduction therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "less severely affected patients that cannot tolerate IV replacement therapy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "miglustat",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bone marrow transplant",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "if performed early may be curative",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Fracture management**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "preoperative optimization with enzyme therapy is critical",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "availability of additional blood, clotting factors and platelets due to increased bleeding risk",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "anesthisologist to maintain oxygenation to avoid precipitating bone crisis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "increased risk of infection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
