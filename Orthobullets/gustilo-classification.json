                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**1st generation cephalosporin** (e.g. cefazolin)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**1st generation cephalosporin** for gram positive coverage",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Aminoglycoside** (such as gentamicin) for gram negative coverage",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Penicillin** should be added if concern for anaerobic organism (farm injury) **Flouroquinolones** (e.g. ciprofloxacin) should be used for fresh water wounds or salt water wounds (can be used if allergic to cephalosporins or clindamycin **Doxycycline and 3rd or 4th-generation cephalosporin** (e.g. ceftazidime) can be used for salt water wounds",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
