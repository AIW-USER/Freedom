{
  "title": "Gustilo Classification",
  "url": "https://www.orthobullets.com/trauma/1003/gustilo-classification",
  "subtitle": "Updated: Jan 11 2026",
  "sections": [
    {
      "text": "Abridged version",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Type I**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "wound ≤1 cm, minimal contamination or muscle damage",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Type II**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "wound 1-10 cm, moderate soft tissue injury",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Type IIIA**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "wound usually >10 cm, high energy, extensive soft-tissue damage, contaminated",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "adequate tissue for flap **coverage**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "farm injuries are automatically at least Gustillo IIIA",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Type IIIB**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "extensive periosteal stripping, wound **requires soft tissue coverage (rotational or free flap)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Type IIIC**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "vascular injury requiring **vascular repair, regardless of degree of soft tissue injury**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Most accurate way to grade open fratures is by **intra-operative examination**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
