    {
      "text": "Antibiotic Indications for Open Fractures",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Gustillo type I and II",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1st generation cephalosporin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Gustillo type III",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1st generation **cephalosporin + aminoglycoside**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "traditionally recommended, **but there is controversy about this regimen**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "With farm injury / bowel contamination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1st generation **cephalosporin + aminoglycoside + PCN**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "add PCN for clostridia",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Duration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "initiate as soon as possible",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increased infection rate when antibiotics are delayed > 3 hours from time of injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
