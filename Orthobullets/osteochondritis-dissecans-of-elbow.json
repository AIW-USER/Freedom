                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Bony stability may or may not be present",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
