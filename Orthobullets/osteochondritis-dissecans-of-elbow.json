                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Loose bodies present in joint",
                      "table": null,
                      "images": [],
