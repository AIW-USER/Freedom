          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prognosis based on physeal status",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Most heal between 6 to 18 months of nonoperative treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Wide range of potential disability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inability to participate in sports at same level",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "up to 50% develop arthritic changes long term",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
