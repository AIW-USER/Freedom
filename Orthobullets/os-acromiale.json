{
  "title": "Os Acromiale",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3036/os-acromiale",
  "subtitle": "Updated: Nov 10 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "An Os Acromiale is an unfused secondary ossification center of the acromion that can be associated with shoulder impingement and rotator cuff tendonitis.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with axillary lateral radiographs of the shoulder.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Treatment is observation in the majority of cases with operative management reserved for patients who have persistent shoulder impingement or rotator cuff disease that have failed nonoperative management.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "8%",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "bilateral in 60%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "more common in males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "more common in African American",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3036/images/os%20acromiale%20drawing..jpg",
              "caption": "Shows os acromiale"
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "most common location is the **junction of meso- and meta-acromion**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shoulder impingement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rotator cuff disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "meso-acromion is associated with rotator cuff tendonitis and full thickness tears (in 50%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "3 ossification centers",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3036/images/os%20acromiale%20drawing..jpg",
              "caption": "Shows os acromiale"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "**meta-acromion** (base)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "origin of posterior portion of deltoid",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**meso-acromion** (mid)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "origin of middle deltoid",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**pre-acromion** (tip)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "origin of anterior deltoid fibers and coracoacromial ligament",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Results from **failure of fusion between ossification centers**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acromiale branch of thoracoacromial artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "from impingement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "reduction in subacromial space from flexion of the anteiror fragment with deltoid contraction and arm elevation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "from motion at the nonunion site (painful synchondrosis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "incidental finding on radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "trauma can trigger onset of symptoms from previously asymptomatic os acromiale",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "best seen on an **axillary lateral** of the shoulder",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3036/images/os%20acromiale%20xray%20axillary.jpg",
                      "caption": "Shows os acromiale"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3036/images/shoulder_ax.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "to better visualize the nonunion site",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "to detect degenerative changes (cysts, sclerosis, hypertrophy)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3036/images/ct.jpg",
                      "caption": "CT axial cuts showing cysts, sclerosis"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation, NSAIDS, therapy, subacromial corticosteroid injections",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "mild symptoms",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "two-stage fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "symptomatic os acromiale with impingement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "direct excision can lead to **deltoid dysfunction**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "a two-stage procedure may be required",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "first stage - **fuse the os acromiale ± bone graft**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "second stage - perform **acromioplasty**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "preserve blood supply (acromiale branch of thoracoacromial artery)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "tension band wires, sutures, cannulated screws",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "arthroscopic subacromial decompression and acromioplasty",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**impingement with/without rotator cuff tear (where the os acromiale is only incidental and nontender)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "open or arthroscopic fragment excision",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "symptomatic pre-acromion with small fragment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "salvage after failed ORIF",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "results",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "arthroscopic has less periosteal and deltoid detachment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "better excision results with pre-acromion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Deltoid weakness",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "from fragment excision",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Persistent pain/weakness",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Poorer outcomes after rotator cuff repairs in patients with meso-os acromiale",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
