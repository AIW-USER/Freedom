{
  "title": "Carpal Instability Nondissociative (CIND)",
  "url": "https://www.orthobullets.com/hand/6044/carpal-instability-nondissociative-cind",
  "subtitle": "Updated: Feb 10 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Carpal instability nondissociative (CIND) is defined as instability between carpal rows (either radiocarpal or midcarpal)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**radiocarpal instability (**between radius and proximal row)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**midcarpal instability** (between proximal and distal row)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "< 1 per 100,000 annually",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radiocarpal instability (\"inferior arc injury\")",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "high-energy injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ulnar translation signifies global rupture of extrinsic ligaments",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "distal radius malunion is the most common cause",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may be purely ligamentous or have associated ulnar and radial styloid fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intracarpal injury (scapholunate or lunotriquetral ligament)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "acute carpal tunnel syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "compartment syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Volar extrinsic ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radioscaphocapitate (RSC)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "long radiolunate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "short radiolunate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "radioscapholunate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview table of wrist instability",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually no history of trauma (midcarpal)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "high energy trauma (radiocarpal)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "subluxation that may or may not be painful",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "complain of wrist giving way",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "irritating clunking sign",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "\"clunk\" when wrist is moved ulnarly from flexion to extension with an axial load",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "generalized ligamentous laxity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "required",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "AP and lateral of the wrist",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "optional",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "cineradiographs",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sudden **subluxation of proximal carpal row** with active radial or ulnar deviation on cineradiograph",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6044/images/Cineradiography%20of%20midcarpal%20instability_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "ulnar translation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "diagnosis made when **>50% of lunate width is ulnarly translated** off the lunate fossa of the radius",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6044/images/Ulnar%20translation%20with%20text_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization +/- splinting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "midcarpal instability is most amenable to splinting",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immediate open repair, reduction, and pinning",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**ulnar translation associated with styloid fractures**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**poor results with late repair**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**ligament reconstruction has poor long term results**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "midcarpal joint fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**midcarpal instability (preferred over ligamentous reconstruction)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**late diagnosis that failed nonoperative management**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "will lead to 20-35% loss of motion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "osteotomy with malunion correction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**distal radius malunion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "wrist arthrodesis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "failure of above treatments",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fusion of radiocarpal joint leads to a 55-60% loss of motion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "distal pole of the scaphoid excision can improve postoperative range of motion with radioscapholunate fusion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "volar dislocation is more severe than dorsal",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
