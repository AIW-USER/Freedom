{
  "title": "Congenital Dislocation of Patella",
  "url": "https://www.orthobullets.com/pediatrics/4047/congenital-dislocation-of-patella",
  "subtitle": "Updated: Jun 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Dislocation of Patella is a rare congenital knee condition that presents with an irreducible, lateral dislocation of the patella.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is confirmed clinically with genu valgum, knee contractures and presence of a patella that is dislocated posterolaterally.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is surgical reduction and stabilization in majority of cases.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually dislocated at birth",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often missed or misdiagnosed",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "can be reduced at birth with subluxation and later fixed dislocation in childhood",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "osseous abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**small or absent patella**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**hypoplastic trochlea**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**external tibial torsion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "soft tissues abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**thickened, tight lateral structures** including",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "iliotibial band",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "retinaculum",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**tight quadriceps**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "causing superiorly subluxed patella",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Larson syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "arthrogryposis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "diastrophic dysplasia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nail-patella syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Down syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Ellis-van Creveld syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the patella is the **largest sesamoid bone**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "males at 4-5 yrs. old",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "females at 3 yrs. old",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "accessory ossification center appears between 8-12 years",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "separate fragment attached to patella by fibrocartilaginous tissue",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fulcrum for the quadriceps",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "protects the knee joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "articular cartilage of patella is thickest in body (up to 1cm)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "enhances lubrication of the knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "see complete knee biomechanics",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "blood supply to patella is predominantly from **distal to proximal**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "6 arteries contribute",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4047/images/blood%20supply_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**from popliteal artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**superior lateral geniculate artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**superior medial geniculate artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**inferior lateral geniculate artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**inferior medial geniculate artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**from superficial femoral artery**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**supreme geniculate artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**from anterior tibial artery**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**recurrent anterior tibial artery**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated syndromes present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**delayed walking**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "can mimic cerebral palsy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**genu valgum**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**knee flexion contractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "\"smiley face\" appearance of knee caps",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4047/images/clinical_photo_(miller_colorado).jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "femoral condyles abnormally prominent",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "small patella which is difficult to palpate laterally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "limited active flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "as genu valgum worsens, **patella subluxes posterolaterally causing quadriceps to act as knee flexor**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not helpful in children younger than 3 years old because patella is not ossified",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "in children > 3 years of age",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "AP lateral and sunrise",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4047/images/cdp_ap_.jpg",
                          "caption": "Congenitally dislocated patella"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4047/images/cdp_lateral.jpg",
                          "caption": "Congenitally dislocated patella"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4047/images/cdp_sunrise.jpg",
                          "caption": "Congenitally dislocated patella"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dislocated patella",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hypoplastic trochlea",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound or MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "children <3 years of age",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "can help diagnose non-ossified, dislocated patella",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**for most part not recommended as the condition impairs long term function if left untreated**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical reduction (Andrish technique)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "perform early to allow for trochlear intervention",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique (below)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Surgical reduction (**Andrish** technique)**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "soft tissue reduction steps",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "divide and lengthen lateral retinaculum between oblique and transverse layers",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dissect vastus lateralis from intermuscular septum and advance proximally on quadriceps tendon",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "release distal patellomeniscal ligaments",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lengthen quadriceps tendon, shorten patellar tendon to correct patellar alta",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tighten medial structures via medial patellofemoral reconstruction",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "reroute semitendinosus through medial collateral ligament and attach to patella",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "osseous realignment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "distal realignment usually not needed with adequate release",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "if needed, realignment limited due to tibial tubercle apophysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**Roux-Goldthwait** is preferred",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Recurrence**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
