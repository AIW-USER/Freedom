{
  "title": "Pelvis Anatomy",
  "url": "https://www.orthobullets.com/recon/12768/pelvis-anatomy",
  "subtitle": "Updated: Jun 11 2022",
  "sections": [
    {
      "text": "Osteology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "The pelvic ring formed from 2 innominate bones",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "articulate posteriorly with the sacrum and anteriorly through pubis symphysis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Each innominate bone is composed of three fused bones: ilium, ischium, and pubis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ilium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Anterior superior iliac spine (ASIS)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Aneterior inferior iliac spine (AIIS)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Posterior superior iliac spine (PSIS)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "iliopectineal eminence - region union between ilium and pubis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "gluteal pillar",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12768/images/e3cf0b6a-da46-4f2e-9003-62621ff36706_screenshot_2022-06-11_8.21.00_am.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "the anterior portion of the gluteus medius insertion and thickening of the iliac crest",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "important fixation pathway for fractures of the pelvis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "sciatic notch",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ischium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pubis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no inherent stability of articulations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stability comes from ligament complexes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Ligament complexes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**posterior complex**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12768/images/bony-pelvis-2.jpg",
                  "caption": "Posterior Ligaments"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "**sacroiliac ligaments**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "posterior stronger than anterior",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**iliolumbar ligaments**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "transverse process of L4/L5 to posterior ilium",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "anterior complex",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12768/images/bony-pelvis-top.jpg",
                  "caption": "Anterior ligaments"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**pubis symphysis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "a fibrocartilaginous disc between innominate bones",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pelvic floor complex",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**sacrospinous ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "transversely oriented",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "resists external rotation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**sacrotuberous ligaments**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "longitudinally oriented",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "resists vertical translation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Abdominal aorta",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/c3-ff211.png..jpg",
              "caption": "Arterial anatomy"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "bifurcates at L4 into common iliac system",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**external iliac artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "courses over the pelvic brim",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "continues as the common femoral artery (distal to the inguinal ligament)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**internal iliac artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "divides distal and posterior near the SI joint into",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "posterior division",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "leads to the iliolumbar artery, lateral sacral artery, and terminates as the superior gluteal artery",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "anterior division",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "leads to the obturator artery and inferior gluteal artery, terminating as the internal pudendal artery",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Corona mortis",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/f4-u1.0-b978-0-323-03329-9..50056-8..gr9.jpg",
              "caption": "Corona"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "vascular anastomosis that connects the external iliac artery (or inferior epigastric artery) and obturator artery",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "encountered during anterior approaches to pelvis (ilioinguinal and modified Stoppa)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "can result in brisk bleeding with rapid blood loss if not identified and ligated",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Posterior venous plexus",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "injury in pelvic fractures can account for majority of blood loss",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Neurologic",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lumbosacral plexus",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/lumbar_plexus.svg.jpg",
              "caption": "Lumbosacral plexus"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "L1-S4 nerve roots",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Lateral femoral cutanous nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "L2-L3 nerve roots",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "deep to inguinal ligament near ASIS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Obturator nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Femoral nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Sciatic nerve",
          "table": null,
          "images": [],
          "importance": "2",
          "children": []
        },
        {
          "text": "AP pelvis",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/nlpelvislines.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "standard radiograph for all trauma patients",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Inlet view",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/65feffe1-a9cf-46b3-8e2b-05481b26dc53_screenshot_2022-06-11_7.53.54_am.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/823d89dd-a247-45ad-8049-064661d73a53_screenshot_2022-06-11_8.07.32_am.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "cranial tilt (x-ray tube angle toward head and photons beamed in a caudal direction)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "beam perpendicular to the S1 end plate",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Outlet view",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12768/images/femoral_head_fracture_3.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "caudal tilt (x-ray tube angled toward feet and beamed in cranial direction)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "demonstrates cranial-caudal displacement of the pelvic ring and sacral morphology",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Judet radiographs",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "pseudo-lateral (oblique) views of the pelvis designed to evaluate the columns and walls of the acetabulum",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "the views are reciprocal, meaning a LEFT iliac-oblique is the same as a RIGHT obturator-oblique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "iliac-oblique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "assessment of the ilioischial line of the posterior column, the roof of the acetabulum, the anterior acetabular wall, and Iliac crest",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "obturator-oblique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "assessment of the iliopectineal line of the anterior column, the posterior acetabular wall, and the obturator foramen",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "provides excellent detail of bony anatomy and can confirm pelvic ring/acetabular fractures that are not always visible on plain radiographs.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
