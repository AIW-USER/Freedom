{
  "title": "Hip Anatomy",
  "url": "https://www.orthobullets.com/recon/12769/hip-anatomy",
  "subtitle": "Updated: Nov 27 2024",
  "sections": [
    {
      "text": "Overview",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ball-and-socket type of diarthrodial joint",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "conferred by bony architechture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "augmented by acetabular labrum and hip capsule",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Acetabulum",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "formed from three ossification centers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ilium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ischium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pubis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "posterosuperior portion has thicker cartilage for weightbearing purposes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Osteology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acetabulum",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12769/images/hip-joint-anatomy.jpg",
              "caption": "Hip joint"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**anteverted 15 degrees**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**abducted 45 degrees** (caudal tilt)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "divided into four quadrants",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12769/images/f001054f105-002-9780443069918.jpg",
                  "caption": "Tab quadrants"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "line drawn from ASIS through center of acetabulum",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "anterior and posterior quadrants",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "line perpendicularly bisecting previous line",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "superior and inferior quadrants",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**posterior-superior**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "contains superior gluteal nerve and vessels and sciatic nerve",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "safest zone for screw placement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**posterior-inferior**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "contains inferior gluteal nerve and internal pudendal vessels",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "second safest zone for screw placement",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**anterior-inferior**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "contain the obturator vessels",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "unsafe for screws",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**anterior-superior**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "contains external iliac artery and vein",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "unsafe for screws",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Proximal femur",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12769/images/b9781455725311000158_f06-02-9781455725311.jpg",
              "caption": "Proximal femur"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "femoral head",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "center of femoral head should be at the level of the tip of the greater trochanter",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "femoral neck",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**anteverted** 15 degrees (in relation to femoral condyles)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**neck shaft angle** of 125 degrees",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "greater trochanter",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "lesser trochanter",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Capsule & Ligaments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hip joint capsule",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12769/images/hipcpan3.jpg",
              "caption": "Hip capsule"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "attaches anteriorly along the intertrochanteric line",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "attaches posteriorly along the intertrochanteric crest",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12769/images/hipcppo2.jpg",
                  "caption": "posterior capsule"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "basicervical and intertrochanteric regions are extracapsular",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "three ligaments",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**iliofemoral ligament** (Y ligament of Bigelow)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "strongest ligament",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "attaches to the AIIS and intertrochanteric line",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "taut in full hip extension",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "prevents anterior dislocation / hyperextension",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ischiofemoral",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "reinforces posterior capsule",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "pubofemoral",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ligamentum teres",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cotyloid notch to fovea of femoral head",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Transverse acetabular ligament",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "located in the most inferior portion of labrum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "provides anatomic landmark to assess acetabular version during reaming for THA",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Blood supply to femoral head changes with age",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "birth to 4 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial and lateral circumflex and ligamentus teres",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "4 years of age to adult",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterosuperior and posteroinferior retinacular vessels from medial femoral circumflex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**piriformis start nails**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "damage posterosuperior retinacular vessels",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "can cause AVN of femoral head",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "adult age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial femoral circumflex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**avoid transection the quadratus** during posterior approach and damaging the MFC artery",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ligamentum teres",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arterial branch of the posterior division of the obturator artery to the femoral head",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "not significant in adults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Abdominal aorta",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**external iliac artery**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "common femoral artery",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**at risk** during screw placement in anterosuperior quadrant during THA",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "profunda femoris",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "lateral femoral circumflex",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "**ascending branch** at risk during the direct anterior approach",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**medial femoral circumflex**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "**major blood supply to femoral head**",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "at risk during psoas tenotomy",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "femoral artery perforators",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "supply vastus lateralis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**internal iliac artery**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "posterior branch of the obturator artery",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "supplies transverse acetabular ligament",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**at risk** with screw placement and acetabular retractors in the anteroinferior quadrant",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "superior gluteal",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inferior gluteal",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "supplies short external rotators and gluteus maximus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**runs along the piriformis after it exits the greater sciatic notch**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "internal pudendal",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "re-enters pelvis via lesser sciatic notch",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Corona Mortis",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12769/images/2182a73e-d14f-4555-987d-4bb94ee55d1c_f4-u1.0-b978-0-323-03329-9..50056-8..gr9.jpg",
              "caption": "Corona mortis"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "vascular connection between",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "inferior epigastric branch of the external iliac vessels",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "obturator vessels",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Neurologic",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lumbosacral plexus",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12769/images/501f511c-94f0-41d1-a679-2d9aa8c9bb0d_lumbar_plexus.svg.jpg",
              "caption": "Lumbar plexus"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "T12-S4 nerve roots",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "lies posterior to psoas muscle",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Sciatic nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**posterior division**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "peroneal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "lateral in comparison to tibial division",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**most commonly injured** neural structure during THA",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "runs deep to long head of biceps femoris",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "superior gluteal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "inferior gluteal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "piriformis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "posterior femoral cutaneous",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**anterior division**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "tibial",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "nerve to quadratus femoris",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "nerve to obturator internus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "pudendal",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "coccygeus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Obturator nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "innervates medial compartment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "all hip adductors except hamstring portion of adductor magnus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Femoral nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "between iliacus and psoas",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "branches to muscle, overlying skin, and hip joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Lateral femoral cutaneous nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "L2-L3 nerve roots; branch of the lumbar plexus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "deep to inguinal ligament near ASIS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genitofemoral nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "L1-L2 nerve roots; branch of the lumbar plexus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "two terminal branches",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "femoral branch",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "genital branch",
