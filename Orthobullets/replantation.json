{
  "title": "Replantation",
  "url": "https://www.orthobullets.com/hand/6063/replantation",
  "subtitle": "Updated: Oct 1 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Replantation is the reconstruction of an amputated portion of the upper extremity secondary to trauma.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis of an amputated digit is contingent on absence of blood supply (cold, white digit, without soft tissue attachment).",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves prompt transportation of the amputated tissue and stepwise reconstruction prior to tissue ischemia and meticulous post-operative care.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "90% of upper extremity amputation occurred after trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**4:1 male-to-female ratio**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most amputations occur at the level of the digits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of traumatic amputation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**sharp dissection**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "blunt dissection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "avulsion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "crush",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "timing of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "type and location of amputation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "number of digits involved",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "preservation of amputated tissue",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**associated injury**",
              "table": null,
