            }
          ]
        },
        {
          "text": "Examination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stump examined for",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "zone of injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tissue viability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**supporting tissue structures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "contamination",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "amputated portion inspected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "segmental injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bone and soft tissue envelope",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "contamination",
                  "table": null,
                  "images": [],
