                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications for replantation after trauma",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "primary indications",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "thumb at any level",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "multiple digits",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "through the palm",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "wrist level or proximal to wrist",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "almost all parts in children",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "relative indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "individual digits **distal to the insertion of flexor digitorum superficialis** [FDS] (Zone I)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "ring avulsion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "through or above elbow",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Contraindications to replantation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary contraindications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "severe vascular disorder",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "mangled limb or crush injury",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "segmental amputation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "prolonged ischemia time with large muscle content (>6 hours)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "relative contraindications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**single digit proximal to FDS insertion (Zone II)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "ring finger injuires in zone II have better cosmesis and grip strenth with 4th ray resection and 5th ray transposition",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medically unstable patient",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "disabling psychiatric illness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tissue contamination",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "prolonged ischemia time with no muscle content (>12 hours)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Transport of amputated tissue**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "any salvageable tissue should be transported with the patient to hospital",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "modality",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "keep amputated tissue wrapped in moist gauze in lactate ringers solution",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "place in sealed plastic bag and place in ice water (avoid direct ice or dry ice)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "wrap, cover and compress stump with moistened gauze",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**time to replantation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "proximal to carpus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**warm ischemia time < 6 hours**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**cold ischemia time < 12 hours**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "distal to carpus (digit)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**warm ischemia time < 12 hours**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**cold ischemia time < 24 hours**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**general operative sequence of replantation**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6063/images/guidelines.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "vascular shunt first (for proximal replantation with large muscle mass to minimize warm ischemia time)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "bone fixation +/- shortening (after irrigation and debridement of soft-tissue and bone)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "extensor tendon repair",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "artery repair (repair second after bone if ischemic time is >3-4 hours)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "venous anastomoses",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "flexor tendon repair",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "nerve repair",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "skin +/- fasciotomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**finger order**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "thumb, long, ring, small, index",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "for multiple amputations **structure-by-structure** sequence is most efficient",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "digit-by-digit sequence takes the most time",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Postoperative Care",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Environment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "keep patient in warm room (80°F)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "avoid caffeine, chocolate, and nicotine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Replant monitoring",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**skin temperature most reliable**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "concerning changes include a > 2° drop in skin temp in less than one hour or a temperature below 30° celsius",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**pulse oximetry**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**< 94% indicates potential vascular compromise**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anticoagulation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "adequate hydration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "medications (aspirin, dipyridamile, low-molecular weight dextran, heparin)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Arterial Insufficiency",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "treat with",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "release constricting bandages",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "place extremity in dependent position",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "consider heparinization",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "consider stellate ganglion blockade",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "early surgical exploration if previous measures unsuccessful",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "thrombosis secondary to vasospasm is most common cause of early replant failure",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Venous congestion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "elevate extremity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "leech application",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "releases Hirudin (powerful anticoagulant)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Aeromonos hydrophila infection can occur",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "prophylaxis with **Ciprofloxacin or Bactrim**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "heparin soaked pledgets if leeches not available",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Replantation failure**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "most frequently cause within 12 hours is arterial thrombosis from persistent vasospasm",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "decreased palmar width with ray resection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Stiffness**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "replanted digits have 50% of total motion",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "tenolysis is most common secondary surgery",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Myonecrosis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "greater concern in major limb replantation than in digit replantation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Myoglobinuria**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "caused by muscle necrosis in larger replants (forearm and arm)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "can lead to renal failure and be fatal",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Reperfusion injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "mechanism thought to be related to ischemia-induced hypoxanthine conversion to xanthine",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "allopurinol is the best adjunctive therapy agent to decrease xanthine production",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Infection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Cold intolerance**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
