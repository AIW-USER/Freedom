    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "collision or direct blow to the thigh during competition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "worsening severity over the first 24-48 hours",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "worse with dynamic movements and with knee flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "swelling, **ecchymosis**, point tenderness",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "compare thigh firmness and circumference to contralateral side",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "possible palpable defect indicating partial or complete muscle tear",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "possible knee effusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "variable **loss of knee flexion**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "antalgic gait",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "straight leg raise to test integrity of extensor mechanism",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "distal neurovascular exam to evaluate for thigh compartment syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "only necessary acutely in severe injuries with high suspicion for underlying fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**myositis ossificans**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3103/images/myositis_femur..jpg",
                      "caption": "AP radiograph showing myositis ossificans"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "occasionally seen in **chronic cases**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "concern for extensor mechanism disruption",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "best to demonstrate the degree of soft tissue involvement and extensor mechanism integrity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "finding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "will find edema with muscles",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3103/images/axial_mr_quad_cont.jpg",
                      "caption": "MRI showing contusion and fluid within quad"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3103/images/quadriceps%20contusion%20mri.jpg",
                      "caption": "MRI showing edema within the quadriceps signifying a contusion"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/3103/images/quad%20contusion%20mri.jpg",
                      "caption": "MRI shows quadriceps contusion."
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Maintain suspicion for compartment syndrome in severe injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization, cryotherapy, NSAIDs, physical therapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "first line of treatment for acute injuries",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "begin immediately to minimize hematoma formation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thigh fasciotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "compartment syndrome",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Immobilization, cryotherapy, NSAIDs, physical therapy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "immobilization",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "in 120 degrees of flexion using an ace wrap or hinged knee brace immediately after injury for 24-48 hours, frequent use of cold therapy",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3103/images/quad%20contusion_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "physical therapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "transition to stretching and active ROM exercises after initial flexion period, protected weight-bearing with crutches often required",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "begin functional rehabilitation and sport-specific activities once full and pain-free ROM achieved",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Thigh fasciotomies**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3103/images/646fe3e1-c704-465d-a447-4ca731cb5ca2_thigh_fasciotomy..jpg",
              "caption": "Thigh fasciotomy"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "single **anterolateral incision** over length of thigh allows access to anterior and posterior compartments",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "decompression",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "incise fascia lata to expose and decompress anterior compartment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "retract vastus lateralis medially to expose lateral intermuscular septum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "incise lateral intermuscular septum to decompress posterior compartment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may add medial incision to decompress adductor compartment if involved",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Myositis Ossificans**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "incidence ranges from 9-18%",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "more common with severe contusions",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "develops 2-4 weeks following injury",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "lesions followed with serial imaging, characteristic **“egg-shell”** calcifications on radiographs",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "observation often successful",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "resection if continued pain with loss of strength and knee motion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "only operate on **mature lesions** showing no signs of continued growth",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "maturation occurs around 6-12mos",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Compartment syndrome**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "usually due to rupture of deep perforating branches of the deep femoral vessels",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "thigh fasciotomy",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Self-limited course with a prolonged disability without appropriate treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Initiation of treatment greatly expedites recovery and return to sport (13 days for mild contusions)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Time to return directly correlated with initial severity of injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
