{
  "title": "Shoulder Resurfacing",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3077/shoulder-resurfacing",
  "subtitle": "Updated: Jun 5 2021",
  "sections": [
    {
      "text": "Prosthetic Resurfacing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "humeral head arthroplasty with a non-stemmed, metal prosthesis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may or may not be mated with glenoid prosthesis or biologic resurfacing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Advantages over conventional stemmed prosthesis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "no osteotomy is needed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**no change in anatomic offset or version**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "improved restoration of normal biomechanics",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "minimal bone resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "shorter operative time",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "low prevalence of humeral periprosthetic fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**easy revision to conventional arthroplasty if needed**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cases in which the humerus anatomy is abnormal, causing:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "difficulty with dislocation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "difficulty with stem insertion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "examples",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "humeral dysplasia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "developmental",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "secondary",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "Apert's disease",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "epiphyseal dysplasias",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "chronic Erb's palsy",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "prior humerus fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "proximal, metaphyseal, or diaphyseal malunion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "hardware in place which blocks stem implantation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "has demonstrated success in pain relief",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "does not reliably improve motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "at one year, **considered inferior to outcomes of traditional stemmed prostheses**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "implant loosening is most common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Biologic Resurfacing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Also known as interpositonal allografting",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Concept of putting soft tissue in glenoid to reduce symptoms and obviate need for TSA",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Frequently combined with hemiarthroplasty of the humerus or humeral prosthetic resurfacing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "young patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rotator cuff arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "GH narrowing following hemiarthroplasty",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "GH arthritis following arthroscopic stabilization procedures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Interpositional allografts include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**fascia lata**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "meniscal allograft",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "achilles allograft",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "acellular dermal matrix",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "short-term outcomes (2-year)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "improvement:",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "VAS pain score",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "ASES score",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "questionable improvement:",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "active forward elevation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "active external rotation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "active internal rotation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "long-term outcomes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the rate of failure by 36-months has been reported at 44%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "difficulty converting to TSA due to scarring within the glenohumeral joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
