{
  "title": "Molecular Biology Basics",
  "url": "https://www.orthobullets.com/basic-science/9084/molecular-biology-basics",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "Nuclear structures",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Chromosomes**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "46 in humans (23 pairs)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "22 pairs of autosomes, 1 pair of sex chromosomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "contains DNA and RNA",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Deoxyribonucleic acid (DNA)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Thymine, adenine, guanine, and cytosine (TAGC)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "adenine linked to thymine (A-T)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "guanine linked to cytosine (G-C)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "double stranded",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "strands linked together by phosphate groups",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "2' hydrogen group",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "regulates cell division",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "mRNA is produced from DNA",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "an exon is portion of gene that codes for mRNA",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**ex**on is **ex**pressed",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Gene**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "segment of DNA that contains the information needed to synthesize a protein",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "determines the unique biologic qualities of a cell",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**exon**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "coding information",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**intron**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "does not code for mRNA",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Ribonucleic acid (RNA)**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9084/images/rna.jpg",
              "caption": "different RNA"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "usually single stranded but can be double stranded",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "double stranded RNA found in some viruses",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "certain interactions between single stranded RNA in human cells can form double stranded RNA",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "has ribose sugar",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "Uracil, adenine, guanine, and cytosine (UAGC, **no thymine**)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "less stable than DNA",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "2' hydroxyl group",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "can be located in either the nucleus or cytoplasm",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "messenger RNA (mRNA)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "translates DNA information into protein",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "ribosomal RNA (rRNA)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "major part of ribosome, which helps synthesize a protein",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "transfer RNA (tRNA)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "transfers amino acids to mRNA",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Genetic Terms",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Nucleotides**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "thymine, adenine, guanine, and cytosine",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Codon**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "sequence of three nucleotides",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "each codon correlates to one of the 20 amino acids",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "linking of the amino acids create a protein",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Gene promotor**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "regulatory portion of DNA that controls initiation of transcription",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Gene enhancers**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "site on DNA that transcription factors bind to",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "regulate transcription",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Transcription**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "DNA => mRNA",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Translation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "mRNA => protein",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Haploid**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Haploid is the amount of DNA in a human egg or sperm cell (half the amount of DNA in a normal cell)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Whole-genome sequencing**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Whole-genome sequencing (WGS) is the process of determining the entirety, or near entirety, of the DNA sequence of an organism's genome, including coding and non-coding DNA",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Whole-exome sequencing**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Whole-exome sequencing (WES) allows sequencing of only the protein-coding regions of genes in a genome (known as the exome)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Genome-wide association sequencing**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Genome-wide association sequencing (GWAS) uses single-nucleotide polymorphisms (SNPs) to evaluate mutational variability among patients with a phenotype (or disease) of interest.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": []
    },
    {
      "text": "Cell Cycle",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Phases",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9084/images/cell_cycle.jpg",
              "caption": ""
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "**G0**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "represents a \"stable\" phase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cells are **diploid** (2N) in the G0 and G1 phases",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**G1**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "initial growth phase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cells are **diploid** (2N) in the G0 and G1 phases",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**S**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "DNA replication/synthesis phase",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "cells become **tetraploid** (4N) at the end of S and for the entire G2 phases",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**G2**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "gap phase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cells become **tetraploid** (4N) at the end of S and for the entire G2 phases",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**M**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "mitosis phase",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Apoptosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Defined as programmed cell death",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Requires a series of intracellular signaling events",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Different from cell lysis - where a cell releases its contents into the surrounding area",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "One hallmark of cancer is the cell's loss of apoptosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Research techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Agarose gel electrophoresis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "separates DNA based on size",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "DNA is negatively charged",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "gel exposed to electric field",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "smaller pieces moves through gel faster",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Southern blotting**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "restriction enzymes cut up DNA",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "separate on agarose gel",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "identifies **DNA sequence**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Northern blotting**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "restriction enzymes cut up RNA",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "separate on agarose gel",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "identifies **RNA sequence**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Western blotting**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "SDS-PAGE gel",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "identifies protein",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**DNA ligation**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "combining different DNA fragments not found together naturally to create **recombinant DNA**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Plasmid vector**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "an extrachromosomal element, often circular, that can replicate and be transferred independently of the host chromosome",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "one example of the function of a plasmid is antibiotic resistance",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "can be introduced into bacteria in the process of transformation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Polymerase chain reaction (PCR)**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "DNA => DNA",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "a molecular biology tool used to generate many copies of a DNA sequence",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "uses \"primers\" specific to a segment of DNA",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "requires temperature-mediated enzyme DNA polymerase",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Reverse transcription polymerase chain reaction (RT-PCR)**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "RNA => DNA",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "variant of polymerase chain reaction (PCR) used in molecular biology to generate many copies of a DNA sequence from fragments of RNA",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "RNA strand is first reverse transcribed into its DNA complement",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "amplification of the resulting DNA proceeds using polymerase chain reaction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    }
  ],
