{
  "title": "Anterior Tibialis Tendon Rupture",
  "url": "https://www.orthobullets.com/foot-and-ankle/7055/anterior-tibialis-tendon-rupture",
  "subtitle": "Updated: Apr 22 2026",
  "sections": [
    {
      "text": "SUMMARY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anterior Tibialis Tendon Ruptures are traumatic anterior ankle injuries that can present with foot drop and impaired gait.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with presence of a painless mass at the anteromedial aspect of the ankle associated with weakness of dorsiflexion.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally direct surgical repair of the tendon to achieve optimal functional outcomes.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "result of either laceration of the tendon or closed rupture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may also result from strong eccentric contraction in young individual",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Medical conditions & comorbidities",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diabetes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inflammatory arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "attritional rupture more common in older patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "strong eccentric contraction more common in younger patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "body location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "at the level of the ankle joint with varying degrees of retraction of the proximal stump",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "older age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**diabetes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**fluoroquinolone use**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "local steroid injection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inflammatory arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Ankle dorsiflexion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary ankle dorsiflexor (80%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**tibialis anterior**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "inserts onto the medial cuneiform and base of 1st metatarsal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "secondary ankle dorsiflexors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**extensor hallucis longus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**extensor digitorum longus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patient reports a 'pop' followed by anterior ankle swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "chronic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patient reports difficulty clearing foot during gait",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Symtpoms:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "chronic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be painless",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain swelling anterior to ankle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "weakness in dorsiflexion of the ankle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "delay in diagnosis is common because of intact ankle dorsiflexion that occurs as a result of secondary function of the extensor hallucis longus and extensor digitorum longus muscles",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "chronic injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inspection and palpation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "swelling may be minimal",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**painless mass at the anteromedial aspect of the ankle**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "loss of the contour of the tibialis anterior tendon over the ankle (tendon not palpable during resisted dorsiflexion)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "weakness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "use of the extensor hallucis longus and extensor digitorum communis to dorsiflex the ankle",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "gait",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**steppage gait** (hip flexed more than normal in swing phase to prevent toes from catching)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "foot slaps down after heel strike",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "three views of foot and ankle helpful to exclude any associated osseous injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not indicated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "helpful to diagnose complete versus partial tear but not to determine if interposition graft is necessary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lumbar radiculopathy (L4)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be differentiated from TA rupture by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "intact tendon palpable",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "no ankle mass",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may have dermatomal sensory abnormality",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "positive lumbar spine MRI",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Common peroneal nerve compression neuropathy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "EDL, EHL also affected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sensory abormalities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "history of compression to common peroneal nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ankle-foot orthosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "low demand patient",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "casting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "partial ruptures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "direct repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "acute injury (<6 week) injuries in an active, high demand patient",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "should be attempted up to 3 months out",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "surgical repair leads to improved AOFAS scores and improved levels of activity",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "some residual weakness of dorsiflexion is expected",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "reconstruction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most often required in chronic (>6 week) old injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Direct repair**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "open laceration: incorporate laceration",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "closed rupture: longitudinal incision centered over palpable defect",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "repair technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "distal end usually accessible through laceration, proximal end may retract ~3cm",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "place hemostat in wound under extensor retinaculum and pull tendon into wound",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "primary end-to-end non-absorbable suture with Krackow, Bunnell or Kessler technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "if less then 5 degrees of ankle dorsiflexion with the knee extended perform gastrocnemius recession prior to tensioning repair",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ends oversewn with small monofilament if frayed to create smoother gliding surface",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "in cases of avulsion, suture anchors or bone tunnels may be used for reattachment",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Tendon reconstruction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "curvilinear incision over course of tibialis tendon, may need to be extensile depending needs of reconstruction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "EHL can be divided through separate small incision and tunneled proximally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "sliding tendon graft",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "harvest one half width of tibialis anterior tendon proximally and turn down to span gap",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "repair can be strengthened by securing tibialis anterior tendon to medial cuneiform or dorsal navicular distal to extensor retinaculum",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "free tendon graft",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "interposition of **autograft (hamstring, plantaris)** or allograft",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**EHL tenodesis or EHL transfer**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "distal EHL stump tenodesed to EHB",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "proximal EHL stump used as tendon graft to repair tibialis anterior insertion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "proximal tibialis anterior placed under tension prior to suturing to proximal EHL stump",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Failure of reconstruction/repair",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Weakness of dorsiflexion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Adhesion formation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Neuroma formation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Good with treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
