  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "primarily a neurovascular approach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "pathology related to posterolateral and posteromedial corners of the knee should be approached using lateral and medial approaches to knee respectively",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**neurovascular repair in traumatic injury**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**PCL avulsion repair**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "gastrocnemius recession in knee contractures",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "hamstring lengthening",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Baker's / popliteal cyst excision",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "tibial nerve compression by soleus",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Key Anatomy",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "gastrocnemius",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "semimembranosus",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "semitendinosus",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Nerves",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "medial sural nerve",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Vessels",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "small saphenous vein",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "popliteal artery and vein",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "genicular vessels (two superior, two inferior, one middle)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Internervous Plane",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The is no true internervous plane",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Preparation & Positioning",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Preparation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "table",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "use radioopaque table when performing fixation (PCL avulsion)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "tourniquet",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "used in most cases except when a vascular repair is being performed",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "may delay exsanguination until vein is identified",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Position",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patient is placed prone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Approach",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incision",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "identify superficial landmarks",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "gastrocnemius",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "semimembranous",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "semitendinosus",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "biceps femoris",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**make lazy-S incision running**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "from lateral biceps femoris",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "to medial head of gastrocnemius muscle and into calf",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Superficial Dissection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**make subcutaneous skin flaps**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "generous skin flaps will facilitate closure",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**identify small saphenous vein and medial sural nerve**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "medial sural nerve runs on lateral side of vein",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "small sapheneous vein can assist in locating the medial sural nerve",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "the medial sural nerve is a branch of the tibial nerve and can be used as a guide and into popliteal fossa",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**incise fascia of popliteal fossa**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "make fascial incision just medial to small saphenous vein",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**disect to apex of popliteal fossa**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "use tibia nerve as a guide to apex of popliteal fossa",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "apex is formed by semimembranous (medial) and biceps femoris (lateral)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**mobilize common peroneal nerve**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "branches from tibial nerve at apex of popliteal fossa",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "runs along posterior border of biceps femoris",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**mobilize popliteal artery and vein**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "lies deep and medial to tibial nerve",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "popliteal vein lies medial to artery as it enters the fossa, then it curves and lies directly posterior to the artery at the midpoint in the fossa",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "must identify and ligate at least one of the five genicular branches in the posterior knee that include",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Deep Dissection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**evaluate posteromedial joint capsule**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "faciliated by detaching medial head of gatrocnemius at origin",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**evaluate posterolateral corner of joint**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "develop plane between lateral head of gastrocnemius and biceps femoris",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "faciliated by detaching lateral head of gatrocnemius at origin",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Dangers & Complications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Medial sural cutaneous nerve injury**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "avoid injury by entering fossa medial medial to small saphenous vein (nerve lies lateral)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "injury make lead to painful neuroma or anesthesia",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Tibial nerve injury**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "injury at this level leads to paralysis of foot and toes flexors",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Common peroneal nerve injury**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "injury at this level leads to paralysis of extensors and evertor of the foot",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Popliteal artery**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    }
  ],
