{
  "title": "Domestic and Elder Abuse",
  "url": "https://www.orthobullets.com/trauma/1060/domestic-and-elder-abuse",
  "subtitle": "Updated: Jul 9 2026",
  "sections": [
    {
      "text": "Elder abuse",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "can be in the form of mental or physical abuse, neglect, financial wrongdoings or abandonment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "affects around 2 million Americans per year",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "approximately **1 in 25 individuals** over 65 y/o experiences abuse or neglect",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "risk factors of victims for elder abuse",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "increasing age",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**functional disability**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "child abuse within the regional population",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cognitive impairment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "gender is NOT a risk factor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "caretaker risk factors for elder abuse",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "financial dependence on the elder person",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**substance abuse**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "perceiving the caretaking duty as burdensome",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Etiology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "associated injuries",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**long bone fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**rib fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "bruises caused from abuse are",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "commonly over 5cm in size",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "located on the face, neck or back",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Clinical signs of elder abuse",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unexplained injuries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "delays in seeking care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**repeated fractures, burns, lacerations, etc**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "change in behavior",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "poor hygiene",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "duty to report",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**physicians are mandated reporters of abuse** on elders in almost all states",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "elder abuse is very commonly under reported",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "admit to hospital",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "if the patient is in immediate danger, the patient should be admitted to the hospital",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Domestic, spousal or intimate partner abuse",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "as many as 35% of women presenting to the ER with injuries are a result of domestic violence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "approximately **25% of women experience domestic violence**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "most common cause of nonfatal injury to women",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "frequency often underestimated by orthopaedic surgeons",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "15% of males are victims of domestic violence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "over 8.5% reported prior history of abuse",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "children abused in close to 50% of homes where domestic violence occurs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risks for domestic abuse",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "female",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "19-29 years",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "pregnant",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "short-term relationship",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "cohabitation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "low-income families/low socioeconomic status",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Etiology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "characteristic injuries or patterns",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "injuries inconsistent with history",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**long delay between injury and treatment**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "repeat injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "characteristics of abused patient",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "change in affect",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "constantly seeking partner approval",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "finding excuses to stay in treatment facility for prolonged period of time",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "repeated visits to the emergency department",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**significant time missed at work or decreased productivity at work**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "characteristics of the abuser",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "refuses to leave patient alone",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "overly attentive",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "aggressive or hostile",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**refuses to let the patient answer their own questions**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "barrier to reporting",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fear of retaliation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "shame",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "difficulty reporting to male physicians",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fear of custody conflicts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "duty to act",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "health care workers should inquire into the safety environment at home in cases of suspected abuse",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "emotional abuse is more difficult to discern than physical violence",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "reporting requirements for adult abuse is not standardized among states",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**a physician does not have authority to provide protection to abused spouses in most states**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "should encourage victim to seek protection and report case to law enforcement",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "physician should document encounter completely and be familiar with their state laws",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
