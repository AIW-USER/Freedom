          "children": [
            {
              "text": "antalgic gait",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "anterior hip pain and hip flexion weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
