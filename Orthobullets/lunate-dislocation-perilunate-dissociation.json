{
  "title": "Lunate Dislocation (Perilunate dissociation)",
  "url": "https://www.orthobullets.com/hand/6045/lunate-dislocation-perilunate-dissociation",
  "subtitle": "Updated: Oct 3 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lunate/perilunate dislocations are high energy injuries to the wrist associated with neurological injury and poor functional outcomes.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis requires careful evaluation of plain radiographs.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment requires urgent closed versus open reduction and stabilization.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "< 1 per 100,000 injuries annually",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**commonly missed (~25%) on initial presentation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism of injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "traumatic, high energy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**occurs when wrist extended and ulnarly deviated**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**leads to intercarpal supination**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathoanatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sequence of events",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6045/images/f34.medium.jpg",
                  "caption": "sequence of perilunate dislocation"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "scapholunate ligament disrupted -->",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "disruption of capitolunate articulation -->",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "disruption of lunotriquetral articulation -->",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "failure of dorsal radiocarpal ligament -->",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "lunate rotates and dislocates, **usually into carpal tunnel**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "dislocation can course through",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**greater arc**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**ligamentous disruptions with associated fractures of the radius, ulnar, or carpal bones**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6045/images/greater%20and%20lesser.jpg",
                          "caption": "greater and lesser arc injuries"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**lesser arc**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**purely ligamentous**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6045/images/greater%20and%20lesser.jpg",
                          "caption": "greater and lesser arc injuries"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
