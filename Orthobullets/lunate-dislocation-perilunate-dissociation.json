                      "text": "all acute injuries < 8 weeks old",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "emergent closed reduction leads to",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**decreased risk of median nerve damage**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**decreased risk of cartilage damage**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "return to full function unlikely",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "decreased grip strength and stiffness are common",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "proximal row carpectomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "chronic injury (defined as >8 weeks after initial injury)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "not uncommon, as initial diagnosis frequently missed",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "total wrist arthrodesis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "chronic injuries with degenerative changes",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed Reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "finger traps, elbow at 90 degrees of flexion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "hand 5-10 lbs traction for 15 minutes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dorsal dislocations are reduced through wrist extension, traction, and flexion of wrist",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "apply sugar tong splint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "follow with surgery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction, ligament repair and fixation +/- carpal tunnel release**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach (controversial)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "dorsal approach",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "longitudinal incision centered at Lister's tubercle",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "excellent exposure of proximal carpal row and midcarpal joints",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "does not allow for carpal tunnel release",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "volar approach",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "extended carpal tunnel incision just proximal to volar wrist crease",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "combined dorsal/volar",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "pros",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "added exposure",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "easier reduction",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "access to distal scaphoid fractures",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "ability to repair volar ligaments",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "carpal tunnel decompression",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "cons",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "some believe volar ligament repair not necessary",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "increased swelling",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "potential carpal devascularization",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "difficulty regaining digital flexion and grip",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fix associated fractures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "repair scapholunate ligament",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "suture anchor fixation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "protect scapholunate ligament repair",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "controversy of k-wire versus intraosseous cerclage wiring",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "repair of lunotriquetral interosseous ligament",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "decision to repair based on surgeon preference as no studies have shown improved results",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "post-op",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "short arm thumb spica splint converted to short arm cast at first post-op visit",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "duration of casting varies, but at least 6 weeks",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Proximal row carpectomy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "perform via dorsal and volar incisions if median nerve compression is present",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "volar approach allows median nerve decompression with excision of lunate",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "dorsal approach facilitates excision of the scaphoid and triquetrum",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
