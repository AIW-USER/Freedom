{
  "title": "Congenital Muscular Torticollis",
  "url": "https://www.orthobullets.com/spine/2052/congenital-muscular-torticollis",
  "subtitle": "Updated: Jan 15 2023",
  "sections": [
    {
      "text": "SUMMARY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Muscular Torticollis is a musculoskeletal deformity caused by the abnormal contraction of the sternocleidomastoid muscle.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "The condition typically presents in infants and children with a persistent head tilt toward the involved side.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with the presence of a palpable neck mass from a contracted sternocleidomastoid muscle with the chin rotated towards the contralateral side.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is typically passive stretching with the condition resolving within a year. Surgical lengthening of the SCM muscle is indicated with failed response to at least 1 year of stretching.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**most common** cause of infantile torticollis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "0.3 - 2.0%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3:2 male to female ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "neck",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oligohydramnios",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "first pregnancy (limited intrauterine space)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "traumatic delivery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "breech delivery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**contracture of the sternocleidomastoid (SCM)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cervical rotational deformity with chin rotation away from the affected side and head tilt towards the affected side",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "suspected muscle injury from compression and stretching of SCM",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "venous outflow obstruction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "compression leading to decreased blood supply and subsequent compartment syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated with other packaging disorders",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**developmental dysplasia of the hip (5 - 15% association)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**metatarsus adductus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**calcaneovalgus feet**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "plagiocephaly (asymmetric flattening of the skull)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occurs on contralateral side",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "congenital atlanto-occipital abnormalities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "ANATOMY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**sternocleidomastoid muscle (SCM)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "origins",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "sternal head - anterior surface of manubrium sterni",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "clavicular head - superior surface of medial third of clavicle",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "insertions",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "lateral mastoid process on temporal bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "lateral occipital bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "innervation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "cranial nerve XI - spinal accessory nerve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "at risk when operatively releasing SCM",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "ipsilateral neck flexion, contralateral head rotation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "PRESENTATION",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**head tilt and rotation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "painless passive motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**palpable neck mass** from contracted SCM",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "usually noted within the first four weeks of life or during newborn exam",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2052/images/clinical%20photo%20-%20neck%20mass.jpg",
                          "caption": "Shows palpable neck mass with congenital muscular torticollis"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "head tilt & rotation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "neck tilt towards the affected SCM",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "chin rotation away from the affected SCM",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2052/images/combined_chla.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "conduct routine baby exam",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "assess visual function, auditory assessment, and neurologic exam",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "examine for hip dysplasia, foot deformities, as well as spine abnormalities",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "in older children - restriction of rotation and lateral flexion of neck",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "mass becomes a tight band",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "IMAGING",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "head tilt and rotation with no palpable mass present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rule out other bony conditions that can cause torticollis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dynamic CT scan",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "scan at C1-C2 level with head straight, then in maximum rotation to left and right",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rule out atlantoaxial rotatory subluxation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "MRI brain and cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rule out non-muscular and central causes of torticollis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**head tilt and rotation with decreased ROM in the presence of a palpable mass**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "larger and hyperechoic (due to fibrosis) SCM on involved side when compared to contralateral side",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "differentiate congenital muscular torticollis from more serious underlying neurologic or osseous abnormalities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "DIFFERENTIAL",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Atlantoaxial rotatory subluxation**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**painful** (compared to painless for congenital muscular torticollis)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "post-traumatic or post-infectious (Grisel's disease)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Klippel-Feil syndrome**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "classic triad:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "short webbed neck",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "low posterior hairline",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "limited cervical range of motion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ophthalmologic and vestibular conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Lesions of central and peripheral nervous system",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "TREATMENT",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "passive stretching",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "condition present for less than 1 year",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "less than 30° limitation in ROM",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "90-95% respond to passive stretching in the first year of life",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bipolar release of SCM or Z-lengthening",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**failed response to at least 1 year of stretching**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "good outcomes (92% success), even in older children",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "facial asymmetry can improve as long as release done prior to 10 years of age",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "TECHNIQUES",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Passive stretching**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "opposite of the deformity",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "lateral head tilt away from affected side",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "chin rotation toward the affected side",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Bipolar release of SCM or Z-lengthening**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "short, proximal incision behind the ear to divide SCM",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "single or dual incision to reach sternal and clavicular attachments of SCM",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "SCM branch of CN XI (spinal accessory nerve) is at risk",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "COMPLICATIONS",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Permanent rotational deformity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "left untreated or unnoticed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Positional plagiocephaly**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "left untreated or unnoticed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Craniofacial deformities**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "facial asymmetry",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "facial hemihypoplasia",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Compensatory scoliosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Typically resolves with stretching within the first year",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
