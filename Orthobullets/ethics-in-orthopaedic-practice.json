{
  "title": "Ethics in Orthopaedic Practice",
  "url": "https://www.orthobullets.com/basic-science/422972/ethics-in-orthopaedic-practice",
  "subtitle": "Updated: Sep 24 2024",
  "sections": [
    {
      "text": "Relations with Industry and Hospitals",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Acceptable standards of professionalism**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "practicing orthopedic surgeons may accept tuition, travel, and modest hospitality (including meals and receptions) to attend an industry sponsored **non-CME course** given at a local convention center",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "industry relationships must be disclosed to patients, colleagues, and institution",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "gifts must have a market value under $100",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "no direct kick-backs can be given to a physician or hospital systems from an industry",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "physicians cannot refer patients to centers in which they have a financial interest (Stark II laws)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Patient Satisfaction & Complaints",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Patient complaints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "formal written patient complaints regarding quality of care require letters of response to patients from the surgeon",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Communication",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "leading cause of medical litigation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "on average, most doctors interrupt patients during an interview within 23 seconds",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "orthopedic surgeons are described by patients and colleagues as \"high tech but low touch\"",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "orthopedic surgeons are described as having poor communication skills and empathy for patients",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "translation services",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can be provided by employees fluent in the language, commercially available telephonic services, professional interpreters, and volunteer translators",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inappropriate for family members to act as translators unless patients offer/agree",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Medical Innovation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Royalties**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "surgeons receiving royalties for implants used in surgery must be disclosed to patients",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Research",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "must disclose any financial conflicts of interest and should ethically remove any possible bias from funded studies",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Patient Transfer",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**The Emergency Medical Treatment and Active Labor Act (EMTALA)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "all patients must be appropriately screened and stabilized in the original emergency room/hospital",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "risk of patient transfer must be less than the risk of keeping patient",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "accepting hospital/center must know of and accept patient",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Physician Advertising",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physician advertising is becoming more common",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "AMA and AAOS cannot prevent physicians from advertising services",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "FTC, AAOS, state medical boards can sanction for false advertising",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**things to avoid**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "using terms such as \"cure\" if no cure truly exists",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "using terms such as \"painless\" or \"bloodless\" to describe surgery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "overstating credentials such as \"board certified in joint replacement\" if no such qualification exists",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "using terms such as \"world renowned\"",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Diversity",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Understanding cultural differences leads to",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "enhanced patient-physician relationships",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "minimized disparities in health care",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "optimized access to orthopaedic care",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Implicit biases**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "present when unconscious prejudices or stereotypes influence care delivered to patients",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "determinant of health disparities",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Access to Healthcare",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Type of health insurance has been shown to be a determinant of healthcare access in the pediatric population",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Physician burnout",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Consist of loss of enthusiasm for work, feelings of cynicism, and diminished feelings of personal accomplishment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Affects 45-55% of all US physicians",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
