{
  "title": "Prepatellar Bursitis (Housemaid's Knee)",
  "url": "https://www.orthobullets.com/knee-and-sports/3018/prepatellar-bursitis-housemaids-knee",
  "subtitle": "Updated: May 29 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prepatellar bursitis is the swelling and inflammation of the anterior knee bursa associated with pain with kneeling.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with mild swelling and tenderness over the anterior knee overlying the patella.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is nonoperative with compressive wraps and NSAIDs. Occasionally, in the setting of septic bursitis, antibiotics may be indicated.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common bursitis of the knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bursa anterior to patella",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "excessive kneeling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "common in **wrestlers**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**concern for septic bursitis in wrestlers**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be septic or aseptic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "20% are septic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prepatellar bursa",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the prepatellar bursa is a potential space",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "function to enhance gliding of tissue over patella",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3018/images/bursae%20in%20knee.jpg",
                  "caption": "description of inflammation of bursae about the knee"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often patients have a history of kneeling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be warm to touch, especially if septic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Aspiration with gram stain and culture**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "rarely indicated",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "can be used to distinguish between septic versus aseptic if necessary",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "on physical exam a septic presentation is difficult to distinguish from an aseptic presentation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "the collection is extra-articular so the patient does not have the pain one has with septic arthritis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "S. aureus is the most commonly cultures organism in both septic olecranon and prepatellar bursitis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "compressive wrap, NSAIDs, **+/-aspiration and** immobilization for 1 week",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "corticosteroid use is controversial",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
