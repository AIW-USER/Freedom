        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Jansen type",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "mental retardation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "markedly-short limbed dwarfism with:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "wide eyes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "monkey-like stance",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**hypercalcemia**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Schmid type",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often not diagnosed until older age due to marked **coxa vara** and **genu varum**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "short-limbed dwarf involving:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Trendelenburg gait**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "predominate **proximal femur** involvement",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**increased lumbar lordosis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**normal laboratory results**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "McKusick type",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common associated with",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**atlantoaxial instability secondary to odontoid hypoplasia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**ankle deformity due to fibular overgrowth**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**associated with:**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**abnormal immunocompetence**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**increased risk for malignancies**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**intenstinal malabsorption**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**megacolon**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Jansen type",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP pelvis, hip, knee, and upper extremity radiographs",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4099/images/metaphyseal_chondrodysplasia_-_jansen_type.jpg",
                      "caption": "Jansen type metaphyseal chondrodysplasia"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4099/images/metaphyseal_chondrydysplasia_-_jansen_type_hips.jpg",
                      "caption": "Jansen type metaphyseal chondrodysplasia"
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4099/images/metaphyseal_chondrodysplasia_-_jansen_type_upper.jpg",
                      "caption": "Metaphyseal chondrodysplasia - Jansen type upper extremities"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "reveals bulbous expansion of metaphysis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Schmid type",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP pelvis and hip radiographs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rule out coxa vara",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "standing lower extremity films",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rule out genu varum",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "McKusick type",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "cervical AP, lateral, flexion and extension views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rule out atlantoaxial instability",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ankle AP, oblique and lateral views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "surveillance of potential distal fibular overgrowth",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Metaphyseal dysplasia involving the proliferative and hypertrophic zone of the physis (epiphysis is normal)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior atlantoaxial fusion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "atlantoaxial instability measuring 8 mm or more",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "myelopathy",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "posterior instrumentation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "valgus intertrochanteric osteotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "coxa vara angle <100 degrees",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "progressive coxa vara",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "symptomatic hip arthritis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "valgus + extension osteotomy may help to decrease an associated hip flexion deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "reconstructive measures may be indicated in patients with subluxation, hinge abduction, or osteoarthritis.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "open reduction and fixation of proximal femur and acetabulum to treat hip dislocations.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "tibial osteotomies or hemiepiphysiodeses",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "symptoms are severe",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "nonoperative modalities have failed",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "limb lengthening through a metaphyseal corticotomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "controversial due to high rate of complications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
