{
  "title": "Monteggia Fracture - Pediatric",
  "url": "https://www.orthobullets.com/pediatrics/4015/monteggia-fracture--pediatric",
  "subtitle": "Updated: Feb 27 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Monteggia Fractures in the pediatric population are defined as proximal ulna fractures or plastic deformation of the ulna with an associated radial head dislocation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made with plain radiographs of the elbow.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment may be closed reduction and casting for length stable ulna fractures with a stable radiocapitellar joint. Surgical management is indicated for radial heads that are not stable following closed reduction.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "4 to 10 years of age is peak incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radial head dislocation plus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "proximal ulna fracture or",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "plastic deformation of the ulna without obvious fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Bado Classification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Apex anterior** proximal ulna fracture with **anterior dislocation** of the radial head",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4015/images/37_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Apex posterior** proximal ulna fracture with **posterior dislocation** of the radial head",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4015/images/bado%20type%20ii.jpg",
                          "caption": "Shows a Bado Type II Monteggia fracture."
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Apex lateral** proximal ulna fracture with **lateral dislocation** of the radial head",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4015/images/type%20iii.ap_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type IV",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Fractures of both the radius and ulna** at the same level with an**anterior dislocation** of the radial head (1-11% of cases)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4015/images/bado%20type%20iv%20monteggia%20fx.jpg",
                          "caption": "Shows a Bado Type IV Monteggia fracture"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, swelling, and deformity about the forearm and elbow",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "must **palpate** over **radial head** with all ulna fractures because spontaneous relocation of radial head is common",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "must examine for **plastic deformation** of the ulna if there is a presumed isolated radial head dislocation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "isolated radial head dislocations almost never occur in pediatric patients",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obtain **elbow radiographs** for all forearm fractures to evaluate for radial head dislocation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "assess **radiocapitellar line** on every lateral radiograph of the elbow",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4015/images/radiocapitellar%20line%20on%20x-ray.jpg",
                      "caption": "Shows the radiocapitellar line"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "a line down the axis of the radial neck should pass through the center of the capitellar ossification center",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4015/images/f585a5cd-7615-4fb3-a01e-2c78c6752809_rc_line.jpg",
                          "caption": "RC line"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "obtain **forearm radiographs** for all radial head dislocations",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction of ulna and radial head dislocation and long arm casting",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Bado Types I-III with",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**radial head is stable following reduction**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**length stable ulnar fracture pattern**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "reduction technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "reduction technique uses traction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "radial head will reduce spontaneously with reduction of the ulna and restoration of ulnar length",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "for Type I, elbow flexion is the main reduction maneuver",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "if reduction of radiocapitellar joint is unsuccessful, annular ligament is most common block to reduction",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "immobilization",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Type I **110° of flexion and full supination** to tighten interosseous membrane and relax biceps tendon",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "Type II fulll extension.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Type III full extension and valgus mold",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pinning/nailing of ulna + reduction of radial head ± annular ligament repair/reconstruction",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4015/images/monteggia%20fracture%20imn.jpg",
                  "caption": "Show stacked intramedullary nailing of a Monteggia fracture."
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "Bado Types I-III with",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "**radial head is not stable following reduction**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**ulnar length is not stable (unable to maintain ulnar length)**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**acute Bado Type IV**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "open fractures",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "older patients ≥ 10y if closed reduction is not stable",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "symptomatic individuals (pain, loss of forearm motion, progressive valgus deformity) who had delayed treatment or missed diagnosis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "open reduction of radial head through a lateral approach if needed in chronic (>2-3 weeks old) Monteggia fractures where radial head still retains concave structure",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "annular ligament reconstruction almost never required for acute fractures",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "ORIF similar to adult treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "closed physes",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
