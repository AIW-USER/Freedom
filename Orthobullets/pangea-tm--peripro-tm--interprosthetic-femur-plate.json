        }
      ]
    },
    {
      "text": "Technical specifications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Material: Ti6Al4V ELI (plates and non locking screws) and Cobalt chrome (CoCr alloy locking screws)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Interprosthetic femur plate lengths: 320 – 420mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Variable angle locking within a 30° cone",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Left and right anatomic plate options",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Variable Angle Screw Trajectory",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Variable angle locking screws are compatible in all circular holes across the entire plate to provide options for bicortical fixation around a prosthesis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
