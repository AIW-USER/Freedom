{
  "title": "Hook Nail Deformity",
  "url": "https://www.orthobullets.com/hand/6111/hook-nail-deformity",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nail deformity that occurs caused by volar curving of the nail matrix",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be caused by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tight closure of the fingertip during treatment fo distal tip amputation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "loss of bony support under the nail bed causing volar sloping of the nail bed",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Perionychium",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "nail bed",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "soft tissue beneath the nail includes",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "germinal matrix (proximal)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "produces 90% of the nail",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "**scarring causes absence**",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "sterile matrix (distal)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "keeps nail adherent to nail bed",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "**injury causes deformity**",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "nail fold",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most proximal portion of the perionychium consists of",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "ventral floor - germinal matrix portion of the nail bed",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "dorsal roof",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "eponychium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin proximal to the nail that covers the nail fold",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "paronychium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin on each side of the nail",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "hyponychium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin distal to the nail bed",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patient will report fingertip injury in the form of trauma or infection in the past",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "common symptoms",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "painless",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "complaint is typically cosmetic in nature",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "can become painful if it becomes in-grown",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Careful inspection of the nail to identify any 'hooking' of the nail",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "typically needed to assess the bone stock/deformity of the distal phalanx tuft",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "observation alone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "majority of patients not concerned about cosmesis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "prosthetic replacement",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6111/images/finger_prosthetic..jpg",
                  "caption": "Prosthetic example"
                }
              ],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "improving cosmesis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "painful, in-grown hook nail",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "soft tissue manipulation - shorten bone, do not maintain nail bed length",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "majority of distal tuft maintained",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "when the distal nail bed has been closed/pulled over the distal tuft",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "soft tissue + bony support - lengthen bone, maintain nail bed length",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "lack of distal tuft/bony support",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Soft tissue manipulation**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "shorten bone, perform soft tissue procedure to correct 'hooking' of nail bed that advances soft tissue and reattach to dorsum of bone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**V-Y advancement**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**cross-finger flap**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**full-thickness skin graft**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Bony support procedure to maintain nail length**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "options",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**bone graft to distal tip**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**free, vascularized bone graft from second toe**",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
