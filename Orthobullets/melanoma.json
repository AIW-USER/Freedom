{
  "title": "Melanoma",
  "url": "https://www.orthobullets.com/pathology/6093/melanoma",
  "subtitle": "Updated: Jan 20 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Melanomas are an aggressive skin malignancy of melanocytic origin.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "The condition is typically seen in patients between 50 and 70 years old who present with a pigmented skin lesion with a recent change in shape or size.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy showing melanocytes with marked cellular atypia with invasion into the dermis.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually wide surgical excision.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "slightly more common in men (male:female ratio = 1.2:1)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "age bracket is 50-70yrs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**thumb** > great toe > index finger",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "sun exposed areas",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**sun exposure**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "UV radiation suppresses skin immunity, induces melanocyte cell division, produces free radicals, damages melanocyte DNA",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**family history**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "skin characteristics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "blue eyes, fair hair and complexion, freckling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "xeroderma pigmentosa",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "familial atypical mole or melanoma (FAMM) syndrome",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "multiple benign and dysplastic nevi",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**dysplastic nevi** are a precursor",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "immunesuppression",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
