          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thickness =< 0.75mm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "thickness 0.76 - 1.5mm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "thickness 1.51 - 4mm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "thickness >4mm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
