    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pigmented lesion with **recent change in shape or size**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**nail trauma**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "subungual melanoma renders the nail dystrophic and vulnerable to trauma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "itching or bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "brown-black pigmented lesion, may ulcerate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "extension of brown-black pigment of the nail bed or nail plate to the cuticle and nail folds (Hutchinson sign)",
              "table": null,
              "images": [
                {
