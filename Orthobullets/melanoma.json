    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Melanocytes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "derived from **neural crest** cells",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "found in deepest layer of epidermis, separated from dermis by basement membrane",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "dermis is divided into papillary dermis and reticular dermis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "subcutaneous tissue is deep to reticular dermis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
