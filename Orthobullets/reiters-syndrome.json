{
  "title": "Reiter's Syndrome",
  "url": "https://www.orthobullets.com/basic-science/9049/reiters-syndrome",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Reiter's Syndrome is a seronegative spondyloarthropathy, often caused by an underlying infection, that typically presents with urethritis, ocular conjunctivitis, uveitis, and/or arthritis.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically based on history, symptoms, and ophthalmologic exam.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually antibiotics, symptomatic treatment, and observation.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs most commonly in young man (<40 years of age)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rarely occurs in children, but sometimes appears in adolescents",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be unilateral or bilateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may affect one or multiple joints",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnostic criteria",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**urethritis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**conjunctivitis or uveitis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**arthritis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated infections",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mycoplasma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "yersinia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "salmonella",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "shigella",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "chlamydia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "campylobacter",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be genetic component making certain individuals more susceptible",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "urinary discomfort or pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually appears within days or weeks of infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "inflammation or dryness of the eye",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "joint pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may develop within weeks of initial infection and urinary symptoms",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "other non-specific pain symptoms including",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "heel pain (Achilles tendon pain)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "low back pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nongonococcal urethritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "conjunctivitis or uveitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "skin lesions on palms/soles",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may resemble psoriasis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "genital skin lesions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "low-grade fever",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may identify arthritis of the joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Diagnosis is based primarily on symptoms and presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "HLA-**B27 positive in** 75% of cases",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "CRP elevated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ESR elevated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Urinalysis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may identify signs of active infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "antibiotics, symptomatic treatment, observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "standard of treatment in most cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "direct antibiotics at underlying infection",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "azithromycin and doxycycline indicated for Chlamydia",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**NSAIDs** for pain and inflammation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "systemic steroids",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "severe or recalcitrant cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Aortic insufficiency**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Arrhythmia**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Most cases resolve within weeks, but can last up to months",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Recurrence occurs in up to half of cases over period of several years",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
