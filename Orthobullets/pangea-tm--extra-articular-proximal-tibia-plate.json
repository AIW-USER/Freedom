      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Standard plate lengths: 6-16 hole (133-356mm)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Thickness: 4.3mm",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Left and right anatomic plate options",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Drill bits: Ø3.2mm x 145mm (542050) Ø3.2mm x 215mm (542051) Ø4.3mm x 145mm (542052) Ø4.3mm x 215mm (542053)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
