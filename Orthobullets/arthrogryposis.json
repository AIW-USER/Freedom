                        }
                      ],
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Teratologic Hip Subluxation & Dislocation",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "present in 68-80% of patients with arthrogryposis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "observation alone",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "observe alone while addressing other hand/foot deformities",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "bilateral dislocations (controversial)",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "unilateral dislocation in older child (controversial)",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**Pavlik harness** and rigid abduction brace are unlikely to succeed",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "closed reduction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "**indications**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "**rarely successful**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "medial open reduction with possible femoral shortening",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "done at ≥ 6 months of age",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "**unilateral teratologic dislocation**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "may lead to worse function if it leads to a hip flexion contracture because flexion deformities worsen the patient's gait",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Knee Contractures",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "soft tissue releases (especially hamstrings)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "flexion contracture >30 degrees",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "best performed early (6-9 months of age)",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "perform before hip reduction to assist in maintenance of reduction",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "femoral angulation through guided growth (epiphysiodesis)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "useful in conjunction with osteotomies",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "outcomes",
                      "table": null,
