                            }
                          ]
                        },
                        {
                          "header": false,
                          "cells": [
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "**Finger defomity**",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "PIP arthrodesis",
                                  "table": null,
                                  "images": [],
