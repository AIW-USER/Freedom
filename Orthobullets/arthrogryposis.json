                  "bullets": [
                    {
                      "text": "Type I",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Single localized deformity (e.g., forearm pronation)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type II",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Full expression (absence of shoulder muscles, thin limbs, elbows extended, wrists flexed and ulnarly deviated, intrinsic plus deformity of hands, adducted thumbs, no flexion creases)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Type III",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Full expression (type II) with polydactyly and involvement of non-neuromuscular systems",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "inspection & palpation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**shoulders adducted and internally rotated** (absense of shoulder muscles)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**elbows extended (no flexion creases)**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**wrists flexed and ulnarly deviated**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**hands with intrinsic plus deformity**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "thumb adducted",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**hips flexed, abducted, and externally rotated**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "subluxation or teratologic dislocation common",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "knees extended (classical), most of the time flexed",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "clubfeet",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "normal intelligence, facies, sensation, and viscera",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "range of motion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "severely limited usually involving all four extremities",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Perform at 3-4 months of age",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "neurologic studies",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "enzyme tests",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "muscle biopsies",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Upper Extremity Deformity",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "goals",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "allow optimal function to increase ability to drive an electric chair and use computer assisted devices",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "one elbow in extension for positioning and perianal care and one elbow in flexion for feeding",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "passive manipulation and serial casting",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "first line of treatment",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "soft tissue releases, tendon transfers, osteotomies",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "consider after age 4 to allow independent eating",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "",
                      "table": [
                        {
                          "header": true,
                          "cells": [
                            {
                              "colspan": 3,
                              "bullets": [
