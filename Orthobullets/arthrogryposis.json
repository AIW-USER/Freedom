                                {
                                  "text": "",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "header": false,
                          "cells": [
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "Wrist palmar flexion and ulnar deviation",
                                  "table": null,
                                  "images": [],
                                  "importance": "-1",
                                  "children": []
                                }
                              ]
                            },
                            {
                              "colspan": 0,
                              "bullets": [
                                {
                                  "text": "Flexor carpi ulnaris release, lengthening and/or transfer to wrist extensors; dorsal carpal closing wedge osteotomy",
                                  "table": null,
                                  "images": [],
