      ]
    },
    {
      "text": "Approach",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Incision**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "an anterolateral incision splits the deltoid, exposing the bursa and supraspinatus tendon",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423321/images/7679f96b-6d48-4238-ac7a-764776e3fde8_screenshot_2025-12-18_at_3.38.44_pm.jpg",
                  "caption": "Incision and entry point"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "percutaneous approach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "using an incision on the upper arm, the deltoid muscle is bluntly split to expose the rotator cuff",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "superior transdeltoid approach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "the anterior deltoid is detached from the anterior acromion to expose the rotator cuff",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Entry point**",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "central entry point",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "located at the very top of the humeral head, in the articular surface, in line with humeral axis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/734603a2-001b-4427-930c-bff07ee8b34a_screenshot_2025-12-17_at_5.32.33_pm.jpg",
                      "caption": "Entry Point"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Reaming & nail selection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "guide wire",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "insert 2.5mm ball-tip wire to desired depth",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/a4955733-9391-467a-93c3-0b1062c0fa26_screenshot_2025-12-18_at_3.46.49_pm.jpg",
                      "caption": "Guide Wire insertion"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "reaming (long nails)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "reaming 0.5mm increments",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "use a pusher on the guide wire during reamer extraction to maintain position",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/556ca53a-6d3b-4326-8dcd-520243c17fcb_screenshot_2025-12-18_at_3.52.11_pm.jpg",
                      "caption": "Reaming (long nail only)"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "sizing",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "select nail **1.0–1.5mm smaller** than the last reamer used",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "measure remaining guide wire length with the ruler seated on bone",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/4f2fb03c-129d-49aa-a982-af5a24584f5d_screenshot_2025-12-18_at_3.53.48_pm.jpg",
                      "caption": "Nail selection"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "if between sizes, **round down** to the shorter nail",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "measurement",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "measure remaining guide wire length with the ruler seated on bone",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "if between sizes, **round down** to the shorter nail",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Assembly & insertion",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "assembly",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "hand-tighten nail to adapter; secure with ball-tip screwdriver",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "remove targeting devices before insertion",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "insertion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "advance nail over smooth-tip wire",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "depth",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "countersink the nail below the articular surface",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/8d5b1b0c-90eb-4205-b9c7-b65e1fe78fd2_screenshot_2025-12-18_at_3.54.39_pm.jpg",
                      "caption": "Two circumferential grooves are located on the insertion post of the Nail Adapter at 2mm and 8mm from the driving end of the nail"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "use fluoroscopy to ensure a depth of **≥6mm** if compression is planned",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "completion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "remove guide wire once positioned",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Targeting device setup",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "attachment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "slide targeting device onto adapter (unlocked) until it hits the stop and turn knob to lock",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "validation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "insert tissue protection sleeve/drill sleeve and **3.5mm drill** to confirm alignment",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "repeat for the anterior device",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Proximal locking",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "alignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "rotate nail for tuberosity access",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/83e8e3e8-2f9b-499a-bb13-16383728f6d7_screenshot_2025-12-17_at_5.33.21_pm.jpg",
                      "caption": "Implant Positioning"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "align k-wire (AP plane) with the forearm for **30° retroversion**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "drilling",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "incise skin at the sleeve tip",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "drill the first cortex, then advance (no rotation) to the subchondral bone",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "leave a second drill bit in an adjacent hole to stabilize the arm during screw insertion",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "screw placement",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "measure length via the sleeve",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "use the gray friction lock to hold the sleeve and press to release",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "use imaging to confirm the screw head is seated on bone",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Distal locking",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "short nails (guided)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "static",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "two round holes",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "dynamic",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "oblong hole",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "long nails (guided/distal targeting device)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423321/images/e20f8a59-47ec-4699-89eb-64b2a792cafc_unnamed.jpg",
                  "caption": "Distal Targeter"
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "align c-arm **30° oblique** to the sleeve axis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "adjust the device knob until the sleeve and nail are collinear",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "always start with a standard bicortical screw to prevent \"skiving\"",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "freehand (long nails)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "use the \"perfect circle\" technique under x-ray",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "drill perpendicular to the nail and measure via scale or depth gauge",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/423321/images/eed72fc8-618a-4d95-bdef-acd3cec15f7a_unnamed.jpg",
                      "caption": "Drill perpendicular to the nail and measure via scale or depth gauge"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Apposition (long nails)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "setup",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "insert two distal screws and one proximal screw in the oblong hole",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "execution",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "insert the compression screwdriver through the nail holding screw",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "apply up to **6mm of compression**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "finalize",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "insert a second proximal shaft screw to lock the compression",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Advanced locking screws & end cap",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "advanced locking screws",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "open the near cortex with a counterbore drill",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "push the screw until it engages the nail and rotate counter-clockwise until it \"clicks\" to ensure alignment, then tighten",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "end cap",
              "table": null,
              "images": [],
              "importance": "-1",
