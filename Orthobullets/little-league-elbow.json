{
  "title": "Little League Elbow",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3086/little-league-elbow",
  "subtitle": "Updated: Dec 7 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Little league elbow refers to a continuous spectrum of injuries to the medial side of the elbow seen in adolescent pitchers, which includes: medial epicondyle stress fractures, ulnar collateral ligament (UCL) injuries and flexor-pronator mass strains.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with tenderness over the medial elbow made worse with valgus stress and supplemented with MRI studies.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treament is a trial of rest, activity modification, decrease in innings pitched, and physical therapy.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "younger patients are more likely to have apophysitis or avulsion injuries, rather than UCL sprains",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "consists of 3 potential sites of injury",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**medial epicondyle stress fractures**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**ulnar collateral ligament (UCL)**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**flexor-pronator mass strains**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "due to **repetitive valgus loading with throwing causing repetitive microtrauma to the immature skeleton**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**causes tension overload** of the medial structures",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "Greater than 80 pitches per game",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "More than 8 months of competitive pitching per year",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "Fastball speed > 85mph",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "Continued pitching despite arm fatigue/pain",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "Participating in showcases",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "elbow pain in throwing arm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**decreased throwing speed, accuracy, and distance**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tenderness to palpation about medial elbow",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain with valgus stress",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "instability with valgus stress notes more severe involvement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "should be checked in varying degrees of elbow flexion to extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP/lateral elbow",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may show physeal widening",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/3086/images/me.jpg",
                      "caption": "ME fx"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "may show fragmentation or avulsion of the medial epicondyle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will show increased edema of the medial epicondyle apophysis",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3086/images/mrime.jpg",
                  "caption": "MRI ME"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "can be used to confirm UCL insufficiency",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3086/images/mriucl.jpg",
                  "caption": "MRI UCL"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, activity modifications, PT",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "is the mainstay of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "coach and parent education is critical to **limit number of innings pitched per week**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "use minimal immobilization to maintain elbow ROM",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ORIF of medial epicondyle",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for medial epicondyle avulsion fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "UCL reconstruction",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for UCL disruption and insufficiency",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Pediatric UCL reconstruction**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "similar to adult treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "commonly using **palmaris longus autograft**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Ulnar nerve neuropathy**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Continued pain and instability**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Loss of motion**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Inability to return to same level of play**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
  ],
