      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "kidney stones (\"stones\")",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bone pain (\"bones\")",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "constipations (\"groans\")",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "uncommon cause of secondary hypertension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hypercalcemia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**↑ PTH**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "secondary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hypocalcemia/normocalcemia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**↑ PTH**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "malignancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**↓ PTH**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "↑ alkaline phosphatase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "normal anion gap metabolic acidosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "↓ renal reclamation of bicarbonate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Urinalysis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primary",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hypercalciuria (renal stones)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "↑ cAMP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Radiograph",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cystic bone spaces (\"salt and pepper\")**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "often in the skull",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "loss of phalange bone mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "↑ concavity (see key image of this topic)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "EKG",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**shortened QT**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acute hypercalcemia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**IV fluids**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**Loop diuretics**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptomatic hypercalcemia is treated surgically",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "treat with **parathyroidectomy**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**complications include post-op hypocalcemia**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "manifests as numbness, tingling, and muscle cramps",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**should be treated with IV calcium gluconate**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Peptic ulcer disease**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "↑ gastrin production stimulated by ↑ Ca2+",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Acute pancreatitis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "↑ lipase activity stimulated by ↑ Ca2+",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**CNS dysfunction**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "anxiety, confusion, coma",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "result of metastatic calcification of the brain",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Osteoporosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "bone loss occurs as result of bone resorption due to excess PTH",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "orthopedic surgeons should recognize lab abnormalities as patients may present with fragility fractures",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
