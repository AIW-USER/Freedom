{
  "title": "Types of Bone",
  "url": "https://www.orthobullets.com/basic-science/9001/types-of-bone",
  "subtitle": "Updated: Jul 6 2022",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bone can be classified based on both anatomy and structure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anatomic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**long bones**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**short bones**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**flat bones**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**sesamoid bones**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**irregular bones**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "structure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "macroscopic level",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**cortical**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**cancellous**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "microscopic level",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**lamellar**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**woven bone**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomic classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Long bones**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "e.g. femur, humerus, tibia, forearm bones",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**three anatomic regions in long bones**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "diaphysis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "thick cortical bone surrounding a central canal of cancellous bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "outer region covered by periosteum",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "metaphysis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "thin cortical bone surrounding loose trabecular bone",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "epiphysis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "end of bone that forms the articular surface",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "contains the **physis and the subchondral region under the articular cartilage**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Flat bones**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "e.g. skull, pelvis, scapula",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "varied structure of either purely cortical bone or cortical bone with a thin central trabecular region",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Macroscopic structural classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Cortical**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9001/images/lamellar%20bone.jpg",
              "caption": "Shows lamellar bone structure."
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "80% of skeleton",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "metabolism",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "characterized by **slow turnover rate and high Young's modulus**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "structure",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "made of packed osteons or Haversian systems",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "osteons",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "outer border defined by cement lines",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "vascular canals",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9001/images/lamellar%20bone.jpg",
                          "caption": "Shows lamellar bone structure."
                        }
                      ],
                      "importance": "1",
                      "children": [
                        {
                          "text": "contain arterioles, venules, capillaries, and nerves",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "if oriented along long axis of bone: **Haversian canals**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**if oriented transversely to long axis of bone: Volkmann canals**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "interstitial lamellae",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "the region between osteons",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Cancellous bone** (spongy or trabecular bone)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9001/images/cancellous.jpg",
              "caption": "A histologic image of cancellous bone showing wide spaces between the boney lattice where abundant marrow cells are seen."
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "metabolism",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lower Young's modulus and more elastic",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**high turnover to remodel according to stress across the bone**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "structure",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "boney struts organized into a loose network",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "each strut is approximately 200 micrometers in diameter",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "30-90% of bone is porous and contains bone marrow",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**increased porosity in osteoporosis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Microscopic structural classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Woven bone**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9001/images/woven%20bone.jpg",
              "caption": "A histological image of woven bone."
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "immature or pathologic bone that is woven and random and is **not stress oriented**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "compared to lamellar bone, woven bone has:",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "more osteocytes per unit of volume",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "higher rate of turnover",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**weaker and more flexible than lamellar bone**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Lamellar bone**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9001/images/lamellar%20bone%20histo.jpg",
              "caption": "Histological image of lamellar bone showing well organized osteons."
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "secondary bone created by remodeling woven bone",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "organized and **stress oriented**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**stronger and less flexible than woven bone**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    }
  ],
