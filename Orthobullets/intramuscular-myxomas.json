{
  "title": "Intramuscular Myxomas",
  "url": "https://www.orthobullets.com/pathology/8080/intramuscular-myxomas",
  "subtitle": "Updated: Jan 27 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Intramuscular Myxomas are benign soft tissue tumors that present as slow-growing deeply seated masses confined within the skeletal muscle.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "The condition is typically seen in patients between 40 and 60 years of age who present with a slow-growing mass that may or may not be painful.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with MRI studies showing a homogenous mass with an intramuscular location.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is observation for asymptomatic lesions. Marginal surgical excision is indicated for symptomatic lesions that do not resolve with nonoperative management.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occur in 40 to 60 year olds",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "slight female predilection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly located in the thigh, shoulder, buttock, or upper arm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "likely develop from premature mesenchymal stem cells which differentiate into benign fibroblasts which loose their capacity to secrete collagen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Mazabraud's syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a syndrome characterized by multiple intramuscular myxomas associated with monostotic or polyostotic fibrous dysplasia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**myxoid liposarcomas**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "important to differentiate from a myxoid liposarcomas, which occurs in an intermuscular location",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**slowly growing mass**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "may or may not be painful",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain in soft tissue sarcomas is often based on compression of surrounding tissues like vessels or nerves",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**homogeneous appearance**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8080/images/mri.intramuscular%20myxoma.jpg",
                  "caption": "MRI of intramuscular myxoma"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "**bright T2 signal**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**dark T1 signal**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**intramuscular location**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**intra**muscular location of myxomas is important to differentiate from myxoid liposarcoma, which occurs in an **inter**muscular location",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "characterized by bland and hypo-cellular myxoid stroma",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8080/images/histology%20intramuscular%20myxoma.jpg",
                  "caption": "Histology slide of intramuscular myxoma"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "no cellular atypia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "low nuclear to cytoplasmic ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "no atypical mitosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for asymptomatic lesions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "marginal surgical excision",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**symptomatic** benign low-grade tumors",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "neoadjuvant chemo-radiotherapy is not needed",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "local recurrence and metastasis uncommon",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Local recurrence and metastasis uncommon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
