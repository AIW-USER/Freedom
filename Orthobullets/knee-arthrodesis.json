{
  "title": "Knee Arthrodesis",
  "url": "https://www.orthobullets.com/recon/5035/knee-arthrodesis",
  "subtitle": "Updated: Jun 11 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Knee arthrodesis is the fusion of the tibiofemoral joint most commonly performed as a salvage for failed TKA or complete loss of extensor mechanism.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "The optimal position of the knee during fusion is 5° valgus, 0-10° of external rotation, and 0-15° of flexion.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Absolute contraindications is presence of active infection.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "painful ankylosis after infection or trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neuropathic arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tumor resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "salvage for failed TKA (most common)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "loss of extensor mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Contraindications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "absolute",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "active infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "relative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "bilateral knee arthrodesis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "contralateral leg amputation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "significant bone loss",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ipsilateral hip or ankle DJD",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Optimal Position",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "5-8° valgus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "0-10° of external rotation (match other leg)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "0-15° of flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "some limb shortening advantageous for patient self-care",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Techniques",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**Intramedullary rod fixation**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5035/images/knee.jpg",
                  "caption": "Knee arthrodesis with intramedullary nail"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "can be one long antegrade device or a two part device connected at the knee",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "patella can be left alone or incorporated into arthrodesis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**External fixation**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5035/images/medium_10195_2010_89_fig6_html.jpg",
                  "caption": "Taylor Spatial Frame fixation of a knee arthrodesis"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "must allow compression of arthrodesis site",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "done with unilateral external fixation, Ilizarov, or Taylor Spatial Frame",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Plate fixation**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/5035/images/knee%20fusion.jpg",
                  "caption": "Plate and screw fixation of a knee arthrodesis"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "can be done alone in combination with intramedullary nailing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
