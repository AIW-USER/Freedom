                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8036/images/4B_moved.JPG",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "cavity lining",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "numerous **benign giant cells**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8036/images/Histology%20B%20-%20giant%20cell%20-%20parsons_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "spindle cells",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8036/images/Histology%20C%20-%20giant%20cell%20-%20parsons_moved.png",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "thin strands of woven (new) bone present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
