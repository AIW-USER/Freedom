              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cavernous space**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "blood-filled s**paces without endothelial lining**",
