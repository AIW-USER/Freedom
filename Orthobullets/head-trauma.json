{
  "title": "Head Trauma",
  "url": "https://www.orthobullets.com/trauma/322055/head-trauma",
  "subtitle": "Updated: Jun 25 2021",
  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1.5 million in the US each year",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanisms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "41% in falls",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "14% in motor vehicle accidents",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "11% in assults",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Death after head injury (bimodal distribution)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "10-30 year olds",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "> 70 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "males affected 2x more than females",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Conditions include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**epidural hematoma** (below)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**subdural hematoma** (below)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**subarachnoid hemorrhage** (below)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**intraparenchymal hemorrhage** (below)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "stroke",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "transient ischemic attack",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "concussion (mild traumatic brain injury)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidural Hematoma",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/322055/images/epidural-subdural-1-01.jpg",
              "caption": "epi/sub"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "a traumatic intracranial hemorrhage which can follow a temporal bone skull fracture resulting in tearing of the middle meningeal artery",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "the middle meningeal artery passes through the foramen spinosum of the sphenoid bone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "resultant rapid expansion of the hematoma with high arterial pressure can lead to transtentorial herniation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "prognosis",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**better than for subdurals**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "momentary loss of consciousness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**lucid period** up to 48 hours",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "headache, nausea, hemiparesis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "CN III palsy (if tentorial herniation present)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CT",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**lens-shaped, biconvex** hyperdensity not crossing sutures",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/322055/images/epidural_hematoma.jpg",
                      "caption": "Epi"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medical management of increased intracerebral pressure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**mannitol**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**hyperventilate**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**steroids/ventricular shunt**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evacuate hematoma",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Subdural Hematoma",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/322055/images/epidural-subdural-1-01.jpg",
              "caption": "epi/sub"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "occurs with head trauma + / - coagulopathy",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "results from rupture of **cortical bridging veins**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "especially common in **elderly** and **alchoholics**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "prognosis",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**worse than epidurals** due to concurrent brain damage.",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may begin immediately, or from **days to weeks** after trauma.",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "headache",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "contralateral hemiparesis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "may look like a chronic change, with a past history of a fall",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can be easily confused with dementia.",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "other focal changes.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CT shows **crescent shaped, concave hyperdensity** that can extend across suture line",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322055/images/sdh.jpg",
                  "caption": "SDH"
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "medical management for increased ICP",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**mannitol**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**hyperventilate**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**steroids/ventricular shunt**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evacuation via burr holes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "increased ICP",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "clinical neuro decline",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Subarachnoid Hemorrhage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "commonly caused by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ruputred aneurysm (**Berry Aneurysm**)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/322055/images/berry_aneurysms_of_the_circle_of_willis_-_moises_dominguez.jpg",
                      "caption": "Circle of Willis"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most common site of berry aneurysm development is the anterior communicating artery",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "stroke",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AVM",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "trauma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "blood accumulates between arachnoid and pia mater",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322055/images/sah.jpg",
                  "caption": "SAH"
                }
              ],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**intense headache**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**neck stiffness**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "fever",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "nausea",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "vomiting",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fluctuating level of conciousness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "possible seizure activity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "can resemble meningitis because both cause menigeal irritation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "berry aneurysm presents with severe, sudden headache and **CN III palsy**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**immediate head CT without contrast**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "look for blood in the subarachnoid space",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "if CT is negative and there is no papilledema or focal signs, proceed with an **LP**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "RBC in CSF",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**CSF xanthoma (CSF protein > 150 mg/dL or serum bilirubin > 6 mg/dL)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "once an SAH has been confirmed, move to four vessel angiography",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "medical management to prevent elevation of ICP",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**raise the head of bed**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**limit fluids**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**treat HTN**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**giving calcium channel blockers (nimodipine)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "prevent vasospasms",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**prophylax with anti-seizure medications (phenytoin)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "surgical",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "clipping or coiling of aneurysm or AVM",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Intraparenchymal Haemorrhage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a hemorrhage within the brain parenchyma",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322055/images/iph.jpg",
                  "caption": "IPH"
                }
              ],
              "importance": "2",
              "children": []
            },
            {
              "text": "common bleeding sites include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**basal ganglia**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "internal capsule",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thalamus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cerebellum",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "causes include:",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**HTN**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "leads to **hemorrhage in the basal ganglia, thalamus, cerebellum, and pons**.",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "trauma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AVM",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "coagulopathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tumors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**amyloid angiopathy** in the elderly",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "leads to **lobar hemorrhage**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lethargy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "headache",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "obtundation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "physical exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "focal motor and sensory deficits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
