{
  "title": "Polydactyly of Hand",
  "url": "https://www.orthobullets.com/hand/6079/polydactyly-of-hand",
  "subtitle": "Updated: Apr 30 2023",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Polydactyly of Hand is a congenital malformation of the hand that presents with an extra digit in the hand.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is usually a form of surgical reconstruction depending on the level of duplication and the specific digit involved.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Forms",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**preaxial polydactlyly**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "thumb duplication",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**postaxial polydactlyly**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "small finger duplication",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**central polydactlyly**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Preaxial Polydactyly (Thumb Duplication)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Epidemiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "1 per 1,000 to 10,000 live births",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Type IV most common (43%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Type II second most common (15%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "demographics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "M>F",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "caucasian > African Americans",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritance pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "usually unilateral and sporadic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "except for Type VII which is associated with several syndromes including",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Holt-Oram syndrome",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Fanconi's anemia",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Blackfan-Diamond anemia",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "imperforate anus",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "cleft palate",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "tibial defects",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pollex abductus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "abnormal connection between EPL and FPL tendons, seen in approximately 20% of hypoplastic and duplicated thumbs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "suggested by abduction of affected digit + absence of IP joint crease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
