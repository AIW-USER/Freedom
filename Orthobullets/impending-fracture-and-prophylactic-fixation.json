    {
      "text": "Treatment algorithm",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Obtain tissue diagnosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unless patient has a known primary neoplasm with bone biopsy proven skeletal metastasis, the treating surgeon should biopsy the lesion in question",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "biopsy may require separate incision than the incision used for IM nailing of bone",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "if biopsy suggests primary neoplasm of bone (like sarcoma) that may benefit from neoadjuvant chemo/radiotherapy then close wound and refer to local sarcoma center **prior to surgical stabilization**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "surgical treatment of primary sarcoma will contaminate entire bone with sarcoma and affect ability to perform limb-salvage surgery",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Radiation therapy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "painful lesion with Mirels' score =< 8",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Surgical fixation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "do not proceed with fixation until primary neoplasm of bone has been ruled out with biopsy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "goals of fixation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "maximize ability for immediate mobilization and weight-bearing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "protect the entire bone in setting of systemic or metastatic disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "optimize implant choice in the context of the patient's overall prognosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "type of fixation depends on location of lesion and type of disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "humerus",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8002/images/illus_b.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "proximal humerus lesions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "endoprosthesis",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/8002/images/i_endo.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "diaphysis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "intramedullary nail",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/8002/images/i_nail.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "resection and intercalary spacer",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/8002/images/i_spacer.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "plates and screws (less preferred)",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/8002/images/i_plate.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "distal humerus lesions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "flexible nails",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/8002/images/i_flex_nail.jpg",
                              "caption": ""
                            }
                          ],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "elbow replacement",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "femur",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
