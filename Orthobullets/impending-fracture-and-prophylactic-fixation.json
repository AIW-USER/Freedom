      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mirels' classification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**score > 8 suggests prophylactic fixation**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "size of lesion is expressed as a fraction of the cortical thickness.",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
