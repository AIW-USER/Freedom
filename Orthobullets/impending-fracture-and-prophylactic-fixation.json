                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Postoperative radiation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "following surgery refer the patient to radiation oncology for post-operative radiotherapy treatment to",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decrease pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "slow progression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "treat remaining tumor burden not removed at surgery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
