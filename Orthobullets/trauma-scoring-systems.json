    {
      "text": "Glasgow Coma Scale",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "quantifies severity of head injury by measuring CNS function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "used as",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "initial assessment tool",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "continual re-evaluation of head injured patients",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Variables",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1055/images/gcs.jpg",
              "caption": "GCS"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**Best Motor Response**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "6 - Obeys command",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "5 - Localizes pain",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "4 - Normal withdrawal (flexion)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "3 - Abnormal withdrawal (flexion): decorticate",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "2 - Abnormal withdrawal (extension): decerebrate",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "1 **-** None (flaccid)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Best Verbal Response**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "5 - Oriented",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "4 - Confused conversation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "3 - Inappropriate words",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "2 - Incomprehensible sounds",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "1 **-** None",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Eye Opening**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "4 - Spontaneous",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "3 **-** To speech",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "2 **-** To pain",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "1 - None",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Calculation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "motor response + verbal response + eye opening",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Interpretation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "brain injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "severe <9",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "moderate 9-12",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "minor 13 and above",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pros",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "reliably predicts outcomes for diffuse and focal lesions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Cons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "does not take into account",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "focal or lateralizing signs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diffuse metabolic processes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intoxication",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Revised Trauma Score (RTS)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most widely used prehospital field triage tool",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Variables",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1055/images/revised%20trauma%20score.jpg",
              "caption": "RTS"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**Glasgow Coma Scale (GCS)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "score",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "4: 13-15",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "3: 9-12",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "2: 6-8",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "1: 4-5",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "0: 3",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**systolic blood pressure**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "score",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "4: >90",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "3: 76-89",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "2: 50-75",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "1: 1-49",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "0: 0",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**respiratory rate**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "score",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "4: 10-29",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "3: >30",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "2: 6-9",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "1: 1-5",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "0: 0",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Calculation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Glasgow coma scale score + systolic blood pressure score + respiratory rate score",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Interpretation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lower score indicates higher severity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "RTS <4 proposed for transfer to trauma center",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pros",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful during triage to determine which patients need to be transported to a trauma center",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Cons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can underestimate injury severity in patients injured in one system",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Injury Severity Scale (ISS)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "first scoring system to be based on anatomic criteria",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "defines injury severity for comparative purposes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Variables",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "based on scores of **9 anatomic regions** head face neck thorax abdominal and pelvic contents spine upper extremity lower extremity external",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Calculation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Abbreviated Injury Scale (AIS) grades",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "0 - no injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "1 - minor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "2 - moderate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "3 - severe (not life-threatening)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "4 - severe (life-threatening, survival probable)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "5 - severe (critical, survival uncertain)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "6 - maximal, possibly fatal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "ISS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**ISS = sum of squares** for the highest AIS grades in the **three most severely injured** ISS body regions",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "ISS = A2 + B2 + C2",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "where A, B, C are the AIS scores of the three most severely injured ISS body regions",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "scores range from 1 to 75",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "single score of 6 on any AIS region results in automatic score of 75",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Interpretation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ISS > 15 associated with mortality of 10%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pros",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "integrates anatomic areas of injury in formulating a prediction of outcomes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Cons",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "difficult to calculate during initial evaluation and resuscitation in emergency room",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "difficult to predict outcomes for patients with severe single body area injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "New Injury Severity Score (NISS) overcomes this deficit",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Modifications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Modified Injury Severity Score (MISS)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "similar to ISS but for pediatric trauma",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "categorizes body into 5 areas, instead of 9",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "sum of the squares for the highest injury score grades in the three most severely injured body regions",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**New Injury Severity Score (NISS)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "takes three highest scores regardless of anatomic area",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "more predictive of complications and mortality than ISS",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Mangled Extremity Severity Score (MESS)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "used to predict necessity of amputation after lower extremity trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Variables",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
