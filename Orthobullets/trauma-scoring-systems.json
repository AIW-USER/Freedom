    {
      "text": "Systemic Inflammatory Response Syndrome (SIRS)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a generalized response to trauma characterized by",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "an increase in cytokines",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "an increase in complement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "an increase in hormones",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "a marker for an individual's generalized response to trauma that likely has a genetic predisposition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "associated with conditions such as",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "disseminated intravascular coagulopathy (DIC)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "acute respiratory distress syndrome (ARDS)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "renal failure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "multisystem organ failure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "shock",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Variables",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**heart rate** > 90 beats/min",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**WBC count** < 4000cells/mm³ OR >12,000 cells/mm³",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**respiratory rate** > 20 or PaCO2 < 32mm (4.3kPa)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**temperature** less than 36 degrees or greater than 38 degrees",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Calculation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "each component (heart rate, WBC count, respiratory rate, temperature) is given 1 point if it meets the above criteria",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Interpretation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "score of 2 or more meets criteria for SIRS",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
