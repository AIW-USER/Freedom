{
  "title": "Congenital Popliteal Webbing",
  "url": "https://www.orthobullets.com/pediatrics/422805/congenital-popliteal-webbing",
  "subtitle": "Updated: Jun 14 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Popliteal Webbing, also known as popliteal pterygium syndrome, is an inherited condition that affects the face, limbs, and genitalia.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically by the presence of a characteristic web running behind the knee from ischial tuberosity down to the heel. MRI studies are helpful for operative planning to identify location of neurovascular structures.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is generally surgical resection in the majority of cases.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rare**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "affects 1:300,000",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**affects males and females equally**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritance pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**autosomal dominant**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "can also be sporadic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "associated with advanced paternal age",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "mutations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "results from a mutation in the **IRF6 gene**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "encodes a **transcription factor** that is active in cells that give rise to tissues in the head and face",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "also involved in the development of the skin and genitalia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cleft lip/palate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "syndactyly",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "criptorchidism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bifid scrotum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hypoplasia of the labia majora",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "congnitive delays",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "spina bifida",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Popliteal pterygium",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/422805/images/anatomy.jpg",
              "caption": "anatomy"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**subcutaneous fibrous band**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lies superficially along the free edge of the pterygium",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**sciatic/peroneal nerve**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lies deep to the fibrous band, usually halfway between the free edge and the apex",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**popliteal artery/vein**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "usually lies deep in the popliteal space",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**extensive web running behind the knee from ischial tuberosity down to the heel**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/422805/images/image..jpg",
                  "caption": "clinical image"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/422805/images/imag..jpg",
                  "caption": "clinical image"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "usually bilateral",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "limits lower extremity extension, abduction, and rotation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "syndactyly",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "triangular folds of skin over the nails of the large toes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tissue connecting the upper and lower eyelids (ankyloblepharon) or jaws (syngnathia)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "abnormal genitalia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypoplastic labia majora in females",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cryptorchidism or bifid scrotum in males",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "cleft lip/palate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "knee flexion contracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/422805/images/mri..jpg",
              "caption": "mri"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "operative planning",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**used to assess location of neurovascular structures given wide variation and risk for injury**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "rare",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical resection",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "most cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Surgical resection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "resection or tenotomy of fibrous band",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "z-plasty of overlying skin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "can perform sciatic nerve grafting or tendon lengthening if needed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
