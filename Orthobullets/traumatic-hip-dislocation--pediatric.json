{
  "title": "Traumatic Hip Dislocation - Pediatric",
  "url": "https://www.orthobullets.com/pediatrics/4017/traumatic-hip-dislocation--pediatric",
  "subtitle": "Updated: Mar 25 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Traumatic Hip Dislocations in the pediatric population are usually posterior and may occur due to low energy sports injuries in children less than 10 years of age and high energy trauma in children greater than 10.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with plain radiographs. CT or MRI studies are indicated post-reduction to assess for joint congruity and articular injuries.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is urgent closed reduction under general anesthesia or sedation. Open reduction may be required if there is an intraarticular fragment following reduction.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "80% are **traumatic posterior dislocations**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**more common than hip fracture** in pediatric patients",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "age <10",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may have **low energy sports injury**, or trip and fall",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "age >10",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "mostly high energy (e.g. MVA)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**fractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**acetabular fractures**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "lower incidence of acetabular fractures compared with adults",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "due to cartilaginous acetabulum and ligamentous laxity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "posterior wall fractures are most common",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "femoral head fracture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "femoral neck fracture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "proximal femoral physis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**avascular necrosis of femoral head**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "increased rate if not reduced within 6 hours",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, inability to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior dislocation (most common)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**slight flexion, adduction, and internal rotation** of the limb",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "clinical limb length discrepancy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "if large posterior wall acetabular fracture, can appear shortened without malalignment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "anterior dislocation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**slight flexion, abduction, and external rotation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "inferior dislocation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "External rotation and extension",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "check for **sciatic or gluteal nerve** palsy (rare)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most can be diagnosed on AP pelvis films",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "used to differentiate between anterior vs. posterior dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "scrutinize femoral neck to rule out fracture prior to attempting closed reduction",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "post reduction films",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "necessary to **inspect for joint incongruity or nonconcentric reduction**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4017/images/nonconcentric.jpg",
                          "caption": "This AP pelvis after hip reduction shows a widening of the medial joint space, indicating a non-concentric reduction."
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "loss of congruence of femoral head with acetabulum",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4017/images/hip_disloc_xr_2yo.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4017/images/hip_disloc_xr_3_yo.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "second choice behind MRI for any abnormal findings on **post-reduction** radiographs such as joint widening",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "radiation exposure should be considered",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inspect for joint incongruity or nonconcentric reduction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**osteochondral fragments** can be seen in older children and are easily detected by CT",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4017/images/osteochondral_fragment.jpg",
                      "caption": "An osteochondral fragment causing non-concentric reduction can be appreciated on this axial CT."
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "interposed soft-tissue can be difficult to appreciate on CT scan",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4017/images/ct_labrum_interposed.jpg",
                      "caption": "Interposed soft tissue can be difficult to appreciate on CT scan. Asymmetry is noted in the left hip on this study but the interposed structure is not readily apparent."
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**study of choice** for any abnormal findings on **post-reduction** radiographs such as joint widening",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "decreased radiation exposure than a CT scan",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inspect for **joint incongruity** or nonconcentric reduction",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "osteochondral fragments can be seen in older children and are easily detected by CT",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**interposed soft-tissue** is best evaluated with MRI",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**entrapped labrum** or **capsule** is best evaluated via MRI",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4017/images/subtle_asymmetry.jpg",
                      "caption": "An entrapped labrum can produce subtle asymmetry, as seen in the left hip on this AP pelvis."
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/4017/images/mri_labrum_interposed.jpg",
                      "caption": "MRI was performed 4 days following closed reduction of a left hip dislocation. A and B: Coronal MRI images demonstrated joint effusion and mild incongruity. Interposed labrum and capsule was found at surgery"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction under general anesthesia or sedation within 6 hours",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "urgent attempt at closed reduction is first line treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "most are successful reduced with closed means (85%)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "increased **risk of AVN** if not performed within 6 hours",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open reduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**nonconcentric reduction**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**intra-articular fragment**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**unstable acetabular rim fracture, associated femoral head or neck fracture**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**irreducible by closed means**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "surgical approach is typically performed in **direction of dislocation** (most commonly posterior)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed reduction technique**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "reduction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**adequate anesthesia** or sedation during reduction is mandatory in order **to decrease the risk of displacing an unrecognized fracture of the proximal femoral epiphysis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "reduction **under fluoroscopy** has been recommended to decrease risk of displacement due to possibility of epiphyseolysis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "mainly traction in flexion with gentle rotation maneuver",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "post-reduction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "test hip stability before weaning sedation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "obtain **post-reduction imaging**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "some advocate spica cast or bed rest with abduction splint for 4 weeks in patients < 10 years old or bracing in older children with 6-12 weeks protected weight-bearing on crutches",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Osteonecrosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "reported in **3-15%**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "decreased incidence under age 5",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "less frequent than in adults if there is an absence of an associated femoral neck fracture",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "if present, **thought to be related to delayed reduction**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Coxa magna**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "common radiographic finding (20%)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "not associated with functional limitation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Redislocation**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "rare sequela",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "prolonged immobilization",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "if recurrent and recalcitrant to immobilization: address with capsulorrhaphy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Nerve injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "sciatic or gluteal nerve injury can occur, usually resolves after reduction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Typically associated with good long-term outcomes when treated promptly",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most have mild or no pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most return to high-demand activities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
