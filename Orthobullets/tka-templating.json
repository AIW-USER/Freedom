{
  "title": "TKA Templating",
  "url": "https://www.orthobullets.com/recon/12303/tka-templating",
  "subtitle": "Updated: Jan 19 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the process of anticipating the size and position of implants prior to surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Importance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows prediction of implant sizes needed to be available in operating room",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "provides a reliable starting point in determining size and position of implants",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Accuracy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Manual templating is up to 92-100% accurate +/- one size",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Automatic templating only 51% accurate +/- one size",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obtain appropriate radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "analyze radiographs for appropriate planning",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ensure scale is correct between templates and radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "template femoral component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "template tibial component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Alignement strategies",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "mechanical alignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "TKA Kinematic Alignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Mechanical alignment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Goal",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "achieve neutral mechanical axis with the hip, knee center, and ankle in alignment (0° ± 3°)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Femoral component",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "positioned perpendicular to the mechanical axis of the femur (typically 5-7° of valgus relative to the anatomical axis)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Tibial component",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "positioned perpendicular to the mechanical axis of the tibia (0° varus/valgus)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "aim is too avoid too much accidental varus",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Femoral rotation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "set using either the surgical transepicondylar axis (TEA) or 3° external rotation to the posterior condyles",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Soft tissue considerations",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "templating anticipates need for ligament releases to achieve balanced rectangular gaps in extension and flexion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Kinematic Alignment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Goal",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "restore pre-arthritic joint line anatomy and native knee kinematics",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Femoral component",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "aligned to the cylindrical axis of the posterior femoral condyles (the native flexion-extension axis)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "typically resulting in -0.7° to -1.8° more valgus positioning than Mechanical Alignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Tibial component",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "positioned to match the pre-arthritic tibial joint line",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "typically resulting in more varus alignment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "usually 1.2° to 2.2° more varus than Mechanical Alignment",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Tibial slope",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "restored to match native posterior slope",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "approximately 1.2° more slope than mechanical alignment",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Resection planning",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "equal thickness resections from medial and lateral femoral condyles and tibial plateaus to match cartilage and bone loss",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Soft tissue considerations",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "aims to preserve native ligament balance without releases; fewer soft tissue releases anticipated",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Radiographic Views",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Necessary radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "AP weight-bearing radiograph of the knee",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/ap_weightbearing.jpg",
                  "caption": "AP weight bearing"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "lateral view of the knee",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/lateral.jpg",
                  "caption": "regular lateral"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "most important view for templating",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "patellofemoral joint view",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/sunrise.jpg",
                  "caption": "sunrise"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "not necessary for templating",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Optional radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "full-length hip-to-ankle AP weight-bearing view",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/hip_to_ankle.jpg",
                  "caption": "hip to ankle"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "can be used for templating",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "useful for",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "ruling-out extra-articular deformity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "estimating coronal laxity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "planning bony cuts with respect to mechanical axis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Magnification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "20% is standard",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most templates account for this",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "magnification markers are helpful",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Radiographic Analysis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Step 1",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "assess the mechanical axis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "draw a line of the hip-to-ankle view that shows the overall mechanical axis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/mehcanical_axis.jpg",
                      "caption": "MA"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "neutral mechanical axis should bisect the center of knee",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Step 2",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "estimate magnitude of coronal deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "measure the tibiofemoral angle",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/tibiofemoral_angle.jpg",
                      "caption": "tibiofemoral angle"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Step 3",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "determine the femoral resection angle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "difference between mechanical and anatomic axis of the femur",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/valgus_cut.jpg",
                      "caption": "valgus cut angle"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Step 4",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "determine tibial bone cut",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "perpendicular to mechanical axis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/tibial_cut.jpg",
                      "caption": "tibial cut"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Step 5",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "assess bony defects and osteophytes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "easiest to do on AP weight-bearing view",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Step 6",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "assess tibial slope",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "completed on lateral radiograph",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/correct_slope.jpg",
                      "caption": "tibial slope"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Step 7",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "assess patellar height",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "completed on lateral radiograph",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/patellar_height.jpg",
                      "caption": "patellar height"
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "assess for patella baja",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "this will make exposure more difficult",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Step 8",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "assess patellar shift/tilt",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/patellar_tilt.jpg",
                  "caption": "patellar tilt"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "completed on skyline view of patella",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Template the Femur",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "choose appropriate implant size on lateral radiograph",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/femoral_template_lateral.jpg",
                  "caption": "femoral template lateral"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "restore posterior condylar offset",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/oversized_femur_lateral.jpg",
                      "caption": "oversized femur lateral"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "avoid notching",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "assess this size component on the AP to determine medial/lateral positioning and ensure no overhang",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/femoral_template_ap.jpg",
                  "caption": "femoral template AP"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "if there is significant overhang, may have to consider downsizing",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/oversized_femoral_component.jpg",
                      "caption": "overside femur AP"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pitfalls",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "is to oversize the femoral component",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "consistently less accurate than templating the tibia",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Template the Tibia",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "choose appropriate size based on lateral radiograph",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/tibial_template_lateral.jpg",
                  "caption": "tibial template lateral"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "ensure no overhang",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "aim to match native tibial slope",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "assess this component size on the AP to determine medial/lateral positioning and ensure no overhang",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12303/images/tibial_template_ap.jpg",
                  "caption": "tibial template ap"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "consider downsizing if there is any overhang",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12303/images/oversized_tibial_component.jpg",
                      "caption": "oversized tibia"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pitfalls",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "equally likely to oversize and undersize",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "intraoperative decision making more likely to lead surgeons to downsize the component",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
