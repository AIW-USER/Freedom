{
  "title": "Pediatric Cervical Trauma Overview",
  "url": "https://www.orthobullets.com/spine/2047/pediatric-cervical-trauma-overview",
  "subtitle": "Updated: Sep 19 2024",
  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "pediatric cervical spine injuries are uncommon",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "account for 60% of spinal injuries in the pediatric population",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "33% of pediatric patients with cervical spine injury will present with neurologic deficits",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "at or above C3",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "87% of injuries at C3 or above in children <8 y/o",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "below C3",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "beyond 8 y/o, lower cervical injuries are more common (adult-like injury patterns)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**motor vehicle accidents**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "most common mechanism",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "airbags should be turned off for children who weigh <80 lbs riding in the front passenger seat",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**falls**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "may be cause of injury in toddlers and school-aged patients",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**sports related injuries**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "may be cause of injury in adolescents",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "in patients younger than 8 y/o, the cervical spine is more susceptible to injury due to:",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "larger head size relative to the trunk",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "increased physiologic motion due to:",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "horizontally oriented facet joints",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "increased ligamentous laxity",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "weaker muscles",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "neurologic injury",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "33% of patients will present with neurologic deficits",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "solid organ involvement",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "other organs may be involved in ~40% of patients with spinal trauma",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Normal physiologic motion",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "the pediatric spinal column can stretch up to 5 cm without rupture",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "increased physiologic motion due to:",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "horizontally oriented facet joints",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "increased ligamentous laxity",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "complete exam",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "critical because of a high incidence of associated injuries",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "always suspect cervical spine injuries when patients present with head trauma and facial fractures",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "careful neurologic exam",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "need to document sensation (including sacral sparing), motor function, and presence of reflexes",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "repeat exams are warranted as 20% of patients with spinal fractures may have normal examinations",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "examinations can be difficult in unconscious patients",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "overview",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "pediatric cervical spine imaging interpretation complicated by:",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "hypermobility",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "unique vertebral configurations",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "incomplete ossification",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "presence of apophyses",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "radiographic findings that could be considered abnormal in an adult may be normal in a pediatric patient",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "mandatory trauma radiographs include:",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**AP**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2047/images/apcspine.jpg",
                      "caption": "Nml pediatric Ap c-spine"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**odontoid open mouth**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2047/images/nmlodontoid.jpg",
                      "caption": "Odontoid view pediatric cervical spine"
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**cross-table lateral**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2047/images/lateralcspine.jpg",
                      "caption": "Lateral X-ray of pediatric cervical spine"
                    }
                  ],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "normal findings include:",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "**prevertebral swelling <2/3 of adjacent vertebral width**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "**smooth contour lines** of",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "anterior vertebral bodies",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "posterior vertebral bodies",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "spinolaminar line (inside lamina)",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "tips of spinous processes",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**parallel facet joints**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "**normal retropharyngeal space**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "<6 mm at C2",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "**<22 mm at C6**",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**retrotracheal space <14 mm**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "**atlanto-dens interval <5 mm in children and <3 mm adolescents**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "**absent vertebral body wedging**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "7% of normal children have a wedge shaped C3 vertebral body",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**absence of cervical lordosis**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "loss of cervical lordosis may be found in 14% of normal children",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**C2-3 or C3-4 pseudosubluxation <4 mm**",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "considered normal as long as the posterior laminar line is contiguous",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "additional X-rays (optional)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**oblique**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "can help visualize facet disruption",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**flexion-extension**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "problematic and should only be performed under **physician supervision**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "useful to identify:",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "fractures of upper cervical spine",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**atlantoaxial rotatory subluxation**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "can help to assess the degree of spinal canal compromise",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "useful in obtunded patients or patients with closed head injuries",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "can help to assess the degree of spinal canal compromise",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "initial immobilization",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "all pediatric cervical spine trauma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "on pediatric spine board with head \"cutout\" to compensate for large head size",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "commercial collars often do not fit properly, may need to use sandbags",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "using an adult backboard for pediatric patients creates a dangerous level of cervical flexion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "transporting patients less than 8 y/o requires a spine board with occipital depression or enough thoracic elevation to align the cervical and thoracic segments of the spine",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "pseudosubluxation C2-3",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "collar immobilization",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "some common indications include:",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "stable odontoid fractures",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "atlantoaxial instability",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "acute atlantoaxial rotatory displacement (AARD)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "stable subaxial cervical spine trauma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "rigid collar vs. soft collar (depends on injury, often controversial)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "halo immobilization",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "some common indications include:",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "unstable odontoid fractures",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "occipitocervical instability",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "atlantoaxial instability",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "subacute atlantoaxial rotatory displacement (AARD)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "C1 fractures (Jefferson fractures)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "unstable subaxial cervical spine trauma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "surgical stabilization",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "some common indications:",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "unstable cervical spine with spinal cord injury",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "atlantoaxial instability",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "chronic atlantoaxial rotatory displacement (AARD)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mortality",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "higher mortality rate at C3 or above",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "injuries at C1 lead to a mortality rate of 17%",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "injuries at C4 lead to a mortality rate of ~4%",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Neurologic injury",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "spinal cord injury is more common/lethal in patients younger than 8 y/o",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "prognosis for recovery is better in patients older than 8 y/o",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
