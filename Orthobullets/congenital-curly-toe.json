{
  "title": "Congenital Curly Toe",
  "url": "https://www.orthobullets.com/pediatrics/4081/congenital-curly-toe",
  "subtitle": "Updated: Jun 15 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Curly Toe is a common congenital deformity caused by contracture of the flexor digitorum longus or flexor digitorum brevis that presents with resting flexion of a toe.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with presence of a flexion and varus deformity of the interphalangeal joints, most commonly affecting one of the lateral 3 toes.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is observation as the condition is usually asymptomatic. Surgical soft tissue release is indicated in the presence of a severe toe or nail bed deformity in children typically greater than 3 years old.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence and natural history",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "unknown",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually involves lateral three toes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "usually bilateral",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flexion and varus deformity of the interphalangeal joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "contracture of the flexor digitorum longus (FDL) or flexor digitorum brevis (FDB) is the most common cause",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not indicated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "usually asymptomatic and requires no treatment",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "toe strapping not found to be beneficial",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "soft tissue release e.g. flexor tenotomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "FDL release reserved for severe toe deformity or nail bed deformity in children typically > 3 years old",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "85-90% effective",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "flexor tenotomy is as effective as flexor tendon transfer",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Surgical soft tissue release**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "open tenotomy of both slips of the flexor digitorum brevis (FDB) and FDL tendon",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "open tenotomy of one slip of the flexor digitorum brevis (FDB) tendon only",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "flexor digitorum longus (FDL) transfer to the extensor hood",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
