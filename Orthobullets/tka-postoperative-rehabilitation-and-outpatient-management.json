      "children": [
        {
          "text": "Rehabilitation requires coordinated effort from",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic surgeon",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "physical therapist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "occupational therapist",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "case manager",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nursing staff",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patient and patient's family",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Care can be broken down into different phases including",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**inpatient extended care** (rehab/SNF)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**outpatient care**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Inpatient Extended Care (Rehab)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Earlier discharge to rehab from hospital associated with improved outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Discharge criteria to home similar to those in hospital",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Outpatient Care",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical therapy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "2-3 times per week for at least 2 weeks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "in appropriately selected patients, outpatient physical therapy and self-directed therapy are associated with comparable ROM and rates of manipulation under anesthesia",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**focused on closed-chain concentric exercises**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "gradually advance from crutches to cane to unassisted",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "other modalities include but not limited to",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "aquatic therapy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "buoyancy attenuates gravity/compressive forces in joint; provides resistance",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "balance training",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "proprioception and postural control",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**cryotherapy**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "correlation between local temp and synovial PGE2",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "neuromuscular electrical stimulation (NMES)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may override deficits in muscle activation caused by CNS impairments",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Medications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "preoperative opioid use associated with elevated risk of chronic postoperative opioid use",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Return to activities",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "low-impact closed chain exercises preferred",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "eliptical",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "biking",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "golf",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "slight increase in handicap following TKA and THA",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "drive distance may slightly increase after THA, but reduced following TKA",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "impact activities may decrease longevity of implant",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "running is discouraged",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Driving recommendations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "4 weeks after a right total knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "< 4 weeks after a left total knee",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
