                },
                {
                  "text": "Looser's zones (pseudofractures)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9092/images/pubic%20ramus_moved.jpg",
                      "caption": ""
