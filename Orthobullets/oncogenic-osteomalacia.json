                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Octrotide scans (radiolabeled somatostatin analog)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**gallium-68 DOTA-octreotate PET scan**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9092/images/octreotide_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "indium-111 pentetreotide SPECT/CT",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "to identify primary tumors when TIO is suspected",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "will only identify tumors expressing somatostatin receptors",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
