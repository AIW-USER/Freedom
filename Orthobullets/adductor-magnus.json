    {
      "text": "Innervation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Adductor magnus is innervated by the",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obturator nerve (L2-L4) - adductor part",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tibial nerve (L4-S3) - hamstring part",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Primary nerves of the anterior thigh",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**obturator nerve**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "origin",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "L2-4 of lumbar plexus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "motor",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "medial compartment of thigh",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "adductor longus",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "adductor brevis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "**adductor magnus**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "gracilis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "sensory",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "cutaneous branch innervates skin of medial thigh",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "course",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "descends through psoas and emerges at medial border",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "runs posterior to common iliac arteris to the obturator foamen",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "enters thigh through obturator canal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "splits into anterior and posterior divisions",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "anterior division - descends between adductor longus and brevis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "pierces fascia lata to become the cutaneous branch of obturator nerve",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**posterior division** - descends through obturator externus muscle",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "passes anterior to adductor magnus and gives off branches to supply it",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**tibial nerve**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Adductor magnus is supplied by the",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obturator artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "femoral artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "medial femoral circumflex",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "direct and perforating branches of the deep femoral artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Obturator artery**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "arises from internal iliac artery in pelvis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "bifurcates in medial thigh into two branches",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**anterior branch** - pectineus, obturator externus, **adductor muscles** and gracilis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "posterior branch - deep gluteal muscles",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Femoral artery**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "branches in thigh",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "profunda femoris",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**direct and perforating branches**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**medial femoral circumflex**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "lateral femoral circumflex",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Cross section",
