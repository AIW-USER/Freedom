{
  "title": "Hypoparathyroidism",
  "url": "https://www.orthobullets.com/basic-science/9028/hypoparathyroidism",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hypoparathyroidism is the decreased production of parathyroid hormone by chief cells of the parathyroid gland most commonly caused by a thyroidectomy that results in decreased plasma calcium levels, increased plasma phosphate levels, and decreased active Vitamin D levels.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made by obtaining serum calcium, phosphate, PTH, and 1,25(OH)2 Vitamin D levels.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is aimed at supplementing vitamin D and calcium levels. There is no current hormone replacement therapy available.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Findings",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**decreased plasma calcium levels**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**increased plasma phosphate levels**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**decreased 1,25(OH)2 Vitamin D levels**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Etiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "iatrogenic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**thyroidectomy** most common cause",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decreased PTH levels cause",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decreased urinary excretion of phosphate at kidneys",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**serum phosphate levels increase**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "decreased conversion of inactive form of vitamin D to active form",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**1,25(OH)2-vitamin levels decrease**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
