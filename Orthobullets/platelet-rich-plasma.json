{
  "title": "Platelet-Rich Plasma",
  "url": "https://www.orthobullets.com/basic-science/9090/platelet-rich-plasma",
  "subtitle": "Updated: Sep 24 2024",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Platelet rich plasma (PRP) consists of plasma sample from one's own blood enriched with **autologous platelets**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**controversially used in orthopaedics** for possible stimulation of bone and soft tissue healing",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "preparation technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "PRP is created by centrifugation of blood to separate platelet rich plasma layer from a sample of whole blood",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**calcium chloride** used to initiate platelet activation in the prepared sample of PRP",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "optimal concentration",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "3-5x that of whole blood",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": ">5x inhibits healing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Platelet function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "plays an important role in the inflammatory cascade response after injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**growth factors** released from platelets include",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "PDGF",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "TGF-B",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "VEGF",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "IGF-1",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "EGF (epidermal growth factor)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "CTGF (connective tissue growth factor)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "FGF-2",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Proposed function of PRP",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increase ECM deposition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reduce pro-apoptotic signals",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "minimize joint inflammation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Clinical Application",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**PRP efficacy is controversial** due to small amount of high level studies in literature",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "soft tissue injury healing",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**no consensus** for acute ligamentous, tendon and muscle injuries or chronic tendonopathies",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "osteoarthritis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**no consensus** in evidence, lack of studies with long term followup",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "purportedly downregulates COX-2 and nuclear factor-kappa B (NF-κB) pathways while increasing hyaluronic acid production by synoviocytes, decreasing cartilage degradation, and increasing chondrocyte proliferation in knee OA",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "fracture healing / fusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**limited evidence** for bone formation (some studies show detrimental effects)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "ACL reconstruction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "literature does NOT support PRP for ligamentization/graft maturation, patient reported outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "direct application to patellar and tibial plug donor sites (BPTB) linked to **improved patient-reported outcomes of knee function** and decreased patellar tendon gap",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "meniscal repair",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "no clear evidence to support use in meniscal repair",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "rotator cuff repair",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "no benefit in augmenting RC repair (possible detrimental effects)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "tendon healing",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lateral epicondylar tendinosis (tennis elbow)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "potential **benefit** (improved patient reported outcomes and pain scores)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "midsubstance/insertional Achilles tendinopathy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "current literature does NOT support",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Potential benefits for **BPTB donor sites and tennis elbow**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    }
  ],
