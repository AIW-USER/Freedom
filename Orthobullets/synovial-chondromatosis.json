{
  "title": "Synovial Chondromatosis",
  "url": "https://www.orthobullets.com/pathology/8051/synovial-chondromatosis",
  "subtitle": "Updated: Jan 10 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Synovial Chondromatosis is a proliferative disease of the synovium associated with cartilage metaplasia that results in multiple intra-articular loose bodies.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "The condition usually presents in patients between 30 and 50 years of age with localized joint pain, stiffness, and swelling.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made on radiographs in late disease but MRI studies may be required in early disease to show cartilage nodules throughout the joint space.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually observation for mild symptoms without restriction in motion. Open or arthroscopic synovectomy and loose body resection is indicated for patients with progressive pain, loss of motion, and reduced function.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually affects young adults 30-50 years of age",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "2:1 male to female ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "knee is most common location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated with **cartilage metaplasia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "results in **multiple intra-articular loose bodies**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**ranges from synovial tissue to firm nodules of cartilage**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occasional chromosome 6 abnormalities have been found",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "slow progression of symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain and swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain worse with activity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "mechanical symptoms including stiffness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can occur in the bursa overlying an osteochondroma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decreased range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "can have warmth, erythema, or tenderness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "standard AP/lateral of affected joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "variable depending on stage of disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may show stippled calcification",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "initially cartilage nodules are only visible on MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lobular appearance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "in later stage, signal drop out consistent with calcification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "discrete hyaline cartilage nodules in various stages of calcification and ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "chondrocytes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mild atypia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "binucleate cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "occasional mitoses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "mild symptoms not affecting range of motion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open or **arthroscopic** synovectomy and loose body resection",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "severe symptoms affecting range of motion",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "treatment is symptomatic but may help prevent degenerative joint changes",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
