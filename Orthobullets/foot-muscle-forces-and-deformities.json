    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Equinovarus foot",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common deformity following stroke",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "use AFO and physical therapy for at least 6 months to await for possible neuro recovery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "overactivity of the tibialis anterior, with contributions from the FHL, FDL, and tibialis posterior",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "nonoperative",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "AFO fitting",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "physical therapy",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Phenol or botox injections",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "surgical",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "split anterior tibial tendon transfer (SPLATT)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "flexor hallucis longus tendon transfer to the dorsum of the foot and release of the flexor digitorum longus and brevis tendons at the base of each toe",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "gastrocnemius or achilles lengthening",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Foot drop",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Inability to dorsiflex at the ankle and/or toes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Commonly result from peroneal nerve palsy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Multiple etiologies",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "central nervous system (brain, spinal cord, nerve roots)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "peripheral nervous system (sciatic nerve, peroneal nerve)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "traumatic (knee dislocation, laceration, blunt trauma)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "compressive (compressive mass, deformity correction)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "systemic (diabetic polyneuropathy, mononeuropathy)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Iatrogenic (laceration, casting, positioning, surgical injury)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Mechanical (muscle debridement, tumor excision, etc.)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Presentation - variable depending on location of nerve injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Motor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Loss of ankle/toe dorsiflexion (DPN)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Loss of ankle eversion (SPN)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Sensory",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Loss of first dorsal webspace sensation (DPN)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Loss of lateral leg/dorsal foot sensation (SPN)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Nonoperative",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Observation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "AFO bracing",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Therapy - stretching and supple joints",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Operative",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Acute injury",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "Laceration - repair, grafting, or nerve transfer",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "Chronic injury",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "Tendon transfer",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "Posterior tibial tendon transfer to lateral cuneiform +/- gastroc or Achilles tendon lengthening",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Physical Exam",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Silfverskiöld test**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7054/images/silverskiold_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "improved ankle dorsiflexion with knee flexed = gastrocnemius tightness",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "equivalent ankle dorsiflexion with knee flexion and extension= achilles tightness",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
