            {
              "text": "VariAx 2 Compression Plating System",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "VariAx 2 Distal Ulna Locking Plate System",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
