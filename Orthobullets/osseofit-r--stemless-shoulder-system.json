        },
        {
          "text": "Humeral head implantation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "select the final humeral head implant matching the trial diameter and height",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "use the offset letter or interval determined during trialing",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "place the humeral head into the concave surface of the impactor base on a rigid sterile table",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/0b666885-6990-4ba6-b47e-0793c6388ed2_screenshot_2026-04-27_at_5.11.40_pm.jpg",
                  "caption": "Place the humeral head into the concave surface of the impactor base on a rigid sterile table"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "impact the adapter into the humeral head with the disposable impactor",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "using a mallet, strike the head impactor at least twice until the humeral head is flush with the resection",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/8cb8aa7f-a5ae-4e93-904f-727b2090c9c4_screenshot_2026-04-27_at_5.12.45_pm.jpg",
                  "caption": "Using a mallet, strike the head impactor at least twice until the humeral head is flush with the resection"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "visually confirm uniform seating",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "consider implant subsidence and stemmed fixation if no pre-impaction gap is present",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
