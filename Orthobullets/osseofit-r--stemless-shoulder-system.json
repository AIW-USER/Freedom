{
  "title": "OsseoFit® Stemless Shoulder System",
  "url": "https://www.orthobullets.com/implants/423353/osseofit-r--stemless-shoulder-system",
  "subtitle": "Updated: Apr 28 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "The OsseoFit™ Stemless Shoulder System is indicated for anatomic total shoulder arthroplasty in patients where a bone-sparing, stemless solution is desired to maximize humeral fixation.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "It achieves this through OsseoTi® Porous Metal Technology and a site-specific fin design that creates a stable, biological press-fit while simplifying the surgical workflow with integrated suture holes.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "This system addresses a wide variety of patient anatomies using its versatile inlay and onlay size options.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Indications",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "osteoarthritis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "indicated for anatomic total shoulder applications",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "local/systemic infection, sepsis, and osteomyelitis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "active local or systemic infection",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "sepsis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "osteomyelitis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "inadequate humeral bone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "inadequate bone may lead to poor implant fixation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "large metaphyseal cysts may compromise stemless fixation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "irreparable cuff tear",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "rotator cuff must be functionally reconstructable for anatomic total shoulder arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "revision of any stemmed or stemless prothesis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "contraindicated for revision of any stemmed or stemless prosthesis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "humeral head",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "anatomic neck",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "greater tuberosity",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "lesser tuberosity",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "bicipital groove",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "metaphyseal cancellous bone",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "deltoid forms the lateral border of the deltopectoral interval",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "pectoralis major forms the medial border of the deltopectoral interval",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "subscapularis",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "released and repaired according to surgeon preference",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "glenohumeral capsule is released as needed to expose the humeral head and glenoid",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "coracohumeral ligament",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "contributes to rotator interval constraint",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "superior, middle, and inferior glenohumeral ligaments",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "contribute to anterior stability",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "transverse humeral ligament overlies the bicipital groove",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Nerves",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "axillary nerve courses inferior to the subscapularis and around the lateral humerus",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "must be protected",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "musculocutaneous nerve lies medial to the coracobrachialis and conjoint tendon",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "suprascapular nerve is at risk with aggressive posterior-superior glenoid exposure",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "anterior and posterior humeral circumflex arteries",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "arcuate artery is a terminal branch of the anterior humeral circumflex system",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "suprascapular and circumflex scapular vessels",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Preoperative Planning",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "X-rays",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "A/P, scapular Y and axillary views",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "evaluate bony anatomy, humeral head position, glenoid wear, deformity, and acquired bone loss",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "use x-ray templates to estimate stemless humeral implant size",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "assess whether an anatomic total shoulder reconstruction is appropriate",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "assess bone quality and identify any humeral bone tissues",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "use to assess bone quality and identify humeral bone issues that may affect implant selection",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "evaluate metaphyseal bone stock, cysts, avascular necrosis, deformity, and cortical support",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Approach",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Extended deltopectoral anterior incision with an optional biceps tenodesis beginning immediately above the coracoid process and extending distally and laterally, following deltopectoral groove along the anterior border of the deltoid",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/423353/images/9b16e150-753f-4c61-8a07-d57d4c26428e_screenshot_2026-04-27_at_3.13.13_pm.jpg",
              "caption": "Extended deltopectoral anterior incision"
            }
          ],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Humeral head resection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "expose the humeral head and identify anatomic neck landmarks",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "fixed-angle resection targets 135° inclination and 30° retroversion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "select left- or right-specific extramedullary resection guide",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/aded80c6-f19e-4ff8-a54f-9464d4a3f44f_screenshot_2026-04-27_at_3.15.00_pm.jpg",
                  "caption": "Select left- or right-specific extramedullary resection guide"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "align the guide post with the humeral shaft for fixed-angle resection",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/8501cc9f-95aa-42f7-9e63-7cb08513dbd4_screenshot_2026-04-27_at_3.15.43_pm.jpg",
                  "caption": "Align the guide post with the humeral shaft for fixed-angle resection"
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "align the 30° version rod with the forearm flexed at 90°",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "place pins to define version and inclination and to stabilize the cutting surface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "resect the humeral head through the far side of the humeral head",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "adjust the resection with the guide or calcar planer if needed",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "assess bone quality with direct pressure perpendicular to the resected surface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "consider stemmed humeral fixation if cancellous bone is easily depressed or primary stability is questionable",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Humeral protection during glenoid preparation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "select the humeral resection cover that most closely fits the resected surface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "prepare the glenoid using the appropriate compatible glenoid technique",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "remove the humeral resection cover before humeral sizing",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Humeral sizing",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "place the humeral sizer onto the resection surface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "select the size intended to optimize cancellous bone fixation without violating the inner cortical rim",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/f89996dd-1bfb-4975-ab4e-ecf439e5d0c0_screenshot_2026-04-27_at_3.17.05_pm.jpg",
                  "caption": "Select the size intended to optimize cancellous bone fixation without violating the inner cortical rim"
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "orient the sizer so the bicipital groove bisects the superior and anterior fins",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "insert the central Steinmann pin through the center of the sizer and through the lateral cortex",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/f0e1da45-d2f6-4c47-a27b-fab34635583a_screenshot_2026-04-27_at_5.01.21_pm.jpg",
                  "caption": "Insert the central Steinmann pin through the center of the sizer and through the lateral cortex"
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "avoid deep lateral cortical penetration to reduce risk to the axillary nerve",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "place a lateral humeral retractor as needed to protect the axillary nerve",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "confirm sizing after any additional planing",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Humeral bone preparation (boss reaming)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "ream until the boss reamer bottoms out on the resected surface",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/1a8b9236-788a-4a4f-9b0c-c016b3081b19_screenshot_2026-04-27_at_5.02.19_pm.jpg",
                  "caption": "Ream until the boss reamer bottoms out on the resected surface"
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "ream over the central Steinmann pin with the boss reamer",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "protect the lateral humerus and axillary nerve with a retractor",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "remove the boss reamer while leaving the central Steinmann pin in place",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Humeral bone preparation (broaching)",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "select the reference foot based on implant size",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "select the broach that corresponds to the humeral sizer",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "align the broach superior fin with the superior indicator line on the broach inserter",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "slide the assembly over the central Steinmann pin until the broach contacts the resection surface",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/68cf6fb3-527f-46ba-926f-c8209243da31_screenshot_2026-04-27_at_5.03.23_pm.jpg",
                  "caption": "Slide the assembly over the central Steinmann pin until the broach contacts the resection surface"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "remove the inserter-reference foot assembly and central Steinmann pin",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "perform broach stability testing",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "consider stemmed humeral fixation if the broach is unstable",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Humeral head trialing",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "determine humeral head diameter and height using the humeral head sizing template or the resected humeral head",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/635dfff0-3216-4eac-9e91-8944457c960c_screenshot_2026-04-27_at_5.04.05_pm.jpg",
                  "caption": "Humeral head sizing template"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "seat the head trial assembly into the broach",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "rotate the trial assembly with the hex driver to assess coverage of the resection surface",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/4b161d44-3655-4643-96c4-f7954d594e64_screenshot_2026-04-27_at_5.05.25_pm.jpg",
                  "caption": "Rotate the trial assembly with the hex driver to assess coverage of the resection surface"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "confirm alignment with the anterior and posterior borders of the humeral resection",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "increase offset if the head trial does not cover one side of the resection",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "decrease offset if the head trial overhangs the resected bone",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "reduce the joint and perform trial range of motion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "record the final offset letter or interval on the proximal humerus",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/abda4c9c-df80-4cc7-b868-2805b18c150d_screenshot_2026-04-27_at_5.06.30_pm.jpg",
                  "caption": "Record the final offset letter or interval on the proximal humerus"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "remove and disassemble the head trial assembly",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Implant insertion",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "remove the broach with the slap hammer while maintaining an on-axis trajectory",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "use the same reference foot size used for broach insertion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "select the implant size corresponding to the final broach and operative side",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "slide the reference foot down until it uniformly contacts the resection surface",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "confirm superior fin markings on reference foot, implant, and bone are aligned",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "disengage the inserter-reference foot assembly with axial traction and slight rotational force as needed",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423353/images/29ad3807-d178-4e5d-8bd6-f381dab6080c_screenshot_2026-04-27_at_5.09.31_pm.jpg",
                  "caption": "Disengage the inserter-reference foot assembly with axial traction and slight rotational force as needed"
                }
              ],
