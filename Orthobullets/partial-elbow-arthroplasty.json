{
  "title": "Partial Elbow Arthroplasty",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/12111/partial-elbow-arthroplasty",
  "subtitle": "Updated: May 28 2022",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Forms of elbow arthroplasty",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**total elbow arthroplasty**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**elbow hemiarthroplasty**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "radiocapitellar",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "distal humeral (not FDA approved)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**ulnohumeral distraction & interpositional arthroplasty**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**ulnohumeral debridement arthroplasty**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**radial head excision**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**radial head arthroplasty**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Elbow Hemiarthroplasty",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12111/images/distal_humerus_hemi_xray_copy.jpg",
              "caption": "Radiograph showing distal humeral hemiarthroplasty"
            },
            {
              "src": "https://upload.orthobullets.com/topic/12111/images/rc_arthroplasty_xray.jpg",
              "caption": "Radiograph demonstrating radiocapitellar arthroplasty"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "non-FDA approved hemiarthroplasty of either radiocapitellar joint or distal humerus",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "thought to avoid capitellar degeneration",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Ulnohumeral Arthroplasty (distraction interposition)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "resection followed by contouring of articular surfaces with fascial interposition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "addition of distraction external fixator allows early motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**young active patients** with **posttraumatic arthritis** too young to follow TEA restrictions",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12111/images/ularthr_moved.jpg",
                  "caption": "Lateral radiograph showing arthritics changes in ulnohumeral and radiocapitellar joints"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "ligamentously stable elbow",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "posterior midline skin incision",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Kocher's interval",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "extensor musculature and LUCL complex released",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "if aconeus is to be used, release ulnar attachment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "triceps released from lateral olecranon attachment, ulnar subluxated and elbow flexed to expose distal humerus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone work",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "distal humerus and ulnar surfaces prepared with saw or rongeur to create congruent surface",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "all osteophytes and cartilage removed to expose subchondral bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Soft tissue",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ulnar nerve transposed if symptomatic or prone to subluxate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "capsular release performed to address contractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Instrumentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "local aconeus autograft, tensor fascia autograft or Achilles allograft interposed in joint, sutured into place to cover distal humerus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "graft may be pulled through bone tunnels to address collateral insufficiency",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hinged external fixator placed to distract joint and allow early motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bony resorption, joint subluxation, heterotopic ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "less predictable than TEA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reasonable pain relief achieved in short-term and intermediate-term",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "worse outcomes if residual instability present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Ulnohumeral Debridement Arthroplasty (Outerbridge-Kashiwagi procedure)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "joint space narrowing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "osteophytes (especially in posteromedial olecranon)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthroscopic debridement for mild disease and no prior ulnar nerve transposition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "open debridement for severe disease with inaccessible joint space",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior triceps-splitting approach",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral column approach allows better access to anterior joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Bone work",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "osteophytes and soft tissues removed from olecranon tip and fossa",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12111/images/arthroscopic%20olecranon%20fossa%20debridement_moved.jpg",
                  "caption": "Intra-operative image of arthroscopic debridement of olecranon fossa"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "olecranon fossa opened with burr or trephine to access coronoid fossa",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12111/images/s.jpg",
                  "caption": "Arthroscopic image showing burr hole connecting posterior to anterior elbow compartments during O-K procedure"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "osteotome to resect coronoid osteophytes",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12111/images/ok_xray.jpg",
                  "caption": "Radiograph demonstrating post-operative change following Outerbridge-Kashiwagi procedure"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Soft tissue",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "capsular release may be done in conjunction if contracture present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "generally the ulnar nerve is transposed if pre-operative range of motion less than 90 degrees",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lesser outcomes with failure to release all causative osteophytes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "failure to recognize and address ulnar neuropathy with release or transposition leads to inferior outcomes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "improvements in motion and pain with both arthroscopic and open procedures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Radial Head Excision",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rheumatoid arthritis isolated to the radiocapitellar joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "unreconstructable radial head fracture in ligamentously stable elbow",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "performed using either Kocher or Kaplan's interval",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "supinator muscle fibers and capsule split longitudinally",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone work",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "resect any bony fragments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "resect as little radial neck as possible",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12111/images/radial%20head%20excision_moved.jpg",
                  "caption": "Lateral radiograph showing post-operative changes following radial head excision"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "use fluoroscopy to evaluate stability of elbow and distal radioulnar joint following resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Instrumentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "none",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "progressive degenerative changes in ulnohumeral joint of unclear significance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "radial shortening and wrist pain, likely secondary to unrecognized interosseous injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increase in valgus elbow carrying angle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Radial Head Arthroplasty",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12111/images/depuy-radial-elbow-head.jpg",
              "caption": "Radial head arthroplasty- modular"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "unreconstructable radial head fracture",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "radial head malunion or nonunion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "radiocapitellar arthritis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Approach",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "performed using either Kocher or Kaplan's interval",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "supinator muscle fibers and capsule split longitudinally",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Soft tissue",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "LUCL complex may be taken down for visualization but must be repaired",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone work",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "level of saw cut at the base of radial neck",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "proximal canal broached to anatomic fit",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Instrumentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "size the native radial head if intact",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "trial implant to assess for gapping or overstuffing of joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lesser sigmoid notch can serve as landmark if using fluoroscopy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "assess fit in both extension and flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Complications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "capitellar degeneration due to overstuffing joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
