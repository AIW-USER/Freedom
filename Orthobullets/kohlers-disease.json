{
  "title": "Kohler's Disease",
  "url": "https://www.orthobullets.com/pediatrics/4071/kohlers-disease",
  "subtitle": "Updated: Nov 2 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Kohler's Disease is a rare idiopathic condition caused by avascular necrosis of the navicular bone that occurs in young children and presents with pain on the dorsal and medial surface of the foot.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs of the foot showing sclerosis, fragmentation, and flattening of tarsal navicular bone.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually nonoperative with NSAIDs and a short period of cast immobilization as the condition typically resolves over time.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs in young children (usually age 4-7 yrs)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "four times more common in **boys** than girls",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "80% of cases in boys",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic locations",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be bilateral in up to 25% of cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the blood supply of the **central one third of the navicular is a watershed zone**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "accounts for the susceptibility to avascular necrosis and stress fractures",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "the navicular is the last bone to ossify",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "increases its vulnerability to mechanical compression and injury",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Kohler's disease is often misdiagnosed as infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "There is no widely used classification system for this condition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patient may not have complaints as disease can be asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "characteristically described as midfoot pain with an associated limp",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain in dorsomedial midfoot**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "may have swelling, warmth, and redness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "point tenderness over the navicular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "antalgic limp (may place weight on lateral side of foot)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "characteristic **sclerosis, fragmentation, and flattening** of tarsal navicular",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "most tarsal navicular bones reorganize after disease has run its course",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "some continue to be deformed but almost all of those remain asymptomatic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**NSAIDs**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "short course can be used to decrease symptoms",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**immobilization with short leg walking cast**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "pain with activities",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "studies have shown treatment in a **short leg walking cast will decrease the duration of symptoms**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**radiographs improve at around 6-48 months from onset of symptoms**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**no reports of long-term disability**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgery",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "not indicated for this disease",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Typically a self-limiting condition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Intermittent symptoms for 1-3 years after diagnosis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "typically associated with activity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
