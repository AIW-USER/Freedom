{
  "title": "Juvenile Idiopathic Scoliosis",
  "url": "https://www.orthobullets.com/spine/2054/juvenile-idiopathic-scoliosis",
  "subtitle": "Updated: Mar 30 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Juvenile Idiopathic Scoliosis is a coronal plane spinal deformity which most commonly presents in children between ages 4 and 10.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with full-length standing PA and lateral spine radiographs. MRI studies are indicated in children <10 years old with a curve > 20°.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment can be observation, bracing, or surgical management depending on the skeletal maturity of the patient, magnitude of deformity, and curve progression.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "15% of all idiopathic scoliosis cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "females > males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly appear as a right main thoracic curve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "high incidence of neural axis abnormalities (18-25%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**syringomyelia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "cyst or tubular cavity within spinal cord",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2054/images/Syringomyelia[1]_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "can be seen in a scoliotic curve without rotation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "can manifest as an asymmetric umbilicus reflex",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Arnold-Chiari syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "cerebellar tonsil are elongated and protruding through the opening of the base of the skull and blocking CSF flow)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2054/images/chiari-csd[1]_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**tethered cord**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "dysraphism",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "spinal cord tumor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Early onset scoliosis (EOS)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early-onset scoliosis is a broader category including scoliosis in children <10 years old. It includes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "infantile idiopathic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "juvenile idiopathic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "congenital scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "neurogenic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "syndromic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Marfan's",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Down's syndrome",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "important to determine when deformity was first noticed and any observed progression",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "get perinatal history",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "failure to develop bowel and bladder control by age ~ 3 or 4 may indicate neurologic involvement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patients often referred from school screening where a **7° curve on scoliometer during Adams forward bending test** is considered abnormal",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "7° correlates with 20° coronal plane curve",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "general inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cafe-au-lait spots** (neurofibromatosis)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "leg length inequality",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "shoulder height differences",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "truncal shift",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "waist asymmetry and pelvic tilt",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "foot deformities (**cavovarus)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "can suggest neural axis abnormalities and warrant a MRI",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "spine inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "midline **skin defects**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**hairy patches**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**dimples (**signs of spinal dysraphism)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**nevi**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "rib rotational deformity (rib prominence)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**Adams forward bending test**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2054/images/ais%20standing_moved.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/2054/images/ais%20forward%20bending_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "axial plane deformity indicates structural curve",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "forward bending sitting test",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "can eliminate leg length inequality as cause of scoliosis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "neurologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "motor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "upper and lower extremities exam",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**reflexes**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**abnormal abdominal reflexes**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "associated with the presence of a syrinx",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "gently stroking each abdominal quadrant should cause contraction of the abdominal muscles",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "clonus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Hoffman sign",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Babinski",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "gait analysis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "PA and lateral upright images are used to assess curve severity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "treatment based on Cobb angle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "**Cobb angle**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**> 10°** defined as scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "intra-interobserver error of 3-5°",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "bending radiographs can help determine which curves require fusion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "indicated in **children <10 years old with a curve > 20°**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "even in the absence of neurologic symptoms",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "must rule out **neural axis** abnormalities (e.g., syringomyelia)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "presence of left-sided thoracic curve",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "curves < 20°",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "frequent radiographs to observe for curve progression",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "bracing",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**curves 20 - 50°**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "designed to prevent curve progression, not correct the curve",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "relative contraindication to bracing is thoracic hypokyphosis",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "16-23h/day until skeletal growth completed or surgery indicated",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "non-fusion procedures (growing rods, VEPTR)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**curves > 50°** in small children with significant growth remaining",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "allows continued spinal growth over unfused segments",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "definitive PSF + ASF performed when the child has grown and is closer skeletal maturity",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "traditional growing rods associated with greater curve correction and truncal height gain than VEPTR constructs",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "requires additional lengthening procedures",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "anterior / posterior spinal fusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**curves > 50° in younger patients**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "required in order to prevent **crankshaft phenomenon**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "posterior spinal fusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**curve > 50° in older patients near skeletal maturity**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "remains gold standard for thoracic and double major curves (most cases)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "anterior spinal fusion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**curve > 50°**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "best for thoracolumbar and lumbar cases with a normal sagittal profile",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Crankshaft phenomenon**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**High risk of progression**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "70% require treatment (50% bracing, 50% surgery)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Very few experience spontaneous resolution",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Growing rod constructs found to improve pulmonary function parameters and diaphragmatic motion",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Can be fatal if not treated appropriately",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
