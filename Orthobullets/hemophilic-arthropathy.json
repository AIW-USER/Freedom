                  "children": []
                }
              ]
            },
            {
              "text": "elbow",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "joint arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "epiphyseal overgrowth",
              "table": null,
              "images": [],
