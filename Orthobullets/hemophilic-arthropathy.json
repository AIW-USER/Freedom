{
  "title": "Hemophilic Arthropathy",
  "url": "https://www.orthobullets.com/basic-science/9051/hemophilic-arthropathy",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hemophilic Arthropathy is a systemic arthropathy most commonly caused by hemophilia, and characterized by repetitive hemarthroses and progressive joint disease.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with with recurrent atraumatic hemarthroses in a patient with a bleeding disorder such as hemophilia A, hemophilia B or von Willibrand's disease.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually compressive dressings, analgesics, and bleeding factor administration. Joint arthroplasty is indicated in cases of severe end-stage degenerative joint disease.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "has decreased significantly due to home factor treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "young males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "affects patients between 3-15 years old",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**knee is most commonly affected**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "elbow, ankle, shoulder and spine are also involved",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "persistent minor trauma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "root bleeding disorder may be",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hemophilia A**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "X-linked recessive",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "decrease factor VIII",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**hemophilia B - Christmas disease**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "X-linked recessive",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "decreased factor IX",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**von Willebrand's disease**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "rare cause of joint bleeds",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "more commonly mucosal bleeding",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "autosomal dominant",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "abnormal factor VIII with platelet dysfunction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "synovitis -> cartilage destruction (enzyme based) -> joint deformity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**hemarthrosis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**intramuscular hematoma** (pseudotumor)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may lead to nerve compression",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**femoral nerve palsy** may be caused by iliacus hematomas",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**leg length discrepancy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "due to epiphyseal overgrowth",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**fractures**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "due to generalized osteopenia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "normal healing chronology",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "medical conditions and comorbidities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**HIV**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "prevalence up to 90% in hemophiliacs",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
