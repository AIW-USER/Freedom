              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can be used to identify early degeneratve joint disease",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9051/images/anklet1hemophilia.jpg",
                  "caption": "T1 weighted image"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Ultrasound",
