    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "painful range of motion of joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hemarthrosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the knee is most commonly affected",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**acute**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "presentation will show a **painful** and **tense joint effusion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**subacute**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "occurs **after two prior bleeds**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**chronic**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "presentation will **demonstrate contractures** or **arthritis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**paresthesias**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "in the L4 distribution",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9051/images/dermatomes-netter2_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "caused by **iliacus hematoma** that compress femoral nerve",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
