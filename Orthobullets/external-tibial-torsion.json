{
  "title": "External Tibial Torsion",
  "url": "https://www.orthobullets.com/pediatrics/4121/external-tibial-torsion",
  "subtitle": "Updated: Aug 30 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "External Tibial Torsion is a rare developmental condition in young children caused by abnormal external rotation of the tibia leading to an out-toeing gait.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with a thigh-foot angle measuring greater than 20 degrees of external rotation.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is generally nonoperative with rehab and activity modications for the majority of patients. Surgical management is indicated for children older than 8 years of age with external tibial torsion greater than three standard deviations above the mean ( >40 degrees external).",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "may be bilateral but if unilateral most commonly involves the right lower extremity.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Associated Conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**miserable malalignment syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a condition defined as external tibial torsion with femoral anteversion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**Osgood-Schlatter disease**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**osteochondritis dessicans**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "early degenerative joint disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "an association between external tibial torsion and early degenerative joint disease has been found",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neuromuscular conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be found with neuromuscular conditions such as myelodysplasia and polio",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Normal development",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tibia externally rotates on average 15 degrees during early childhood",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "femoral anteversion decreases on average 25 degrees during this time as well",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**anterior knee pain**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "caused by patellofemoral malalignment",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/4121/images/external%20tibial%20torsion%20example.jpg",
              "caption": "Shows clinical example external tibial torsion."
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "**thigh-foot axis measurement**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "best way to evaluate tibial torsion",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "average during infancy is 5 degrees internal rotation, that slowly derotates",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "average at 8 years of age is 10 degrees external, ranging from -5 to +30 degrees",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "lie patient prone with knee flexed to 90 degrees",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "thigh-foot-axis is the angle subtended by the thigh and the longitudinal axis of the foot",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4121/images/tfa%201.jpg",
                          "caption": "Schematic of the thigh foot axis"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/4121/images/tfa%202.jpg",
                          "caption": "Schematic drawing of thigh foot axis"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**transmalleolar axis measurement**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "another way to evaluate tibial torsion",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "average at infancy is 4-5 degrees internal rotation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "average at adulthood is 23 degrees external (range 0-40 degrees external)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "lie patient supine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "an imaginary line from medial malleolus to lateral malleolus and another imaginary line from medial to lateral femoral condyle is made",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "the axis is the angle made at the intersection of these two lines",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "this helps to determine the direction and extent of tibial torsion present",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Usually none required.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, rehab, and activity modifications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first line of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "supramalleolar derotational osteotomy or proximal tibial derotational osteotomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "surgery is reserved for children older than 8 years of age with external tibial torsion greater than three standard deviations above the mean ( >40 degrees external).",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "more likely to require surgery than internal tibial torsion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Supramalleolar rotational osteotomy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "osteotomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "supramalleolar rotational osteotomy is most commonly performed",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fibula is obliquely osteotomized if the deformity is severe",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "proximal tibial osteotomies are avoided secondary to higher risk factors associated with this procedure",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "plate fixation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cross pin fixation or plate fixation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "intramedullary fixation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "IM fixation with rotational osteotomy is reserved for skeletally mature adolescents",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Since the leg externally rotates with physical growth, this deformity usually worsens during late childhood and early adolescence.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
