  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Aneurysm is defined as a permanent dilation of an artery with a 50% increase in its normal diameter",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "< 1 per 100,000",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "traumatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "true aneurysm",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**blunt trauma** weakens the arterial wall causing it to dilate",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "appear more **uniform in shape**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "false aneurysm (e.g. pseudoaneurysm)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**pentrating trauma** to arterial wall replaced by organized hematoma and fibrous wall",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "appear more **'sac-like' in shape**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "non-traumatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inflammatory",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "atherosclerotic",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recent blunt or penetrating hand trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "slow-growing painful mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "many be sensory disturbance due to compression of adjacent digital nerve",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physican exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "palpable mass",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12282/images/nfig001.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "may be pulsatile in ~ 50% of cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may occur in any of the 5 digits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most common in thumb > index > ring finger",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
