{
  "title": "TKA Vascular Injury and Bleeding",
  "url": "https://www.orthobullets.com/recon/12751/tka-vascular-injury-and-bleeding",
  "subtitle": "Updated: Aug 19 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Vascular Injury and Bleeding, is a rare, potentially devastating, complication that may occur during TKA most commonly as a result of direct injury to the popliteal artery.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made with visual inspection for significant arterial bleeding and a change in patient hemodynamic status.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is recognization of the injured vessel, hemostasis and vascular consultation.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "0.017%-0.2%",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "revision surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "peripheral vascular disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Causes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "direct laceration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sharp dissection in posterior compartment of knee",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "blunt trauma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "posterior retractor placement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "stay medial with single-prong retractor (do not go lateral to PCL)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12751/images/medial_retractor.jpg",
                          "caption": "medial retractor placement"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/12751/images/lateral_retractor.jpg",
                          "caption": "lateral retractor placement"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "popliteal artery is a **lateral** structure at the level of the joint line",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "do not insert retractor more >1cm into posterior soft tissues",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**hyperflexion** displaces artery and can avoid injury",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12751/images/hyperflexion_retractor.jpg",
                          "caption": "hyperflexion"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "excessive **hyperextension brings the artery closer to the knee**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12751/images/hyperextension_artery.jpg",
                      "caption": "knee in hyper extension"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "increases likelihood of injury during bone cuts",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "thrombosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Popliteal artery",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12751/images/popliteal_artery_angiogram.jpg",
              "caption": "Labeled anatomic structures"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "origin before knee",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "a **continuation of the superficial femoral artery**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "transition is at **hiatus of adductor magnus muscle**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**anchored by insertion of adductor magnus** as enters region of posterior knee",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "course in posterior knee",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "relation to anatomy structures of knee",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "lies posterior to the **posterior horn of the lateral horn of the lateral meniscus**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "lies directly behind posterior capsule",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "branches within knee",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "at supracondylar ridge gives branches the provide blood supply to the knee",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "above knee joint branches include",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**medial and lateral sural arteries**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**cutaneous branch**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**middle genicular artery**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "at level of knee joint branches include",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**medial genicular artery**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "**lateral genicular artery**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "exit of knee",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "anchor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "as artery exits knee it is anchored by **soleus tendon** (originates form medial aspect of tibial plateau)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "distal branches",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "branches into anterior and posterior tibial arteries at distal **popliteus muscles**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Intraoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "brisk bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "loss of pulses",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Postoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ischemia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sensory changes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "loss of distal pulses",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "skin mottling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Intraoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "angiogram",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12751/images/popliteal_artery_injury_during_tka.jpg",
                  "caption": "Intraoperative angiogram"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "if brisk intraoperative bleeding and/or loss of pulses than obtain immediate vascular surgery consultation.",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "vascular consultation will dictate intraoperative imaging, including angiogram.",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Postoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CT angiogram",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12751/images/ct_angiogram_tka.jpg",
                  "caption": "CT angiogram s/p TKA"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "signs of ischemia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "loss of pulses",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "skin mottling",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "sensory changes",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Immediate vascular surgery consultation",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "whenever a concern for injury to the popliteal artery",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "modalities may include",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**nonoperative and observation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "closed suction drainage is associated with increased incidence of transfusion",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**stent placement**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12751/images/stent_for_pseudoaneurysm..jpg",
                      "caption": "s/p stent placement"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**bypass**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**endarterectomy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**prophylactic fasciotomy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may be indicated to avoid reperfusion compartment syndrome",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
