{
  "title": "Psoriatic Arthritis",
  "url": "https://www.orthobullets.com/basic-science/9050/psoriatic-arthritis",
  "subtitle": "Updated: Sep 23 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Psoriatic Arthritis is a seronegative spondyloarthropathy that presents with DIP predominant arthritis of the hands, rash with silvery plaques, uveitis, and dysmorphic nails.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made based on a thorough evaluation of serum labs, clinical features, and radiographic findings.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is usually medical management with a variety of options including corticosteroids, disease modifying anti-rheumatic drugs, and biological drugs.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "affect up to 5-20% of patients with psoriasis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "equally affects men and women",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "5 patterns of arthritis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "asymmetric oligo/monoarticular arthritis affecting DIPJ, PIPJ, MCPJ",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "DIP-predominant arthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "arthritis mutilans",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "symmetric, RF-negative polyarthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "psoriatic spondyloarthropathy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**HLAB27** found in 50%",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthritic symptoms in hands",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**rash with silvery plaques** over extensor surfaces (elbows, knees)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9050/images/skinrash.jpg",
                  "caption": "Psoriasis rash picture"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "typically precede joint involvement by several years (80-85% of time)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**hands**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**dactylitis** (sausage digit)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9050/images/dactylitis.jpg",
                      "caption": "Clinical picture showing sausage digits."
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/9050/images/img_0245.jpg",
                      "caption": "Isolated sausage digit."
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**onychodystrophy** (nail pitting)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9050/images/pitting.jpg",
                      "caption": "Nail pitting."
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "onycholysis (lifting of nail plate starting distally)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "arthritis mutilans",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "opera glass hands (la main en lorgnette)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "excess skin from the shortening of the phalanx bones becomes folded transversely, as if retracted into one another like opera glasses",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "chronic uveitis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "entheses such as achilles tendonitis, posterior tibial tendonitis, and plantar fasciitis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hands",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "distal phalanx acrolysis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9050/images/img_0247.jpg",
                      "caption": "DIP acrolysis image."
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/9050/images/img_0246.jpg",
                      "caption": "DIP acrolysis lateral image."
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "DIP arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "classic finding is \"pencil-in-cup\" deformity",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9050/images/pencilcup.jpg",
                          "caption": "Radiograph of pencil in cup deformity."
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "simultaneous destruction of the head of the middle phalanx and expansion of the base of the distal phalanx",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "different than DJD by presence of centripetal erosions which cause joint space widening",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "small joint erosions or fusions (PIP, MCP, and wrist commonly involved)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fluffy periostitis (caused by periosteal ossification)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "acroosteolysis (resorption of the distal phalanx tuft)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "flail digits",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "spine in axial disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "sacroiliitis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "syndesmophytes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "paravertebral ossification",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "destructive discovertebral lesions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**HLAB27** found in 50%",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "RA and ANA tests are usually negative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "NSAIDS, methotrexate, sulfasalazine, cyclosporine,TNF-alpha inhibitors",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "mainstay of treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "similar to RA",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "digit fusion vs resection arthroplasty",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "advanced joint disease",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
