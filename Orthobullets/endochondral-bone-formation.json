{
  "title": "Endochondral Bone Formation",
  "url": "https://www.orthobullets.com/basic-science/9006/endochondral-bone-formation",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Endochondral bone formation occurs in",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**longitudinal physeal growth**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**embryonic long bone formation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**non-rigid fracture healing (secondary healing)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Cell biology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "endochondral bone formation occurs with a **cartilage model**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "chondrocytes produce cartilage which is absorbed by osteoclasts",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "osteoblasts lay down bone on cartilaginous framework (bone replaces cartilage, cartilage is not converted to bone)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "forms primary trabecular bone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**bone deposition occurs on metaphyseal side**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**type X collagen** associated with endochondral ossification",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Molecular biology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "chondrocytes play a critical role in endochondral bone formation throughout the formation of the cartilage intermediate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "transcription factors involved in regulation of chondrocytes include",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**Sox-9**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "considered a major regulator of chondrogenesis, regulates several cartilage-specific genes during endochondral ossification, including collagen types II, IV, and XI and aggrecan",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**PTHrP**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**delays differentiation of chondrocytes in the zone of hypertrophy**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "variables that affect growth across the physis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Hueter-Volkmann Law**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**compression** across the growth plate **slows longitudinal growth**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "tension accelerates longitudinal growth",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**perichondrial artery**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9006/images/perichondral%20artery_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "You have not been heard from for a while. major source of nutrition to physis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Longitudinal Physeal Growth",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Longitudinal physeal growth**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Reserve zone (B)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9006/images/a6ee7329-5055-4483-a50b-8225e0052622_histology_of_zones_moved..jpg",
                          "caption": "Histology of the physis"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Cells store lipids, glycogen, and proteoglycan aggregates for later growth and matrix production",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Low oxygen tension",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Gaucher's**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Diastrophic dysplasia",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Kneist",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Pseudoachondroplasia",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Proliferative zone (C)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9006/images/a6ee7329-5055-4483-a50b-8225e0052622_histology_of_zones_moved..jpg",
                          "caption": "Histology of the physis"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Proliferation of chondrocytes with longitudinal growth and stacking of chondrocytes.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Increased oxygen tension in surroundings inhibits calcification",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Achondroplasia**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Gigantism**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "MHE",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Hypertrophic zone (D)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9006/images/a6ee7329-5055-4483-a50b-8225e0052622_histology_of_zones_moved..jpg",
                          "caption": "Histology of the physis"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Zone of chondrocyte maturation, **chondrocyte hypertrophy**, and chondrocyte calcification.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Three phases occur in the hypertrophic zone",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Maturation zone:** preparation of matrix for calcification, chondrocyte growth",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Degenerative zone:** further preparation of matrix for calcification, further chondrocyte growth in size (5x)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Provisional calcification zone:** chondrocyte death allows calcium release, allowing calcification of matrix",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Chondrocyte maturation regulated by local growth factors (parathyroid related peptides, expression regulated by Indian hedgehog gene)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Type X collagen** produced by hypertrophic chondrocytes important for mineralization",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**SCFE (not renal)**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Rickets (provisional calcification zone)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Enchondromas",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Mucopolysacharide disease",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Schmids",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Fractures most commonly occur through **zone of provisional calcification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Primary spongiosa (E)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9006/images/a6ee7329-5055-4483-a50b-8225e0052622_histology_of_zones_moved..jpg",
                          "caption": "Histology of the physis"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(metaphysis)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9006/images/a6ee7329-5055-4483-a50b-8225e0052622_histology_of_zones_moved..jpg",
                          "caption": "Histology of the physis"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Vascular invasion and resorption of transverse septa.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Osteoblasts align on cartilage bars produced by physeal expansion.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Primary spongiosa mineralized to form woven bone and then remodels to become secondary spongiosa (below)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Metaphyseal \"corner fracture\" in child abuse**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Scurvy",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Secondary spongiosa (metaphysis)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Internal remodeling (removal of cartilage bars, replacement of fiber bone with lamellar bone)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "External remodeling (funnelization)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Renal SCFE",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Physis Periphery**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Groove of Ranvier",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "During the first year of life, the zone spreads over the adjacent metaphysis to form a fibrous circumferential ring bridging from the epiphysis to the diaphysis.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "This **ring increases the mechanical strength of the physis and is responsible for appositional bone growths**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "Supplies chondrocytes to the periphery",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Osteochondroma",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Perichondrial fibrous ring of La Croix",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Dense fibrous tissue that is the primary limiting membrane that anchors and supports the **physis through peripheral stability**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9006/images/ring_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Perichondrial artery",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Major source of nutrition to physis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Embryonic Long Bone Formation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows growth in width and length",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "formed from mesenchymal anlage around **6th week in utero**.",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Steps of formation include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cartilage model forms**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "mesenchymal cells differentiate into chondroblasts (cartilage cells) that form the hyaline cartilaginous skeletal precursor of the bones",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**vascularization**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "vascular buds invade the mesenchymal model",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**primary ossification centers form**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "(at ~ 8 weeks) osteoprogenitor cells migrate through vascular buds and differentiate into osteoblasts forming the primary ossification centers. Marrow is simultaneously formed by resorption of central portion of the cartilage anlage by myeloid precursor cells that migrate in through the vascular buds.",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**cartilage model continues to grow**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "Cartilage and chondrocytes continue to grow at ends of the bone while medullary cavity expands and remodels.",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**secondary ossification centers form**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "develop at bone ends and lead to epiphyseal ossification center (growth plate)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Non-Rigid Fracture Healing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of bone formation is similar to physeal endochondral ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Cell biology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "soft callus is the cartilage intermediate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bone replaces callus via same chondrocyte proliferation, **chondrocyte hypertrophy**, and finally chondrocyte calcification",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Examples include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**casting and bracing**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**intramedullary nailing**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "allows for motion at the fracture site, which promotes bone formation both directly (intramembranous ossification) and through a cartilage intermediate (endochondral ossification)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
