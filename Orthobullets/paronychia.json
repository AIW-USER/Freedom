{
  "title": "Paronychia",
  "url": "https://www.orthobullets.com/hand/6101/paronychia",
  "subtitle": "Updated: May 15 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Paronychias are soft tissue infections of the proximal or lateral nail fold.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis involves careful clinical examination assessing for erythema and fluctuance around the nail with discoloration/hypertrophic changes of the nail.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment involves warm soaks and oral antibiotics and if fluctuance is present, debridement and partial/complete nail removal is warranted.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**most common** hand infection (one third of all hand infections)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually in **children**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "more common in **women** (3:1)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly involve the **thumb**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "organism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "acute infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "adults - usually caused by **Staphylococcus aureus**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "children - usually mixed oropharyngeal flora",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "diabetics - mixed bacterial infection",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chronic infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Candida albicans** (more common in diabetics)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "often unresponsive to antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acute paronychia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**minor trauma** from nail biting, thumb sucking, manicure",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Chronic paronychia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occupations with prolonged exposure to **water and irritant acid/alkali chemicals**e.g. dishwashers, florists, gardeners, housekeepers, swimmers, bartenders",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "risk factors for chronic paronychia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**diabetes**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "psoriasis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "steroids",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "retroviral drugs (indinavir and lamivudine)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**indinavir** is most common cause of paronychia in HIV positive patients",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**resolves** when medication is discontinued",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nail organ",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6101/images/anatomy_nail.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "adds to stability of finger tip by acting as counterforce to finger pulp",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "thermoregulation (glomus bodies of nail bed and nail matrix)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "allows \"extended precision grip\" (using opposed thumbnail and index fingernail to pluck out a splinter)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Nail plate",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "made of keratin, grows at 3mm/month, faster in summer",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fingernails grow faster than toenails (fingernails take 3-6 months to regrow, and toenails take 12-18 months)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "growing part is under proximal eponychium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Perionychium",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6101/images/anatomy_nail.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "comprises hyponychium, eponychium and paronychium",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute paronychia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pain and",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "nail fold tenderness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "erythema",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "chronic paronychia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**recurrent** bouts of low-grade inflammation (less severe than acute paronychia)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acute paronychia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fluctuance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**nail plate discoloration (green** discoloration suggests Pseudomonas)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6101/images/pseudomonas.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "chronic paronychia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "nail plate **hypertrophy** (fungal infection)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "nail fold blunting and **retraction** after repeated bouts of inflammation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "prominent **transverse ridges** on nail plate",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Herpetic whitlow",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Felon",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Onychomycosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Psoriasis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Glomus tumor",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Mucous cyst",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Acute paronychia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "warm soaks, oral antibiotics and avoidance of nail biting",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "swelling only, but no fluctuance",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "medications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "augmentin or clindamycin",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "I&D with partial or total nail bed removal followed by oral abx",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "fluctuance (indicates abscess collection)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "nail bed mobility (indicates tracking under the nail)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "follow with **oral antibiotic**s and **routine dressing change**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Chronic paronychia",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "warm soaks, avoidance of finger sucking, topical antifungals",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "first line of treatment",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "medications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "miconazole is commonly used",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "marsupialization (excision of dorsal eponychium down to level of germinal matrix**)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "severe cases that fail nonoperative treatment",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "combine with **nail plate removal**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "leave to **heal by secondary intention**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**I&D with partial or total nail bed removal**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "may be done in emergency room",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "incision into sulcus between lateral nail plate and lateral nail fold",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "preserve eponychial fold by placing materials (removed nail) between skin and nail bed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "if abscess extends proximally over eponychium (eponychia), a separate counterincision is needed over the eponychium",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "obtain gram stain and culture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Eponychia**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "spread into eponychium",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Runaround infection**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "involvement of both lateral nail folds",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Felon**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "spread volarward to pulp space",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "I&D of finger pulp is necessary",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Flexor tenosynovitis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "volar spread into flexor sheath",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Subungual abscess** (\"floating nail\")",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "nail plate removal is necessary",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
