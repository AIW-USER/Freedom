{
  "title": "Hip Arthrodesis",
  "url": "https://www.orthobullets.com/recon/5034/hip-arthrodesis",
  "subtitle": "Updated: Jan 30 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hip Arthrodesis is the fusion of the hip joint most commonly performed for management of advanced hip arthritis in a select group of patients.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Common indications include salvage option for a failed THA, and for young active laborers with painful unilateral ankylosis after infection or trauma.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Ideal hip fusion position is 20-35° of flexion, 0-5° adduction, 5-10° external rotation.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Biomechanics",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**reduces efficiency of gait by ~50%**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "increases pelvic rotation of contralateral hip",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "increases stress at adjacent joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Biochemistry",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increases oxygen consumption",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "requires **30% more energy expenditure** for ambulation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Primary hip arthrodesis",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**salvage for failed THA** (most common)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**young active laborers** with painful **unilateral** ankylosis after infection or trauma",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "neuropathic arthropathy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tumor resection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "contraindications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**active infection**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "severe **limb-length discrepancy** greater than 2.0 cm.",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "bilateral hip arthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "adjacent joint degenerative changes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "lumbar spine",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "contralateral hip",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "ipsilateral knee",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "severe osteoporosis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "degenerative changes in lumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**contralateral THA**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "increased failure rate (40%) in THA when there is a contralateral hip arthrodesis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Conversion of fusion to THA",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "severely debilitating back pain (most common)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "severe ipsilateral knee pain with instability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "severe contralateral hip pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "techniques",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "obtain preoperative **EMG to assess the status of the gluteus medius**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "a constrained acetabular component is required if the abductor complex is nonfunctional",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "clinical outcome is dependent on abductor complex function",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the presence of hip abductor complex weakness or dysfunction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "requires prolonged rehabilitation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "severe lurching gait may develop",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Hip arthrodesis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "goals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "achieve apposition of arthrodesis surfaces, obtain rigid internal fixation and promote early mobilization",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "optimal position",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "optimal positioning for function and limited effect on adjacent joints",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**20-35° of flexion**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**0°-5° adduction**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**5-10° external rotation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "avoid abduction as it creates pelvic obliquity and increased back pain",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lateral approach with trochanteric osteotomy is preferred",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5034/images/lateral%20approach.jpg",
                      "caption": "Lateral approach for hip fusion"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "important to preserve the abductor complex",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "avoid injury to the superior gluteal nerve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "anterior approach to hip is also popular",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/5034/images/anteriorhipplating.jpg",
                      "caption": "Anterior plating"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cobra plating",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Low back pain**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "can be improved by taking down hip arthrodesis, but overall improvement **depends on abductor function**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "**Ipsilateral knee degeneration and laxity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "related to altered biomechanical forces on adjacent joints",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "**Contralateral hip degeneration**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Provides pain relief and reasonable clinical results in most patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Success may be limited by **adjacent joint degeneration in 60%** of patients",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "lumbar spine, ipsilateral knee or contralateral hip may be affected",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "low back pain and arthritic ipsilateral knee pain are the most common symptoms",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "may start within 25 years of hip arthrodesis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
