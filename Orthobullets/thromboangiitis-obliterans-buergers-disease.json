{
  "title": "Thromboangiitis Obliterans (Buerger's disease)",
  "url": "https://www.orthobullets.com/hand/6099/thromboangiitis-obliterans-buergers-disease",
  "subtitle": "Updated: May 22 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A nonatherosclerotic, segmental, **inflammatory disease in the small and medium-sized vessels** of the hands and feet",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "occurs predominantly in smokers",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "12.6 per 100,000 in the United States",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3:1 male: female ratio",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "typically affects patients **< 45 years old**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**smoking**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "chewing tobacco",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inflammation and clotting of the small vessels of hands and feet",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6099/images/tao.jpg",
                  "caption": "TAO key image"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "3 phases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "acute",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6099/images/acute.jpg",
                      "caption": "acute"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "thrombus including neutrophils and giant cells **occludes the vessel lumen while sparing the wall**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "subacute",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6099/images/subacute.jpg",
                      "caption": "subacute phase"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "progressive organization of the thrombus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chronic",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6099/images/chronic.jpg",
                      "caption": "chronic phase of tao"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "inflammation has subsided",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "organized thrombus and vascular fibrosis remain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**intermittent claudication** of feet, legs, hands or arms",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "numbness and/or tingling in the limbs",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "late disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "symptoms of critical limb ischemia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**rest pain**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ulcerations",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6099/images/ulcerations.jpg",
                      "caption": "ulcerations"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "large, erythematous, superficial blood vessels",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**necrotic distal digits** in hands and feet",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6099/images/necrotic%20fingers.jpg",
                      "caption": "necrotic fingers"
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decreased temperature in hands and feet",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "diminished or absent pulses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "sensory findings in up to 70% of patients",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**positive Allen test** in young smoker with digital ischemia is suggestive of disease",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Arteriography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "useful for ruling-out other conditions that may mimic Buerger's disease",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**\"corkscrew\" vessels**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6099/images/corkscrew.jpg",
                      "caption": "arteriogram"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "collateral circulation giving a \"spider leg\" appearance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "used to exclude alternative diagnoses",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Echocardiogram",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "used to **exclude proximal source of emboli**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "smoking cessation and symptomatic treatment",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "all patients with Buerger's disease that use tobacco",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "smoking cessation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "patient education",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "pharmacotherapy",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "smoking cessation groups",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "symptomatic treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "avoid exposure to cold",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "gentle exercise",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "daily aspirin",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "vasodilators",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "smoking cessation is the **only treatment known to decrease the risk of future amputation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical sympathectomy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**indications (controversial)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**refractory pain and digital ischemia**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**technique**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**cut nerves to the affected areas**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "amputation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "gangrene",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "non-healing ulcers",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "refractory pain",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Depends on smoking status",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**94% who quit smoking avoid amputation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "43% chance of amputation within 8 years if smoking is continued",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
