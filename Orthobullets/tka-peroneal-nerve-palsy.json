{
  "title": "TKA Peroneal Nerve Palsy",
  "url": "https://www.orthobullets.com/recon/12305/tka-peroneal-nerve-palsy",
  "subtitle": "Updated: Jun 11 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Peroneal Nerve Palsy is a rare, potentially devastating, complication of TKA that is most commonly seen following correction of a knee with a valgus and/or flexion deformity.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically post-op with decreased sensation in peroneal nerve distribution with weakness if dorsiflexion of the ankle.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is placing the knee in flexion immediately post-operatively. Observation and AFO in the presence of foot drop are recommended to monitor for recovery of the nerve.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Neurologic Injury (Peroneal nerve)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "incidence",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "0.3%-2%",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "risk factors",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "preoperative **valgus** and/or **flexion deformity**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "tourniquet time > 120 min",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "postoperative use of epidural analgesia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "aberrant retractor placement",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "preoperative diagnosis of neuropathy (centrally or peripherally)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "prognosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "50% or more improve in time with no additional treatment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common peroneal nerve lying on lateral head of gastrocnemius at the level of the joint line",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "distance from posterolateral corner of tibia to peroneal nerve is 9mm-15mm at this level",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "EMG",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "obtain after 3 months if no improvement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "remove dressing and place knee in flexed position",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "initial postoperative management in all cases noted in the immediate postoperative period",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "ankle-foot orthosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "complete foot drop",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "late nerve decompression or muscle transfer",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "no recovery after 3 months",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
