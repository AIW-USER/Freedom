{
  "title": "Skin Grafting",
  "url": "https://www.orthobullets.com/hand/6064/skin-grafting",
  "subtitle": "Updated: May 17 2021",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A skin graft is an avascular dermal tissue used to cover well-perfused dermal defects.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "The graft is most commonly autologous and can be either split-thickness or full-thickness.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Skin grafting donor sites are commonly the anterolateral thigh for STSG and the upper extremity for FTSG.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Types",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "partial-thickness dermal tissue (STSG)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "full-thickness dermal tissue (FTSG)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Donor site",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly autologous",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Goals of treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cover** deep structures",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**create a barrier** to bacteria,",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**restore dynamic function** of the limb",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**prevent joint contractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "well-perfused wound beds over muscle or subcutaneous tissue",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Contraindications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wounds with exposed bone, tendon, nerves, or blood vessels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Split-Thickness Skin Graft (STSG)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**well-perfused wound beds** where contraction will not lead to decreased joint mobility or scar contracture",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "preferred for **dorsal hand** wounds",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Donor sites",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**anterolateral thigh** is the most common",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Graft elements",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "variable based on thickness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "always contain keratinocytes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "thicker grafts contain more dermis with hair follicles and sweat glands and contract less",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nutrition is obtained by diffusion from the wound bed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Technique",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "thin (0.005-0.012 in)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intermediate (0.012-0.018 in)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thick (0.018-0.030 in)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "meshed v. nonmeshed grafts",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "meshed grafts provide a greater surface area",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "meshed grafts have a lower incidence of hematoma formation and infection leading to better \"take\" of the graft",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Full-Thickness Skin Grafts",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6064/images/full-thickness%20skin%20graft.jpg",
              "caption": "Full-thickness skin graft to finger"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**volar hand wounds and fingertips**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Donor sites",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "proximal **forearm**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**medial upper arm**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "**hypothenar eminence** of hand",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Graft elements",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contain **full thickness of dermis and epidermis,** containing hair follicles and sweat glands",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**subcutaneous fat is not included** because it decreases vascular ingrowth and survival",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "nutrition is obtained by diffusion from the wound bed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Technique",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "apply under gentle tension over a well-perfused wound bed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "place multiple tie-over sutures to decrease shear forces",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "dressing should include a medicated gauze and moist cotton",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "leave dressing in place for 5 to 7 days",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pros",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "better reinnveration and sensation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "less scar contracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "more durable and wear resistant to shear stresses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "cons",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hematomas and seromas can still cause failure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "revascularization takes 2 to 3 days",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Other Skin Grafts",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Allograft",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "used as a **temporary measure** to prepare the wound bed for autograft",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Xenograft",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "used occasionally as **biologic dressings**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
