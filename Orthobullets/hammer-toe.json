    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain on dorsal surface with shoe wear",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flexion deformity of the PIP joint of the lesser toes with extension of DIP",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ankle plantar flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "flexible deformity corrects",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "fixed deformity does not correct with ankle plantar flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "**push up test**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**flexible deformity is reducible** with dorsal directed pressure on the plantar aspect of the involved metatarsal",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "effect of over active extrinsics is removed",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Imaging not required in diagnosis and treatment",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shoes with high toe boxes, foam or silicone gel sleeves",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "pain and or corns on dorsal PIP",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "flexor tendon (FDL) to EDL tendon transfer",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "flexible deformity that has failed nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "PIP resection arthroplasty +/- tenotomy and tendon transfers",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "rigid deformity that has failed nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "Girdlestone procedure with FDL to EDL transfer",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "MTP involvement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "similar to claw toe treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "EDL Z-lengthening or tenotomy",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "mild MTP hyperextension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "EDL Z-lengthening and dorsal capsular release",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "ndications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "moderate to severe MTP hyperextension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "PIPJ arthrodesis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "an option in rigid deformity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "high nonunion rate",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "K-wire fixation is the most cost effective implant",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "treat concurrent forefoot deformities",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "correct hallux valgus (for 2nd hammer toe)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "arthrodesis for severe hallux valgus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "amputation for severe hallux valgus touching 3rd toe",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "indications",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "elderly",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "poor health",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            },
                            {
                              "text": "does not want hallux reconstruction",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Resection arthroplasty +/- tenotomy and tendon transfers**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "resection of head and neck of proximal phalanx to create a fibrous joint",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "+/- FDL to EDL transfer",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "hold in place with K-wire for 2-3 weeks",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "postoperative",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "protect for additional 3 weeks with taping of PIP in extension",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Girdlestone procedure (flexor to extensor transfer)**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "extensor tendon lengthening with Z plasty",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "perform MTP capsule release",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "+/- metatarsal shortening with oblique osteotomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "FDL to EDL transfer",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    }
