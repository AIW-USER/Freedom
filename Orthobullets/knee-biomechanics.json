{
  "title": "Knee Biomechanics",
  "url": "https://www.orthobullets.com/recon/9065/knee-biomechanics",
  "subtitle": "Updated: Jun 10 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "The knee is comprised of 2 joints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tibiofemoral joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patellofemoral joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Patellofemoral Articulation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "transmits tensile forces generated by the quadriceps to the patellar tendon",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9065/images/patellofemoral%20joint.jpg",
                  "caption": "Patellofemoral joint illustration"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "increases lever arm of the extensor mechanism",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "patellectomy decreases extension force by 30%",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patellofemoral joint reaction force",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9065/images/free_body.jpg",
                  "caption": "JRF PF joint"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "up to 7x body weight with squatting",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9065/images/jr%20forec.jpg",
                      "caption": "JRF about patellofemoral chart"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "2-3x body weight when descending stairs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Motion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "\"sliding\" articulation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patella moves 7cm caudally during full flexion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9065/images/42-e289a4c9d4.jpg",
                      "caption": "motion of patellofemoral joint"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "maximum contact between femur and patella is at 45 degrees of flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "passive restraints to lateral subluxation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial patellofemoral ligament",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9065/images/mpfl.jpg",
                      "caption": "MPFL"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "primary passive restraint to lateral translation in 20 degrees of flexion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "60% of total restraining force",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial patellomeniscal ligament",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "13% of total restraining force",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medial retinaculum",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9065/images/lateral%20retinaculum.jpg",
                      "caption": "lateral retinaculum"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "10% of total restraining force",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "dynamic restraint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "quadriceps muscles",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "Q angle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "definition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "line drawn from the anterior superior iliac spine --> middle of patella --> tibial tuberosity",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9065/images/qangle.jpg",
                          "caption": "q-angle"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "normal Q angle",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "in extension",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "males",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "13 degrees",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "females",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "18 degrees",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "in flexion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "8 degrees",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "pathology",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Tibiofemoral Articulation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "transmission of body weight from femur to tibia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tibiofemoral joint reaction force",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "3x body weight with walking",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "4x body weight with climbing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Motion in sagittal plane",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "3 degrees of hyperextension to 155 degrees of flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "thigh-calf contact is usually the limiting factor to full flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "normal gait requires ROM from 0 to 70 degrees",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Rotation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "instant center of rotation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "definition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "point at which the joint surfaces are in direct contact",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "relevance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "posterior rollback",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "during normal motion, the contact point between the femur and the medial tibial plateau is relatively stationary (the medial pivot point of the knee).",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/9065/images/rollback.jpg",
                              "caption": "key image"
                            }
                          ],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "the contact point between the femur and the lateral tibial plateau moves progressively posterior as the knee flexes",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        },
                        {
                          "text": "allows for increased knee flexion by avoiding impingement",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "\"screw home\" mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "definition",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "tibial externally rotates 5 degrees in the last 15 degrees of extension",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "cause",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "medial tibial plateau articular surface is longer than lateral tibial plateau",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9065/images/screw3.jpg",
                          "caption": "screw home mechanism"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "relevance",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "\"locks\" knee decreasing the work performed by the quadriceps while standing",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "varus stress",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lateral collateral ligament",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9065/images/lateral%20collateral%20ligament.jpg",
                      "caption": "LCL"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "valgus stress",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "superficial portion of medial collateral ligament",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9065/images/mcl.jpg",
                      "caption": "MCL"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "anterior translation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anterior cruciate ligament",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "attachments",
                      "table": null,
                      "images": [],
