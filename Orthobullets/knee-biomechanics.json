                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "also plays a roll in axial rotation",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
