                          "children": [
                            {
                              "text": "tight in extension",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "function",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
