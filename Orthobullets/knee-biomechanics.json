                      "children": [
                        {
                          "text": "origin",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "semicircular area on the posteromedial aspect of lateral femoral condyle",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/9065/images/acl.jpg",
                                  "caption": "ACL insertion illustration-femoral"
                                }
                              ],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "insertion",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "just anterior to and between the intercondylar eminences of the tibia",
                              "table": null,
                              "images": [
                                {
                                  "src": "https://upload.orthobullets.com/topic/9065/images/acl%20-%20copy.jpg",
                                  "caption": "ACL insertion illustration-tibial"
                                }
                              ],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "components",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "anteromedial bundle",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "tight in flexion",
                              "table": null,
                              "images": [
