        },
        {
          "text": "Normal variants",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "fabella",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322085/images/fabella.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "sesamoid bone in lateral head of gastrocnemius",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "best seen on lateral view",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "cyamella",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322086/images/cyamella.jpg",
                  "caption": "AP view of the knee demonstrating cyamella"
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "sesamoid bone in popliteus tendon",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "usually present in lateral aspect of distal femur in popliteal groove",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "best seen on AP view",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "cortical desmoid",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/322085/images/cortical_desmoid.jpg",
                  "caption": ""
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "cortical lucency in posteromedial aspect of distal femur",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "represents origin of medial head of gastrocnemius + insertion of adductor magnus",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "seen in adolescents (10-15 yo)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "bipartite/tripartite patella",
