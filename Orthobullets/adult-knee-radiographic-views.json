    {
      "text": "Lateral view",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Positioning",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patient",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "rolled lateral (mediolateral) = lateral decubitus on ipsilateral side + knee flexed 20-30°",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/322085/images/gw400h300-1.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "horizontal ray (lateromedial) = supine + knee extended",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/322085/images/cross_table_lateral.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "beam",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "aim 2.5cm distal to medial epicondyle",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "tilt 5-7° cephalad (if rolled lateral)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "patella fracture = horizontal ray view to avoid displacement",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "patella alta/baja = requires knee in 30° flexion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "trochlear dysplasia",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "OA",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "joint effusion",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Critique",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/322085/images/lateral.jpg",
              "caption": ""
            }
          ],
          "importance": "-1",
          "children": [
            {
              "text": "visualization of suprapatellar fat pad = via knee flexion < 30°",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "appropriate IR/ER",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "superimposition of posterior aspect of femoral condyles",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "superimposition of fibular head + tibia",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "open patellofemoral joint",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "no visualization of adductor tubercle",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "appropriate cephalad angulation = open tibiofemoral joint",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
