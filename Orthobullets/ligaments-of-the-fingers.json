{
  "title": "Ligaments of the Fingers",
  "url": "https://www.orthobullets.com/hand/6003/ligaments-of-the-fingers",
  "subtitle": "Updated: May 23 2021",
  "sections": [
    {
      "text": "Extensor Ligaments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lumbrical tendon passes volar to transverse metacarpal ligament",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6003/images/ORL%20strauch%20300_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": []
        },
        {
          "text": "Interossei tendon passes dorsal to transverse metacarpal ligament",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6003/images/ORL%20strauch%20300_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Retinacular Ligaments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6003/images/obretlig..jpg",
              "caption": "retinac lig"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "retain and position common extensor mechanism during PIP and DIP flexion",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "similar to sagittal band function",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic Components",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**oblique band (oblique retinacular ligament of Landsmeer)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "links motion of DIP and PIP",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "lies volar to axis of PIP, but dorsal to axis of DIP",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "anatomy",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "origin: from lateral volar aspect of proximal phalanx,",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "insertion: to lateral terminal extensor dorsally (crosses collateral ligaments)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "biomechanics",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "with PIP flexion, ligament relaxes to allow DIP flexion",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "with PIP extension, ligament tights to facilitate DIP extension",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "pathology",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "contracture causes volar displacement of lateral bands and a resulting Boutonniere Deformity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "reconstruction of oblique retinacular ligament used to treat swan neck deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "if ORL is **tight**,",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "resting finger position is DIP extended, PIP flexed",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "unable to flex DIP if PIP is extended",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "able to flex DIP only after PIP is flexed",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "contrast this with intrinsic tightness, where there is decreased PIP flexion when the MCP is extended, and improved PIP flexion when the MCP is flexed",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            },
                            {
                              "text": "contrast this with extrinsic tightnes (extensor tendon tightness), where there is increased PIP flexion when MCP is extended, and decreased PIP flexion when MCP is flexed",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "**transverse band**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "with PIP flexion, pull lateral bands volarly over PIP",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "with PIP extension, prevents excessive dorsal translation of lateral bands",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "anatomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "origin: from edge of flexor tendon sheath at PIP",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "insertion: lateral border of conjointed lateral bands",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "pathology",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "attenuation leads to dorsal translation of lateral bands and a resulting swan neck deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "contracture (with attenuation of triangular ligament) leads to volar translation of lateral bands and resulting boutonniere deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Digital Cutaneous Ligaments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tether skin to deeper layers of fascia and bone to prevent excessive mobility of skin and improve grip",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stabilize the digital neurovascular bundle with finger flexion and extension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic Components",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Cleland's ligaments (remember \"C\" for ceiling)**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/Cleland's_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/gray-cle.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/cleland-grayson.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "dorsal to digital nerves",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "not involved in Dupuytren's disease",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**Grayson's ligament** (remember \"G\" for ground)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/cleland-grayson.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/gray-cle.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/Cleland's_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "volar to digital nerves",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Expansion Hood",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "works to extend PIP and DIP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic Components",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**central slip**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/Extensor%20hood_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "functions to extend PIP",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inserts into base of middle phalanx",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**lateral band**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/Extensor%20hood_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "functions to extend DIP",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inserts into distal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "lumbricals, extensor indicis, dorsal and palmar interossei insert on lateral band",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "MCP Joint Collateral Ligaments",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stabilize MCP joint during motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "MCP joint \"cam\" nature leads to inconstant arc of motion because of joint asymmetry",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6003/images/snoopyhead.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "caused by \"snoopy head\" configuration of metacarpal head",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "collaterals looser in extension, tighten during increasing flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "as MP joint flexes, proximal phalanx moves further away from metacarpal head, tightening all the ligaments",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic Components",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "radial collateral ligaments (RCL) are more horizontal than ulnar collateral ligaments (UCL)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "RCL and UCL have 2 parts each: proper and accessory ligaments",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/collat%20lig..jpg",
                  "caption": "Red, dorsal - proper ligament Green, volar - accessory ligament"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**accessory ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "fan shaped",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "more volar",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "tight in extension",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "attachment",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "from metacarpal head at center of rotation",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "to palmar plate and deep transverse metacarpal ligament",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "clinical test",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "adduction/abduction stress in extension",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**proper ligament**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "cord like",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "more dorsal",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "tight in 30 degrees of flexion",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "attachment",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "from posterior tubercle of metacarpal head (dorsal to mid axis)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "to proximal phalanx base",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "clinical test",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "adduction/abduction stress in 30 degrees flexion to isolate proper ligaments",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Deep Transverse Metacarpal Ligament",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prevents metacarpal heads from splaying apart (abduction)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "allows some dorsal-volar translation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic components",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "connects 2nd to 5th metacarpal heads together at volar plate of the MP joint",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/deep%20transverse%20met.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/deep%20tvs%20met.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Natatory Ligament (Superficial Transverse Metacarpal Ligament)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "resists abduction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic components",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most superficial MP joint ligament",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/natatory.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/natatory%20ligament2.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "origin: from distal to the MP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "insertion: proximal phalanx of all 5 fingers (runs in the web space)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Sagittal Bands",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "keep extensor mechanism tracking in the midline during flexion of MP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6003/images/obretlig..jpg",
              "caption": "retinac lig"
            },
            {
              "src": "https://upload.orthobullets.com/topic/6003/images/sag%20band..jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "origin: palmar plate",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "insertion: extensor mechanism (curves around radial and ulnar side of MP joint)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Triangular ligament",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "counteracts pull of oblique retinacular ligament, preventing lateral subluxation of the common extensor mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "triangular in shape",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/trianglig..jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "located on dorsal side of extensor mechanism, distal to PIP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Pathology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contracture leads to swan neck deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Volar Plate",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prevent hyperextension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thickening of joint capsule volar to the MP joint",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6003/images/deep%20tvs%20met.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "in the thumb, sesamoid bones are located here",
