{
  "title": "Infantile Idiopathic Scoliosis",
  "url": "https://www.orthobullets.com/spine/2055/infantile-idiopathic-scoliosis",
  "subtitle": "Updated: Jan 26 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Infantile Idiopathic Scoliosis is a coronal plane spinal deformity which most commonly presents in children ages 3 years or less.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with full-length PA and lateral spine radiographs. MRI studies are indicated to rule out syrinx, tumor, or tethered cord.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment can be observation, bracing, or surgical management depending on the skeletal maturity of the patient, magnitude of deformity, and curve progression.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "4% of idiopathic scoliosis cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**males > females**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually **left thoracic**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "family history",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may adversely affect growth of alveoli and normal development of the thoracic cage",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "autosomal dominant with variable penetrance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**plagiocephaly** (skull flattening)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2055/images/plagiocephaly.jpg",
                  "caption": "Illustration demonstrating plagiocephaly"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "**congenital defects**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**neural axis abnormalities**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "22% of patients with curves > 20° will be affected",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "80% of these patients will need neurosurgical involvement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**thoracic insufficiency syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "characterized by decreased thoracic growth and lung volume",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "leads to pulmonary hypertension and cor pulmonale",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "pulmonary function impairment associated with curves > 60°",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cardiopulmonary issues associated with curves > 90°",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the T1-L5 spinal segment grows fastest in the 1st five years of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the height of the thoracic spine increases by 2 times between birth and skeletal maturity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Infantile Idiopathic Scoliosis consists of",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**resolving type**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**progressive type**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Early onst scoliosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "early-onset scoliosis is a broader category that includes scoliosis in children < 10 years. It includes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "infantile idiopathic scoliosis (this topic)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "juvenile idiopathic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "congenital scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "neurogenic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "syndromic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "Marfan's",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Down's syndrome",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "age deformity was first noticed and any observed progression",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "perinatal history",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "developmental milestones",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Presentation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most present with deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "excessive drooling may reflect neurologic condition",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cafe-au-lait spots** (neurofibromatosis)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2055/images/cafe_au_lait_spots_axillary_freckling.jpg",
                      "caption": "Photograph of a patient with cafe-au-lait spots and axillary freckling."
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**patches of hair**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**dimpling over the spinal region**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "dimpling outside of the gluteal fold is usually benign",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**nevi** or other tumors may be indicative of spinal dysraphism",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**plagiocephaly** (skull flattening)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "neurologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "motor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "document developmental milestones",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "evaluate for **cavovarus feet**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "upper and lower extremities exam",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**reflexes**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**abnormal abdominal reflexes**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "associated with the presence of a syrinx",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "clonus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Hoffman sign",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Babinski",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "gait analysis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**recommended views**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**standing PA and lateral**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**supine in infants unable to stand (will make curve appear less severe)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "look for congenital vertebral defects",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "measurements",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**cobb angle**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "> 20 degrees associated with progression",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**rib phase**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2055/images/rib_phase.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "technique",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "convex rib head position with respect to the apical vertebrae",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "findings",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "phase 1 - no rib overlap",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "phase 2 - rib overlap with the apical vertebrae",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "**high risk for curve progression**",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**RVAD** (rib vertebrae angle difference, Mehta angle)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "technique",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2055/images/rvad4.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/2055/images/rvad2.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "measure angle between the endplate and rib (line between midpoint of rib head and neck)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "RVAD = difference of 2 rib-vertebral angles",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "findings",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/2055/images/overlap.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": [
                        {
                          "text": "> 20° is linked to high rate of progression",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "< 20° is associated with spontaneous recovery",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**obtain MRI of spine first** to rule out",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "tether",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cyst",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tumor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**syrinx** (20% incidence)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation alone (most resolve spontaneously)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**Cobb angle < 30°**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**RVAD < 20°**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "90% will resolve spontaneously",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "serial Mehta casting (derotational) or thoracolumbosacral orthosis (TLSO)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2055/images/mheta_cast_patient_on_table.jpg",
                  "caption": "Illustration and photograph showing application of a Mehta Cast"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2055/images/mheta_cast_molding.jpg",
                  "caption": "Applicaiton and molding of a Mehta Cast."
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**flexible curves**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**Cobb angle > 30°**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**RVAD > 20°**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**phase 2 rib-vertebrae relationship (rib-vertebral overlap)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "mechanism",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "functions to straighten the spine in young patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "in older patients it serves as an adjunctive measure prior to definitive treatment",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "bracing",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "incompletely corrected curves after Mehta casting",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "late presenting cases where the spine is still flexible",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "growing rod construct (dual rod or VEPTR)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Cobb > 50 to 60 degrees",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "failed Mehta casting or bracing",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "fusion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "delay until as close to skeletal maturity as possible",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "fusion before age 10 years results in pulmonary compromise",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
