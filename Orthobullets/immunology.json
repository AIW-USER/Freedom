{
  "title": "Immunology",
  "url": "https://www.orthobullets.com/basic-science/9077/immunology",
  "subtitle": "Updated: Mar 23 2022",
  "sections": [
    {
      "text": "Types of Immune Responses",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Types of Immune Responses",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "**innate response**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "not specific to a type of immunological challenge",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "represents the immune response which does not have memory",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "e.g., anatomic barriers (skin), inflammation, complement cascade",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "recognizes structures common to multiple microbes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "found in nearly all forms of life",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "cells include",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "natural killer cells",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "mast cells",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "eosinophils",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "basophils",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "phagocytic cells (macrophages, neutrophils, and dendritic cells)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**acquired response**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "portion of immune response which has memory",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "occurs in a pathogen and antigen specific mechanism",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "requires antigen processing and presentation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "performed by antigen presentation cells (APC)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "B cells and dendritic cells are two examples of APCs",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "the APC breaks down the protein antigen in a multitude of enzymatic reactions and presents key peptide sequences via the major histocompatibility complex (MHC) receptors",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "once presented on the surface of the APC, the T-cell receptor recognizes the MHC/antigen complex prior to T-cell activation",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "cells include",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "CD8+ T lymphocytes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "T helper cells",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "delta gamma T cells",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "B cells and plasma cells",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Types of Immunological Reactions",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Type I: Immediate anaphylactic reaction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated with allergy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "mediated by IgE antibody activation of mast cells and basophils",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Type II: Antibody dependent (aka cytotoxic) hypersensitivity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mediated by IgG and IgM antibodies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Type III: Immune complex (antigen bound to antibody) deposition type of hypersensitivity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mediated by IgG and IgM antibodies which when bound to antigen get deposited in various tissues",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Type IV: Delayed-type or cell-mediated hypersensitivity",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mediated by T cells, monocytes and macrophages",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "take several days to develop",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "examples include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tuberculosis skin test",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "topical antibiotic ointment",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "the immune response to **metallic orthopaedic implants** is typically a Type IV (delayed-type hypersensitivity reaction)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Immunoglobulins",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Immunoglobulin types",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "IgG",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the most abundant immunoglobulin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "IgM",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the first class of antibody to appear in our serum after exposure to an antigen",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "IgA",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "the major class of antibody in external secretions (e.g. intestinal mucus, bronchial mucus, saliva, and tears)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "IgE",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "important in conferring protection against parasites and allergic reactions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Immunologic Variations",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Benign Ethnic Neutropenia",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "Most common neutropenia in the world",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "Approximately 25%-50% of people of African descent and some sub-groups in the Middle East found to have low ANC without increased infection risk",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "ANC < 1.5 x 10(9) cells/L considered \"abnormally low\" without clear clinical relevance.",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "4.5% African Americans, 0.79% white Americans, 0.38% Mexican-Americans below this ANC",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Also more common in males vs females, athlete vs non-athlete, and children under age 5",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
