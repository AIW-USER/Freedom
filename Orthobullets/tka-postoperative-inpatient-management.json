    {
      "text": "Pain management",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Preoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "NSAIDS and opioids given immediately before procedure reduce postoperative pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Intraoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "regional anesthesia (spinal and/or epidural)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "preferred over general anesthesia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "peripheral nerve blocks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "useful adjuvant to decrease postoperative pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "studies have show the use of adductor canal blocks results in earlier postoperative ambulation compared to femoral nerve blocks",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "periarticular multimodal drug injection",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/422740/images/c6a010f0-8802-4361-a03f-79d7e4db010a_multimodal..jpg",
                  "caption": "Example of solution used for a periarticular injection in TKA"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "decrease postoperative pain with minimal risks",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Postoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "multimodal oral drug therapy",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/422740/images/9fb46a46-3908-433f-a455-4f506bbcf8de_oral_multimodal..jpg",
                  "caption": "Multimodal therapy defined as altering the pain pathway in various ways"
                }
              ],
              "importance": "2",
              "children": [
                {
                  "text": "gold standard and includes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "NSAIDs: Inhibit COX-1 and COX-2 ? inhibition of inflammatory mediators ( PGs, TXA, AA) **opioids**",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "Mu agonist leading to neuron hyperpolarization and reduced excitability",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**NSAIDs**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "inhibit COX-1 and COX-2",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "inhibition of inflammatory",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "mediators (PGs, TXA, AA)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**selective COX-2 inhibitors**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "inhibits transformation of AA to PG precursors",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "minimizes GI effects",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "may inhibit bone healing",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**gabapentin/pregabalin**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "reduce hyper-excitability of voltage dependent Ca2+ channels in activated neurons.",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "pregabalin= better oral bioavailability.",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**SNRIs**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "inhibition of serotonin and noradrenergic reuptake in the CNS",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Post-Operative Anemia",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Intra-operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "less intraoperative blood loss with the use of tourniquet",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Earlier discharge to rehab from hospital associated with improved outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Physical therapy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Therapy should start on the day of surgery",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "reduces length of hospital stay",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "reduced pain and improves function",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Range of motion",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Requirements",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "swing phase of gait",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "65° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "activities of daily living",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "90° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "stairs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "95° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "rise from a chair",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "105° of flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Continuous passive motion (CPM) machine",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/422740/images/b3aef510-9f32-4038-91b2-345dd9b20955_cpm..jpg",
              "caption": "Use of a CPM has not shown to have any long-term benefit following TKA"
            }
          ],
          "importance": "2",
          "children": [
            {
              "text": "improve early knee flexion",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "has not been shown to have a long-term benefit",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Drain Management",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Has not demonstrated any difference in complications or outcomes",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Associated with higher cost",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Discharge",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Discharge to home",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "medically stable",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "80-90° AROM knee flexion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ambulate 75-100 feet",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ascend or descend stairs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Discharge to rehab/SNF",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "earlier discharge to rehab from hospital associated with improved outcomes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
