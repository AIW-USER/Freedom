{
  "title": "Cartilage",
  "url": "https://www.orthobullets.com/basic-science/9014/cartilage",
  "subtitle": "Updated: Feb 1 2026",
  "sections": [
    {
      "text": "Types of cartilage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Main types of cartilage include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**articular (hyaline) cartilage**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**fibrocartilage (tendon/ligament junction with bone) and fibroelastic cartilage (menisci)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**elastic cartilage (trachea)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**epiphyseal cartilage (growth plates)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Cartilage biology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cartilage contents (avascular, aneural, and alymphatic)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**cells**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "chondrocytes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**extracellular matrix**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "water",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "collagen",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "proteoglycans",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "noncollagenous proteins",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Cell differentiation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cartilage is formed from mesenchymal stem cells designated towards the cartilagenous lineage",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "multi-step process involving activation and migration of cells to necessary sites",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "SOX-9 is a key transcription factor involved in the differentiation of cells towards the cartilage lineage",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "parathyroid hormone (PTH) may have chondroprotective effects",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "thought to be related to influence on indian hedgehog (IHH) signaling pathways affecting cartilage growth",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Metabolism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "regulated through mechanical stimulation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pH of cartilage is 7.4",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "disruption in pH can lead to an abnormal cartilage structure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Nutrition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oxygen and other nutrients supplied to cartilage from synovial fluid diffusion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Loading",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "physiologic loading is chondroprotective",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "underloading leads to cartilage thinning, tissue softening, and reduced proteoglycan content, leading to cartilage fibrillation, ulceration and erosion",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "overloading leads to cartilage damage (in vitro only)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "has not been shown in clinical setting",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Articular (Hyaline) cartilage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Complete Topic**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "**Location**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "articular surfaces",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "ribs",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "nasal septum",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Composition**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "water > collagen > proteoglycan > noncollagenous protein > cells",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "water = 65% to 80% of mass of the cartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Type II collagen = provides cartilagenous framework and tensile strength",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "**proteoglycans = function to provide compressive strength and attract water**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**chondrocytes = produce collagen, proteoglycans, and enzymes**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Function**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "decreases friction and distributes loads",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "cartilage exhibits stress-shielding of the solid matrix components due to its high water content, the incompressibility of water, and the structural organization of the proteoglycan and collagen molecules",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Fibrocartilage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Location**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "tendon/ligament junction with bone",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "pubic symphysis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "annulus fibrosis of the intervertebral disc",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "menisci",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Composition**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "fibrous cartilage",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9014/images/fibrocartilage.jpg",
                  "caption": "fibrocartilage"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**Type I collagen (predominantly)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "extracellular matrix",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "proteoglycans",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chondrocytes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "water",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "fibroelastic cartilage",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fewer proteoglycans and glycoproteins compared to hyaline cartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Function**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "healing response to injury of articular cartilage including",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "chondroplasty microfracture",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "drilling",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "abrasion arthroplasty",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "compressive strength",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Elastic Cartilage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Location**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "auricle of external ear",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "epiglottis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "auditory tube",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Composition**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "chondrocytes surrounded by a thin collagenous network",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9014/images/elastic.jpg",
                  "caption": "Elastic Cartilage"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**Type II collagen (predominantly)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "elastin fiber network",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "extracellular matrix",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "proteoglycans and glycoproteins",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chondrocytes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "water",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Function**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "highly elastic",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "designed to tolerate repetitive deformation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Epiphyseal cartilage",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Location**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "also known as the epiphyseal plate or epiphyseal ossification center",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "between the epiphysis and metaphysis at each end of long bones",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Composition**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "stacked chondrocytes are divided into different zones of maturation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "proteoglycans and growth factor (e.g.BMP-2) are found in the extracellular matrix between chondrocytes",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "progressive chondrocyte maturation and calcification of the extracellular matirix",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "infiltration of osteoprogenitor cells to produce osteoblasts and osteoid",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Histology of Epiphyseal cartilage**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9014/images/epiphysealplate001.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "Reserve zone",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "Proliferative zone",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "Hypertrophic zone",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "Primary spongiosa",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "Secondary spongiosa",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Function**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "linear growth via endochondral ossification",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "can allow extensive bone deformity remodeling potential",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
