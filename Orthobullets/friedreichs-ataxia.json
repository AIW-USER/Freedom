{
  "title": "Friedreich's Ataxia",
  "url": "https://www.orthobullets.com/pediatrics/4087/friedreichs-ataxia",
  "subtitle": "Updated: Jun 15 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Friedreich's Ataxia is an inherited disorder that leads to spinocerebellar degeneration due to an autosomal recessive mutation in the frataxin gene. The condition presents with ataxia, cardiomyopathy, motor weakness, cavovarus foot deformity, and scoliosis usually from age 7 to 25 year.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with genetic testing to assess for the absence of the frataxin gene.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is initially nonoperative. Corrective surgery for symptomatic cavovarus foot deformity and progressive scoliosis may be indicated over time.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1 in 50,000 births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "onset usually between 7 and 25 years",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "age of onset related to number of GAA repeats",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**autosomal recessive**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "repeat mutation leads to lack of **frataxin gene**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "frataxin is a mitochondrial protein involved in iron metabolism and oxidative stress",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "mutation is GAA repeat at 9q13",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pes cavovarus foot**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**scoliosis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "predictors of progression",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "onset of disease is less than 10 years of age",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "onset of scoliosis is before 15 years of age",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**cardiomyopathy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cardiology evaluation before surgery",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "antioxidants (Coenzyme Q) have been shown to decrease rate of cardiac deterioration but have no effect on ataxia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ataxia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "staggering **wide based gait** (spinocerebellar)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classic triad",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "ataxia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "areflexia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**positive plantar response**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "weakness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nystagmus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**cavovarus foot**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4087/images/Colman%20block%20test%20-%20flexible%20hindfoot%20-%20courtesy%20Miller_moved.png",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "very high arch",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "rigid deformity",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "associated claw toes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "standing scoliosis series",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "AP and lateral of foot if pes cavovarus present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "EMG",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shows defects in motor and sensory with an increase in polyphasic potentials",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nerve conduction velocities are decreased in upper extremities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cavovarus foot",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "only indicated in nonambulatory patient",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "deformity is rigid and progressive and resistant to bracing and stretching as treatment",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "plantar release, transfers, +/- metatarsal and calcaneal osteotomy",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "early disease in ambulatory patient",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "triple arthrodesis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "late disease in nonambulatory patients",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Scoliosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "observation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "curves < 40 degree without predictors of progression (see above)",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "PSF and instrumentation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "curve > 60 degrees",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "rapid progression with positive predictors of progression",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "onset of disease is less than 10 years of age",
                              "table": null,
                              "images": [],
                              "importance": "5",
                              "children": []
                            },
                            {
                              "text": "onset of scoliosis is before 15 years of age",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "usually does not need to be extended to pelvis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Usually wheelchair bound by age 30",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Usually die by age 50 from cardiomyopathy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
