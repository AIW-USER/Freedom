{
  "title": "Felon",
  "url": "https://www.orthobullets.com/hand/6102/felon",
  "subtitle": "Updated: May 15 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Felons are subcutaneous abscesses of the fingertip pulp.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically by assessing for tenderness, erythema and fluctuance of the fingertip pulp.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is usually I&D and IV antibiotics.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "accounts for 15-20% of hand infections",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly occurs in the **thumb or index finger**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**penetrating injury**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "blood glucose needlestick",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "splinters",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**local spread**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may spread from paronychia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**no history of injury in 50% of patients**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "may result from bacterial contamination of the fat pad through the eccrine sweat glands",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "overview",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "swelling and pressure within micro-compartments, leading to \"compartment syndromes\" of the pulp",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "progression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "inflammation and cellulitis leads to local vascular congetsion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "if left untreated, tissue necrosis and abscess formation leads to increased microvascular impairment",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "increasing pressure can eventually lead to \"compartment syndrome\" and subsequent ischemia",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "affects the blood supply to the diaphysis more than the blood supply to the skin, causing bone necrosis and sequestration before spontaneous decompression through the skin",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "organisms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**Staphylococcus aureus**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most common organism",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**gram negative organisms**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "found in immunosuppressed patients",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Eikenella corrodens",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "found in diabetics who bite their nails",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fingertip pulp",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed sac connective tissue framework",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "separated by **fibrous vertical septae** running from periosteum of the distal phalanx to the epidermis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "provides structural support",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "stabilizes the pulp during pinch and grasp",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "contains eccrine sweat glands that open onto the epidermis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "digital arteries run parallel to the distal phalanx",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "gives off a nutrient branch to the epiphysis before entering the pulp space",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "severe throbbing pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "swelling",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6102/images/felon%20presentation.jpg",
                  "caption": ""
                }
              ],
              "importance": "2",
              "children": [
                {
                  "text": "does not extend proximal to DIP flexion crease unless flexor tendon sheath or joint is involved",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "tenderness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "only indicated if history of trauma to rule out fracture or foreign body",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "not indicated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not indicated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Herpetic Whitlow",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Paronychia",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Glomus Tumor",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Mucous cyst",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Psoriasis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Clinical",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral antibiotics and observation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "early felon (no drainable abscess)",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bedside I&D and IV antibiotics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "most cases",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Bedside I&D**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "anesthesia",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "digital block",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "keep incision distal to DIP crease",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "to prevent DIP flexion crease contracture and prevent extension into flexor sheath",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**mid-lateral approach**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6102/images/felon%20drainage.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/6102/images/felon%20drainage%20surgical.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated for deep felons with no foreign body and no drainage",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "incision on ulnar side for digits 2-4 and radial side for thumb and digit 5 (non-pressure bearing side of digit)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**volar longitudinal approach**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6102/images/felon%20drainage%202.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most direct access",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "indicated for superficial felons, foreign body penetration, or visible drainage",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "incisions to avoid",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6102/images/felon%20incisions.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "fish-mouth incision",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "risk of unstable finger pulp or vascular compromise",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "double longitudinal or transverse incision",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "risk of injury to digital nerve and artery",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "debridement",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "avoid violating flexor sheath or DIP joint to prevent spread into these spaces",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**break up septa** to decompress infection and prevent compartment syndrome of fingertip",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "obtain gram stain and culture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "hold antibiotics until culture obtained",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "place gauze wick",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "postoperative",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "routine dressing changes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Finger tip compartment syndrome**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Flexor tenosynovitis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Osteomyelitis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Digital tip necrosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "If left untreated, can lead to",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sequestration of the diaphysis of the distal phalanx",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pyogenic arthritis of the DIP joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "flexor tenosynovitis from proximal extension",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
