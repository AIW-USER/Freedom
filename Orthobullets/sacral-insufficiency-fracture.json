    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12297/images/f0cc2637-9dd3-4a5f-94e6-ad3ace8f7e8d_sacrum..jpg",
              "caption": "Osteology of sacrum"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "formed by fusion of 5 sacral vertebrae",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "articulates with",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "5th lumbar vertebra proximally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "coccyx distally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ilium laterally at the sacroiliac joints",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "contains 4 foramina that transmit sacral nerves",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Nerves",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12297/images/1d8268ba-f33a-4ff7-bdaf-5ec7cf927bf2_nerves_of_sacrum..jpg",
              "caption": "Nerves of sacrum (P, pudendal; SN, sciatic nerve; LST, lumbosacral trunk)"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "L5 nerve root runs **on top of the sacral ala**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "S1-4 nerve roots pass through the sacral foramina",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "S1 and S2 nerve roots have a higher rate of injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "lower sacral nerve roots (S2-5)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "anal sphincter tone / voluntary contraction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bulbocavernosus reflex",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "perianal sensation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "unilateral preservation of nerves is adequate for bowel and bladder control",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "transmission of load from the first sacral segment through the iliac wings to the acetabulum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
