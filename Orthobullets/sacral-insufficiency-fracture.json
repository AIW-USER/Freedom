    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Sacroplasty**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "injection of polymethylmethacrylate cement",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications specific to this treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**cement extrusion**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "avoid sacroplasty in displaced fractures because of the risk of symptomatic cement extrusion",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**ORIF**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "unilateral iliosacral screws",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12297/images/unilat.jpg",
                      "caption": "Unilateral iliosacral screws"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "place two parallel 7-8 mm cannulated screws perpendicular to the fracture plane",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "**two screws provide greater stability than one screw**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "screws should cross midline",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "**stability depends on the strength of the sacral cancellous bone**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "use washers to prevent penetration of the screw head through the lateral cortex of the posterior part of the ilium",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "trans-sacral screw",
