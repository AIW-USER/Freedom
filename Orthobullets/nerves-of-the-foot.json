  "subtitle": "Updated: Jul 11 2021",
  "sections": [
    {
      "text": "Branches of the Tibial nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Medial calcaneal nerve**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "innervates",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "plantar medial heel",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Medial plantar nerve**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "innervates",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "Abductor Hallucis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "FHB",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "FDB",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lumbricals to 2nd and 3rd toes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "at risk",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "proper branch of medial plantar nerve at risk with medial-plantar approach to the tibial sesamoid",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Lateral plantar nerve**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "innervates",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "adductor hallucis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "quadratus plantae",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "all interossei muscles",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lateral two lumbricals",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**abductor digiti minimus** (via Baxter's nerve - the **first branch of LPN**)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Baxter`s nerve",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "courses anterior to the medial tubersosity between the QP and FDB",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "provides sensation to",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "plantar lateral foot",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lateral fourth toe",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "fifth toe",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "injury to lateral/medial plantar nerve leads to **weak or absent MTP flexion** (intrinsic minus)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Sural Nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Provides dorsal sensory in 4th web space (70-80% of time)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Most vulnerable during",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extensile lateral approach to calcaneus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "screw placement for stress fx of proximal 5th MT",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Achilles tendon repair - especially percutaneous technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Deep peroneal Nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Innervates EDB, and EHB in foot",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Provides sensation to the first dorsal webspace",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Found compressed beneath inferior retinaculum in anterior tarsal tunnel syndrome",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Lateral branch",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most vulnerable during removal of calcaneonavicular bar",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "during approach for reduction of Lisfranc injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Injury",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "injury leads to weak or absent EDB and EHB function",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "this can be seen with trauma or CMT",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Superficial Peroneal Nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Medial branch**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "dorsomedial aspect of hallux",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most vulnerable during bunion surgery",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Lateral cutaneous branch**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "emerges from deep fascia 12-15 cm proximal to tip of lateral malleolus",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "most vulnerable with",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "arthroscopic anterolateral portal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ORIF of distal fibula fx (especially Weber C)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "At risk with ankle inversion injuries",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Saphenous Nerve",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Supplies sensation to",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medial side of foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
