    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most patient asymptomatic and diagnosed at birth",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**normal anatomy proximal to constriction ring**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "bands perpendicular to longitudinal axis of the digit or limb",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most common presentation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "central digits more commonly affected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "amputations distal to constriction site can be found",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "when no amputations present look for",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "secondary syndactyly",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bony fusions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "may observe sinus tracts proximally between digits",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
