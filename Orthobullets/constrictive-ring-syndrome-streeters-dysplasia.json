                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**syndactyly**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "nonorthopaedic",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**cleft palate**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cleft lip",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "craniofacial defects",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cardiac defect",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Encephalocele",
                  "table": null,
