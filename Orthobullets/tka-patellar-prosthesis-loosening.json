  "subtitle": "Updated: Jun 23 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Patellar Prosthesis Loosening is a complication following TKA that is more common with metal-backed patellar components.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made with plain radiographs of the knee.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally revision arthroplasty of the patellar component.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "0.6-5% of cases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "more common with metal-backed patellae",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cause",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "subclinical infection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "maltracking or overstuffing, leading to high shear",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risks",
          "table": null,
