          "importance": "3",
          "children": [
            {
              "text": "obesity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lateral release",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "joint-line elevation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "postoperative flexion >100°",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "poor bone stock",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "asymmetric patellar resection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "inadequate implant fixation (small pegs)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "secondary osteonecrosis and osteolysis",
              "table": null,
              "images": [],
