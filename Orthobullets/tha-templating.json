{
  "title": "THA Templating",
  "url": "https://www.orthobullets.com/recon/12124/tha-templating",
  "subtitle": "Updated: Jan 15 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Definition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the process of anticipating the size and position of implants prior to surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Importance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "allows surgeon to anticipate potential difficulties",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "to reproduce hip biomechanics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "minimizes leg length inequality",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Accuracy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "52-98% accurate +/- one size",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "related to experience and practice",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "obtain appropriate radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "record vital patient information on template (age, height, weight, etc)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "establish radiographic landmarks",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "establish limb length discrepancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "template acetabular component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "do this first to determining center of rotation of new hip",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "template femoral component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Tips",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12124/images/table_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "best to achieve a good template with sizes in the middle range of the component system",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "different system may be a better choice if this cannot be achieved",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Radiographic Analysis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Necessary radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "AP pelvis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "centered over pubic symphysis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "AP hip",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "taken with 10-15 degrees of internal rotation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "places femoral neck parallel to cassette",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "external rotation on radiographs will",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "falsely decrease offset",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "create valgus appearing femoral neck",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "falsely decrease femoral canal diameter",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "frog lateral hip",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Magnification",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "20% is standard",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most templates account for this",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "magnification markers are helpful",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Secondary assessment of radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pelvic obliquity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be secondary to spinal deformity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "may cause leg-length issues",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "acetabular retroversion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "makes appropriate positioning of acetabular component more difficult intraoperatively",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Radiographic Landmarks",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Femoral side",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medullary canal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "greater trochanter",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lesser trochanter",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "saddle point",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most distal part of the junction between the superior aspect of the femoral neck and the greater trochanter",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12124/images/screen_shot_2015-01-21_at_2.05.54_pm.jpg",
                      "caption": "saddle"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Acetabular side",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "acetabular roof",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12124/images/roof.jpg",
                  "caption": "roof"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "tear drop",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12124/images/teardrop.jpg",
                  "caption": "teardrop"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "created by superposition of the most distal part of the medial wall of the acetabulum and the tip of the anterior/posterior horn of acetabulum",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Pelvis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ischial tuberosities",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12124/images/ischial_tuberosities2.jpg",
                  "caption": "ischial line"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "important to determine limb length discrepancy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Establish Limb Length Discrepancy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "on AP pelvis, draw horizontal line connecting the ischial tuberosities",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12124/images/ischial_tuberosities.jpg",
                  "caption": "ischial tuberosities"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "ensure the line extends beyond the medial femoral cortices bilaterally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "mark the top (proximal-most point) of both lesser trochanters on the AP pelvis radiograph",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12124/images/lesser.jpg",
                  "caption": "lesser line"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "measure the distance between the inter-tuberosity line and the line drawn at the most proximal aspect of the lesser trochanters",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12124/images/limb_length.jpg",
                  "caption": "limb length"
                }
              ],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Alternatives",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a line connecting the teardrops may be used instead of the ischial tuberosity line",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "this may be more accurate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Template the Acetabulum",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cup abduction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "place appropriately sized acetabular template with roughly 40 degrees of abduction",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "medial border of cup",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial border of cup should approximate the **ilioischial line** and lie close to the **teardrop**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "a medial cup will",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**decrease joint reactive forces**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "decrease force required by abductors to maintain a level pelvis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "inferior border of cup",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inferior border of cup should be at level of **inferior teardrop line**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "mark center of rotation of acetabular component",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Template the Femur",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Steps",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "size femoral implant",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "choose an appropriate sized femoral implant to **fill medullary canal**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "determine insertion depth",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "insertion depth is determined to **optimize limb length inequality**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "placing the new femoral head center of rotation **superior** to the acetabular center of rotation will **lengthen the limb**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "placing the new femoral head center of rotation **inferior** to the acetabular center of rotation will shorten the limb",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12124/images/decrease_leg_length.jpg_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "mark femoral neck cut",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "mark the intended femoral neck resection level",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "posterior approach",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "use **lesser trochanter** for posterior approach",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "anterior approach",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "use **saddle point** (see above) for anterior approaches",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "restore offset",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "may be restored by",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "choosing a stem with more or less offset",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "choosing a stem with a different neck-shaft angle",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "modifying the length of the femoral neck",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
