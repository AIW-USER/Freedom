  "sections": [
    {
      "text": "causes of hypocalcemia",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Causes of hypocalcemia include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**decreased PTH** that can be caused by",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**hypoparathyrodism**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**pseudohypoparathyroidism**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**renal osteodystrophy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**decreased vitamin D3**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptom",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms of **hypocalcemia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "paresthesia",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fingertip, toes, perioral",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "abdominal pain, biliary colic",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "muscle cramps, tetany",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "dyspnea (laryngospasm, bronchospasm)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "convulsions",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "mental status changes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "anxiety, fatigue, mood swings",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**findings of tetany**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**Trousseau's Sign**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "carpopedal spasm after blood pressure readings",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "inflate BP cuff 20mmHg above systolic BP x 3-5min",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "hand adopts a MCP flexed, DIP and PIP extended position",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "more sensitive than Chvostek's sign",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Chvostek's Sign**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**facial muscle contractions after tapping on the facial nerve**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "dermatologic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fungal nail infections",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hair loss",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "blotchy skin",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "pigment loss, vitiligo",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Radiographs",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Basal ganglia calcification",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9027/images/basal%20ganglia%20calcification.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "comprises striatum, globus pallidus, substantia nigra, subthalamic nucleus",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum calcium, phosphate, vit D, PTH",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Serum albumin",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "low serum albumin (low protein) leads to low total calcium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "but ionized calcium levels will be normal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "pH",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "alkalosis increases albumin binding to ionized calcium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leads to hypocalcemia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
