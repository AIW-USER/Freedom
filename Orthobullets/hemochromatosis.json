{
  "title": "Hemochromatosis",
  "url": "https://www.orthobullets.com/basic-science/9043/hemochromatosis",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hemochromatosis is a common metabolic disorder caused by deposition of excess levels of iron in the blood and tissue. Patients present with arthritis, chondrocalcinosis, diabetes, and skin hyperpigmentation.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with liver biopsy showing hemosiderin in parenchymal cells.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is identifying and treating the underlying etiology, decreasing iron intake, and a phlebotomy regimen.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prevalence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "1 in 200 people of northern European extraction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually presents in 4th-5th decade of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "women usually present later than men due to the protective effect of iron loss during menses and pregnancy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "multi-system disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypogonadism",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diabetes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "liver cirrhosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cardiomyopathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**arthritis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may be unilateral or bilateral",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "may affect one or multiple joints",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increased dietary iron absorption and/or increased iron release from cell",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "leading to inappropriate levels of iron into organs and tissues",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inheritance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "autosomal recessive",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "mutations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**C282Y allele** is most common",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "classically presents with non-specific symptoms",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "fatigue",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lethargy",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "joint or muscle pain",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "may present with systemic symptoms",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "impotence",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "diabetes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "skin hyperpigmentation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Examination",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most often in PIPJ, MCPJ of index and middle finger",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "larger joints may also be affected",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "highly suspicious with bilateral ankle OA",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may identify arthritis of the joints",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "chonrocalcinosis presents in >50% of patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "serum ferritin levels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "serum iron levels (>30 µmol/L)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "total iron-binding capacity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "TSH",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lipid profile",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Liver Biopsy (gold standard)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hemosiderin in parenchymal cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "decrease iron intake",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "standard of treatment to reduce iron overload",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "methods",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "reduced consumption of red meat",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "avoid raw shellfish",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "limit supplemental vitamin C",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "avoid excessive alcohol (secondary liver damage)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "phlebotomy regime",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "weekly blood letting sessions to reduce serum ferritin levels",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "contraindications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "severe anemia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "congestive heart failure",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "total joint arthroplasty",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "large joint involvement",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Orthopaedic Manifestations",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bilateral ankle arthritis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hemochromatosis should be suspected when symmetrical ankle arthropathy occurs in young men",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Produces arthritis and chondrocalcinosis in > 50% of patients**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment returns life expectancy to normal if patient non cirrhotic and no diabetic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
