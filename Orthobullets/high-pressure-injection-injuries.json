{
  "title": "High-Pressure Injection Injuries",
  "url": "https://www.orthobullets.com/hand/12104/high-pressure-injection-injuries",
  "subtitle": "Updated: Nov 8 2024",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "High-Pressure Injection Injuries are a traumatic condition characterized by extensive soft tissue damage associated with a benign high-pressure entry wound.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis requires obtaining a careful history and inspection of the digit involved.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment involves emergent surgical debridement.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "relatively rare, 1 in 600 hand traumas",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common in young male laborers in industry using paint, automotive grease, solvents and diesel oil",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the non-dominant index finger is the most commonly affected digit",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12104/images/high%20injection.jpg",
                  "caption": "High pressure injection injury"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": ">50%",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "injection force delievered from 3,000 to 10,000 PSI and up to 400 MPH",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "100 PSI is enough force to break the skin",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "4 main components",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "initial injury",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "chemical irritation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "inflammation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "secondary infection",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leads to dissection along planes of least resistance (along neurovascular bundles)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "vascular occlusion may lead to local soft tissue necrosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "important to document duration since event",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "time to physician evaluation averages nearly 9 hours",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "material injected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "minimal or no pain at injection site",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain and paresthesias eventually occur",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "entry wound often benign looking",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "only 1 in 4 initially present to ED",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "eventually finger becomes bloated, edematous, tense, pale, and cold",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may be useful to detect spread of radio-opaque dyes or paint",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12104/images/2f005524-ac8d-4ad9-8986-2089d526ffc4_radiograph..jpg",
                  "caption": "Radiograph"
                }
              ],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Clinical",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tetanus prophylaxis, parenteral antibiotics, limb elevation, early mobilization, monitoring for compartment syndrome",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "for injection of air, water, or chicken vaccine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "50% of injuries treated nonoperatively will ultimately require an operation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "delayed surgical management associated with higher reoperation rates and postoperative complications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12104/images/table.jpg",
              "caption": "table"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "irrigation & debridement, foreign body removal and broad-spectrum antibiotics",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "most cases require immediate surgical debridement",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/12104/images/high%20pressure.jpg",
                          "caption": "high pressure injection injury"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "higher rates of amputation are seen when surgery is delayed greater than 10 hours after injury",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "48% of finger injuries require amputation",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "**Tetanus prophylaxis, parenteral antibiotics, limb elevation, early mobilization, monitoring for compartment syndrome**",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "considerations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tetanus prophylaxis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "parenteral antibiotics",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "gram-negative and gram-positive coverage",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "limb elevation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "early mobilization",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pain control",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "avoid digital blocks and ice to prevent decreased perfusion",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "monitor for compartment syndrome",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Irrigation & debridement, foreign body removal and broad-spectrum antibiotics**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "Bruner palmar digital incisions",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "midaxial incision",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "full exposure to zone of injury",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "wide debridemeent of all involved tissues",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "decompression of tissue compartments",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "exploration and incision of tendon sheaths",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "removal of all injected material",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "saline irrigation",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "repeat I&D at 24 to 72-hours",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "postoperative infection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "42% have positive cultures, most polymicrobial",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Amputation**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/12104/images/oil_injection_injury_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "amputation rates approach 50% with oil-based paint injection injuries",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Infection**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "delayed treatment increases risk of postoperative infection",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "necrotic tissue is a good culture medium for bacterial growth",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "might be lower with organic solvent injections as they do not support bacterial growth",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Up to 50% amputation rate for organic solvents (paint, paint thinner, diesel fuel, jet fuel, oil)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Prognostic variables",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**time from injury to treatment**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**force of injection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**volume injected**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**composition of material**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "grease, latex, chloroflourocarbon & water based paints are less destructive",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "industrial solvents & oil based paints cause more soft tissue necrosis",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
