                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Large split in the periosteal tube with superior displacement",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4122/images/distal_clavicle_classification.jpg",
                          "caption": "Distal clavicle classification"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
