      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "common",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "ecchymosis in older children",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**tenderness** at the distal clavicle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "deformity at distal clavicle",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "skin tenting may be present",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "pseudo-paralysis of the affected ipsilateral extremity may be present in newborns",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "reflexes remain intact following isolated clavicle fractures",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "can help differentiate from brachial plexus injuries",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "initial views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**AP +/- Zanca**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4122/images/distal%20clavicle%20physeal%20xray.jpg",
                      "caption": "Pediatric Distal Clavicle Physeal Injury"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**for intra-articular injury**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "axillary lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "to define a Type-IV injury",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "later findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "intact periosteal sleeve forms a \"new\" lateral clavicle inferior to the superiorly displaced medial fragment.",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "sling management",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indicated in most cases, especially if periosteum is intact",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "a new clavicle will form within the intact periosteal sleeve resulting in a Y shaped clavicle",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "the displaced clavicle will typically reabsorb with time and growth",
                          "table": null,
                          "images": [
                            {
                              "src": "https://upload.orthobullets.com/topic/4122/images/peds%20clavicle%20fx%20periosteal%20sleeve.jpg",
                              "caption": "Periosteal sleeve healing pediatric clavicle fracture"
                            },
                            {
                              "src": "https://upload.orthobullets.com/topic/4122/images/healing%20distal%20clavicle%20fracture%20pediatric.jpg",
                              "caption": "Example of progression of healing of distal clavicle physeal injury"
                            },
                            {
                              "src": "https://upload.orthobullets.com/topic/4122/images/healing%20distal%20clavicle%20fracture%20pediatric2.jpg",
                              "caption": "Healed distal clavicle physeal injury, periosteal sleeve has filled in and ossified"
                            }
                          ],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical reduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "absolute indications (rare)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**open fractures**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**significant skin compromise**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**displaced intra-articular extension**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**a/w neurovascular injuries requiring surgery**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**relative**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**severely displaced** fractures in older patients with nearly closed physis",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "displaced and entrapped fragment in trapezius",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "floating shoulder injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "some Type III fractures in patients approaching skeletal maturity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "types IV, V, and VI may need open reduction with repair of periosteal sleeve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Laceration of subclavian artery or vein**",
