{
  "title": "Dog and Cat Bites",
  "url": "https://www.orthobullets.com/hand/6103/dog-and-cat-bites",
  "subtitle": "Updated: May 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Dog and Cat Bites to the hand are common and are associated with secondary infections due to a large number of animal oral flora pathogens.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is often delayed and is confirmed with a careful history and physical examination.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is generally oral antibiotics but presence of soft tissue infection, abscess or tenosynovitis requires urgent irrigation and debridement.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence (dog > cat > human)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**dog** bites are most common animal bites in the US (90%)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "dog is known to victim in 90% of cases",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "cat bites are 2nd most common (10%)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "human bites are 3rd most common",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "more frequent at ages **2-19 years**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic Location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**upper extremity** > lower extremity",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**dog bites**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "cause crush, puncture, avulsion, tears and abrasions",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6103/images/dog%20teeth.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/6103/images/rottweiler%201.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "large dogs' jaws exert >450lbs/ square inch",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "more likely to cause **structural damage** to nerves, vessels, joints",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**cat bites**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "penetrate bones and joints, and cause septic arthritis and osteomyelitis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "small, **sharp** teeth cause puncture wounds that seal immediately",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/6103/images/cat%20teeth.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "penetrate joints and flexor tendons",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**higher risk for infection** than dog bites",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "microbiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**most infections are polymicrobial, with > 1 anerobe**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**most common isolate from both cats and dogs is Pasteurella sp.**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "gram-negative, facultative, anaerobic, pleomorphic coccobacillus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "inform lab about potential for Pasteurella",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "cultures require appropriate growth media and take 1wk to grow",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**dog bites**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**Pasteurella (50% of dog bite infections)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "***Pasteurella canis***",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "Staphylococcus aureus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Streptococcus alpha-hemolytic",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "Corynebacterium",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "anerobes (e.g. Bacteroides)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "*Capnocytophaga canimorsus*",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "rare, potentially fatal (in splenectomy patients)",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "causes cellulitis, sepsis, endocarditis, meningitis, DIC, ARDS and death",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "highest mortality in immunocompromised (30-60%)",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**cat bites**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "***Pasteurella* (most common**, 70-80% of cat bite infections)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "*Pasteurella multocida* and *Pasteurella septica*",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "causes intense pain, swelling in 48h",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "other organisms similar to dog bites",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**secondary bacterial infection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most bites do not become infected",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "risk factors for infection",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "bite to hand, foot, or major joint",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "puncture wounds or crush injuries",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "treatment delay >12h",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "age >50y",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "preexisting host disease",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "immune suppression (steroids, asplenism)",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "chronic alcoholism",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "diabetes mellitus",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "vascular disease",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "existing edema of extremity",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "rabies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "caused by a rhabdovirus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "common animal carriers include dogs, raccoons, bats, foxes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "increased risk with open wounds, scratches/abrasions, mucous membranes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "important to determine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "type of animal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "time since injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "presence of comorbidities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain and swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "bleeding",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "signs of local or systemic sepsis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "evaluate depth of puncture wound and presence of crush injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "check for neurovascular status",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "look for joint penetration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "important to photograph wounds",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications to obtain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "crush injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "suspected fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "suspected foreign body",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Culture",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "if signs of infection are present",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "routine culture not indicated",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "deep aerobic and anaerobic culture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Diagnosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Clinical",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnosis is made with careful history and physical examination",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "copious irrigation, prophylactic antibiotics, tetanus toxoid, +/- rabies prophylaxis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "copious irrigation in emergency room",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "saline (>150ml) irrigation with 18-19G needle or plastic catheter",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "use povidone-iodine solution if high risk of rabies",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "indications for antibiotics",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "cat bites",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "presentation >8h",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "immune compromised or diabetic",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "hand bite",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "deep bites",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "choice of antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "**amoxicillin/clavulanic acid** effective against Pasteurella multocida",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "cefuroxime",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "ceftriaxone",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**rabies prophylaxis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated when any suspicion for rapid animal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "suspect if unprovoked attack by animal with bizarre behavior",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "human diploid cell vaccine and human rabies immunoglobulin",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "immobilization",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**immobilize and elevate extremity**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "formal surgical debridement",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "crush or devitalized tissue",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "foreign body",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "bites to digital pulp space, nail bed, flexor tendon sheath, deep spaces of the palm, joint spaces",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "tenosynovitis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "septic arthritis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "abscess formation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serious and fatal bites include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "large, aggressive dogs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "small children",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "head and neck bites",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
