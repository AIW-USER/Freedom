                  "children": [
                    {
                      "text": "irreducible radiocarpal dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "unstable radiocarpal joint after reduction",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "good outcomes can be achieved with concentric reduction of the radiocarpal joint, treatment of intercarpal injuries and sound repair of the osseousligamentous injuries",
