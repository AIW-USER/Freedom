                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed reduction and cast immobilization**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "longitudinal axial traction of the digits",
