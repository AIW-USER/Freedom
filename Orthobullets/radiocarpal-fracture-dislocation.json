                                }
                              ],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "intercarpal widening",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "evaluate for scapholunate or lunotriquetral dissociation",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "break in the Gilula arcs",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "the radiocarpal, proximal midcarpal, distal midcarpal arcs should be colinear",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "lateral view of the wrist",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/422863/images/radiocarpal_dislocation..jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "dorsal or volar radiocarpal wrist dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "loss of colinearity of the lunate with the articular surface of the radius",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "\"tear-drop view\"",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/422863/images/tear-drop_view..jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "10 degree proximal view on a lateral",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "evaluate for lunate facet fracture",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
