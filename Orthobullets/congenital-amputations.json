      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Congenital Amputations are upper extremity amputations that are most commonly associated with amniotic band constriction.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with a variable location of amputation.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment depends on the level of amputation and may be addressed with prosthesis placement as necessary.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
