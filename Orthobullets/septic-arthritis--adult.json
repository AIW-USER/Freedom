{
  "title": "Septic Arthritis - Adult",
  "url": "https://www.orthobullets.com/trauma/1058/septic-arthritis--adult",
  "subtitle": "Updated: Jan 26 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Septic Arthritis is the inflammation of the joints secondary to an infectious etiology, most commonly affecting the knee, hip, and shoulder.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with an aspiration of joint fluid with a WBC count > 50,000 being considered diagnostic for septic arthritis. Lower counts may still indicate infection in the presence of positive gram stains or cultures results.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually urgent surgical irrigation and debridement followed by culture directed IV antibiotics.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most commonly affected joints in descending order",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "knee (~ 50% of cases) >",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "hip >",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "shoulder >",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "elbow >",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "ankle >",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "sternoclavicular joint",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "found in IV drug users",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "pseudomonas aeruginosa was most common pathogen in 1980's",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**staphylococcus aureus** is now the most common pathogen in all patients, including IV drug users",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "advanced imaging (CT/MRI) should be obtained preoperatively to rule out retrosternal abscess or chest wall phlegmon",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "age > 80 years",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "medical conditions",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "diabetes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "rheumatoid arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "cirrhosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "HIV",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "history of crystal arthropathy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "endocarditis or recent bacteremia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**IV drug user**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "recent joint surgery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "3 etiologies of bacterial seeding of joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**bacteremia**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**direct inoculation**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "from trauma or surgery",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**contiguous spread**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "from adjacent osteomyelitis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "cellular biology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "septic arthritis causes irreversible cartilage destruction in an involved joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "cartilage injury can occur by 8 hours",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "caused by release of proteolytic enzymes from inflammatory cells (PMNs)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "microbiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most common pathogens is **staphylococcus aureus (accounts for >50% of cases)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "see Classification below",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**prosthetic implant infection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "By organism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "staphylococcus species",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**staphylococcus aureus**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1058/images/staph%20aerues%20%20(reference.medscape).jpg",
                      "caption": "Staph aereus gram stain"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**most common and accounts for >50% of cases**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "MRSA",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "staphylococcus epidermis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "neisseria gonorrhea",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "account for ~20% of cases",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "most common organism in otherwise healthy **sexually active adolescents and young adults**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "manifests as a bacteremic infection",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "arthritis-dermatitis syndrome in ~60% of cases",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "localized septic arthritis in ~40% cases",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "gram-negative bacilli",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "account for 10-20% of cases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "pathogens include",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "E coli, proteus",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "klebsiella",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "enterobacter",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "risk factors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**neonates**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**IV drug users**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**elderly**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**immunocompromised patients with diabetes**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "streptococcus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "streptococcus pyogenes (Group A)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "most common",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Group B streptococcus (e.g., agalactiae)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "predilection for infants, elderly and diabetic patients",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "propionibacterium acnes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "associated with **shoulder surgery**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "salmonella or streptococcus pneumoniae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "seen in patients with **sickle cell disease**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "bartonella henselae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "seen in patients with **HIV**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pseudomonas aeruginosa",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "seen in patients with history of **IV drug abuse**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pasteurella multocida",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "seen in patients after **dog or cat bite**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "eikenella corrodens",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "seen in patients after **human bite**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "fungal/candida",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "found in immunocompromised host",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain in affected joint",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fevers (only present in 60% of cases)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may appear toxic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "erythema",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1058/images/img_0018.jpg",
                      "caption": "Septic knee"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "effusion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "extremity tends to be in position of maximum joint volume",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "hip would be in FABER position (flexed, abducted, externally rotated)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1058/images/faber%20(aafp.org).jpg",
                          "caption": "FABER"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "warmth",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tender",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "inability to bear weight",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "inability to tolerate PROM",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral of the joint in question",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may show joint space widening or effusion",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1058/images/lateral%20knee%20x-ray%20(rsna.org).jpg",
                      "caption": "Lateral knee septic effusion"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "periarticular osteopenia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may help in confirming joint effusion in large joint such as hip",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1058/images/ultrasound%20knee%20(gcus.com).jpg",
                      "caption": "Ultrasound septic knee"
                    }
                  ],
                  "importance": "2",
                  "children": [
                    {
                      "text": "can be used in guiding aspirations",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "detects joint effusion, and may detect adjacent bone involvement such as osteomyelitis",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1058/images/lateral%20mri%20(ajronline.org).jpg",
                      "caption": "Septic knee MRI"
                    }
                  ],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "WBC >10K cells/mL with left shift",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ESR >30 mm/hr",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ESR is often elevated but may be normal early in process",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rises within 2 days of infection and can rise 3-5 days after initiation of appropriate antibiotics, and returns to normal 3-4 weeks",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "CRP >1 mg/dL",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**most helpful**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "best way to judge efficacy of treatment, as CRP rises within few hours of infection, and may normalize within 1 week of treatment",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Joint fluid aspirate",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "**gold standard for treatment and allows directed antibiotic treatment**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**should be analyzed for**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "**cell count with differential**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**gram stain**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**culture**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**glucose level**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**crystal analysis**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**septic arthritis occurs concurrently with gout or pseudogout in < 5% of cases**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "characteristic findings",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "joint fluid appears cloudy or purulent",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "cell count with **WBC > 50,000** is considered diagnostic for septic arthritis, however lower counts may still indicate infection",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "antibiotics administered **within 24 hours of arthrocentesis can lower synovial WBC count** and lead to false negative results",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "gram stains only identifies infective organism 1/3 of time",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "glucose less than 60% of serum level",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "negative \"string\" sign",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "septic synovial fluid has low viscosity compared to normal synovial fluid (high viscosity)",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1058/images/string_sign..jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Saline load test",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "utilized to determine if wound near a joint communicates with the joint",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "for the knee",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "155 mL of saline is needed to reach 95% sensitivity",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "175 mL of saline is needed to reach 99% sensitivity",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Crystal arthropathy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "gout",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "pseudogout",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Cellulitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Bursitis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prepatellar bursitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "IV abx, operative irrigation and drainage of the joint",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "considered an orthopaedic surgical emergency",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**IV antibiotic therapy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "initiate empiric therapy prior to definitive cultures based on patient age and or risk factors",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "young, healthy adults",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "staphylococcus aureus and neisseria gonorrhea",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "immunocompromised patients",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "staphylococcus aureus and pseudomonas aeruginosa",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "**transition to organism-specific antibiotic therapy based once obtain culture sensitivities**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "treatment can be monitored by following serum WBC, ESR, and CRP levels during treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "gonococcal septic arthritis can be treated with antibiotics and aspiration",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "typical antibiotic therapy includes ceftriaxone or fluoroquinolones",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "high resistance pattern to penicillin and tetracyclines",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Operative irrigation and drainage of the joint**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "can be performed open or arthroscopically (depending on joint)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "irrigation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "remove all purulent fluid and irrigate joint",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "debridement",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "synovectomy can be performed as needed",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "cultures",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "obtain joint fluid and tissue for culture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Arthritis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Fibrous ankylosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Osteomyelitis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Delayed diagnosis can lead to profound, extensive cartilage damage within 8 hours",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
