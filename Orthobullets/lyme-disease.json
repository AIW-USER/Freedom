{
  "title": "Lyme Disease",
  "url": "https://www.orthobullets.com/pediatrics/9052/lyme-disease",
  "subtitle": "Updated: Mar 1 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lyme Disease is a systemic infection caused by tick-born B. burgdorferi which usually presents with flu-like symptoms, a characteristic rash, and occasionally acute joint effusions.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is confirmed by a history of travel to a tick-heavy regions, presence of erythema migrans rash, and a positive lyme titers on an ELISA test.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is usually oral doxycycline for acute or mild disease.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "most common tick-borne illness in the US",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "19,931 cases in 2006",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most cases occur in June, July, and August",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bimodal age distribution",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "children 5-9 (8.6 cases/100,000)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "adults 55-59 (7.8 cases/100,00)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "geographic locations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**northeast**, midwest, western US (areas with heavy deer population)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9052/images/map.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "Maryland to Maine (Ixodes scapularis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Great Lakes region (Ixodes scapularis)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Pacific Northwest (Ixodes pacificus)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "mechanism of transmission",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "zoonotic - transmitted from nonhuman animals to humans",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "mice, squirrels, shrews, and other small mammals are carriers of B burgdorferi",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "Ixodes tick feeds on these small animals and spirochete is carried in its gut",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "humans become infected when bacteria is injected into the skin as ticks attach to feed",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "transmission takes 48-72 hours",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "caused by B burgdorferi",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9052/images/borrelia.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "tick saliva with spirochete disrupt local immune mechanisms",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "create a protective environment and the bacteria replicate",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "spirochetes multiply and expand within the dermis, causing erythema migrans",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rash caused by the host inflammatory response",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "the spirochete then undergoes hematogenous dissemination to multiple sites",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "skin",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "central nervous system",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "joints",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "induces an inflammatory response",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": [
                            {
                              "text": "synovial hypertrophy",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "vascular proliferation",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "infiltration of mononuclear cells",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            },
                            {
                              "text": "immune complexes accumulate in synovial fluid",
                              "table": null,
                              "images": [],
                              "importance": "3",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "pathobiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "B burgdorferi induces chondrocytes to produce matrix metalloproteinases",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "causes degradation of extracellular matrix proteins, collagen, and proteoglycans",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "may contribute to cartilage damage",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Stage 1 (rash) - early localized",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**1 to 30 days** after bite",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**erythema migrans (bull's-eye rash) is hallmark**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "rash may be found on head, neck, arms, legs, back, abdomen, axilla, groin, and chest",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "flu-like symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "fatigue",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "headache",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "malaise",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Stage 2 (neurologic and cardiac) - early disseminated",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**weeks to months** after bite",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "progresses to stage 2 in 15-20% of untreated patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neurologic symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**CN VI palsy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**CN VII palsy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**lymphocytic meningitis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**migratory polyarthritis or monoarthritis, tendonitis, bursitis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Lyme carditis relatively rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may have a cardiac conduction abnormality",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "symptoms",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "syncope",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "fatigue",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "dizziness",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "shortness of breath",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "palpitation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "prognosis good with complete resolution following treatment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Stage 3 (arthritis) - late",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**months to years** after bite",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "occurs in 60% of untreated patients",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**arthritis** (usually the knee)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "swelling disproportionate to tenderness",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "intermittent arthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "chronic monoarthritis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "acrodermatitis chronica atrophicans",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tick bite in May through November",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "fever, headache, myalgia, arthralgia, fatigue",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "neurologic symptoms",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "headache, neck stiffness, encephalitis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "facial **CN VII palsy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "bilateral in 50% (unlike Bell's palsy)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "polyradiculoneuropathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "numbness, paresthesia, weakness, cramps",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "carditis (complete heart block)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "acute joint pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "acute or chronic arthritis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**erythema migrans** (\"bullseye rash\") in 60-80% of patients",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9052/images/erythema%20migrans.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "expanding rash **>5cm** diameter **1 to 3 weeks** after tick bite",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "itching or burning",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "fades after 1 month",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "at **axillary or gluteal folds**, hairline, near elastic bands (bra strap or underwear)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "acute, self limiting joint effusions",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "knee and shoulder",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "recurrent",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "acrodermatitis chronica atrophicans",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9052/images/atrophica.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "\"cigarette paper\" skin",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "dorsum of hands, feet, knees, elbows",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "in older patients",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Serum labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "WBC normal or elevated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ESR, CRP elevated",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "ELISA (sensitive, not specific)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "2 steps",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "if ELISA positive, proceed to Western blot (specific)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "seroconversion takes weeks to become positive",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "prior Lyme disease might have persistently positive results",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "vaccination gives positive ELISA, negative Western blot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CSF (patients with polyradiculitis and CN VII neuropathy)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increased protein",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lymphocytic pleocytosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Joint aspiration / Synovial fluid",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "10,000-25,000 WBC/mm3",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lower than baterial septic arthritis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "PMN predominance",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Skin biopsy culture",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Culture on Barbour-Stoenner-Kelly medium",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "use skin edge punch biopsy from erythema migrans lesion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "PCR",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bacterial septic arthritis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "features that differentiate Lyme's diseae from bacterial septic arthritis include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ability to bear weight",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "normal serum WBC",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lower synovial fluid WBC count",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Non-operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "oral antibiotics for mild disease",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "in endemic regions, if erythema migrans is present, start antibiotics **without** blood tests",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
