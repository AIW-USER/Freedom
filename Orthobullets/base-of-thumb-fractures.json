                          "caption": "Y sign"
                        }
                      ],
                      "importance": "5",
                      "children": [
                        {
                          "text": "represents a splitting of the 1st metacarpal base into volar and dorsal fragments",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
