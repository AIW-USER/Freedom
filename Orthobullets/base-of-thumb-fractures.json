    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction and thumb spica casting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "extra-articular fractures with <30 degrees of angulation following closed reduction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Bennett fractures with **<1mm displacement**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "a reduction is achieved with longitudinal **traction, palmar abduction, and pronation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "thumb spica casting",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "fractures greater than 3 weeks old that will no motion at fracture site should be treated allowance of step-off and casting",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction and percutaneous k-wire fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "extra-articular fractures with >30 degrees of angulation following closed reduction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "inability to maintain reduction <30 degrees with thumb spica",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Rolando fracture **<1mm** displacement",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**small fracture fragments that are not amenable to screw fixation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "open reduction internal fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": ">1mm of displacement in Bennett, Rolando, and severely comminuted fractures with **large fracture fragments amenable to fixation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "distraction and external fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "Rolando fracture with >1mm displacement and major soft tissue injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "severely comminuted fractures with major soft tissue injury or impacted articular fragments",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Bennett, Rolando, or severely comminuted fractures with fragments too small for ORIF",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed reduction and percutaneous k-wire fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "a transverse extra-articular fracture can be treated with transarticular k-wire fixation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "oblique extra-articular fractures can be treated with intermetacarpal k-wire fixation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complication specific to this treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "loss of reduction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction internal fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "volar approach of Gedda and Moberg",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "soft tissue",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "thenar muscles are reflected volarly and a longitudinal capsulotomy is made",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "bone work",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fracture is clamped in a volar-dorsal plane",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "fracture provisionally reduced with k-wire and fixed with screws or T-plate depending on fracture pattern",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complication specific to this treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "injury to the superficial branch of the radial nerve",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "wound healing complications if significant edema is present",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "outcomes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "adequacy of anatomic reduction predicts development of radiographic arthritis but does not predict symptomatic arthritis",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Distraction and external fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "instrumentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "two 3mm are placed in the dorsoradial aspect of the distal shaft of the metacarpal",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "two 3mm are placed in the dorsoradial aspect of the radius",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "pins may be placed into the second metacarpal shaft to control deforming forces",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "complications specific to this treatment",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "pin site infection",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
