              "importance": "3",
              "children": [
                {
                  "text": "bennett fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "a small fragment of 1st metacarpal base articulating with trapezium",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "rolando fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Y sign**",
                      "table": null,
