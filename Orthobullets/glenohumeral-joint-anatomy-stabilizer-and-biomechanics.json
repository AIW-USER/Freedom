                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "SGHL/CHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "45° (ER) and 45° abducted",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "MGHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "MGHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "90° (ER)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Anterior band IGHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Anterior band IGHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Posterior band IGHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "90° (forward flexed, abduction, and IR)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Anterior band IGHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "SGHL/CHL",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "SGHL",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3032/images/screen_shot_2017-04-06_at_6.05.21_pm.jpg",
              "caption": "SGHL"
            },
            {
              "src": "https://upload.orthobullets.com/topic/3032/images/arthroscopy%20question%203_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "from anteriosuperior labrum to humerus",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "restraint to **inferior translation at 0° degrees of abduction (neutral rotation)**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "prevents anteroinferior translation of long head of biceps (biceps pulley)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/screen_shot_2017-04-06_at_6.04.38_pm.jpg",
                  "caption": "SGHL prevents ant-inf translation of long head of biceps tendon"
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "MGHL",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3032/images/arthroscopy%20question%203_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "resist **anterior and posterior translation in the midrange** of abduction (~45°) in ER",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "IGHL",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3032/images/arthroscopy%20question%203_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**posterior band IGHL**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most important restraint to **posterior subluxation at 90° flexion and IR**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "tightness leads to **internal impingement** and increased shear forces on superior labrum (linked to SLAP lesions)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**anterior band IGHL**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "stability",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "primary restraint to **anterior/inferior translation 90° abduction** and **maximum ER** (late cocking phase of throwing)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "anatomy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "anchors into anterior labrum",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "forms weak link that predisposes to Bankart lesions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**superior band IGHL**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most important static stabilizer about the joint",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "100% increased strain on superior band of IGHL in presence of a SLAP lesion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Coracohumeral ligament (CHL)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3032/images/screen_shot_2017-04-06_at_6.03.43_pm.jpg",
              "caption": "CHL and SGHL"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "from coracoid to rotator cable",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "limits posterior translation with shoulder in flexion,adduction, and internal rotation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "limits inferior translation and external rotation at adducted position",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Glenoid Labrum (static)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Function",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "helps create cavity-compression and creates 50% of the glenoid socket depth",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Composition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "composed of fibrocartilagenous tissue",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "suprascapular artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "anterior humeral circumflex scapular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior humeral circumflex arteries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "labrum receives blood from capsule and periosteal vessels and not from underlying bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**anterior-superior labrum** has poorest blood supply",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Stability",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anterior labrum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**anchors IGHL** (weak link that leads to Bankart lesion)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "superior labrum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "anchors biceps tendon (weak link that leads to SLAP lesion)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Anatomic variants",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**normal variant**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/variants.jpg",
                  "caption": "Variants in anterosuperior labrum anatomy: (a) normal, (b) sublabral foramen, (c) sublabral foramen + cordlike MGHL, (d) Buford complex (absent anterosuperior labrum + cordlike MGHL)"
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "the labrum attached to the glenoid rim and a flat/broad middle glenohumeral ligament is the most common “normal” variation.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "a cord-like middle glenohumeral ligament is present in 86% of population",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "**sublabral foramen**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/variants.jpg",
                  "caption": "Variants in anterosuperior labrum anatomy: (a) normal, (b) sublabral foramen, (c) sublabral foramen + cordlike MGHL, (d) Buford complex (absent anterosuperior labrum + cordlike MGHL)"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/sublabral%20foramen%20illustration-%20edit%20copy_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "seen in ~12% if population",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**sublabral foramen + cordlike MGHL**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/variants.jpg",
                  "caption": "Variants in anterosuperior labrum anatomy: (a) normal, (b) sublabral foramen, (c) sublabral foramen + cordlike MGHL, (d) Buford complex (absent anterosuperior labrum + cordlike MGHL)"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "**Buford complex (absent anterosuperior labrum + cordlike MGHL)**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/variants.jpg",
                  "caption": "Variants in anterosuperior labrum anatomy: (a) normal, (b) sublabral foramen, (c) sublabral foramen + cordlike MGHL, (d) Buford complex (absent anterosuperior labrum + cordlike MGHL)"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/Buford%20Comples%20-%20%20scope%20view_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/buford%20illustration-edit%20copy_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "seen in ~1.5% of population",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "cordlike middle glenohumeral ligament with attachment to base of biceps anchor and complete absence of the anterosuperior labrum",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "attaching a Buford complex will lead to painful and restricted external rotation and elevation.",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**meniscoid appearance (1%)**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/3032/images/meniscoid%20labrum_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Soft Tissue Stabilizers",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Posterior capsule(static)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thin (< 1mm) with no ligaments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Rotator Interval (static)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "contracture of the rotator interval is seen with adhesive capsulitis (frozen shoulder)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "laxity of the rotator interval results in a visible sulcus sign with inferior laxity with the shoulder in adduction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "includes the capsule, SGHL, coracohumeral ligament and long head biceps tendon that bridge the gap between the supraspinatus and the subscapularis.",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "boundaries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medially by lateral **coracoid base**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "superiorly by anterior edge of **supraspinatus**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "inferiorly by superior border of **subscapularis**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lateral apex formed by **transverse humeral ligament**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Rotator cuff(dynamic)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the primary biomechanical role of the rotator cuff is stabilizing the glenohumeral joint by compressing the humeral head against the glenoid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Biceps Long Head(dynamic)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/3032/images/arthroscopy%20question%203_moved.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "long head of biceps acts as humeral head depressor.",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "variable origin from superior labrum",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "forms weak links that predisposes to SLAP tear",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "SGHL and subscapularis thought to play role in stabilizing long head of biceps",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Osteology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Humeral head",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "greater and lesser tuberosities are attachment sites for the rotator cuff",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "spheroidal in shape in 90% of individuals",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "average diameter is 43 mm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**approximate retroversion 20°** from transepicondylar axis of the distal humerus",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "articular surface inclined upward **130° from the shaft**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Glenoid",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pear-shaped surface with average upward tilt of 5°",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "average version is 5° of retroversion in relation to the axis of the scapular body and varies from **7° of retroversion** to **10° of anteversion**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Coracoid",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "serves as an anatomic landmark or \"lighthouse\" for the deltopectoral approach",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "coracobrachialis, pectoralis minor, and short head of the biceps attach to the coracoid",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Acromion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "3 ossification centers",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "meta (base), meso (mid), and pre-acromion (tip)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "acromiohumeral interval is 7-8mm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AHI may be normal on Xray but decreased on MRI when pt is supine and weight of arm is removed. This usually signifies multiple tendon tear.",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "acromial morphology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "I=flat",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "II=curved",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "III=hooked",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Humeral head",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**ascending branch** of **anterior humeral circumflex artery** and **arcuate artery**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "provides blood supply to humeral head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "vessel runs parallel to lateral aspect of tendon of long head of biceps in the bicipital groove",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "beware not to injure when plating proximal humerus fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "arcuate artery is the interosseous continuation of ascending branch of anterior humeral circumflex artery and penetrates the bone of the humeral head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "posterior humeral circumflex artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**most current literature** supports this as providing the **main blood supply to humeral head**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Free Body Analysis of Deltoid",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Free body diagram if the arm was at 90 degs of abduction (not pictured)",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "assuming A = 3cm and B = 30 cm",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sum of moment M = 0",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "(A x D) - (B x 0.5W) = 0",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "3D = 0.5W (30)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "D = 5W",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Arthrodesis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "optimal position",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "15-20° of abduction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "20-25° of forward flexion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "40-50° of internal rotation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
