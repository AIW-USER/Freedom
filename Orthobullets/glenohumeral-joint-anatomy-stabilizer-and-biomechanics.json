{
  "title": "Glenohumeral Joint Anatomy, Stabilizer, and Biomechanics",
  "url": "https://www.orthobullets.com/shoulder-and-elbow/3032/glenohumeral-joint-anatomy-stabilizer-and-biomechanics",
  "subtitle": "Updated: Sep 9 2022",
  "sections": [
    {
      "text": "Planes of Motion",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Reference",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "scapular plane is 30 degrees anterior to coronal plane.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Abduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "abduction requires external rotation to clear the greater tuberosity from impinging on the acromion.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "therefore if someone has an internal rotation contracture they can not abduct > 120",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "180° of abduction present in shoulder",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "motion occurs at two joints",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "120° from the glenohumeral joint (2/3)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**60° from the scapulothoracic joint (1/3)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Glenohumeral Stability",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Static restraints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**glenohumeral ligaments (below)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**glenoid labrum (below)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**articular congruity and version**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**negative intraarticular pressure**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "if release head will sublux inferiorly",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Dynamic restraints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**rotator cuff muscles**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the primary biomechanical role of the rotator cuff is stabilizing the glenohumeral joint by compressing the humeral head against the glenoid",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**rotator interval**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**biceps long head**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**periscapular muscles**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
