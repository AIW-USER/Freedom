{
  "title": "Poliomyelitis",
  "url": "https://www.orthobullets.com/foot-and-ankle/7048/poliomyelitis",
  "subtitle": "Updated: Apr 26 2025",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Poliomyelitis is a disease caused by viral destruction of the anterior horn cells in the spinal cord and brain stem motor nuclei.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with presence of motor weakness with normal sensation in a patient with history of polio.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on degree of functional limitation and presence of secondary contractures.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "has been eradicated in the United States with the use of a vaccine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "majority of individuals with infection (75%) will remain asymptomatic",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Postpolio syndrome**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "an aging phenomenon where more nerve cells become inactive with time",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "it does not represent reactivation of the virus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "occurs after middle age",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "occurs in up to 50% of polio cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "leads to increasing difficulty performing activities of daily living",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "patients should exercise at sub-exhaustion levels to tone affected muscle groups without causing muscle breakdown",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "hallmark is muscle weakness with **normal sensation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Postpolio Syndrome",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "nonoperative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "limited exercise with periods of rest, +/-lightweight orthosis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "first line of treatment",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "technique",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "goal is to maintain but not overuse muscles",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "operative",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "tendon transfers, contracture releases, and arthrodesis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "used to optimize functional capacity",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
