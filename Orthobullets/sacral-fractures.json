                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Zone 3",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Fracture medial to foramina into the spinal canal **Highest rate of neurologic deficit** (60%)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1032/images/zone%203.jpg",
                          "caption": "Zone 3 radiograph"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Transverse sacral fractures",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/transverse%20sacral%20illustration.jpg",
              "caption": "trasnverse sacral fracture illustration"
            },
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/transverse%20ct.jpg",
              "caption": "Transverse sacral fracture CT"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "higher incidence of nerve dysfunction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "U-type sacral fractures",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/u-type.jpg",
              "caption": "U-type illustration"
            },
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/u-type%20radiograph.jpg",
              "caption": "U-type radiograph"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "results from axial loading",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "represent spino-pelvic dissociation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "high incidence of neurologic complications",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "motor vehicle accident or fall from height most common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "repetitive stress",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "insufficiency fracture in osteoporotic adults",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**peripelvic pain**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "soft tissue trauma around pelvis should raise concerns for pelvic or sacral fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "palpation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "test pelvic ring stability by internally and externally rotating iliac wings",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "palpate for subcutaneous fluid mass indicative of lumbosacral fascial degloving **(Morel-Lavallee lesion)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "perform vaginal exam in women to rule-out open injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurologic exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "rectal exam",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "light touch and pinprick sensation along S2-S5 dermatomes",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1032/images/lower%20extremity%20dermatomes.jpg",
                      "caption": "Lower extremity dermatomes"
                    }
                  ],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "perianal wink",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bulbocavernosus and cremasteric reflexes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "vascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "distal pulses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "if different consider ankle-brachial index or angiogram",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**only show 30% of sacral fractures**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "effective screening tool for sacral fractures",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "often of poor quality",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "inlet view",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1032/images/inlet%20view.jpg",
                      "caption": "Inlet View"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "best assessment of sacral spinal canal and superior view of S1",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outlet view",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1032/images/outlet.jpg",
                      "caption": "outlet view of sacrum"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "provides true AP of sacrum",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "L4 or L5 transverse process fractures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "asymmetric foramina",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "anterior pelvic ring disruptions",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "stepladder sign",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1032/images/5fcfaabe-b122-4e13-94cc-0bc60faa6ac1_stepladder..jpg",
                      "caption": "Stepladder sign"
                    }
                  ],
                  "importance": "1",
                  "children": [
                    {
                      "text": "seen on AP view",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "results from displacement with overriding of transverse fracture fragments",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "indicates disruption of anterior sacral foramina and lumbrosacral facets",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnostic **study of choice**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "recommend coronal and sagittal reconstruction views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended when **neural compromise** is suspected",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "progressive weight-bearing +/- orthosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "<1 cm displacement and no neurologic deficit",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "insufficiency fractures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "surgical fixation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "displaced fractures >1 cm",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "soft tissue compromise",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "persistent pain after non-operative management",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "displacement of fracture after non-operative management",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "surgical fixation with decompression",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "any evidence of neurologic injury",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Percutaneous screw fixation**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "screws may be placed as sacroiliac, trans-sacral or trans-iliac trans-sacral",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1032/images/ap%20pelvis%20of%20sacral%20screws.jpg",
                  "caption": "Sacral screws"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "useful for sagittal plane fractures",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "screws placed percutaneously under fluoroscopy",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "beware of **L5 nerve root**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**avoid overcompression** of fracture",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may cause iatrogenic nerve dysfunction",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "screw placement posterior to the ICD ensures safe screw placement",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "non-dysmorphic sacrum",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "cons",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "may result in loss of fixation or malreduction",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "does not allow for removal of loose bone fragments",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "do not use in osteoporotic bone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Posterior tension band plating**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/sacral_fx_1o.jpg",
              "caption": "Sacral plating"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "posterior two-incision approach",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1032/images/psoterior%20incision.jpg",
                      "caption": "Posterior two-incision approach"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "may use in addition to iliosacral screws",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "pros",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "allows for direct visualization of fracture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "cons",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "wound healing complications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Iliosacral and lumbopelvic fixation**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/iliolumbar.jpg",
              "caption": "Iliolumbar fixaiton radiograph"
            },
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/iliolumbar%20radiograph.jpg",
              "caption": "Iliolumbar fixation radiograph"
            }
          ],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "posterior approach to lower lumbar spine and sacrum",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "pedicle screw fixation in lumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "iliac screws parallel to the inclination angle of outer table of ilium",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "longitudinal and transverse rods",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "pros",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "shown to have **greatest stiffness** when used for an unstable sacral fracture",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "lumbopelvic fixation for spinopelvic dissociation provides adequate stability for mobilization",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "cons",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "invasive",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Decompression of neural elements**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indirect",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "reduction through axial traction",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "direct",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "posterior approach followed by laminectomy or foraminotomy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Venous thromboembolism**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "often as a result of immobility",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Iatrogenic nerve injury**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "may result from",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "overcompression of fracture",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "improper hardware placement",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Malreduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "more common with vertically displaced fractures",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Presence of a neurologic deficit is the **most important factor in predicting outcome**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "**Displacement confers an increased risk of neurologic dysfunction**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Mistreated fractures may result in",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "lower extremity deficits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "urinary dysfunction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "rectal dysfunction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "sexual dysfunction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
