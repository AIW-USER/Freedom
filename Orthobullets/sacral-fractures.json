{
  "title": "Sacral Fractures",
  "url": "https://www.orthobullets.com/trauma/1032/sacral-fractures",
  "subtitle": "Updated: Jul 30 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Sacral fractures are common pelvic ring injuries that are under-diagnosed and often associated with neurologic compromise.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can made with pelvis radiographs but frequently require pelvic CT scan for full characterization.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on fracture displacement, associated pelvic ring instability and patient activity demands.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "common in pelvic ring injuries (30-45%)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Bimodal distribution",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "young adults",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "as a result of high energy trauma",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "elderly",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "as a result of low energy falls",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associate injuries",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**25% are associated with neurologic injury**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "frequently missed",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "75% in patients who are neurologically intact",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "50% in patients who have a neurologic deficit",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/sacrum.jpg",
              "caption": "Anatomy of the sacrum"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "formed by fusion of 5 sacral vertebrae",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "articulates with",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "5th lumbar vertebra proximally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "coccyx distally",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "ilium laterally at sacroiliac joints",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "contains 4 foramina which transmit sacral nerves",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Nerves",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1032/images/nerves%20of%20sacrum.jpg",
              "caption": "Nerves of sacrum"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "L5 nerve root runs **on top of sacral ala**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "S1-S4 nerve roots are transmitted through the sacral foramina",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "S1 and S2 nerve roots carry higher rate of injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "lower sacral nerve roots (S2-S5)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "function",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "anal sphincter tone / voluntary contracture",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bulbocavernosus reflex",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "perianal sensation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "unilateral preservation of nerves is adequate for bowel and bladder control",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "transmission of load distributed by first sacral segment through iliac wings to the acetabulum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
