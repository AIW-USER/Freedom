{
  "title": "Bone Remodeling",
  "url": "https://www.orthobullets.com/basic-science/9008/bone-remodeling",
  "subtitle": "Updated: Jun 16 2021",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Wolff's Law",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bone remodels in response to mechanical stress",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Piezoelectric charges",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bone remodels in response to electric charges",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**compression side is electronegative** and stimulates osteoblast **formation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**tension side is electropostive** and stimulates **osteoclasts**",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Hueter-Volkmann Law",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "theory that bone remodels in small packets of cells known as Basic Multicellular Units (BMUs)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "theory suggest that mechanical forces influence longitudinal growth",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "compressive forces inhibit growth",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "may play role in scoliosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Remodeling Mechanism",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cortical bone",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "remodels by osteoclastic tunneling (cutting cone)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**osteoclastic resorption > layering of osteoblasts > layering** of lamellae > cement line laid down",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "osteoclast make up head of cutting cone, followed by capillaries and then osteoblasts which lay down the osteoid to fill the cutting cone",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "sclerostin inhibits osteoblastogenenesis to decrease bone formation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "cortical bone continues to change over time",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "cortical area decreases as age increases",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "linked to increase fracture risk",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "medullary canal volume increases as age increases",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Cancellous bone remodels by",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**osteoclastic resorption**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "osteoblastic deposition of layers of lamellae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
