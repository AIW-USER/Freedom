{
  "title": "Non-Ossifying Fibroma",
  "url": "https://www.orthobullets.com/pathology/8027/non-ossifying-fibroma",
  "subtitle": "Updated: Jan 7 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Non-Ossifying Fibromas are benign fibrogenic lesions that result from dysfunctional ossification that are most commonly found in the metaphysis of long bones. Patients typically present between the ages of 5 and 15 with an asymptomatic lesion discovered incidentally on radiographs.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made on radiographs with a characteristic metaphyseal eccentric \"bubbly\" lytic lesion surrounded by a sclerotic rim.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is observation as most lesions resolve spontaneously.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "occurs in 30-40% of skeletally immature children",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in **males** (2:1)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "common in children 5-15 years old",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**metaphysis** of long bones",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "80% in lower extremity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**distal femur > proximal tibia > distal tibia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "uncommon in proximal femur, proximal humerus",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "non-ossifying fibroma (NOF) is a benign fibrogenic lesion that is related to dysfunctional ossification",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "one of the **most common benign bone tumors in childhood (with osteochondroma)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "other names",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "metaphyseal fibrous defect",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "nonosteogenic fibroma",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "cortical desmoid",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "fibrous cortical defect",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "fibromatosis",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "fibroxanthoma",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "possibly due to abnormal osteoclastic resorption at the subperiosteal level during remodeling of the metaphysis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Jaffe-Campanacci syndrome**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "congenital syndrome of multiple non-ossifying fibromas and",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "cafe au lait pigmentation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "mental retardation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "heart, eyes, gonads involved",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**neurofibromatosis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "familial multifocal NOF",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ABC",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**asymptomatic**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "usually found incidentally",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "may present with pathologic fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diagnostic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**metaphyseal eccentric** \"**bubbly**\" lytic lesion surrounded by sclerotic rim",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8027/images/5a_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "cortex may be expanded and thin",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "length > width",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "as bone grows",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "migrates to diaphysis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lesions enlarge (1-7cm)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "as patient approaches skeletal maturity, lesions become sclerotic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "avulsion of adductor magnus insertion in the posteromedial aspect of the distal femur may produce a similar looking lesion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**quantitative CT** shown to be useful in predicting fracture risk",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classic characteristics are",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**fibroblastic spindle cells** in **whirled or storiform pattern** (helicopter in wheat field)",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8027/images/Histology%20A%20-%20low%20power%20-%20Parsons_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "fibroblastic connective tissue background",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "numerous **lipophages and giant cells**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8027/images/Histology%20B%20-%20high%20power%20-%20Parsons_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**hemosiderin pigmentation**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8027/images/Histology%20C%20-%20low%20power%20-%20Parsons_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "occasional ABC component",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Giant cell tumor",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "painful",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "rare in skeletally immature",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "no mineralization",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Osteosarcoma",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "painful",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "irregular zone of bony destruction with less defined zone of transition",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "periosteal reaction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "mineralized soft tissue mass",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
