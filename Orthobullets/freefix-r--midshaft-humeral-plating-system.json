          "importance": "-1",
          "children": [
            {
              "text": "Distal Humerus Plating System",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Midshaft Humerus Plating System **(this topic)**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "The Skeletal Dynamics Humeral Fixation Set contains bone plates for the repair of distal and midshaft humerus fractures.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Included in the set are bone screws, K-Wires, and specialized instrumentation.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
