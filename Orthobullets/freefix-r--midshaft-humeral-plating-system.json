    {
      "text": "Approach",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "A posterior longitudinal incision, with exposure of the midshaft of the ulna through subperiosteal dissection along the dorsal aspect.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Exposure",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Expose the humerus using the optimal approach for the fracture location.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/aa13fa14-e318-4ba1-974e-4eb691b2ad19_screenshot_2025-08-13_at_3.51.31_pm.jpg",
                  "caption": "Expose the humerus using the optimal approach for the fracture location"
                }
              ],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Reduce Fracture",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Debride and reduce the fracture.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/293e2ea2-293e-48c4-9f6f-48b3d4c19f6c_screenshot_2025-08-13_at_3.52.46_pm.jpg",
                  "caption": "Debride and reduce the fracture"
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Address fracture pattern using lag screws as needed.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Bone clamps are useful for provisional fixation.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Insert Lag Screw",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "If the fracture does not require use of a Lag Screw, proceed to plate selection.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Place the lag screw as perpendicularly as possible to the fracture line.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/6e46906f-0434-4a49-bbb4-a9bb725dff81_screenshot_2025-08-13_at_3.53.31_pm.jpg",
                  "caption": "Place the lag screw as perpendicularly as possible to the fracture line."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Use the 3.5mm x 50mm Drill Bit with the tissue protector Drill Guide to drill the near cortex,",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Insert the 2.7mm end of the Guide into the hole previously drilled and use the 2.7mm x 50mm Drill Bit to drill through the far cortex.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Countersinking the near cortex may be required to limit screw head prominence. Measure and insert the desired 3.5mm Cortex Screw.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Plate Selection",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Select the appropriate plate type and length.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/451aa8bc-94d9-4e16-9055-b8c53f0aba5d_screenshot_2025-08-13_at_3.57.34_pm.jpg",
                  "caption": "Select the appropriate plate type and length."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Six cortices are recommended proximal and distal to the extent of the fracture.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Forceps can be used to aid in plate placement or fracture reduction.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "If needed, use bending irons to bend the plate for precise anatomical fit.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Plate Fixation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Utilizing the center hole of the Drill Guide, drill a pilot hole in a chosen FreeFix® Slot on one side of the fracture.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/94f72ec6-40d9-4f66-960f-216e61305d2c_screenshot_2025-08-13_at_3.59.25_pm.jpg",
                  "caption": "Utilizing the center hole of the Drill Guide, drill a pilot hole in a chosen FreeFix® Slot on one side of the fracture."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Using the FreeFix® scale of the Depth Gauge, measure then insert a 4.5mm Compression Screw (non-locking cortical screw) and tighten with the T-15 Driver.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Repeat this step on the opposite side of the fracture to compress the plate to the bone.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Dynamic Compression",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Place the drill guide in the chosen slot, ensuring the off-center hole of the guide is furthest from the fracture.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/c98cb235-c2da-4f2b-8a41-fc6277a6bfb9_screenshot_2025-08-13_at_4.00.17_pm.jpg",
                  "caption": "Place the drill guide in the chosen slot, ensuring the off-center hole of the guide is furthest from the fracture."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Drill through the off-center hole, then measure using the depth gauge to determine the appropriate screw length.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Before engaging the head of the screw with the threads of the FreeFix® slot, loosen any previously placed screws on the corresponding side of the fracture. Then tighten the screw for dynamic compression.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Once the screw is fully seated, retighten any previously loosened screws.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Final Plate Fixation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Fill the necessary screw holes on each side of the fracture to provide the recommended minimum six cortices of stability.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/bb22df47-5212-426d-9884-da0e65b5440c_screenshot_2025-08-13_at_4.02.02_pm.jpg",
                  "caption": "Fill the necessary screw holes on each side of the fracture to provide the recommended minimum six cortices of stability."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "The thread-in drill guide can be used to insert screws at any location within the slots.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Final Confirmation",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Confirm proper reduction, alignment and screw length with fluoroscopy.",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/423274/images/f37e923d-23c2-4ef9-a919-63b055d784d4_screenshot_2025-08-13_at_4.02.52_pm.jpg",
                  "caption": "Confirm proper reduction, alignment and screw length with fluoroscopy."
                }
              ],
              "importance": "-1",
              "children": []
            },
            {
              "text": "Close the incision in the usual fashion.",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
