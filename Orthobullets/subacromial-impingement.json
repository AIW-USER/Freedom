    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**insidious onset**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**exacerbated by overhead activities and lifting objects away from body**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**night pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "poor indicator of successful nonoperative management",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "strength",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**usually normal**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "impingement tests (see complete physical exam of shoulder)",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**positive Neer impingement sign**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "positive if passive forward flexion >90° causes pain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**positive Neer impingement test**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "if a subacromial injection relieves pain associated with passive forward flexion >90°",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**positive Hawkins test**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "positive if internal rotation and passive forward flexion to 90° causes pain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Jobe test**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "pain with resisted pronation and forward flexion to 90° indicates supraspinatus pathology",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Painful Arc Test",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "pain with arm abducted in scapular plane from 60° to 120°",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3041/images/painful_arc_test_copy.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Yocum Test",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "positive if pain reproduced with elbow elevation while ipsilateral hand placed on contralateral shoulder",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "sensitive but nonspecific",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "Internal Impingement test",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "positive if pain is elicited with abduction and external rotation of the shoulder",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**true AP of the shoulder**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "useful in evaluating the acromiohumeral interval",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "normal distance is 7-14 mm",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**30° caudal tilt view**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "useful in identifying subacromial spurring",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**supraspinatus outlet view**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "useful in defining acromial morphology",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "common radiographic findings associated with impingement",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "proximal migration of the humerus as seen in rotator cuff tear arthropathy",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3041/images/cuff%20tear%20arthropathy.jpg",
                          "caption": "Shows cuff tear arthropathy"
                        }
                      ],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "traction osteophytes",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "calcification of the coracoacromial ligament",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "cystic changes within the greater tuberosity",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**Type III-hooked acromion**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "associated with impingment",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "os acromiale",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3041/images/os%20acromiale%20supraspinatus%20outlet%20view.jpg",
                          "caption": "Shows an os acromiale"
                        }
                      ],
                      "importance": "2",
                      "children": [
                        {
                          "text": "best seen on axillary lateral",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful in evaluating the degree of rotator cuff pathology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "subacromial and subdeltoid bursisits often seen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT arthography",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can also accurately image the rotator cuff tendons and muscle bellies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Ultrasound",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "can also accurately image the rotator cuff tendons and muscle bellies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tendinopathy histology shows",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**disorganized collagen fibers**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**mucoid degeneration**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**inflammatory cells**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**inflammation of the subacromial bursa**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "high levels of metalloproteases and other inflammatory cytokines",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "physical therapy, oral anti-inflammatory medication, subacromial injections",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "first line and mainstay of treatment of subacromial impingement alone without rotator cuff tear",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "aggressive rotator cuff strengthening and periscapular stabilizing exercises",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "an integrated rehabilitation program is indicated in the presence of scapular dyskinesia which aims to regain full shoulder range of motion and coordinate the scapula with trunk and hip motions",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "**platelet-rich plasma injections**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "most recent meta-analysis showing insufficient evidence to support use",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "subacromial decompression / acromioplasty",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "subacromial impingement syndrome that has failed a minimum of 4-6 months of nonoperative treatment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "poor subjective outcomes have been observed after acromioplasty in patients with",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "workers' compensation claims",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "anxiety and depression",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Technique",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Subacromial decompression and acromioplasty**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**acromioplasty**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "two-step procedure performed open or arthroscopically",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "an **anterior acromionectomy** is performed first",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "the anterior deltoid origin determines the extent of the acromionectomy when performed arthroscopically and must remain intact",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "an **anteroinferior acromioplasty** to smooth the undersurface of the acromion follows as the second step of the procedure",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "a bone rasp is used if performed open",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "a shaver or burr is used if performed arthroscopically",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "the deltoid is meticulously repaired to bone in open procedures",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**treatment of an os acromiale**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "a two-stage procedure may be required with the presence of an os acromiale to avoid deltoid dysfunction caused by direct excision",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "the os acromiale is first fused with bone graft and allowed to heal",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/3041/images/fused%20os%20acromiale.jpg",
                          "caption": "Shows internal fixation of an os acromiale with bone graft"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "an acromioplasty is then performed as a separate second procedure",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Deltoid dysfunction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "resulting from a failed deltoid repair following an open acromioplasty or an excessive acromionectomy during an arthroscopic procedure",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "secondary to direct excision of an os acromiale",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Anterosuperior escape**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "avoid acromioplasty and CA ligament release to preserve the coracoacromial arch in patients with massive, irreparable rotator cuff tears",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
