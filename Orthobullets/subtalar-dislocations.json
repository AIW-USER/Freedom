    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Closed reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "sedation",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "requires adequate sedation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "reduction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "typical maneuvers include knee flexion and ankle plantarflexion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "followed by distraction and hindfoot inversion or eversion depending on direction of dislocation",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "post-reduction",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "perform a post-reduction CT to look for associated injuries",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Open reduction**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "anesthesia",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "dictated by direction of dislocation and associated fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "medial dislocation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "sinus tarsi approach to remove incarcerated lateral structures (EDB, etc.)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "lateral dislocation",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "medial approach between tibialis anterior and posterior tibial tendon to remove medial structures (posterior tibialis tendon, etc.)",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        },
                        {
                          "text": "may still require sinus tarsi/lateral approach to remove subtalar debris",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "post-op care",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "if joint stable",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "place in short leg cast with non-weightbearing for 4-6 weeks",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "if joint remains unstable",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "place temporary transarticular pins or spanning external fixator",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Post-traumatic arthritis**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "long-term follow up of these injuries show degenerative changes",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "subtalar joint most commonly affected with up to 89% of patients demonstrating radiographic arthrosis (**63% symptomatic)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Stiffness**",
