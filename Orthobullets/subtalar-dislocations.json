{
  "title": "Subtalar Dislocations",
  "url": "https://www.orthobullets.com/trauma/1050/subtalar-dislocations",
  "subtitle": "Updated: Feb 16 2026",
  "sections": [
    {
      "text": "Summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Subtalar Dislocations are hindfoot dislocations that result from high energy trauma.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically and confirmed with orthogonal radiographs of the foot.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is a trial of closed reduction but may require open reduction given the several anatomic blocks to reduction.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "accounts for 1% of all dislocations",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "< 1 per 100,000 per year",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in young or middle-aged males",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Pathophysiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "typically result from a high-energy mechanism",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**25% may be open**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1050/images/soft%20tissue%20injury.jpg",
                      "caption": "shows lateral tension failure of soft tissue with subtalar dislocation"
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**lateral dislocations more likely to be open**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "associated dislocations",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "talonavicular",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "associated fractures (up to 44%)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "with **medial dislocation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "dorsomedial talar head",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "posterior process of talus",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/weatherford_110919_-5.jpg",
                          "caption": "shows open medial subtalar dislocation"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/weatherford_110919_-7.jpg",
                          "caption": "shows posterior tubercle fracture"
                        }
                      ],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "navicular",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "with **lateral dislocation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "cuboid",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "anterior calcaneus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "lateral process of talus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fibula",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Articulation",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1050/images/024cb871-7097-4c2d-8f84-36f2eb43ae15_tarsus.jpg",
              "caption": "Tarsal facets and articulations"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "inferior surface articulates with **posterior facet of calcaneus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**talar head** articulation",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "navicular bone",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "sustenaculum tali",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "navicular bone",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "sustenaculum tali",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "**lateral process** articulates with",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "posterior facet of calcaneus",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "lateral malleolus of fibula",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**posterior process** consist of medial and lateral tubercles separated by groove for FHL",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "talus has no muscular or tendinous attachments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Blood Supply",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/1050/images/b2975cf5-81c8-4d0d-8b7d-5cd738a89c4e_blood_supply..jpg",
              "caption": "Blood supply to the talus"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**posterior tibial** artery",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "via **artery of tarsal canal** (most important and main supply)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "supplies most of talar body",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "via calcaneal braches",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "supplies posterior talus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**anterior tibial artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "supplies head and neck",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**perforating peroneal** arteries via **artery of tarsal sinus**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "supplies head and neck",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**deltoid artery** (located in deep segment of deltoid ligament)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "supplies body",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "may be only remaining blood supply with a talar neck fracture",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomic",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Anatomic**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**(based on dislocation direction of midfoot/forefoot)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Medial dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**most common (65-80%)**, due to lateral malleolus acting as strong buttress, preventing lateral dislocation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "results from inversion force on plantarflexed foot",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "associated with posterior process of talus, dorsomedial talar head, and navicular fracture",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/6a27cc87-8ae2-41d9-b8ea-0a0fb1093f06_medial_dislocation..jpg",
                          "caption": "Medial dislocation"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/Xray%20-%20AP%20-%20Medial%20subtalar%20dislocation%20(e-rediography)_moved.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Lateral dislocation",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "more likely to be open",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "results from eversion force on plantarflexed foot",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "anterior process of calcaneus acts as fulcrum for the anterolateral corner of the talus to pivot around",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "foot becomes locked in **pronation**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "associated with lateral process of talus, anterior calcaneus, cuboid, and fibula fractures",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/75e9964e-0449-4b36-9d44-7cea5e5e9f30_lateral_dislocation..jpg",
                          "caption": "Lateral dislocation"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/lateral%20subtalar%20dislocation%20xr.jpg",
                          "caption": "shows talar head inferior to navicular"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Anterior dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "rare",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Posterior dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "rare",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Total dislocation",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "talus is completely dislocated from ankle and subtalar and talonavicular joints",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "usually open",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "foot will be locked in supination with medial dislocation",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1050/images/clinical%20photo%20subtalar%20dislocation.jpg",
                  "caption": "shows hyper-supinated foot with medial dislocation"
                }
              ],
              "importance": "2",
              "children": [
                {
                  "text": "known as \"acquired clubfoot\"",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "foot will be locked in pronation with lateral dislocation",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/1050/images/clinical%20photo%20lateral%20subtalar%20dislocation.jpg",
                  "caption": "shows pronated position of foot with lateral dislocation"
                }
              ],
              "importance": "2",
              "children": [
                {
                  "text": "known as \"acquired flatfoot\"",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "medial dislocation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "talar head will be superior to navicular on lateral view",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/medial%20subtalar%20dislocation.jpg",
                          "caption": "shows talar head superior to navicular"
                        }
                      ],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral dislocation",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "talar head will be collinear or inferior to navicular on lateral view",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/75e9964e-0449-4b36-9d44-7cea5e5e9f30_lateral_dislocation..jpg",
                          "caption": "Lateral dislocation"
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/1050/images/lateral%20subtalar%20dislocation%20xr.jpg",
                          "caption": "shows talar head inferior to navicular"
                        }
                      ],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "perform following reduction",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "look for associated injuries or subtalar debris",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1050/images/ct%20subtalar%20dislocation.jpg",
                      "caption": "shows subtalar osteochondral fragment causing residual subluxation"
                    }
                  ],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "closed reduction and short leg non-weight bearing cast for 4-6 weeks",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
