{
  "title": "Freiberg's Disease",
  "url": "https://www.orthobullets.com/foot-and-ankle/7018/freibergs-disease",
  "subtitle": "Updated: Mar 25 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Freiberg's Disease is a rare foot condition characterized by infarction and fracture of the metatarsal head.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with plain radiographs showing subchondral sclerosis, flattening of the involved MT head and eventual joint destruction in advance disease. MRI studies may be needed to detect early disease.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is activity modification and NSAIDs in early disease. Surgical management is indicated for progressive pain, joint destruction and joint deformity.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "female to male = ~ 4:1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most commonly seen in patients 13-18 years",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "more common in female adolescent athletes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**most often seen in 2nd metatarsal (MT) head**, particularly the dorsal aspect",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "4th and 5th MT rarely affected",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more common in patients with long 2nd metatarsals",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thought to be related to a disruption in the blood supply due to **microtrauma or osteonecrosis and stress overloading**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "leads to eventual collapse of 2nd MT head",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Smillie Classification**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage 1",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Subchondral fracture visible only on MRI",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/sim.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/freibergmri.jpg",
                          "caption": "mri"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage 2",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Dorsal collapse of articular surface on plain radiographs",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/sim.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/stage%202.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage 3",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Collapse of dorsal MT head, with plantar articular portion intact",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/sim.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/stage%203.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage 4",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Collapse of entire MT head, joint space narrowing",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/sim.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/freiberg4.jpg",
                          "caption": "4"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Stage 5",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Severe arthritic changes and joint space obliteration",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/sim.jpg",
                          "caption": ""
                        },
                        {
                          "src": "https://upload.orthobullets.com/topic/7018/images/stage%205.jpg",
                          "caption": ""
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "forefoot pain, swelling and stiffness localized to head of the second MT",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "worse with weight bearing activities",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "peri-articular swelling",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "exacerbated by distraction (early stages) and compaction (later stages)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "limitation of motion in 2nd MTP joint",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP, lateral, obliques of foot",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings (see Smillie classification)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**subchondral sclerosis** in early disease",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**flattening** of involved MT head",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7018/images/freibergflat.jpg",
                      "caption": "xray"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**joint destruction** in late disease",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7018/images/joint%20destruction.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "defect is usually located in the upper half of the articular surface of the MT head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can show patchy edema in metatarsal head",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7018/images/freibergmri.jpg",
                      "caption": "mri"
                    }
                  ],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "activity limitations, NSAIDS, immobilization",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "early stage of disease",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**short leg walking cast or boot for 4-6 weeks**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "can be used if symptoms are severe and do not improve with orthotics",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**stiff-soled shoe with MT bars or pads**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "typically used after period of casting",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "metatarsophalangeal arthrotomy with removal of loose bodies",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "very rarely indicated",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "only if extensive nonoperative management fails",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "dorsal closing-wedge osteotomy",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7018/images/dorsiflexion%20osteotomy.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "dorsal disease involvement of bone and cartilage",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "recent literature suggests that end-stage joint destruction without plantar-surface sparing has been shown to lead to poor outcomes",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "DuVries arthroplasty (partial MT head resection)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7018/images/duvries1.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/7018/images/duvries2.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/7018/images/duvries%203yr,%205yr.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "severe stage 4 or 5 disease",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "plantar cartilage is not sufficient to reconstruct joint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "can consider adding capsular interposition after joint debridement",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Metatarsophalangeal arthrotomy with removal of loose bodies**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lesser toe MTP joint approach",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "may be combined with **drilling of metatarsal head, subchondral bone grafting, and interposition arthroplasty using EDL tendon**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "metatarsal head resection should be avoided due to increased loads on adjacent metatarsal heads",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Dorsal closing-wedge osteotomy**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "goals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "shortening offloads stress on metatarsal head",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "resects collapsed dorsal diseased bone and cartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "lesser toe MTP joint approach",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "technique",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "bring less affected plantar cartilage into contact with proximal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Degenerative joint disease**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "of 2nd MTP joint in adulthood",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
