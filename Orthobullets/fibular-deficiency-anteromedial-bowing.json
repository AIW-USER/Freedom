                  "bullets": [
                    {
                      "text": "Type IA",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "A portion of fibula remains present but proximal fibular epiphysis is distal to level of proximal tibial physis while distal fibula is proximal to the talus.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Heel lift (if LLD >2cm)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
