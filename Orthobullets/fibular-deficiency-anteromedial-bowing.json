      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Achterman & Kalamchi",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "based on amount of fibula present",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "",
