    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "classic findings",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4055/images/fibular%20hemimelia.jpg",
                  "caption": "Shows Fibular Deficiency"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**short limb**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**skin dimpling over midanterior tibia**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**equinovalgus foot**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "other findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often missing lateral toes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "genu valgum",
                  "table": null,
                  "images": [],
