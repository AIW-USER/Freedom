{
  "title": "Tendons",
  "url": "https://www.orthobullets.com/basic-science/9015/tendons",
  "subtitle": "Updated: Dec 24 2025",
  "sections": [
    {
      "text": "Function",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Transfer forces from muscle to bone to produce joint motion",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Tendons orient themselves along stress",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Types",
      "table": null,
      "images": [],
      "importance": "4",
      "children": [
        {
          "text": "**Paratenon covered tendons**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**e.g., patellar, achilles tendons**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "have rich **vascular supply** and thus heal better",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "often injured due to trauma and most often fail at the",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**musculotendinous junction**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**tendon-bone junction**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Sheathed tendons**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**e.g., hand flexor tendons**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "less vascularized and have avascular areas that receive **nutrition by diffusion**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "often injured due to laceration and at risk for **adhesions**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Composition",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "groups of collagen bundles (fascicles) separated by endotenon and surrounded by epitenon",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "composed of",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "water",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "tendons primarily composed of water",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "collagen",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**Type I collagen** makes up 85% of dry weight of tendons",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**Type III collagen make up 0-5% of dry weight of tendons**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "proteoglycans",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "make up 0-5% of dry weight of tendons",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**decorin**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "is the most predominant proteoglycan in tendon",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "regulates collagen fiber diameter (length of 300nm, diameter of 1.5nm)",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "forms cross-links between collagen fibers and transfers loads between collagen fibers",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**aggrecan**",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "is proteoglycan found in areas of tendon compression",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Structure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "has a highly ordered hierarchical structure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "microfibrils",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9015/images/heirarchy2.jpg",
                  "caption": "hierarchical structure"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "insert into bone via 4 transitional tissues of increasing modulus",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9015/images/4_layers.jpg",
                  "caption": "4 layers at insertion site"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "tendon",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "type I and III collagen, elastin, proteoglycans, tendon fibroblasts",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "uncalcified fibrocartilage",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "aggrecan, types I, II and III collagen, fibrochondrocytes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "tidemark - straight, basophilic line separating uncalcified and calcified fibrocartilage, a mechanical boundary between soft-hard tissue",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "calcified fibrocartilage (separated from fibrocartilage by tidemark)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "type II collagen, aggrecan, types I and X collagen, fibrochondrocytes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "irregular boundary, with interlocking of calcified fibrocartilage zone with bone",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "bone",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "osteocytes, osteoclasts, osteoblasts, type I collagen, apatite",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the musculotendinous junction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "the osseotendinous junction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "vessels from various surrounding connective tissue (such as the paratenon, mesotenon and vincula)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "FDS and FDP tendons have 2 vincula each (vincula longa and vincula brevia)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Cell biology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**fibroblasts** are predominant cell type",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**spindle shaped** and arranged in parallel rows in direction of muscle loading",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/9015/images/myofibroblast.jpg",
                      "caption": "myofibroblast"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "produce mostly type I collagen (85% of dry weight of tendons)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "produce small amount of type III collagen (5% of dry weight)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "responsible for healing process",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 4,
                  "bullets": [
                    {
                      "text": "**Fibrous vs. Fibrocartilaginous Enthesis**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Fibrous Enthesis*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "(Indirect Attachment)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Fibrocartilaginous Enthesis (Direct Attachment)*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Attachment",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Metaphysis and diaphysis of long bones",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Epiphysis and apophysis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/9015/images/physis_tendon.jpg",
                          "caption": "Physis ligament strain"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Composition",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Perforating mineralized collagen fibers",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "4 distinct zones (tendon, fibrocartilage, calcified fibrocartilage, and bone)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Angle of Insertion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Insertion angle changes slightly during motion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Insertion angle changes greatly during motion (thus prone to overuse injury)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Example",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Deltoid-humerus attachment, adductor magnus-linea aspera attachment, pronator teres attachment",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Rotator cuff, Achilles tendon",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Material Properties",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Characteristics",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9015/images/tendon_properties_1.jpg",
              "caption": "load elongation curve"
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "tendons contain more collagen and are **less viscoelastic than ligaments**",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9015/images/mcl_strain.jpg",
                  "caption": "MCL strain"
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "tendon enthesis contains free nerve endings responsible for nociception",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "viscoelastic behavior with nonlinear elasticity",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the rate at which tendon sees force can influence the mechanical property",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "biomechanical effects",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "exercise has positive effect",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "immobilization has detrimental effect",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "age dependent",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "increase in strength from birth to maturity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "decrease in strength after maturity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "laser/heat causes tendons to shrink",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "vary with exposure to hydration, temperature, pH",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**tendons should be tested under physiologic relevant conditions**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Advantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**strong in tension** (can withstand 5-10% as opposed to 1-4% in bone)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Disadvantages",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "buckle in compression",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "demonstrate creep and stress relaxation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Load-elongation or stress-strain curve**",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/9015/images/loadelongationcurve2.jpg",
              "caption": "load elongation curve"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "toe region",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "initial nonlinear segment of curve during low loads due to tendons being \"crimped\"",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "linear region",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "intermediate loads",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "failure region",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "high loads",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Tendon Healing",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Stages of tendon healing",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Stages of Soft Tissue Healing**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**(including tendons)**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Hemostasis",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Platelets** initiate coagulation cascade",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "**Fibrin clot** and fibronectin interaction leading to chemotaxis to stabilize torn tendon edges",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "5-15 minutes",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Inflammation",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "**Fibroblasts produce type III collagen**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
