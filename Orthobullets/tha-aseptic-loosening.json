{
  "title": "THA Aseptic Loosening",
  "url": "https://www.orthobullets.com/recon/12304/tha-aseptic-loosening",
  "subtitle": "Updated: Aug 28 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "THA Aseptic Loosening is a macrophage-induced inflammatory response that results in bone loss and implant loosening in the absence of an infection.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis can be made with plain radiographs of the hip.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment is generally revision arthroplasty with exchange of all loose components.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Steps in the process",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**prosthesis micromotion**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**particulate debris formation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**macrophage activated osteolysis**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "See wear and osteolysis basic science for full description",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "location",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "groin pain",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "thigh pain",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "knee pain",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "aggrevating factors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "often activity related",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may have minimal pain with ROM",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "increased pain with weight bearing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings (xrays are not sensitive for osteolysis and typically underestimate extent of involvement)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "lucency > 2 mm at cement-bone or metal-bone interface",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "component motion with stress views",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "femoral component",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "subsidence > 1 cm",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "fracture of cement mantle",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "change in peg-neck angle",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "can also represent femoral head necrosis/collapse, femoral neck fracture",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "decreased distance from tip of peg to lateral femoral cortex",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "can also represent femoral head necrosis/collapse",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "narrowing of femoral neck after 3 years or > 10%",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "can also represent impingement",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "acetabular component",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "migration or change in position/inclination",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "wearing of polyethylene liner",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": [
                        {
                          "text": "leads to asymmetric superior location of femoral head within acetabular cup",
                          "table": null,
                          "images": [],
                          "importance": "3",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
