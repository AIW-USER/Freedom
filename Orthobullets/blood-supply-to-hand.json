                    {
                      "text": "*Arch*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Kaplan's Cardinal line",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "*Distal Wrist Crease*",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Superficial",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "15mm distal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "50mm distal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Deep",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "7mm distal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "40mm distal",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Digital Arteries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Common digital arteries arise from the **superficial palmar arch**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Divide into proper digital arteries at the web spaces",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Gives dorsal branches distal to the PIP joints",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Dominant arteries are found on the **median** side of the digit (closer to midline)",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "in the index finger, the **ulnar** digital artery is dominant",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "in the little finger, the **radial** digital artery is dominant",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "in the middle and ring fingers, ulnar and radial digital arteries are dominant respectively, but dominance is less obvious",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Dorsal Arteries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Blood supply",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/dorsal%20arteries.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "posterior interosseous artery",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "dorsal perforating branch of anterior interosseous artery",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Form a dorsal carpal arch which gives rise to dorsal metacarpal arteries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful for dorsal metacarpal artery flaps",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "1st and 2nd dorsal metacarpal artery are more consistent than 3rd and 4th",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Veins",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Deep veins",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "veins follow the deep arterial system as **venae comitantes**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Superficial veins",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "found at the hand dorsum",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "contribute to the basilic and cephalic vein system",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
