{
  "title": "Blood Supply to Hand",
  "url": "https://www.orthobullets.com/hand/6007/blood-supply-to-hand",
  "subtitle": "Updated: May 23 2021",
  "sections": [
    {
      "text": "Source Arteries",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radial artery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "runs between brachioradialis and FCR",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "enters the dorsum of the carpus by passing between FCR and APL/EPB tendons (in the snuffbox)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "gives off superficial palmar branch (communicates with superficial arch)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "finally passes between 2 heads of 1st dorsal interosseous to form the **deep palmar arch**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Ulnar artery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "runs under flexor carpi ulnaris",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**lateral to ulnar nerve** at the wrist",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "enters the hand through Guyon's canal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "lies on the **transverse carpal ligament**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Supplemental arteries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "anterior interosseous artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "posterior interosseous artery",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "median artery (occasionally)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Superficial Arch",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/arches.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/superficial%20arch%20close.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "deep to palmar fascia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**distal** to the deep arch",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "surface marking",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "at the level of a line drawn across the palm parallel to the distal edge of the fully abducted thumb",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**predominant supply is ulnar artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "minor supply from **superficial branch of radial artery**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Branches of superficial arch (from ulnar to radial)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/arches.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "1st branch",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "is the **deep branch** that provides the minor supply to the deep palmar arch",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "2nd branch",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "is the **ulnar digital artery of the little finger**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "the proper digital artery to the ulnar side of the little finger arises **directly from the superficial arch**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "3rd, 4th, 5th, and 6th branches",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "are the common **palmar digital arteries**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "in the **palm**, the digital arteries are **volar** to the digital nerves",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**in the digits, the digital arteries are dorsal to the digital nerves**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6007/images/digital%20artery%20and%20nerve.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "in the digits, the neurovascular bundle is volar to Cleland's ligament",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "multiple branches to intrinsic muscles and skin",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "The superficial arch is complete (branches to all digits) in **80%** of individuals",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Deep Arch",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/arches.jpg",
              "caption": ""
            },
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/deep%20arch%20close.jpg",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "deep to the flexor tendons (FDS, FDP)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**proximal** to the superficial arch",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "at the level of the base of the metacarpals",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "surface marking",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "1 fingerbreadth proximal to a line drawn across the palm parallel to the distal edge of the fully abducted thumb",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "1 fingerbreadth proximal to the superficial arch",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "predominant supply is the deep branch of the **radial artery**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "minor supply from the **deep branch of the ulnar artery**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Branches of the deep arch (from radial to ulnar)",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6007/images/arches.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "**princeps pollicis**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "runs between 1st dorsal interosseus and adductor pollicis",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**branch to the radial side of the index finger**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "the proper digital artery to the radial side of the IF arises directly from the deep arch",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "branches to the 3 **common digital arteries** in the 2nd, 3rd, and 4th web spaces",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "The deep arch is complete (branches to all digits) in **97%** of individuals",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
