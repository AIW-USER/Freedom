    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "emergent radical debridement and **broad-spectrum IV antibiotics**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "whenever suspicion for necrotizing fasciitis",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "antibiotics",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "initial antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "start empirically with penicillin, clindamycin, metronidazole, and an aminoglycoside",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": [
                            {
                              "text": "clindamycin has been shown to reduce odds of limb amputation",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "definitive antibiotics",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "**penicillin G**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "for strep or clostridium",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "**imipenem or doripenem or meropenem**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "for polymicrobial",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "add **vancomycin or daptomycin**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": [
                            {
                              "text": "if MRSA suspected",
                              "table": null,
                              "images": [],
                              "importance": "4",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "hemodynamic monitoring with systemic resuscitation is critical",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "**hyperbaric oxygen chamber** if anaerobic organism identified",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "operative findings",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "liquefied subcutaneous fat",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
