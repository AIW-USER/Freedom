            {
              "text": "Literature",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "Original study revealed a score > 6 has PPV of 92% of having necrotizing fasciitis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "Subsequent analyses have shown the tool to be modestly sensitive (68%) but fairly specific (85%) with scores of six or greater",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
