                },
                {
                  "text": "medial",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "medial malleolus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "contents of anterior tarsal tunnel",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "EDL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "EHL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Tibialis anterior",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "peroneus tertius",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Deep peroneal nerve",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "within tunnel division of nerve between **mixed (lateral)** and **sensory only (medial)** occurs",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "dorsalis pedis artery and vein",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**dysesthesia and paresthesias on dorsal foot**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "lateral hallux, medial second toe and first web space are most common locations",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**vague pain on dorsum of foot**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "motor",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "weakness or atrophy of EDB",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "sensory",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "decreased two-point discrimination",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "provocative tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Tinel sign over course of DPN with possible radiation to first web space",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "exacerbation with plantar flexion and inversion (puts nerve on stretch)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "relief of symptoms with injection of lidocaine (DPN nerve block)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
