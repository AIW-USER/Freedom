    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anterior Tarsal Tunnel Anatomy",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/7043/images/anatomy.jpg",
              "caption": "Anatomy"
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "borders",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "superficial",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "inferior extensor retinaculum",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "deep",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "capsule of talonavicular joint",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "lateral malleolus",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
