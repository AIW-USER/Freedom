    {
      "text": "Innervation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Vastus lateralis is supplied by the muscular branches of the femoral nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Primary nerves of the anterior thigh",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**obturator nerve**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**femoral nerve**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "origin",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "L2-4 of lumbar plexus",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "motor",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "extensors of the knee",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "rectus femoris",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "**vastus lateralis**",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "vastus medialis",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "vastus intermedius",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "sensory",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "none",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "course",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "descends in the abdomen through the psoas",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "runs behind inguinal ligament and into the thigh where it splits into an anterior and posterior division",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "passes through femoral triangle lateral to femoral vessels",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "terminal cutaneous branch is the saphenous nerve",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Blood Supply",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Vastus lateralis is primarily supplied by lateral circumflex artery, a branch of femoral artery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "**Femoral artery**",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "branches in thigh",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "profunda femoris",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "medial femoral circumflex",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**lateral femoral circumflex**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "lateral to rectus femoris",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "branches",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "ascending branch - runs towards ASIS between sartorius and TFL",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "requires ligation during anterior approach to hip",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "transverse branch - joins branch of medial femoral circumflex",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "descending branch - runs between vastus intermedius and lateralis muscles",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": [
                            {
                              "text": "encountered in anterolateral approach to femur",
                              "table": null,
                              "images": [],
                              "importance": "2",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
