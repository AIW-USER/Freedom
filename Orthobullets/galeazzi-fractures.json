    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, swelling, deformity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "point tenderness over fracture site",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "ROM",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "test forearm supination and pronation for instability",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "DRUJ stress",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "causes wrist or midline forearm pain",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP and lateral views of forearm, elbow, and wrist",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "signs of DRUJ injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "ulnar styloid fx",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "**widening of joint on AP view**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "dorsal or volar displacement on lateral view",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "radial shortening (≥5mm)",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "ORIF of radius with reduction and stabilization of DRUJ",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "all cases, as anatomic reduction of DRUJ is required",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "**acute operative treatment** far superior to late reconstruction",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**ORIF of radius**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**volar (Henry) approach to radius**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "plate fixation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "perform **anatomic plate fixation** of radial shaft",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "radial bow must be restored/maintained",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Reduction & stabilization of DRUJ**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "approach",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**dorsal capsulotomy**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "reduction technique",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**immobilization in supination (6 weeks)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated if DRUJ stable following ORIF of radius",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**percutaneous pin fixation**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/1029/images/galeazzi%20fracture%20orif.jpg",
                      "caption": "Show a Galeazzi fracture both before and after open reduction and internal fixation."
                    }
                  ],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated if DRUJ reducible but unstable following ORIF of radius",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "cross-pin ulna to radius",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "leave pins in place for 4-6 weeks",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**open surgical reduction**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated if reduction is blocked",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "suspect **interposition of ECU tendon**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**open reduction internal fixation**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "indicated if a large ulnar styloid fragment exists",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fix styloid and immobilize in supination",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Compartment syndrome**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "increased risk with",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "high energy crush injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "open fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "vascular injuries or coagulopathies",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "diagnosis",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "pain with passive stretch is most sensitive",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Neurovascular injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "uncommon except type III open fractures",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Refracture**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "usually occurs following plate removal",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "increased risk with",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "removing plate too early",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "large plates (4.5mm)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "comminuted fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "persistent radiographic lucency",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "prevention",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "do not remove plates before 18 months after insertion",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "amount of time needed for complete primary bone healing",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Nonunion**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Malunion**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**DRUJ subluxation**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "displaced by gravity, pronator quadratus, or brachioradialis",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    }
  ],
