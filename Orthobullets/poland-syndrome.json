{
  "title": "Poland Syndrome",
  "url": "https://www.orthobullets.com/hand/6077/poland-syndrome",
  "subtitle": "Updated: Dec 24 2025",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "A congenital disorder characterized by",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**unilateral chest wall hypoplasia**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "due to absence of sternocostal head of **pectoralis major**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**hypoplasia** of the hand and forearm",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**symbrachydactyly and shortening** of middle fingers",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6077/images/symbrachy.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "result of absence or shortening of the middle phalanx",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6077/images/img0[1]_moved.gif",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "simple complete syndactyly of the short digits",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "1 in 32,000 live births",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "thought to be linked to subclavian artery hypoplasia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "occurs in 10% of syndactyly cases",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extent of hand and chest involvement varies",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "chest deformities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "hypoplasia or absence of the pectoralis major, pectoralis minor, deltoid, serratus anterior, external oblique, and latissimus dorsi",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Sprengel’s deformity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "dextrocardia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "absence or underdevelopment of the breast",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "hand deformities",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "syndactyly",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "hypoplasia or absence of metacarpals or phalanges",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "absence of extensors or flexor tendons",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "carpal coalition or hypoplasia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "radioulnar synostosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "nail agenesis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "CT scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "will show absent perctoralis major",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6077/images/123-773[1]_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "syndactyly release",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "performed in most patients",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "complete syndactyly release produces skin deficiency that requires skin grafting",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "perform only one side of the digit at a time to avoid vascular complications",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "local flap is created for commisure reconstruction followed by interdigitating zigzag dorsal and palmar flaps along the medial and lateral aspect of the digit",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Skin graft failure**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "**Excessive tension**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Improper flap planning**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Digital artery injury**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Web creep**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Nail deformity**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    }
