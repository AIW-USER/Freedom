{
  "title": "TKA Metal Hypersensitivity",
  "url": "https://www.orthobullets.com/recon/12753/tka-metal-hypersensitivity",
  "subtitle": "Updated: Feb 14 2022",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "TKA Metal Hypersensitivity is a complication of TKA that may lead to persistent knee pain and stiffness as a result of an allergic reaction to the metallic components.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis involves careful patient history, and ruling out infection or aseptic loosening. Patch testing may be helpful in diagnosis.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment generally involves component exchange to a hypoallergenic femoral component with all-polyethylene tibial component.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rare",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Type IV - delayed-type cell mediated hypersensitivity**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "mediated by T cells",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "reaction to",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**nickel** found in cobalt-chromium alloys",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**metal ions** deposit in local tissue, must react with proteins to initiate hypersensitivity",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/12753/images/soft_tissue_metal_allergy.jpg",
                      "caption": "Intraoperative image"
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "biggest link may be metal ions/hypersensitivity as a causative initiator of early implant loosening",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may have history of dermatitis, eczema, other signs of atopic hypersensitivity",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**vague persistent pain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "persistent, unremitting effusion/swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stiffness",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "document range of motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**patch testing** (limited evidence for direct link to diagnose hypersensitivity)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12753/images/patch_test.jpg",
                  "caption": "Example of patch test results"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "lymphocyte transformation test (LST)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "T-lymphyocyte rich immunohistopathology",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12753/images/hypersensitivity_histology.jpg",
                  "caption": "Metal hypersensitivity synovial histology"
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "**negative work-up for chronic/acute infection** (must be ruled out)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Diagnosis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "exact definition is controversial",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "some argue combination of a positive patch test, positive immunohistopathology, and relief of symptoms upon implant exchange is only way to confirm diagnosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "others argue that metal hypersensitivity is a diagnosis of exclusion, only arrived upon when infection and aseptic loosening is ruled out",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "implant exchange",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "persistent symptoms affecting quality of life",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "hypoallergenic femoral component with all-polyethylene tibial component if possible",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "at time of surgery, chronic inflammatory synovitis typically present",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
