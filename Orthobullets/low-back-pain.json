  "sections": [
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Low back pain affects 50-80% of the population during their lifetime",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "$100 billion annual cost",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "secondary only to respiratory infections as a reason for visiting a doctor's office",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**muscle strain**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most common cause of low back pain",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "most common degenerative disorders",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**lumbar spinal stenosis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**lumbar disc herniation**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**discogenic back pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "obesity, smoking, gender",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "lifting, vibration, prolonged sitting",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "job dissatisfaction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Red flags",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "infection (IV drug use, history of fever and chills)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "tumor (history of cancer)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "trauma (history of car accident or fall)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cauda equina syndrome (bowel/bladder changes)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Outcomes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "90% of low back pain resolves within one year",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "axial pain",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**musculogenic**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "most common cause of back pain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "associated with activity",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "characterized by stiffness and difficulty bending",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**discogenic pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "controversial",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "confirmed by discogram",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**mechanical pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "caused by",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "facet degeneration",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "micro- and macro-instability",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "worse with activities such as lifting objects and prolonged standing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**sacroiliac symptoms**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "pain originating from a sacroiliac joint",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "peripheral / neurogenic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**radicular pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "unilateral leg pain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "usually dermatomal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**referred pain**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "buttocks",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "posterior thighs",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "inguinal region (L5-S1)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**neurogenic claudication**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "pain in buttocks and legs that is worse with prolonged standing",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fairly specific for spinal stenosis",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**myelopathy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "hand clumsiness",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "gait instability",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "due to spinal cord injury (~L1 or above)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**conus medullaris syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**cauda equina syndrome**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "bilateral leg pain",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "LE weakness",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "saddle anesthesia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "bowel/bladder symptoms",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**spinal cord injury**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "incomplete",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "complete",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "**Waddell signs**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "evaluation of non-organic back pain symptoms",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "clinically significant if **three positive signs** are present:",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "superficial and non-anatomic tenderness",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "pain with axial compression or simulated rotation of the spine",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "negative straight-leg raise with patient distraction",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "regional disturbances that do not follow dermatomal patterns",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "overreaction to physical examination",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
