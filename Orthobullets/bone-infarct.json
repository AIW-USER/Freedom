{
  "title": "Bone Infarct",
  "url": "https://www.orthobullets.com/pathology/8078/bone-infarct",
  "subtitle": "Updated: Oct 18 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Bone Infarcts are medullary bony lesions that are in the same spectrum of disease as osteonecrosis. Patients typically present with an asymptomatic lesion in the metaphysis or diaphysis of long bones, discovered incidentally on radiographs.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made radiographically with the presence of a medullary lesion of sheet-like central lucency surrounded by sclerosis with a serpiginous border, commonly referred to as a \"smoke up the chimney\" lesion.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is observation as lesions are generally asymptomatic.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "similar risk factors as those seen in osteonecrosis",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "trauma",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "sickle cell disease",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "thalassemia",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "connective tissue disorders",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "steroid useGaucher's disease",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "steroid use",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "interruption of blood supply by intrinsic or extrinsic factors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "usually asymptomatic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "often found when imaging the extremities for other reasons",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "medullary lesion of sheet-like central lucency surrounded by sclerosis with a serpiginous border",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8078/images/bone%20infarct%20xray.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "\"smoke up the chimney\"",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "key feature is that central signal remains of normal marrow",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8078/images/bone%20infarct%20mri.jpg",
                  "caption": ""
                }
              ],
              "importance": "1",
              "children": []
            },
            {
              "text": "T1 weighted images",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "peripheral low signal due to grannulation tissue and to lesser extent sclerosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "periphery may enhance post gadolinium",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "T2 weighted images",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "acute infarct may show ill-defined non-specific area of high signal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "intense inner ring of granulation tissue and a hypointense outer ring of sclerosis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Bone Scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cold in early phases",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "hot in late resorptive and revascularisation phase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "observation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": [
                    {
                      "text": "**usually asymptomatic and do not require treatment**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
