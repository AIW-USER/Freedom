    },
    {
      "text": "Bone Morphogenetic Protein (BMP) & SMADs",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "BMPs belong to the TGF-B superfamily",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "BMP 2,4,6, and 7 all exhibit osteoinductive activity",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "BMP 3 does not exhibit osteoinductive activity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "Mutations in BMP-4 are associated with Fibrodysplasia ossificans progressiva",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "osteoinductive",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "leads to bone formation",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "activates mesenchymal cells to transform into osteoblasts and produce bone",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "has been found to increase chondrogenic phenotype and matrix synthesis in intervertebral discs",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Signaling Pathways and Cellular Targets",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "BMP targets undifferentiated perivascular mesenchymal cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "activates a **transmembrane serine/threonine kinase receptor** that leads to the activation of intracellular signaling molecules called SMADs",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/9086/images/bmp.jpg",
                  "caption": "BMP and SMAD"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "**SMADS** are primary intracellular signaling mediators",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "currently eight known SMADs, and the activation of different SMADs within a cell leads to different cellular responses.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Clinical applications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "FDA-approved uses",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "rhBMP-2",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "single-­level ALIF from L2 to ­S1 levels in degenerative disc disease together with the lumbar tapered fusion device (LT Cage; Medtronic)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "open tibial shaft fractures stabilized with an IM nail and treated within 14 days of the initial injury",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "rhBMP-7",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "as an alternative to autograft in recalcitrant long bone nonunions where use of autograft is unfeasible and alternative treatments have failed",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "as an alternative to autograft in compromised patients (with osteoporosis, smoking or diabetes) requiring revision posterolateral/intertransverse lumbar fusion for whom autologous bone and bone marrow harvest are not feasible or are not expected to promote fusion",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "contraindications",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "pregnancy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "allergy to bovine type I collagen or recombinant human rhBMP­-2",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "infection",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "tumor",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "skeletal immaturity",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Transforming Growth Factor-B (TGF-B)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "secreted in a paracrine fashion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "both osteoblast and osteoclasts synthesize and respond to TGF-B",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "found in fracture hematomas and believed to regulate cartilage and bone formation in fracture callus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stimulates production of Type II collagen and proteoglycans by mesenchymal cells.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "induces osteoblasts to synthesize collagen",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Signal Pathway & Cellular Targets",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "signal mechanism involves transmembrane serine/threonine kinase receptors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Clinical applications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "TGF-B is used to coat porous coated implants to promote bone ingrowth",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Insulin-like Growth Factor 1 (IGF-1)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "IGF-1, formerly known as somatomedin-C, possibly acts by both paracrine and endocrine hormone pathways",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most abundant growth factor in bone",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "the products of the GH-IGF-1 system induce proliferation without maturation of the growth plate and thus induce linear skeletal growth.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "the action of the thyroid hormone axis is via an active metabolite that enters target cells and signals a nuclear receptor to stimulate both proliferation and maturation of the growth plate. Increased amounts of the active steroid hormone metabolite promote proliferation and maturation of the growth plate",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "IGF-1 may have a role in enhancing bone formation in defects that heal via **intramembranous ossification**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Signal Pathway & Cellular Targets",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "signal mechanism involves tyrosine kinase receptors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Insulin-like Growth Factor 2 (IGF-2)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "more potent than IGF-1",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stimulates type I collagen production",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stimulates cartilage matrix synthesis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stimulates cellular proliferation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "stimulates bone formation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Signal Pathway & Cellular Targets",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "signal mechanism involves tyrosine kinase receptors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Fibroblast Growth Factor (FGF)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "FGF-1 and FGF-2 are most abundant",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "promote growth and differentiation of a variety of cells",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "epithelial cells",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "myocytes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "osteoblasts",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "chondrocytes",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "binds to membrane spanning tyrosine kinase",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "associated with angiogenesis and chondrocyte and osteoblast activation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "involved in early stages of fracture healing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Platelet-derived growth factor (PDGF)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "released from platelets and signals inflammatory cells to migrate to fracture site",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "role in fracture healing and bone repair has not been clearly defined",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Signal Pathway & Cellular Targets",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "signal mechanism involves tyrosine kinase receptors",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Peroxisome proliferator-activated receptor gamma (PPAR-gamma or PPARG)",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Overview",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "key factor demonstrated in adipogenic differentiation of mesenchymal precursor cells in vitro",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Signal Pathway & Cellular Targets",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "a nuclear binding receptor that binds to DNA and regulates transcription of target genes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Clinical and research applications",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "utilized for adipogenic differentiation in vitro",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "agonists are being utilized to attempt treatment of hyperglycemia and hyperlipidemia",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "targeted by thiazolidinediones for treatment of diabetes",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    }
  ],
  "gallery": [],
