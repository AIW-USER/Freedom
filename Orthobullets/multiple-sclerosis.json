{
  "title": "Multiple Sclerosis",
  "url": "https://www.orthobullets.com/basic-science/9079/multiple-sclerosis",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Multiple Sclerosis is a chronic inflammatory disease caused by demyelination and widespread axonal injury in the central nervous system, leading to progressive motor and sensory dysfunction.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made with MRI with gadolinium of brain and spinal cord.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is medical management with immunomodulators, antispasticity agents and physical therapy. Currently, there is no cure for the condition.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "5 per 100,000 people in the US",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "20-40 years old",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "women>men",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "northern latitude",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "genetic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**not considered a hereditary disease**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "environment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "stress",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "smoking",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "decreased sunlight/low vitamin D exposure",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pathophysiology",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "believed to be caused by a combination of genetic, environmental and infectious factors",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "recent research suggests a T-cell mediated autoimmune mechanism",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**increased fracture risk**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "relating to increased risk of falling and decreased bone mineral density",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**osteoporosis**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "relating to physical inactivity, vitamin D deficiency, immunomodulatory medication",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**gait abnormalities**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "muscle paralysis causing foot drop, etc",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**muscle and joint spasticity**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "clinically defined by **two or more episodes of neurological dysfunction (brain, spinal cord or optic nerves) that are separated in time and space**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "symptoms of disease are based on the systems involved",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "psych",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "fatigue, depression, mood disorders",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "central nervous system",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**optic neuritis**, diplopia, nystagmus",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "ENT",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "dysarthria, dysphagia",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "MSK",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "weakness, loss of balance and coordination, spasms, ataxia, falls",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "neuro",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "parasthesis, hypoesthesia, **peculiar sensory phenomena's (e.g. sensation of wetness)**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "GI",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "incontinence, diarrhea, constipation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "urology",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "incontinence, frequency, retention",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**inspection**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**assess for gait abnormalities (e.g. wide-based gait, limb ataxia, slapping foot)**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**joint or muscle contractures**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "**neurological examination**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**muscle spasticity**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**increased deep tendon reflexes**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "muscle weakness",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Babinski positive",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "special tests",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**fundoscopy**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**MLF syndrome** (Internuclear Ophthalmoplegia)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Lhermitte's sign**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Evaluation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Laboratory studies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "CBC, lytes, TSH, comprehensive metabolic panel",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "used to exclude concomitant illnesses",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "usually normal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "CSF analysis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "mononucleur pleocytosis (25%)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**elevated CSF IgG** (80%)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**oligoclonal bands** on electrophoresis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Imaging studies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "MRI",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**obtain MRI with gadolinium of brain and spinal cord**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "findings",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**multiple focal demyelination** scattered in **brain** and **spinal cord**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**asymmetric periventricular plaques**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cervical myelopathy, CNS mass lesion, vitamin B12 deficiency, sarcoidosis, CNS infections",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immunomodulators",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "treatment attempt to return function after an attack, prevent new attacks, and prevent disability",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**corticosteroids**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "indicated for acute exacerbations",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**prophylactic immunosuppresants (interferon beta)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "may decrease the number and severity of relapses",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "has been shown to decrease the progression of relapsing remitting multiple sclerosis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "text": "antispasticity agents",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "increased muscle tone with spasms",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "oral agents",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": [
                        {
                          "text": "baclofen, gabapentin, clonazapem",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "botox injections",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "physiotherapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "improve gait and balance",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "gentle stretching exercises for spasticity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "progressive resistant-training",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "osteoporosis management",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Increased fracture risk**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "relating to increased risk of falling and decreased bone mineral density",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Osteoporosis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "relating to physical inactivity, vitamin D deficiency, immunomodulatory medication",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Patterns of disease progression",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**remitting-relapsing (most common)**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "primary progressive",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "secondary progressive",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "progressive relapsing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Life expectancy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "5 to 10 years lower than that of unaffected people",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
