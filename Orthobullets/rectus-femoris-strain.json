        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain in the anterior aspect of the hip**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "strain or avulsion at insertion on AIIS",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**pain midthigh**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "strain in muscle fibers",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "**pain distally**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "most common finding",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
