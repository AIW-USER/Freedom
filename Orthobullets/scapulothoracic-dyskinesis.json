            },
            {
              "text": "pathoanatomy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "scapulothoracic power imbalance leads to **protraction of scapula**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "leads to alteration of mechanics at glenohumeral joint",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "excessive stress placed on anterior capsule of shoulder and posterosuperior labrum",
