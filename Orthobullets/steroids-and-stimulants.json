{
  "title": "Steroids & Stimulants",
  "url": "https://www.orthobullets.com/knee-and-sports/3126/steroids-and-stimulants",
  "subtitle": "Updated: Jun 2 2021",
  "sections": [
    {
      "text": "Anabolic steroids",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Introduction",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cause increase in muscle strength",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "increase aggressive behavior",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "increased erythropoiesis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "side effects",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "hypertension",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "liver tumors",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "increased LDL",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "decreased HDL",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "hypercholesterolemia",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Intake",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "either oral or injection routes possible",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Evaluation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "an abnormally **low high-density lipoprotein level** should alert the physician to the possibility of steroid use in an athlete.",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "blood testing examines for **testosterone to epitestosterone ratio of > 6:1**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increased body weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "testicular atrophy",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "irreversible deepening of female voice",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "alopecia (irreversible)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "reduction in gonadotropic and sex hormones (estrogen and testosterone)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "can lead to decreased bone mineral density",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "oligospermia or azoospermia",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "growth retardation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "gynecomastia",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Type of steroids",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**Human Growth hormone (HGH)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "the most abundant substance produced by the **pituitary gland**. Growth hormone has a direct anabolic effect by accelerating the incorporation of amino acids into proteins. It is becoming an increasingly popular anabolic steroid substitute;",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "similar effects from insulin-like growth factor (IGF-1)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "increased muscle size but not strength",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "Side effects:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "myopathic muscles development",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "carpal tunnel syndrome",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "insulin resistance",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Androstenedione**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "an androgen produced by the **adrenal gland**s and **gonads**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "acts as a potent anabolic steroid and is converted in the liver directly to testosterone with a resultant increase in levels after administration.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**DHEA**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "is a naturally occurring hormone made by the **adrenal cortex**.",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "it is converted to androstenedione, which in turn is converted to testosterone.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "the beneficial and adverse effects of DHEA can be correlated directly with those of testosterone.",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**Erythropoietin (EPO)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "stimulates hemoglobin production and increases O2 carrying capacity",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "side effects",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**increased blood viscosity** which can lead to stroke or myocardial infarctions",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**Somatotropin**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "a growth hormone that causes **hypertrophy of type 1 muscles** and atrophy of type 2 muscle",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Catabolic Hormones",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Glucagon**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "has a catabolic effect on skeletal muscle",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Supplements",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Creatine**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "Introduction",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "derived from **glycine, arginine, and methionine**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "a muscle and power building **supplement** (not an anabolic steroid)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "mechanism is that creatinine is converted to phosphocreatine, which acts as a source of ATP for muscle",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "studies have shown although it can increase work in anaerobic trials, it cannot increase peak force",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "widely used in conjunction with off-season weight lifting programs",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "Outcomes",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "studies show mixed results with regard to enhanced sports performance",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "Risks",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "pulls water from blood vessels into cells, creating a theoretical **risk of dehydration**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "Reports of",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "cramps",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "increased muscle injury",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "renal insufficiency (rare)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Stimulants",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Includes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**caffeine**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "doses of 2 to 3 mg/kg have been shown to improve performance",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "works by reducing fatigue and increasing alertness",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "previously banned by the International Olympic Committee (IOC)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "now allowed up to 12 micrograms per milileter of urine",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**ephedra**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**ephedrine**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "\"**ma huang**\"",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "often included in energy drinks",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**amphetamines**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Risks include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dehydration",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "impaired heat management",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "high blood pressure",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "nervous system impairment",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    }
  ],
