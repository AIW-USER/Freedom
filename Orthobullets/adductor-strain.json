    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Hip joint adductor complex",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "adductor longus (most common muscle injured in complex)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "adductor magnus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "adductor brevis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "gracilis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "obturator externus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pectineus",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "All have obturator nerve innervation",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain is immediate and severe in the groin region.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "tenderness is at the site of injury along the subcutaneous border of the pubic ramus.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "pain and/or decreased strength with resisted leg adduction compared to the other leg",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AP pelvis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "lateral of hip",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "findings",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "if injury is due to an avulsion then fleck of bone may be visible",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may show avulsion injury of the adductor muscle from the pubic ramus with muscle edema and hemorrhage.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "rest, ice, protected weight bearing as needed",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "mainstay of treatment",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "dictated by the severity of the symptoms but generally consists of of a period of rest",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": [
                        {
                          "text": "follow with a rehabilitation program that begins with gentle stretching and progresses to resistance exercise and core strengthening with a gradual return to sports",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "immobilization should be avoided because this promotes muscle tightness and scarring",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "open repair",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "no data exist to suggest that open repair yields a better outcome than nonsurgical management.",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
