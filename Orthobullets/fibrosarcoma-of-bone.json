{
  "title": "Fibrosarcoma of Bone",
  "url": "https://www.orthobullets.com/pathology/8031/fibrosarcoma-of-bone",
  "subtitle": "Updated: Jun 21 2021",
  "sections": [
    {
      "text": "SUMMARY",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Fibrosarcoma of Bone is a malignant, high-grade, fibrogenic tumor of bone that usually occurs in patients > 50 years of age who presents with regional pain and swelling.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with a biopsy and histology showing atypical spindle cells in a herringbone pattern.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually wide surgical resection and multiagent chemotherapy.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Prognosis is poor",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "high grade has 30% survival at 5 years",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**majority are high-grade**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "low grade has 80% survival at 10 years",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "PRESENTATION",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain and swelling",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographic characteristics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "purely **lytic lesion** with **bone destruction** in a permeative pattern",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "ill defined features",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "looks like osteosarcoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/8031/images/Case%20C%20-%20femur%20-%20bone%20scan%20-%20Parsons_moved.gif",
              "caption": ""
            }
          ],
          "importance": "4",
          "children": [
            {
              "text": "is very hot",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "STUDIES",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "Same as soft tissue sarcoma",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "atypical spindle cells",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8031/images/Histology%20A%20-%20high%20power_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**herringbone pattern**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/8031/images/Histology%20B%20-%20medium%20power%20-%20Parsons_moved.jpg",
                      "caption": ""
                    },
                    {
                      "src": "https://upload.orthobullets.com/topic/8031/images/Histology%20C%20-%20low%20power%20-%20Parsons_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "variable levels of collagen production",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "wide surgical resection and multiagent chemotherapy",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "all malignant cases",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "chemotherapy",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "multiagent chemotherapy only if high grade (most cases)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
