{
  "title": "Chance Fracture (Flexion-Distraction Injury)",
  "url": "https://www.orthobullets.com/spine/2023/chance-fracture-flexion-distraction-injury",
  "subtitle": "Updated: Oct 12 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Chance fractures are traumatic fractures of the thoracic and lumbar spine that occur via a flexion-distraction injury mechanism and are associated with high rates of mechanical instability and gastrointestinal injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis of bony Chance fractures is made with radiographs or CT scan. An MRI may be necessary to identify a ligamentous Chance injury involving disruption of the PLC",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment can be nonoperative or involve surgical spinal stabilization, depending on the presence of mechanical instability and/or neurologic deficits",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "a flexion-distraction injury (seatbelt injury)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may be a **bony injury**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "may be a **ligamentous injury** (flexion-distraction injury)",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "more difficult to heal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**middle and posterior columns** fail under tension",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**anterior column fails under compression**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/2023/images/chance_fx_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated injuries",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "high rate of gastrointestinal injuries (50%)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "AP and lateral",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/2023/images/AP%20xray_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2023/images/chance%20fx.jpg",
                  "caption": "Shows Chance Fracture"
                },
                {
                  "src": "https://upload.orthobullets.com/topic/2023/images/lateral%20xray_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "flexion-extension radiographs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "evaluate the degree of bone injury and retropulsion of posterior wall into canal",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "evaluate for injury to the **posterior elements**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immobilization in cast or TLSO",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "neurologically intact patients with:",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "stable injury patterns and intact posterior elements",
                          "table": null,
                          "images": [],
                          "importance": "2",
                          "children": []
                        },
                        {
                          "text": "**bony Chance** fracture",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "technique",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "may cast or brace (TLSO) in extension",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "patients must be followed closely for nonunion and kyphotic deformity",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**surgical decompression and stabilization**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "patients with neurologic deficits",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "unstable spine with **injury to the posterior ligaments (soft tissue Chance fracture)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**anterior decompression and stabilization**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "usually with vertebrectomy and strut grafting, followed by instrumentation",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "**posterior indirect decompression and stabilization with compression fusion construct**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "historically, fusion included three levels above and two levels below",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "modern pedicle screw systems have permitted stable fusion constructs using one level above and one level below",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "distraction construct in burst fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "compression construct in Chance fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Pain**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "most common",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Deformity**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "scoliosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "progressive kyphosis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "common with unrecognized injury of the PLL",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "flat back deformity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "leads to pain, a forward flexed posture, and easy fatigue",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "posttraumatic syringomyelia",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "**Nonunion**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    }
  ],
