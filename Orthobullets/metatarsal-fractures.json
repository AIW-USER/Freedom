{
  "title": "Metatarsal Fractures",
  "url": "https://www.orthobullets.com/foot-and-ankle/7032/metatarsal-fractures",
  "subtitle": "Updated: Sep 21 2024",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Metatarsal fractures are among the most common injuries of the foot that may occur due to trauma or repetitive microstress.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Diagnosis is made with plain radiographs of the foot.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment may be nonoperative or operative depending on the specific metatarsal involved, number of metatarsals involved, and fracture displacement.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "5th metatarsal most commonly fractured in adults",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "1st metatarsal most commonly fractured in children less than 4 years old",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "3rd metatarsal fractures rarely occur in isolation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "68% associated with fracture of 2nd or 4th metatarsal",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "peak incidence between 2nd and 5th decade of life",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Mechanism",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "direct crush injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "may have significant associated soft tissue injury",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "indirect mechanism (most common)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "occurs with forefoot fixed and hindfoot or leg rotating",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Lisfranc injury",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "Lisfranc equivalent injuries seen with multiple proximal metatarsal fractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "stress fracture",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "consider metabolic evaluation for fragility fracture",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "look for associated foot deformity",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "seen at **base of 2nd metatarsal in ballet dancers**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "may have history of amenorrhea",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Anatomy",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Osteology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "shape and function similar to metacarpals of the hand",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7032/images/metarsals.jpg",
                  "caption": "shows metatarsals"
                }
              ],
              "importance": "4",
              "children": []
            },
            {
              "text": "first metatarsal has plantar crista that articulates with sesamoids",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/7032/images/first%20metatarsal.jpg",
                  "caption": "first metatarsal osteology"
                }
              ],
              "importance": "4",
              "children": [
                {
                  "text": "widest and shortest",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**bears 30-50% of weight** during gait",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "second metatarsal is longest",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "most common location of stress fracture",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Muscles",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "muscular balance between extrinsic and intrinsic muscles",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "extrinsics include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Extensor digitorum longus (EDL)",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "Flexor digitorum longus (FDL)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "intrinsics include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "Interossei",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "Lumbricals",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "see Layers of the Plantar Foot",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Ligaments",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Metatarsals have dense proximal and distal ligamentous attachments",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "2nd-5th metatarsal have distal intermetatarsal ligaments that maintain length and alignment with isolated fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "implicated in formation of interdigital (Morton's) neuromas",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "multiple metatarsal fractures lose the stability of intermetatarsal ligaments leading to increased displacement",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/7032/images/metatarsal-fracture-222x300.jpg",
                      "caption": "shows multiple metatarsal fractures"
                    }
                  ],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Blood supply",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "dorsal and plantar metatarsal arteries",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Biomechanics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "see Foot and Ankle Biomechanics",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Classification of metatarsal fractures is descriptive and should include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "location",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "fracture pattern",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "displacement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "angulation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "articular involvement",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "History",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "look for antecedent pain when suspicious for stress fracture",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain, inability to bear weight",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "foot alignment (neutral, cavovarus, planovalgus)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "focal areas or diffuse areas of tenderness",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "careful soft tissue evaluation with crush or high-energy injuries",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "motion",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "evaluate for overlapping or malrotation with motion",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "neurovascular",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "semmes weinstein monofilament testing if suspicious for peripheral neuropathy",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "recommended views",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "required",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "AP, lateral and oblique views of the foot",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "optional",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "contralateral foot views",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "stress or weight bearing radiographs",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "not routinely obtained",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "may be of use in periarticular injuries or to rule out Lisfranc injury",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "MRI or bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful in detection of occult or stress fractures",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "stiff soled shoe or walking boot with weight bearing as tolerated",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "first metatarsal",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "non-displaced fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "second through fourth (central) metatarsals",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "isolated fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "non-displaced or minimally displaced fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    },
                    {
                      "text": "stress fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "second metatarsal most common",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "look for metabolic bone disease",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "evaluate for cavovarus foot with recurrent stress fractures",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "percutaneous vs open reduction and fixation",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "**open fractures**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "**first metatarsal**",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/7032/images/first%20mt%20fracture.jpg",
                          "caption": "ORIF first metatarsal"
                        }
                      ],
                      "importance": "4",
                      "children": [
                        {
                          "text": "any displacement",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": [
                            {
                              "text": "no intermetatarsal ligament support",
                              "table": null,
                              "images": [],
                              "importance": "1",
                              "children": [
                                {
                                  "text": "30-50% of weight bearing with gait",
                                  "table": null,
                                  "images": [],
                                  "importance": "1",
                                  "children": []
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "**central metatarsals**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": [
                        {
                          "text": "sagittal plane deformity more than 10 degrees",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": ">4mm translation",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        },
                        {
                          "text": "multiple fractures",
                          "table": null,
                          "images": [],
                          "importance": "4",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "techniques",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "restore alignment to allow for normal force transmission across metatarsal heads",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "antegrade or retrograde pinning",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    },
                    {
                      "text": "lag screws or mini fragment plates in length unstable fracture patterns",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "maintain proper length to minimize risk of transfer metatarsalgia",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "outcomes",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "limited information available in literature",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Malunion**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "may lead to transfer metatarsalgia or plantar keratosis",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "treat with osteotomy to correct deformity",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Majority of isolated metatarsal fractures heal with conservative management",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Malunion may lead to transfer metatarsalgia",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
