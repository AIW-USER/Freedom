{
  "title": "Lymphoma",
  "url": "https://www.orthobullets.com/pathology/8025/lymphoma",
  "subtitle": "Updated: Mar 25 2026",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Lymphoma is a malignant hematopoietic tumor that occurs in three forms: primary lymphoma of bone, multiple bony sites, or bone and soft tissue lymphoma. Patients typically present between ages 35 and 55 with regional pain associated with fever, night sweats, and weight loss.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with biopsy showing mixed small round blue cell infiltrate (different sizes and shapes) that are CD20 and CD45 positive on immunohistochemical stains.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Treatment is usually chemotherapy and radiation. Surgical management is indicated for associated fractures.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "10-35% of non-Hodgkin's lymphoma patients have extranodal disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "primary lymphoma of bone is **very rare**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Demographics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**males** > females",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "can occur in all age groups",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most common in **patients aged 35 to 55**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bones with persistent red marrow",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "most common sites are pelvis, spine, and ribs",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "other common sites include knee (distal femur and proximal tibia), proximal femur, and shoulder girdle",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "risk factors",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "immunodeficiency (HIV, hepatitis)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "viral or bacterial infections",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**primary lymphoma of bone (solitary site)**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "most primary lymphomas of bone are Non-Hodgkin's B-cell lymphomas rather than T-cell variants",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "diagnosed when there is only a single node of disease for six months",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**multiple bony sites (no visceral sites)**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**bone and soft tissue lymphoma**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pain unrelieved by rest**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**25%** present with a **pathologic fracture**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "neurologic symptoms from spinal compression",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**fever, nightsweats, weight loss** (B-cell symptoms)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Physical Exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "inspection",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "warm and swollen large **soft tissue masses** are common",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Radiographs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**large ill-defined diffuse lytic lesions** with a subtle mottled appearance",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8025/images/Case%20A%20-%20femur%20-%20xray%20-%20Parsons_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/8025/images/Case%20B%20-humerus%20-%20xray%20-%20Parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            },
            {
              "text": "more common in the diaphysis of long bones",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8025/images/Case%20B%20-humerus%20-%20xray%20-%20Parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "2",
              "children": []
            },
            {
              "text": "25% show cortical thickening",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8025/images/Case%20B%20-humerus%20-%20xray%20-%20Parsons_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "2",
              "children": []
            },
            {
              "text": "\"ivory\" vertebrae",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "multiple sites of disease is common",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "differential diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "metastatic disease",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "multiple myeloma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "osteomyelitis",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "CT",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**CT of chest, abdomen, and pelvis** required for staging",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "extensive marrow involvement with large soft-tissue mass",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Bone scan",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intensely positive",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "PET",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "useful to stage and follow the disease",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Biopsy",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**bone marrow aspiration and biopsy are** required for staging",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "Histology",
          "table": null,
          "images": [],
          "importance": "2",
          "children": [
            {
              "text": "**diagnosis difficult to make with needle biopsy alone because tissue is often crushed**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**mixed small round blue cell** infiltrate (different sizes and shapes)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/8025/images/Histology%20B%20-%20high%20-%20Parsons_moved.jpg",
                  "caption": ""
                },
                {
                  "src": "https://upload.orthobullets.com/topic/8025/images/Histology%20A%20-%20high%20power%20-%20Parsons_moved.png",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": [
                {
                  "text": "differentiate from other small round blue cell tumors",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "CD99 negative and absent 11:22 chromosomal translocation",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            },
            {
              "text": "diffuse infiltration of **trabeculae** (as opposed to nodular)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "immunohistochemical stains positive",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "**CD20 positive**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**CD45 positive**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**lymphocyte common antigen positive**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "diffuse large B-cell lymphoma (DLBCL) is the most common histological subtype",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "accounts for 70–80% of all bone lymphomas",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
