    {
      "text": "Techniques",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Local surgical decompression**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "release hypothenar muscle origin",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "decompress ganglion cysts",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "resect hook of hamate",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "vascular treatment of ulnar artery thombosis",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            },
            {
              "text": "explore and release all three zones in Guyon's canal",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        },
        {
          "text": "**Tendon transfers**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "correct claw fingers",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "possible grafts include ECRL, ECRB, palmaris longus",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "tendons must pass volar to transverse metacarpal ligament in order to flex the proximal phalanx",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "attach with either a two or four-tailed graft to the A2 pulley of the ring and small fingers",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "restore power pinch",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "Smith transfer using ECRB or FDS of ring finger",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "restore adduction of small finger",
              "table": null,
              "images": [],
              "importance": "2",
              "children": [
                {
                  "text": "transfer ulnar insertion of EDM to A1 pulley or radial collateral ligament of the small finger",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            }
          ]
        }
