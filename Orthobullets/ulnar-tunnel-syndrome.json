              ],
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Deep branch of the ulnar nerve",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "innervates all of the interosseous muscles and the 3rd and 4th lumbricals.",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Innervates the hypothenar muscles, the adductor pollicis, and the medial head (deep) of the flexor pollicis brevis (FPB)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Classification",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Presentation varies based on location of compression within Guyon's canal and may be",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "Motor only",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Sensory only",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "Mixed Motor & Sensory",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Presentation varies based on location of compression within Guyon's canal and may be",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pure motor**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**pure sensory**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**mixed motor and sensory**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "pain and paresthesias in ulnar 1-1/2 digits",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "weakness to intrinsics, ring and small finger digital flexion or thumb adduction",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**inspection & palpation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "**clawing of ring and little fingers**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**caused from loss of intrinsics flexing the MCPs and extending the IP joints**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Allen test**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "**helps diagnose ulnar artery thrombosis**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "neurovascular exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "ulnar nerve palsy results in paralysis of the intrinsic muscles (adductor pollicis, deep head FPB, interossei, and lumbricals 3 and 4)",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**weakened grasp**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "from loss of MP joint flexion power",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**weak pinch**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "from loss of thumb adduction (as much as 70% of pinch strength is lost)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Froment sign**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "IP flexion compensating for loss of thumb adduction when attempting to hold a piece of paper",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "loss of MCP flexion and adduction by adductor pollicis (ulnar n.)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "compensatory **IP hyperflexion by FPL** (AIN)",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Jeane's sign**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "a compensatory thumb **MCP hyperextension** and **thumb adduction** by EPL (radial n.)",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "compensates for loss of IP extension and thumb adduction by adductor pollicis (ulna n.)",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**Wartenberg sign**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/6022/images/wartenberg%20sign.jpg",
                      "caption": "Wartenberg sign"
                    }
                  ],
                  "importance": "4",
                  "children": [
                    {
                      "text": "abduction posturing of the little finger",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
