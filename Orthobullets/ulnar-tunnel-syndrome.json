              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "useful to evaluate for a ganglion cysts",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "a gradient echo MRI will also show an ulnar artery aneurysm",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/6022/images/26_moved.jpg",
                  "caption": ""
                }
              ],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Doppler US or arteriogram",
          "table": null,
          "images": [
            {
              "src": "https://upload.orthobullets.com/topic/6022/images/angio.jpg",
              "caption": ""
            }
          ],
          "importance": "1",
          "children": [
            {
              "text": "useful to diagnosis ulnar artery thrombosis and aneurysm",
              "table": null,
              "images": [],
              "importance": "2",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "NCS and EMG",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "helpful in establishing diagnosis and prognosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "threshold for diagnosis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "conduction velocity <50 m/sec across elbow",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "low amplitudes of sensory nerve action potentials and compound muscle action potentials",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Cubital tunnel syndrome",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "compared to ulnar tunnel syndrome, cubital tunnel demonstrates",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "less clawing",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
