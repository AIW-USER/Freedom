{
  "title": "Stroke",
  "url": "https://www.orthobullets.com/basic-science/12288/stroke",
  "subtitle": "Updated: Jun 18 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Stroke is an acute onset of focal neurologic deficits resulting from diminished blood flow or hemorrhage in the brain.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Diagnosis is made clinically with specific and thorough neurological examination.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Treatment is emergent medical management and possible surgical management depending on underlying cause.",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "incidence",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "risk factors include",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**diabetes**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**smoking**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**atrial fibrillation**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**cocaine**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Two forms",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "diminished blood flow **(ischemic stroke)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "hemorrhage (**hemorrhagic stroke**)",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/12288/images/hemorrhagicstroke-large.jpg",
                  "caption": ""
                }
              ],
              "importance": "5",
              "children": []
            }
          ]
        },
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "etiology include",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**35% - atherosclerosis of the extracranial vessels (carotid atheroma)**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**30% -**cardiac and fat emboli, endocarditis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**15% -** lacunar",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "occur in areas supplied by small perforating vessels and result from",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": [
                        {
                          "text": "atherosclerosis",
                          "table": null,
                          "images": [],
                          "importance": "1",
                          "children": []
                        },
                        {
                          "text": "**hypertension**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        },
                        {
                          "text": "**diabetes**",
                          "table": null,
                          "images": [],
                          "importance": "5",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "**10% - parenchymal hemorrhage**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "10% - subarachnoid hemorrhage",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Watershed occurs at areas at border of two arterial supplies",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "often follow **prolonged hypotension**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "TIA is charcaterized by transient neurologic deficits for **less than 24 hours** (usually less than 1 hr.)",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Edema occurs 2-4 days post-infarct.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Watch for symptoms",
          "table": null,
          "images": [],
          "importance": "1",
          "children": [
            {
              "text": "decorticate (cortical lesion): flexion of arms",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "decerebrate (midbrain or lower lesion): extension of arms",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "",
          "table": [
            {
              "header": true,
              "cells": [
                {
                  "colspan": 3,
                  "bullets": [
                    {
                      "text": "**Symptoms of various strokes**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Carotid/Ophthalmic",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Amaurosis fugax (monocular blind)",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "MCA",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Aphasia, neglect, hemiparesis, gaze preference, homonymous hemianopsia.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "ACA",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Leg paresis, hemiplegia, urinary incontinence",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "PCA",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Homonynmous hemianopsia",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Basilar Art",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Coma, cranial nerve palsies, apnea, drop attach, vertigo",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "header": false,
              "cells": [
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Lacunar stroke",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "Silent, pure motor or sensory stroke, dysarthria (clusy hand syndrome), ataxic hemiparesis.",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "colspan": 0,
                  "bullets": [
                    {
                      "text": "",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ],
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Other stroke syndromes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**lateral medullary infarct (Wallenburg syndrome)**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "loss of pain and temp on ipsilateral face and contralateral body, vestibulocerebellar impairment, Horner's syndrome",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Imaging",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**CT without contrast**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "indicated for acute presentation",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "important to diagnose as ischemic or hemorrhagic",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "MRI",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "indicated for subacute",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "vascular studies of intra and extracranial vessels",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Studies",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Labs",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "should include **coagulation studies**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "lumbar puncture to r/o encephalitis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "**Echo**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "to check for mural thrombus, rule out endocarditis",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "EEG to rule out seizure",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Differential",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Brain tumor, epi / subdural bleeds, brain abscess, endocarditis, multiple sclerosis, metabolic (hypoglycemia), neurosyphillis",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thrombolytics",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "for occlusive disease",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "modalities",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "give **IV tPA** if within 3-4.5 hours",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    },
                    {
                      "text": "can consider **intra-arterial thrombolysis** in select patients (major MCA occlusion) up to 6 hours after onset of symptoms",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "warfarin/aspirin therapy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "**for embolic disease** and hypercoagulable states **give warfarin / aspirin** once the hemorrhagic stroke has been ruled out",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "anti-hypertensive medications",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "do not overtreat hypertension. Allow BP to rise to 200/100 to maintain perfusion",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Operative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "thrombectomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "within 6 hours in an ischemic stroke with a proximal cerebral arterial occlusion, compared to alteplase alone, improved reperfusion, early neurological recovery, and functional outcome.",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "endarterectomy",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "if corotid > 70% occluded",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Prognosis, Prevention, and Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Less than 1/3 achieve full recovery",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "For embolic disease give warfarin / aspirin for **prophylaxis**",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "**Carotid endarterectomy** if stenosis is > 70%. Contraindicated if vessel is 100% occluded.",
          "table": null,
          "images": [],
          "importance": "1",
          "children": []
        },
        {
          "text": "Manage hypertension",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
