{
  "title": "Cervical Spine Trauma Evaluation",
  "url": "https://www.orthobullets.com/spine/2012/cervical-spine-trauma-evaluation",
  "subtitle": "Updated: Sep 2 2026",
  "sections": [
    {
      "text": "Introduction",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "All trauma patients have a cervical spine injury **until proven otherwise**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": []
        },
        {
          "text": "Cervical spine clearance defined as confirming the **absence of cervical spine injury**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "important to clear cervical spine and remove collar in an efficient manner",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "delayed clearance is associated with an increased complication rate",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "cervical clearance can be performed with",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "**physical exam**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**imaging**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Missed cervical spine injuries",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "may lead to **permanent disability**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "careful clinical and radiographic evaluation is paramount",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "high rate of missed cervical spine injuries due to:",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "**inadequate imaging of affected level**",
                      "table": null,
                      "images": [],
                      "importance": "4",
                      "children": []
                    },
                    {
                      "text": "loss of consciousness",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    },
                    {
                      "text": "multisystem trauma",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "cervical spine injury necessitates careful examination of entire spine",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**noncontiguous spinal column injuries** reported in 10-15% of patients",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "History",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "**Details of accident**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**energy of accident**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "higher level of concern when there is a history of high energy trauma as indicated by:",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "MVA at >35 MPH",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "fall from >10 feet",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "closed head injuries",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "neurologic deficits referable to cervical spine",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    },
                    {
                      "text": "pelvis and extremity fractures",
                      "table": null,
                      "images": [],
                      "importance": "1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "**mechanism of accident**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "e.g. elderly person falls and hits forehead (hyperextension injury)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "e.g. patient rear-ended at high speed (hyperextension injury)",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**condition of patient at scene of accident**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "general condition",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "degree of consciousness",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "presence or absence of neurologic deficits",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "**Identify associated conditions and comorbidities**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": [
            {
              "text": "**ankylosing spondylitis** (AS)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "diffuse idiopathic skeletal hyperostosis (DISH)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "previous cervical spine fusion (congenital or acquired)",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "connective tissue disorders leading to ligamentous laxity",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Physical Exam",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Useful for detecting **major injuries**",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Primary survey",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "airway",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "breathing",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "circulation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "visual and manual inspection of entire spine should be performed",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "manual inline traction should be applied whenever cervical immobilization is removed for securing airway",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "seat belt sign (abdominal ecchymosis) should raise suspicion for flexion distraction injuries of thoracolumbar spine",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Secondary survey",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cervical spine exam",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**remove immobilization collar**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**examine face and scalp for evidence of direct trauma**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "inspect for angular or rotational deformities in the holding position of the patient's head",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": [
                    {
                      "text": "rotational deformity may indicate a unilateral facet dislocation",
                      "table": null,
                      "images": [],
                      "importance": "3",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**palpate posterior cervical spine** looking for tenderness along the midline or paraspinal tissues",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": [
                    {
                      "text": "absence of posterior midline tenderness in the awake, alert patient predicts **low probability of significant cervical spine injury**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "**log roll** patient to inspect and palpate entire spinal axis",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "perform careful **neurologic exam**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Clinical Cervical Clearance",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Removal of cervical collar WITHOUT radiographic studies allowed if:",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "patient is **awake, alert,** and not intoxicated AND",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "has **no neck pain, tenderness, or neurologic deficits** AND",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "has **no distracting injuries**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "**Utilizing updated clinical practice guidelines and Nexus criteria for pediatric C-spine clearance**",
          "table": null,
          "images": [],
          "importance": "5",
          "children": [
            {
              "text": "less radiation exposure with reduced CT scans for C-spine clearance",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Radiographic Cervical Clearance",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications for obtaining radiographic clearance",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "intoxicated patients OR",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "patients with altered mental status OR",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "**neck pain or tenderness** present OR",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**distracting injury** present",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Methods",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "lateral",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "must include **inferior endplate of C7**",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                },
                {
                  "text": "open-mouth odontoid",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "AP",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "CT scan",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "must include **superior endplate of T1**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Treatment",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Nonoperative",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "cervical collar",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "initiated at scene of injury until directed examination performed",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "early active range of motion",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indications",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "\"whiplash-like\" symptoms AND",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "cleared from a serious cervical injury by exam or imaging",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Complications",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Delayed clearance associated with increased complication rate including",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "increased risk of **aspiration**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "inhibition of **respiratory function**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            },
            {
              "text": "**decubitus ulcers** in occipital and submandibular areas",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "possible increase in **intracranial pressure**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": []
            }
          ]
        },
        {
          "text": "Mortality increased in geriatric patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    }
  ],
