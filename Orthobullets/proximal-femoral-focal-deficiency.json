{
  "title": "Proximal Femoral Focal Deficiency",
  "url": "https://www.orthobullets.com/pediatrics/4043/proximal-femoral-focal-deficiency",
  "subtitle": "Updated: Jul 27 2025",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Proximal Femoral Focal Deficiency is a congenital condition caused by a defect in the primary ossification center of the proximal femur that may present with an absent hip, femoral neck pseudoarthrosis, absent femur, or a shortened femur.",
          "table": null,
          "images": [],
          "importance": "4",
          "children": []
        },
        {
          "text": "Diagnosis is made with radiographs of the hip and femur.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        },
        {
          "text": "Treatment is nonoperative or operative depending on location and size of the femoral defect, as well as presence of bilateral involvement.",
          "table": null,
          "images": [],
          "importance": "3",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Anatomic location",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "bilateral (15%)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Pathophysiology",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "defect in the primary ossification center (cartilage anlage)",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Spectrum",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "spectrum of disease includes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**absent hip**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**femoral neck pseudoarthrosis**",
                  "table": null,
                  "images": [
                    {
                      "src": "https://upload.orthobullets.com/topic/4043/images/AP%20xrays%20cervical%20pseudoarthrosis_moved.jpg",
                      "caption": ""
                    }
                  ],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**absent femur**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**shortened femur**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "primarily sporadic etiology, but rare autosomal dominant form exists",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "associated with **sonic hedge-hog gene** (limb bud)",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4043/images/screen_shot_2014-05-25_at_9.00.38_pm.jpg",
                  "caption": "Deficiencies of PFFD"
                }
              ],
              "importance": "1",
              "children": [
                {
                  "text": "**fibular hemimelia** (50%)",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "**ACL deficiency**",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                },
                {
                  "text": "coxa vara",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                },
                {
                  "text": "knee contractures",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "nonorthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "dysmorphic facies found in rare autosomal dominant type",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
