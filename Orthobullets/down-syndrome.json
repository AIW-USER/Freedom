{
  "title": "Down Syndrome",
  "url": "https://www.orthobullets.com/pediatrics/4104/down-syndrome",
  "subtitle": "Updated: Jun 16 2021",
  "sections": [
    {
      "text": "summary",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Down Syndrome is a common congenital disorder caused by the maternal duplication of chromosome 21. Patients present with mental retardation, cardiovascular abnormalities, cervical spine instability, generalized ligamentous laxity, and recurrent joint dislocations.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Diagnosis is made with chromosomal testing to assess for trisomy 21.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        },
        {
          "text": "Treatment involves a multidisciplinary approach to improve and maintain function. Surgical spinal instrumentation and fusion are indicated in patients with atlantoaxial instability and occipitocervical with progressive neurological deficits.",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": []
        }
      ]
    },
    {
      "text": "Epidemiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Incidence",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**most common chromosomal abnormality** in the United States",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "1:700 live births",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Risk factors",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "**advanced maternal age.** 1 in 250 if mother > 35 yo, 1 in 5000 if < 30 yo",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Etiology",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Genetics",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "maternal duplication of chromosome 21, yielding a **trisomy 21**",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            },
            {
              "text": "chromosome 21 codes for Type VI Collagen (COL6A1, COL6A2)",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "critical component of skeletal muscle extracellular matrix",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "dysfunction may contribute to generalized joint laxity",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Associated conditions",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "orthopaedic manifestations",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**generalized ligamentous laxity and hypotonia**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**short stature**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**C1-2 instability**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**Occipitocervical Instability**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "delayed motor milestones (walk at 2-3 years of age)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**hip subluxation and dislocation**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**patellofemoral instability and dislocation**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**scoliosis & spondylolisthesis**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "pes planus",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "metatarsus primus varus",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "SCFE",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "medical conditions and comorbidities",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "mental retardation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**cardiac disease (50%)**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**endocrine disorders (hypothyroidism)**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "premature aging",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "duodenal atresia",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "hypothyroidism",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "Alzheimer's disease",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Presentation",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Symptoms",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "determining degree of symptoms can be difficult",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Physical exam",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "HEENT",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "flattened facies",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "upward slanting eyes",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "epicanthal folds",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "upper extremity",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "single palmar crease (simian crease)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "ligamentous laxity",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "spine",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "neuro",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "mental retardation of varying degrees",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "hearing loss",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Spine Conditions",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Atlantoaxial Instability",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "epidemiology",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "instability is present in 17.5%",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "presentation",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "may be subtle",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "manifests as a loss or change in gait or bowel/bladder symptoms",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "radiographs",
              "table": null,
              "images": [
                {
                  "src": "https://upload.orthobullets.com/topic/4104/images/down.jpg",
                  "caption": "8 year old male with history of Down syndrome, ASD, PDA, and secondary pulmonary hypertension with tricuspid insufficiency. Eval cervical spine."
                }
              ],
              "importance": "-1",
              "children": [
                {
                  "text": "may obtain flexion-extension cervical spine radiographs (indications vary, routine screening radiographs likely not needed)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "**flexion-extension films are needed to confirm stability prior to intubation**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "atlantodens interval (ADI) of <5mm is normal",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "In general, 5-10mm of motion can be considered normal in this population",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "nonoperative",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "routine follow up with neurologic evaluation and repeat imaging",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "indications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "for ADI 5-10, no neurologic findings, and imaging with >14mm space available for the cord.",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "operative",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "C1-2 posterior spinal fusion",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "general indications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "ADI >5mm and symptomatic/myelopathic or ADI >10mm",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "<14mm space available for the cord",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "complications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "reported complication rate up to 50%",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "sports participation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "asymptomatic patients with instability should avoid contact sports, diving, and gymnastic",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Occipitocervical Instability",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "imaging",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "**Powers ratio**",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "used to diagnosis occipitocervical instability",
                      "table": null,
                      "images": [
                        {
                          "src": "https://upload.orthobullets.com/topic/4104/images/9f78bb4b-817d-4036-9be0-1bfe0d6cdbc2_powers_ratio_ct_scan..jpg",
                          "caption": "Power's ratio"
                        }
                      ],
                      "importance": "-1",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "observation with limitation of contact sports activity",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "vast majority of patients",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "posterior occipitocervical fusion",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "indications",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "progressive neurologic deficits and myelopathy",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Lumbar Spondylolithesis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "present in 6% of patients with Down's Syndrome",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": []
            }
          ]
        },
        {
          "text": "Scoliosis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "bracing for Curves 25-30 degrees",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "spinal Fusion for curves >50 degrees",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "complications",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "complication rate with surgical treatment likely greater than idiopathic scoliosis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Knee Conditions",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Patellofemoral instability",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "lower extremity to evaluate for genu valgum",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "sunrise or Merchant view to evaluate degree of subluxation or dislocation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "nonoperative",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "observation only",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "indications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "in skeletally mature patient with no pain",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "text": "patellar stabilizing brace",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "indicated if symptomatic",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "operative",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "lateral release, medial reefing, semitendiniosus tenodesis, or tibial tubercle osteotomy",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "indications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "symptomatic patients",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            },
                            {
                              "text": "osteotomy for skeletal mature patients",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Hip Conditions",
      "table": null,
      "images": [],
      "importance": "-1",
      "children": [
        {
          "text": "Hip instability",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "introduction",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "hip instability is very common secondary to ligamentous laxity and altered proximal femur/acetabular osteology (i.e. coxa valgum, retroverted acetabulum)",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "may initially present with subluxation or dislocation",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "occurs between 2-10 years of age",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                },
                {
                  "text": "occurs in 5% of patients",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "nonoperative",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "abduction bracing",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "indications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "younger child without bony changes or dislocation",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "text": "operative",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": [
                    {
                      "text": "capsulorrhaphy and pelvic and femoral varus osteotomies",
                      "table": null,
                      "images": [],
                      "importance": "-1",
                      "children": [
                        {
                          "text": "indications",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": [
                            {
                              "text": "symptomatic older children",
                              "table": null,
                              "images": [],
                              "importance": "-1",
                              "children": []
                            }
                          ]
                        },
                        {
                          "text": "surgery associated with high complication rate",
                          "table": null,
                          "images": [],
                          "importance": "-1",
                          "children": []
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Slipped capital femoral epiphysis",
          "table": null,
          "images": [],
          "importance": "-1",
          "children": [
            {
              "text": "introduction",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "evaluate for concomitant hypothyroidism",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "radiographs",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
                {
                  "text": "AP and Frog Pelvis",
                  "table": null,
                  "images": [],
                  "importance": "-1",
                  "children": []
                }
              ]
            },
            {
              "text": "treatment",
              "table": null,
              "images": [],
              "importance": "-1",
              "children": [
