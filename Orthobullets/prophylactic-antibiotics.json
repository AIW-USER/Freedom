{
  "title": "Prophylactic Antibiotics",
  "url": "https://www.orthobullets.com/basic-science/9088/prophylactic-antibiotics",
  "subtitle": "Updated: Jun 17 2021",
  "sections": [
    {
      "text": "Perioperative Abx Overview",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Includes preoperative and postoperative antibiotics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "25-50% of all antibiotics used are for prophylaxis",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            }
          ]
        },
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "routine adminstration of prophylactic antibiotics is accepted in",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "patients who will have a foreign body implanted",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "bone grafting procedures",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "large dissection resulting in significant dead space or hematoma",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "expecting significant blood loss",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "orthopaedics procedures that do not require prophylactic antibiotics",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "carpal tunnel surgery",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "diagnostic arthroscopy is more controversial",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Most likely pathogens to cause infection in orthopaedic procedures includes",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**S aureus**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "**S epidermidis**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**aerobic streptococci**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "**anaerobic cocci**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Perioperative Prophylaxis in Total Joint Replacement (AAOS Recommendations)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Choice of antibiotics",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**if no beta-lactam allergy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "cefazolin or",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "cefuroxime",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**if beta-lactam allergy**",
              "table": null,
              "images": [],
              "importance": "4",
              "children": [
                {
                  "text": "vancomycin or",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "clindamycin",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            },
            {
              "text": "**if history of MRSA infection or in areas with high prevelance of MRSA**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "vancomycin in addition to cefazolin",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": [
                    {
                      "text": "use judiciously - increased risk of **vancomycin-resistant enterococcus (VRE)**",
                      "table": null,
                      "images": [],
                      "importance": "5",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "text": "Administration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "always administer abx prior to tourniquet inflation",
              "table": null,
              "images": [],
              "importance": "3",
              "children": []
            },
            {
              "text": "cefazolin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "administer **within 1 hour of incision**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "double amount of cefazolin administered **if above 80kg**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                }
              ]
            },
            {
              "text": "vancomycin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "administer within 2 hours of incision",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Duration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "prophylactic antibiotics **should NOT exceed 24 hours** after surgery",
              "table": null,
              "images": [],
              "importance": "4",
              "children": []
            },
            {
              "text": "In clean and clean-contaminated procedures, do not administer additional doses of antibiotics after incision is closed in the operating room, even in the presence of a drain.",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "text": "Dental Procedure Abx Prophylaxis in TJR Patients (AAOS & ADA)",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "TJA patients at increased risk of hematogenous seeding should be given prophylactic antibiotics prior to dental procedures. This includes",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**all patients for the first two years after TJA**",
                  "table": null,
                  "images": [],
                  "importance": "4",
                  "children": []
                },
                {
                  "text": "**immunocompromised patients**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "drug induced immunosuppression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "radiation induced immunosuppression",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "**inflammatory arthropathies** including SLE and RA",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "**comorbidities including**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": [
                    {
                      "text": "previous prosthetic joint infection",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "Type I (insulin-dependent) diabetes",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "malnourishment",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "hemophilia",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "HIV",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    },
                    {
                      "text": "malignancy",
                      "table": null,
                      "images": [],
                      "importance": "2",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "text": "evidence to support recommendations",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "AAOS and ADA recognizes there is **limited or inconclusive evidence** to support the recommendations above and practitioners should use clinical judgment",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "text": "Administration",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "antibiotics is given **1 hour before dental procedure**",
              "table": null,
              "images": [],
              "importance": "5",
              "children": []
            },
            {
              "text": "patients NOT allergic to penicillin should be given",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "**amoxicillin or cephalexin 2 grams orally**",
                  "table": null,
                  "images": [],
                  "importance": "1",
                  "children": []
                },
                {
                  "text": "if unable to take oral medications than 1 gram cefazolin or 2 gram ampicillin IV or IM",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            },
            {
              "text": "if allergic to penicillin",
              "table": null,
              "images": [],
              "importance": "3",
              "children": [
                {
                  "text": "clindamycin 600 mg orally",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                },
                {
                  "text": "if unable to take oral medications than clindamycin 600 mg IV",
                  "table": null,
                  "images": [],
                  "importance": "3",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "text": "Splenectomy Patients Prophylaxis",
      "table": null,
      "images": [],
      "importance": "3",
      "children": [
        {
          "text": "Indications in splenectomized patients",
          "table": null,
          "images": [],
          "importance": "3",
          "children": [
            {
              "text": "**pneumococcal immunization**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indicated in all splenectomized patients and those with functional hyposplenism",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**haemophilus influenza type B vaccine**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indicated in all patients not previously immunized",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**meningococcal group C conjugate vaccine**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "indicated in all patients not previously immunized",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**influenza immunization**",
              "table": null,
              "images": [],
              "importance": "1",
              "children": [
                {
                  "text": "should be given annually",
                  "table": null,
                  "images": [],
                  "importance": "2",
                  "children": []
                }
              ]
            },
            {
              "text": "**lifelong prophylactic antibiotics** (oral phenoxymethylpenicillin or erythromycin)",
              "table": null,
              "images": [],
              "importance": "5",
              "children": [
                {
                  "text": "indicated in all splenectomized patients",
                  "table": null,
                  "images": [],
                  "importance": "5",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
